index 0000000..2762fc2
--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/module/city/SqlCityLedgerStorage.java
@@ -0,0 +1,157 @@
+package dev.starcore.starcore.module.city;
+
+import java.sql.*;
+import java.util.*;
+import java.util.function.Supplier;
+import javax.sql.DataSource;
+
+/** Snapshot and authority seal are committed together, including first-time file migration. */
+final class SqlCityLedgerStorage implements CityLedgerStorage {
+  private final Supplier<Optional<DataSource>> source;
+  private final Supplier<CityLedger> legacy;
+  private CityLedger expected;
+
+  SqlCityLedgerStorage(Supplier<Optional<DataSource>> source, Supplier<CityLedger> legacy) {
+    this.source = Objects.requireNonNull(source);
+    this.legacy = Objects.requireNonNull(legacy);
+  }
+
+  private Connection open() throws SQLException {
+    return source
+        .get()
+        .orElseThrow(() -> new IllegalStateException("City database unavailable"))
+        .getConnection();
+  }
+
+  private boolean table(Connection c, String name) throws SQLException {
+    try (var rows = c.getMetaData().getTables(c.getCatalog(), null, name, new String[] {"TABLE"})) {
+      while (rows.next()) if (name.equalsIgnoreCase(rows.getString("TABLE_NAME"))) return true;
+      return false;
+    }
+  }
+
+  private void initialize(Connection c) throws SQLException {
+    boolean state = table(c, "starcore_city_state"), seal = table(c, "starcore_city_authority");
+    if (state != seal) throw new SQLException("Missing city authority table");
+    if (state) return;
+    if (expected != null) throw new SQLException("City authority disappeared");
+    boolean sqlite = "SQLite".equalsIgnoreCase(c.getMetaData().getDatabaseProductName());
+    try (var s = c.createStatement()) {
+      s.execute(
+          "CREATE TABLE IF NOT EXISTS starcore_city_state (singleton INTEGER PRIMARY KEY,payload "
+              + (sqlite ? "TEXT" : "LONGTEXT")
+              + " NOT NULL)");
+      s.execute(
+          "CREATE TABLE IF NOT EXISTS starcore_city_authority (singleton INTEGER PRIMARY"
+              + " KEY,revision BIGINT NOT NULL,checksum VARCHAR(64) NOT NULL)");
+    }
+    // Interrupted initialization with empty tables requires explicit reconciliation on restart.
+    CityLedger initial = legacy.get();
+    String payload = initial.encode();
+    boolean auto = c.getAutoCommit(), safe = false;
+    c.setAutoCommit(false);
+    try {
+      try (var s =
+          c.prepareStatement("INSERT INTO starcore_city_state(singleton,payload) VALUES(1,?)")) {
+        s.setString(1, payload);
+        s.executeUpdate();
+      }
+      try (var s =
+          c.prepareStatement(
+              "INSERT INTO starcore_city_authority(singleton,revision,checksum) VALUES(1,?,?)")) {
+        s.setLong(1, initial.revision());
+        s.setString(2, initial.fingerprint());
+        s.executeUpdate();
+      }
+      c.commit();
+      safe = true;
+    } catch (SQLException | RuntimeException failure) {
+      try {
+        c.rollback();
+        safe = true;
+      } catch (SQLException rollback) {
+        failure.addSuppressed(rollback);
+      }
+      throw failure;
+    } finally {
+      if (safe) c.setAutoCommit(auto);
+    }
+  }
+
+  private CityLedger read(Connection c) throws SQLException {
+    try (var s = c.createStatement();
+        var r =
+            s.executeQuery(
+                "SELECT a.revision,a.checksum,s.payload FROM starcore_city_authority a JOIN"
+                    + " starcore_city_state s ON a.singleton=s.singleton WHERE a.singleton=1")) {
+      if (!r.next()) throw new SQLException("Missing city authority row");
+      var ledger = CityLedger.decode(r.getString(3));
+      if (ledger.revision() != r.getLong(1) || !ledger.fingerprint().equals(r.getString(2)))
+        throw new SQLException("City authority checksum mismatch");
+      return ledger;
+    }
+  }
+
+  public synchronized CityLedger load() {
+    try (var c = open()) {
+      initialize(c);
+      var ledger = read(c);
+      expected = ledger;
+      return ledger;
+    } catch (SQLException e) {
+      throw new IllegalStateException("Unable to load city authority", e);
+    }
+  }
+
+  public synchronized void save(CityLedger ledger) {
+    if (expected == null) throw new IllegalStateException("Load city authority before writing");
+    ledger.requireSuccessorOf(expected);
+    String payload = ledger.encode();
+    try (var c = open()) {
+      boolean auto = c.getAutoCommit(), safe = false;
+      c.setAutoCommit(false);
+      try {
+        // Acquire the authority lock before inspecting the old snapshot.
+        try (var s =
+            c.prepareStatement(
+                "UPDATE starcore_city_authority SET revision=?,checksum=? WHERE singleton=1 AND"
+                    + " revision=? AND checksum=?")) {
+          s.setLong(1, ledger.revision());
+          s.setString(2, ledger.fingerprint());
+          s.setLong(3, expected.revision());
+          s.setString(4, expected.fingerprint());
+          if (s.executeUpdate() != 1)
+            throw new SQLException("Stale city authority; reload and retry");
+        }
+        try (var s = c.createStatement();
+            var r = s.executeQuery("SELECT payload FROM starcore_city_state WHERE singleton=1")) {
+          if (!r.next()) throw new SQLException("Missing city state");
+          var previous = CityLedger.decode(r.getString(1));
+          if (!previous.equals(expected))
+            throw new SQLException("City changed outside authority protocol");
+          ledger.requireSuccessorOf(previous);
+        }
+        try (var s =
+            c.prepareStatement("UPDATE starcore_city_state SET payload=? WHERE singleton=1")) {
+          s.setString(1, payload);
+          if (s.executeUpdate() != 1) throw new SQLException("Missing city state");
+        }
+        c.commit();
+        safe = true;
+        expected = ledger;
+      } catch (SQLException | RuntimeException failure) {
+        try {
+          c.rollback();
+          safe = true;
+        } catch (SQLException rollback) {
+          failure.addSuppressed(rollback);
+        }
+        throw failure;
+      } finally {
+        if (safe) c.setAutoCommit(auto);
+      }
+    } catch (SQLException e) {
+      throw new IllegalStateException("Unable to persist city authority", e);
+    }
+  }
+}
