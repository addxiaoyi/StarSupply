+package dev.starcore.starcore.module.city;
+
+import com.google.gson.*;
+import com.google.gson.stream.JsonReader;
+import dev.starcore.starcore.module.city.model.*;
+import dev.starcore.starcore.module.nation.model.NationId;
+import java.io.*;
+import java.nio.charset.StandardCharsets;
+import java.time.Instant;
+import java.util.*;
+import org.bukkit.Bukkit;
+import org.bukkit.Location;
+
+/** Canonical plain JSON; validation never resolves worlds. */
+final class CitySnapshotCodec {
+  private CitySnapshotCodec() {}
+
+  static final Gson GSON = new GsonBuilder().disableHtmlEscaping().create();
+
+  static String encode(City city) {
+    var p = new JsonObject();
+    p.addProperty("id", city.id().toString());
+    p.addProperty("nationId", city.nationId().toString());
+    p.addProperty("name", city.name());
+    p.addProperty("treasury", city.treasury());
+    p.addProperty("createdAt", city.createdAt().toEpochMilli());
+    p.addProperty("lastUpdated", city.lastUpdated().toEpochMilli());
+    var loc = city.spawnChunk();
+    if (loc != null) {
+      if (loc.getWorld() == null)
+        throw new IllegalArgumentException("City spawn world unavailable");
+      var spawn = new JsonObject();
+      spawn.addProperty("world", loc.getWorld().getName());
+      spawn.addProperty("x", loc.getX());
+      spawn.addProperty("y", loc.getY());
+      spawn.addProperty("z", loc.getZ());
+      spawn.addProperty("yaw", loc.getYaw());
+      spawn.addProperty("pitch", loc.getPitch());
+      p.add("spawnChunk", spawn);
+    }
+    var residents = new JsonObject();
+    city.residents().forEach((id, rank) -> residents.addProperty(id.toString(), rank.name()));
+    p.add("residents", residents);
+    p.addProperty("mayorRank", city.mayorRank().name());
+    p.addProperty("level", city.level());
+    p.addProperty("maxLevel", city.maxLevel());
+    p.addProperty("experience", city.experience());
+    p.addProperty("pvpEnabled", city.isPvpEnabled());
+    p.addProperty("publicSpawn", city.isPublicSpawn());
+    p.addProperty("openRecruitment", city.isOpenRecruitment());
+    if (city.announcement() != null) p.addProperty("announcement", city.announcement());
+    var claims = new JsonArray();
+    city.claims().stream().sorted().forEach(claims::add);
+    p.add("claims", claims);
+    var votes = new JsonObject();
+    for (var vote : city.getActiveVotes()) {
+      var v = new JsonObject();
+      v.addProperty("creator", vote.creatorId().toString());
+      v.addProperty("title", vote.title());
+      v.addProperty("type", vote.type().name());
+      v.addProperty("duration", vote.durationSeconds());
+      v.addProperty("createdAt", vote.createdAt().toEpochMilli());
+      var ballots = new JsonObject();
+      vote.ballots().forEach((id, yes) -> ballots.addProperty(id.toString(), yes));
+      v.add("ballots", ballots);
+      if (votes.has(vote.id())) throw new IllegalArgumentException("Duplicate vote");
+      votes.add(vote.id(), v);
+    }
+    p.add("votes", votes);
+    validate(p);
+    return canonical(p);
+  }
+
+  static JsonObject parse(String text) {
+    if (text == null || text.length() > 64 * 1024 * 1024)
+      throw new IllegalArgumentException("City JSON too large");
+    try (var reader = new JsonReader(new StringReader(text))) {
+      reader.setLenient(false);
+      var value = read(reader, 0);
+      if (reader.peek() != com.google.gson.stream.JsonToken.END_DOCUMENT || !value.isJsonObject())
+        throw new IllegalArgumentException("Invalid city JSON document");
+      return value.getAsJsonObject();
+    } catch (IOException e) {
+      throw new IllegalArgumentException("Invalid city JSON", e);
+    }
+  }
+
+  private static JsonElement read(JsonReader r, int depth) throws IOException {
+    if (depth > 32) throw new IllegalArgumentException("City JSON nesting limit");
+    return switch (r.peek()) {
+      case BEGIN_OBJECT -> {
+        r.beginObject();
+        var value = new JsonObject();
+        while (r.hasNext()) {
+          if (value.size() >= 100_000) throw new IllegalArgumentException("City JSON object limit");
+          var key = r.nextName();
+          if (value.has(key)) throw new IllegalArgumentException("Duplicate JSON field");
+          value.add(key, read(r, depth + 1));
+        }
+        r.endObject();
+        yield value;
+      }
+      case BEGIN_ARRAY -> {
+        r.beginArray();
+        var value = new JsonArray();
+        while (r.hasNext()) {
+          if (value.size() >= 100_000) throw new IllegalArgumentException("City JSON array limit");
+          value.add(read(r, depth + 1));
+        }
+        r.endArray();
+        yield value;
+      }
+      case STRING -> new JsonPrimitive(r.nextString());
+      case NUMBER -> new JsonPrimitive(new java.math.BigDecimal(r.nextString()));
+      case BOOLEAN -> new JsonPrimitive(r.nextBoolean());
+      case NULL -> {
+        r.nextNull();
+        yield JsonNull.INSTANCE;
+      }
+      default -> throw new IllegalArgumentException("Invalid city JSON token");
+    };
+  }
+
+  static String canonical(JsonElement value) {
+    if (value.isJsonObject()) {
+      var sorted = new JsonObject();
+      value.getAsJsonObject().keySet().stream()
+          .sorted()
+          .forEach(k -> sorted.add(k, parseElementCanonical(value.getAsJsonObject().get(k))));
+      return GSON.toJson(sorted);
+    }
+    if (value.isJsonArray()) {
+      var array = new JsonArray();
+      value.getAsJsonArray().forEach(v -> array.add(parseElementCanonical(v)));
+      return GSON.toJson(array);
+    }
+    return GSON.toJson(value);
+  }
+
+  private static JsonElement parseElementCanonical(JsonElement value) {
+    return JsonParser.parseString(canonical(value));
+  }
+
+  static String normalizeLegacy(String text) {
+    var p = parse(text);
+    if (!p.has("treasury")) p.addProperty("treasury", 0.0);
+    if (!p.has("lastUpdated")) p.add("lastUpdated", p.get("createdAt"));
+    if (!p.has("residents")) p.add("residents", new JsonObject());
+    if (!p.has("mayorRank")) p.addProperty("mayorRank", "MAYOR");
+    if (!p.has("level")) p.addProperty("level", 1);
+    if (!p.has("maxLevel")) p.addProperty("maxLevel", 10);
+    if (!p.has("experience")) p.addProperty("experience", 0);
+    if (!p.has("pvpEnabled")) p.addProperty("pvpEnabled", false);
+    if (!p.has("publicSpawn")) p.addProperty("publicSpawn", true);
+    if (!p.has("openRecruitment")) p.addProperty("openRecruitment", true);
+    if (!p.has("claims")) p.add("claims", new JsonArray());
+    if (!p.has("votes")) p.add("votes", new JsonObject());
+    if (p.has("spawnChunk")) {
+      var spawn = p.getAsJsonObject("spawnChunk");
+      if (!spawn.has("yaw")) spawn.addProperty("yaw", 0.0);
+      if (!spawn.has("pitch")) spawn.addProperty("pitch", 0.0);
+    }
+    validate(p);
+    return canonical(p);
+  }
+
+  static void validate(JsonObject p) {
+    fields(
+        p,
+        Set.of(
+            "id",
+            "nationId",
+            "name",
+            "treasury",
+            "createdAt",
+            "lastUpdated",
+            "residents",
+            "mayorRank",
+            "level",
+            "maxLevel",
+            "experience",
+            "pvpEnabled",
+            "publicSpawn",
+            "openRecruitment",
+            "claims",
+            "votes"),
+        Set.of("announcement", "spawnChunk"));
+    uuid(string(p, "id", 36));
+    uuid(string(p, "nationId", 36));
+    if (string(p, "name", 128).isBlank()) throw new IllegalArgumentException("Blank city name");
+    var money = number(p, "treasury").doubleValue();
+    if (!Double.isFinite(money) || money < 0)
+      throw new IllegalArgumentException("Invalid city treasury");
+    Instant.ofEpochMilli(number(p, "createdAt").longValueExact());
+    Instant.ofEpochMilli(number(p, "lastUpdated").longValueExact());
+    var residents = p.getAsJsonObject("residents");
+    if (residents.size() > 100_000) throw new IllegalArgumentException("Too many residents");
+    residents
+        .entrySet()
+        .forEach(
+            e -> {
+              uuid(e.getKey());
+              CityRank.valueOf(string(residents, e.getKey(), 32));
+            });
+    CityRank.valueOf(string(p, "mayorRank", 32));
+    int level = number(p, "level").intValueExact(),
+        max = number(p, "maxLevel").intValueExact(),
+        xp = number(p, "experience").intValueExact();
+    if (level < 1 || max < level || max > 1000 || xp < 0)
+      throw new IllegalArgumentException("Invalid city progress");
+    for (var k : List.of("pvpEnabled", "publicSpawn", "openRecruitment")) bool(p, k);
+    if (p.has("announcement")) string(p, "announcement", 65536);
+    Set<String> claims = new HashSet<>();
+    for (var value : p.getAsJsonArray("claims")) {
+      if (!value.isJsonPrimitive() || !value.getAsJsonPrimitive().isString())
+        throw new IllegalArgumentException("Expected claim text");
+      var claim = value.getAsString();
+      var parts = claim.split(",", -1);
+      if (parts.length != 3 || parts[0].isBlank() || parts[0].length() > 191 || !claims.add(claim))
+        throw new IllegalArgumentException("Invalid city claim");
+      int x = Integer.parseInt(parts[1]), z = Integer.parseInt(parts[2]);
+      if (!claim.equals(parts[0] + "," + x + "," + z))
+        throw new IllegalArgumentException("Noncanonical city claim");
+    }
+    var votes = p.getAsJsonObject("votes");
+    if (votes.size() > 100_000) throw new IllegalArgumentException("Too many votes");
+    for (var e : votes.entrySet()) {
+      if (e.getKey().isBlank() || e.getKey().length() > 128)
+        throw new IllegalArgumentException("Invalid vote ID");
+      var v = e.getValue().getAsJsonObject();
+      fields(v, Set.of("creator", "title", "type", "duration", "createdAt", "ballots"), Set.of());
+      uuid(string(v, "creator", 36));
+      string(v, "title", 65536);
+      City.VoteType.valueOf(string(v, "type", 64));
+      if (number(v, "duration").intValueExact() < 1)
+        throw new IllegalArgumentException("Invalid vote duration");
+      Instant.ofEpochMilli(number(v, "createdAt").longValueExact());
+      v.getAsJsonObject("ballots")
+          .entrySet()
+          .forEach(
+              b -> {
+                uuid(b.getKey());
+                bool(v.getAsJsonObject("ballots"), b.getKey());
+              });
+    }
+    if (p.has("spawnChunk")) {
+      var s = p.getAsJsonObject("spawnChunk");
+      fields(s, Set.of("world", "x", "y", "z", "yaw", "pitch"), Set.of());
+      if (string(s, "world", 191).isBlank())
+        throw new IllegalArgumentException("Invalid spawn world");
+      for (var k : List.of("x", "y", "z", "yaw", "pitch"))
+        if (!Double.isFinite(number(s, k).doubleValue()))
+          throw new IllegalArgumentException("Invalid spawn coordinate");
+      if (!Float.isFinite(number(s, "yaw").floatValue())
+          || !Float.isFinite(number(s, "pitch").floatValue()))
+        throw new IllegalArgumentException("Invalid spawn angle");
+    }
+  }
+
+  static City decode(String text) {
+    var p = parse(text);
+    validate(p);
+    Location loc = null;
+    if (p.has("spawnChunk")) {
+      var s = p.getAsJsonObject("spawnChunk");
+      var world = Bukkit.getWorld(s.get("world").getAsString());
+      if (world == null)
+        throw new IllegalStateException(
+            "City spawn world unavailable: " + s.get("world").getAsString());
+      loc =
+          new Location(
+              world,
+              s.get("x").getAsDouble(),
+              s.get("y").getAsDouble(),
+              s.get("z").getAsDouble(),
+              s.get("yaw").getAsFloat(),
+              s.get("pitch").getAsFloat());
+    }
+    Map<UUID, CityRank> residents = new HashMap<>();
+    p.getAsJsonObject("residents")
+        .entrySet()
+        .forEach(
+            e -> residents.put(uuid(e.getKey()), CityRank.valueOf(e.getValue().getAsString())));
+    var city =
+        new City(
+            uuid(p.get("id").getAsString()),
+            NationId.fromString(p.get("nationId").getAsString()),
+            p.get("name").getAsString(),
+            loc,
+            residents,
+            CityRank.valueOf(p.get("mayorRank").getAsString()),
+            p.get("treasury").getAsDouble(),
+            Instant.ofEpochMilli(p.get("createdAt").getAsLong()),
+            Instant.ofEpochMilli(p.get("lastUpdated").getAsLong()));
+    city.restoreProgress(
+        p.get("level").getAsInt(), p.get("maxLevel").getAsInt(), p.get("experience").getAsInt());
+    city.setPvpEnabled(p.get("pvpEnabled").getAsBoolean());
+    city.setPublicSpawn(p.get("publicSpawn").getAsBoolean());
+    city.setOpenRecruitment(p.get("openRecruitment").getAsBoolean());
+    if (p.has("announcement")) city.setAnnouncement(p.get("announcement").getAsString());
+    p.getAsJsonArray("claims")
+        .forEach(
+            c -> {
+              var a = c.getAsString().split(",", -1);
+              city.addClaim(a[0], Integer.parseInt(a[1]), Integer.parseInt(a[2]));
+            });
+    p.getAsJsonObject("votes")
+        .entrySet()
+        .forEach(
+            e -> {
+              var v = e.getValue().getAsJsonObject();
+              var vote =
+                  new City.CityVote(
+                      e.getKey(),
+                      uuid(v.get("creator").getAsString()),
+                      v.get("title").getAsString(),
+                      City.VoteType.valueOf(v.get("type").getAsString()),
+                      v.get("duration").getAsInt(),
+                      Instant.ofEpochMilli(v.get("createdAt").getAsLong()));
+              v.getAsJsonObject("ballots")
+                  .entrySet()
+                  .forEach(b -> vote.vote(uuid(b.getKey()), b.getValue().getAsBoolean()));
+              city.restoreVote(vote);
+            });
+    city.setLastUpdated(Instant.ofEpochMilli(p.get("lastUpdated").getAsLong()));
+    return city;
+  }
+
+  static void fields(JsonObject p, Set<String> required, Set<String> optional) {
+    if (!p.keySet().containsAll(required)
+        || p.keySet().stream().anyMatch(k -> !required.contains(k) && !optional.contains(k)))
+      throw new IllegalArgumentException("Invalid city snapshot fields");
+  }
+
+  static String string(JsonObject p, String key, int max) {
+    var v = p.get(key);
+    if (v == null || !v.isJsonPrimitive() || !v.getAsJsonPrimitive().isString())
+      throw new IllegalArgumentException("Expected text: " + key);
+    var s = v.getAsString();
+    if (s.length() > max) throw new IllegalArgumentException("Text too long: " + key);
+    return s;
+  }
+
+  static java.math.BigDecimal number(JsonObject p, String key) {
+    var v = p.get(key);
+    if (v == null || !v.isJsonPrimitive() || !v.getAsJsonPrimitive().isNumber())
+      throw new IllegalArgumentException("Expected number: " + key);
+    return v.getAsBigDecimal();
+  }
+
+  static boolean bool(JsonObject p, String key) {
+    var v = p.get(key);
+    if (v == null || !v.isJsonPrimitive() || !v.getAsJsonPrimitive().isBoolean())
+      throw new IllegalArgumentException("Expected boolean: " + key);
+    return v.getAsBoolean();
+  }
+
+  static UUID uuid(String text) {
+    UUID id = UUID.fromString(text);
+    if (!id.toString().equals(text)) throw new IllegalArgumentException("Noncanonical UUID");
+    return id;
+  }
+
+  static String checksum(String text) {
+    try {
+      return HexFormat.of()
+          .formatHex(
+              java.security.MessageDigest.getInstance("SHA-256")
+                  .digest(text.getBytes(StandardCharsets.UTF_8)));
+    } catch (java.security.NoSuchAlgorithmException e) {
+      throw new IllegalStateException(e);
+    }
+  }
+}
