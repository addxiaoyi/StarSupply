--- /dev/null
+++ b/src/test/java/dev/starcore/starcore/module/city/CitySnapshotPersistenceTest.java
@@ -0,0 +1,161 @@
+package dev.starcore.starcore.module.city;
+
+import static org.assertj.core.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+import dev.starcore.starcore.module.city.model.*;
+import dev.starcore.starcore.module.nation.model.NationId;
+import java.nio.file.*;
+import java.time.Instant;
+import java.util.*;
+import org.bukkit.*;
+import org.junit.jupiter.api.*;
+import org.junit.jupiter.api.io.TempDir;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.*;
+
+class CitySnapshotPersistenceTest {
+  @TempDir Path directory;
+
+  City city() {
+    return City.create(NationId.random(), "城市", UUID.randomUUID(), null);
+  }
+
+  @Test
+  void votesProgressFractionalSpawnAndOriginalTimestampsSurviveReload() {
+    var world = mock(World.class);
+    when(world.getName()).thenReturn("world");
+    var city = city();
+    city.setSpawnChunk(new Location(world, 1.25, 64.75, -8.125, 15.5f, -2.25f));
+    city.restoreProgress(8, 20, 100);
+    city.deposit(1.25);
+    city.setAnnouncement("公告<&>");
+    city.setPvpEnabled(true);
+    city.setPublicSpawn(false);
+    city.setOpenRecruitment(false);
+    city.addClaim("world", -4, 2);
+    var vote =
+        new City.CityVote(
+            "vote",
+            UUID.randomUUID(),
+            "投票",
+            City.VoteType.CHANGE_SETTINGS,
+            3600,
+            Instant.ofEpochMilli(123456));
+    vote.vote(UUID.randomUUID(), true);
+    vote.vote(UUID.randomUUID(), false);
+    city.restoreVote(vote);
+    city.setLastUpdated(Instant.ofEpochMilli(234567));
+    var storage = new DurableCityStorage(new FileCityLedgerStorage(directory));
+    storage.save(city);
+    try (var bukkit = mockStatic(Bukkit.class)) {
+      bukkit.when(() -> Bukkit.getWorld("world")).thenReturn(world);
+      var restored = storage.find(city.id()).orElseThrow();
+      assertThat(restored.maxLevel()).isEqualTo(20);
+      assertThat(restored.level()).isEqualTo(8);
+      assertThat(restored.experience()).isEqualTo(100);
+      assertThat(restored.spawnChunk()).isEqualTo(city.spawnChunk());
+      assertThat(restored.lastUpdated()).isEqualTo(city.lastUpdated());
+      assertThat(restored.getVote("vote").ballots()).isEqualTo(vote.ballots());
+      assertThat(restored.getVote("vote").createdAt()).isEqualTo(vote.createdAt());
+      assertThat(CitySnapshotCodec.encode(restored)).isEqualTo(CitySnapshotCodec.encode(city));
+    }
+  }
+
+  @Test
+  void unavailableWorldDoesNotDropSpawnAndRetirementNeedsNoWorld() {
+    var world = mock(World.class);
+    when(world.getName()).thenReturn("offline");
+    var city = city();
+    city.setSpawnChunk(new Location(world, 1.25, 60, 4));
+    var storage = new DurableCityStorage(new FileCityLedgerStorage(directory));
+    storage.save(city);
+    try (var bukkit = mockStatic(Bukkit.class)) {
+      assertThatThrownBy(storage::loadAll)
+          .isInstanceOf(IllegalStateException.class)
+          .hasMessageContaining("world unavailable");
+      assertThat(storage.retireNationCities(UUID.randomUUID(), city.nationId()).deletedCityIds())
+          .containsExactly(city.id());
+      assertThat(storage.loadAll()).isEmpty();
+    }
+  }
+
+  @Test
+  void legacyImportsOnceWithoutChangingOriginalSource() throws Exception {
+    var city = city();
+    var json = CitySnapshotCodec.parse(CitySnapshotCodec.encode(city));
+    json.remove("votes");
+    json.remove("maxLevel");
+    json.remove("claims");
+    String legacy = CitySnapshotCodec.canonical(json);
+    var file = directory.resolve(city.id() + ".json");
+    Files.writeString(file, legacy);
+    var storage = new DurableCityStorage(new FileCityLedgerStorage(directory));
+    assertThat(storage.loadAll()).hasSize(1);
+    storage.delete(city.id());
+    Files.writeString(file, "corrupted old copy");
+    assertThat(new DurableCityStorage(new FileCityLedgerStorage(directory)).loadAll()).isEmpty();
+    assertThat(Files.readString(file)).isEqualTo("corrupted old copy");
+  }
+
+  @ParameterizedTest
+  @ValueSource(strings = {"duplicate", "wrong-id", "invalid", "unknown-field"})
+  void invalidLegacyPreventsPartialMigration(String damage) throws Exception {
+    var good = city();
+    Files.writeString(directory.resolve(good.id() + ".json"), CitySnapshotCodec.encode(good));
+    var bad = city();
+    bad.setName("other");
+    String data = CitySnapshotCodec.encode(bad);
+    UUID filename = bad.id();
+    switch (damage) {
+      case "duplicate" -> data = data.replace("\"id\":", "\"id\":\"" + bad.id() + "\",\"id\":");
+      case "wrong-id" -> filename = UUID.randomUUID();
+      case "invalid" -> data = "{broken";
+      case "unknown-field" -> data = data.substring(0, data.length() - 1) + ",\"unexpected\":1}";
+    }
+    Files.writeString(directory.resolve(filename + ".json"), data);
+    assertThatThrownBy(() -> new DurableCityStorage(new FileCityLedgerStorage(directory)).loadAll())
+        .isInstanceOf(IllegalStateException.class);
+    assertThat(Files.exists(directory.resolve("ledger.json"))).isFalse();
+    assertThat(Files.exists(directory.resolve("ledger.initialized"))).isFalse();
+  }
+
+  @ParameterizedTest
+  @ValueSource(
+      strings = {
+        "{\"a\":1,\"a\":2}",
+        "{}{}",
+        "{/*x*/\"a\":1}",
+        "{\"a\":NaN}",
+        "{a:1}",
+        "{\"a\":'x'}",
+        "{\"a\":01}"
+      })
+  void rejectsNonJsonOrDuplicateProperties(String input) {
+    assertThatThrownBy(() -> CitySnapshotCodec.parse(input)).isInstanceOf(RuntimeException.class);
+  }
+
+  @Test
+  void corruptCurrentSnapshotDoesNotFallBackToPreRetirementBackup() throws Exception {
+    var storage = new DurableCityStorage(new FileCityLedgerStorage(directory));
+    var city = city();
+    storage.save(city);
+    storage.retireNationCities(UUID.randomUUID(), city.nationId());
+    var file = directory.resolve("ledger.json");
+    String data = Files.readString(file);
+    Files.writeString(file, data.replace("\"revision\":2", "\"revision\":1"));
+    assertThat(Files.exists(directory.resolve("ledger.json.bak"))).isTrue();
+    assertThatThrownBy(() -> new DurableCityStorage(new FileCityLedgerStorage(directory)).loadAll())
+        .isInstanceOf(IllegalStateException.class);
+  }
+
+  @Test
+  void saveCannotPersistNonfiniteMoney() {
+    var storage = new DurableCityStorage(new FileCityLedgerStorage(directory));
+    var city = city();
+    storage.save(city);
+    city.setTreasury(Double.NaN);
+    assertThatThrownBy(() -> storage.save(city)).isInstanceOf(RuntimeException.class);
+    assertThat(storage.find(city.id()).orElseThrow().treasury()).isZero();
+  }
+}
