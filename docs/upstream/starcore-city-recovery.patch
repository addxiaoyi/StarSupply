+  /** Restore validated progress without replaying experience awards or level-up actions. */
+  public void restoreProgress(int level, int maxLevel, int experience) {
+    if (level < 1 || maxLevel < level || maxLevel > 1000 || experience < 0)
+      throw new IllegalArgumentException("Invalid city progress");
+    this.level = level;
+    this.maxLevel = maxLevel;
+    this.experience = experience;
