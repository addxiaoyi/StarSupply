+  static final class FaultStore implements CityLedgerStorage {
+    final CityLedgerStorage delegate;
+    boolean fail, after, blockRead, unreadable;
+
+    FaultStore(CityLedgerStorage delegate) {
+      this.delegate = delegate;
+    }
+
+    public CityLedger load() {
+      if (unreadable) throw new IllegalStateException("read unavailable");
+      return delegate.load();
+    }
+
+    public void save(CityLedger ledger) {
+      if (!fail) {
+        delegate.save(ledger);
+        return;
+      }
+      fail = false;
+      if (after) delegate.save(ledger);
+      unreadable = blockRead;
+      throw new IllegalStateException("lost response");
+    }
+  }
