@@ -0,0 +1,23 @@
+package dev.starcore.starcore.module.city;
+
+import dev.starcore.starcore.module.nation.model.NationId;
+import java.util.*;
+
+/** Permanent nation closure in the city authority. The caller must persist disband intent first. */
+public interface CityRetirementService {
+  record CityRetirementReceipt(UUID operationId, NationId nationId, List<UUID> deletedCityIds) {
+    public CityRetirementReceipt {
+      Objects.requireNonNull(operationId);
+      Objects.requireNonNull(nationId);
+      deletedCityIds = List.copyOf(deletedCityIds);
+      if (deletedCityIds.size() > 100_000
+          || new HashSet<>(deletedCityIds).size() != deletedCityIds.size())
+        throw new IllegalArgumentException("Invalid retired city IDs");
+      deletedCityIds = deletedCityIds.stream().sorted().toList();
+    }
+  }
+
+  CityRetirementReceipt retireNationCities(UUID operationId, NationId nationId);
+
+  Optional<CityRetirementReceipt> cityRetirementReceipt(NationId nationId);
+}
