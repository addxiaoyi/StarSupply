+  void simultaneousCreateAndRetireCannotReopenNation(boolean sql) throws Exception {
+    var stores = stores(sql);
+    stores.get().load();
+    var barrier = new CyclicBarrier(2);
+    Supplier<CityLedgerStorage> racing =
+        () ->
+            new CityLedgerStorage() {
+              final CityLedgerStorage delegate = stores.get();
+              boolean first = true;
+
+              public CityLedger load() {
+                return delegate.load();
+              }
+
+              public void save(CityLedger ledger) {
+                if (first) {
+                  first = false;
+                  try {
+                    barrier.await(10, TimeUnit.SECONDS);
+                  } catch (Exception e) {
+                    throw new IllegalStateException(e);
+                  }
+                }
+                delegate.save(ledger);
+              }
+            };
+    var writer = new DurableCityStorage(racing.get());
+    var closer = new DurableCityStorage(racing.get());
+    var nation = NationId.random();
+    var id = UUID.randomUUID();
+    try (var executor = Executors.newFixedThreadPool(2)) {
+      var one =
+          executor.submit(
+              () -> {
+                try {
+                  writer.save(city(nation, "racing"));
+                } catch (IllegalStateException conflict) {
+                }
+              });
+      var two =
+          executor.submit(
+              () -> {
+                try {
+                  closer.retireNationCities(id, nation);
+                } catch (IllegalStateException conflict) {
+                }
+              });
+      one.get(15, TimeUnit.SECONDS);
+      two.get(15, TimeUnit.SECONDS);
+    }
+    var restarted = new DurableCityStorage(stores.get());
+    restarted.retireNationCities(id, nation);
+    assertThat(restarted.loadAll()).isEmpty();
+    assertThatThrownBy(() -> restarted.save(city(nation, "late")))
+        .isInstanceOf(IllegalArgumentException.class);
+  }
