+    var storage = new DurableCityStorage(fault);
+    var nations = mock(NationService.class);
+    var nation = mock(Nation.class);
+    var nationId = NationId.random();
+    var mayor = UUID.randomUUID();
+    when(nation.id()).thenReturn(nationId);
+    when(nations.nationById(nationId)).thenReturn(Optional.of(nation));
+    when(nations.nationOf(mayor)).thenReturn(Optional.of(nation));
+    var service = new CityService(storage, nations);
+    fault.fail = true;
+    assertThatThrownBy(() -> service.createCity(nationId, "city", mayor, null))
+        .isInstanceOf(IllegalStateException.class);
+    assertThat(service.getAllCities()).isEmpty();
+    assertThat(service.getPlayerCity(mayor)).isEmpty();
+    assertThat(service.createCity(nationId, "city", mayor, null).success()).isTrue();
+  }
+
+  @Test
+  void bulkMembershipKeepsMayorAndForeignCityIndexes() {
+    var storage = new DurableCityStorage(stores(false).get());
+    var first = city(NationId.random(), "first");
+    var other = city(NationId.random(), "other");
+    storage.saveAll(List.of(first, other));
+    var service = new CityService(storage, mock(NationService.class));
+    var mayor = first.residents().keySet().iterator().next();
+    var foreign = other.residents().keySet().iterator().next();
+    var member = UUID.randomUUID();
+    assertThat(
+            service.addResidents(
+                first.id(), Map.of(member, CityRank.RESIDENT, foreign, CityRank.RESIDENT)))
+        .isEqualTo(1);
+    assertThat(service.removeResidents(first.id(), List.of(mayor, member, foreign))).isEqualTo(1);
+    assertThat(service.getPlayerCity(mayor)).contains(first);
+    assertThat(service.getPlayerCity(foreign)).contains(other);
+    assertThat(service.getPlayerCity(member)).isEmpty();
+    assertThat(service.kickResident(UUID.randomUUID(), member)).isFalse();
+  }
+
+  @Test
+  void creationDoesNotHoldCityMonitorWhileWaitingForNation() throws Exception {
+    var storage = new DurableCityStorage(stores(false).get());
+    var nation = NationId.random();
+    var nations = mock(NationService.class);
+    var entered = new CountDownLatch(1);
+    var release = new CountDownLatch(1);
+    when(nations.nationById(nation))
+        .thenAnswer(
+            call -> {
+              entered.countDown();
+              if (!release.await(5, TimeUnit.SECONDS)) throw new IllegalStateException("deadlock");
+              return Optional.empty();
+            });
+    var service = new CityService(storage, nations);
+    try (var executor = Executors.newFixedThreadPool(2)) {
+      var create =
+          executor.submit(() -> service.createCity(nation, "city", UUID.randomUUID(), null));
+      assertThat(entered.await(5, TimeUnit.SECONDS)).isTrue();
+      try {
+        assertThat(
+                executor
+                    .submit(() -> service.retireNationCities(UUID.randomUUID(), nation))
+                    .get(2, TimeUnit.SECONDS)
+                    .deletedCityIds())
+            .isEmpty();
+      } finally {
+        release.countDown();
+      }
+      assertThat(create.get(5, TimeUnit.SECONDS).success()).isFalse();
+    }
+  }
+
+  @Test
+  void externalCallbackCannotReenterCityMutations() {
+    var storage = new DurableCityStorage(stores(false).get());
+    var nation = NationId.random();
+    var nations = mock(NationService.class);
+    var service = new CityService(storage, nations);
+    when(nations.nationById(nation))
+        .thenAnswer(
+            call -> {
+              assertThatThrownBy(
+                      () -> service.createCity(nation, "nested", UUID.randomUUID(), null))
+                  .isInstanceOf(IllegalStateException.class);
+              assertThatThrownBy(service::shutdown).isInstanceOf(IllegalStateException.class);
+              return Optional.empty();
+            });
+    assertThat(service.createCity(nation, "outer", UUID.randomUUID(), null).success()).isFalse();
+    assertThat(service.getAllCities()).isEmpty();
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void staleCreationAndDeletionCannotBorrowLatestAuthority(boolean sql) {
+    var stores = stores(sql);
+    var left = new DurableCityStorage(stores.get());
+    left.loadAll();
+    var expected = left.loadedFingerprint();
+    var right = new DurableCityStorage(stores.get());
+    var city = city(NationId.random(), "other");
+    right.save(city);
+    left.currentFingerprint();
+    assertThatThrownBy(() -> left.saveAtFingerprint(city(NationId.random(), "stale"), expected))
+        .isInstanceOf(IllegalStateException.class);
+    assertThatThrownBy(() -> left.deleteAtFingerprint(city.id(), expected))
+        .isInstanceOf(IllegalStateException.class);
+    assertThat(left.loadAll()).containsExactly(city);
+  }
+}
diff --git a/src/test/java/dev/starcore/starcore/module/city/CitySnapshotPersistenceTest.java b/src/test/java/dev/starcore/starcore/module/city/CitySnapshotPersistenceTest.java
