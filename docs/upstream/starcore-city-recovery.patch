+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void authorityRejectsStaleOrForgedRetirement(boolean sql) {
+    var stores = stores(sql);
+    var storage = new DurableCityStorage(stores.get());
+    var city = city(NationId.random(), "city");
+    storage.save(city);
+    var left = stores.get();
+    var before = left.load();
+    var right = stores.get();
+    var original = right.load();
+    var updated = new HashMap<>(original.cities());
+    var model = CitySnapshotCodec.decode(updated.get(city.id()));
+    model.deposit(5);
+    updated.put(city.id(), CitySnapshotCodec.encode(model));
+    right.save(original.next(updated, original.deleted(), original.retirements()));
+    assertThatThrownBy(
+            () -> left.save(before.next(before.cities(), before.deleted(), before.retirements())))
+        .isInstanceOf(IllegalStateException.class);
+    var current = left.load();
+    var forged =
+        new CityRetirementService.CityRetirementReceipt(
+            UUID.randomUUID(), city.nationId(), List.of());
+    var candidate = current.next(Map.of(), Set.of(city.id()), Map.of(city.nationId(), forged));
+    assertThatThrownBy(() -> left.save(candidate)).isInstanceOf(IllegalStateException.class);
+    assertThat(new DurableCityStorage(stores.get()).find(city.id()).orElseThrow().treasury())
+        .isEqualTo(5);
