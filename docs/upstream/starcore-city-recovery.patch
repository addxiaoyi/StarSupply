@@ -0,0 +1,108 @@
+package dev.starcore.starcore.module.city;
+
+import dev.starcore.starcore.core.persistence.AtomicFilePersistence;
+import java.io.*;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.*;
+import java.util.*;
+
+/** File mode is single-process; striped locks also coordinate multiple services in that process. */
+final class FileCityLedgerStorage implements CityLedgerStorage {
+  private static final Object[] GUARDS = new Object[64];
+
+  static {
+    Arrays.setAll(GUARDS, ignored -> new Object());
+  }
+
+  private final Path directory, path, marker;
+  private String expected;
+
+  FileCityLedgerStorage(Path directory) {
+    this.directory = directory.toAbsolutePath().normalize();
+    path = this.directory.resolve("ledger.json");
+    marker = this.directory.resolve("ledger.initialized");
+  }
+
+  private Object guard() {
+    return GUARDS[Math.floorMod(path.hashCode(), GUARDS.length)];
+  }
+
+  public synchronized CityLedger load() {
+    synchronized (guard()) {
+      try {
+        Files.createDirectories(directory);
+        if (Files.exists(path)) {
+          if (!Files.isRegularFile(marker) || !Files.readString(marker).equals("city-ledger-v1"))
+            throw new IOException("Missing city authority marker");
+          var data = read(path);
+          var result = CityLedger.decode(data);
+          expected = data;
+          return result;
+        }
+        if (expected != null
+            || Files.exists(marker)
+            || Files.exists(AtomicFilePersistence.temp(marker))
+            || Files.exists(AtomicFilePersistence.backup(marker))
+            || Files.exists(AtomicFilePersistence.temp(path))
+            || Files.exists(AtomicFilePersistence.backup(path)))
+          throw new IOException("Missing city authority; explicit reconciliation required");
+        var initial = legacy();
+        String data = initial.encode();
+        AtomicFilePersistence.replace(marker, temp -> Files.writeString(temp, "city-ledger-v1"));
+        AtomicFilePersistence.replace(
+            path, temp -> Files.writeString(temp, data, StandardCharsets.UTF_8));
+        if (!read(path).equals(data)) throw new IOException("City authority not published");
+        expected = data;
+        return initial;
+      } catch (IOException | RuntimeException e) {
+        throw new IllegalStateException("City authority requires reconciliation", e);
+      }
+    }
+  }
+
+  private CityLedger legacy() throws IOException {
+    Map<UUID, String> cities = new HashMap<>();
+    try (var files = Files.list(directory)) {
+      for (var file : files.filter(f -> f.getFileName().toString().endsWith(".json")).toList()) {
+        String name = file.getFileName().toString();
+        UUID id = CitySnapshotCodec.uuid(name.substring(0, name.length() - 5));
+        String value = CitySnapshotCodec.normalizeLegacy(read(file));
+        if (!CitySnapshotCodec.parse(value).get("id").getAsString().equals(id.toString())
+            || cities.putIfAbsent(id, value) != null)
+          throw new IOException("Legacy city identity mismatch");
+      }
+    }
+    return new CityLedger(0, cities, Set.of(), Map.of());
+  }
+
+  public synchronized void save(CityLedger ledger) {
+    String candidate = ledger.encode();
+    synchronized (guard()) {
+      if (expected == null) throw new IllegalStateException("Load city authority before writing");
+      try {
+        String actual = read(path);
+        if (!actual.equals(expected))
+          throw new IllegalStateException("Stale city authority; reload and retry");
+        if (!Files.isRegularFile(marker) || !Files.readString(marker).equals("city-ledger-v1"))
+          throw new IOException("Missing city authority marker");
+        ledger.requireSuccessorOf(CityLedger.decode(actual));
+        AtomicFilePersistence.replace(
+            path, temp -> Files.writeString(temp, candidate, StandardCharsets.UTF_8));
+        if (!read(path).equals(candidate)) throw new IOException("City snapshot not published");
+        expected = candidate;
+      } catch (IOException e) {
+        throw new IllegalStateException("City file save failed", e);
+      }
+    }
+  }
+
+  private String read(Path file) throws IOException {
+    if (!Files.isRegularFile(file) || Files.size(file) > 64 * 1024 * 1024)
+      throw new IOException("Invalid city authority file");
+    try (var input = Files.newInputStream(file)) {
+      byte[] bytes = input.readNBytes(64 * 1024 * 1024 + 1);
+      if (bytes.length > 64 * 1024 * 1024) throw new IOException("City file too large");
+      return StandardCharsets.UTF_8.newDecoder().decode(java.nio.ByteBuffer.wrap(bytes)).toString();
+    }
+  }
+}
