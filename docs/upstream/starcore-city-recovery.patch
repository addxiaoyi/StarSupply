+    var nation = NationId.random();
+    var first = city(nation, "first");
+    var later = city(nation, "later");
+    var kept = city(NationId.random(), "kept");
+    storage.saveAll(List.of(first, later, kept));
+    var stale = storage.find(first.id()).orElseThrow();
+    var id = UUID.randomUUID();
+    var receipt = storage.retireNationCities(id, nation);
+    assertThat(receipt.deletedCityIds()).containsExactlyInAnyOrder(first.id(), later.id());
+    var restarted = new DurableCityStorage(stores.get());
+    assertThat(restarted.retireNationCities(id, nation)).isEqualTo(receipt);
+    assertThat(restarted.loadAll()).extracting(City::id).containsExactly(kept.id());
+    assertThatThrownBy(() -> storage.save(stale)).isInstanceOf(IllegalStateException.class);
+    assertThatThrownBy(() -> restarted.save(first)).isInstanceOf(IllegalArgumentException.class);
+    assertThatThrownBy(() -> restarted.save(city(nation, "late")))
+        .isInstanceOf(IllegalArgumentException.class);
+    assertThatThrownBy(() -> restarted.retireNationCities(UUID.randomUUID(), nation))
+        .isInstanceOf(IllegalStateException.class);
+    assertThat(restarted.cityRetirementReceipt(nation)).contains(receipt);
+  }
