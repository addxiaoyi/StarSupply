diff --git a/src/main/java/dev/starcore/starcore/module/city/CityLedger.java b/src/main/java/dev/starcore/starcore/module/city/CityLedger.java
new file mode 100644
index 0000000..3e3ed5e
--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/module/city/CityLedger.java
@@ -0,0 +1,166 @@
+package dev.starcore.starcore.module.city;
+
+import com.google.gson.*;
+import dev.starcore.starcore.module.city.CityRetirementService.CityRetirementReceipt;
+import dev.starcore.starcore.module.nation.model.NationId;
+import java.util.*;
+
+/** Immutable city authority. Deleted identities and retired nations can never be reopened. */
+record CityLedger(
+    long revision,
+    Map<UUID, String> cities,
+    Set<UUID> deleted,
+    Map<NationId, CityRetirementReceipt> retirements) {
+  CityLedger {
+    if (revision < 0 || revision == Long.MAX_VALUE)
+      throw new IllegalArgumentException("Invalid city revision");
+    cities = Map.copyOf(cities);
+    deleted = Set.copyOf(deleted);
+    retirements = Map.copyOf(retirements);
+    if (cities.size() > 100_000 || deleted.size() > 100_000 || retirements.size() > 100_000)
+      throw new IllegalArgumentException("City authority capacity exceeded");
+    Set<String> names = new HashSet<>();
+    Set<UUID> residents = new HashSet<>();
+    for (var entry : cities.entrySet()) {
+      var p = CitySnapshotCodec.parse(entry.getValue());
+      CitySnapshotCodec.validate(p);
+      if (!entry.getKey().toString().equals(p.get("id").getAsString())
+          || deleted.contains(entry.getKey())
+          || retirements.containsKey(NationId.fromString(p.get("nationId").getAsString()))
+          || !entry.getValue().equals(CitySnapshotCodec.canonical(p)))
+        throw new IllegalArgumentException("Invalid live city identity");
+      if (!names.add(p.get("name").getAsString().toLowerCase(Locale.ROOT)))
+        throw new IllegalArgumentException("Duplicate city name");
+      for (var player : p.getAsJsonObject("residents").keySet())
+        if (!residents.add(UUID.fromString(player)))
+          throw new IllegalArgumentException("Resident belongs to multiple cities");
+    }
+    for (var entry : retirements.entrySet())
+      if (!entry.getKey().equals(entry.getValue().nationId())
+          || !deleted.containsAll(entry.getValue().deletedCityIds()))
+        throw new IllegalArgumentException("Invalid city retirement");
+  }
+
+  static CityLedger empty() {
+    return new CityLedger(0, Map.of(), Set.of(), Map.of());
+  }
+
+  NationId owner(UUID cityId) {
+    return NationId.fromString(
+        CitySnapshotCodec.parse(cities.get(cityId)).get("nationId").getAsString());
+  }
+
+  List<UUID> ownedBy(NationId nation) {
+    return cities.keySet().stream().filter(id -> owner(id).equals(nation)).sorted().toList();
+  }
+
+  CityLedger next(
+      Map<UUID, String> values, Set<UUID> removed, Map<NationId, CityRetirementReceipt> retired) {
+    return new CityLedger(Math.addExact(revision, 1), values, removed, retired);
+  }
+
+  void requireSuccessorOf(CityLedger previous) {
+    if (revision != previous.revision + 1
+        || !deleted.containsAll(previous.deleted)
+        || !retirements.entrySet().containsAll(previous.retirements.entrySet()))
+      throw new IllegalStateException("City revision or permanent history changed");
+    for (var id : previous.cities.keySet()) {
+      if (!cities.containsKey(id) && !deleted.contains(id))
+        throw new IllegalStateException("Missing city deletion receipt");
+      if (cities.containsKey(id) && !owner(id).equals(previous.owner(id)))
+        throw new IllegalStateException("City owner cannot change");
+    }
+    for (var e : retirements.entrySet())
+      if (!previous.retirements.containsKey(e.getKey())
+          && !e.getValue().deletedCityIds().equals(previous.ownedBy(e.getKey())))
+        throw new IllegalStateException("City retirement must record actual authority cities");
+  }
+
+  String encode() {
+    var p = new JsonObject();
+    p.addProperty("format", 1);
+    p.addProperty("revision", revision);
+    var values = new JsonObject();
+    cities.forEach((id, value) -> values.add(id.toString(), CitySnapshotCodec.parse(value)));
+    p.add("cities", values);
+    var removed = new JsonArray();
+    deleted.stream().sorted().forEach(id -> removed.add(id.toString()));
+    p.add("deleted", removed);
+    var retired = new JsonObject();
+    retirements.forEach(
+        (nation, receipt) -> {
+          var r = new JsonObject();
+          r.addProperty("operationId", receipt.operationId().toString());
+          var ids = new JsonArray();
+          receipt.deletedCityIds().forEach(id -> ids.add(id.toString()));
+          r.add("cityIds", ids);
+          retired.add(nation.toString(), r);
+        });
+    p.add("retirements", retired);
+    p.addProperty("checksum", CitySnapshotCodec.checksum(CitySnapshotCodec.canonical(p)));
+    String text = CitySnapshotCodec.canonical(p);
+    if (text.getBytes(java.nio.charset.StandardCharsets.UTF_8).length > 64 * 1024 * 1024)
+      throw new IllegalArgumentException("City authority too large");
+    return text;
+  }
+
+  String fingerprint() {
+    return CitySnapshotCodec.checksum(encode());
+  }
+
+  static CityLedger decode(String text) {
+    var p = CitySnapshotCodec.parse(text);
+    CitySnapshotCodec.fields(
+        p, Set.of("format", "revision", "cities", "deleted", "retirements", "checksum"), Set.of());
+    if (CitySnapshotCodec.number(p, "format").intValueExact() != 1)
+      throw new IllegalArgumentException("Unsupported city authority");
+    String checksum = CitySnapshotCodec.string(p, "checksum", 64);
+    p.remove("checksum");
+    if (!CitySnapshotCodec.checksum(CitySnapshotCodec.canonical(p)).equals(checksum))
+      throw new IllegalArgumentException("City authority checksum mismatch");
+    Map<UUID, String> cities = new HashMap<>();
+    p.getAsJsonObject("cities")
+        .entrySet()
+        .forEach(
+            e -> {
+              UUID id = CitySnapshotCodec.uuid(e.getKey());
+              if (cities.putIfAbsent(id, CitySnapshotCodec.canonical(e.getValue())) != null)
+                throw new IllegalArgumentException("Duplicate city");
+            });
+    Set<UUID> deleted = new HashSet<>();
+    p.getAsJsonArray("deleted")
+        .forEach(
+            id -> {
+              if (!id.isJsonPrimitive()
+                  || !id.getAsJsonPrimitive().isString()
+                  || !deleted.add(CitySnapshotCodec.uuid(id.getAsString())))
+                throw new IllegalArgumentException("Invalid city deletion");
+            });
+    Map<NationId, CityRetirementReceipt> retirements = new HashMap<>();
+    p.getAsJsonObject("retirements")
+        .entrySet()
+        .forEach(
+            e -> {
+              var nation = NationId.of(CitySnapshotCodec.uuid(e.getKey()));
+              var r = e.getValue().getAsJsonObject();
+              CitySnapshotCodec.fields(r, Set.of("operationId", "cityIds"), Set.of());
+              List<UUID> ids = new ArrayList<>();
+              r.getAsJsonArray("cityIds")
+                  .forEach(
+                      id -> {
+                        if (!id.isJsonPrimitive() || !id.getAsJsonPrimitive().isString())
+                          throw new IllegalArgumentException("Invalid retired city ID");
+                        ids.add(CitySnapshotCodec.uuid(id.getAsString()));
+                      });
+              var receipt =
+                  new CityRetirementReceipt(
+                      CitySnapshotCodec.uuid(CitySnapshotCodec.string(r, "operationId", 36)),
+                      nation,
+                      ids);
+              if (retirements.putIfAbsent(nation, receipt) != null)
+                throw new IllegalArgumentException("Duplicate city retirement");
+            });
+    return new CityLedger(
+        CitySnapshotCodec.number(p, "revision").longValueExact(), cities, deleted, retirements);
+  }
+}
