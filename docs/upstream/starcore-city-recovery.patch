+    assertThatThrownBy(() -> storage.retireNationCities(id, city.nationId()))
+        .isInstanceOf(IllegalStateException.class);
+    var restarted = new DurableCityStorage(stores.get());
+    assertThat(restarted.cityRetirementReceipt(city.nationId()).isPresent()).isEqualTo(after);
+    assertThat(restarted.retireNationCities(id, city.nationId()).deletedCityIds())
+        .containsExactly(city.id());
+    fault.unreadable = false;
+    assertThat(storage.retireNationCities(id, city.nationId()).deletedCityIds())
+        .containsExactly(city.id());
+  }
