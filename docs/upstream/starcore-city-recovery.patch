+package dev.starcore.starcore.module.city;
+
+import dev.starcore.starcore.core.database.DatabaseService;
+import dev.starcore.starcore.core.storage.StateStorageBackend;
+import java.nio.file.Path;
+
+final class DatabaseAwareCityStorage extends DurableCityStorage {
+  DatabaseAwareCityStorage(Path directory, DatabaseService database) {
+    super(pinned(directory, database));
+  }
+
+  private static CityLedgerStorage pinned(Path directory, DatabaseService database) {
+    var backend = new StateStorageBackend(database);
+    var file = new FileCityLedgerStorage(directory);
+    var sql = new SqlCityLedgerStorage(backend::dataSource, file::load);
+    return new CityLedgerStorage() {
+      private CityLedgerStorage active() {
+        return backend.usesDatabase() ? sql : file;
+      }
+
+      public CityLedger load() {
+        return active().load();
+      }
+
+      public void save(CityLedger ledger) {
+        active().save(ledger);
+      }
+    };
+  }
+}
diff --git a/src/main/java/dev/starcore/starcore/module/city/DurableCityStorage.java b/src/main/java/dev/starcore/starcore/module/city/DurableCityStorage.java
new file mode 100644
index 0000000..526e14a
--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/module/city/DurableCityStorage.java
@@ -0,0 +1,173 @@
+package dev.starcore.starcore.module.city;
+
+import dev.starcore.starcore.module.city.model.City;
+import dev.starcore.starcore.module.nation.model.NationId;
+import java.lang.ref.*;
+import java.util.*;
+
+/** Mutable models retain their original authority version, independent of later reads. */
+class DurableCityStorage implements CityRevisionStorage {
+  private final CityLedgerStorage storage;
+  private final ReferenceQueue<City> collected = new ReferenceQueue<>();
+  private final Map<IdentityReference, String> provenance = new HashMap<>();
+  private String loadedFingerprint;
+
+  DurableCityStorage(CityLedgerStorage storage) {
+    this.storage = Objects.requireNonNull(storage);
+  }
+
+  private static final class IdentityReference extends WeakReference<City> {
+    private final int hash;
+
+    IdentityReference(City city, ReferenceQueue<City> queue) {
+      super(city, queue);
+      hash = System.identityHashCode(city);
+    }
+
+    public int hashCode() {
+      return hash;
+    }
+
+    public boolean equals(Object other) {
+      return this == other
+          || other instanceof IdentityReference ref && get() != null && get() == ref.get();
+    }
+  }
+
+  private void remember(City city, String fingerprint) {
+    Reference<? extends City> ref;
+    while ((ref = collected.poll()) != null) provenance.remove(ref);
+    provenance.put(new IdentityReference(city, collected), fingerprint);
+  }
+
+  private City model(String value, String fingerprint) {
+    var city = CitySnapshotCodec.decode(value);
+    remember(city, fingerprint);
+    return city;
+  }
+
+  public synchronized Collection<City> loadAll() {
+    var ledger = storage.load();
+    String fingerprint = ledger.fingerprint();
+    List<City> values = new ArrayList<>();
+    for (var value : ledger.cities().values()) values.add(model(value, fingerprint));
+    loadedFingerprint = fingerprint;
+    return List.copyOf(values);
+  }
+
+  public synchronized Optional<City> find(UUID cityId) {
+    var ledger = storage.load();
+    var value = ledger.cities().get(Objects.requireNonNull(cityId));
+    return value == null ? Optional.empty() : Optional.of(model(value, ledger.fingerprint()));
+  }
+
+  public synchronized String currentFingerprint() {
+    return storage.load().fingerprint();
+  }
+
+  public synchronized String loadedFingerprint() {
+    return loadedFingerprint;
+  }
+
+  public synchronized void save(City city) {
+    saveAll(List.of(city));
+  }
+
+  public synchronized void saveAll(Collection<City> cities) {
+    saveInputs(cities, null);
+  }
+
+  public synchronized void saveAtFingerprint(City city, String fingerprint) {
+    saveAllAtFingerprint(List.of(city), fingerprint);
+  }
+
+  public synchronized void saveAllAtFingerprint(Collection<City> cities, String fingerprint) {
+    saveInputs(cities, Objects.requireNonNull(fingerprint));
+  }
+
+  private void saveInputs(Collection<City> cities, String expectedFingerprint) {
+    var inputs = List.copyOf(cities);
+    var previous = storage.load();
+    String fingerprint = previous.fingerprint();
+    if (expectedFingerprint != null && !expectedFingerprint.equals(fingerprint))
+      throw new IllegalStateException("City authority changed before write");
+    Map<UUID, String> values = new HashMap<>(previous.cities());
+    Set<UUID> seen = new HashSet<>();
+    for (var city : inputs) {
+      Objects.requireNonNull(city);
+      if (!seen.add(city.id())) throw new IllegalArgumentException("Duplicate city in save batch");
+      String original = provenance.get(new IdentityReference(city, null));
+      if (previous.cities().containsKey(city.id()) && !fingerprint.equals(original))
+        throw new IllegalStateException("Stale or detached city; reload before editing");
+      if (!previous.cities().containsKey(city.id()) && original != null)
+        throw new IllegalStateException("Previously published city cannot be recreated");
+      values.put(city.id(), CitySnapshotCodec.encode(city));
+    }
+    if (values.equals(previous.cities())) return;
+    var candidate = previous.next(values, previous.deleted(), previous.retirements());
+    commit(candidate);
+    for (var city : inputs) remember(city, candidate.fingerprint());
+  }
+
+  public synchronized void delete(UUID cityId) {
+    deleteInput(cityId, null);
+  }
+
+  public synchronized void deleteAtFingerprint(UUID cityId, String fingerprint) {
+    deleteInput(cityId, Objects.requireNonNull(fingerprint));
+  }
+
+  private void deleteInput(UUID cityId, String fingerprint) {
+    Objects.requireNonNull(cityId);
+    var previous = storage.load();
+    if (fingerprint != null && !fingerprint.equals(previous.fingerprint()))
+      throw new IllegalStateException("City authority changed before deletion");
+    if (previous.deleted().contains(cityId)) return;
+    Map<UUID, String> values = new HashMap<>(previous.cities());
+    values.remove(cityId);
+    Set<UUID> deleted = new HashSet<>(previous.deleted());
+    deleted.add(cityId);
+    commit(previous.next(values, deleted, previous.retirements()));
+  }
+
+  public synchronized CityRetirementReceipt retireNationCities(
+      UUID operationId, NationId nationId) {
+    Objects.requireNonNull(operationId);
+    Objects.requireNonNull(nationId);
+    var previous = storage.load();
+    var existing = previous.retirements().get(nationId);
+    if (existing != null) {
+      if (!existing.operationId().equals(operationId))
+        throw new IllegalStateException("Nation cities already retired by another operation");
+      return existing;
+    }
+    var ids = previous.ownedBy(nationId);
+    var receipt = new CityRetirementReceipt(operationId, nationId, ids);
+    Map<UUID, String> values = new HashMap<>(previous.cities());
+    ids.forEach(values::remove);
+    Set<UUID> deleted = new HashSet<>(previous.deleted());
+    deleted.addAll(ids);
+    Map<NationId, CityRetirementReceipt> retired = new HashMap<>(previous.retirements());
+    retired.put(nationId, receipt);
+    commit(previous.next(values, deleted, retired));
+    return receipt;
+  }
+
+  public synchronized Optional<CityRetirementReceipt> cityRetirementReceipt(NationId nationId) {
+    return Optional.ofNullable(storage.load().retirements().get(Objects.requireNonNull(nationId)));
+  }
+
+  private void commit(CityLedger candidate) {
+    try {
+      storage.save(candidate);
+    } catch (RuntimeException failure) {
+      // A lost response is success only if the complete proposed authority is observed.
+      try {
+        if (candidate.equals(storage.load())) return;
+      } catch (RuntimeException unreadable) {
+        if (unreadable != failure) failure.addSuppressed(unreadable);
+      }
+      throw failure;
+    }
+  }
+}
