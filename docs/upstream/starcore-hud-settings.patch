+import org.mockito.MockedConstruction;
+
+final class HudTestFixture implements AutoCloseable {
+  final FeedbackSchedulerFixture scheduler = new FeedbackSchedulerFixture();
+  final ManualIo io = new ManualIo();
+  final AtomicBoolean failWrites = new AtomicBoolean();
+  final HudPreferences preferences;
+  final ModernHudListener listener;
+  final HudCommand command;
+  final Map<Player, AtomicReference<Inventory>> visible = new HashMap<>();
+  final List<Inventory> inventories = new ArrayList<>();
+  final MockedConstruction<ItemStack> items;
+
+  HudTestFixture(Path directory) {
+    when(scheduler.plugin.getDataFolder()).thenReturn(directory.toFile());
+    when(scheduler.plugin.getLogger()).thenReturn(Logger.getAnonymousLogger());
+    when(scheduler.plugin.getServer().getOnlinePlayers()).thenAnswer(ignored -> scheduler.players);
+    items =
+        mockConstruction(
+            ItemStack.class,
+            (item, context) -> {
+              when(item.getType()).thenReturn((Material) context.arguments().getFirst());
+              when(item.getItemMeta()).thenReturn(mock(ItemMeta.class));
+            });
+    preferences =
+        new HudPreferences(
+            directory,
+            scheduler.plugin.getLogger(),
+            io,
+            (file, content) -> {
+              if (failWrites.get()) throw new IOException("injected disk error");
+              AtomicFilePersistence.replace(file, temp -> Files.writeString(temp, content));
+            });
+    listener = ModernHudListener.initialize(scheduler.plugin, preferences);
+    NationModule nation = mock(NationModule.class);
+    when(nation.nationOf(any())).thenReturn(Optional.empty());
+    command = new HudCommand(scheduler.plugin, nation, mock(MessageService.class));
+    scheduler
+        .bukkit
+        .when(() -> Bukkit.createInventory(any(InventoryHolder.class), anyInt(), anyString()))
+        .thenAnswer(
+            call -> {
+              InventoryHolder holder = call.getArgument(0);
+              int size = call.getArgument(1);
+              assertSame(((ModernHudMenu) holder).getPlayer(), scheduler.owner);
+              ItemStack[] slots = new ItemStack[size];
+              Inventory inventory = mock(Inventory.class);
+              when(inventory.getSize()).thenReturn(size);
+              when(inventory.getItem(anyInt()))
+                  .thenAnswer(slot -> slots[slot.getArgument(0, Integer.class)]);
+              doAnswer(
+                      slot -> {
+                        assertSame(((ModernHudMenu) holder).getPlayer(), scheduler.owner);
+                        slots[slot.getArgument(0, Integer.class)] = slot.getArgument(1);
+                        return null;
+                      })
+                  .when(inventory)
+                  .setItem(anyInt(), nullable(ItemStack.class));
+              inventories.add(inventory);
+              return inventory;
+            });
+  }
+
+  Player player(double x) {
+    Player player = scheduler.player(x);
+    when(player.getName()).thenReturn("HudPlayer");
+    AtomicReference<Inventory> top = new AtomicReference<>(mock(Inventory.class));
+    visible.put(player, top);
+    InventoryView view = mock(InventoryView.class);
+    when(view.getTopInventory()).thenAnswer(ignored -> top.get());
+    when(player.getOpenInventory()).thenReturn(view);
+    when(player.openInventory(any(Inventory.class)))
+        .thenAnswer(
+            call -> {
+              assertSame(player, scheduler.owner);
+              closeEvent(player, top.get());
+              top.set(call.getArgument(0));
+              return view;
+            });
+    doAnswer(
+            ignored -> {
+              assertSame(player, scheduler.owner);
+              closeEvent(player, top.get());
+              top.set(mock(Inventory.class));
+              return null;
+            })
+        .when(player)
+        .closeInventory();
+    doAnswer(
+            ignored -> {
+              assertSame(player, scheduler.owner, "feedback must run on player owner");
+              return null;
+            })
+        .when(player)
+        .sendMessage(any(Component.class));
+    return player;
+  }
+
+  void command(Player player, String... arguments) {
+    scheduler.owner = player;
+    command.onCommand(player, mock(Command.class), "hud", arguments);
+    scheduler.owner = null;
+  }
+
+  ModernHudMenu menu(Player player) {
+    command(player);
+    return ModernHudListener.getMenu(player);
+  }
+
+  void drainIo() {
+    scheduler.owner = null;
+    io.drain();
+  }
+
+  void tickOwners() {
+    for (var pending : List.copyOf(scheduler.pending)) pending.tick();
+  }
+
+  private void closeEvent(Player player, Inventory inventory) {
+    InventoryCloseEvent event = mock(InventoryCloseEvent.class);
+    when(event.getPlayer()).thenReturn(player);
+    when(event.getInventory()).thenReturn(inventory);
+    listener.onInventoryClose(event);
+  }
+
+  @Override
+  public void close() {
+    listener.shutdown();
+    items.close();
+    scheduler.close();
+  }
+
+  static final class ManualIo extends AbstractExecutorService {
+    final ArrayDeque<Runnable> jobs = new ArrayDeque<>();
+    boolean stopped;
+
+    void drain() {
+      while (!jobs.isEmpty()) jobs.remove().run();
+    }
+
+    @Override
+    public void execute(Runnable action) {
+      if (stopped) throw new RejectedExecutionException();
+      jobs.add(action);
+    }
+
+    @Override
+    public void shutdown() {
+      stopped = true;
+      drain();
+    }
+
+    @Override
+    public List<Runnable> shutdownNow() {
+      stopped = true;
+      var discarded = List.copyOf(jobs);
+      jobs.clear();
+      return discarded;
+    }
+
+    @Override
+    public boolean isShutdown() {
+      return stopped;
+    }
+
+    @Override
+    public boolean isTerminated() {
+      return stopped && jobs.isEmpty();
+    }
+
+    @Override
+    public boolean awaitTermination(long timeout, TimeUnit unit) {
+      return isTerminated();
+    }
+  }
+}
