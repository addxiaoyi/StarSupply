@@ -0,0 +1,300 @@
+package dev.starcore.starcore.foundation.hud;
+
+import dev.starcore.starcore.core.persistence.AtomicFilePersistence;
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.*;
+import java.util.concurrent.*;
+import java.util.function.BiFunction;
+import java.util.logging.Logger;
+import org.bukkit.configuration.ConfigurationSection;
+import org.bukkit.configuration.InvalidConfigurationException;
+import org.bukkit.configuration.file.YamlConfiguration;
+
+/** Immutable HUD snapshots; admitted changes are serialized and acknowledged after durable save. */
+final class HudPreferences implements AutoCloseable {
+  record Settings(
+      GlassPaneStyle style,
+      boolean particles,
+      ModernHudListener.ParticleType particleType,
+      boolean breathing) {}
+
+  record Overrides(
+      GlassPaneStyle style,
+      Boolean particles,
+      ModernHudListener.ParticleType particleType,
+      Boolean breathing) {
+    static final Overrides EMPTY = new Overrides(null, null, null, null);
+
+    Settings resolve(Settings defaults) {
+      return new Settings(
+          style == null ? defaults.style() : style,
+          particles == null ? defaults.particles() : particles,
+          particleType == null ? defaults.particleType() : particleType,
+          breathing == null ? defaults.breathing() : breathing);
+    }
+  }
+
+  private record Snapshot(Settings defaults, Map<UUID, Overrides> players) {}
+
+  @FunctionalInterface
+  interface Writer {
+    void write(Path file, String content) throws IOException;
+  }
+
+  private static final Settings DEFAULTS =
+      new Settings(GlassPaneStyle.NIGHTMARE, true, ModernHudListener.ParticleType.SPARKLE, true);
+  private static final Set<String> KEYS =
+      Set.of("style", "particles", "particle-type", "breathing");
+  private final Path configFile;
+  private final Path playerFile;
+  private final Logger logger;
+  private final ExecutorService io;
+  private final Writer writer;
+  private final Set<CompletableFuture<?>> pending = ConcurrentHashMap.newKeySet();
+  private volatile Snapshot snapshot = new Snapshot(DEFAULTS, Map.of());
+  private volatile boolean closed;
+  private boolean ready;
+
+  HudPreferences(Path directory, Logger logger) {
+    this(
+        directory,
+        logger,
+        new ThreadPoolExecutor(
+            1,
+            1,
+            0L,
+            TimeUnit.MILLISECONDS,
+            new ArrayBlockingQueue<>(128),
+            runnable -> {
+              Thread thread = new Thread(runnable, "StarCore-HUD-settings");
+              thread.setDaemon(true);
+              return thread;
+            },
+            new ThreadPoolExecutor.AbortPolicy()),
+        (path, text) -> AtomicFilePersistence.replace(path, temp -> Files.writeString(temp, text)));
+  }
+
+  HudPreferences(Path directory, Logger logger, ExecutorService io, Writer writer) {
+    this.configFile = directory.resolve("hud.yml");
+    this.playerFile = directory.resolve("hud-players.yml");
+    this.logger = Objects.requireNonNull(logger);
+    this.io = io;
+    this.writer = writer;
+    try {
+      if (!Files.exists(configFile)) {
+        YamlConfiguration config = new YamlConfiguration();
+        config.set("version", 1);
+        writeValues(
+            config.createSection("defaults"),
+            new Overrides(
+                DEFAULTS.style(),
+                DEFAULTS.particles(),
+                DEFAULTS.particleType(),
+                DEFAULTS.breathing()));
+        writer.write(configFile, config.saveToString());
+      }
+      load();
+    } catch (IOException | IllegalArgumentException failure) {
+      logger.warning(
+          "HUD settings unavailable; changes disabled until a successful /hud reload: "
+              + failure.getMessage());
+    }
+  }
+
+  Settings settings(UUID player) {
+    Snapshot current = snapshot;
+    return current.players().getOrDefault(player, Overrides.EMPTY).resolve(current.defaults());
+  }
+
+  CompletableFuture<Settings> style(UUID player, GlassPaneStyle style) {
+    Objects.requireNonNull(style);
+    return change(
+        player,
+        (current, old) ->
+            new Overrides(style, old.particles(), old.particleType(), old.breathing()));
+  }
+
+  CompletableFuture<Settings> particle(UUID player, ModernHudListener.ParticleType type) {
+    Objects.requireNonNull(type);
+    return change(
+        player,
+        (current, old) -> new Overrides(old.style(), old.particles(), type, old.breathing()));
+  }
+
+  CompletableFuture<Settings> toggleParticles(UUID player) {
+    return change(
+        player,
+        (current, old) ->
+            new Overrides(old.style(), !current.particles(), old.particleType(), old.breathing()));
+  }
+
+  CompletableFuture<Settings> toggleBreathing(UUID player) {
+    return change(
+        player,
+        (current, old) ->
+            new Overrides(old.style(), old.particles(), old.particleType(), !current.breathing()));
+  }
+
+  CompletableFuture<Settings> reset(UUID player) {
+    return change(player, (current, old) -> Overrides.EMPTY);
+  }
+
+  private CompletableFuture<Settings> change(
+      UUID player, BiFunction<Settings, Overrides, Overrides> update) {
+    Objects.requireNonNull(player);
+    return submit(
+        () -> {
+          if (!ready) throw new IOException("HUD 配置无效，请修复后重载");
+          Snapshot before = snapshot;
+          Overrides old = before.players().getOrDefault(player, Overrides.EMPTY);
+          Overrides next = update.apply(old.resolve(before.defaults()), old);
+          Map<UUID, Overrides> changed = new HashMap<>(before.players());
+          if (Overrides.EMPTY.equals(next)) changed.remove(player);
+          else changed.put(player, next);
+          YamlConfiguration yaml = new YamlConfiguration();
+          yaml.set("version", 1);
+          ConfigurationSection players = yaml.createSection("players");
+          changed.entrySet().stream()
+              .sorted(Map.Entry.comparingByKey())
+              .forEach(
+                  entry ->
+                      writeValues(
+                          players.createSection(entry.getKey().toString()), entry.getValue()));
+          writer.write(playerFile, yaml.saveToString());
+          snapshot = new Snapshot(before.defaults(), Map.copyOf(changed));
+          return next.resolve(before.defaults());
+        });
+  }
+
+  CompletableFuture<Void> reload() {
+    return submit(
+        () -> {
+          load();
+          return null;
+        });
+  }
+
+  private void load() throws IOException {
+    // A failed reload may expose a corrupt player file. Never overwrite it with stale memory.
+    ready = false;
+    YamlConfiguration config = read(configFile);
+    requireKeys(config, Set.of("version", "defaults"));
+    Settings defaults = readValues(requireSection(config, "defaults")).resolve(DEFAULTS);
+    Map<UUID, Overrides> players = new HashMap<>();
+    if (Files.exists(playerFile)) {
+      YamlConfiguration yaml = read(playerFile);
+      requireKeys(yaml, Set.of("version", "players"));
+      ConfigurationSection section = requireSection(yaml, "players");
+      for (String id : section.getKeys(false)) {
+        UUID uuid = UUID.fromString(id);
+        if (!uuid.toString().equals(id)) throw new IOException("Invalid HUD player UUID: " + id);
+        players.put(uuid, readValues(requireSection(section, id)));
+      }
+    }
+    snapshot = new Snapshot(defaults, Map.copyOf(players));
+    ready = true;
+  }
+
+  private static YamlConfiguration read(Path file) throws IOException {
+    YamlConfiguration yaml = new YamlConfiguration();
+    try {
+      yaml.loadFromString(Files.readString(file));
+    } catch (InvalidConfigurationException invalid) {
+      throw new IOException("Invalid HUD YAML: " + file.getFileName(), invalid);
+    }
+    if (!(yaml.get("version") instanceof Integer version) || version != 1)
+      throw new IOException("Unsupported HUD settings version: " + file.getFileName());
+    return yaml;
+  }
+
+  private static ConfigurationSection requireSection(ConfigurationSection parent, String key)
+      throws IOException {
+    ConfigurationSection section = parent.getConfigurationSection(key);
+    if (section == null) throw new IOException("Missing HUD section: " + key);
+    return section;
+  }
+
+  private static void requireKeys(ConfigurationSection section, Set<String> allowed)
+      throws IOException {
+    for (String key : section.getKeys(false))
+      if (!allowed.contains(key)) throw new IOException("Unknown HUD option: " + key);
+  }
+
+  private static Overrides readValues(ConfigurationSection section) throws IOException {
+    requireKeys(section, KEYS);
+    return new Overrides(
+        enumValue(section, "style", GlassPaneStyle.class),
+        booleanValue(section, "particles"),
+        enumValue(section, "particle-type", ModernHudListener.ParticleType.class),
+        booleanValue(section, "breathing"));
+  }
+
+  private static Boolean booleanValue(ConfigurationSection section, String key) throws IOException {
+    Object value = section.get(key);
+    if (value == null) return null;
+    if (value instanceof Boolean flag) return flag;
+    throw new IOException("HUD " + key + " must be true or false");
+  }
+
+  private static <T extends Enum<T>> T enumValue(
+      ConfigurationSection section, String key, Class<T> type) throws IOException {
+    Object value = section.get(key);
+    if (value == null) return null;
+    try {
+      if (value instanceof String name) return Enum.valueOf(type, name.toUpperCase(Locale.ROOT));
+    } catch (IllegalArgumentException invalid) {
+      throw new IOException("Unknown HUD " + key + ": " + value, invalid);
+    }
+    throw new IOException("HUD " + key + " must be a name");
+  }
+
+  private static void writeValues(ConfigurationSection section, Overrides values) {
+    if (values.style() != null) section.set("style", values.style().name());
+    if (values.particles() != null) section.set("particles", values.particles());
+    if (values.particleType() != null) section.set("particle-type", values.particleType().name());
+    if (values.breathing() != null) section.set("breathing", values.breathing());
+  }
+
+  private <T> CompletableFuture<T> submit(Callable<T> action) {
+    CompletableFuture<T> result = new CompletableFuture<>();
+    pending.add(result);
+    result.whenComplete((ignored, failure) -> pending.remove(result));
+    if (closed) {
+      result.completeExceptionally(new IllegalStateException("HUD 已停用"));
+      return result;
+    }
+    try {
+      io.execute(
+          () -> {
+            try {
+              result.complete(action.call());
+            } catch (Exception failure) {
+              result.completeExceptionally(failure);
+            }
+          });
+    } catch (RejectedExecutionException busy) {
+      result.completeExceptionally(new IllegalStateException("HUD 设置繁忙或已停用，请稍后重试", busy));
+    }
+    // Cancelling the caller's observation cannot cancel an admitted durable change.
+    return result.copy();
+  }
+
+  @Override
+  public void close() {
+    closed = true;
+    io.shutdown();
+    try {
+      if (!io.awaitTermination(5, TimeUnit.SECONDS)) {
+        io.shutdownNow();
+        logger.warning("HUD settings writer did not drain before shutdown");
+      }
+    } catch (InterruptedException interrupted) {
+      io.shutdownNow();
+      Thread.currentThread().interrupt();
+    } finally {
+      pending.forEach(future -> future.completeExceptionally(new IllegalStateException("HUD 已停用")));
+    }
+  }
+}
