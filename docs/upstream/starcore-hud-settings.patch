+package dev.starcore.starcore.foundation.hud;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import dev.starcore.starcore.core.persistence.AtomicFilePersistence;
+import java.io.IOException;
+import java.nio.file.*;
+import java.util.*;
+import java.util.concurrent.*;
+import java.util.concurrent.atomic.AtomicBoolean;
+import java.util.logging.Logger;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+class HudPreferencesTest {
+  @TempDir Path directory;
+  private final Logger logger = Logger.getAnonymousLogger();
+  private final UUID first = UUID.randomUUID();
+  private final UUID second = UUID.randomUUID();
+
+  @Test
+  void personalOverridesSurviveRestartAndDefaultsReloadWithoutAffectingOtherPlayers()
+      throws Exception {
+    try (var store = new HudPreferences(directory, logger)) {
+      await(store.style(first, GlassPaneStyle.FOREST));
+      await(store.toggleParticles(first));
+      await(store.particle(first, ModernHudListener.ParticleType.FIREFLY));
+      assertEquals(GlassPaneStyle.NIGHTMARE, store.settings(second).style());
+      assertTrue(store.settings(second).particles());
+      defaults("ROYAL", false);
+      await(store.reload());
+      assertEquals(GlassPaneStyle.FOREST, store.settings(first).style());
+      assertFalse(store.settings(first).breathing(), "untouched fields inherit new defaults");
+      assertEquals(GlassPaneStyle.ROYAL, store.settings(second).style());
+    }
+    try (var restarted = new HudPreferences(directory, logger)) {
+      assertEquals(GlassPaneStyle.FOREST, restarted.settings(first).style());
+      assertFalse(restarted.settings(first).particles());
+      assertEquals(
+          ModernHudListener.ParticleType.FIREFLY, restarted.settings(first).particleType());
+      await(restarted.reset(first));
+      assertEquals(restarted.settings(second), restarted.settings(first));
+    }
+    try (var again = new HudPreferences(directory, logger)) {
+      assertEquals(GlassPaneStyle.ROYAL, again.settings(first).style());
+    }
+  }
+
+  @Test
+  void invalidReloadRetainsEntireSnapshotAndDoesNotRewriteAdministratorsFile() throws Exception {
+    try (var store = new HudPreferences(directory, logger)) {
+      await(store.style(first, GlassPaneStyle.FOREST));
+      var before = store.settings(first);
+      String malformed = "version: 1\ndefaults:\n  style: ROYAL\n  breathing: perhaps\n";
+      Files.writeString(directory.resolve("hud.yml"), malformed);
+      assertThrows(ExecutionException.class, () -> await(store.reload()));
+      assertEquals(before, store.settings(first));
+      assertEquals(GlassPaneStyle.NIGHTMARE, store.settings(second).style());
+      assertEquals(malformed, Files.readString(directory.resolve("hud.yml")));
+    }
+  }
+
+  @Test
+  void failedAtomicSaveLeavesMemoryAndPreviouslyAcknowledgedFileUnchanged() throws Exception {
+    AtomicBoolean fail = new AtomicBoolean();
+    try (var store =
+        new HudPreferences(
+            directory,
+            logger,
+            Executors.newSingleThreadExecutor(),
+            (path, value) ->
+                AtomicFilePersistence.replace(
+                    path,
+                    temp -> {
+                      Files.writeString(temp, value);
+                      if (fail.get()) throw new IOException("Injected failure before replace");
+                    }))) {
+      await(store.style(first, GlassPaneStyle.FOREST));
+      byte[] saved = Files.readAllBytes(directory.resolve("hud-players.yml"));
+      fail.set(true);
+      assertThrows(ExecutionException.class, () -> await(store.toggleParticles(first)));
+      assertTrue(store.settings(first).particles());
+      assertArrayEquals(saved, Files.readAllBytes(directory.resolve("hud-players.yml")));
+      fail.set(false);
+      await(store.toggleParticles(first));
+      assertFalse(store.settings(first).particles());
+    }
+  }
+
+  @Test
+  void rapidTogglesAreSerializedAndDoNotLoseAnotherPlayersChanges() throws Exception {
+    try (var store = new HudPreferences(directory, logger)) {
+      List<CompletableFuture<?>> changes = new ArrayList<>();
+      for (int i = 0; i < 15; i++) {
+        changes.add(store.toggleParticles(first));
+        changes.add(store.toggleBreathing(second));
+      }
+      await(CompletableFuture.allOf(changes.toArray(CompletableFuture[]::new)));
+      assertFalse(store.settings(first).particles());
+      assertTrue(store.settings(first).breathing());
+      assertFalse(store.settings(second).breathing());
+      assertTrue(store.settings(second).particles());
+    }
+  }
+
+  @Test
+  void shutdownDrainsAdmittedChangesAndRefusesNewWrites() throws Exception {
+    var store = new HudPreferences(directory, logger);
+    var saved = store.style(first, GlassPaneStyle.INFERNO);
+    store.close();
+    assertEquals(GlassPaneStyle.INFERNO, await(saved).style());
+    assertThrows(ExecutionException.class, () -> await(store.reset(first)));
+    try (var restarted = new HudPreferences(directory, logger)) {
+      assertEquals(GlassPaneStyle.INFERNO, restarted.settings(first).style());
+    }
+  }
+
+  @Test
+  void cancellingObservationDoesNotCancelAdmittedPreference() throws Exception {
+    try (var store = new HudPreferences(directory, logger)) {
+      store.style(first, GlassPaneStyle.CRYSTAL).cancel(false);
+      await(store.toggleParticles(second)); // Serial queue barrier.
+      assertEquals(GlassPaneStyle.CRYSTAL, store.settings(first).style());
+    }
+    try (var restarted = new HudPreferences(directory, logger)) {
+      assertEquals(GlassPaneStyle.CRYSTAL, restarted.settings(first).style());
+    }
+  }
+
+  @Test
+  void corruptExistingPlayerFileIsNotOverwrittenAndCanBeRepairedWithReload() throws Exception {
+    String corrupt = "version: 1\nplayers:\n  broken-uuid: {}\n";
+    Files.writeString(directory.resolve("hud-players.yml"), corrupt);
+    try (var store = new HudPreferences(directory, logger)) {
+      assertThrows(ExecutionException.class, () -> await(store.toggleParticles(first)));
+      assertEquals(corrupt, Files.readString(directory.resolve("hud-players.yml")));
+      Files.writeString(directory.resolve("hud-players.yml"), "version: 1\nplayers: {}\n");
+      await(store.reload());
+      assertFalse(await(store.toggleParticles(first)).particles());
+    }
+  }
+
+  @Test
+  void brokenPlayerReloadDoesNotPublishNewDefaults() throws Exception {
+    try (var store = new HudPreferences(directory, logger)) {
+      await(store.style(first, GlassPaneStyle.FOREST));
+      defaults("ROYAL", false);
+      Files.writeString(directory.resolve("hud-players.yml"), "version: 1\nplayers: [oops]\n");
+      assertThrows(ExecutionException.class, () -> await(store.reload()));
+      assertEquals(GlassPaneStyle.FOREST, store.settings(first).style());
+      assertEquals(GlassPaneStyle.NIGHTMARE, store.settings(second).style());
+      assertThrows(ExecutionException.class, () -> await(store.toggleParticles(first)));
+      assertEquals(
+          "version: 1\nplayers: [oops]\n", Files.readString(directory.resolve("hud-players.yml")));
+    }
+  }
+
+  @Test
+  void unknownOptionsAndVersionsFailWithoutPublishing() throws Exception {
+    try (var store = new HudPreferences(directory, logger)) {
+      for (String invalid :
+          List.of(
+              "version: 9\ndefaults: {}\n",
+              "version: 1\ndefaults:\n  breathng: true\n",
+              "version: 1\ndefaults:\n  style: unknown\n",
+              "version: [")) {
+        Files.writeString(directory.resolve("hud.yml"), invalid);
+        assertThrows(ExecutionException.class, () -> await(store.reload()));
+        assertEquals(GlassPaneStyle.NIGHTMARE, store.settings(first).style());
+      }
+    }
+  }
+
+  private void defaults(String style, boolean breathing) throws IOException {
+    Files.writeString(
+        directory.resolve("hud.yml"),
+        "version: 1\ndefaults:\n  style: " + style + "\n  breathing: " + breathing + "\n");
+  }
+
+  private static <T> T await(CompletableFuture<T> future) throws Exception {
+    return future.get(5, TimeUnit.SECONDS);
+  }
+}
