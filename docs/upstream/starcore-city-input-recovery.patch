+  @Test
+  void failedDialogPublicationDiscardsCapturedCallbacksAndAllowsNewAttempt() {
+    var forms = new ArrayList<Form>();
+    var results = new ArrayList<String>();
+    var fail = new AtomicBoolean(true);
+    var player = player(UUID.randomUUID());
+    var input =
+        new CityTextInput(
+            (owner, prompt, submit, cancel) -> {
+              forms.add(new Form(owner, prompt, submit, cancel));
+              if (fail.getAndSet(false)) throw new IllegalStateException("show failed");
+            },
+            (owner, action, retired) -> action.run(),
+            System::nanoTime);
+    Runnable open =
+        () ->
+            input.open(
+                player,
+                new CityTextInput.Prompt("a", "b", "", 10, false),
+                (actor, text) -> results.add(text),
+                actor -> {});
+    assertThatThrownBy(open::run).isInstanceOf(IllegalStateException.class);
+    forms.getFirst().submit().accept(player, "stale");
+    assertThat(results).isEmpty();
+    open.run();
+    forms.getLast().submit().accept(player, "valid");
+    assertThat(results).containsExactly("valid");
+    verify(player, never()).getInventory();
+  }
+
+  @Test
+  void schedulerRejectionCannotLeaveLiveSubmission() {
+    var forms = new ArrayList<Form>();
+    var player = player(UUID.randomUUID());
+    var fail = new AtomicBoolean(true);
+    var results = new ArrayList<String>();
+    var input =
+        new CityTextInput(
+            (owner, prompt, submit, cancel) -> forms.add(new Form(owner, prompt, submit, cancel)),
+            (owner, action, retired) -> {
+              if (forms.size() == 1 && fail.getAndSet(false))
+                throw new IllegalStateException("scheduler unavailable");
+              action.run();
+            },
+            System::nanoTime);
+    Runnable open =
+        () ->
+            input.open(
+                player,
+                new CityTextInput.Prompt("a", "b", "", 10, false),
+                (actor, text) -> results.add(text),
+                actor -> {});
+    open.run();
+    assertThatThrownBy(() -> forms.getFirst().submit().accept(player, "first"))
+        .isInstanceOf(IllegalStateException.class);
+    forms.getFirst().submit().accept(player, "stale");
+    open.run();
+    forms.getLast().submit().accept(player, "second");
+    assertThat(results).containsExactly("second");
+  }
+
+  @Test
+  void shutdownWaitsForOngoingDialogPublicationAndRejectsItsResponse() throws Exception {
+    var entered = new CountDownLatch(1);
+    var release = new CountDownLatch(1);
+    var results = new ArrayList<String>();
+    var forms = new ArrayList<Form>();
+    var player = player(UUID.randomUUID());
+    var input =
+        new CityTextInput(
+            (owner, prompt, submit, cancel) -> {
+              forms.add(new Form(owner, prompt, submit, cancel));
+              entered.countDown();
+              try {
+                if (!release.await(5, TimeUnit.SECONDS)) throw new IllegalStateException("timeout");
+              } catch (InterruptedException e) {
+                throw new IllegalStateException(e);
+              }
+            },
+            (owner, action, retired) -> action.run(),
+            System::nanoTime);
+    try (var executor = Executors.newFixedThreadPool(2)) {
+      var opened =
+          executor.submit(
+              () ->
+                  input.open(
+                      player,
+                      new CityTextInput.Prompt("a", "b", "", 10, false),
+                      (actor, text) -> results.add(text),
+                      actor -> {}));
+      assertThat(entered.await(5, TimeUnit.SECONDS)).isTrue();
+      var closing = executor.submit(input::close);
+      release.countDown();
+      opened.get(5, TimeUnit.SECONDS);
+      closing.get(5, TimeUnit.SECONDS);
+    }
+    forms.getFirst().submit().accept(player, "after stop");
+    assertThat(results).isEmpty();
+    verify(player, never()).getInventory();
+  }
+}
