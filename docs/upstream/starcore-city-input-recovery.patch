+package dev.starcore.starcore.module.city.gui;
+
+import static org.assertj.core.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+import java.util.*;
+import java.util.concurrent.*;
+import java.util.concurrent.atomic.*;
+import java.util.function.*;
+import org.bukkit.entity.Player;
+import org.junit.jupiter.api.Test;
+
+class CityTextInputTest {
+  record Form(
+      Player owner,
+      CityTextInput.Prompt prompt,
+      BiConsumer<Player, String> submit,
+      Consumer<Player> cancel) {}
+
+  record Task(Runnable run, Runnable retired) {}
+
+  static class Fixture {
+    final List<Form> forms = new ArrayList<>();
+    final Deque<Task> tasks = new ArrayDeque<>();
+    final List<String> results = new ArrayList<>();
+    final AtomicLong clock = new AtomicLong();
+    final Player player = player(UUID.randomUUID());
+    final CityTextInput input =
+        new CityTextInput(
+            (owner, prompt, submit, cancel) -> forms.add(new Form(owner, prompt, submit, cancel)),
+            (owner, action, retired) -> tasks.add(new Task(action, retired)),
+            clock::get);
+
+    void queueOpen() {
+      input.open(
+          player,
+          new CityTextInput.Prompt("title", "label", "", 100, true),
+          (actor, text) -> results.add(text),
+          actor -> results.add("cancel"));
+    }
+
+    Form open() {
+      queueOpen();
+      tasks.removeLast().run().run();
+      return forms.getLast();
+    }
+
+    void drain() {
+      while (!tasks.isEmpty()) tasks.remove().run().run();
+    }
+  }
+
+  static Player player(UUID id) {
+    var player = mock(Player.class);
+    when(player.getUniqueId()).thenReturn(id);
+    when(player.isOnline()).thenReturn(true);
+    return player;
+  }
+
+  @Test
+  void callbackOnlyRunsOnScheduledOwnerAndConsumesAtMostOneResponse() {
+    var f = new Fixture();
+    var form = f.open();
+    form.submit().accept(f.player, "  exact text  ");
+    form.submit().accept(f.player, "duplicate");
+    form.cancel().accept(f.player);
+    assertThat(f.results).isEmpty();
+    assertThat(f.tasks).hasSize(1);
+    f.drain();
+    assertThat(f.results).containsExactly("exact text");
+    verify(f.player, never()).getInventory();
+  }
+
+  @Test
+  void queuedDialogDoesNotOpenAfterQuitStopExpiryRetirementOrSupersession() {
+    for (String reason : List.of("quit", "stop", "expiry", "retirement", "offline", "superseded")) {
+      var f = new Fixture();
+      f.queueOpen();
+      assertThat(f.forms).isEmpty();
+      switch (reason) {
+        case "quit" -> f.input.cancel(f.player);
+        case "stop" -> f.input.close();
+        case "expiry" -> f.clock.set(CityTextInput.LIFETIME.toNanos());
+        case "retirement" -> f.tasks.getFirst().retired().run();
+        case "offline" -> when(f.player.isOnline()).thenReturn(false);
+        case "superseded" -> f.queueOpen();
+      }
+      f.tasks.removeFirst().run().run();
+      assertThat(f.forms).as(reason).isEmpty();
+      if (reason.equals("superseded")) {
+        f.drain();
+        assertThat(f.forms).hasSize(1);
+        f.forms.getFirst().submit().accept(f.player, "new");
+        f.drain();
+        assertThat(f.results).containsExactly("new");
+      }
+      verify(f.player, never()).getInventory();
+    }
+  }
+
+  @Test
+  void foreignAndReconnectedPlayerCannotConsumeOriginalSession() {
+    var f = new Fixture();
+    var form = f.open();
+    var foreign = player(UUID.randomUUID());
+    var reconnect = player(f.player.getUniqueId());
+    form.submit().accept(foreign, "foreign");
+    form.submit().accept(reconnect, "new connection");
+    form.cancel().accept(reconnect);
+    f.drain();
+    assertThat(f.results).isEmpty();
+    form.submit().accept(f.player, "owner");
+    f.drain();
+    assertThat(f.results).containsExactly("owner");
