new file mode 100644
index 0000000..292c388
--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/module/city/gui/CityTextInput.java
@@ -0,0 +1,166 @@
+package dev.starcore.starcore.module.city.gui;
+
+import dev.starcore.starcore.core.scheduler.CompatScheduler;
+import java.lang.ref.WeakReference;
+import java.time.Duration;
+import java.util.*;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.atomic.AtomicBoolean;
+import java.util.function.*;
+import net.kyori.adventure.text.Component;
+import net.kyori.adventure.text.format.NamedTextColor;
+import org.bukkit.entity.Player;
+import org.bukkit.plugin.Plugin;
+
+/** Ephemeral input only: no inventory replacement, escrow, or persisted player item snapshot. */
+final class CityTextInput implements AutoCloseable {
+  static final Duration LIFETIME = Duration.ofMinutes(5);
+
+  record Prompt(String title, String label, String initial, int maxLength, boolean multiline) {
+    Prompt {
+      Objects.requireNonNull(title);
+      Objects.requireNonNull(label);
+      Objects.requireNonNull(initial);
+      if (maxLength < 1 || initial.length() > maxLength)
+        throw new IllegalArgumentException("Invalid city input");
+    }
+  }
+
+  interface View {
+    void show(
+        Player player, Prompt prompt, BiConsumer<Player, String> submit, Consumer<Player> cancel);
+  }
+
+  interface Dispatcher {
+    void execute(Player player, Runnable action, Runnable retired);
+  }
+
+  private static final class Session {
+    final UUID account;
+    final WeakReference<Player> player;
+    final long started;
+    final AtomicBoolean submitted = new AtomicBoolean();
+
+    Session(Player player, long started) {
+      this.account = player.getUniqueId();
+      this.player = new WeakReference<>(player);
+      this.started = started;
+    }
+  }
+
+  private final View view;
+  private final Dispatcher dispatcher;
+  private final LongSupplier clock;
+  private final Map<UUID, Session> sessions = new ConcurrentHashMap<>();
+  private final Object publication = new Object();
+  private volatile boolean stopped;
+
+  CityTextInput(Plugin plugin) {
+    this(
+        new PaperCityTextDialog(),
+        (player, action, retired) -> CompatScheduler.entity(plugin, player, action, retired),
+        System::nanoTime);
+  }
+
+  CityTextInput(View view, Dispatcher dispatcher, LongSupplier clock) {
+    this.view = Objects.requireNonNull(view);
+    this.dispatcher = Objects.requireNonNull(dispatcher);
+    this.clock = Objects.requireNonNull(clock);
+  }
+
+  void open(
+      Player player, Prompt prompt, BiConsumer<Player, String> submit, Consumer<Player> cancel) {
+    final Session session;
+    synchronized (publication) {
+      if (stopped) throw new IllegalStateException("City input service stopped");
+      sessions.entrySet().removeIf(e -> expired(e.getValue()) || e.getValue().player.get() == null);
+      session = new Session(player, clock.getAsLong());
+      sessions.put(session.account, session);
+    }
+    try {
+      dispatcher.execute(
+          player,
+          () -> {
+            synchronized (publication) {
+              if (!current(session, player) || !player.isOnline()) {
+                sessions.remove(session.account, session);
+                return;
+              }
+              try {
+                view.show(
+                    player,
+                    prompt,
+                    (actor, text) ->
+                        dispatch(
+                            session,
+                            actor,
+                            () -> {
+                              if (text == null || text.length() > prompt.maxLength()) {
+                                actor.sendMessage(
+                                    Component.text("输入内容超出长度限制，请重新输入", NamedTextColor.RED));
+                                cancel.accept(actor);
+                                return;
+                              }
+                              submit.accept(actor, text.trim());
+                            }),
+                    actor -> dispatch(session, actor, () -> cancel.accept(actor)));
+              } catch (RuntimeException | LinkageError failure) {
+                sessions.remove(session.account, session);
+                player.sendMessage(Component.text("无法打开输入窗口，请稍后重试或使用城市命令", NamedTextColor.RED));
+                throw failure;
+              }
+            }
+          },
+          () -> sessions.remove(session.account, session));
+    } catch (RuntimeException failure) {
+      sessions.remove(session.account, session);
+      throw failure;
+    }
+  }
+
+  private boolean expired(Session session) {
+    return clock.getAsLong() - session.started >= LIFETIME.toNanos();
+  }
+
+  private boolean current(Session session, Player actor) {
+    return !stopped
+        && session.player.get() == actor
+        && sessions.get(session.account) == session
+        && !expired(session);
+  }
+
+  private void dispatch(Session session, Player actor, Runnable action) {
+    if (!current(session, actor) || !session.submitted.compareAndSet(false, true)) return;
+    try {
+      dispatcher.execute(
+          actor,
+          () -> {
+            if (!current(session, actor)) {
+              sessions.remove(session.account, session);
+              return;
+            }
+            if (!actor.isOnline()) {
+              sessions.remove(session.account, session);
+              return;
+            }
+            if (sessions.remove(session.account, session) && !stopped) action.run();
+          },
+          () -> sessions.remove(session.account, session));
+    } catch (RuntimeException failure) {
+      sessions.remove(session.account, session);
+      throw failure;
+    }
+  }
+
+  void cancel(Player player) {
+    sessions.computeIfPresent(
+        player.getUniqueId(), (id, session) -> session.player.get() == player ? null : session);
+  }
+
+  public void close() {
+    synchronized (publication) {
+      stopped = true;
+      sessions.clear();
+    }
+  }
+}
