+package dev.starcore.starcore.module.city.gui;
+
+import io.papermc.paper.dialog.Dialog;
+import io.papermc.paper.registry.data.dialog.*;
+import io.papermc.paper.registry.data.dialog.action.DialogAction;
+import io.papermc.paper.registry.data.dialog.input.*;
+import io.papermc.paper.registry.data.dialog.type.DialogType;
+import java.util.List;
+import java.util.function.*;
+import net.kyori.adventure.text.Component;
+import net.kyori.adventure.text.event.ClickCallback;
+import org.bukkit.entity.Player;
+
+/** Native 1.21.11 text form. Values are callback data, never command templates or real items. */
+final class PaperCityTextDialog implements CityTextInput.View {
+  public void show(
+      Player player,
+      CityTextInput.Prompt prompt,
+      BiConsumer<Player, String> submit,
+      Consumer<Player> cancel) {
+    var dialog = Dialog.create(factory -> configure(factory.empty(), prompt, submit, cancel));
+    player.closeInventory();
+    player.showDialog(dialog);
+  }
+
+  static void configure(
+      DialogRegistryEntry.Builder builder,
+      CityTextInput.Prompt prompt,
+      BiConsumer<Player, String> submit,
+      Consumer<Player> cancel) {
+    var input =
+        DialogInput.text("value", Component.text(prompt.label()))
+            .initial(prompt.initial())
+            .maxLength(prompt.maxLength())
+            .width(300);
+    if (prompt.multiline()) input.multiline(TextDialogInput.MultilineOptions.create(5, 100));
+    // Ownership and one-shot consumption belong to CityTextInput; foreign audiences cannot consume
+    // it.
+    var options =
+        ClickCallback.Options.builder()
+            .uses(ClickCallback.UNLIMITED_USES)
+            .lifetime(CityTextInput.LIFETIME)
+            .build();
+    var confirm =
+        ActionButton.builder(Component.text("预览"))
+            .action(
+                DialogAction.customClick(
+                    (response, audience) -> {
+                      if (audience instanceof Player actor)
+                        submit.accept(actor, response.getText("value"));
+                    },
+                    options))
+            .build();
+    var back =
+        ActionButton.builder(Component.text("取消"))
+            .action(
+                DialogAction.customClick(
+                    (response, audience) -> {
+                      if (audience instanceof Player actor) cancel.accept(actor);
+                    },
+                    options))
+            .build();
+    builder
+        .base(
+            DialogBase.builder(Component.text(prompt.title()))
+                .canCloseWithEscape(true)
+                .pause(false)
+                .afterAction(DialogBase.DialogAfterAction.CLOSE)
+                .inputs(List.of(input.build()))
+                .build())
+        .type(DialogType.confirmation(confirm, back));
+  }
+}
