+package dev.starcore.starcore.foundation.territory;
+
+import dev.starcore.starcore.foundation.territory.model.ChunkCoordinate;
+import java.util.Comparator;
+import java.util.List;
+import java.util.Objects;
+import java.util.Optional;
+import java.util.UUID;
+
+/** An entire batch and its immutable terminal receipt commit together. */
+public interface TerritoryBatchService {
+  enum Status {
+    APPLIED,
+    OVERLAP,
+    LIMIT_REACHED,
+    CANCELLED
+  }
+
+  record Request(
+      UUID operationId, String ownerId, List<ChunkCoordinate> coordinates, int maxOwnerClaims) {
+    public Request {
+      Objects.requireNonNull(operationId);
+      if (ownerId == null || ownerId.isBlank() || ownerId.length() > 64)
+        throw new IllegalArgumentException("Invalid territory owner");
+      coordinates = List.copyOf(coordinates);
+      if (coordinates.isEmpty()
+          || coordinates.size() > 100_000
+          || maxOwnerClaims < -1
+          || coordinates.stream().distinct().count() != coordinates.size())
+        throw new IllegalArgumentException("Invalid territory batch");
+      for (var c : coordinates)
+        if (c.world().isBlank() || c.world().length() > 191)
+          throw new IllegalArgumentException("Invalid territory world");
+      coordinates =
+          coordinates.stream()
+              .sorted(
+                  Comparator.comparing(ChunkCoordinate::world)
+                      .thenComparingInt(ChunkCoordinate::x)
+                      .thenComparingInt(ChunkCoordinate::z))
+              .toList();
+    }
+  }
+
+  record Receipt(Request request, Status status) {
+    public Receipt {
+      Objects.requireNonNull(request);
+      Objects.requireNonNull(status);
+    }
+  }
+
+  Receipt claimBatch(Request request);
+
+  /**
+   * Cancels only an unpublished batch. An existing APPLIED result wins and is returned unchanged.
+   */
+  Receipt cancelBatch(Request request);
+
+  Optional<Receipt> batchReceipt(UUID operationId);
+}
