index 0000000..e588b05
--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/module/nation/NationClaimCoordinator.java
@@ -0,0 +1,189 @@
+package dev.starcore.starcore.module.nation;
+
+import static dev.starcore.starcore.module.nation.NationClaimService.State.*;
+
+import dev.starcore.starcore.foundation.economy.PlayerMoneyService;
+import dev.starcore.starcore.foundation.territory.TerritoryBatchService;
+import dev.starcore.starcore.module.nation.model.Nation;
+import java.util.*;
+import java.util.function.*;
+
+/** The original quote and both external request IDs survive every payment and land boundary. */
+final class NationClaimCoordinator {
+  private final NationStateStorage storage;
+  private final PlayerMoneyService money;
+  private final TerritoryBatchService territories;
+  private final Consumer<NationStateCodec.Snapshot> publish;
+  private NationStateCodec.Snapshot snapshot;
+
+  NationClaimCoordinator(
+      NationStateStorage storage, PlayerMoneyService money, TerritoryBatchService territories) {
+    this(storage, money, territories, ignored -> {});
+  }
+
+  NationClaimCoordinator(
+      NationStateStorage storage,
+      PlayerMoneyService money,
+      TerritoryBatchService territories,
+      Consumer<NationStateCodec.Snapshot> publish) {
+    this.storage = Objects.requireNonNull(storage);
+    this.money = Objects.requireNonNull(money);
+    this.territories = Objects.requireNonNull(territories);
+    this.publish = Objects.requireNonNull(publish);
+    snapshot = NationStateCodec.snapshot(storage.load());
+    publish.accept(snapshot);
+  }
+
+  NationClaimService.Receipt claim(
+      NationClaimService.Request request, Function<List<Nation>, NationClaimOperation> admission) {
+    var previous = snapshot.claims().get(request.operationId());
+    if (previous != null) {
+      if (!previous.request().equals(request))
+        throw new IllegalArgumentException("Conflicting claim request");
+      return advance(previous);
+    }
+    if (snapshot.claims().values().stream().anyMatch(op -> op.state().pending())
+        || snapshot.creations().values().stream().anyMatch(op -> op.state().pending()))
+      throw new IllegalStateException(
+          "Nation lifecycle recovery pending; retry its original operation ID");
+    var operation = admission.apply(snapshot.nations());
+    if (!operation.request().equals(request) || operation.state() != PREPARED)
+      throw new IllegalArgumentException("Invalid claim admission");
+    persist(operation);
+    return advance(operation);
+  }
+
+  NationClaimService.Receipt recover(UUID id, boolean retryBlocked) {
+    var op = required(id);
+    if (op.state() == REFUND_BLOCKED && retryBlocked) {
+      op = op.retryRefund();
+      persist(op);
+    }
+    return advance(op);
+  }
+
+  NationClaimService.Receipt cancel(UUID id) {
+    var op = required(id);
+    if (!op.state().pending()) return op.receipt();
+    if (op.state() == PREPARED) {
+      op = op.state(CANCEL_PENDING, "cancelled-by-administrator");
+      persist(op);
+    }
+    return advance(op);
+  }
+
+  private NationClaimOperation required(UUID id) {
+    var op = snapshot.claims().get(Objects.requireNonNull(id));
+    if (op == null) throw new IllegalArgumentException("Unknown nation claim operation " + id);
+    return op;
+  }
+
+  private NationClaimService.Receipt advance(NationClaimOperation op) {
+    if (!op.state().pending() || op.state() == REFUND_BLOCKED) return op.receipt();
+    // Even a cancelling executor seals the original debit; no delayed caller can debit after
+    // refund.
+    var debit = op.quote().totalPrice().signum() == 0 ? null : settle(op.debit());
+    if (debit != null && debit.status() != PlayerMoneyService.Status.APPLIED) {
+      var land = land(op, true);
+      if (land.status() == TerritoryBatchService.Status.APPLIED)
+        throw new IllegalStateException("Claim land/payment authority disagree");
+      var rejected =
+          op.state(op.state() == PREPARED ? REJECTED : CANCELLED, "debit-" + debit.status());
+      persist(rejected);
+      return rejected.receipt();
+    }
+    var nationId = op.nationId();
+    boolean cancel =
+        op.state() != PREPARED
+            || snapshot.nations().stream().noneMatch(n -> n.id().equals(nationId));
+    var land = land(op, cancel);
+    if (land.status() == TerritoryBatchService.Status.APPLIED) {
+      if (op.state() == REFUND_PENDING)
+        throw new IllegalStateException("Claim refund/land authority disagree");
+      var done = op.state(CLAIMED, "claimed");
+      persist(done);
+      return done.receipt();
+    }
+    if (op.state() != REFUND_PENDING) {
+      op = op.state(REFUND_PENDING, "land-" + land.status());
+      persist(op);
+    }
+    var refund = op.quote().totalPrice().signum() == 0 ? null : settle(op.refund());
+    var done =
+        refund == null || refund.status() == PlayerMoneyService.Status.APPLIED
+            ? op.state(REFUNDED, op.detail())
+            : op.state(REFUND_BLOCKED, "refund-" + refund.status());
+    persist(done);
+    return done.receipt();
+  }
+
+  private TerritoryBatchService.Receipt land(NationClaimOperation op, boolean cancel) {
+    var request = op.batch();
+    var receipt = territories.batchReceipt(request.operationId());
+    if (receipt.isEmpty()) {
+      try {
+        if (cancel) territories.cancelBatch(request);
+        else territories.claimBatch(request);
+      } catch (RuntimeException failure) {
+        try {
+          receipt = territories.batchReceipt(request.operationId());
+        } catch (RuntimeException read) {
+          failure.addSuppressed(read);
+          throw failure;
+        }
+        if (receipt.isEmpty()) throw failure;
+      }
+      if (receipt.isEmpty()) receipt = territories.batchReceipt(request.operationId());
+    }
+    var proof =
+        receipt.orElseThrow(() -> new IllegalStateException("Claim territory receipt unavailable"));
+    if (!proof.request().equals(request))
+      throw new IllegalStateException("Conflicting claim territory receipt");
+    return proof;
+  }
+
+  private PlayerMoneyService.Receipt settle(PlayerMoneyService.Request request) {
+    var receipt = money.moneyReceipt(request.operationId());
+    if (receipt.isEmpty()) {
+      try {
+        money.applyMoney(request);
+      } catch (RuntimeException failure) {
+        try {
+          receipt = money.moneyReceipt(request.operationId());
+        } catch (RuntimeException read) {
+          failure.addSuppressed(read);
+          throw failure;
+        }
+        if (receipt.isEmpty()) throw failure;
+      }
+      if (receipt.isEmpty()) receipt = money.moneyReceipt(request.operationId());
+    }
+    var proof =
+        receipt.orElseThrow(() -> new IllegalStateException("Claim money receipt unavailable"));
+    if (!proof.request().equals(request))
+      throw new IllegalStateException("Conflicting claim money receipt");
+    return proof;
+  }
+
+  private void persist(NationClaimOperation op) {
+    var operations = new HashMap<>(snapshot.claims());
+    operations.put(op.request().operationId(), op);
+    var candidate =
+        NationStateCodec.toProperties(snapshot.nations(), snapshot.creations(), operations);
+    try {
+      storage.save(candidate);
+    } catch (RuntimeException failure) {
+      try {
+        var actual = storage.load();
+        snapshot = NationStateCodec.snapshot(actual);
+        publish.accept(snapshot);
+        if (candidate.equals(actual)) return;
+      } catch (RuntimeException read) {
+        failure.addSuppressed(read);
+      }
+      throw failure;
+    }
+    snapshot = NationStateCodec.snapshot(candidate);
+    publish.accept(snapshot);
+  }
+}
diff --git a/src/main/java/dev/starcore/starcore/module/nation/NationClaimOperation.java b/src/main/java/dev/starcore/starcore/module/nation/NationClaimOperation.java
new file mode 100644
index 0000000..342f50f
--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/module/nation/NationClaimOperation.java
@@ -0,0 +1,114 @@
+package dev.starcore.starcore.module.nation;
+
+import dev.starcore.starcore.foundation.economy.PlayerMoneyService;
+import dev.starcore.starcore.foundation.territory.TerritoryBatchService;
+import dev.starcore.starcore.foundation.territory.model.ChunkCoordinate;
+import dev.starcore.starcore.module.nation.model.*;
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.nio.charset.StandardCharsets;
+import java.util.*;
+
+record NationClaimOperation(
+    NationClaimService.Request request,
+    NationId nationId,
+    String nationName,
+    ClaimPriceBreakdown quote,
+    int maxClaims,
+    NationClaimService.State state,
+    int refundAttempt,
+    String detail) {
+  NationClaimOperation {
+    Objects.requireNonNull(request);
+    Objects.requireNonNull(nationId);
+    Objects.requireNonNull(quote);
+    Objects.requireNonNull(state);
+    Objects.requireNonNull(detail);
+    if (nationName == null
+        || nationName.isBlank()
+        || nationName.length() > 128
+        || maxClaims < -1
+        || refundAttempt < 0
+        || detail.length() > 512
+        || quote.chunkCount() != request.selection().chunkCount())
+      throw new IllegalArgumentException("Invalid claim operation");
+    var total = amount(quote.totalPrice());
+    var base = amount(quote.baseChunkPrice());
+    var coordinates = request.selection().coordinates();
+    if (!quote.chunks().isEmpty()) {
+      if (quote.chunks().size() != coordinates.size())
+        throw new IllegalArgumentException("Incomplete claim quote");
+      for (int i = 0; i < coordinates.size(); i++) {
+        var p = quote.chunks().get(i);
+        var c = coordinates.get(i);
+        if (!c.equals(new ChunkCoordinate(p.world(), p.chunkX(), p.chunkZ()))
+            || p.biome() == null
+            || p.biome().length() > 128
+            || !Double.isFinite(p.biomeRichness())
+            || p.biomeRichness() < 0
+            || !Double.isFinite(p.distanceMultiplier())
+            || p.distanceMultiplier() < 0
+            || !Double.isFinite(p.biomeMultiplier())
+            || p.biomeMultiplier() < 0
+            || p.distanceBlocks() < 0)
+          throw new IllegalArgumentException("Invalid claim quote chunk");
+        amount(p.price());
+      }
+    }
+    quote = new ClaimPriceBreakdown(base, total, quote.chunkCount(), quote.chunks());
+  }
+
+  private static BigDecimal amount(BigDecimal value) {
+    value = Objects.requireNonNull(value).setScale(2, RoundingMode.UNNECESSARY);
+    if (value.signum() < 0 || value.compareTo(PlayerMoneyService.MAX_BALANCE) > 0)
+      throw new IllegalArgumentException("Invalid claim price");
+    return value;
+  }
+
+  NationClaimOperation state(NationClaimService.State next, String reason) {
+    return new NationClaimOperation(
+        request, nationId, nationName, quote, maxClaims, next, refundAttempt, reason);
+  }
+
+  NationClaimOperation retryRefund() {
+    return new NationClaimOperation(
+        request,
+        nationId,
+        nationName,
+        quote,
+        maxClaims,
+        NationClaimService.State.REFUND_PENDING,
+        Math.addExact(refundAttempt, 1),
+        detail);
+  }
+
+  NationClaimService.Receipt receipt() {
+    return new NationClaimService.Receipt(request, nationId, nationName, quote, state, detail);
+  }
+
+  TerritoryBatchService.Request batch() {
+    return new TerritoryBatchService.Request(
+        id("land"), nationId.toString(), request.selection().coordinates(), maxClaims);
+  }
+
+  PlayerMoneyService.Request debit() {
+    return money("debit", PlayerMoneyService.Direction.DEBIT);
+  }
+
+  PlayerMoneyService.Request refund() {
+    return money("refund/" + refundAttempt, PlayerMoneyService.Direction.CREDIT);
+  }
+
+  private UUID id(String suffix) {
+    return UUID.nameUUIDFromBytes(source(suffix).getBytes(StandardCharsets.UTF_8));
+  }
+
+  private String source(String suffix) {
+    return "nation-claim/" + request.operationId() + "/" + suffix;
+  }
+
+  private PlayerMoneyService.Request money(String suffix, PlayerMoneyService.Direction direction) {
+    return new PlayerMoneyService.Request(
+        id(suffix), request.playerId(), direction, quote.totalPrice(), source(suffix));
+  }
+}
diff --git a/src/main/java/dev/starcore/starcore/module/nation/NationClaimOperationCodec.java b/src/main/java/dev/starcore/starcore/module/nation/NationClaimOperationCodec.java
new file mode 100644
index 0000000..8841ff5
--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/module/nation/NationClaimOperationCodec.java
@@ -0,0 +1,119 @@
+package dev.starcore.starcore.module.nation;
+
+import dev.starcore.starcore.foundation.territory.model.ChunkClaimSelection;
+import dev.starcore.starcore.module.nation.model.*;
+import java.math.BigDecimal;
+import java.util.*;
+
+final class NationClaimOperationCodec {
+  static final String PREFIX = "claimOperations.";
+
+  private NationClaimOperationCodec() {}
+
+  static void write(Properties p, Map<UUID, NationClaimOperation> operations) {
+    p.setProperty(PREFIX + "version", "1");
+    p.setProperty(PREFIX + "count", Integer.toString(operations.size()));
+    int i = 0;
+    for (var e : operations.entrySet().stream().sorted(Map.Entry.comparingByKey()).toList()) {
+      var op = e.getValue();
+      if (!e.getKey().equals(op.request().operationId()))
+        throw new IllegalArgumentException("Claim operation key mismatch");
+      String k = PREFIX + i++ + ".";
+      var r = op.request();
+      var s = r.selection();
+      p.setProperty(k + "id", r.operationId().toString());
+      p.setProperty(k + "player", r.playerId().toString());
+      p.setProperty(k + "world", s.world());
+      p.setProperty(k + "minX", "" + s.minChunkX());
+      p.setProperty(k + "maxX", "" + s.maxChunkX());
+      p.setProperty(k + "minZ", "" + s.minChunkZ());
+      p.setProperty(k + "maxZ", "" + s.maxChunkZ());
+      p.setProperty(k + "nation", op.nationId().toString());
+      p.setProperty(k + "name", op.nationName());
+      p.setProperty(k + "base", op.quote().baseChunkPrice().toPlainString());
+      p.setProperty(k + "total", op.quote().totalPrice().toPlainString());
+      p.setProperty(k + "max", "" + op.maxClaims());
+      p.setProperty(k + "state", op.state().name());
+      p.setProperty(k + "refundAttempt", "" + op.refundAttempt());
+      p.setProperty(k + "detail", op.detail());
+      p.setProperty(k + "quoteCount", "" + op.quote().chunks().size());
+      for (int j = 0; j < op.quote().chunks().size(); j++) {
+        var q = op.quote().chunks().get(j);
+        String c = k + "quote." + j + ".";
+        p.setProperty(c + "biome", q.biome());
+        p.setProperty(c + "richness", "" + q.biomeRichness());
+        p.setProperty(c + "distance", "" + q.distanceBlocks());
+        p.setProperty(c + "distanceMultiplier", "" + q.distanceMultiplier());
+        p.setProperty(c + "biomeMultiplier", "" + q.biomeMultiplier());
+        p.setProperty(c + "price", q.price().toPlainString());
+      }
+    }
+  }
+
+  static Map<UUID, NationClaimOperation> read(Properties p) {
+    if (!"1".equals(p.getProperty(PREFIX + "version")))
+      throw new IllegalArgumentException("Invalid claim operation version");
+    int count = integer(p, PREFIX + "count");
+    if (count < 1 || count > 100_000)
+      throw new IllegalArgumentException("Invalid claim operation count");
+    Map<UUID, NationClaimOperation> result = new LinkedHashMap<>();
+    for (int i = 0; i < count; i++) {
+      String k = PREFIX + i + ".";
+      var s =
+          new ChunkClaimSelection(
+              p.getProperty(k + "world"),
+              integer(p, k + "minX"),
+              integer(p, k + "maxX"),
+              integer(p, k + "minZ"),
+              integer(p, k + "maxZ"));
+      var r =
+          new NationClaimService.Request(
+              UUID.fromString(p.getProperty(k + "id")),
+              UUID.fromString(p.getProperty(k + "player")),
+              s);
+      int quotes = integer(p, k + "quoteCount");
+      if (quotes != 0 && quotes != s.chunkCount())
+        throw new IllegalArgumentException("Incomplete claim quote");
+      List<ClaimChunkPrice> prices = new ArrayList<>();
+      var coords = s.coordinates();
+      for (int j = 0; j < quotes; j++) {
+        String c = k + "quote." + j + ".";
+        var coordinate = coords.get(j);
+        prices.add(
+            new ClaimChunkPrice(
+                s.world(),
+                coordinate.x(),
+                coordinate.z(),
+                p.getProperty(c + "biome"),
+                Double.parseDouble(p.getProperty(c + "richness")),
+                Long.parseLong(p.getProperty(c + "distance")),
+                Double.parseDouble(p.getProperty(c + "distanceMultiplier")),
+                Double.parseDouble(p.getProperty(c + "biomeMultiplier")),
+                new BigDecimal(p.getProperty(c + "price"))));
+      }
+      var quote =
+          new ClaimPriceBreakdown(
+              new BigDecimal(p.getProperty(k + "base")),
+              new BigDecimal(p.getProperty(k + "total")),
+              s.chunkCount(),
+              prices);
+      var op =
+          new NationClaimOperation(
+              r,
+              new NationId(UUID.fromString(p.getProperty(k + "nation"))),
+              p.getProperty(k + "name"),
+              quote,
+              integer(p, k + "max"),
+              NationClaimService.State.valueOf(p.getProperty(k + "state")),
+              integer(p, k + "refundAttempt"),
+              p.getProperty(k + "detail"));
+      if (result.putIfAbsent(r.operationId(), op) != null)
+        throw new IllegalArgumentException("Duplicate claim operation");
+    }
+    return Map.copyOf(result);
+  }
+
+  private static int integer(Properties p, String key) {
+    return Integer.parseInt(p.getProperty(key));
+  }
+}
