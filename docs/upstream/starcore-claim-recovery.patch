diff --git a/src/main/java/dev/starcore/starcore/foundation/territory/DurableTerritoryService.java b/src/main/java/dev/starcore/starcore/foundation/territory/DurableTerritoryService.java
new file mode 100644
index 0000000..56c2353
--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/foundation/territory/DurableTerritoryService.java
@@ -0,0 +1,152 @@
+package dev.starcore.starcore.foundation.territory;
+
+import dev.starcore.starcore.foundation.territory.model.ChunkCoordinate;
+import dev.starcore.starcore.foundation.territory.model.TerritoryClaim;
+import java.util.*;
+
+abstract class DurableTerritoryService implements TerritoryService, TerritoryBatchService {
+  private final TerritoryLedgerStorage storage;
+  private boolean closed;
+
+  DurableTerritoryService(TerritoryLedgerStorage storage) {
+    this.storage = Objects.requireNonNull(storage);
+    storage.load();
+  }
+
+  private TerritoryLedger load() {
+    if (closed) throw new IllegalStateException("Territory service is already closed");
+    return storage.load();
+  }
+
+  public synchronized Optional<TerritoryClaim> claimAt(ChunkCoordinate c) {
+    return Optional.ofNullable(load().claims().get(Objects.requireNonNull(c)));
+  }
+
+  public synchronized boolean isClaimed(ChunkCoordinate c) {
+    return claimAt(c).isPresent();
+  }
+
+  public synchronized int claimedChunkCount() {
+    return load().claims().size();
+  }
+
+  public synchronized Collection<TerritoryClaim> claimsByOwner(String owner) {
+    return load().claims().values().stream().filter(c -> c.ownerId().equals(owner)).toList();
+  }
+
+  public synchronized boolean claim(String owner, ChunkCoordinate c) {
+    new Request(UUID.randomUUID(), owner, List.of(c), -1);
+    var state = load();
+    if (state.claims().containsKey(c)) return false;
+    var next = new HashMap<>(state.claims());
+    next.put(c, new TerritoryClaim(owner, c));
+    commit(new TerritoryLedger(next, state.receipts()));
+    return true;
+  }
+
+  public synchronized boolean unclaim(String owner, ChunkCoordinate c) {
+    var state = load();
+    var current = state.claims().get(c);
+    if (current == null || !current.ownerId().equals(owner)) return false;
+    var next = new HashMap<>(state.claims());
+    next.remove(c);
+    commit(new TerritoryLedger(next, state.receipts()));
+    return true;
+  }
+
+  public synchronized boolean unclaimDurably(String owner, ChunkCoordinate c) {
+    return unclaimClaimsDurably(List.of(new TerritoryClaim(owner, c)));
+  }
+
+  public synchronized boolean unclaimClaimsDurably(Collection<TerritoryClaim> expected) {
+    var state = load();
+    var next = new HashMap<>(state.claims());
+    Set<ChunkCoordinate> unique = new HashSet<>();
+    for (var claim : List.copyOf(expected)) {
+      if (!unique.add(claim.coordinate()))
+        throw new IllegalArgumentException("Durable unclaim contains duplicate coordinates");
+      var current = next.get(claim.coordinate());
+      if (current != null && !current.ownerId().equals(claim.ownerId())) return false;
+      next.remove(claim.coordinate());
+    }
+    if (!next.equals(state.claims())) commit(new TerritoryLedger(next, state.receipts()));
+    return true;
+  }
+
+  public synchronized boolean transferClaims(
+      String source, String target, Collection<ChunkCoordinate> coordinates) {
+    var transfer = ClaimTransfer.of(source, target, coordinates);
+    var state = load();
+    var next = new HashMap<>(state.claims());
+    for (var c : transfer.coordinates()) {
+      var current = next.get(c);
+      if (current == null || !source.equals(current.ownerId())) return false;
+      next.put(c, new TerritoryClaim(target, c));
+    }
+    commit(new TerritoryLedger(next, state.receipts()));
+    return true;
+  }
+
+  public synchronized Receipt claimBatch(Request request) {
+    return batch(request, false);
+  }
+
+  public synchronized Receipt cancelBatch(Request request) {
+    return batch(request, true);
+  }
+
+  public synchronized Optional<Receipt> batchReceipt(UUID id) {
+    return Optional.ofNullable(load().receipts().get(Objects.requireNonNull(id)));
+  }
+
+  private Receipt batch(Request request, boolean cancel) {
+    Objects.requireNonNull(request);
+    var state = load();
+    var previous = state.receipts().get(request.operationId());
+    if (previous != null) {
+      if (!previous.request().equals(request))
+        throw new IllegalArgumentException("Conflicting territory batch");
+      return previous;
+    }
+    Status status = cancel ? Status.CANCELLED : Status.APPLIED;
+    if (!cancel) {
+      if (request.coordinates().stream().anyMatch(state.claims()::containsKey))
+        status = Status.OVERLAP;
+      else if (request.maxOwnerClaims() >= 0
+          && state.claims().values().stream()
+                      .filter(c -> c.ownerId().equals(request.ownerId()))
+                      .count()
+                  + request.coordinates().size()
+              > request.maxOwnerClaims()) status = Status.LIMIT_REACHED;
+    }
+    var next = new HashMap<>(state.claims());
+    var receipts = new HashMap<>(state.receipts());
+    var result = new Receipt(request, status);
+    receipts.put(request.operationId(), result);
+    if (status == Status.APPLIED)
+      for (var c : request.coordinates()) next.put(c, new TerritoryClaim(request.ownerId(), c));
+    commit(new TerritoryLedger(next, receipts));
+    return result;
+  }
+
+  private void commit(TerritoryLedger next) {
+    try {
+      storage.save(next);
+    } catch (RuntimeException failure) {
+      try {
+        if (storage.load().equals(next)) return;
+      } catch (RuntimeException read) {
+        failure.addSuppressed(read);
+      }
+      throw failure;
+    }
+  }
+
+  public synchronized void shutdown() {
+    closed = true;
+  }
+
+  public synchronized void save() {
+    load();
+  }
+}
