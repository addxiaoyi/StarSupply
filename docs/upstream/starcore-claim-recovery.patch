+package dev.starcore.starcore.module.nation.command;
+
+import static org.mockito.Mockito.*;
+
+import dev.starcore.starcore.module.nation.NationClaimService;
+import dev.starcore.starcore.module.nation.NationService;
+import java.util.List;
+import java.util.UUID;
+import org.bukkit.command.CommandSender;
+import org.bukkit.plugin.Plugin;
+import org.junit.jupiter.api.Test;
+
+class NationClaimRecoveryCommandTest {
+  @Test
+  void permissionsProtectConsoleQueriesAndCancellation() {
+    var nations =
+        mock(NationService.class, withSettings().extraInterfaces(NationClaimService.class));
+    var service = (NationClaimService) nations;
+    var sender = mock(CommandSender.class);
+    var command = new NationLifecycleCommand(mock(Plugin.class), nations);
+    var id = UUID.randomUUID().toString();
+    command.onCommand(
+        sender, null, "nation", new String[] {"claimrecovery", "cancel", id, "confirm"});
+    verifyNoInteractions(nations);
+    when(sender.hasPermission("starcore.admin")).thenReturn(true);
+    command.onCommand(sender, null, "nation", new String[] {"claimrecovery", "cancel", id});
+    verifyNoInteractions(nations);
+    when(service.pendingClaims()).thenReturn(List.of());
+    command.onCommand(sender, null, "nation", new String[] {"claimrecovery", "list"});
+    verify(service).pendingClaims();
+    command.onCommand(sender, null, "nation", new String[] {"claimrecovery", "retry", id});
+    verify(service).recoverClaim(UUID.fromString(id));
+    command.onCommand(
+        sender, null, "nation", new String[] {"claimrecovery", "cancel", id, "confirm"});
+    verify(service).cancelClaim(UUID.fromString(id));
+  }
+
+  @Test
+  void retiredCommandCannotRecoverOrForward() {
