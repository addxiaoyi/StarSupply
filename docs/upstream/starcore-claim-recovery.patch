@@ -0,0 +1,144 @@
+package dev.starcore.starcore.foundation.territory;
+
+import dev.starcore.starcore.core.persistence.AtomicFilePersistence;
+import dev.starcore.starcore.core.persistence.PersistenceService;
+import java.io.*;
+import java.nio.file.*;
+import java.util.*;
+import java.util.Properties;
+
+final class FileTerritoryLedgerStorage implements TerritoryLedgerStorage {
+  private static final String FILE_NAME = "claims.properties";
+
+  private static final Object[] GUARDS = new Object[64];
+
+  static {
+    Arrays.setAll(GUARDS, ignored -> new Object());
+  }
+
+  private Path path;
+  private final String namespace;
+  private final PersistenceService persistenceService;
+  private byte[] expected;
+  private boolean loaded, failed;
+
+  FileTerritoryLedgerStorage(PersistenceService persistenceService) {
+    this.namespace = "territory";
+    this.persistenceService = Objects.requireNonNull(persistenceService);
+  }
+
+  private void resolvePath() {
+    if (path != null) return;
+    try {
+      path =
+          Objects.requireNonNull(persistenceService)
+              .namespacePath(namespace)
+              .resolve(FILE_NAME)
+              .toAbsolutePath()
+              .normalize();
+    } catch (IOException failure) {
+      throw new IllegalStateException("Territory storage unavailable", failure);
+    }
+  }
+
+  @Override
+  public synchronized TerritoryLedger load() {
+    resolvePath();
+    try {
+      byte[] data = read();
+      if (data == null
+          && (expected != null
+              || Files.exists(AtomicFilePersistence.backup(path))
+              || Files.exists(AtomicFilePersistence.temp(path))))
+        throw new IOException("Missing territory authority; explicit recovery required");
+      Properties value = decode(data);
+      expected = data;
+      loaded = true;
+      failed = false;
+      return TerritoryLedger.decode(value);
+    } catch (IOException | RuntimeException failure) {
+      failed = true;
+      throw new IllegalStateException("Territory authority requires reconciliation", failure);
+    }
+  }
+
+  @Override
+  public synchronized void save(TerritoryLedger ledger) {
+    Properties properties = ledger.properties();
+    resolvePath();
+    synchronized (GUARDS[Math.floorMod(path.hashCode(), GUARDS.length)]) {
+      if (!loaded) load();
+      requireLoaded();
+      TerritoryLedger.decode(properties);
+      var canonical = properties;
+      try {
+        byte[] current = read();
+        if (!Arrays.equals(expected, current))
+          throw new IllegalStateException("Territory file changed; retry original operation");
+        var buffer = new ByteArrayOutputStream();
+        canonical.store(buffer, "STARCORE territory state");
+        byte[] candidate = buffer.toByteArray();
+        if (candidate.length > 64 * 1024 * 1024)
+          throw new IOException("Territory snapshot too large");
+        try {
+          AtomicFilePersistence.replace(path, temp -> Files.write(temp, candidate));
+          if (!Arrays.equals(read(), candidate))
+            throw new IOException("Territory snapshot not published");
+        } catch (IOException | RuntimeException failure) {
+          byte[] actual;
+          try {
+            actual = read();
+          } catch (IOException unreadable) {
+            failed = true;
+            failure.addSuppressed(unreadable);
+            throw new IllegalStateException("Territory authority requires reconciliation", failure);
+          }
+          if (Arrays.equals(actual, candidate)) {
+            expected = candidate;
+            return;
+          }
+          if (!Arrays.equals(actual, expected)) {
+            failed = true;
+            throw new IllegalStateException("Territory authority requires reconciliation", failure);
+          }
+          throw failure;
+        }
+        expected = candidate;
+      } catch (IOException failure) {
+        throw new IllegalStateException("Territory file save failed", failure);
+      }
+    }
+  }
+
+  private void requireLoaded() {
+    if (!loaded || failed) throw new IllegalStateException("Territory storage unavailable");
+  }
+
+  private byte[] read() throws IOException {
+    if (!Files.exists(path)) return null;
+    if (!Files.isRegularFile(path) || Files.size(path) > 64 * 1024 * 1024)
+      throw new IOException("Invalid territory authority file");
+    try (var input = Files.newInputStream(path)) {
+      byte[] bytes = input.readNBytes(64 * 1024 * 1024 + 1);
+      if (bytes.length > 64 * 1024 * 1024) throw new IOException("Territory file too large");
+      return bytes;
+    }
+  }
+
+  private Properties decode(byte[] bytes) throws IOException {
+    Properties value =
+        new Properties() {
+          @Override
+          public synchronized Object put(Object key, Object text) {
+            if (containsKey(key))
+              throw new IllegalArgumentException("Duplicate territory property");
+            return super.put(key, text);
+          }
+        };
+    if (bytes == null) return value;
+    value.load(new ByteArrayInputStream(bytes));
+    if (value.isEmpty()) throw new IOException("Empty territory authority");
+    TerritoryLedger.decode(value);
+    return value;
+  }
+}
