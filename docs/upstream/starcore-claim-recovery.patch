+          "CREATE TRIGGER fail_insert BEFORE INSERT ON "
+              + table
+              + " BEGIN SELECT RAISE(ABORT,'forced transaction failure'); END");
+    }
+    assertThatThrownBy(() -> land.claimBatch(original)).isInstanceOf(IllegalStateException.class);
+    var restarted = service(stores.get());
+    assertThat(restarted.claimedChunkCount()).isZero();
+    assertThat(restarted.batchReceipt(original.operationId())).isEmpty();
+    try (var c = source().getConnection();
+        var s = c.createStatement()) {
+      s.execute("DROP TRIGGER fail_insert");
+    }
+    assertThat(restarted.claimBatch(original).status())
+        .isEqualTo(TerritoryBatchService.Status.APPLIED);
+  }
