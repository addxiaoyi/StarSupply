+package dev.starcore.starcore.foundation.territory;
+
+import dev.starcore.starcore.foundation.territory.model.ChunkCoordinate;
+import dev.starcore.starcore.foundation.territory.model.TerritoryClaim;
+import java.io.*;
+import java.sql.*;
+import java.util.*;
+import java.util.function.Supplier;
+import javax.sql.DataSource;
+
+final class SqlTerritoryLedgerStorage implements TerritoryLedgerStorage {
+  private final Supplier<Optional<DataSource>> source;
+  private final Supplier<TerritoryLedger> legacy;
+  private long expected = -1;
+  private String expectedHash;
+  private boolean initialized;
+
+  SqlTerritoryLedgerStorage(
+      Supplier<Optional<DataSource>> source, Supplier<TerritoryLedger> legacy) {
+    this.source = Objects.requireNonNull(source);
+    this.legacy = Objects.requireNonNull(legacy);
+  }
+
+  private Connection open() throws SQLException {
+    return source
+        .get()
+        .orElseThrow(() -> new IllegalStateException("Territory database unavailable"))
+        .getConnection();
+  }
+
+  private void initialize(Connection c) throws SQLException {
+    if (initialized) return;
+    boolean claims = table(c, "starcore_territory_claims"),
+        receipts = table(c, "starcore_territory_batch_receipts"),
+        revision = table(c, "starcore_territory_revision");
+    boolean durable = receipts || revision;
+    if (durable && (!claims || !receipts || !revision))
+      throw new SQLException("Missing territory authority table");
+    boolean sqlite = "SQLite".equalsIgnoreCase(c.getMetaData().getDatabaseProductName());
+    try (var s = c.createStatement()) {
+      s.execute(
+          "CREATE TABLE IF NOT EXISTS starcore_territory_claims (world_name VARCHAR(191) NOT"
+              + " NULL,chunk_x INTEGER NOT NULL,chunk_z INTEGER NOT NULL,owner_id VARCHAR(64) NOT"
+              + " NULL,PRIMARY KEY(world_name,chunk_x,chunk_z))");
+      s.execute(
+          "CREATE TABLE IF NOT EXISTS starcore_territory_batch_receipts (operation_id VARCHAR(36)"
+              + " PRIMARY KEY,payload "
+              + (sqlite ? "TEXT" : "LONGTEXT")
+              + " NOT NULL)");
+      s.execute(
+          "CREATE TABLE IF NOT EXISTS starcore_territory_revision (singleton INTEGER PRIMARY"
+              + " KEY,revision BIGINT NOT NULL,checksum VARCHAR(64) NOT NULL)");
+      if (!durable)
+        s.execute(
+            sqlite
+                ? "INSERT INTO starcore_territory_revision VALUES(1,0,'') ON CONFLICT(singleton) DO"
+                    + " NOTHING"
+                : "INSERT IGNORE INTO starcore_territory_revision VALUES(1,0,'')");
+    }
+    initialized = true;
+  }
+
+  private boolean table(Connection c, String name) throws SQLException {
+    try (var r = c.getMetaData().getTables(c.getCatalog(), null, name, new String[] {"TABLE"})) {
+      while (r.next()) if (name.equalsIgnoreCase(r.getString("TABLE_NAME"))) return true;
+      return false;
+    }
+  }
+
+  private record Revision(long value, String checksum) {}
+
+  private Revision revision(Connection c) throws SQLException {
+    try (var s = c.createStatement();
+        var r =
+            s.executeQuery(
+                "SELECT revision,checksum FROM starcore_territory_revision WHERE singleton=1")) {
+      if (!r.next()) throw new SQLException("Missing territory revision");
+      long value = r.getLong(1);
+      String hash = r.getString(2);
+      if (value < 0
+          || value == Long.MAX_VALUE
+          || hash == null
+          || (value == 0 && !hash.isEmpty())
+          || (value > 0 && !hash.matches("[0-9a-f]{64}")))
+        throw new SQLException("Invalid territory revision");
+      return new Revision(value, hash);
+    }
+  }
+
+  public synchronized TerritoryLedger load() {
+    TerritoryLedger initial = null;
+    try (var c = open()) {
+      initialize(c);
+      for (int attempt = 0; attempt < 8; attempt++) {
+        var before = revision(c);
+        var ledger = read(c);
+        var after = revision(c);
+        if (!before.equals(after)) continue;
+        if (after.value() > 0
+            && !after.checksum().equals(ledger.properties().getProperty("batches.sha256")))
+          throw new SQLException("Territory authority checksum mismatch");
+        expected = after.value();
+        expectedHash = after.checksum();
+        if (expected != 0) return ledger;
+        initial = ledger.claims().isEmpty() && ledger.receipts().isEmpty() ? legacy.get() : ledger;
+        break;
+      }
+      if (initial == null) throw new SQLException("Territory authority changed while reading");
+    } catch (SQLException e) {
+      throw new IllegalStateException("Unable to load territory claims", e);
+    }
+    // Release the read connection before the first publication; a one-connection pool is valid.
+    save(initial);
+    return initial;
+  }
+
+  private TerritoryLedger read(Connection c) throws SQLException {
+    Map<ChunkCoordinate, TerritoryClaim> claims = new HashMap<>();
+    Map<UUID, TerritoryBatchService.Receipt> receipts = new HashMap<>();
+    try (var s = c.createStatement();
+        var r =
+            s.executeQuery(
+                "SELECT world_name,chunk_x,chunk_z,owner_id FROM starcore_territory_claims")) {
+      while (r.next()) {
+        long x = r.getLong(2), z = r.getLong(3);
+        if (x < Integer.MIN_VALUE
+            || x > Integer.MAX_VALUE
+            || z < Integer.MIN_VALUE
+            || z > Integer.MAX_VALUE) throw new SQLException("Invalid territory coordinate");
+        var coordinate = new ChunkCoordinate(r.getString(1), (int) x, (int) z);
+        String owner = r.getString(4);
+        if (owner == null
+            || owner.isBlank()
+            || owner.length() > 64
+            || coordinate.world().isBlank()
+            || coordinate.world().length() > 191) throw new SQLException("Invalid territory claim");
+        if (claims.putIfAbsent(coordinate, new TerritoryClaim(owner, coordinate)) != null)
+          throw new SQLException("Duplicate claim");
+        if (claims.size() > 1_000_000) throw new SQLException("Too many territory claims");
+      }
+    }
+    try (var s = c.createStatement();
+        var r =
+            s.executeQuery("SELECT operation_id,payload FROM starcore_territory_batch_receipts")) {
+      while (r.next()) {
+        if (receipts.size() >= 100_000) throw new SQLException("Too many territory receipts");
+        Properties p =
+            new Properties() {
+              public synchronized Object put(Object k, Object v) {
+                if (containsKey(k)) throw new IllegalArgumentException("Duplicate receipt field");
+                return super.put(k, v);
+              }
+            };
+        try {
+          String payload = r.getString(2);
+          if (payload == null || payload.length() > 64 * 1024 * 1024)
+            throw new SQLException("Invalid territory receipt payload");
+          p.load(new StringReader(payload));
+        } catch (IOException e) {
+          throw new SQLException(e);
+        }
+        var receipt = TerritoryLedger.readReceipt(p, "");
+        Properties exact = new Properties();
+        TerritoryLedger.writeReceipt(exact, "", receipt);
+        if (!p.equals(exact)
+            || !receipt.request().operationId().toString().equals(r.getString(1))
+            || receipts.putIfAbsent(receipt.request().operationId(), receipt) != null)
+          throw new SQLException("Invalid territory receipt");
+      }
+    }
+    return new TerritoryLedger(claims, receipts);
+  }
+
+  public synchronized void save(TerritoryLedger ledger) {
+    var properties = ledger.properties();
+    TerritoryLedger.decode(properties);
+    if (expected < 0) throw new IllegalStateException("Load territory authority before writing");
+    try (var c = open()) {
+      boolean auto = c.getAutoCommit();
+      c.setAutoCommit(false);
+      boolean safe = false;
+      try {
+        try (var update =
+            c.prepareStatement(
+                "UPDATE starcore_territory_revision SET revision=revision+1,checksum=? WHERE"
+                    + " singleton=1 AND revision=?")) {
+          update.setString(1, properties.getProperty("batches.sha256"));
+          update.setLong(2, expected);
+          if (update.executeUpdate() != 1)
+            throw new SQLException("Stale territory revision; retry original operation");
+        }
+        var previous = read(c);
+        if (expected > 0
+            && !previous.properties().getProperty("batches.sha256").equals(expectedHash))
+          throw new SQLException("Territory changed outside revision protocol");
+        if (!ledger.receipts().entrySet().containsAll(previous.receipts().entrySet()))
+          throw new SQLException("Territory receipts cannot be removed or changed");
+        try (var s = c.createStatement()) {
+          s.executeUpdate("DELETE FROM starcore_territory_claims");
+        }
+        try (var insert =
+            c.prepareStatement(
+                "INSERT INTO starcore_territory_claims(world_name,chunk_x,chunk_z,owner_id)"
+                    + " VALUES(?,?,?,?)")) {
+          for (var claim : ledger.claims().values()) {
+            insert.setString(1, claim.coordinate().world());
+            insert.setInt(2, claim.coordinate().x());
+            insert.setInt(3, claim.coordinate().z());
+            insert.setString(4, claim.ownerId());
+            insert.addBatch();
+          }
+          insert.executeBatch();
+        }
+        try (var insert =
+            c.prepareStatement(
+                "INSERT INTO starcore_territory_batch_receipts(operation_id,payload)"
+                    + " VALUES(?,?)")) {
+          for (var entry : ledger.receipts().entrySet())
+            if (!previous.receipts().containsKey(entry.getKey())) {
+              Properties p = new Properties();
+              TerritoryLedger.writeReceipt(p, "", entry.getValue());
+              StringWriter output = new StringWriter();
+              try {
+                p.store(output, "territory receipt");
+              } catch (IOException e) {
+                throw new SQLException(e);
+              }
+              insert.setString(1, entry.getKey().toString());
+              insert.setString(2, output.toString());
+              insert.addBatch();
+            }
+          insert.executeBatch();
+        }
+        c.commit();
+        safe = true;
+        expected++;
+        expectedHash = properties.getProperty("batches.sha256");
+      } catch (SQLException | RuntimeException failure) {
+        try {
+          c.rollback();
+          safe = true;
+        } catch (SQLException rollback) {
+          failure.addSuppressed(rollback);
+        }
+        throw failure;
+      } finally {
+        if (safe) c.setAutoCommit(auto);
+      }
+    } catch (SQLException e) {
+      throw new IllegalStateException("Unable to persist territory claims", e);
+    }
+  }
+}
