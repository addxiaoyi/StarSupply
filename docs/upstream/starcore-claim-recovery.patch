+  static final class FaultStorage implements NationStateStorage {
+    final NationStateStorage delegate;
+    int saves, failAt;
+    boolean after, blockRead, failed;
+
+    FaultStorage(NationStateStorage delegate) {
+      this.delegate = delegate;
+    }
+
+    public Properties load() {
+      if (failed && blockRead) throw new IllegalStateException("read unavailable");
+      return delegate.load();
+    }
+
+    public void save(Properties state) {
+      boolean fail = ++saves == failAt;
+      if (!fail || after) delegate.save(state);
+      if (fail) {
+        failed = true;
+        throw new IllegalStateException("reply lost");
+      }
+    }
+  }
+
+  static final class LostMoney implements PlayerMoneyService {
+    final PlayerMoneyService delegate;
+    final Direction direction;
+    boolean lost, block;
+
+    LostMoney(PlayerMoneyService delegate, Direction direction) {
+      this.delegate = delegate;
+      this.direction = direction;
+    }
+
+    public Receipt applyMoney(Request request) {
+      var receipt = delegate.applyMoney(request);
+      if (!lost && request.direction() == direction) {
+        lost = true;
+        throw new IllegalStateException("money reply lost");
+      }
+      return receipt;
+    }
+
+    public Optional<Receipt> moneyReceipt(UUID id) {
+      if (lost && block) throw new IllegalStateException("money read unavailable");
+      return delegate.moneyReceipt(id);
+    }
+  }
+
+  static final class LostLand implements TerritoryBatchService {
+    final TerritoryBatchService delegate;
+    boolean lost, block;
+
+    LostLand(TerritoryBatchService delegate) {
+      this.delegate = delegate;
+    }
+
+    public Receipt claimBatch(Request request) {
+      var receipt = delegate.claimBatch(request);
+      lost = true;
+      throw new IllegalStateException("land reply lost");
+    }
+
+    public Receipt cancelBatch(Request request) {
+      return delegate.cancelBatch(request);
+    }
+
+    public Optional<Receipt> batchReceipt(UUID id) {
+      if (lost && block) throw new IllegalStateException("land read unavailable");
+      return delegate.batchReceipt(id);
+    }
+  }
