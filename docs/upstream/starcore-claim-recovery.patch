+package dev.starcore.starcore.foundation.territory;
+
+import dev.starcore.starcore.foundation.territory.model.ChunkCoordinate;
+import dev.starcore.starcore.foundation.territory.model.TerritoryClaim;
+import java.util.*;
+
+record TerritoryLedger(
+    Map<ChunkCoordinate, TerritoryClaim> claims,
+    Map<UUID, TerritoryBatchService.Receipt> receipts) {
+  TerritoryLedger {
+    claims = Map.copyOf(claims);
+    receipts = Map.copyOf(receipts);
+    for (var e : claims.entrySet()) {
+      var c = e.getKey();
+      var owner = e.getValue().ownerId();
+      if (!c.equals(e.getValue().coordinate())
+          || owner == null
+          || owner.isBlank()
+          || owner.length() > 64
+          || c.world().isBlank()
+          || c.world().length() > 191)
+        throw new IllegalArgumentException("Invalid territory claim");
+    }
+  }
+
+  Properties properties() {
+    Properties result = TerritoryStateCodec.toProperties(claims.values());
+    result.setProperty("batches.version", "1");
+    result.setProperty("batches.count", Integer.toString(receipts.size()));
+    int i = 0;
+    for (var entry : receipts.entrySet().stream().sorted(Map.Entry.comparingByKey()).toList()) {
+      var receipt = entry.getValue();
+      if (!entry.getKey().equals(receipt.request().operationId()))
+        throw new IllegalArgumentException("Territory receipt key mismatch");
+      String key = "batches." + i++ + ".";
+      writeReceipt(result, key, receipt);
+    }
+    result.setProperty("batches.sha256", checksum(result));
+    return result;
+  }
+
+  static void writeReceipt(Properties p, String key, TerritoryBatchService.Receipt r) {
+    p.setProperty(key + "id", r.request().operationId().toString());
+    p.setProperty(key + "owner", r.request().ownerId());
+    p.setProperty(key + "max", Integer.toString(r.request().maxOwnerClaims()));
+    p.setProperty(key + "status", r.status().name());
+    p.setProperty(key + "count", Integer.toString(r.request().coordinates().size()));
+    for (int j = 0; j < r.request().coordinates().size(); j++) {
+      var c = r.request().coordinates().get(j);
+      String k = key + "chunk." + j + ".";
+      p.setProperty(k + "world", c.world());
+      p.setProperty(k + "x", Integer.toString(c.x()));
+      p.setProperty(k + "z", Integer.toString(c.z()));
+    }
+  }
+
+  static TerritoryBatchService.Receipt readReceipt(Properties p, String key) {
+    int count = Integer.parseInt(p.getProperty(key + "count"));
+    if (count < 1 || count > 100_000)
+      throw new IllegalArgumentException("Invalid territory receipt size");
+    List<ChunkCoordinate> coordinates = new ArrayList<>();
+    for (int j = 0; j < count; j++) {
+      String k = key + "chunk." + j + ".";
+      coordinates.add(
+          new ChunkCoordinate(
+              p.getProperty(k + "world"),
+              Integer.parseInt(p.getProperty(k + "x")),
+              Integer.parseInt(p.getProperty(k + "z"))));
+    }
+    return new TerritoryBatchService.Receipt(
+        new TerritoryBatchService.Request(
+            UUID.fromString(p.getProperty(key + "id")),
+            p.getProperty(key + "owner"),
+            coordinates,
+            Integer.parseInt(p.getProperty(key + "max"))),
+        TerritoryBatchService.Status.valueOf(p.getProperty(key + "status")));
+  }
+
+  static TerritoryLedger decode(Properties p) {
+    if (p.isEmpty()) return new TerritoryLedger(Map.of(), Map.of());
+    boolean durable = p.stringPropertyNames().stream().anyMatch(k -> k.startsWith("batches."));
+    Properties plain = new Properties();
+    p.stringPropertyNames().stream()
+        .filter(k -> !k.startsWith("batches."))
+        .forEach(k -> plain.setProperty(k, p.getProperty(k)));
+    int claimCount = Integer.parseInt(plain.getProperty("count"));
+    if (claimCount < 0 || claimCount > 1_000_000)
+      throw new IllegalArgumentException("Invalid territory count");
+    Map<ChunkCoordinate, TerritoryClaim> claims = new LinkedHashMap<>();
+    for (int i = 0; i < claimCount; i++) {
+      String k = "claim." + i + ".";
+      var c =
+          new ChunkCoordinate(
+              plain.getProperty(k + "world"),
+              Integer.parseInt(plain.getProperty(k + "x")),
+              Integer.parseInt(plain.getProperty(k + "z")));
+      if (claims.putIfAbsent(c, new TerritoryClaim(plain.getProperty(k + "owner"), c)) != null)
+        throw new IllegalArgumentException("Duplicate claim");
+    }
+    if (!TerritoryStateCodec.toProperties(claims.values()).equals(plain))
+      throw new IllegalArgumentException("Incomplete territory claims");
+    Map<UUID, TerritoryBatchService.Receipt> receipts = new LinkedHashMap<>();
+    if (durable) {
+      if (!"1".equals(p.getProperty("batches.version"))
+          || !checksum(p).equals(p.getProperty("batches.sha256")))
+        throw new IllegalArgumentException("Territory ledger checksum mismatch");
+      int count = Integer.parseInt(p.getProperty("batches.count"));
+      if (count < 0 || count > 100_000)
+        throw new IllegalArgumentException("Invalid territory receipt count");
+      for (int i = 0; i < count; i++) {
+        var r = readReceipt(p, "batches." + i + ".");
+        if (receipts.putIfAbsent(r.request().operationId(), r) != null)
+          throw new IllegalArgumentException("Duplicate territory receipt");
+      }
+    }
+    var result = new TerritoryLedger(claims, receipts);
+    if (durable && !result.properties().equals(p))
+      throw new IllegalArgumentException("Incomplete territory authority");
+    return result;
+  }
+
+  static String checksum(Properties p) {
+    try {
+      var digest = java.security.MessageDigest.getInstance("SHA-256");
+      for (String key :
+          p.stringPropertyNames().stream()
+              .filter(k -> !k.equals("batches.sha256"))
+              .sorted()
+              .toList())
+        for (String value : List.of(key, p.getProperty(key))) {
+          byte[] b = value.getBytes(java.nio.charset.StandardCharsets.UTF_8);
+          digest.update(java.nio.ByteBuffer.allocate(4).putInt(b.length).array());
+          digest.update(b);
+        }
+      return HexFormat.of().formatHex(digest.digest());
+    } catch (java.security.NoSuchAlgorithmException e) {
+      throw new IllegalStateException(e);
+    }
+  }
+}
