+package dev.starcore.starcore.module.nation;
+
+import dev.starcore.starcore.foundation.territory.model.ChunkClaimSelection;
+import dev.starcore.starcore.module.nation.model.ClaimPriceBreakdown;
+import dev.starcore.starcore.module.nation.model.NationId;
+import java.util.List;
+import java.util.Objects;
+import java.util.Optional;
+import java.util.UUID;
+
+/** Durable paid claims. Callers authorize the player and retain the original request ID. */
+public interface NationClaimService {
+  enum State {
+    PREPARED,
+    CLAIMED,
+    REJECTED,
+    CANCEL_PENDING,
+    REFUND_PENDING,
+    REFUND_BLOCKED,
+    REFUNDED,
+    CANCELLED;
+
+    public boolean pending() {
+      return this == PREPARED
+          || this == CANCEL_PENDING
+          || this == REFUND_PENDING
+          || this == REFUND_BLOCKED;
+    }
+  }
+
+  record Request(UUID operationId, UUID playerId, ChunkClaimSelection selection) {
+    public Request {
+      Objects.requireNonNull(operationId);
+      Objects.requireNonNull(playerId);
+      Objects.requireNonNull(selection);
+      if (selection.chunkCount() > 100_000 || selection.world().length() > 191)
+        throw new IllegalArgumentException("Claim selection is too large");
+    }
+  }
+
+  record Receipt(
+      Request request,
+      NationId nationId,
+      String nationName,
+      ClaimPriceBreakdown quote,
+      State state,
+      String detail) {}
+
+  Receipt claim(Request request);
+
+  Optional<Receipt> claimOperation(UUID operationId);
+
+  List<Receipt> pendingClaims();
+
+  Receipt recoverClaim(UUID operationId);
+
+  /** Cancels an uncommitted batch; an already committed territory receipt wins. */
+  Receipt cancelClaim(UUID operationId);
+}
