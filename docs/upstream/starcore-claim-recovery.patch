+  static final class FaultStore implements TerritoryLedgerStorage {
+    final TerritoryLedgerStorage delegate;
+    boolean fail, after, blockRead, failed;
+
+    FaultStore(TerritoryLedgerStorage delegate) {
+      this.delegate = delegate;
+    }
+
+    public TerritoryLedger load() {
+      if (failed && blockRead) throw new IllegalStateException("read unavailable");
+      return delegate.load();
+    }
+
+    public void save(TerritoryLedger state) {
+      if (!fail || after) delegate.save(state);
+      if (fail) {
+        failed = true;
+        throw new IllegalStateException("response lost");
+      }
+    }
+  }
+
+  static final class BarrierStore implements TerritoryLedgerStorage {
+    final TerritoryLedgerStorage delegate;
+    final CyclicBarrier barrier;
+
+    BarrierStore(TerritoryLedgerStorage delegate, CyclicBarrier barrier) {
+      this.delegate = delegate;
+      this.barrier = barrier;
+    }
+
+    public TerritoryLedger load() {
+      return delegate.load();
+    }
+
+    public void save(TerritoryLedger state) {
+      try {
+        barrier.await(10, TimeUnit.SECONDS);
+      } catch (Exception e) {
+        throw new IllegalStateException(e);
+      }
+      delegate.save(state);
+    }
+  }
+}
