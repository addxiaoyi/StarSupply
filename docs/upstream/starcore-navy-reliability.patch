+package dev.starcore.starcore.module.army.navy;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+import dev.starcore.starcore.module.army.navy.command.NavyCommand;
+import dev.starcore.starcore.module.army.navy.model.*;
+import dev.starcore.starcore.module.nation.NationService;
+import dev.starcore.starcore.module.nation.model.*;
+import java.util.*;
+import org.bukkit.*;
+import org.bukkit.command.Command;
+import org.bukkit.entity.Player;
+import org.junit.jupiter.api.*;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+
+class NavyCommandTest {
+  final NavyService navy = mock(NavyService.class);
+  final NationService nations = mock(NationService.class);
+  final Player player = mock(Player.class);
+  final World world = mock(World.class);
+  final UUID actor = UUID.randomUUID();
+  final Nation mine = new Nation(NationId.random(), "Mine", actor, "Owner");
+  final Nation enemy = new Nation(NationId.random(), "Enemy", UUID.randomUUID(), "Other");
+  final Command command = mock(Command.class);
+  final NavyCommand handler = new NavyCommand(navy, nations, (key, args) -> key);
+  NavyUnit foreign, own;
+
+  @BeforeEach
+  void setup() {
+    when(player.getUniqueId()).thenReturn(actor);
+    when(player.hasPermission("starcore.navy")).thenReturn(true);
+    when(player.hasPermission("starcore.navy.manage")).thenReturn(true);
+    when(player.getWorld()).thenReturn(world);
+    when(player.getLocation()).thenReturn(new Location(world, 0, 64, 0));
+    when(navy.isAvailable()).thenReturn(true);
+    when(nations.nationOf(actor)).thenReturn(Optional.of(mine));
+    when(nations.getNationByMember(actor)).thenReturn(Optional.of(mine));
+    own = NavyUnit.create(mine.id().value(), NavyType.GALLEY, 2, player.getLocation(), "Own");
+    foreign =
+        NavyUnit.create(enemy.id().value(), NavyType.GALLEY, 2, player.getLocation(), "Other");
+    when(navy.getFleet(own.id())).thenReturn(Optional.of(own));
+    when(navy.getFleet(foreign.id())).thenReturn(Optional.of(foreign));
+    when(navy.getNationNavies(mine.id().value())).thenReturn(List.of(own));
+  }
+
+  void run(String... args) {
+    handler.onCommand(player, command, "navy", args);
+  }
+
+  @ParameterizedTest
+  @ValueSource(
+      strings = {
+        "move",
+        "supply",
+        "disband",
+        "rename",
+        "embark",
+        "disembark",
+        "state",
+        "engage",
+        "m",
+        "s",
+        "d",
+        "rn",
+        "emb",
+        "dis",
+        "st",
+        "e"
+      })
+  void fullForeignUuidCannotReachAnyMutationOrAlias(String operation) {
+    run(operation, foreign.id().toString(), "1", "2");
+    verify(navy, never()).moveFleet(any(), any());
+    verify(navy, never()).resupplyFleet(any());
+    verify(navy, never()).disbandFleet(any());
+    verify(navy, never()).renameFleet(any(), any());
+    verify(navy, never()).embarkUnits(any(), anyInt());
+    verify(navy, never()).disembarkUnits(any(), anyInt());
+    verify(navy, never()).setFleetState(any(), any());
+    verify(navy, never()).engage(any(), any());
+  }
+
+  @Test
+  void leaderMayManageOwnFleetWithEitherIdentifier() {
+    run("rename", own.id().toString(), "New", "Fleet");
+    verify(navy).renameFleet(own.id(), "New Fleet");
+    run("supply", own.id().toString().substring(0, 8));
+    verify(navy).resupplyFleet(own.id());
+  }
+
+  @Test
+  void membershipAloneDoesNotAuthorizeTreasurySpending() {
+    Nation member = new Nation(mine.id(), "Mine", UUID.randomUUID(), "Another");
+    when(nations.nationOf(actor)).thenReturn(Optional.of(member));
+    run("create", "galley", "2", "Fleet");
+    run("supply", own.id().toString());
+    verify(navy, never()).createFleet(any(), any(), anyInt(), any(), any());
+    verify(navy, never()).resupplyFleet(any());
+  }
+
+  @Test
+  void administratorMayManageForeignFleetButStillNeedsOperationPermission() {
+    when(player.hasPermission("starcore.navy.admin")).thenReturn(true);
+    run("disband", foreign.id().toString());
+    verify(navy).disbandFleet(foreign.id());
+    clearInvocations(navy);
+    when(player.hasPermission("starcore.navy.manage")).thenReturn(false);
+    run("supply", foreign.id().toString());
+    verify(navy, never()).resupplyFleet(any());
+  }
+
+  @Test
+  void attackerMustBeOwnedButEnemyTargetMayUseCompleteUuid() {
+    run("engage", own.id().toString(), foreign.id().toString());
+    verify(navy).engage(own.id(), foreign.id());
+  }
+
+  @Test
+  void ambiguousShortIdDoesNotSelectFirstMatch() {
+    NavyUnit one = mock(NavyUnit.class), two = mock(NavyUnit.class);
+    when(one.id()).thenReturn(UUID.fromString("abcd0000-0000-0000-0000-000000000001"));
+    when(two.id()).thenReturn(UUID.fromString("abcd0000-0000-0000-0000-000000000002"));
+    when(navy.getNationNavies(mine.id().value())).thenReturn(List.of(one, two));
+    run("disband", "abcd");
+    verify(navy, never()).disbandFleet(any());
+  }
+
+  @Test
+  void disabledCommandAndDeniedBasePermissionCannotMutate() {
+    when(player.hasPermission("starcore.navy")).thenReturn(false);
+    run("disband", own.id().toString());
+    when(player.hasPermission("starcore.navy")).thenReturn(true);
+    handler.shutdown();
+    run("disband", own.id().toString());
+    verify(navy, never()).disbandFleet(any());
+    assertTrue(handler.onTabComplete(player, command, "navy", new String[] {""}).isEmpty());
+  }
+
+  @Test
+  void recoveryRequiresAdministratorPermission() {
+    run("recover");
+    verify(navy, never()).recoverPayments();
+    when(player.hasPermission("starcore.navy.admin")).thenReturn(true);
+    run("recover");
+    verify(navy).recoverPayments();
+  }
+
+  @Test
+  void creationSupportsDefaultAndMultiwordNames() {
+    var location = player.getLocation();
+    when(navy.createFleet(any(), any(), anyInt(), any(), any())).thenReturn(own);
+    run("create", "galley", "2");
+    verify(navy)
+        .createFleet(
+            eq(mine.id().value()), eq(NavyType.GALLEY), eq(2), eq(location), eq("galley Fleet"));
+    run("create", "galley", "2", "First", "Fleet");
+    verify(navy)
+        .createFleet(
+            eq(mine.id().value()), eq(NavyType.GALLEY), eq(2), eq(location), eq("First Fleet"));
+  }
+
+  @Test
+  void pendingRequestsAreOnlyVisibleToAdministrators() {
+    run("pending");
+    verify(navy, never()).pendingPayments();
+    when(player.hasPermission("starcore.navy.admin")).thenReturn(true);
+    when(navy.pendingPayments()).thenReturn(Map.of(UUID.randomUUID(), "CREATE"));
+    run("pending");
+    verify(navy).pendingPayments();
+    assertTrue(
+        handler.onTabComplete(player, command, "navy", new String[] {""}).contains("pending"));
+  }
+}
