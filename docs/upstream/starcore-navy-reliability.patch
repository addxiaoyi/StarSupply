--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/module/army/navy/NavyStore.java
@@ -0,0 +1,373 @@
+package dev.starcore.starcore.module.army.navy;
+
+import dev.starcore.starcore.core.persistence.AtomicFilePersistence;
+import dev.starcore.starcore.module.army.navy.model.NavyUnit;
+import dev.starcore.starcore.module.army.navy.storage.NavyStateCodec;
+import dev.starcore.starcore.module.nation.model.NationId;
+import dev.starcore.starcore.module.treasury.NationSpendingService;
+import java.io.*;
+import java.math.BigDecimal;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.*;
+import java.security.MessageDigest;
+import java.util.*;
+
+/** One durable authority for fleets, original payment quotes and battle admission. */
+final class NavyStore {
+  private static final int MAGIC = 0x4e415659, VERSION = 2;
+  private static final int MAX_BYTES = 64 * 1024 * 1024, MAX_ENTRIES = 100_000;
+  private static final Object[] GUARDS = new Object[64];
+
+  static {
+    Arrays.setAll(GUARDS, ignored -> new Object());
+  }
+
+  enum Kind {
+    CREATE,
+    SUPPLY
+  }
+
+  enum Status {
+    PREPARED,
+    APPLIED,
+    REJECTED
+  }
+
+  record Payment(
+      UUID id, Kind kind, String before, String after, BigDecimal amount, Status status) {
+    Payment {
+      Objects.requireNonNull(id);
+      Objects.requireNonNull(kind);
+      Objects.requireNonNull(after);
+      Objects.requireNonNull(status);
+      Objects.requireNonNull(amount);
+      amount = amount.setScale(2, java.math.RoundingMode.UNNECESSARY);
+      if (amount.signum() < 0
+          || (amount.signum() == 0 && (kind != Kind.SUPPLY || status != Status.APPLIED))
+          || (kind == Kind.CREATE) != (before == null))
+        throw new IllegalArgumentException("Invalid navy payment");
+    }
+
+    Payment withStatus(Status value) {
+      return new Payment(id, kind, before, after, amount, value);
+    }
+
+    NationSpendingService.SpendRequest request(NavyStateCodec codec) {
+      NavyUnit fleet = codec.decode(after);
+      return new NationSpendingService.SpendRequest(
+          "navy:" + id,
+          new NationId(fleet.nationId()),
+          amount,
+          NationSpendingService.SpendingCategory.MILITARY,
+          "navy:" + kind.name() + ":" + fleet.id());
+    }
+  }
+
+  record Snapshot(
+      Map<UUID, String> fleets, Map<UUID, Payment> payments, Map<String, Long> cooldowns) {
+    Snapshot {
+      fleets = Map.copyOf(fleets);
+      payments = Map.copyOf(payments);
+      cooldowns = Map.copyOf(cooldowns);
+    }
+
+    static Snapshot empty() {
+      return new Snapshot(Map.of(), Map.of(), Map.of());
+    }
+  }
+
+  @FunctionalInterface
+  interface Writer {
+    void write(Path path, byte[] bytes) throws IOException;
+  }
+
+  private final Path path;
+  private final NavyStateCodec codec;
+  private final Writer writer;
+  private byte[] expected;
+  private boolean loaded;
+  private volatile boolean failed;
+
+  NavyStore(Path path, NavyStateCodec codec) {
+    this(
+        path,
+        codec,
+        (target, bytes) -> AtomicFilePersistence.replace(target, temp -> Files.write(temp, bytes)));
+  }
+
+  NavyStore(Path path, NavyStateCodec codec, Writer writer) {
+    this.path = path;
+    this.codec = codec;
+    this.writer = writer;
+  }
+
+  synchronized Snapshot load() throws IOException {
+    if (loaded) throw new IOException("Navy store already loaded");
+    try {
+      Snapshot value;
+      if (!Files.exists(path)) {
+        if (Files.exists(AtomicFilePersistence.backup(path))
+            || Files.exists(AtomicFilePersistence.temp(path)))
+          throw new IOException("Missing navy authority; restore explicitly");
+        value = Snapshot.empty();
+      } else {
+        expected = bytes();
+        value = decode(expected);
+      }
+      loaded = true;
+      return value;
+    } catch (IOException | RuntimeException failure) {
+      failed = true;
+      throw new IOException("Cannot load navy authority", failure);
+    }
+  }
+
+  synchronized void save(Snapshot snapshot) throws IOException {
+    synchronized (
+        GUARDS[Math.floorMod(path.toAbsolutePath().normalize().hashCode(), GUARDS.length)]) {
+      if (!loaded || failed) throw new IOException("Navy storage unavailable");
+      byte[] next = encode(snapshot);
+      byte[] current;
+      try {
+        current = Files.exists(path) ? bytes() : null;
+      } catch (IOException failure) {
+        failed = true;
+        throw failure;
+      }
+      if (!Arrays.equals(current, expected)) {
+        failed = true;
+        throw new IOException("Navy authority changed outside the service");
+      }
+      if (Arrays.equals(current, next)) return;
+      try {
+        writer.write(path, next);
+        if (!Arrays.equals(bytes(), next)) throw new IOException("Navy snapshot not published");
+      } catch (IOException | RuntimeException failure) {
+        byte[] actual;
+        try {
+          actual = Files.exists(path) ? bytes() : null;
+        } catch (IOException readFailure) {
+          failed = true;
+          failure.addSuppressed(readFailure);
+          throw new IOException(failure);
+        }
+        if (Arrays.equals(actual, next)) {
+          expected = next;
+          return;
+        }
+        if (!Arrays.equals(actual, expected)) failed = true;
+        throw new IOException("Navy snapshot write failed", failure);
+      }
+      expected = next;
+    }
+  }
+
+  boolean failed() {
+    return failed;
+  }
+
+  private byte[] bytes() throws IOException {
+    if (!Files.isRegularFile(path) || Files.size(path) > MAX_BYTES)
+      throw new IOException("Invalid navy file");
+    try (var input = Files.newInputStream(path)) {
+      byte[] data = input.readNBytes(MAX_BYTES + 1);
+      if (data.length > MAX_BYTES) throw new IOException("Navy file too large");
+      return data;
+    }
+  }
+
+  private Snapshot decode(byte[] data) throws IOException {
+    if (data.length < 4 || new DataInputStream(new ByteArrayInputStream(data)).readInt() != MAGIC)
+      return legacy(data);
+    if (data.length < 52
+        || !MessageDigest.isEqual(
+            digest(Arrays.copyOf(data, data.length - 32)),
+            Arrays.copyOfRange(data, data.length - 32, data.length)))
+      throw new IOException("Navy checksum mismatch");
+    try (var in = new DataInputStream(new ByteArrayInputStream(data, 0, data.length - 32))) {
+      in.readInt();
+      if (in.readInt() != VERSION) throw new IOException("Unsupported navy version");
+      Map<UUID, String> fleets = new HashMap<>();
+      for (int n = count(in); n > 0; n--) {
+        UUID id = uuid(in.readUTF());
+        String value = string(in);
+        if (!id.equals(codec.decode(value).id()) || fleets.put(id, value) != null)
+          throw new IOException("Duplicate or mismatched navy");
+      }
+      Map<UUID, Payment> payments = new HashMap<>();
+      for (int n = count(in); n > 0; n--) {
+        UUID id = uuid(in.readUTF());
+        Kind kind = Kind.valueOf(in.readUTF());
+        String before = in.readBoolean() ? string(in) : null;
+        Payment p =
+            new Payment(
+                id,
+                kind,
+                before,
+                string(in),
+                new BigDecimal(in.readUTF()),
+                Status.valueOf(in.readUTF()));
+        if (payments.put(id, p) != null) throw new IOException("Duplicate navy payment");
+      }
+      Map<String, Long> cooldowns = new HashMap<>();
+      for (int n = count(in); n > 0; n--) {
+        String key = in.readUTF();
+        long until = in.readLong();
+        String[] ids = key.split("/", -1);
+        if (ids.length != 2
+            || !pair(uuid(ids[0]), uuid(ids[1])).equals(key)
+            || until < 0
+            || cooldowns.put(key, until) != null) throw new IOException("Invalid battle cooldown");
+      }
+      if (in.read() != -1) throw new IOException("Trailing navy data");
+      Snapshot result = new Snapshot(fleets, payments, cooldowns);
+      validate(result);
+      return result;
+    } catch (RuntimeException failure) {
+      throw new IOException("Invalid navy record", failure);
+    }
+  }
+
+  private Snapshot legacy(byte[] bytes) throws IOException {
+    Properties properties =
+        new Properties() {
+          @Override
+          public synchronized Object put(Object key, Object value) {
+            if (containsKey(key)) throw new IllegalArgumentException("Duplicate legacy navy");
+            return super.put(key, value);
+          }
+        };
+    try {
+      properties.load(new ByteArrayInputStream(bytes));
+      if (properties.isEmpty()
+          && !new String(bytes, StandardCharsets.ISO_8859_1).startsWith("#STARCORE navy state"))
+        throw new IOException("Empty or unrecognized legacy navy authority");
+      if (properties.size() > MAX_ENTRIES) throw new IOException("Too many fleets");
+      Map<UUID, String> fleets = new HashMap<>();
+      for (String key : properties.stringPropertyNames()) {
+        UUID id = uuid(key);
+        NavyUnit navy = codec.decode(properties.getProperty(key));
+        if (!id.equals(navy.id())) throw new IOException("Legacy navy key mismatch");
+        fleets.put(id, codec.encode(navy));
+      }
+      return new Snapshot(fleets, Map.of(), Map.of());
+    } catch (RuntimeException failure) {
+      throw new IOException("Invalid legacy navy authority", failure);
+    }
+  }
+
+  private void validate(Snapshot state) throws IOException {
+    long pending = 0;
+    for (Payment p : state.payments().values()) {
+      NavyUnit after = codec.decode(p.after());
+      if (!after.isAlive()) throw new IOException("Invalid navy payment candidate");
+      if (p.kind() == Kind.CREATE) {
+        if (after.health() != 100
+            || after.morale() != 100
+            || after.supply() != 100
+            || after.embarkedUnits() != 0
+            || after.supplyMinuteRemainder() != 0
+            || after.state() != dev.starcore.starcore.module.army.navy.model.NavyState.ANCHORED
+            || p.amount()
+                    .compareTo(
+                        BigDecimal.valueOf((long) after.type().costPerUnit() * after.ships()))
+                != 0) throw new IOException("Invalid navy creation quote");
+      } else {
+        NavyUnit before = codec.decode(p.before());
+        if (!before.isAlive()
+            || p.amount().compareTo(BigDecimal.valueOf((100L - before.supply()) * 15)) != 0)
+          throw new IOException("Invalid navy supply quote");
+        before.resupply(100 - before.supply());
+        before.restoreMaintenance(before.supplyMinuteRemainder(), after.lastUpdated());
+        if (!codec.encode(before).equals(p.after()))
+          throw new IOException("Navy supply changed unrelated state");
+      }
+      if (p.status() == Status.PREPARED) {
+        pending++;
+        if (!Objects.equals(state.fleets().get(after.id()), p.before()))
+          throw new IOException("Navy intent does not match authority");
+      }
+    }
+    if (pending > 1) throw new IOException("Multiple outstanding navy payments");
+  }
+
+  private byte[] encode(Snapshot state) throws IOException {
+    validate(state);
+    var bytes = new ByteArrayOutputStream();
+    try (var out = new DataOutputStream(bytes)) {
+      out.writeInt(MAGIC);
+      out.writeInt(VERSION);
+      out.writeInt(state.fleets().size());
+      for (UUID id : sorted(state.fleets().keySet())) {
+        out.writeUTF(id.toString());
+        string(out, state.fleets().get(id));
+      }
+      out.writeInt(state.payments().size());
+      for (UUID id : sorted(state.payments().keySet())) {
+        Payment p = state.payments().get(id);
+        if (!id.equals(p.id())) throw new IOException("Payment key mismatch");
+        out.writeUTF(id.toString());
+        out.writeUTF(p.kind().name());
+        out.writeBoolean(p.before() != null);
+        if (p.before() != null) string(out, p.before());
+        string(out, p.after());
+        out.writeUTF(p.amount().toPlainString());
+        out.writeUTF(p.status().name());
+      }
+      out.writeInt(state.cooldowns().size());
+      for (String key : sorted(state.cooldowns().keySet())) {
+        out.writeUTF(key);
+        out.writeLong(state.cooldowns().get(key));
+      }
+    }
+    bytes.write(digest(bytes.toByteArray()));
+    byte[] data = bytes.toByteArray();
+    if (data.length > MAX_BYTES) throw new IOException("Navy snapshot too large");
+    decode(data);
+    return data;
+  }
+
+  static String pair(UUID a, UUID b) {
+    if (a.equals(b)) throw new IllegalArgumentException("A fleet cannot fight itself");
+    return a.toString().compareTo(b.toString()) < 0 ? a + "/" + b : b + "/" + a;
+  }
+
+  private static <T> List<T> sorted(Collection<T> values) {
+    return values.stream().sorted(Comparator.comparing(Object::toString)).toList();
+  }
+
+  private static UUID uuid(String value) throws IOException {
+    UUID id = UUID.fromString(value);
+    if (!id.toString().equals(value)) throw new IOException("Non-canonical UUID");
+    return id;
+  }
+
+  private static int count(DataInputStream in) throws IOException {
+    int n = in.readInt();
+    if (n < 0 || n > MAX_ENTRIES) throw new IOException("Invalid navy entry count");
+    return n;
+  }
+
+  private static void string(DataOutputStream out, String value) throws IOException {
+    byte[] bytes = value.getBytes(StandardCharsets.UTF_8);
+    if (bytes.length > 65536) throw new IOException("Navy record too large");
+    out.writeInt(bytes.length);
+    out.write(bytes);
+  }
+
+  private static String string(DataInputStream in) throws IOException {
+    int size = in.readInt();
+    if (size < 0 || size > 65536) throw new IOException("Invalid navy record size");
+    byte[] bytes = in.readNBytes(size);
+    if (bytes.length != size) throw new EOFException();
+    return new String(bytes, StandardCharsets.UTF_8);
+  }
+
+  private static byte[] digest(byte[] data) throws IOException {
+    try {
+      return MessageDigest.getInstance("SHA-256").digest(data);
+    } catch (java.security.NoSuchAlgorithmException impossible) {
+      throw new IOException(impossible);
+    }
+  }
+}
