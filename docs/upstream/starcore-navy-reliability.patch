+package dev.starcore.starcore.module.treasury;
+
+import dev.starcore.starcore.core.persistence.PersistenceService;
+import java.util.Properties;
+import java.util.concurrent.atomic.AtomicInteger;
+
+/** Real TreasuryModule and file storage, with a controllable reply-loss boundary. */
+public final class NavyTreasuryFixture {
+  private NavyTreasuryFixture() {}
+
+  public static BudgetServiceImpl openBudget(
+      PersistenceService persistence, TreasuryModule treasury, java.time.Clock clock) {
+    return new BudgetServiceImpl(
+        new PersistenceBudgetStateStorage("navy-test-budget", persistence),
+        treasury,
+        treasury,
+        clock);
+  }
+
+  public static TreasuryModule open(PersistenceService persistence, AtomicInteger failureMode) {
+    try {
+      TreasuryStateStorage files =
+          new PersistenceTreasuryStateStorage("navy-test-treasury", persistence);
+      TreasuryStateStorage storage =
+          new TreasuryStateStorage() {
+            public Properties load() {
+              return files.load();
+            }
+
+            public void save(Properties properties) {
+              int mode = failureMode.getAndSet(0);
+              if (mode == 1) throw new IllegalStateException("treasury before replacement");
+              files.save(properties);
+              if (mode == 2) throw new IllegalStateException("treasury lost write reply");
+            }
+          };
+      TreasuryModule module = new TreasuryModule();
+      var field = TreasuryModule.class.getDeclaredField("stateStorage");
+      field.setAccessible(true);
+      field.set(module, storage);
+      var load = TreasuryModule.class.getDeclaredMethod("loadState");
+      load.setAccessible(true);
+      load.invoke(module);
+      return module;
+    } catch (ReflectiveOperationException failure) {
+      throw new IllegalStateException(failure);
+    }
+  }
+}
