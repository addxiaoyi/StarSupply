+package dev.starcore.starcore.module.army.navy;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+import dev.starcore.starcore.module.army.navy.model.*;
+import dev.starcore.starcore.module.army.navy.storage.NavyStateCodec;
+import java.nio.file.*;
+import java.time.Instant;
+import java.util.*;
+import org.bukkit.*;
+import org.junit.jupiter.api.*;
+import org.junit.jupiter.api.io.TempDir;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.EnumSource;
+
+class NavyModelStorageTest {
+  @TempDir Path directory;
+  final World world = mock(World.class);
+  final NavyStateCodec codec = new NavyStateCodec(name -> name.equals("world") ? world : null);
+
+  @BeforeEach
+  void setup() {
+    when(world.getName()).thenReturn("world");
+    when(world.getUID()).thenReturn(UUID.randomUUID());
+  }
+
+  NavyUnit fleet() {
+    return NavyUnit.create(
+        UUID.randomUUID(), NavyType.GALLEY, 5, new Location(world, 0, 64, 0), "Fleet");
+  }
+
+  @ParameterizedTest
+  @EnumSource(NavyState.class)
+  void eachHourlyRateAccumulatesAcrossSerialization(NavyState state) {
+    NavyUnit value = fleet();
+    value.setState(state);
+    for (int i = 0; i < 31; i++) value.consumeMaintenanceMinute();
+    value = codec.decode(codec.encode(value));
+    for (int i = 31; i < 60; i++) value.consumeMaintenanceMinute();
+    assertEquals(100 - state.supplyConsumptionPerHour(), value.supply());
+    assertEquals(0, value.supplyMinuteRemainder());
+  }
+
+  @Test
+  void consumptionDoesNotApplyHiddenMoralePenaltyAndEmptySupplyClearsRemainder() {
+    var value = fleet();
+    value.consumeMaintenanceMinute();
