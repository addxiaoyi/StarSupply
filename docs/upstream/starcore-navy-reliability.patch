+    loc.setX(200);
+    assertEquals(100, value.location().getX());
+    value.location().setX(500);
+    assertEquals(100, value.location().getX());
+  }
+
+  @Test
+  void invalidNumbersCannotWrapIntoShipsCargoSupplyOrHealth() {
+    var value = fleet();
+    assertThrows(IllegalArgumentException.class, () -> value.embarkUnits(-1));
+    assertThrows(IllegalArgumentException.class, () -> value.disembarkUnits(-1));
+    assertFalse(value.embarkUnits(Integer.MAX_VALUE));
+    assertThrows(IllegalArgumentException.class, () -> value.consumeSupply(-1));
+    assertThrows(IllegalArgumentException.class, () -> value.takeDamage(Double.NaN));
+    assertThrows(
+        IllegalArgumentException.class, () -> value.changeMorale(Double.POSITIVE_INFINITY));
+    assertThrows(IllegalArgumentException.class, () -> value.restoreMaintenance(60, Instant.now()));
+    value.resupply(Integer.MAX_VALUE);
+    assertEquals(100, value.supply());
