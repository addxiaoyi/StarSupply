+  @Test
+  void damagedFleetReportsActualShipLossesAndCannotRetainOvercapacityCargo() {
+    var value = fleet();
+    assertTrue(value.embarkUnits(value.transportCapacity()));
+    value.takeDamage(350);
+    assertEquals(1, value.ships());
+    assertEquals(50, value.embarkedUnits());
+    value.takeDamage(1000);
+    assertEquals(0, value.ships());
+    assertEquals(0, value.embarkedUnits());
+  }
+
+  @Test
+  void strongerAttackDamagesOpponentAndPredictionProbabilitiesSumToOne() {
+    var calculator = new NavyBattleCalculator();
+    var a = fleet();
+    var b = fleet();
+    int aShips = a.ships(), bShips = b.ships();
+    double aHealth = a.ships() * a.health() / 100 * a.type().baseHealth(),
+        bHealth = b.ships() * b.health() / 100 * b.type().baseHealth();
+    var forecast = calculator.predictBattle(a, b);
+    assertEquals(
+        1,
+        forecast.attackerWinChance() + forecast.defenderWinChance() + forecast.drawChance(),
+        1e-12);
+    assertEquals(aHealth, a.ships() * a.health() / 100 * a.type().baseHealth());
+    var result = calculator.calculateBattle(a, b);
+    assertEquals(
+        result.attackerDamage(),
+        bHealth - b.ships() * b.health() / 100 * b.type().baseHealth(),
+        1e-8);
+    assertEquals(
+        result.defenderDamage(),
+        aHealth - a.ships() * a.health() / 100 * a.type().baseHealth(),
+        1e-8);
+    assertEquals(aShips - a.ships(), result.attackerCasualties());
+    assertEquals(bShips - b.ships(), result.defenderCasualties());
+  }
