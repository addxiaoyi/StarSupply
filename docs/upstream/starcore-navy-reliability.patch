new file mode 100644
index 0000000..c125672
--- /dev/null
+++ b/src/test/java/dev/starcore/starcore/module/army/navy/NavyBattleListenerTest.java
@@ -0,0 +1,96 @@
+package dev.starcore.starcore.module.army.navy;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+import dev.starcore.starcore.module.army.navy.listener.NavyBattleListener;
+import dev.starcore.starcore.module.army.navy.model.*;
+import dev.starcore.starcore.module.nation.NationService;
+import dev.starcore.starcore.module.nation.model.*;
+import dev.starcore.starcore.performance.OptimizedMoveListener;
+import java.util.*;
+import org.bukkit.*;
+import org.bukkit.entity.Player;
+import org.junit.jupiter.api.*;
+
+class NavyBattleListenerTest {
+  final NavyService service = mock(NavyService.class);
+  final NationService nations = mock(NationService.class);
+  final Player player = mock(Player.class);
+  final World world = mock(World.class);
+  final Location location = new Location(world, 0, 64, 0);
+  final Nation nation = new Nation(NationId.random(), "Nation", UUID.randomUUID(), "Founder");
+  final OptimizedMoveListener dispatcher = mock(OptimizedMoveListener.class);
+  NavyBattleListener listener;
+  OptimizedMoveListener.BlockMoveSubscriber callback;
+  NavyUnit own, enemy, neutral;
+
+  @BeforeEach
+  void setup() {
+    when(service.isAvailable()).thenReturn(true);
+    when(player.getUniqueId()).thenReturn(nation.founderId());
+    when(nations.nationOf(player.getUniqueId())).thenReturn(Optional.of(nation));
+    own = NavyUnit.create(nation.id().value(), NavyType.GALLEY, 2, location, "Own");
+    enemy = NavyUnit.create(UUID.randomUUID(), NavyType.GALLEY, 2, location, "Enemy");
+    neutral = NavyUnit.create(UUID.randomUUID(), NavyType.GALLEY, 2, location, "Neutral");
+    when(service.enemies(enemy.nationId(), nation.id().value())).thenReturn(true);
+    when(service.getNaviesNear(location, 60)).thenReturn(List.of(neutral, own));
+    when(service.getNaviesNear(location, 100)).thenReturn(List.of(neutral, enemy, own));
+    when(service.engage(enemy.id(), own.id()))
+        .thenReturn(NavyBattleResult.create(enemy.id(), own.id(), 10, 10, 0, 0, true, true));
+    when(dispatcher.registerBlock(any()))
+        .thenAnswer(
+            call -> {
+              callback = call.getArgument(0);
+              return callback;
+            });
+    listener = new NavyBattleListener(service, nations, Optional.empty(), (key, args) -> key);
+    listener.subscribe(dispatcher);
+  }
+
+  @Test
+  void autoBattleUsesPlayerNationDefenderAndNeverUnrelatedNeutralFleet() {
+    callback.onBlockMove(player, location, location);
+    verify(service).engage(enemy.id(), own.id());
+    verify(service, never()).engage(enemy.id(), neutral.id());
+    verify(player).sendMessage(any(net.kyori.adventure.text.Component.class));
+  }
+
+  @Test
+  void ceasefireAndMissingNationNeverTriggerBattle() {
+    when(service.enemies(enemy.nationId(), nation.id().value())).thenReturn(false);
+    callback.onBlockMove(player, location, location);
+    verify(service, never()).engage(any(), any());
+    when(nations.nationOf(player.getUniqueId())).thenReturn(Optional.empty());
+    callback.onBlockMove(player, location, location);
+    verify(service, never()).engage(any(), any());
+  }
+
+  @Test
+  void oldCallbackIsSuppressedAfterUnsubscribeAndDuplicateSubscribeIsIdempotent() {
+    listener.subscribe(dispatcher);
+    verify(dispatcher, times(1)).registerBlock(any());
+    listener.unsubscribe(dispatcher);
+    callback.onBlockMove(player, location, location);
+    verify(dispatcher).unregister(callback);
+    verify(service, never()).engage(any(), any());
+  }
+
+  @Test
+  void expiredOrBlockedBattleDoesNotEmitSuccess() {
+    when(service.engage(enemy.id(), own.id())).thenThrow(new IllegalStateException("cooldown"));
+    callback.onBlockMove(player, location, location);
+    verify(player, never()).sendMessage(any(net.kyori.adventure.text.Component.class));
+  }
+
+  @Test
+  void oldSubscriptionCannotResumeAfterSubscribingAgain() {
+    var old = callback;
+    listener.unsubscribe(dispatcher);
+    listener.subscribe(dispatcher);
+    old.onBlockMove(player, location, location);
+    verify(service, never()).engage(any(), any());
+    callback.onBlockMove(player, location, location);
+    verify(service).engage(enemy.id(), own.id());
+  }
+}
