+  @Test
+  void legacyMigrationPreservesIdentityLocationAndUpdatedTime() throws Exception {
+    var value = fleet();
+    var props = new Properties();
+    String json = codec.encode(value);
+    var object = com.google.gson.JsonParser.parseString(json).getAsJsonObject();
+    object.remove("supplyMinuteRemainder");
+    props.setProperty(value.id().toString(), object.toString());
+    Path path = directory.resolve("navies.dat");
+    try (var out = Files.newOutputStream(path)) {
+      props.store(out, "legacy");
+    }
+    var store = new NavyStore(path, codec);
+    var state = store.load();
+    store.save(state);
+    var reopened = new NavyStore(path, codec).load();
+    var actual = codec.decode(reopened.fleets().get(value.id()));
+    assertEquals(value.lastUpdated().toEpochMilli(), actual.lastUpdated().toEpochMilli());
+    assertEquals(value.location(), actual.location());
+    assertEquals(0, actual.supplyMinuteRemainder());
+  }
