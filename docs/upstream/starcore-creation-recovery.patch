+  private Fixture fixture() {
+    var plugin = mock(JavaPlugin.class);
+    when(plugin.getDataFolder()).thenReturn(directory.toFile());
+    when(plugin.getLogger()).thenReturn(Logger.getLogger("CreationTest"));
+    var persistence = new PersistenceService(plugin, mock(StarCoreScheduler.class));
+    persistence.start();
+    var money = new InternalEconomyService(persistence);
+    money.start();
+    money.deposit(founder, new BigDecimal("1000"), true);
+    return new Fixture(persistence, money);
+  }
+
+  private final class Fixture {
+    final PersistenceService persistence;
+    final InternalEconomyService money;
+
+    Fixture(PersistenceService persistence, InternalEconomyService money) {
+      this.persistence = persistence;
+      this.money = money;
+    }
+
+    NationStateStorage storage() {
+      return new PersistenceNationStateStorage("nation", persistence);
+    }
+
+    NationCreationCoordinator coordinator() {
+      return new NationCreationCoordinator(storage(), money);
+    }
+
+    BigDecimal balance() {
+      return money.balance(founder);
+    }
+
+    NationStateCodec.Snapshot snapshot() {
+      return NationStateCodec.snapshot(storage().load());
+    }
+
+    void prepare(NationCreationOperation operation) {
+      var storage = storage();
+      var before = NationStateCodec.snapshot(storage.load());
+      storage.save(
+          NationStateCodec.toProperties(
+              before.nations(), Map.of(operation.request().operationId(), operation)));
+    }
+  }
+
+  private static final class FaultStorage implements NationStateStorage {
+    final NationStateStorage delegate;
+    int saves, failAt;
+    boolean after, failed, blockRead;
+
+    FaultStorage(NationStateStorage delegate) {
+      this.delegate = delegate;
+    }
+
+    public Properties load() {
+      if (failed && blockRead) throw new IllegalStateException("read unavailable");
+      return delegate.load();
+    }
+
+    public void save(Properties state) {
+      boolean fail = ++saves == failAt;
+      if (!fail || after) delegate.save(state);
+      if (fail) {
+        failed = true;
+        throw new IllegalStateException("snapshot reply lost");
+      }
+    }
+  }
+
+  private static final class ReplyLossMoney implements PlayerMoneyService {
+    final PlayerMoneyService delegate;
+    final Direction direction;
+    boolean lost, blockReads;
+
+    ReplyLossMoney(PlayerMoneyService delegate, Direction direction) {
+      this.delegate = delegate;
+      this.direction = direction;
+    }
+
+    public Receipt applyMoney(Request request) {
+      var result = delegate.applyMoney(request);
+      if (!lost && request.direction() == direction) {
+        lost = true;
+        throw new IllegalStateException("money response lost");
+      }
+      return result;
+    }
+
+    public Optional<Receipt> moneyReceipt(UUID id) {
+      if (lost && blockReads) throw new IllegalStateException("money read unavailable");
+      return delegate.moneyReceipt(id);
+    }
+  }
