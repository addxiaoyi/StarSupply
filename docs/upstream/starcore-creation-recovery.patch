@@ -0,0 +1,91 @@
+package dev.starcore.starcore.module.nation;
+
+import dev.starcore.starcore.foundation.economy.PlayerMoneyService;
+import dev.starcore.starcore.module.government.model.GovernmentType;
+import dev.starcore.starcore.module.nation.model.Nation;
+import dev.starcore.starcore.module.nation.model.NationId;
+import dev.starcore.starcore.module.nation.model.NationKind;
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.nio.charset.StandardCharsets;
+import java.time.Instant;
+import java.util.Objects;
+import java.util.UUID;
+
+record NationCreationOperation(
+    NationCreationService.Request request,
+    NationId nationId,
+    NationId parentNationId,
+    Instant foundedAt,
+    BigDecimal cost,
+    NationCreationService.State state,
+    int refundAttempt,
+    String detail) {
+  NationCreationOperation {
+    Objects.requireNonNull(request);
+    Objects.requireNonNull(nationId);
+    Objects.requireNonNull(foundedAt);
+    Objects.requireNonNull(state);
+    Objects.requireNonNull(detail);
+    cost = Objects.requireNonNull(cost).setScale(2, RoundingMode.UNNECESSARY);
+    if (cost.signum() < 0
+        || cost.compareTo(PlayerMoneyService.MAX_BALANCE) > 0
+        || refundAttempt < 0
+        || detail.length() > 512
+        || (request.kind() == NationKind.CITY_STATE) != (parentNationId != null))
+      throw new IllegalArgumentException("Invalid nation creation operation");
+  }
+
+  Nation candidate() {
+    Nation nation =
+        new Nation(
+            nationId,
+            request.name(),
+            request.founderId(),
+            request.founderName(),
+            request.kind(),
+            parentNationId,
+            foundedAt);
+    if (request.kind() == NationKind.CITY_STATE) nation.setGovernmentType(GovernmentType.REPUBLIC);
+    return nation;
+  }
+
+  NationCreationOperation state(NationCreationService.State next, String reason) {
+    return new NationCreationOperation(
+        request, nationId, parentNationId, foundedAt, cost, next, refundAttempt, reason);
+  }
+
+  NationCreationOperation retryRefund() {
+    return new NationCreationOperation(
+        request,
+        nationId,
+        parentNationId,
+        foundedAt,
+        cost,
+        NationCreationService.State.REFUND_PENDING,
+        Math.addExact(refundAttempt, 1),
+        detail);
+  }
+
+  NationCreationService.Receipt receipt() {
+    return new NationCreationService.Receipt(request, nationId, cost, state, detail);
+  }
+
+  PlayerMoneyService.Request debit() {
+    return money("debit", PlayerMoneyService.Direction.DEBIT);
+  }
+
+  PlayerMoneyService.Request refund() {
+    return money("refund/" + refundAttempt, PlayerMoneyService.Direction.CREDIT);
+  }
+
+  private PlayerMoneyService.Request money(String suffix, PlayerMoneyService.Direction direction) {
+    String source = "nation-creation/" + request.operationId() + "/" + suffix;
+    return new PlayerMoneyService.Request(
+        UUID.nameUUIDFromBytes(source.getBytes(StandardCharsets.UTF_8)),
+        request.founderId(),
+        direction,
+        cost,
+        source);
+  }
+}
diff --git a/src/main/java/dev/starcore/starcore/module/nation/NationCreationOperationCodec.java b/src/main/java/dev/starcore/starcore/module/nation/NationCreationOperationCodec.java
new file mode 100644
index 0000000..da00d1f
--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/module/nation/NationCreationOperationCodec.java
@@ -0,0 +1,76 @@
+package dev.starcore.starcore.module.nation;
+
+import dev.starcore.starcore.module.nation.model.NationId;
+import dev.starcore.starcore.module.nation.model.NationKind;
+import java.math.BigDecimal;
+import java.time.Instant;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.Properties;
+import java.util.UUID;
+
+final class NationCreationOperationCodec {
+  static final String PREFIX = "creationOperations.";
+
+  private NationCreationOperationCodec() {}
+
+  static void write(Properties p, Map<UUID, NationCreationOperation> operations) {
+    p.setProperty(PREFIX + "version", "1");
+    p.setProperty(PREFIX + "count", Integer.toString(operations.size()));
+    int i = 0;
+    for (var entry : operations.entrySet().stream().sorted(Map.Entry.comparingByKey()).toList()) {
+      var op = entry.getValue();
+      if (!entry.getKey().equals(op.request().operationId()))
+        throw new IllegalArgumentException("Creation operation key mismatch");
+      String key = PREFIX + i++ + ".";
+      p.setProperty(key + "id", op.request().operationId().toString());
+      p.setProperty(key + "founderId", op.request().founderId().toString());
+      p.setProperty(key + "founderName", op.request().founderName());
+      p.setProperty(key + "name", op.request().name());
+      p.setProperty(key + "kind", op.request().kind().name());
+      p.setProperty(key + "nationId", op.nationId().toString());
+      if (op.parentNationId() != null)
+        p.setProperty(key + "parentId", op.parentNationId().toString());
+      p.setProperty(key + "foundedAt", op.foundedAt().toString());
+      p.setProperty(key + "cost", op.cost().toPlainString());
+      p.setProperty(key + "state", op.state().name());
+      p.setProperty(key + "refundAttempt", Integer.toString(op.refundAttempt()));
+      p.setProperty(key + "detail", op.detail());
+    }
+  }
+
+  static Map<UUID, NationCreationOperation> read(Properties p) {
+    if (!"1".equals(p.getProperty(PREFIX + "version")))
+      throw new IllegalArgumentException("Invalid nation creation authority version");
+    int count = Integer.parseInt(p.getProperty(PREFIX + "count"));
+    if (count < 1 || count > 100_000) throw new IllegalArgumentException("Invalid creation count");
+    Map<UUID, NationCreationOperation> result = new LinkedHashMap<>();
+    for (int i = 0; i < count; i++) {
+      String key = PREFIX + i + ".";
+      var request =
+          new NationCreationService.Request(
+              UUID.fromString(p.getProperty(key + "id")),
+              UUID.fromString(p.getProperty(key + "founderId")),
+              p.getProperty(key + "founderName"),
+              p.getProperty(key + "name"),
+              NationKind.valueOf(p.getProperty(key + "kind")));
+      String parent = p.getProperty(key + "parentId");
+      var op =
+          new NationCreationOperation(
+              request,
+              NationId.of(UUID.fromString(p.getProperty(key + "nationId"))),
+              parent == null ? null : NationId.of(UUID.fromString(parent)),
+              Instant.parse(p.getProperty(key + "foundedAt")),
+              new BigDecimal(p.getProperty(key + "cost")),
+              NationCreationService.State.valueOf(p.getProperty(key + "state")),
+              Integer.parseInt(p.getProperty(key + "refundAttempt")),
+              p.getProperty(key + "detail"));
+      if (result.putIfAbsent(request.operationId(), op) != null)
+        throw new IllegalArgumentException("Duplicate nation creation operation");
+    }
+    if (result.values().stream().filter(op -> op.state().pending()).count() > 1
+        || result.values().stream().map(NationCreationOperation::nationId).distinct().count()
+            != count) throw new IllegalArgumentException("Inconsistent nation creation history");
+    return Map.copyOf(result);
+  }
+}
