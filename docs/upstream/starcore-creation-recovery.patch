index 0000000..81f15d9
--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/module/nation/NationCreationCoordinator.java
@@ -0,0 +1,185 @@
+package dev.starcore.starcore.module.nation;
+
+import static dev.starcore.starcore.module.nation.NationCreationService.State.*;
+
+import dev.starcore.starcore.foundation.economy.PlayerMoneyService;
+import dev.starcore.starcore.module.nation.model.Nation;
+import dev.starcore.starcore.module.nation.model.NationKind;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Objects;
+import java.util.UUID;
+import java.util.function.Function;
+
+/**
+ * All intent and catalog writes share the nation storage revision. Money is keyed independently.
+ */
+final class NationCreationCoordinator {
+  private final NationStateStorage storage;
+  private final PlayerMoneyService money;
+  private final java.util.function.Consumer<NationStateCodec.Snapshot> publish;
+  private NationStateCodec.Snapshot snapshot;
+
+  NationCreationCoordinator(NationStateStorage storage, PlayerMoneyService money) {
+    this(storage, money, ignored -> {});
+  }
+
+  NationCreationCoordinator(
+      NationStateStorage storage,
+      PlayerMoneyService money,
+      java.util.function.Consumer<NationStateCodec.Snapshot> publish) {
+    this.storage = Objects.requireNonNull(storage);
+    this.money = Objects.requireNonNull(money);
+    this.publish = Objects.requireNonNull(publish);
+    snapshot = NationStateCodec.snapshot(storage.load());
+    publish.accept(snapshot);
+  }
+
+  NationCreationService.Receipt create(
+      NationCreationService.Request request,
+      Function<List<Nation>, NationCreationOperation> admission) {
+    var existing = snapshot.creations().get(request.operationId());
+    if (existing != null) {
+      if (!existing.request().equals(request))
+        throw new IllegalArgumentException("Conflicting creation request");
+      return advance(existing);
+    }
+    if (snapshot.creations().values().stream().anyMatch(op -> op.state().pending()))
+      throw new IllegalStateException(
+          "Nation creation recovery pending; retry its original operation ID");
+    var operation = admission.apply(snapshot.nations());
+    if (!operation.request().equals(request) || operation.state() != PREPARED)
+      throw new IllegalArgumentException("Invalid creation admission");
+    persist(operation, snapshot.nations());
+    return advance(operation);
+  }
+
+  NationCreationService.Receipt recover(UUID id, boolean retryBlocked) {
+    var operation = required(id);
+    if (operation.state() == REFUND_BLOCKED && retryBlocked) {
+      operation = operation.retryRefund();
+      persist(operation, snapshot.nations());
+    }
+    return advance(operation);
+  }
+
+  NationCreationService.Receipt cancel(UUID id) {
+    var operation = required(id);
+    if (!operation.state().pending()) return operation.receipt();
+    if (operation.state() == PREPARED) {
+      operation = operation.state(REFUND_PENDING, "cancelled-by-administrator");
+      persist(operation, snapshot.nations());
+    }
+    return advance(operation);
+  }
+
+  private NationCreationOperation required(UUID id) {
+    var operation = snapshot.creations().get(Objects.requireNonNull(id));
+    if (operation == null)
+      throw new IllegalArgumentException("Unknown nation creation operation " + id);
+    return operation;
+  }
+
+  private NationCreationService.Receipt advance(NationCreationOperation operation) {
+    if (!operation.state().pending() || operation.state() == REFUND_BLOCKED)
+      return operation.receipt();
+    // Even cancellation seals the original debit ID, so a delayed creator cannot charge later.
+    var debit = operation.cost().signum() == 0 ? null : settle(operation.debit());
+    if (debit != null && debit.status() != PlayerMoneyService.Status.APPLIED) {
+      var rejected =
+          operation.state(
+              operation.state() == PREPARED ? REJECTED : CANCELLED,
+              "debit-" + debit.status().name());
+      persist(rejected, snapshot.nations());
+      return rejected.receipt();
+    }
+    if (operation.state() == PREPARED) {
+      String conflict = conflict(operation, snapshot.nations());
+      if (conflict == null) {
+        var nations = new ArrayList<>(snapshot.nations());
+        nations.add(operation.candidate());
+        var created = operation.state(CREATED, "created");
+        persist(created, nations);
+        return created.receipt();
+      }
+      operation = operation.state(REFUND_PENDING, conflict);
+      persist(operation, snapshot.nations());
+    }
+    var refund = operation.cost().signum() == 0 ? null : settle(operation.refund());
+    var settled =
+        refund == null || refund.status() == PlayerMoneyService.Status.APPLIED
+            ? operation.state(REFUNDED, operation.detail())
+            : operation.state(REFUND_BLOCKED, "refund-" + refund.status().name());
+    persist(settled, snapshot.nations());
+    return settled.receipt();
+  }
+
+  private PlayerMoneyService.Receipt settle(PlayerMoneyService.Request request) {
+    var receipt = money.moneyReceipt(request.operationId());
+    if (receipt.isEmpty()) {
+      try {
+        money.applyMoney(request);
+      } catch (RuntimeException failure) {
+        try {
+          receipt = money.moneyReceipt(request.operationId());
+        } catch (RuntimeException readFailure) {
+          failure.addSuppressed(readFailure);
+          throw failure;
+        }
+        if (receipt.isEmpty()) throw failure;
+      }
+      if (receipt.isEmpty()) receipt = money.moneyReceipt(request.operationId());
+    }
+    var proof =
+        receipt.orElseThrow(() -> new IllegalStateException("Creation money receipt unavailable"));
+    if (!proof.request().equals(request))
+      throw new IllegalStateException("Conflicting creation money receipt");
+    return proof;
+  }
+
+  private void persist(NationCreationOperation operation, List<Nation> nations) {
+    var operations = new HashMap<>(snapshot.creations());
+    operations.put(operation.request().operationId(), operation);
+    var candidate = NationStateCodec.toProperties(nations, operations);
+    try {
+      storage.save(candidate);
+    } catch (RuntimeException failure) {
+      try {
+        var actual = storage.load();
+        snapshot = NationStateCodec.snapshot(actual);
+        publish.accept(snapshot);
+        if (candidate.equals(actual)) return;
+      } catch (RuntimeException readFailure) {
+        failure.addSuppressed(readFailure);
+      }
+      throw failure;
+    }
+    snapshot = NationStateCodec.snapshot(candidate);
+    publish.accept(snapshot);
+  }
+
+  private static String conflict(NationCreationOperation operation, List<Nation> nations) {
+    var request = operation.request();
+    String name = request.name().trim().toLowerCase(Locale.ROOT);
+    if (nations.stream()
+        .anyMatch(
+            n ->
+                n.id().equals(operation.nationId())
+                    || n.name().trim().toLowerCase(Locale.ROOT).equals(name)))
+      return "identity-conflict";
+    if (request.kind() == NationKind.NATION) {
+      if (nations.stream()
+          .anyMatch(n -> n.kind() == NationKind.NATION && n.hasMember(request.founderId())))
+        return "founder-already-in-nation";
+    } else if (nations.stream()
+        .noneMatch(
+            n ->
+                n.id().equals(operation.parentNationId())
+                    && n.kind() == NationKind.NATION
+                    && n.founderId().equals(request.founderId())
+                    && n.hasMember(request.founderId()))) return "parent-nation-changed";
+    return null;
+  }
+}
