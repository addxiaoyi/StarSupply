+package dev.starcore.starcore.module.nation;
+
+import dev.starcore.starcore.module.nation.model.NationId;
+import dev.starcore.starcore.module.nation.model.NationKind;
+import java.math.BigDecimal;
+import java.util.List;
+import java.util.Objects;
+import java.util.Optional;
+import java.util.UUID;
+
+/** Durable nation creation. Callers authorize the founder and retain the original request ID. */
+public interface NationCreationService {
+  enum State {
+    PREPARED,
+    CREATED,
+    REJECTED,
+    REFUND_PENDING,
+    REFUND_BLOCKED,
+    REFUNDED,
+    CANCELLED;
+
+    public boolean pending() {
+      return this == PREPARED || this == REFUND_PENDING || this == REFUND_BLOCKED;
+    }
+  }
+
+  record Request(
+      UUID operationId, UUID founderId, String founderName, String name, NationKind kind) {
+    public Request {
+      Objects.requireNonNull(operationId);
+      Objects.requireNonNull(founderId);
+      Objects.requireNonNull(kind);
+      if (founderName == null
+          || founderName.isBlank()
+          || founderName.length() > 128
+          || name == null
+          || name.isBlank()
+          || name.length() > 128)
+        throw new IllegalArgumentException("Invalid nation creation name");
+    }
+  }
+
+  record Receipt(Request request, NationId nationId, BigDecimal cost, State state, String detail) {}
+
+  Receipt create(Request request);
+
+  Optional<Receipt> creation(UUID operationId);
+
+  List<Receipt> pendingCreations();
+
+  Receipt recoverCreation(UUID operationId);
+
+  /** Admin operation: durably decides cancellation before settling the original debit/refund. */
+  Receipt cancelCreation(UUID operationId);
+}
