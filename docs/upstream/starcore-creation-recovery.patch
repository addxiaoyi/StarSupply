+package dev.starcore.starcore.module.nation.command;
+
+import static org.mockito.Mockito.*;
+
+import dev.starcore.starcore.module.nation.NationCreationService;
+import dev.starcore.starcore.module.nation.NationService;
+import java.util.List;
+import java.util.UUID;
+import org.bukkit.command.CommandSender;
+import org.bukkit.plugin.Plugin;
+import org.junit.jupiter.api.Test;
+
+class NationCreationRecoveryCommandTest {
+  @Test
+  void permissionsProtectConsoleQueriesAndCancellation() {
+    var nations =
+        mock(NationService.class, withSettings().extraInterfaces(NationCreationService.class));
+    var service = (NationCreationService) nations;
+    var sender = mock(CommandSender.class);
+    var command = new NationLifecycleCommand(mock(Plugin.class), nations);
+    var id = UUID.randomUUID().toString();
+    command.onCommand(sender, null, "nation", new String[] {"recovery", "cancel", id, "confirm"});
+    verifyNoInteractions(nations);
+    when(sender.hasPermission("starcore.admin")).thenReturn(true);
+    command.onCommand(sender, null, "nation", new String[] {"recovery", "cancel", id});
+    verifyNoInteractions(nations);
+    when(service.pendingCreations()).thenReturn(List.of());
+    command.onCommand(sender, null, "nation", new String[] {"recovery", "list"});
+    verify(service).pendingCreations();
+    command.onCommand(sender, null, "nation", new String[] {"recovery", "retry", id});
+    verify(service).recoverCreation(UUID.fromString(id));
+    command.onCommand(sender, null, "nation", new String[] {"recovery", "cancel", id, "confirm"});
+    verify(service).cancelCreation(UUID.fromString(id));
+  }
+
+  @Test
+  void retiredCommandCannotRecoverOrForward() {
+    var nations =
+        mock(NationService.class, withSettings().extraInterfaces(NationCreationService.class));
+    var plugin = mock(Plugin.class);
+    var command = new NationLifecycleCommand(plugin, nations);
+    var sender = mock(CommandSender.class);
+    when(sender.hasPermission("starcore.admin")).thenReturn(true);
+    command.shutdown();
+    command.onCommand(sender, null, "nation", new String[] {"recovery", "list"});
+    command.onCommand(sender, null, "nation", new String[] {"create", "New"});
+    verifyNoInteractions(nations, plugin);
+  }
+}
