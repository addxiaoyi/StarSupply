+package dev.starcore.starcore.module.war;
+
+import dev.starcore.starcore.module.nation.model.NationId;
+import dev.starcore.starcore.war.WarGoal;
+import java.math.BigDecimal;
+import java.time.Instant;
+import java.util.*;
+
+/** Durable original declaration requests; exceptions never prove that the fee was not charged. */
+public interface WarDeclarationRecoveryService {
+  record Request(
+      UUID operationId, NationId actorId, NationId aggressor, NationId defender, WarGoal goal) {
+    public Request {
+      Objects.requireNonNull(operationId);
+      Objects.requireNonNull(actorId);
+      Objects.requireNonNull(aggressor);
+      Objects.requireNonNull(defender);
+      Objects.requireNonNull(goal);
+      if (!actorId.equals(aggressor) || aggressor.equals(defender))
+        throw new IllegalArgumentException("Only the aggressor may declare against another nation");
+    }
+  }
+
+  enum Status {
+    PENDING,
+    DECLARED,
+    REJECTED,
+    CANCELLED
+  }
+
+  record Receipt(
+      Request request, BigDecimal cost, Instant requestedAt, Status status, Instant declaredAt) {
+    public Receipt {
+      Objects.requireNonNull(request);
+      Objects.requireNonNull(cost);
+      Objects.requireNonNull(requestedAt);
+      Objects.requireNonNull(status);
+      cost = cost.setScale(2, java.math.RoundingMode.UNNECESSARY);
+      if (cost.signum() < 0
+          || cost.compareTo(new BigDecimal("1000000000000000")) > 0
+          || !requestedAt.isAfter(Instant.EPOCH)
+          || requestedAt.getNano() % 1_000_000 != 0
+          || (status == Status.DECLARED) != (declaredAt != null)
+          || declaredAt != null
+              && (!declaredAt.isAfter(Instant.EPOCH) || declaredAt.getNano() % 1_000_000 != 0))
+        throw new IllegalArgumentException("Invalid declaration receipt");
+    }
+
+    public UUID warId() {
+      return request.operationId();
+    }
+  }
+
+  Receipt declareWarWithReceipt(Request request);
+
+  Receipt recoverWarDeclaration(UUID operationId);
+
+  /** Seals an unpaid original ID; an already applied fee must finish the original declaration. */
+  Receipt cancelWarDeclaration(UUID operationId);
+
+  Optional<Receipt> warDeclaration(UUID operationId);
+
+  Collection<Receipt> pendingWarDeclarations();
+}
