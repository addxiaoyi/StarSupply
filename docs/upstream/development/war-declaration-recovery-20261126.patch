+  /** å‘å¸ƒäº‹ä»¶åˆ°äº‹ä»¶æ€»çº¿ */
+  private void publishEvent(Object event) {
+    if (!mutating) throw new IllegalStateException("Federation event outside mutation");
+    pendingEvents.add(event);
+  }
+
+  private <T> T mutate(java.util.function.Supplier<T> action) {
+    T result;
+    List<Object> events;
+    long token;
+    synchronized (this) {
+      if (stopped || !initialized || mutating || unavailable)
+        throw new IllegalStateException("Federation authority unavailable, stopped or reentrant");
+      mutating = true;
+      token = generation;
+      FederationState before = selection;
+      try {
+        apply(storage.loadSnapshot());
+        before = selection;
+        pendingInvites.entrySet().removeIf(e -> isInviteExpired(e.getValue()));
+        result = action.get();
+        if (stopped || token != generation)
+          throw new IllegalStateException("Federation stopped during mutation");
+        var removed = new HashSet<>(dissolved);
+        before.alliances().keySet().stream()
+            .filter(id -> !alliances.containsKey(id))
+            .forEach(removed::add);
+        var candidate =
+            new FederationState(
+                alliances,
+                allianceMembers,
+                nationAllianceMap,
+                pendingInvites,
+                allianceRelations,
+                announcements,
+                retired,
+                removed);
+        if (!candidate.equals(before)) storage.saveSnapshot(before, candidate);
+        apply(candidate);
+        events = List.copyOf(pendingEvents);
+        pendingEvents.clear();
+      } catch (RuntimeException | Error failure) {
+        try {
+          apply(storage.loadSnapshot());
+        } catch (RuntimeException | Error read) {
+          unavailable = true;
+          if (before != null) apply(before);
+          failure.addSuppressed(read);
+        }
+        pendingEvents.clear();
+        mutating = false;
+        throw failure;
+      }
+    }
+    // Event handlers may acquire the nation write lock. Never retain our monitor across them.
+    try {
+      if (eventBus != null)
+        for (Object event : events) {
+          synchronized (this) {
+            if (stopped || token != generation) break;
+          }
+          try {
+            eventBus.publish(event);
+          } catch (RuntimeException failure) {
+            LOGGER.warn("Federation committed but event delivery failed", failure);
+          }
+        }
+      return result;
+    } finally {
+      synchronized (this) {
+        mutating = false;
+      }
+    }
+  }
+
+  private void apply(FederationState s) {
+    selection = s;
+    alliances.clear();
+    alliances.putAll(s.alliances());
+    allianceMembers.clear();
+    s.members().forEach((id, group) -> allianceMembers.put(id, new ArrayList<>(group)));
+    nationAllianceMap.clear();
+    nationAllianceMap.putAll(s.membership());
+    pendingInvites.clear();
+    pendingInvites.putAll(s.invites());
+    allianceRelations.clear();
+    allianceRelations.putAll(s.relations());
+    announcements.clear();
+    announcements.putAll(s.announcements());
+    retired.clear();
+    retired.putAll(s.retired());
+    dissolved.clear();
+    dissolved.addAll(s.dissolved());
+    allianceNames.clear();
+    s.alliances().forEach((id, a) -> allianceNames.put(a.name().toLowerCase(Locale.ROOT), id));
+  }
