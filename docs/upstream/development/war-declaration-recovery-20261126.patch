+            || b == null
+            || !ReparationsStateCodec.encode(a).equals(ReparationsStateCodec.encode(b)))
+          throw new IllegalStateException("Nation disband admission fences reparations");
+      }
+    var ids = new HashSet<>(old.settlements().keySet());
+    ids.addAll(next.settlements().keySet());
