+package dev.starcore.starcore.module.treasury;
+
+import dev.starcore.starcore.module.nation.model.NationId;
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.time.Instant;
+import java.util.Objects;
+import java.util.Optional;
+import java.util.UUID;
+
+/** Original-request national debit with durable positive and negative decisions. */
+public interface NationDebitService {
+  enum Status {
+    APPLIED,
+    INSUFFICIENT_FUNDS,
+    RETIRED,
+    CANCELLED
+  }
+
+  record Request(UUID operationId, NationId nationId, BigDecimal amount, String purpose) {
+    public Request {
+      Objects.requireNonNull(operationId, "operationId");
+      Objects.requireNonNull(nationId, "nationId");
+      Objects.requireNonNull(amount, "amount");
+      Objects.requireNonNull(purpose, "purpose");
+      try {
+        amount = amount.setScale(2, RoundingMode.UNNECESSARY);
+      } catch (ArithmeticException error) {
+        throw new IllegalArgumentException("Debit amount requires exact cents", error);
+      }
+      if (amount.signum() <= 0
+          || amount.compareTo(new BigDecimal("1000000000000000.00")) > 0
+          || purpose.isBlank()
+          || purpose.length() > 4096)
+        throw new IllegalArgumentException("Invalid original debit request");
+    }
+  }
+
+  record Receipt(Request request, Status status, Instant decidedAt) {
+    public Receipt {
+      Objects.requireNonNull(request, "request");
+      Objects.requireNonNull(status, "status");
+      Objects.requireNonNull(decidedAt, "decidedAt");
+      decidedAt = Instant.ofEpochMilli(decidedAt.toEpochMilli());
+      if (!decidedAt.isAfter(Instant.EPOCH))
+        throw new IllegalArgumentException("Invalid debit decision time");
+    }
+  }
+
+  /** Every returned decision is committed and read back. Exceptions do not prove nonpayment. */
+  Receipt applyDebit(Request request);
+
+  Optional<Receipt> debitReceipt(UUID operationId);
+
+  /**
+   * Seals an undecided ID; an already committed decision, including APPLIED, is returned intact.
+   */
+  Receipt cancelDebit(Request request);
+}
