--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/module/nation/NationDisbandCoordinator.java
@@ -0,0 +1,154 @@
+package dev.starcore.starcore.module.nation;
+
+import dev.starcore.starcore.module.nation.model.Nation;
+import dev.starcore.starcore.module.war.WarDisbandAdmissionService;
+import java.util.*;
+import java.util.function.Consumer;
+import java.util.function.Function;
+
+/** Original cleanup requests survive directory deletion, restart and independent writers. */
+final class NationDisbandCoordinator {
+  private final NationStateStorage storage;
+  private final Consumer<NationDisbandTransaction> cleanup;
+  private final Consumer<NationStateCodec.Snapshot> publish;
+  private final Function<NationDisbandTransaction, WarDisbandAdmissionService.Receipt> admission;
+  private NationStateCodec.Snapshot snapshot;
+  private boolean unavailable;
+
+  NationDisbandCoordinator(
+      NationStateStorage storage,
+      Consumer<NationDisbandTransaction> cleanup,
+      Function<NationDisbandTransaction, WarDisbandAdmissionService.Receipt> admission) {
+    this(storage, cleanup, ignored -> {}, admission);
+  }
+
+  NationDisbandCoordinator(
+      NationStateStorage storage,
+      Consumer<NationDisbandTransaction> cleanup,
+      Consumer<NationStateCodec.Snapshot> publish,
+      Function<NationDisbandTransaction, WarDisbandAdmissionService.Receipt> admission) {
+    this(storage, cleanup, publish, null, admission);
+  }
+
+  NationDisbandCoordinator(
+      NationStateStorage storage,
+      Consumer<NationDisbandTransaction> cleanup,
+      Consumer<NationStateCodec.Snapshot> publish,
+      Properties selection,
+      Function<NationDisbandTransaction, WarDisbandAdmissionService.Receipt> admission) {
+    this.storage = Objects.requireNonNull(storage);
+    this.cleanup = Objects.requireNonNull(cleanup);
+    this.publish = Objects.requireNonNull(publish);
+    this.admission = Objects.requireNonNull(admission);
+    snapshot = NationStateCodec.snapshot(storage.load());
+    if (selection != null
+        && !selection.equals(
+            NationStateCodec.toProperties(
+                snapshot.nations(),
+                snapshot.creations(),
+                snapshot.claims(),
+                snapshot.splits(),
+                snapshot.disbands())))
+      throw new NationStateConflictException(
+          new IllegalStateException("Disband selection changed before commit"));
+    publish.accept(snapshot);
+  }
+
+  NationDisbandOperation disband(NationDisbandTransaction transaction) {
+    requireAvailable();
+    Objects.requireNonNull(transaction);
+    var existing = snapshot.disbands().get(transaction.transactionId());
+    if (existing != null) {
+      if (!existing.transaction().equals(transaction))
+        throw new IllegalArgumentException("Conflicting disband request");
+      return advance(existing);
+    }
+    if (NationDisbandOperationCodec.otherPending(snapshot)
+        || snapshot.disbands().values().stream().anyMatch(op -> op.state().pending()))
+      throw new IllegalStateException("Nation lifecycle recovery pending");
+    var ids = new HashSet<>(transaction.nationIds());
+    if (snapshot.nations().stream().filter(n -> ids.contains(n.id())).count() != ids.size())
+      throw new IllegalStateException("Original disband nations no longer exist");
+    var op =
+        new NationDisbandOperation(transaction, NationDisbandOperation.State.ADMISSION_PENDING);
+    op = persist(op, snapshot.nations());
+    return advance(op);
+  }
+
+  NationDisbandOperation recover(UUID id) {
+    requireAvailable();
+    var op = snapshot.disbands().get(Objects.requireNonNull(id));
+    if (op == null) throw new IllegalArgumentException("Unknown disband operation " + id);
+    return advance(op);
+  }
+
+  private NationDisbandOperation advance(NationDisbandOperation op) {
+    if (!op.state().pending()) return op;
+    if (op.state() == NationDisbandOperation.State.ADMISSION_PENDING) {
+      var receipt = admission.apply(op.transaction());
+      if (receipt == null
+          || !receipt.request().equals(NationDisbandOperation.request(op.transaction())))
+        throw new IllegalStateException("Conflicting disband admission receipt");
+      var ids = new HashSet<>(op.transaction().nationIds());
+      op =
+          persist(
+              new NationDisbandOperation(
+                  op.transaction(),
+                  receipt.accepted()
+                      ? NationDisbandOperation.State.CLEANUP_PENDING
+                      : NationDisbandOperation.State.REJECTED,
+                  receipt),
+              receipt.accepted()
+                  ? snapshot.nations().stream().filter(n -> !ids.contains(n.id())).toList()
+                  : snapshot.nations());
+      if (!op.state().pending()) return op;
+    } else if (op.admission() != null
+        && !op.admission().equals(admission.apply(op.transaction()))) {
+      throw new IllegalStateException("Conflicting durable disband admission receipt");
+    }
+    cleanup.accept(op.transaction());
+    return persist(op.completed(), snapshot.nations());
+  }
+
+  private NationDisbandOperation persist(NationDisbandOperation op, List<Nation> nations) {
+    var operations = new HashMap<>(snapshot.disbands());
+    operations.put(op.transaction().transactionId(), op);
+    var candidate =
+        NationStateCodec.toProperties(
+            nations, snapshot.creations(), snapshot.claims(), snapshot.splits(), operations);
+    NationDisbandOperationCodec.validateTransition(
+        NationStateCodec.toProperties(
+            snapshot.nations(),
+            snapshot.creations(),
+            snapshot.claims(),
+            snapshot.splits(),
+            snapshot.disbands()),
+        candidate);
+    try {
+      storage.save(candidate);
+    } catch (RuntimeException failure) {
+      try {
+        snapshot = NationStateCodec.snapshot(storage.load());
+        publish.accept(snapshot);
+        var actual = snapshot.disbands().get(op.transaction().transactionId());
+        if (actual != null
+            && actual.transaction().equals(op.transaction())
+            && (actual.equals(op)
+                || !actual.state().pending()
+                || op.state() == NationDisbandOperation.State.ADMISSION_PENDING)) return actual;
+      } catch (RuntimeException read) {
+        unavailable = true;
+        failure.addSuppressed(read);
+      }
+      throw failure;
+    }
+    snapshot = NationStateCodec.snapshot(candidate);
+    publish.accept(snapshot);
+    return op;
+  }
+
+  private void requireAvailable() {
+    if (unavailable)
+      throw new IllegalStateException("Disband authority unavailable; reload required");
+  }
+}
