+  public static Properties readLegacy(Path file) {
+    var properties =
+        new Properties() {
+          @Override
+          public synchronized Object put(Object key, Object value) {
+            if (containsKey(key))
+              throw new IllegalArgumentException("Duplicate legacy reparation property: " + key);
+            return super.put(key, value);
+          }
+        };
+    try {
+      if (Files.exists(file))
+        try (var input = Files.newInputStream(file)) {
+          properties.load(input);
+        }
+      else if (Files.exists(AtomicFilePersistence.backup(file))
+          || Files.exists(AtomicFilePersistence.temp(file)))
+        throw new IllegalStateException(
+            "Missing original reparation ledger; reconciliation required");
+    } catch (java.io.IOException error) {
+      throw new IllegalStateException("Unable to read legacy reparations", error);
+    }
+    return canonical(properties);
+  }
+
+  public static Properties canonical(Properties properties) {
+    Objects.requireNonNull(properties);
+    var snapshot = ReparationsSnapshotCodec.fromProperties(properties);
+    var expected = ReparationsSnapshotCodec.toProperties(snapshot);
+    // Old UUID-keyed ledgers and current counted ledgers are supported, never mixed.
+    if (properties.containsKey("reparation.count")) {
+      for (String key : properties.stringPropertyNames())
+        if (!expected.containsKey(key))
+          throw new IllegalArgumentException("Unknown reparation property: " + key);
+    } else {
+      for (String key : properties.stringPropertyNames()) {
+        if (key.startsWith("settlement.") || key.startsWith("archived.")) {
+          if (!expected.containsKey(key))
+            throw new IllegalArgumentException("Unknown reparation property: " + key);
+        } else if (!snapshot.reparations().containsKey(UUID.fromString(key)))
+          throw new IllegalArgumentException("Unknown legacy reparation property: " + key);
+      }
+    }
+    for (var debt : snapshot.reparations().values()) {
+      if (debt.payerId().equals(debt.receiverId())
+          || debt.totalAmount().signum() <= 0
+          || debt.paidAmount().signum() < 0
+          || debt.paidAmount().compareTo(debt.totalAmount()) > 0
+          || debt.totalAmount().stripTrailingZeros().scale() > 2
+          || debt.paidAmount().stripTrailingZeros().scale() > 2)
+        throw new IllegalArgumentException("Invalid reparation balance or parties");
+      if (debt.status() == WarReparation.ReparationStatus.COMPLETED
+          && debt.remainingAmount().signum() != 0)
+        throw new IllegalArgumentException("Unpaid completed reparation");
+    }
+    for (var payment : snapshot.settlements().values()) {
+      if (payment.state() == ReparationSettlementState.REFUNDED)
+        throw new IllegalArgumentException(
+            "Legacy refunded reparation requires independent cancellation evidence");
+      var debt = snapshot.reparations().get(payment.reparationId());
+      if (payment.updatedAt().isBefore(payment.createdAt())
+          || payment.amount().stripTrailingZeros().scale() > 2
+          || payment.expectedPaidAmount().stripTrailingZeros().scale() > 2
+          || payment.expectedPaidAmount().add(payment.amount()).compareTo(debt.totalAmount()) > 0)
