+    item.put("failureReason", module.failureReason());
+    item.put("dependencies", module.dependencies());
+    return item;
+  }
+
+  private static Map<String, Object> performance(PerformanceSnapshot snapshot) {
+    Map<String, Object> item = new LinkedHashMap<>();
+    item.put("timestamp", snapshot.timestamp().toString());
+    item.put("uptimeMillis", snapshot.uptime().toMillis());
