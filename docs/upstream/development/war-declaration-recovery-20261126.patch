+package dev.starcore.starcore.module.alliance;
+
+import static dev.starcore.starcore.module.alliance.AllianceService.*;
+
+import dev.starcore.starcore.module.alliance.AllianceServiceImpl.AlliancePairKey;
+import dev.starcore.starcore.module.nation.model.NationId;
+import java.time.Instant;
+import java.util.*;
+
+/** Canonical fields avoid delimiter ambiguity and reject unknown, partial or inconsistent data. */
+final class FederationCodec {
+  private FederationCodec() {}
+
+  static Properties encode(FederationState s) {
+    var p = new Properties();
+    p.setProperty("federation.version", "1");
+    s.alliances()
+        .forEach(
+            (id, a) -> {
+              String k = "alliance." + id + ".";
+              put(p, k, "name", a.name(), "leader", a.leaderId(), "created", a.createdAt());
+              optional(p, k + "emblem", a.emblem());
+            });
+    s.members()
+        .forEach(
+            (id, ms) ->
+                ms.forEach(
+                    m ->
+                        put(
+                            p,
+                            "member." + id + ":" + m.nationId() + ".",
+                            "role",
+                            m.role(),
+                            "joined",
+                            m.joinedAt())));
+    s.membership().forEach((id, a) -> p.setProperty("membership." + id, a.toString()));
+    s.invites()
+        .forEach(
+            (id, i) ->
+                put(
+                    p,
+                    "invite." + id + ".",
+                    "alliance",
+                    i.allianceId(),
+                    "name",
+                    i.allianceName(),
+                    "time",
+                    i.invitedAt(),
+                    "by",
+                    i.invitedBy(),
+                    "expires",
+                    i.expiresAt()));
+    s.relations()
+        .forEach(
+            (pair, r) -> {
+              String k = "relation." + pair.alliance1() + ":" + pair.alliance2() + ".";
+              put(p, k, "type", r.type(), "started", r.startedAt());
+              optional(p, k + "notes", r.notes());
+            });
+    s.announcements()
+        .forEach(
+            (id, a) ->
+                put(
+                    p,
+                    "announcement." + id + ".",
+                    "content",
+                    a.content(),
+                    "by",
+                    a.publishedBy(),
+                    "time",
+                    a.publishedAt()));
+    s.retired()
+        .forEach(
+            (id, r) -> {
+              String k = "retired." + id + ".";
+              put(
+                  p,
+                  k,
+                  "operation",
+                  r.operationId(),
+                  "dissolved",
+                  r.dissolvedAlliance(),
+                  "invites",
+                  r.clearedInvites(),
+                  "announcements",
+                  r.clearedAnnouncements());
+              optional(p, k + "alliance", r.formerAllianceId());
+              optional(p, k + "successor", r.successorId());
+            });
+    s.dissolved().forEach(id -> p.setProperty("dissolved." + id, "true"));
+    return p;
+  }
+
+  static FederationState decode(Properties p) {
+    Properties domain = new Properties();
+    domain.putAll(p);
+    for (var key : List.of("authority.version", "authority.sha256", "state.revision"))
+      domain.remove(key);
+    if (domain.isEmpty()) {
+      if (!"0".equals(p.getProperty("state.revision", "0")) || p.containsKey("authority.version"))
+        throw invalid("Missing federation snapshot");
+      return FederationState.empty();
+    }
+    if (!"1".equals(p.getProperty("federation.version")))
+      throw invalid("Invalid federation version");
+    Map<UUID, Alliance> alliances = new HashMap<>();
+    for (String id : rows(p, "alliance.")) {
+      UUID a = uuid(id);
+      String k = "alliance." + id + ".";
+      alliances.put(
+          a,
+          new Alliance(
+              a,
+              required(p, k + "name"),
+              nation(required(p, k + "leader")),
+              time(p, k + "created"),
+              p.getProperty(k + "emblem")));
+    }
+    Map<UUID, List<AllianceMember>> members = new HashMap<>();
+    for (String id : rows(p, "member.")) {
+      String[] pair = parts(id, ":", 2);
+      String k = "member." + id + ".";
+      members
+          .computeIfAbsent(uuid(pair[0]), ignored -> new ArrayList<>())
+          .add(
+              new AllianceMember(
+                  nation(pair[1]),
+                  AllianceMember.Role.valueOf(required(p, k + "role")),
+                  time(p, k + "joined")));
+    }
+    Map<NationId, UUID> membership = new HashMap<>();
+    for (String key : p.stringPropertyNames())
+      if (key.startsWith("membership."))
+        membership.put(nation(key.substring(11)), uuid(required(p, key)));
+    Map<NationId, AllianceInviteInfo> invites = new HashMap<>();
+    for (String id : rows(p, "invite.")) {
+      NationId n = nation(id);
+      String k = "invite." + id + ".";
+      invites.put(
+          n,
+          new AllianceInviteInfo(
+              uuid(required(p, k + "alliance")),
+              required(p, k + "name"),
+              n,
+              time(p, k + "time"),
+              nation(required(p, k + "by")),
+              time(p, k + "expires")));
+    }
+    Map<AlliancePairKey, AllianceRelation> relations = new HashMap<>();
+    for (String id : rows(p, "relation.")) {
+      String[] pair = parts(id, ":", 2);
+      UUID a = uuid(pair[0]), b = uuid(pair[1]);
+      String k = "relation." + id + ".";
+      var key = AlliancePairKey.of(a, b);
+      if (relations.putIfAbsent(
+              key,
+              new AllianceRelation(
+                  a,
+                  b,
+                  AllianceRelationType.valueOf(required(p, k + "type")),
+                  time(p, k + "started"),
+                  p.getProperty(k + "notes")))
+          != null) throw invalid("Duplicate federation relation");
+    }
+    Map<UUID, AllianceAnnouncement> announcements = new HashMap<>();
+    for (String id : rows(p, "announcement.")) {
+      UUID a = uuid(id);
+      String k = "announcement." + id + ".";
+      announcements.put(
+          a,
+          new AllianceAnnouncement(
+              a, required(p, k + "content"), nation(required(p, k + "by")), time(p, k + "time")));
+    }
+    Map<NationId, FederationRetirementService.Receipt> retired = new HashMap<>();
+    for (String id : rows(p, "retired.")) {
+      NationId n = nation(id);
+      String k = "retired." + id + ".";
+      var alliance = p.getProperty(k + "alliance");
+      var successor = p.getProperty(k + "successor");
+      retired.put(
+          n,
+          new FederationRetirementService.Receipt(
+              uuid(required(p, k + "operation")),
+              n,
+              alliance == null ? null : uuid(alliance),
+              successor == null ? null : nation(successor),
+              flag(p, k + "dissolved"),
+              Integer.parseInt(required(p, k + "invites")),
+              Integer.parseInt(required(p, k + "announcements"))));
+    }
+    Set<UUID> dissolved = new HashSet<>();
+    for (String key : p.stringPropertyNames())
+      if (key.startsWith("dissolved.")) {
+        if (!flag(p, key)) throw invalid("Invalid dissolved history");
+        dissolved.add(uuid(key.substring(10)));
+      }
+    var state =
+        new FederationState(
+            alliances, members, membership, invites, relations, announcements, retired, dissolved);
+    if (!encode(state).equals(domain)) throw invalid("Noncanonical or unknown federation fields");
+    return state;
+  }
+
+  static FederationState legacy(
+      Properties a,
+      Properties m,
+      Properties n,
+      Properties i,
+      Properties r,
+      Properties announcements) {
+    Map<UUID, Alliance> alliances = new HashMap<>();
+    Set<String> expected = new HashSet<>();
+    for (String id : rows(a, "")) {
+      UUID key = uuid(id);
+      String k = id + ".";
+      for (String field : List.of("name", "leader", "created", "emblem")) expected.add(k + field);
+      String emblem = required(a, k + "emblem");
+      alliances.put(
+          key,
+          new Alliance(
+              key,
+              required(a, k + "name"),
+              nation(required(a, k + "leader")),
+              millis(required(a, k + "created")),
+              emblem.isEmpty() ? null : emblem));
+    }
+    if (!expected.equals(a.stringPropertyNames()))
+      throw invalid("Unknown legacy federation fields");
+    Map<UUID, List<AllianceMember>> members = new HashMap<>();
+    for (String key : m.stringPropertyNames()) {
+      List<AllianceMember> group = new ArrayList<>();
+      String value = required(m, key);
+      if (!value.isEmpty())
+        for (String row : value.split(";", -1)) {
+          String[] fields = parts(row, ",", 3);
+          group.add(
+              new AllianceMember(
+                  nation(fields[0]), AllianceMember.Role.valueOf(fields[1]), millis(fields[2])));
+        }
+      members.put(uuid(key), group);
+    }
+    Map<NationId, UUID> membership = new HashMap<>();
+    for (String key : n.stringPropertyNames()) membership.put(nation(key), uuid(required(n, key)));
+    Map<NationId, AllianceInviteInfo> invites = new HashMap<>();
+    for (String key : i.stringPropertyNames()) {
+      String[] fields = required(i, key).split("\\|", -1);
+      int size = fields.length;
+      if (size < 5) throw invalid("Incomplete legacy federation invite");
+      var nation = nation(key);
+      invites.put(
+          nation,
+          new AllianceInviteInfo(
+              uuid(fields[0]),
+              String.join("|", Arrays.copyOfRange(fields, 1, size - 3)),
+              nation,
+              millis(fields[size - 3]),
+              nation(fields[size - 2]),
+              millis(fields[size - 1])));
+    }
+    Map<AlliancePairKey, AllianceRelation> relations = new HashMap<>();
+    for (String key : r.stringPropertyNames()) {
+      String[] pair = parts(key, ":", 2), fields = required(r, key).split("\\|", 3);
+      if (fields.length != 3) throw invalid("Incomplete legacy federation relation");
+      UUID left = uuid(pair[0]), right = uuid(pair[1]);
+      var pairKey = AlliancePairKey.of(left, right);
+      if (relations.putIfAbsent(
+              pairKey,
+              new AllianceRelation(
+                  left,
+                  right,
+                  AllianceRelationType.valueOf(fields[0]),
+                  millis(fields[1]),
+                  fields[2].isEmpty() ? null : fields[2]))
+          != null) throw invalid("Duplicate legacy federation relation");
+    }
+    Map<UUID, AllianceAnnouncement> notices = new HashMap<>();
+    for (String key : announcements.stringPropertyNames()) {
+      String[] fields = required(announcements, key).split("\\|", -1);
+      int size = fields.length;
+      if (size < 4 || !uuid(fields[size - 1]).equals(uuid(key)))
+        throw invalid("Invalid legacy federation announcement");
+      notices.put(
+          uuid(key),
+          new AllianceAnnouncement(
+              uuid(key),
+              String.join("|", Arrays.copyOfRange(fields, 0, size - 3)),
+              nation(fields[size - 3]),
+              millis(fields[size - 2])));
+    }
+    return new FederationState(
+        alliances, members, membership, invites, relations, notices, Map.of(), Set.of());
+  }
+
+  private static Set<String> rows(Properties p, String prefix) {
+    Set<String> rows = new TreeSet<>();
+    for (String key : p.stringPropertyNames())
+      if (key.startsWith(prefix)) {
+        String rest = key.substring(prefix.length());
+        int dot = rest.indexOf('.');
+        if (dot <= 0 || dot == rest.length() - 1) throw invalid("Malformed federation row");
+        rows.add(rest.substring(0, dot));
+      }
+    return rows;
+  }
+
+  private static void put(Properties p, String prefix, Object... fields) {
+    for (int j = 0; j < fields.length; j += 2)
+      p.setProperty(prefix + fields[j], Objects.requireNonNull(fields[j + 1]).toString());
+  }
+
+  private static void optional(Properties p, String key, Object value) {
+    if (value != null) p.setProperty(key, value.toString());
+  }
+
+  private static String required(Properties p, String key) {
+    return Objects.requireNonNull(p.getProperty(key), "Missing federation field " + key);
+  }
+
+  private static boolean flag(Properties p, String key) {
+    String v = required(p, key);
+    if (!v.equals("true") && !v.equals("false")) throw invalid("Invalid boolean");
+    return Boolean.parseBoolean(v);
+  }
+
+  private static UUID uuid(String value) {
+    UUID id = UUID.fromString(value);
+    if (!id.toString().equals(value)) throw invalid("Noncanonical UUID");
+    return id;
+  }
+
+  private static NationId nation(String value) {
+    return NationId.of(uuid(value));
+  }
+
+  private static Instant time(Properties p, String key) {
+    return Instant.parse(required(p, key));
+  }
+
+  private static Instant millis(String value) {
+    return Instant.ofEpochMilli(Long.parseLong(value));
+  }
+
+  private static String[] parts(String value, String delimiter, int count) {
+    String[] result = value.split(delimiter, -1);
+    if (result.length != count) throw invalid("Invalid federation field count");
+    return result;
+  }
+
+  private static IllegalArgumentException invalid(String reason) {
+    return new IllegalArgumentException(reason);
+  }
+}
