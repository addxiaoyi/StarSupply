@@ -0,0 +1,48 @@
+package dev.starcore.starcore.module.nation;
+
+import dev.starcore.starcore.module.war.WarDisbandAdmissionService;
+import java.util.Objects;
+
+/** The directory removal and original cleanup request share one durable commit. */
+record NationDisbandOperation(
+    NationDisbandTransaction transaction,
+    State state,
+    WarDisbandAdmissionService.Receipt admission) {
+  enum State {
+    ADMISSION_PENDING,
+    CLEANUP_PENDING,
+    COMPLETED,
+    REJECTED;
+
+    boolean pending() {
+      return this == ADMISSION_PENDING || this == CLEANUP_PENDING;
+    }
+
+    boolean directoryRemoved() {
+      return this == CLEANUP_PENDING || this == COMPLETED;
+    }
+  }
+
+  NationDisbandOperation(NationDisbandTransaction transaction, State state) {
+    this(transaction, state, null);
+  }
+
+  NationDisbandOperation {
+    Objects.requireNonNull(transaction);
+    Objects.requireNonNull(state);
+    if (admission != null && !admission.request().equals(request(transaction)))
+      throw new IllegalArgumentException("Disband admission request mismatch");
+    if (state == State.ADMISSION_PENDING && admission != null
+        || state == State.REJECTED && (admission == null || admission.accepted())
+        || state.directoryRemoved() && admission != null && !admission.accepted())
+      throw new IllegalArgumentException("Invalid disband admission state");
+  }
+
+  NationDisbandOperation completed() {
+    return new NationDisbandOperation(transaction, State.COMPLETED, admission);
+  }
+
+  static WarDisbandAdmissionService.Request request(NationDisbandTransaction tx) {
+    return new WarDisbandAdmissionService.Request(tx.transactionId(), tx.nationIds());
+  }
+}
diff --git a/src/main/java/dev/starcore/starcore/module/nation/NationDisbandOperationCodec.java b/src/main/java/dev/starcore/starcore/module/nation/NationDisbandOperationCodec.java
new file mode 100644
--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/module/nation/NationDisbandOperationCodec.java
@@ -0,0 +1,165 @@
+package dev.starcore.starcore.module.nation;
+
+import dev.starcore.starcore.module.nation.model.NationId;
+import dev.starcore.starcore.module.war.WarDisbandAdmissionService;
+import java.util.*;
+
+final class NationDisbandOperationCodec {
+  static final String PREFIX = "disbandOperations.";
+
+  private NationDisbandOperationCodec() {}
+
+  static void write(Properties properties, Map<UUID, NationDisbandOperation> operations) {
+    properties.setProperty(PREFIX + "version", "1");
+    properties.setProperty(PREFIX + "count", Integer.toString(operations.size()));
+    int index = 0;
+    for (var entry : operations.entrySet().stream().sorted(Map.Entry.comparingByKey()).toList()) {
+      var op = entry.getValue();
+      if (!entry.getKey().equals(op.transaction().transactionId()))
+        throw new IllegalArgumentException("Disband operation key mismatch");
+      String prefix = PREFIX + index++ + ".";
+      properties.setProperty(prefix + "state", op.state().name());
+      if (op.admission() != null)
+        properties.setProperty(prefix + "admission", op.admission().decision().name());
+      var request = PersistenceNationDisbandJournal.encode(op.transaction());
+      request
+          .stringPropertyNames()
+          .forEach(k -> properties.setProperty(prefix + "request." + k, request.getProperty(k)));
+    }
+  }
+
+  static Map<UUID, NationDisbandOperation> read(Properties properties) {
+    if (!"1".equals(properties.getProperty(PREFIX + "version")))
+      throw new IllegalArgumentException("Invalid disband operation version");
+    int count = Integer.parseInt(properties.getProperty(PREFIX + "count"));
+    if (count < 1 || count > 100_000 || count > properties.size())
+      throw new IllegalArgumentException("Invalid disband operation count");
+    Map<UUID, NationDisbandOperation> result = new LinkedHashMap<>();
+    for (int i = 0; i < count; i++) {
+      String prefix = PREFIX + i + ".";
+      Properties request = new Properties();
+      properties.stringPropertyNames().stream()
+          .filter(k -> k.startsWith(prefix + "request."))
+          .forEach(
+              k ->
+                  request.setProperty(
+                      k.substring((prefix + "request.").length()), properties.getProperty(k)));
+      var tx = PersistenceNationDisbandJournal.decode(request).orElseThrow();
+      var op =
+          new NationDisbandOperation(
+              tx,
+              NationDisbandOperation.State.valueOf(properties.getProperty(prefix + "state")),
+              properties.containsKey(prefix + "admission")
+                  ? new WarDisbandAdmissionService.Receipt(
+                      NationDisbandOperation.request(tx),
+                      WarDisbandAdmissionService.Decision.valueOf(
+                          properties.getProperty(prefix + "admission")))
+                  : null);
+      if (result.putIfAbsent(tx.transactionId(), op) != null)
+        throw new IllegalArgumentException("Duplicate disband operation");
+    }
+    return Map.copyOf(result);
+  }
+
+  static void validate(NationStateCodec.Snapshot snapshot) {
+    Set<NationId> retired = new HashSet<>();
+    for (var op : snapshot.disbands().values())
+      if (op.state().directoryRemoved())
+        for (var nation : op.transaction().nationIds())
+          if (!retired.add(nation))
+            throw new IllegalArgumentException("Nation has multiple disband operations");
+    if (snapshot.nations().stream()
+        .anyMatch(n -> retired.contains(n.id()) || retired.contains(n.parentNationId())))
+      throw new IllegalArgumentException("Disbanded nation or its dependent remains in directory");
+    for (var op : snapshot.disbands().values())
+      if (op.state() == NationDisbandOperation.State.ADMISSION_PENDING) {
+        var ids = new HashSet<>(op.transaction().nationIds());
+        if (snapshot.nations().stream().filter(n -> ids.contains(n.id())).count() != ids.size()
+            || snapshot.nations().stream()
+                .anyMatch(n -> ids.contains(n.parentNationId()) && !ids.contains(n.id())))
+          throw new IllegalArgumentException("Admission requires complete original nation cascade");
+      }
+    long pending = snapshot.disbands().values().stream().filter(op -> op.state().pending()).count();
+    if (pending > 1 || (pending > 0 && otherPending(snapshot)))
+      throw new IllegalArgumentException("Conflicting pending nation lifecycle operations");
+  }
+
+  static boolean otherPending(NationStateCodec.Snapshot snapshot) {
+    return snapshot.creations().values().stream().anyMatch(op -> op.state().pending())
+        || snapshot.claims().values().stream().anyMatch(op -> op.state().pending())
+        || snapshot.splits().values().stream().anyMatch(op -> op.state().pending());
+  }
+
+  /** Validate against the actual authority while its file guard or SQL transaction is held. */
+  static void validateTransition(Properties before, Properties after) {
+    var previous = NationStateCodec.snapshot(before);
+    var next = NationStateCodec.snapshot(after);
+    validate(next);
+    for (var entry : previous.disbands().entrySet()) {
+      var updated = next.disbands().get(entry.getKey());
+      if (updated == null
+          || !entry.getValue().transaction().equals(updated.transaction())
+          || entry.getValue().admission() != null
+              && !entry.getValue().admission().equals(updated.admission())
+          || (!entry.getValue().state().pending() && !entry.getValue().equals(updated)))
+        throw new IllegalStateException("Disband request and terminal history are immutable");
+      var old = entry.getValue().state();
+      var current = updated.state();
+      if (old == NationDisbandOperation.State.ADMISSION_PENDING
+              && current != old
+              && current != NationDisbandOperation.State.REJECTED
+              && current != NationDisbandOperation.State.CLEANUP_PENDING
+          || old == NationDisbandOperation.State.CLEANUP_PENDING
+              && current != old
+              && current != NationDisbandOperation.State.COMPLETED)
+        throw new IllegalStateException("Invalid disband state transition");
+      if (old == NationDisbandOperation.State.ADMISSION_PENDING
+          && current != old
+          && updated.admission() == null)
+        throw new IllegalStateException("Disband requires original admission receipt");
+    }
+    var added =
+        next.disbands().entrySet().stream()
+            .filter(e -> !previous.disbands().containsKey(e.getKey()))
+            .toList();
+    boolean pending = previous.disbands().values().stream().anyMatch(op -> op.state().pending());
+    if (added.size() > 1 || (!added.isEmpty() && (pending || otherPending(previous))))
+      throw new IllegalStateException("Nation lifecycle recovery pending");
+    if (!added.isEmpty()) {
+      var op = added.getFirst().getValue();
+      var ids = new HashSet<>(op.transaction().nationIds());
+      if (op.state() != NationDisbandOperation.State.ADMISSION_PENDING
+          || previous.nations().stream().filter(n -> ids.contains(n.id())).count() != ids.size())
+        throw new IllegalStateException(
+            "New disband requires original nations and pending admission");
+      var expected = withoutDisbands(previous);
+      if (!expected.equals(withoutDisbands(next)))
+        throw new IllegalStateException("Admission intent must preserve original nations");
+    } else if (pending) {
+      var active =
+          previous.disbands().values().stream()
+              .filter(op -> op.state().pending())
+              .findFirst()
+              .orElseThrow();
+      var updated = next.disbands().get(active.transaction().transactionId());
+      var expected = withoutDisbands(previous);
+      if (active.state() == NationDisbandOperation.State.ADMISSION_PENDING
+          && updated.state() == NationDisbandOperation.State.CLEANUP_PENDING) {
+        var ids = new HashSet<>(active.transaction().nationIds());
+        expected =
+            NationStateCodec.toProperties(
+                previous.nations().stream().filter(n -> !ids.contains(n.id())).toList(),
+                previous.creations(),
+                previous.claims(),
+                previous.splits());
+      }
+      if (!expected.equals(withoutDisbands(next)))
+        throw new IllegalStateException("Directory writes blocked until disband cleanup completes");
+    }
+  }
+
+  private static Properties withoutDisbands(NationStateCodec.Snapshot snapshot) {
+    return NationStateCodec.toProperties(
+        snapshot.nations(), snapshot.creations(), snapshot.claims(), snapshot.splits());
+  }
+}
