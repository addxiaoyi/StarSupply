@@ -0,0 +1,30 @@
+package dev.starcore.starcore.module.alliance;
+
+import dev.starcore.starcore.module.nation.model.NationId;
+import java.util.*;
+
+/** Permanent nation retirement within the multi-nation federation authority. */
+public interface FederationRetirementService {
+  record Receipt(
+      UUID operationId,
+      NationId nationId,
+      UUID formerAllianceId,
+      NationId successorId,
+      boolean dissolvedAlliance,
+      int clearedInvites,
+      int clearedAnnouncements) {
+    public Receipt {
+      Objects.requireNonNull(operationId);
+      Objects.requireNonNull(nationId);
+      if (clearedInvites < 0
+          || clearedAnnouncements < 0
+          || (formerAllianceId == null && (successorId != null || dissolvedAlliance))
+          || (successorId != null && (successorId.equals(nationId) || dissolvedAlliance)))
+        throw new IllegalArgumentException("Invalid federation retirement receipt");
+    }
+  }
+
+  Receipt retireNationFederation(UUID operationId, NationId nationId);
+
+  Optional<Receipt> federationRetirementReceipt(NationId nationId);
+}
diff --git a/src/main/java/dev/starcore/starcore/module/alliance/FederationState.java b/src/main/java/dev/starcore/starcore/module/alliance/FederationState.java
new file mode 100644
--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/module/alliance/FederationState.java
@@ -0,0 +1,240 @@
+package dev.starcore.starcore.module.alliance;
+
+import static dev.starcore.starcore.module.alliance.AllianceService.*;
+
+import dev.starcore.starcore.module.alliance.AllianceServiceImpl.AlliancePairKey;
+import dev.starcore.starcore.module.nation.model.NationId;
+import java.util.*;
+
+/** Immutable, complete federation selection; redundant membership indexes must agree. */
+record FederationState(
+    Map<UUID, Alliance> alliances,
+    Map<UUID, List<AllianceMember>> members,
+    Map<NationId, UUID> membership,
+    Map<NationId, AllianceInviteInfo> invites,
+    Map<AlliancePairKey, AllianceRelation> relations,
+    Map<UUID, AllianceAnnouncement> announcements,
+    Map<NationId, FederationRetirementService.Receipt> retired,
+    Set<UUID> dissolved) {
+  FederationState {
+    alliances = Map.copyOf(alliances);
+    Map<UUID, List<AllianceMember>> memberCopy = new HashMap<>();
+    members.forEach(
+        (id, values) ->
+            memberCopy.put(
+                id,
+                values.stream()
+                    .sorted(Comparator.comparing(m -> m.nationId().toString()))
+                    .toList()));
+    members = Map.copyOf(memberCopy);
+    membership = Map.copyOf(membership);
+    invites = Map.copyOf(invites);
+    Map<AlliancePairKey, AllianceRelation> relationCopy = new HashMap<>();
+    relations.forEach(
+        (pair, r) -> {
+          if (!pair.equals(AlliancePairKey.of(r.alliance1(), r.alliance2())))
+            throw invalid("relation key");
+          relationCopy.put(
+              pair,
+              new AllianceRelation(
+                  pair.alliance1(), pair.alliance2(), r.type(), r.startedAt(), r.notes()));
+        });
+    relations = Map.copyOf(relationCopy);
+    announcements = Map.copyOf(announcements);
+    retired = Map.copyOf(retired);
+    dissolved = Set.copyOf(dissolved);
+    for (var map :
+        List.of(alliances, members, membership, invites, relations, announcements, retired))
+      if (map.size() > 100_000) throw invalid("capacity");
+    if (dissolved.size() > 100_000) throw invalid("history capacity");
+    if (!alliances.keySet().equals(members.keySet())) throw invalid("member group keys");
+    Set<String> names = new HashSet<>();
+    Map<NationId, UUID> index = new HashMap<>();
+    for (var e : alliances.entrySet()) {
+      var a = e.getValue();
+      if (!e.getKey().equals(a.id())
+          || dissolved.contains(a.id())
+          || retired.containsKey(a.leaderId())) throw invalid("alliance identity");
+      text(a.name(), 3, 32);
+      if (!a.name().equals(a.name().trim()) || !names.add(a.name().toLowerCase(Locale.ROOT)))
+        throw invalid("alliance name");
+      Objects.requireNonNull(a.createdAt());
+      Objects.requireNonNull(a.leaderId());
+      if (a.emblem() != null) text(a.emblem(), 0, 8192);
+      var group = members.get(a.id());
+      if (group.isEmpty() || group.size() > 100_000) throw invalid("members");
+      int leaders = 0;
+      for (var m : group) {
+        Objects.requireNonNull(m.nationId());
+        Objects.requireNonNull(m.role());
+        Objects.requireNonNull(m.joinedAt());
+        if (retired.containsKey(m.nationId()) || index.putIfAbsent(m.nationId(), a.id()) != null)
+          throw invalid("member nation");
+        if (m.role() == AllianceMember.Role.LEADER) {
+          leaders++;
+          if (!m.nationId().equals(a.leaderId())) throw invalid("leader identity");
+        }
+      }
+      if (leaders != 1) throw invalid("leader count");
+    }
+    if (!index.equals(membership)) throw invalid("membership index");
+    for (var e : invites.entrySet()) {
+      var i = e.getValue();
+      if (!e.getKey().equals(i.invitedNationId())
+          || !alliances.containsKey(i.allianceId())
+          || membership.containsKey(i.invitedNationId())
+          || retired.containsKey(i.invitedNationId())
+          || retired.containsKey(i.invitedBy())) throw invalid("invite reference");
+      Objects.requireNonNull(i.invitedBy());
+      Objects.requireNonNull(i.invitedAt());
+      Objects.requireNonNull(i.expiresAt());
+      text(i.allianceName(), 3, 32);
+      if (i.expiresAt().isBefore(i.invitedAt())) throw invalid("invite time");
+    }
+    for (var r : relations.values()) {
+      if (r.alliance1().equals(r.alliance2())
+          || !alliances.containsKey(r.alliance1())
+          || !alliances.containsKey(r.alliance2())) throw invalid("relation endpoint");
+      Objects.requireNonNull(r.type());
+      Objects.requireNonNull(r.startedAt());
+      if (r.notes() != null) text(r.notes(), 0, 1_000_000);
+    }
+    for (var e : announcements.entrySet()) {
+      var a = e.getValue();
+      if (!e.getKey().equals(a.allianceId())
+          || !alliances.containsKey(a.allianceId())
+          || retired.containsKey(a.publishedBy())) throw invalid("announcement reference");
+      text(a.content(), 0, 1_000_000);
+      Objects.requireNonNull(a.publishedBy());
+      Objects.requireNonNull(a.publishedAt());
+    }
+    for (var e : retired.entrySet()) {
+      if (!e.getKey().equals(e.getValue().nationId())) throw invalid("retirement key");
+      if (e.getValue().dissolvedAlliance() && !dissolved.contains(e.getValue().formerAllianceId()))
+        throw invalid("missing dissolved history");
+    }
+  }
+
+  static FederationState empty() {
+    return new FederationState(
+        Map.of(), Map.of(), Map.of(), Map.of(), Map.of(), Map.of(), Map.of(), Set.of());
+  }
+
+  FederationState retire(UUID operation, NationId nation) {
+    Objects.requireNonNull(operation);
+    Objects.requireNonNull(nation);
+    var old = retired.get(nation);
+    if (old != null) {
+      if (!old.operationId().equals(operation))
+        throw new IllegalArgumentException("Conflicting federation retirement operation");
+      return this;
+    }
+    var nextAlliances = new HashMap<>(alliances);
+    var nextMembers = new HashMap<>(members);
+    var nextMembership = new HashMap<>(membership);
+    var nextInvites = new HashMap<>(invites);
+    var nextRelations = new HashMap<>(relations);
+    var nextAnnouncements = new HashMap<>(announcements);
+    var nextDissolved = new HashSet<>(dissolved);
+    nextInvites
+        .entrySet()
+        .removeIf(e -> e.getKey().equals(nation) || e.getValue().invitedBy().equals(nation));
+    nextAnnouncements.entrySet().removeIf(e -> e.getValue().publishedBy().equals(nation));
+    UUID allianceId = nextMembership.remove(nation);
+    NationId successor = null;
+    boolean removed = false;
+    if (allianceId != null) {
+      var group = new ArrayList<>(members.get(allianceId));
+      group.removeIf(m -> m.nationId().equals(nation));
+      var alliance = alliances.get(allianceId);
+      if (group.isEmpty()) {
+        removed = true;
+        nextDissolved.add(allianceId);
+        nextAlliances.remove(allianceId);
+        nextMembers.remove(allianceId);
+        nextInvites.entrySet().removeIf(e -> e.getValue().allianceId().equals(allianceId));
+        nextRelations.entrySet().removeIf(e -> e.getKey().involves(allianceId));
+        nextAnnouncements.remove(allianceId);
+      } else {
+        if (alliance.leaderId().equals(nation)) {
+          successor =
+              group.stream()
+                  .min(
+                      Comparator.<AllianceMember>comparingInt(
+                              m -> m.role() == AllianceMember.Role.OFFICER ? 0 : 1)
+                          .thenComparing(AllianceMember::joinedAt)
+                          .thenComparing(m -> m.nationId().toString()))
+                  .orElseThrow()
+                  .nationId();
+          NationId chosen = successor;
+          group.replaceAll(
+              m ->
+                  m.nationId().equals(chosen)
+                      ? new AllianceMember(chosen, AllianceMember.Role.LEADER, m.joinedAt())
+                      : m);
+          nextAlliances.put(
+              allianceId,
+              new Alliance(
+                  alliance.id(),
+                  alliance.name(),
+                  successor,
+                  alliance.createdAt(),
+                  alliance.emblem()));
+        }
+        nextMembers.put(allianceId, group);
+      }
+    }
+    var receipts = new HashMap<>(retired);
+    receipts.put(
+        nation,
+        new FederationRetirementService.Receipt(
+            operation,
+            nation,
+            allianceId,
+            successor,
+            removed,
+            invites.size() - nextInvites.size(),
+            announcements.size() - nextAnnouncements.size()));
+    return new FederationState(
+        nextAlliances,
+        nextMembers,
+        nextMembership,
+        nextInvites,
+        nextRelations,
+        nextAnnouncements,
+        receipts,
+        nextDissolved);
+  }
+
+  static void transition(FederationState before, FederationState after) {
+    for (var e : before.retired.entrySet())
+      if (!e.getValue().equals(after.retired.get(e.getKey())))
+        throw invalid("modified retirement history");
+    if (!after.dissolved.containsAll(before.dissolved)) throw invalid("removed dissolved history");
+    for (var id : before.alliances.keySet())
+      if (!after.alliances.containsKey(id) && !after.dissolved.contains(id))
+        throw invalid("missing disband history");
+  }
+
+  static void commitTransition(FederationState before, FederationState after) {
+    transition(before, after);
+    var added =
+        after.retired.entrySet().stream()
+            .filter(e -> !before.retired.containsKey(e.getKey()))
+            .toList();
+    if (added.size() > 1) throw invalid("multiple new retirement requests");
+    if (!added.isEmpty()) {
+      var r = added.getFirst().getValue();
+      if (!before.retire(r.operationId(), r.nationId()).equals(after))
+        throw invalid("retirement effects mismatch");
+    }
+  }
+
+  private static IllegalArgumentException invalid(String what) {
+    return new IllegalArgumentException("Invalid federation " + what);
+  }
+
+  static void text(String value, int min, int max) {
+    if (value == null || value.length() < min || value.length() > max) throw invalid("text length");
+  }
+}
