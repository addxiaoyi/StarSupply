+                    entry -> entry.getKey().name(),
+                    Map.Entry::getValue,
+                    (left, right) -> right,
+                    LinkedHashMap::new)));
+    item.put(
+        "oldestNextAttemptAt", summary.oldestNextAttemptAt().map(Instant::toString).orElse(null));
+    return item;
+  }
+
+  private static Map<String, Object> transactionSummary(TransactionSummary summary) {
+    Map<String, Object> item = new LinkedHashMap<>();
+    item.put("totalEntries", summary.totalEntries());
+    item.put("activeEntries", summary.activeEntries());
+    item.put("manualReviewEntries", summary.manualReviewEntries());
+    item.put("failedEntries", summary.failedEntries());
+    item.put(
+        "ownerCounts",
+        summary.ownerCounts().entrySet().stream()
+            .collect(
+                java.util.stream.Collectors.toMap(
+                    entry -> entry.getKey().name(),
+                    Map.Entry::getValue,
+                    (left, right) -> right,
+                    LinkedHashMap::new)));
+    item.put(
+        "typeCounts",
+        summary.typeCounts().entrySet().stream()
+            .collect(
+                java.util.stream.Collectors.toMap(
+                    entry -> entry.getKey().name(),
+                    Map.Entry::getValue,
+                    (left, right) -> right,
+                    LinkedHashMap::new)));
+    item.put("oldestUpdatedAt", summary.oldestUpdatedAt().map(Instant::toString).orElse(null));
+    return item;
