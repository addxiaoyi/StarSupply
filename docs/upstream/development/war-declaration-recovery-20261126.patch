+            .sorted(Map.Entry.comparingByKey())
+            .collect(
+                java.util.stream.Collectors.toMap(
+                    Map.Entry::getKey,
+                    entry -> cache(entry.getValue()),
+                    (left, right) -> right,
+                    LinkedHashMap::new)));
+    return item;
+  }
+
+  private static Map<String, Object> operation(OperationStats stats) {
+    Map<String, Object> item = new LinkedHashMap<>();
