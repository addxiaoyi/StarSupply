+package dev.starcore.starcore.module.war;
+
+import dev.starcore.starcore.module.nation.model.NationId;
+import java.util.*;
+
+/** The caller persists the original directory intent before reserving these nations. */
+public interface WarDisbandAdmissionService {
+  record Request(UUID operationId, List<NationId> nationIds) {
+    public Request {
+      Objects.requireNonNull(operationId);
+      nationIds = List.copyOf(nationIds);
+      if (nationIds.isEmpty() || new HashSet<>(nationIds).size() != nationIds.size())
+        throw new IllegalArgumentException("Invalid disband admission targets");
+      nationIds = nationIds.stream().sorted(Comparator.comparing(NationId::toString)).toList();
+    }
+  }
+
+  enum Decision {
+    ACCEPTED,
+    ACTIVE_WAR,
+    ACTIVE_REPARATION,
+    PENDING_EFFECT
+  }
+
+  record Receipt(Request request, Decision decision) {
+    public Receipt {
+      Objects.requireNonNull(request);
+      Objects.requireNonNull(decision);
+    }
+
+    public boolean accepted() {
+      return decision == Decision.ACCEPTED;
+    }
+  }
+
+  /**
+   * Immutable decision; acceptance permanently fences new effects and authorizes original
+   * retirement.
+   */
+  Receipt prepareDisband(Request request);
+
+  Optional<Receipt> disbandAdmission(UUID operationId);
+}
