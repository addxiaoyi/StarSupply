+    item.put("minNanos", stats.minDuration().toNanos());
+    item.put("maxNanos", stats.maxDuration().toNanos());
+    return item;
+  }
+
+  private static Map<String, Object> cache(CacheStats stats) {
+    Map<String, Object> item = new LinkedHashMap<>();
+    item.put("hits", stats.hits());
+    item.put("misses", stats.misses());
+    item.put("hitRate", stats.hitRate());
+    return item;
+  }
+
+  private static Map<String, Object> replayEvent(EvidenceReplayEvent event) {
