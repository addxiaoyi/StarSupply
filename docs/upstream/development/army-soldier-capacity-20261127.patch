+            || key.startsWith(WarRowVersion.PREFIX)
+            || WarSettlementState.metadata(key)
+            || key.startsWith(WarAuthority.ARCHIVED_FIELD)
+            || key.startsWith(WarAuthority.RETIRED)
+            || key.startsWith(WarAuthority.DELETED))
