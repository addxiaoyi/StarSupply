+
+  @ParameterizedTest
+  @ValueSource(
+      strings = {
+        "armyId",
+        "incarnation",
+        "generation",
+        "nation",
+        "type",
+        "position",
+        "supply",
+        "remainder",
+        "created",
+        "state",
+        "lastUpdated"
