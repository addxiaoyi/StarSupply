+    assertEquals(100, request.attackerBefore().soldiers());
+    assertEquals(80, request.defenderBefore().soldiers());
+    assertEquals(80, resolution.attackerAfter().morale());
+    assertFalse(resolution.defenderAfter().isAlive());
+  }
+
+  @ParameterizedTest
