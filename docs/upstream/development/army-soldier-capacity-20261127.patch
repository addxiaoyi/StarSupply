+
+  @ParameterizedTest
+  @ValueSource(strings = {"\ud800", "\udc00", "x\ud800", "\ud800x", "\udc00\ud800"})
+  void malformedSurrogatesAreRejectedBeforeAnyDebitRequestExists(String worldName) {
