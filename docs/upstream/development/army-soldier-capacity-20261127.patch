@@ -0,0 +1,246 @@
+package dev.starcore.starcore.war;
+
+import dev.starcore.starcore.module.diplomacy.DiplomacyTreatyOperationService.OperationView;
+import dev.starcore.starcore.module.diplomacy.DiplomacyTreatyOperationService.Plan;
+import dev.starcore.starcore.module.diplomacy.DiplomacyTreatyOperationService.ReserveRequest;
+import dev.starcore.starcore.module.war.WarSettlementAdmissionService.EndReceipt;
