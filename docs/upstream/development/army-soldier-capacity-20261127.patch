+    var proof = owner.useSkill(scout);
+    assertTrue(proof.effects().isEmpty());
+    assertEquals(before.armies(), owner.snapshot().armies());
+    assertEquals(before.tombstones(), owner.snapshot().tombstones());
+    assertEquals(before.paidOperations(), owner.snapshot().paidOperations());
+    assertEquals(before.battleSessions(), owner.snapshot().battleSessions());
+    assertEquals(before.revision() + 1, owner.snapshot().revision());
+    assertEquals(proof, reopen(sqlite).skillUse(scoutId).orElseThrow());
+  }
+
+  @ParameterizedTest(name = "sqlite={0}")
+  @ValueSource(booleans = {false, true})
+  void compareAndSwapConflictRequiresRefreshAndThenARequestFromTheWinningHead(boolean sqlite)
+      throws Exception {
+    var winner = initialize(sqlite);
+    var stale = reopen(sqlite);
+    var staleRequest = request(stale, SECOND_OPERATION, ACTOR, SkillType.INSPIRE, null, ACCEPTED);
+    var proof =
+        winner.useSkill(request(winner, OPERATION, ACTOR, SkillType.INSPIRE, null, ACCEPTED));
+    var committed = winner.snapshot();
+
+    assertThrows(RuntimeException.class, () -> stale.useSkill(staleRequest));
+    assertFalse(stale.isReady());
+    assertThrows(IllegalStateException.class, () -> stale.skillUse(SECOND_OPERATION));
+    assertEquals(committed, storage(sqlite).load());
+    assertEquals(committed, stale.refresh());
+    assertEquals(proof, stale.latestSkillUse(ACTOR, SkillType.INSPIRE).orElseThrow());
+    assertThrows(IllegalArgumentException.class, () -> stale.useSkill(staleRequest));
+    assertTrue(stale.isReady());
+    var retried =
+        stale.useSkill(
+            request(stale, SECOND_OPERATION, ACTOR, SkillType.INSPIRE, OPERATION, proof.readyAt()));
+    assertEquals(committed.revision() + 1, stale.snapshot().revision());
+    assertEquals(retried, reopen(sqlite).latestSkillUse(ACTOR, SkillType.INSPIRE).orElseThrow());
+  }
+
+  @ParameterizedTest(name = "sqlite={0}")
+  @ValueSource(booleans = {false, true})
+  void realCommitWithLostAcknowledgementRecoversTheProofWithoutApplyingEffectsTwice(boolean sqlite)
+      throws Exception {
+    initialize(sqlite).close();
+    var delegate = storage(sqlite);
+    var wrapped = mock(ArmyAuthorityStorage.class, delegatesTo(delegate));
+    var failOnce = new AtomicBoolean(true);
+    var commits = new AtomicInteger();
+    doAnswer(
+            invocation -> {
+              ArmyAuthoritySnapshot expected = invocation.getArgument(0);
+              ArmyAuthoritySnapshot draft = invocation.getArgument(1);
+              var result = delegate.commit(expected, draft);
+              commits.incrementAndGet();
+              if (failOnce.getAndSet(false)) {
+                throw new IllegalStateException("Lost skill commit acknowledgement");
+              }
+              return result;
+            })
+        .when(wrapped)
+        .commit(any(), any());
+    var owner = new ArmyAuthorityOwner(wrapped);
+    owner.refresh();
+    var request = request(owner, OPERATION, ACTOR, SkillType.INSPIRE, null, ACCEPTED);
+    var proof = ArmySkillUse.completed(request);
+    var before = owner.snapshot();
+
+    assertThrows(IllegalStateException.class, () -> owner.useSkill(request));
+    assertEquals(1, commits.get());
+    assertFalse(owner.isReady());
+    assertThrows(IllegalStateException.class, owner::snapshot);
+    var durable = storage(sqlite).load();
+    assertEquals(before.revision() + 1, durable.revision());
+    assertEquals(proof, durable.skillUses().get(OPERATION));
+    assertEquals(proof.effects().get(ARMY), durable.armies().get(ARMY));
+    assertEquals(durable, owner.refresh());
+    assertEquals(proof, owner.useSkill(request));
+    assertEquals(1, commits.get());
+    assertEquals(durable, owner.snapshot());
+    assertEquals(proof, reopen(sqlite).useSkill(request));
+  }
+
+  @ParameterizedTest(name = "sqlite={0}")
+  @ValueSource(booleans = {false, true})
+  void defeatedSkillTargetHasTheExactPermanentTombstoneAndCannotResurrect(boolean sqlite)
+      throws Exception {
+    var owner = initialize(sqlite);
+    var enemy = owner.army(ENEMY).orElseThrow();
+    owner.replace(enemy.token(), withHealth(enemy, 1));
+    var request = request(owner, OPERATION, ACTOR, SkillType.CAVALRY_CHARGE, null, ACCEPTED);
+    var proof = owner.useSkill(request);
+    var effect = proof.effects().get(ENEMY);
+    assertFalse(effect.isAlive());
+    assertTrue(owner.army(ENEMY).isEmpty());
+    var expected =
+        new ArmyTombstone(
+            effect.token(),
+            effect.nationId(),
+            effect.type(),
+            effect.createdAt(),
+            effect.lastUpdated(),
+            "skill-defeated",
+            OPERATION);
+    assertEquals(expected, owner.snapshot().tombstones().get(ENEMY));
+    var committed = owner.snapshot();
+    assertEquals(proof, owner.useSkill(request));
+    assertEquals(committed, owner.snapshot());
+    assertThrows(IllegalArgumentException.class, () -> owner.create(army(ENEMY, OTHER_NATION)));
+    assertThrows(IllegalStateException.class, () -> owner.replace(effect.token(), effect));
+    assertEquals(expected, reopen(sqlite).snapshot().tombstones().get(ENEMY));
+    assertEquals(proof, reopen(sqlite).useSkill(request));
+    assertEquals(committed, storage(sqlite).load());
+  }
+
+  @ParameterizedTest(name = "sqlite={0}")
+  @ValueSource(booleans = {false, true})
+  void allOrdinaryPaidAndBattleDraftsPreserveTheSchemaFourSkillLedger(boolean sqlite)
+      throws Exception {
+    var owner = initialize(sqlite);
+    var proof = owner.useSkill(request(owner, OPERATION, ACTOR, SkillType.INSPIRE, null, ACCEPTED));
+    owner.create(army(THIRD, NATION));
+    var current = owner.army(ARMY).orElseThrow();
+    owner.replace(current.token(), current);
+    current = owner.army(ARMY).orElseThrow();
+    owner.applyLogisticsSupply(new UUID(8, 1), NATION, current.token(), 5, ACCEPTED.plusSeconds(1));
+    owner.startBattle(
+        new ArmyBattleRequest(
+            SECOND_OPERATION,
+            ACTOR,
+            owner.army(ARMY).orElseThrow(),
+            owner.army(ENEMY).orElseThrow(),
+            ACCEPTED.plusSeconds(2)));
+    owner.cancelBattle(SECOND_OPERATION, ACCEPTED.plusSeconds(3));
+    var paid =
+        owner.preparePaid(
+            resupply(owner.army(ARMY).orElseThrow(), THIRD_OPERATION, ACCEPTED.plusSeconds(4)));
+    owner.cancelPaid(THIRD_OPERATION);
+    owner.confirmPaid(
+        THIRD_OPERATION,
+        new NationDebitService.Receipt(
+            paid.request().debitRequest(),
+            NationDebitService.Status.CANCELLED,
+            Instant.ofEpochMilli(ACCEPTED.plusSeconds(5).toEpochMilli())));
+
+    assertEquals(4, owner.snapshot().version());
+    assertEquals(Map.of(OPERATION, proof), owner.snapshot().skillUses());
+    assertEquals(proof, owner.useSkill(proof.request()));
+    assertEquals(owner.snapshot(), storage(sqlite).load());
+    assertEquals(owner.snapshot(), reopen(sqlite).snapshot());
+  }
+
+  @ParameterizedTest(name = "sqlite={0}")
+  @ValueSource(booleans = {false, true})
+  void skillApisRequireAReadyOwnerAndRemainClosedAfterShutdown(boolean sqlite) throws Exception {
+    var initialized = initialize(sqlite);
+    var request = request(initialized, OPERATION, ACTOR, SkillType.INSPIRE, null, ACCEPTED);
+    var fresh = new ArmyAuthorityOwner(storage(sqlite));
+    assertThrows(IllegalStateException.class, () -> fresh.skillUse(OPERATION));
+    assertThrows(IllegalStateException.class, () -> fresh.latestSkillUse(ACTOR, SkillType.INSPIRE));
+    assertThrows(IllegalStateException.class, () -> fresh.useSkill(request));
+    fresh.refresh();
+    assertTrue(fresh.skillUse(OPERATION).isEmpty());
+    assertThrows(NullPointerException.class, () -> fresh.skillUse(null));
+    assertThrows(NullPointerException.class, () -> fresh.latestSkillUse(null, SkillType.INSPIRE));
+    assertThrows(NullPointerException.class, () -> fresh.latestSkillUse(ACTOR, null));
+    assertThrows(NullPointerException.class, () -> fresh.useSkill(null));
+    fresh.close();
+    assertThrows(IllegalStateException.class, () -> fresh.skillUse(OPERATION));
+    assertThrows(IllegalStateException.class, () -> fresh.latestSkillUse(ACTOR, SkillType.INSPIRE));
+    assertThrows(IllegalStateException.class, () -> fresh.useSkill(request));
+    assertThrows(IllegalStateException.class, fresh::refresh);
+  }
+
+  private ArmyAuthorityOwner initialize(boolean sqlite) throws Exception {
+    var storage = storage(sqlite);
+    storage.load();
+    storage.initializeFromLegacy(ArmyLegacyImporter.inspect(new byte[0], "skill-owner-test"));
+    var owner = new ArmyAuthorityOwner(storage);
+    owner.refresh();
+    owner.create(army(ARMY, NATION));
+    owner.create(army(ENEMY, OTHER_NATION));
+    return owner;
+  }
+
+  private ArmyAuthorityOwner reopen(boolean sqlite) throws Exception {
+    var owner = new ArmyAuthorityOwner(storage(sqlite));
+    owner.refresh();
+    return owner;
+  }
+
+  private ArmyAuthorityStorage storage(boolean sqlite) throws Exception {
+    if (!sqlite) return new ArmyFileAuthorityStorage(directory.resolve("army"));
+    var dataSource = mock(DataSource.class);
+    when(dataSource.getConnection())
+        .thenAnswer(
+            unused -> DriverManager.getConnection("jdbc:sqlite:" + directory.resolve("army.db")));
+    return new ArmySqlAuthorityStorage(directory.resolve("army"), dataSource);
+  }
+
+  private static ArmySkillRequest request(
+      ArmyAuthorityOwner owner,
+      UUID operationId,
+      UUID actorId,
+      SkillType skillType,
+      UUID previousUseId,
+      Instant acceptedAt) {
+    var targets = new HashMap<UUID, ArmySnapshot>();
+    owner
+        .snapshot()
+        .armies()
+        .forEach(
+            (armyId, army) -> {
+              if (skillType == SkillType.SCOUT
+                  || skillType == SkillType.CAVALRY_CHARGE && armyId.equals(ENEMY)
+                  || skillType != SkillType.CAVALRY_CHARGE && army.nationId().equals(NATION)) {
+                targets.put(armyId, army);
+              }
+            });
+    return new ArmySkillRequest(
+        operationId,
+        actorId,
+        NATION,
+        skillType,
+        1,
+        1,
+        previousUseId,
+        acceptedAt,
+        skillType == SkillType.SCOUT || skillType == SkillType.RALLY ? ORIGIN : null,
+        targets);
+  }
+
+  private static ArmyPaidRequest resupply(
+      ArmySnapshot before, UUID operationId, Instant acceptedAt) {
+    var after =
+        new ArmySnapshot(
+            new ArmyToken(
+                before.token().armyId(),
+                before.token().incarnation(),
+                before.token().generation() + 1),
+            before.nationId(),
+            before.type(),
+            before.soldiers(),
+            before.health(),
+            before.morale(),
+            before.position(),
+            before.state(),
+            100,
+            before.supplyConsumptionRemainder(),
+            before.createdAt(),
+            acceptedAt);
+    return new ArmyPaidRequest(
+        operationId,
+        ACTOR,
+        ArmyPaidRequest.Kind.RESUPPLY,
+        before,
+        after,
+        new BigDecimal("700.00"),
+        acceptedAt,
+        10);
+  }
+
+  private static ArmySnapshot army(UUID armyId, UUID nationId) {
+    return new ArmySnapshot(
+        new ArmyToken(armyId, new UUID(7, armyId.getLeastSignificantBits()), 1),
+        nationId,
+        ArmyType.INFANTRY,
+        100,
+        90,
+        60,
+        ORIGIN,
+        ArmyState.STATIONARY,
+        30,
+        17,
+        ACCEPTED.minusSeconds(2),
+        ACCEPTED.minusSeconds(1));
+  }
+
+  private static ArmySnapshot withHealth(ArmySnapshot before, double health) {
+    return new ArmySnapshot(
+        before.token(),
+        before.nationId(),
+        before.type(),
+        before.soldiers(),
+        health,
+        before.morale(),
+        before.position(),
+        before.state(),
+        before.supply(),
+        before.supplyConsumptionRemainder(),
+        before.createdAt(),
+        before.lastUpdated());
+  }
+}
