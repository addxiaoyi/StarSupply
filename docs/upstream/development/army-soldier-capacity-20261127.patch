index 0000000000000000000000000000000000000000..2e3db587d5812adfd31a106ab58fcfdb5e992133
--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/module/army/model/authority/ArmyBattleIntervention.java
@@ -0,0 +1,183 @@
+package dev.starcore.starcore.module.army.model.authority;
+
+import dev.starcore.starcore.module.army.commander.model.SkillType;
+import dev.starcore.starcore.module.army.model.ArmyState;
+import java.time.Instant;
+import java.util.Map;
+import java.util.Objects;
+import java.util.UUID;
+
+public record ArmyBattleIntervention(
+    UUID skillOperationId,
+    SkillType skillType,
+    Instant acceptedAt,
+    ArmyBattleHeads before,
+    ArmyBattleHeads after,
+    Outcome outcome) {
+  public ArmyBattleIntervention {
+    Objects.requireNonNull(skillOperationId, "skillOperationId");
+    Objects.requireNonNull(skillType, "skillType");
+    Objects.requireNonNull(acceptedAt, "acceptedAt");
+    Objects.requireNonNull(before, "before");
+    Objects.requireNonNull(after, "after");
+    Objects.requireNonNull(outcome, "outcome");
+    if (skillType == SkillType.SCOUT
+        || !before.attacker().isAlive()
+        || !before.defender().isAlive()
+        || before.attacker().state() != ArmyState.ATTACKING
+        || before.defender().state() != ArmyState.DEFENDING) {
+      throw new IllegalArgumentException(
+          "Intervention requires active battle participants and a mutation");
+    }
+    if (!acceptedAt.isAfter(Instant.EPOCH)) {
+      throw new IllegalArgumentException("Battle intervention time must be after the epoch");
+    }
+    requireIdentity(before.attacker(), after.attacker());
+    requireIdentity(before.defender(), after.defender());
+    if (acceptedAt.isBefore(before.attacker().lastUpdated())
+        || acceptedAt.isBefore(before.defender().lastUpdated())) {
+      throw new IllegalArgumentException("Battle intervention precedes a participant head");
+    }
+    boolean valid = false;
+    for (int level = 1; level <= 3; level++) {
+      valid |=
+          canonical(skillOperationId, skillType, acceptedAt, before, after, outcome, true, level);
+      valid |=
+          canonical(skillOperationId, skillType, acceptedAt, before, after, outcome, false, level);
+    }
+    if (!valid) {
+      throw new IllegalArgumentException(
+          "Battle intervention differs from a canonical skill effect");
+    }
+    if (outcome == Outcome.CONTINUED
+        && (!after.attacker().isAlive()
+            || !after.defender().isAlive()
+            || after.attacker().token().generation() == Long.MAX_VALUE
+            || after.defender().token().generation() == Long.MAX_VALUE)) {
+      throw new IllegalArgumentException("Continuing battle requires a terminal successor");
+    }
+  }
+
+  public static ArmyBattleIntervention from(ArmySkillUse use, ArmyBattleHeads before) {
+    Objects.requireNonNull(use, "use");
+    Objects.requireNonNull(before, "before");
+    var request = use.request();
+    if (request.skillType() == SkillType.SCOUT) {
+      throw new IllegalArgumentException("Scout cannot intervene in an active battle");
+    }
+    ArmySnapshot attacker = before.attacker();
+    ArmySnapshot defender = before.defender();
+    boolean attackerHit = use.effects().containsKey(attacker.token().armyId());
+    boolean defenderHit = use.effects().containsKey(defender.token().armyId());
+    if (attackerHit == defenderHit) {
+      throw new IllegalArgumentException("Skill use must affect exactly one battle participant");
+    }
+    if (attackerHit && !Objects.equals(request.targets().get(attacker.token().armyId()), attacker)
+        || defenderHit
+            && !Objects.equals(request.targets().get(defender.token().armyId()), defender)) {
+      throw new IllegalArgumentException("Skill use does not prove the current battle head");
+    }
+    if (request.acceptedAt().isBefore(attacker.lastUpdated())
+        || request.acceptedAt().isBefore(defender.lastUpdated())) {
+      throw new IllegalArgumentException("Skill acceptance precedes the battle heads");
+    }
+    ArmySnapshot nextAttacker =
+        attackerHit ? use.effects().get(attacker.token().armyId()) : attacker;
+    ArmySnapshot nextDefender =
+        defenderHit ? use.effects().get(defender.token().armyId()) : defender;
+    Outcome outcome = Outcome.CONTINUED;
+    if (request.skillType() == SkillType.TACTICAL_RETREAT) {
+      outcome = Outcome.RETREATED;
+      if (attackerHit) nextDefender = stationary(defender, request.acceptedAt());
+      else nextAttacker = stationary(attacker, request.acceptedAt());
+    } else if (request.skillType() == SkillType.CAVALRY_CHARGE
+        && ((attackerHit && !nextAttacker.isAlive()) || (defenderHit && !nextDefender.isAlive()))) {
+      outcome = Outcome.SKILL_DEFEAT;
+      if (attackerHit) nextDefender = stationary(defender, request.acceptedAt());
+      else nextAttacker = stationary(attacker, request.acceptedAt());
+    }
+    return new ArmyBattleIntervention(
+        request.operationId(),
+        request.skillType(),
+        request.acceptedAt(),
+        before,
+        new ArmyBattleHeads(nextAttacker, nextDefender),
+        outcome);
+  }
+
+  private static boolean canonical(
+      UUID operationId,
+      SkillType type,
+      Instant at,
+      ArmyBattleHeads before,
+      ArmyBattleHeads after,
+      Outcome outcome,
+      boolean attackerHit,
+      int level) {
+    var target = attackerHit ? before.attacker() : before.defender();
+    var other = attackerHit ? before.defender() : before.attacker();
+    try {
+      var request =
+          new ArmySkillRequest(
+              operationId,
+              operationId,
+              type == SkillType.CAVALRY_CHARGE ? other.nationId() : target.nationId(),
+              type,
+              level,
+              1,
+              null,
+              at,
+              type == SkillType.RALLY ? target.position() : null,
+              Map.of(target.token().armyId(), target));
+      var effect = request.effects().get(target.token().armyId());
+      Outcome expectedOutcome =
+          type == SkillType.TACTICAL_RETREAT
+              ? Outcome.RETREATED
+              : !effect.isAlive() ? Outcome.SKILL_DEFEAT : Outcome.CONTINUED;
+      var released = expectedOutcome == Outcome.CONTINUED ? other : stationary(other, at);
+      return outcome == expectedOutcome
+          && after.equals(
+              attackerHit
+                  ? new ArmyBattleHeads(effect, released)
+                  : new ArmyBattleHeads(released, effect));
+    } catch (IllegalArgumentException invalid) {
+      return false;
+    }
+  }
+
+  private static ArmySnapshot stationary(ArmySnapshot before, Instant at) {
+    if (before.token().generation() == Long.MAX_VALUE) {
+      throw new IllegalArgumentException("Battle release cannot advance a maximum generation");
+    }
+    return new ArmySnapshot(
+        new ArmyToken(
+            before.token().armyId(), before.token().incarnation(), before.token().generation() + 1),
+        before.nationId(),
+        before.type(),
+        before.soldiers(),
+        before.health(),
+        before.morale(),
+        before.position(),
+        ArmyState.STATIONARY,
+        before.supply(),
+        before.supplyConsumptionRemainder(),
+        before.createdAt(),
+        at);
+  }
+
+  private static void requireIdentity(ArmySnapshot before, ArmySnapshot after) {
+    if (!before.token().armyId().equals(after.token().armyId())
+        || !before.token().incarnation().equals(after.token().incarnation())
+        || !before.nationId().equals(after.nationId())
+        || before.type() != after.type()
+        || !before.createdAt().equals(after.createdAt())) {
+      throw new IllegalArgumentException("Battle intervention changed immutable identity");
+    }
+  }
+
+  public enum Outcome {
+    CONTINUED,
+    RETREATED,
+    SKILL_DEFEAT
+  }
+}
