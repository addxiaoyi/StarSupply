+    Object moduleStorage(String namespace, String type) throws Exception {
+      var constructor =
+          Class.forName("dev.starcore.starcore.module." + namespace + "." + type)
+              .getDeclaredConstructor(
+                  String.class, DatabaseService.class, PersistenceService.class, Logger.class);
+      constructor.setAccessible(true);
+      var result =
+          constructor.newInstance(namespace, database, persistence, Logger.getAnonymousLogger());
+      var sqlField = result.getClass().getDeclaredField("sqlStorage");
+      sqlField.setAccessible(true);
+      if (sqlField.get(result) instanceof AbstractModuleStateStorage asynchronous)
+        ownedStores.add(asynchronous);
+      return result;
+    }
+
+    void fail(Endpoint endpoint, boolean after, NationId target) {
+      var armed = new AtomicBoolean(true);
+      Answer<Object> fault =
+          call -> {
+            boolean selected =
+                call.getArgument(1).toString().equals(target.toString()) && armed.getAndSet(false);
+            if (selected && !after) throw new IllegalStateException("joint boundary " + endpoint);
+            var result = call.callRealMethod();
+            if (selected) throw new IllegalStateException("joint boundary " + endpoint);
+            return result;
+          };
+      switch (endpoint) {
+        case WAR -> doAnswer(fault).when(wars).retireNationWars(any(), any());
+        case TERRITORY -> doAnswer(fault).when(territory).retireOwner(any(), any());
+        case CITY -> doAnswer(fault).when(cities).retireNationCities(any(), any());
+        case DIPLOMACY -> doAnswer(fault).when(diplomacy).retireDiplomacy(any(), any());
+        case BILATERAL -> doAnswer(fault).when(bilateral).retireAlliances(any(), any());
+        case MILITARY -> doAnswer(fault).when(military).retireMilitaryAlliances(any(), any());
+        case TREASURY -> doAnswer(fault).when(treasury).retireTreasury(any(), any());
+        case FEDERATION -> doAnswer(fault).when(federation).retireNationFederation(any(), any());
+      }
+    }
