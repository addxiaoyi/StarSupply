+    assertThat(codec.futureGrowthBudget(source(batch.ended(end)))).isEqualTo(quota);
+    assertThat(codec.futureGrowthBudget(source(acknowledged))).isEqualTo(quota);
+    var state = state(acknowledged);
+    state.setProperty(
+        WarSettlementState.ADMISSION + batch.request().operationId(),
