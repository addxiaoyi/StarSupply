+    unit.getAsJsonObject("location").addProperty("world", "caf" + (char) 0xe9 + "-legacy-world");
+    return ("# exact Latin1 " + (char) 0xe9 + " bytes\r\n" + armyId + "=" + unit + "\r\n")
+        .getBytes(StandardCharsets.ISO_8859_1);
