+    var after = supplied(before, 70, ACCEPTED);
+    assertThrows(NullPointerException.class, () -> resupply(null, after, ACCEPTED));
+    assertThrows(
+        IllegalArgumentException.class, () -> resupply(withLife(before, 0, 0), after, ACCEPTED));
+    var exhausted = before.withToken(new ArmyToken(ARMY_ID, INCARNATION, Long.MAX_VALUE));
+    assertThrows(IllegalArgumentException.class, () -> resupply(exhausted, after, ACCEPTED));
+  }
+
+  @ParameterizedTest
+  @ValueSource(
+      strings = {"operation", "actor", "kind", "amount", "accepted", "maximum", "before", "after"})
+  void everyRequestFieldContributesToItsDigestAndDebitPurpose(String field) {
+    var before = before();
+    var after = supplied(before, 70, ACCEPTED);
+    var original = resupply(before, after, ACCEPTED);
+    ArmyPaidRequest changed =
+        switch (field) {
+          case "operation" ->
+              new ArmyPaidRequest(
+                  OTHER_ID, ACTOR_ID, original.kind(), before, after, AMOUNT, ACCEPTED, 10);
+          case "actor" ->
+              new ArmyPaidRequest(
+                  OPERATION_ID, OTHER_ID, original.kind(), before, after, AMOUNT, ACCEPTED, 10);
+          case "kind" -> create(created(), AMOUNT);
+          case "amount" ->
+              new ArmyPaidRequest(
+                  OPERATION_ID,
+                  ACTOR_ID,
+                  original.kind(),
+                  before,
+                  after,
+                  AMOUNT.add(new BigDecimal("0.01")),
+                  ACCEPTED,
+                  10);
+          case "accepted" ->
+              resupply(before, supplied(before, 70, ACCEPTED.plusNanos(1)), ACCEPTED.plusNanos(1));
+          case "maximum" ->
+              new ArmyPaidRequest(
+                  OPERATION_ID, ACTOR_ID, original.kind(), before, after, AMOUNT, ACCEPTED, 11);
+          case "before" -> resupply(mutate(before, "lastUpdated"), after, ACCEPTED);
+          case "after" -> resupply(before, supplied(before, 71, ACCEPTED), ACCEPTED);
+          default -> throw new AssertionError(field);
