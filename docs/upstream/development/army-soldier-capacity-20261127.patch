+  private static final Instant ACCEPTED = Instant.parse("2026-11-27T04:05:06.123456789Z");
+  private static final Instant DECIDED = ACCEPTED.plusSeconds(3);
+
+  @Test
+  void pendingRequestRetainsFullOriginalSnapshotsAndDerivesExactStartedStates() {
+    var attacker = attacker();
+    var defender = defender();
+    var request = request(attacker, defender, ACCEPTED);
+    var session = new ArmyBattleSession(request, null);
+
+    assertSame(attacker, request.attackerBefore());
+    assertSame(defender, request.defenderBefore());
+    assertEquals(
+        phase(attacker, ArmyState.ATTACKING, attacker.token().generation() + 1, ACCEPTED),
+        request.attackerStarted());
+    assertEquals(
+        phase(defender, ArmyState.DEFENDING, defender.token().generation() + 1, ACCEPTED),
+        request.defenderStarted());
+    assertEquals(ArmyState.MARCHING, request.attackerBefore().state());
+    assertEquals(ArmyState.STATIONARY, request.defenderBefore().state());
+    assertTrue(session.pending());
+    assertNull(session.resolution());
+    assertTrue(session.battleResult().isEmpty());
+  }
+
+  @ParameterizedTest
+  @ValueSource(strings = {"session", "actor", "attacker", "defender", "accepted"})
+  void requestRequiresEveryIdentitySnapshotAndAcceptanceTime(String field) {
+    assertThrows(
+        NullPointerException.class,
+        () ->
+            new ArmyBattleRequest(
+                field.equals("session") ? null : SESSION_ID,
+                field.equals("actor") ? null : ACTOR_ID,
+                field.equals("attacker") ? null : attacker(),
+                field.equals("defender") ? null : defender(),
+                field.equals("accepted") ? null : ACCEPTED));
+  }
+
+  @ParameterizedTest
+  @ValueSource(strings = {"army", "nation"})
+  void battleRequiresDistinctArmyAndNationIdentities(String field) {
+    var defender = defender();
+    var changed =
+        new ArmySnapshot(
+            field.equals("army")
+                ? new ArmyToken(
+                    ATTACKER_ID, defender.token().incarnation(), defender.token().generation())
+                : defender.token(),
+            field.equals("nation") ? ATTACKER_NATION : defender.nationId(),
+            defender.type(),
+            defender.soldiers(),
+            defender.health(),
+            defender.morale(),
+            defender.position(),
+            defender.state(),
+            defender.supply(),
+            defender.supplyConsumptionRemainder(),
+            defender.createdAt(),
+            defender.lastUpdated());
+
+    assertThrows(IllegalArgumentException.class, () -> request(attacker(), changed, ACCEPTED));
+  }
+
+  @ParameterizedTest
+  @ValueSource(strings = {"STATIONARY", "MARCHING", "DEFENDING"})
+  void eligibleOriginalStatesAreAcceptedWithoutErasingTheirOriginalFacts(String state) {
+    var originalState = ArmyState.valueOf(state);
+    var attacker =
+        phase(attacker(), originalState, attacker().token().generation(), attacker().lastUpdated());
+    var defender =
+        phase(defender(), originalState, defender().token().generation(), defender().lastUpdated());
+    var request = request(attacker, defender, ACCEPTED);
+
+    assertEquals(originalState, request.attackerBefore().state());
+    assertEquals(originalState, request.defenderBefore().state());
+    assertEquals(ArmyState.ATTACKING, request.attackerStarted().state());
+    assertEquals(ArmyState.DEFENDING, request.defenderStarted().state());
+  }
+
+  @ParameterizedTest
+  @ValueSource(strings = {"ATTACKING", "SIEGING"})
+  void alreadyAttackingOrSiegingParticipantsAreRejectedOnEitherSide(String state) {
+    var forbidden = ArmyState.valueOf(state);
+    var attacker =
+        phase(attacker(), forbidden, attacker().token().generation(), attacker().lastUpdated());
+    var defender =
+        phase(defender(), forbidden, defender().token().generation(), defender().lastUpdated());
+
+    assertThrows(IllegalArgumentException.class, () -> request(attacker, defender(), ACCEPTED));
+    assertThrows(IllegalArgumentException.class, () -> request(attacker(), defender, ACCEPTED));
+  }
+
+  @ParameterizedTest
+  @ValueSource(
+      strings = {"attackerSoldiers", "attackerHealth", "defenderSoldiers", "defenderHealth"})
+  void bothParticipantsMustBeAlive(String field) {
+    var attacker =
+        stats(
+            attacker(),
+            field.equals("attackerSoldiers") ? 0 : attacker().soldiers(),
+            field.equals("attackerHealth") ? 0 : attacker().health(),
+            attacker().morale());
+    var defender =
+        stats(
+            defender(),
+            field.equals("defenderSoldiers") ? 0 : defender().soldiers(),
+            field.equals("defenderHealth") ? 0 : defender().health(),
+            defender().morale());
+
+    assertThrows(IllegalArgumentException.class, () -> request(attacker, defender, ACCEPTED));
+  }
+
+  @ParameterizedTest
+  @ValueSource(
+      strings = {
+        "epoch",
+        "beforeEpoch",
+        "attackerCreated",
+        "attackerUpdated",
+        "defenderCreated",
+        "defenderUpdated"
+      })
+  void acceptanceCannotPrecedeTheEpochOrEitherSnapshotFact(String field) {
+    Instant accepted =
+        field.equals("epoch")
+            ? Instant.EPOCH
+            : field.equals("beforeEpoch") ? Instant.EPOCH.minusNanos(1) : ACCEPTED;
+    var attacker =
+        times(
+            attacker(),
+            field.equals("attackerCreated") ? ACCEPTED.plusNanos(1) : attacker().createdAt(),
+            field.equals("attackerUpdated") ? ACCEPTED.plusNanos(1) : attacker().lastUpdated());
+    var defender =
+        times(
+            defender(),
+            field.equals("defenderCreated") ? ACCEPTED.plusNanos(1) : defender().createdAt(),
+            field.equals("defenderUpdated") ? ACCEPTED.plusNanos(1) : defender().lastUpdated());
+
+    assertThrows(IllegalArgumentException.class, () -> request(attacker, defender, accepted));
+  }
+
+  @Test
+  void exactAcceptanceBoundaryAndNanosecondFactsArePreserved() {
+    var attacker = times(attacker(), ACCEPTED, ACCEPTED);
+    var defender = times(defender(), ACCEPTED, ACCEPTED);
+    var request = request(attacker, defender, ACCEPTED);
+
+    assertEquals(ACCEPTED, request.acceptedAt());
+    assertEquals(ACCEPTED, request.attackerStarted().createdAt());
+    assertEquals(ACCEPTED, request.defenderStarted().lastUpdated());
+  }
+
+  @Test
+  void generationHeadroomCoversBothStartAndTerminalWithoutOverflow() {
+    var attacker =
+        attacker()
+            .withToken(
+                new ArmyToken(ATTACKER_ID, attacker().token().incarnation(), Long.MAX_VALUE - 2));
+    var defender =
+        defender()
+            .withToken(
+                new ArmyToken(DEFENDER_ID, defender().token().incarnation(), Long.MAX_VALUE - 2));
+    var request = request(attacker, defender, ACCEPTED);
+    var resolution = ArmyBattleSession.cancelled(request, DECIDED);
+
+    assertEquals(Long.MAX_VALUE - 1, request.attackerStarted().token().generation());
+    assertEquals(Long.MAX_VALUE - 1, request.defenderStarted().token().generation());
+    assertEquals(Long.MAX_VALUE, resolution.attackerAfter().token().generation());
+    assertEquals(Long.MAX_VALUE, resolution.defenderAfter().token().generation());
+    assertDoesNotThrow(() -> new ArmyBattleSession(request, resolution));
+  }
+
+  @ParameterizedTest
+  @ValueSource(longs = {Long.MAX_VALUE - 1, Long.MAX_VALUE})
+  void insufficientGenerationHeadroomIsRejectedOnEitherSide(long generation) {
+    var attacker =
+        attacker()
+            .withToken(new ArmyToken(ATTACKER_ID, attacker().token().incarnation(), generation));
+    var defender =
+        defender()
+            .withToken(new ArmyToken(DEFENDER_ID, defender().token().incarnation(), generation));
+
+    assertThrows(IllegalArgumentException.class, () -> request(attacker, defender(), ACCEPTED));
+    assertThrows(IllegalArgumentException.class, () -> request(attacker(), defender, ACCEPTED));
+  }
+
+  @Test
+  void completionRetainsExactProofAndDerivesTheOriginalBattleResultFromDeltasAndLife() {
+    var request = request();
+    var attackerAfter = terminal(request.attackerBefore(), 70, 60, 80, DECIDED);
+    var defenderAfter = terminal(request.defenderBefore(), 0, 0, 50, DECIDED);
+    var resolution =
+        resolution(
