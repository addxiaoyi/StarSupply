+  private ArmyAuthorityOwner initialize(boolean sqlite, Path directory) throws Exception {
+    Files.createDirectories(directory);
+    var storage = storage(sqlite, directory);
+    var initialized =
+        ArmyAuthorityBootstrap.initialize(storage, directory.resolve("missing-legacy"));
+    assertTrue(initialized.initialized());
+    assertTrue(initialized.armies().isEmpty());
+    var owner = new ArmyAuthorityOwner(storage);
