+        try {
+          blockNextLoad.set(true);
+          var pending =
+              executor.submit(
+                  () ->
+                      action.equals("reserve")
+                          ? module.reserveTreaty(request)
+                          : module.cancelTreaty(request));
+          assertThat(loadEntered.await(10, TimeUnit.SECONDS)).isTrue();
