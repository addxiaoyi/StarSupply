+package dev.starcore.starcore.module.army.model.authority;
+
+import dev.starcore.starcore.module.army.model.ArmyState;
+import dev.starcore.starcore.module.army.model.ArmyType;
+import java.time.Instant;
+import java.util.Objects;
+import java.util.UUID;
+
+public record ArmySnapshot(
+    ArmyToken token,
+    UUID nationId,
+    ArmyType type,
+    int soldiers,
+    double health,
+    double morale,
+    ArmyPosition position,
+    ArmyState state,
+    int supply,
+    int supplyConsumptionRemainder,
+    Instant createdAt,
+    Instant lastUpdated) {
+  public ArmySnapshot {
+    Objects.requireNonNull(token, "token");
+    Objects.requireNonNull(nationId, "nationId");
+    Objects.requireNonNull(type, "type");
+    Objects.requireNonNull(position, "position");
+    Objects.requireNonNull(state, "state");
+    Objects.requireNonNull(createdAt, "createdAt");
+    Objects.requireNonNull(lastUpdated, "lastUpdated");
+    if (soldiers < 0) throw new IllegalArgumentException("Soldiers must not be negative");
+    if (!Double.isFinite(health) || health < 0 || health > 100) {
+      throw new IllegalArgumentException("Health percentage must be between 0 and 100");
+    }
+    if (!Double.isFinite(morale) || morale < 0 || morale > 100) {
+      throw new IllegalArgumentException("Morale percentage must be between 0 and 100");
+    }
+    if (supply < 0 || supply > 100) {
+      throw new IllegalArgumentException("Supply must be between 0 and 100");
+    }
+    if (supplyConsumptionRemainder < 0 || supplyConsumptionRemainder >= 60) {
+      throw new IllegalArgumentException("Hourly supply remainder must be between 0 and 59");
+    }
+  }
+
+  public boolean isAlive() {
+    return soldiers > 0 && health > 0;
+  }
+
+  public ArmySnapshot withToken(ArmyToken replacement) {
+    return new ArmySnapshot(
+        replacement,
+        nationId,
+        type,
+        soldiers,
+        health,
+        morale,
+        position,
+        state,
+        supply,
+        supplyConsumptionRemainder,
+        createdAt,
+        lastUpdated);
+  }
+}
