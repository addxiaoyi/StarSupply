@@ -0,0 +1,124 @@
+package dev.starcore.starcore.module.diplomacy;
+
+import dev.starcore.starcore.module.nation.model.NationId;
+import java.time.Instant;
+import java.util.Objects;
+import java.util.Optional;
+import java.util.UUID;
+
+public interface DiplomacyAllianceOperationService {
+  enum Action {
+    FORM,
+    BREAK
+  }
+
+  enum Outcome {
+    APPLIED,
+    CANCELLED,
+    REJECTED_RETIRED,
+    REJECTED_WAR,
+    REJECTED_PRECONDITION,
+    REJECTED_COOLDOWN
+  }
+
+  record Request(
+      UUID operationId,
+      NationId left,
+      NationId right,
+      Action action,
+      NationId actor,
+      Instant occurredAt,
+      DiplomacyRelation expectedRelation,
+      long expectedGeneration) {
+    public Request {
+      Objects.requireNonNull(operationId, "operationId");
+      Objects.requireNonNull(left, "left");
+      Objects.requireNonNull(right, "right");
+      Objects.requireNonNull(action, "action");
+      Objects.requireNonNull(actor, "actor");
+      Objects.requireNonNull(occurredAt, "occurredAt");
+      Objects.requireNonNull(expectedRelation, "expectedRelation");
+      if (left.toString().compareTo(right.toString()) >= 0)
+        throw new IllegalArgumentException(
+            "Alliance operation endpoints must be distinct and ordered");
+      if (!actor.equals(left) && !actor.equals(right))
+        throw new IllegalArgumentException("Alliance operation actor must be an endpoint");
+      if (expectedGeneration < 0)
+        throw new IllegalArgumentException("Invalid expected alliance generation");
+    }
+  }
+
+  record Receipt(
+      Request request,
+      Outcome outcome,
+      long generation,
+      DiplomacyRelation previousRelation,
+      DiplomacyRelation resultingRelation) {
+    public Receipt {
+      Objects.requireNonNull(request, "request");
+      Objects.requireNonNull(outcome, "outcome");
+      Objects.requireNonNull(previousRelation, "previousRelation");
+      Objects.requireNonNull(resultingRelation, "resultingRelation");
+      if (generation < 0) throw new IllegalArgumentException("Invalid alliance generation");
+      if (outcome == Outcome.APPLIED) {
+        DiplomacyRelation target =
+            request.action() == Action.FORM ? DiplomacyRelation.ALLIED : DiplomacyRelation.NEUTRAL;
+        if (resultingRelation != target
+            || previousRelation != request.expectedRelation()
+            || (request.action() == Action.FORM
+                && (previousRelation == DiplomacyRelation.ALLIED
+                    || previousRelation == DiplomacyRelation.WAR
+                    || previousRelation == DiplomacyRelation.HOSTILE))
+            || (request.action() == Action.BREAK && previousRelation != DiplomacyRelation.ALLIED)
+            || generation != Math.addExact(request.expectedGeneration(), 1))
+          throw new IllegalArgumentException("Invalid applied alliance receipt");
+      } else if (previousRelation != resultingRelation) {
+        throw new IllegalArgumentException("Rejected alliance operation changed its relation");
+      }
+    }
+
+    public boolean applied() {
+      return outcome == Outcome.APPLIED;
+    }
+  }
+
+  record PairState(
+      NationId left,
+      NationId right,
+      long generation,
+      DiplomacyRelation relation,
+      UUID ownerOperationId,
+      boolean retired) {
+    public PairState {
+      Objects.requireNonNull(left, "left");
+      Objects.requireNonNull(right, "right");
+      Objects.requireNonNull(relation, "relation");
+      if (left.toString().compareTo(right.toString()) >= 0 || generation < 0)
+        throw new IllegalArgumentException("Invalid alliance pair state");
+      if (retired && ownerOperationId != null)
+        throw new IllegalArgumentException("Retired alliance pair cannot have an owner");
+    }
+
+    public boolean ownedBy(UUID operationId) {
+      return !retired && operationId != null && operationId.equals(ownerOperationId);
+    }
+  }
+
+  default Receipt applyAllianceOperation(Request request) {
+    throw new UnsupportedOperationException("Durable alliance operations are not supported");
+  }
+
+  default Receipt cancelAllianceOperation(Request request) {
+    throw new UnsupportedOperationException(
+        "Durable alliance operation cancellation is not supported");
+  }
+
+  default PairState alliancePairState(NationId left, NationId right) {
+    throw new UnsupportedOperationException("Durable alliance pair state is not supported");
+  }
+
+  default Optional<Receipt> allianceOperationReceipt(UUID operationId) {
+    throw new UnsupportedOperationException(
+        "Durable alliance operation receipts are not supported");
+  }
+}
diff --git a/src/main/java/dev/starcore/starcore/module/diplomacy/DiplomacyAllianceOperationState.java b/src/main/java/dev/starcore/starcore/module/diplomacy/DiplomacyAllianceOperationState.java
new file mode 100644
index 0000000000000000000000000000000000000000..985fe645a94446d15bdcf056c4c3768e8536f0b7
--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/module/diplomacy/DiplomacyAllianceOperationState.java
@@ -0,0 +1,279 @@
+package dev.starcore.starcore.module.diplomacy;
+
+import dev.starcore.starcore.module.diplomacy.DiplomacyAllianceOperationService.Action;
+import dev.starcore.starcore.module.diplomacy.DiplomacyAllianceOperationService.Outcome;
+import dev.starcore.starcore.module.diplomacy.DiplomacyAllianceOperationService.Receipt;
+import dev.starcore.starcore.module.diplomacy.DiplomacyAllianceOperationService.Request;
+import dev.starcore.starcore.module.nation.model.NationId;
+import java.time.Instant;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.Map;
+import java.util.Objects;
+import java.util.Properties;
+import java.util.UUID;
+
+record DiplomacyAllianceOperationState(
+    Map<UUID, Receipt> receipts, Map<DiplomacyPairKey, Fence> pairs) {
+  static final String PREFIX = "allianceOperation.";
+
+  record Fence(long generation, UUID ownerOperationId) {
+    Fence {
+      if (generation <= 0) throw new IllegalArgumentException("Invalid alliance pair generation");
+    }
+  }
+
+  DiplomacyAllianceOperationState {
+    receipts = Map.copyOf(receipts);
+    pairs = Map.copyOf(pairs);
+  }
+
+  static DiplomacyAllianceOperationState empty() {
+    return new DiplomacyAllianceOperationState(Map.of(), Map.of());
+  }
+
+  long generation(DiplomacyPairKey pair) {
+    Fence fence = pairs.get(pair);
+    return fence == null ? 0 : fence.generation();
+  }
+
+  UUID owner(DiplomacyPairKey pair) {
+    Fence fence = pairs.get(pair);
+    return fence == null ? null : fence.ownerOperationId();
+  }
+
+  DiplomacyAllianceOperationState release(DiplomacyPairKey pair) {
+    var next = new HashMap<>(pairs);
+    next.put(pair, new Fence(Math.addExact(generation(pair), 1), null));
+    return new DiplomacyAllianceOperationState(receipts, next);
+  }
+
+  DiplomacyAllianceOperationState record(Receipt receipt) {
+    UUID id = receipt.request().operationId();
+    Receipt previous = receipts.get(id);
+    if (previous != null) {
+      if (!previous.equals(receipt))
+        throw new IllegalArgumentException("Alliance operation receipt is immutable");
+      return this;
+    }
+    var nextReceipts = new HashMap<>(receipts);
+    nextReceipts.put(id, receipt);
+    var nextPairs = new HashMap<>(pairs);
+    if (receipt.applied()) {
+      var pair = DiplomacyPairKey.of(receipt.request().left(), receipt.request().right());
+      if (generation(pair) != receipt.request().expectedGeneration())
+        throw new IllegalArgumentException("Alliance operation generation changed");
+      nextPairs.put(pair, new Fence(receipt.generation(), id));
+    }
+    return new DiplomacyAllianceOperationState(nextReceipts, nextPairs);
+  }
+
+  Properties write(Properties properties) {
+    var result = DiplomacyAuthority.copy(properties);
+    result.keySet().removeIf(key -> key instanceof String text && text.startsWith(PREFIX));
+    result.setProperty(PREFIX + "version", "1");
+    receipts.forEach(
+        (id, receipt) -> result.setProperty(PREFIX + "receipt." + id, encode(receipt)));
+    pairs.forEach(
+        (pair, fence) ->
+            result.setProperty(
+                PREFIX + "pair." + pair.left() + "." + pair.right(),
+                fence.generation() + "|" + Objects.toString(fence.ownerOperationId(), "-")));
+    return result;
+  }
+
+  private static String encode(Receipt receipt) {
+    Request request = receipt.request();
+    return request.left()
+        + "|"
+        + request.right()
+        + "|"
+        + request.action()
+        + "|"
+        + request.actor()
+        + "|"
+        + request.occurredAt()
+        + "|"
+        + request.expectedRelation()
+        + "|"
+        + request.expectedGeneration()
+        + "|"
+        + receipt.outcome()
+        + "|"
+        + receipt.generation()
+        + "|"
+        + receipt.previousRelation()
+        + "|"
+        + receipt.resultingRelation();
+  }
+
+  static DiplomacyAllianceOperationState read(Properties properties) {
+    var keys =
+        properties.stringPropertyNames().stream().filter(key -> key.startsWith(PREFIX)).toList();
+    if (keys.isEmpty()) return empty();
+    if (!"1".equals(properties.getProperty(PREFIX + "version")))
+      throw new IllegalArgumentException("Invalid alliance operation schema");
+    var receipts = new HashMap<UUID, Receipt>();
+    var pairs = new HashMap<DiplomacyPairKey, Fence>();
+    for (String key : keys) {
+      String suffix = key.substring(PREFIX.length());
+      String value = properties.getProperty(key);
+      if (suffix.startsWith("receipt.")) {
+        UUID id = uuid(suffix.substring("receipt.".length()));
+        String[] fields = value.split("\\|", -1);
+        if (fields.length != 11)
+          throw new IllegalArgumentException("Invalid alliance operation receipt");
+        var request =
+            new Request(
+                id,
+                NationId.of(uuid(fields[0])),
+                NationId.of(uuid(fields[1])),
+                Action.valueOf(fields[2]),
+                NationId.of(uuid(fields[3])),
+                Instant.parse(fields[4]),
+                DiplomacyRelation.valueOf(fields[5]),
+                Long.parseLong(fields[6]));
+        var receipt =
+            new Receipt(
+                request,
+                Outcome.valueOf(fields[7]),
+                Long.parseLong(fields[8]),
+                DiplomacyRelation.valueOf(fields[9]),
+                DiplomacyRelation.valueOf(fields[10]));
+        if (!encode(receipt).equals(value))
+          throw new IllegalArgumentException("Noncanonical alliance operation receipt");
+        receipts.put(id, receipt);
+      } else if (suffix.startsWith("pair.")) {
+        String[] endpoints = suffix.substring("pair.".length()).split("\\.", -1);
+        String[] fields = value.split("\\|", -1);
+        if (endpoints.length != 2 || fields.length != 2)
+          throw new IllegalArgumentException("Invalid alliance operation pair");
+        var pair =
+            DiplomacyPairKey.of(NationId.of(uuid(endpoints[0])), NationId.of(uuid(endpoints[1])));
+        var fence =
+            new Fence(Long.parseLong(fields[0]), fields[1].equals("-") ? null : uuid(fields[1]));
+        if (pair.left().equals(pair.right())
+            || !(pair.left() + "." + pair.right()).equals(suffix.substring("pair.".length()))
+            || !(fence.generation() + "|" + Objects.toString(fence.ownerOperationId(), "-"))
+                .equals(value))
+          throw new IllegalArgumentException("Noncanonical alliance operation pair");
+        pairs.put(pair, fence);
+      } else if (!suffix.equals("version")) {
+        throw new IllegalArgumentException("Unknown alliance operation property");
+      }
+    }
+    var result = new DiplomacyAllianceOperationState(receipts, pairs);
+    receipts.values().stream()
+        .filter(Receipt::applied)
+        .forEach(
+            receipt -> {
+              var pair = DiplomacyPairKey.of(receipt.request().left(), receipt.request().right());
+              if (result.generation(pair) < receipt.generation())
+                throw new IllegalArgumentException("Missing alliance operation pair history");
+            });
+    pairs.forEach(
+        (pair, fence) -> {
+          if (fence.ownerOperationId() == null) return;
+          var receipt = receipts.get(fence.ownerOperationId());
+          if (receipt == null
+              || !receipt.applied()
+              || receipt.generation() != fence.generation()
+              || !pair.equals(
+                  DiplomacyPairKey.of(receipt.request().left(), receipt.request().right())))
+            throw new IllegalArgumentException("Invalid alliance operation ownership");
+        });
+    return result;
+  }
+
+  private static UUID uuid(String text) {
+    UUID id = UUID.fromString(text);
+    if (!id.toString().equals(text))
+      throw new IllegalArgumentException("Noncanonical alliance operation UUID");
+    return id;
+  }
+
+  static void validate(Properties properties) {
+    var state = read(properties);
+    var retired = DiplomacyAuthority.receipts(properties);
+    var relations = DiplomacyStateCodec.fromProperties(properties);
+    var times = DiplomacyTemporalStateCodec.relationChangesFromProperties(properties);
+    var wars = DiplomacyWarCodec.fromProperties(properties);
+    var warOwners = WarDiplomacyMirrorState.read(properties).owners();
+    state.pairs.forEach(
+        (pair, fence) -> {
+          if (fence.ownerOperationId() == null) return;
+          Receipt receipt = state.receipts.get(fence.ownerOperationId());
+          if (retired.containsKey(pair.left())
+              || retired.containsKey(pair.right())
+              || warOwners.containsKey(pair)
+              || wars.containsKey(pair)
+              || !receipt.request().occurredAt().equals(times.get(pair))
+              || relations.getOrDefault(pair, DiplomacyRelation.NEUTRAL)
+                  != receipt.resultingRelation())
+            throw new IllegalArgumentException("Alliance operation owner is superseded");
+        });
+  }
+
+  static Properties fenceChanges(Properties previous, Properties next) {
+    var before = read(previous);
+    var after = read(next);
+    var previousRelations = DiplomacyStateCodec.fromProperties(previous);
+    var nextRelations = DiplomacyStateCodec.fromProperties(next);
+    var previousWars = DiplomacyWarCodec.fromProperties(previous);
+    var nextWars = DiplomacyWarCodec.fromProperties(next);
+    var previousTimes = DiplomacyTemporalStateCodec.relationChangesFromProperties(previous);
+    var nextTimes = DiplomacyTemporalStateCodec.relationChangesFromProperties(next);
+    var previousOwners = WarDiplomacyMirrorState.read(previous).owners();
+    var nextOwners = WarDiplomacyMirrorState.read(next).owners();
+    var retiredBefore = DiplomacyAuthority.receipts(previous);
+    var retiredAfter = DiplomacyAuthority.receipts(next);
+    var candidates = new HashSet<>(before.pairs.keySet());
+    candidates.addAll(previousRelations.keySet());
+    candidates.addAll(nextRelations.keySet());
+    candidates.addAll(previousWars.keySet());
+    candidates.addAll(nextWars.keySet());
+    candidates.addAll(previousTimes.keySet());
+    candidates.addAll(nextTimes.keySet());
+    for (var pair : candidates) {
+      boolean newlyRetired =
+          (!retiredBefore.containsKey(pair.left()) && retiredAfter.containsKey(pair.left()))
+              || (!retiredBefore.containsKey(pair.right())
+                  && retiredAfter.containsKey(pair.right()));
+      boolean changed =
+          newlyRetired
+              || !Objects.equals(previousRelations.get(pair), nextRelations.get(pair))
+              || !Objects.equals(previousWars.get(pair), nextWars.get(pair))
+              || !Objects.equals(previousTimes.get(pair), nextTimes.get(pair))
+              || !Objects.equals(previousOwners.get(pair), nextOwners.get(pair));
+      if (changed && after.generation(pair) == before.generation(pair)) after = after.release(pair);
+    }
+    return after.write(next);
+  }
+
+  static void transition(
+      DiplomacyAllianceOperationState before, DiplomacyAllianceOperationState after) {
+    before.receipts.forEach(
+        (id, receipt) -> {
+          if (!receipt.equals(after.receipts.get(id)))
+            throw new IllegalArgumentException("Alliance operation receipts are immutable");
+        });
+    before.pairs.forEach(
+        (pair, fence) -> {
+          Fence next = after.pairs.get(pair);
+          if (next == null
+              || next.generation() < fence.generation()
+              || (next.generation() == fence.generation()
+                  && !Objects.equals(next.ownerOperationId(), fence.ownerOperationId())))
+            throw new IllegalArgumentException("Alliance operation generation rollback");
+        });
+    after.pairs.forEach(
+        (pair, fence) -> {
+          UUID owner = fence.ownerOperationId();
+          if (owner != null
+              && !owner.equals(before.owner(pair))
+              && before.receipts.containsKey(owner))
+            throw new IllegalArgumentException(
+                "Released alliance operation owner cannot be reacquired");
+        });
+  }
+}
