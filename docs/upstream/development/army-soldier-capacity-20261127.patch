+              root.resolve("missing-legacy"));
+    }
+    return initialized;
+  }
+
+  private ArmyAuthoritySnapshot image(ArmySkillUse use) throws Exception {
+    return image(use.effects(), Map.of(use.request().operationId(), use), 4);
+  }
+
+  private ArmyAuthoritySnapshot image(
+      Map<UUID, ArmySnapshot> armies, Map<UUID, ArmySkillUse> skills, int version)
+      throws Exception {
+    return new ArmyAuthoritySnapshot(
+        true,
+        7,
+        armies,
+        Map.of(),
+        Map.of(),
+        base().migration(),
+        version,
+        Map.of(),
+        Map.of(),
+        skills);
+  }
+
+  private static ArmySkillRequest request(
+      SkillType type, ArmyPosition origin, Map<UUID, ArmySnapshot> targets) {
+    return new ArmySkillRequest(
+        OPERATION_ID, ACTOR_ID, NATION_ID, type, 1, 1, null, ACCEPTED, origin, targets);
+  }
+
+  private String rawSkillRow(
+      ArmySkillRequest request,
+      List<Map.Entry<UUID, ArmySnapshot>> targets,
+      List<Map.Entry<UUID, ArmySnapshot>> effects,
+      Instant readyAt)
+      throws Exception {
+    var buffer = new ByteArrayOutputStream();
+    try (var output = new DataOutputStream(buffer)) {
+      output.write(requestPrefix(request));
+      writeEntries(output, targets);
+      writeEntries(output, effects);
+      writeInstant(output, readyAt);
+    }
+    return Base64.getEncoder().encodeToString(buffer.toByteArray());
+  }
+
+  private static byte[] requestPrefix(ArmySkillRequest request) throws Exception {
+    var buffer = new ByteArrayOutputStream();
+    try (var output = new DataOutputStream(buffer)) {
+      output.writeInt(0x41524D59);
+      output.writeByte(1);
+      output.writeByte(7);
+      writeUuid(output, request.operationId());
+      writeUuid(output, request.actorId());
+      writeUuid(output, request.nationId());
+      writeString(output, request.skillType().name());
+      output.writeInt(request.level());
+      output.writeInt(request.rulesVersion());
+      writeNullableUuid(output, request.previousUseId());
+      writeInstant(output, request.acceptedAt());
+      output.writeBoolean(request.origin() != null);
+      if (request.origin() != null) {
+        var origin = request.origin();
+        writeNullableUuid(output, origin.worldId());
+        writeString(output, origin.worldName());
+        output.writeDouble(origin.x());
+        output.writeDouble(origin.y());
+        output.writeDouble(origin.z());
+        output.writeFloat(origin.yaw());
+        output.writeFloat(origin.pitch());
+      }
+    }
+    return buffer.toByteArray();
+  }
+
+  private void writeEntries(DataOutputStream output, List<Map.Entry<UUID, ArmySnapshot>> entries)
+      throws Exception {
+    output.writeInt(entries.size());
+    for (var entry : entries) {
+      writeUuid(output, entry.getKey());
+      var armyProperties =
+          ArmyAuthorityCodec.encode(
+              image(Map.of(entry.getValue().token().armyId(), entry.getValue()), Map.of(), 1));
+      var armyRow = bytes(armyProperties.getProperty("army." + entry.getValue().token().armyId()));
+      output.write(armyRow, ROW_HEADER_BYTES, armyRow.length - ROW_HEADER_BYTES);
+    }
+  }
+
+  private static List<Map.Entry<UUID, ArmySnapshot>> entries(Map<UUID, ArmySnapshot> armies) {
+    return new ArrayList<>(new TreeMap<>(armies).entrySet());
+  }
+
+  private static int previousFlagOffset(ArmySkillRequest request) {
+    return ROW_HEADER_BYTES
+        + 3 * 2 * Long.BYTES
+        + Integer.BYTES
+        + request.skillType().name().getBytes(StandardCharsets.UTF_8).length
+        + 2 * Integer.BYTES;
+  }
+
+  private static void writeNullableUuid(DataOutputStream output, UUID value) throws Exception {
+    output.writeBoolean(value != null);
+    if (value != null) writeUuid(output, value);
+  }
+
+  private static void writeUuid(DataOutputStream output, UUID value) throws Exception {
+    output.writeLong(value.getMostSignificantBits());
+    output.writeLong(value.getLeastSignificantBits());
+  }
+
+  private static void writeInstant(DataOutputStream output, Instant value) throws Exception {
+    output.writeLong(value.getEpochSecond());
+    output.writeInt(value.getNano());
+  }
+
+  private static void writeString(DataOutputStream output, String value) throws Exception {
+    byte[] bytes = value.getBytes(StandardCharsets.UTF_8);
+    output.writeInt(bytes.length);
+    output.write(bytes);
+  }
+
+  private static void assertRejectsSkillRow(Properties original, byte[] row) {
+    var malformed = copy(original);
+    malformed.setProperty(SKILL_KEY, Base64.getEncoder().encodeToString(row));
+    assertThrows(IllegalArgumentException.class, () -> ArmyAuthorityCodec.decode(malformed));
+  }
+
+  private static Properties copy(Properties original) {
+    var copy = new Properties();
+    copy.putAll(original);
+    return copy;
+  }
+
+  private static byte[] bytes(String row) {
+    return Base64.getDecoder().decode(row);
+  }
+
+  private static ArmySnapshot army(UUID armyId, int supply) {
+    return new ArmySnapshot(
+        new ArmyToken(armyId, new UUID(2, armyId.getLeastSignificantBits()), 1),
+        NATION_ID,
+        ArmyType.INFANTRY,
+        42,
+        73.5,
+        64.25,
+        new ArmyPosition(WORLD_ID, "skill-world", 12.5, 68, -9.25, 37.5f, -16.25f),
+        ArmyState.MARCHING,
+        supply,
+        37,
+        ACCEPTED.minusSeconds(60),
+        ACCEPTED.minusSeconds(1));
+  }
+
+  private static ArmySnapshot withSupply(ArmySnapshot before, int supply) {
+    return new ArmySnapshot(
+        before.token(),
+        before.nationId(),
+        before.type(),
+        before.soldiers(),
+        before.health(),
+        before.morale(),
+        before.position(),
+        before.state(),
+        supply,
+        before.supplyConsumptionRemainder(),
+        before.createdAt(),
+        before.lastUpdated());
+  }
+}
