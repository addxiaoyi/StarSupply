+  private static NationId nation(long identifier) {
+    return NationId.of(uuid(identifier));
+  }
+
+  private static UUID uuid(long identifier) {
+    return new UUID(0, identifier);
+  }
+
+  private static <Value> List<Value> reversed(List<Value> values) {
+    var result = new ArrayList<>(values);
+    Collections.reverse(result);
+    return result;
+  }
+
+  private enum WireOrder {
+    CANONICAL,
+    ORIGINAL_TERMS,
+    ATTACKER_ALLIES,
+    ENTRIES,
+    ASSIGNMENTS,
+    ENTRY_SCOPES,
+    GLOBAL_SCOPES
+  }
+
+  private static String wireEnvelope(Envelope envelope, WireOrder order) throws IOException {
+    return binary(output -> writeEnvelope(output, envelope, order));
+  }
+
+  private static String wireManifest(Manifest manifest, WireOrder order) throws IOException {
+    return binary(
+        output -> {
+          output.writeUTF("starcore:treaty:manifest-wire:v2");
+          writeEnvelope(output, manifest.envelope(), order);
+          var entries =
+              order == WireOrder.ENTRIES ? reversed(manifest.entries()) : manifest.entries();
+          output.writeInt(entries.size());
+          for (var entry : entries) {
+            output.writeUTF(entry.receiverId());
+            output.writeInt(entry.receiverVersion());
+            var assignments =
+                order == WireOrder.ASSIGNMENTS
+                    ? reversed(entry.assignedTermIndexes())
+                    : entry.assignedTermIndexes();
+            output.writeInt(assignments.size());
+            for (int index : assignments) output.writeInt(index);
+            output.writeUTF(entry.localPlanHash());
+            writeScopes(
+                output,
+                order == WireOrder.ENTRY_SCOPES ? reversed(entry.scopes()) : entry.scopes());
+          }
+          writeScopes(
+              output,
+              order == WireOrder.GLOBAL_SCOPES ? reversed(manifest.scopes()) : manifest.scopes());
+        });
+  }
+
+  private static void writeEnvelope(DataOutputStream output, Envelope envelope, WireOrder order)
+      throws IOException {
+    output.writeUTF("starcore:treaty:request:v2");
+    output.writeInt(envelope.version());
+    writeUuid(output, envelope.operationId());
+    writeUuid(output, envelope.treatyId());
+    var war = envelope.war();
+    writeUuid(output, war.warId());
+    writeUuid(output, war.attacker().value());
+    writeUuid(output, war.defender().value());
+    writeTime(output, war.declaredAt());
+    writeNations(
+        output,
+        order == WireOrder.ATTACKER_ALLIES ? reversed(war.attackerAllies()) : war.attackerAllies());
+    writeNations(output, war.defenderAllies());
+    output.writeLong(envelope.warGeneration());
+    output.writeUTF(envelope.warFingerprint());
+    writeUuid(output, envelope.victor().value());
+    writeUuid(output, envelope.defeated().value());
+    writeTime(output, envelope.preparedAt());
+    var terms =
+        order == WireOrder.ORIGINAL_TERMS
+            ? reversed(envelope.originalTerms())
+            : envelope.originalTerms();
+    output.writeInt(terms.size());
+    for (var term : terms) {
+      output.writeInt(term.termIndex());
+      output.writeUTF(term.type());
+      output.writeInt(term.payload().size());
+      for (var value : term.payload()) output.writeUTF(value);
+      output.writeUTF(term.description());
+    }
+  }
+
+  private static void writeScopes(DataOutputStream output, List<PairScope> scopes)
+      throws IOException {
+    output.writeInt(scopes.size());
+    for (var scope : scopes) {
+      writeUuid(output, scope.left().value());
+      writeUuid(output, scope.right().value());
+    }
+  }
+
+  private static void writeNations(DataOutputStream output, List<NationId> nations)
+      throws IOException {
+    output.writeInt(nations.size());
+    for (var nation : nations) writeUuid(output, nation.value());
+  }
+
+  private static void writeUuid(DataOutputStream output, UUID identifier) throws IOException {
+    output.writeLong(identifier.getMostSignificantBits());
+    output.writeLong(identifier.getLeastSignificantBits());
+  }
+
+  private static void writeTime(DataOutputStream output, Instant value) throws IOException {
+    output.writeLong(value.getEpochSecond());
+    output.writeInt(value.getNano());
+  }
+
+  private interface BinaryWriter {
+    void write(DataOutputStream output) throws IOException;
+  }
+
+  private static String binary(BinaryWriter writer) throws IOException {
+    var bytes = new ByteArrayOutputStream();
+    try (var output = new DataOutputStream(bytes)) {
+      writer.write(output);
+    }
+    return Base64.getEncoder().encodeToString(bytes.toByteArray());
+  }
+}
