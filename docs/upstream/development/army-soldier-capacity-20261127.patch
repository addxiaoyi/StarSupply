+class NativeTextInputRoutingTest {
+  @Test
+  void realBookEditsCannotConsumeNativeDialogDraftsInAnyMigratedListener() {
+    for (Class<?> listener :
+        List.of(
+            EssentialsGuiListener.class,
+            AllianceGuiListener.class,
+            ArbitrationGuiListener.class,
+            DiplomacyNetworkListener.class,
+            PlayerTradeGuiListener.class,
+            TreasuryMenuListener.class,
+            PetListener.class,
+            ActivityRecommendationListener.class,
+            WarehouseListener.class,
+            ZoneGuiListener.class)) {
+      assertThat(listener.getMethods())
+          .filteredOn(method -> method.isAnnotationPresent(EventHandler.class))
+          .noneSatisfy(
+              method -> assertThat(method.getParameterTypes()).contains(PlayerEditBookEvent.class));
+    }
+  }
+
+  @Test
+  void treasuryNativeSubmissionUsesExistingCallbackOnceAndCancelDiscardsIt() throws Exception {
+    var nations = mock(NationService.class);
+    var nation = mock(Nation.class);
+    NationId nationId = NationId.random();
+    when(nation.id()).thenReturn(nationId);
+    when(nation.getId()).thenReturn(nationId);
+    when(nation.hasPermission(any(), eq("treasury.manage"))).thenReturn(true);
+    var listener = new TreasuryMenuListener(null, null, nations, null, null, null);
+    var player = NativeTextInputTest.player(UUID.randomUUID());
+    when(nations.nationOf(player.getUniqueId())).thenReturn(Optional.of(nation));
+    var method =
+        TreasuryMenuListener.class.getDeclaredMethod(
+            "openBookInput", Player.class, String.class, NationPermission.class, Consumer.class);
+    method.setAccessible(true);
+    var values = new ArrayList<String>();
+    Consumer<String> callback = values::add;
+    try (var permissions = mockStatic(PermissionUtil.class);
+        var support = mockStatic(BookInputSupport.class)) {
+      permissions
+          .when(
+              () ->
+                  PermissionUtil.hasNationPermission(
+                      player, nationId.value(), NationPermission.BANK_WITHDRAW))
+          .thenReturn(true);
+      method.invoke(listener, player, "Amount", NationPermission.BANK_WITHDRAW, callback);
+      var submit = ArgumentCaptor.forClass(Consumer.class);
+      var cancel = ArgumentCaptor.forClass(Runnable.class);
+      var active = ArgumentCaptor.forClass(BooleanSupplier.class);
+      support.verify(
+          () ->
+              BookInputSupport.prepare(
+                  same(player),
+                  eq("Amount"),
+                  eq(""),
+                  active.capture(),
+                  submit.capture(),
+                  cancel.capture()));
+      assertThat(active.getValue().getAsBoolean()).isTrue();
+      submit.getValue().accept("  12.34  ");
+      submit.getValue().accept("second");
+      assertThat(values).containsExactly("12.34");
+      support.clearInvocations();
+      method.invoke(listener, player, "Next", NationPermission.BANK_WITHDRAW, callback);
+      support.verify(
+          () ->
+              BookInputSupport.prepare(
+                  same(player),
+                  eq("Next"),
+                  eq(""),
+                  active.capture(),
+                  submit.capture(),
+                  cancel.capture()));
+      cancel.getValue().run();
+      submit.getValue().accept("canceled");
+      assertThat(values).containsExactly("12.34");
+      verify(player, never()).getInventory();
+    }
+  }
