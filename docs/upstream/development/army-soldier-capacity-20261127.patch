+package dev.starcore.starcore.module.army.authority;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+import dev.starcore.starcore.module.army.model.ArmyState;
+import dev.starcore.starcore.module.army.model.ArmyType;
+import dev.starcore.starcore.module.army.model.authority.ArmyLogisticsReceipt;
+import dev.starcore.starcore.module.army.model.authority.ArmyPosition;
+import dev.starcore.starcore.module.army.model.authority.ArmySnapshot;
+import dev.starcore.starcore.module.army.model.authority.ArmyToken;
+import dev.starcore.starcore.module.army.storage.authority.ArmyAuthorityBootstrap;
