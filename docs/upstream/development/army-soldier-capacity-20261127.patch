+
+    assertEquals(amount, create(created(), amount).amount());
+  }
+
+  @ParameterizedTest
+  @ValueSource(strings = {"before", "generation", "dead", "created", "updated"})
+  void creationRejectsAnyPredecessorOrNonfreshEffect(String scenario) {
