+  private Instant nationHistoryTime(UUID nationId) {
+    var image = owner.snapshot();
+    Instant at = now();
+    for (var army : image.armies().values()) {
+      if (army.nationId().equals(nationId))
+        at = maximum(maximum(at, army.createdAt()), army.lastUpdated());
+    }
+    for (var tombstone : image.tombstones().values())
+      if (tombstone.nationId().equals(nationId)) at = maximum(at, tombstone.retiredAt());
+    for (var operation : image.paidOperations().values())
+      if (operation.request().nationId().equals(nationId))
+        at = maximum(at, operation.request().acceptedAt());
+    for (var skill : image.skillUses().values())
+      if (skill.request().nationId().equals(nationId))
+        at = maximum(at, skill.request().acceptedAt());
+    for (var battle : image.battleSessions().values()) {
+      if (!battle.request().attackerBefore().nationId().equals(nationId)
+          && !battle.request().defenderBefore().nationId().equals(nationId)) continue;
+      at = maximum(at, battle.request().acceptedAt());
+      for (var intervention : battle.interventions()) at = maximum(at, intervention.acceptedAt());
+      if (!battle.pending()) at = maximum(at, battle.resolution().decidedAt());
+    }
+    return at;
+  }
