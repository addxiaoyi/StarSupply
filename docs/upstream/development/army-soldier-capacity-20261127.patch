+    var initial = first.initializeFromLegacy(imported());
+    var second = backend.storage();
+    assertThat(second.load()).isEqualTo(initial);
+    var committed = first.commit(initial, replace(initial, advance(initial.armies().get(firstId))));
+    assertThatThrownBy(
+            () -> second.commit(initial, replace(initial, advance(initial.armies().get(secondId)))))
+        .hasMessageContaining("conflict");
+    assertThat(second.snapshot()).isEqualTo(committed);
+    assertThat(backend.storage().load()).isEqualTo(committed);
+  }
