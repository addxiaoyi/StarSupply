+  private static void assertRejected(Executable action) {
+    var rejected = assertThrows(RuntimeException.class, action);
+    assertTrue(
+        rejected instanceof IllegalArgumentException || rejected instanceof IllegalStateException,
+        () -> "Unexpected rejection: " + rejected);
+  }
