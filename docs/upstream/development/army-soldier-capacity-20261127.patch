+  private ArmyAuthorityStorage storage(boolean sqlite, Path directory) throws SQLException {
+    var stateDirectory = directory.resolve("army");
+    if (!sqlite) {
+      return new ArmyFileAuthorityStorage(stateDirectory);
+    }
+    DataSource dataSource = mock(DataSource.class);
+    when(dataSource.getConnection())
+        .thenAnswer(
+            unused -> DriverManager.getConnection("jdbc:sqlite:" + directory.resolve("army.db")));
