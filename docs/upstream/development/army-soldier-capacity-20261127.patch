+++ b/src/test/java/dev/starcore/starcore/module/army/model/authority/ArmyBattleInterventionTest.java
@@ -0,0 +1,309 @@
+package dev.starcore.starcore.module.army.model.authority;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import dev.starcore.starcore.module.army.commander.model.SkillType;
+import dev.starcore.starcore.module.army.model.ArmyState;
+import dev.starcore.starcore.module.army.model.ArmyType;
+import dev.starcore.starcore.module.army.model.BattleResult;
+import java.time.Instant;
+import java.util.Collections;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+import java.util.stream.Stream;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.Arguments;
+import org.junit.jupiter.params.provider.MethodSource;
+import org.junit.jupiter.params.provider.ValueSource;
+
+class ArmyBattleInterventionTest {
+  private static final Instant TIME = Instant.parse("2026-11-27T10:00:00.123456789Z");
+
+  static Stream<Arguments> supports() {
+    return Stream.of(
+            SkillType.RALLY,
+            SkillType.INSPIRE,
+            SkillType.REINFORCE,
+            SkillType.SIEGE_MASTERY,
+            SkillType.PHALANX,
+            SkillType.MORALE_BOOST,
+            SkillType.SUPPLY_LINE)
+        .flatMap(type -> Stream.of(Arguments.of(type, true), Arguments.of(type, false)));
+  }
+
+  @ParameterizedTest
+  @MethodSource("supports")
+  void supportRetainsTheOpponentAndCancellationKeepsTheLatestStats(
+      SkillType type, boolean attacker) {
+    var original = session(1, 1, 70, 80);
+    var use = use(original, type, attacker, TIME.plusSeconds(1), 10);
+    var advanced = original.intervene(use);
+    var target = attacker ? advanced.currentHeads().attacker() : advanced.currentHeads().defender();
+    assertEquals(use.effects().get(target.token().armyId()), target);
+    assertEquals(
+        attacker ? original.currentHeads().defender() : original.currentHeads().attacker(),
+        attacker ? advanced.currentHeads().defender() : advanced.currentHeads().attacker());
+    assertTrue(advanced.pending());
+    assertEquals(1, advanced.interventions().size());
+    var resolution = ArmyBattleSession.cancelled(advanced, TIME.plusSeconds(2));
+    var terminal = new ArmyBattleSession(advanced.request(), resolution, advanced.interventions());
+    var finalTarget = attacker ? resolution.attackerAfter() : resolution.defenderAfter();
+    assertEquals(target.soldiers(), finalTarget.soldiers());
+    assertEquals(target.health(), finalTarget.health());
+    assertEquals(target.morale(), finalTarget.morale());
+    assertEquals(target.supply(), finalTarget.supply());
+    assertEquals(target.token().generation() + 1, finalTarget.token().generation());
+    assertEquals(ArmyState.STATIONARY, finalTarget.state());
+    assertTrue(terminal.battleResult().isEmpty());
+    assertThrows(
+        IllegalArgumentException.class,
+        () ->
+            new ArmyBattleSession(
+                advanced.request(),
+                ArmyBattleSession.cancelled(advanced.request(), TIME.plusSeconds(2)),
+                advanced.interventions()));
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {true, false})
+  void retreatUsesTheSkillSuccessorAndReleasesTheOtherParticipantOnlyOnce(boolean attacker) {
+    var original = session(1, 1, 40, 50);
+    var use = use(original, SkillType.TACTICAL_RETREAT, attacker, TIME, 11);
+    var terminal = original.intervene(use);
+    var resolution = terminal.resolution();
+    var target = attacker ? resolution.attackerAfter() : resolution.defenderAfter();
+    var opponent = attacker ? resolution.defenderAfter() : resolution.attackerAfter();
+    var opponentBefore =
+        attacker ? original.currentHeads().defender() : original.currentHeads().attacker();
+    assertEquals(ArmyBattleSession.Status.RETREATED, resolution.status());
+    assertEquals(use.effects().get(target.token().armyId()), target);
+    assertEquals(ArmyState.MARCHING, target.state());
+    assertEquals(3, target.token().generation());
+    assertEquals(opponentBefore.health(), opponent.health());
+    assertEquals(opponentBefore.morale(), opponent.morale());
+    assertEquals(opponentBefore.supply(), opponent.supply());
+    assertEquals(opponentBefore.token().generation() + 1, opponent.token().generation());
+    assertEquals(ArmyState.STATIONARY, opponent.state());
+    assertEquals(TIME, resolution.decidedAt());
+    assertTrue(terminal.battleResult().isEmpty());
+    assertThrows(IllegalStateException.class, () -> terminal.intervene(use));
+    assertThrows(
+        IllegalArgumentException.class,
+        () -> new ArmyBattleSession(original.request(), null, terminal.interventions()));
+    assertThrows(
+        IllegalArgumentException.class,
+        () ->
+            new ArmyBattleSession(
+                original.request(),
+                new ArmyBattleSession.Resolution(
+                    ArmyBattleSession.Status.CANCELLED, target, opponent, 0, 0, TIME),
+                terminal.interventions()));
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {true, false})
+  void cavalryChoosesContinuedOrSkillDefeatFromTheActualCanonicalEffect(boolean attacker) {
+    var healthy = session(1, 1, 80, 80);
+    var continuing = healthy.intervene(use(healthy, SkillType.CAVALRY_CHARGE, attacker, TIME, 12));
+    assertTrue(continuing.pending());
+    var vulnerable = session(1, 1, 10, 10);
+    var use = use(vulnerable, SkillType.CAVALRY_CHARGE, attacker, TIME, 13);
+    var defeated = vulnerable.intervene(use);
+    var dead =
+        attacker ? defeated.resolution().attackerAfter() : defeated.resolution().defenderAfter();
+    assertEquals(ArmyBattleSession.Status.SKILL_DEFEAT, defeated.resolution().status());
+    assertEquals(use.effects().get(dead.token().armyId()), dead);
+    assertFalse(dead.isAlive());
+    assertEquals(3, dead.token().generation());
+    assertTrue(defeated.battleResult().isEmpty());
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {true, false})
+  void generationReservationIsSymmetricAndSpecialTerminationNeedsNoExtraSuccessor(
+      boolean attacker) {
+    var original =
+        session(attacker ? Long.MAX_VALUE - 2 : 1, attacker ? 1 : Long.MAX_VALUE - 2, 70, 80);
+    assertThrows(
+        IllegalArgumentException.class,
+        () -> original.intervene(use(original, SkillType.PHALANX, attacker, TIME, 14)));
+    var terminal =
+        original.intervene(use(original, SkillType.TACTICAL_RETREAT, attacker, TIME, 15));
+    assertEquals(
+        Long.MAX_VALUE,
+        (attacker ? terminal.resolution().attackerAfter() : terminal.resolution().defenderAfter())
+            .token()
+            .generation());
+    var room =
+        session(attacker ? Long.MAX_VALUE - 3 : 1, attacker ? 1 : Long.MAX_VALUE - 3, 70, 80);
+    var continued = room.intervene(use(room, SkillType.PHALANX, attacker, TIME, 16));
+    var cancelled = ArmyBattleSession.cancelled(continued, TIME);
+    assertEquals(
+        Long.MAX_VALUE,
+        (attacker ? cancelled.attackerAfter() : cancelled.defenderAfter()).token().generation());
+  }
+
+  @Test
+  void timeCannotPrecedeTheOtherParticipantOrLatestResolutionHead() {
+    var initial = session(1, 1, 70, 80);
+    var advanced =
+        initial.intervene(use(initial, SkillType.PHALANX, true, TIME.plusSeconds(5), 17));
+    assertThrows(
+        IllegalArgumentException.class,
+        () ->
+            advanced.intervene(
+                use(advanced, SkillType.PHALANX, false, TIME.plusSeconds(5).minusNanos(1), 18)));
+    assertThrows(
+        IllegalArgumentException.class,
+        () -> ArmyBattleSession.cancelled(advanced, TIME.plusSeconds(5).minusNanos(1)));
+    assertDoesNotThrow(
+        () -> advanced.intervene(use(advanced, SkillType.PHALANX, false, TIME.plusSeconds(5), 19)));
+  }
+
+  @Test
+  void cappedEffectStillAdvancesOnlyTheSelectedParticipant() {
+    var original = session(1, 1, 70, 80);
+    var use = use(original, SkillType.SUPPLY_LINE, true, TIME, 20);
+    var advanced = original.intervene(use);
+    assertEquals(100, original.currentHeads().attacker().supply());
+    assertEquals(100, advanced.currentHeads().attacker().supply());
+    assertEquals(3, advanced.currentHeads().attacker().token().generation());
+    assertEquals(original.currentHeads().defender(), advanced.currentHeads().defender());
+  }
+
+  @Test
+  void completionCasualtiesUseReinforcedHeads() {
+    var original = session(1, 1, 70, 80);
+    var advanced = original.intervene(use(original, SkillType.REINFORCE, true, TIME, 21));
+    var cancelled = ArmyBattleSession.cancelled(advanced, TIME);
+    var attacker = stats(cancelled.attackerAfter(), 105, 60);
+    var defender = stats(cancelled.defenderAfter(), 90, 70);
+    var terminal =
+        new ArmyBattleSession(
+            advanced.request(),
+            new ArmyBattleSession.Resolution(
+                ArmyBattleSession.Status.COMPLETED, attacker, defender, 10, 20, TIME),
+            advanced.interventions());
+    assertEquals(
+        BattleResult.create(new UUID(0, 1), new UUID(0, 2), 10, 20, 5, 10, true, true),
+        terminal.battleResult().orElseThrow());
+  }
+
+  @Test
+  void proofRejectsOpponentMutationWrongOutcomeDuplicateSkillAndTruncatedHistory() {
+    var original = session(1, 1, 70, 80);
+    var first = original.intervene(use(original, SkillType.PHALANX, true, TIME, 22));
+    var proof = first.interventions().getFirst();
+    assertThrows(
+        IllegalArgumentException.class,
+        () ->
+            new ArmyBattleIntervention(
+                proof.skillOperationId(),
+                proof.skillType(),
+                proof.acceptedAt(),
+                proof.before(),
+                new ArmyBattleHeads(
+                    proof.after().attacker(), stats(proof.after().defender(), 99, 80)),
+                proof.outcome()));
+    assertThrows(
+        IllegalArgumentException.class,
+        () ->
+            new ArmyBattleIntervention(
+                proof.skillOperationId(),
+                proof.skillType(),
+                proof.acceptedAt(),
+                proof.before(),
+                proof.after(),
+                ArmyBattleIntervention.Outcome.RETREATED));
+    assertThrows(
+        IllegalArgumentException.class,
+        () -> first.intervene(use(first, SkillType.PHALANX, false, TIME, 22)));
+    var second = first.intervene(use(first, SkillType.PHALANX, false, TIME, 23));
+    assertThrows(
+        IllegalArgumentException.class,
+        () ->
+            new ArmyBattleSession(
+                original.request(), null, List.of(second.interventions().getLast())));
+    assertThrows(
+        IllegalArgumentException.class,
+        () ->
+            new ArmyBattleSession(
+                original.request(),
+                null,
+                Collections.nCopies(ArmyBattleSession.MAX_INTERVENTIONS + 1, proof)));
+    assertThrows(UnsupportedOperationException.class, () -> first.interventions().clear());
+    var scout = use(original, SkillType.SCOUT, true, TIME, 24);
+    assertThrows(IllegalArgumentException.class, () -> original.intervene(scout));
+  }
+
+  private static ArmyBattleSession session(
+      long attackerGeneration,
+      long defenderGeneration,
+      double attackerHealth,
+      double defenderHealth) {
+    return new ArmyBattleSession(
+        new ArmyBattleRequest(
+            new UUID(0, 3),
+            new UUID(0, 4),
+            army(1, attackerGeneration, attackerHealth),
+            army(2, defenderGeneration, defenderHealth),
+            TIME),
+        null);
+  }
+
+  private static ArmySnapshot army(long identity, long generation, double health) {
+    return new ArmySnapshot(
+        new ArmyToken(new UUID(0, identity), new UUID(1, identity), generation),
+        new UUID(2, identity),
+        ArmyType.INFANTRY,
+        100,
+        health,
+        40,
+        new ArmyPosition(new UUID(0, 100), "world", 0, 64, 0, 0, 0),
+        ArmyState.STATIONARY,
+        100,
+        17,
+        TIME.minusSeconds(10),
+        TIME.minusSeconds(1));
+  }
+
+  private static ArmySkillUse use(
+      ArmyBattleSession session,
+      SkillType type,
+      boolean attacker,
+      Instant accepted,
+      long identity) {
+    var target = attacker ? session.currentHeads().attacker() : session.currentHeads().defender();
+    var other = attacker ? session.currentHeads().defender() : session.currentHeads().attacker();
+    return ArmySkillUse.completed(
+        new ArmySkillRequest(
+            new UUID(3, identity),
+            new UUID(4, identity),
+            type == SkillType.CAVALRY_CHARGE ? other.nationId() : target.nationId(),
+            type,
+            1,
+            1,
+            null,
+            accepted,
+            type == SkillType.RALLY || type == SkillType.SCOUT ? target.position() : null,
+            Map.of(target.token().armyId(), target)));
+  }
+
+  private static ArmySnapshot stats(ArmySnapshot source, int soldiers, double health) {
+    return new ArmySnapshot(
+        source.token(),
+        source.nationId(),
+        source.type(),
+        soldiers,
+        health,
+        source.morale(),
+        source.position(),
+        source.state(),
+        source.supply(),
+        source.supplyConsumptionRemainder(),
+        source.createdAt(),
+        source.lastUpdated());
+  }
+}
