+import org.junit.jupiter.params.provider.ValueSource;
+
+class NationDisbandFederationTest {
+  @TempDir Path root;
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void olderCompletedHistoryBackfillsFederationAndBlocksWritesWhileReceiptUnavailable(boolean sql)
+      throws Exception {
+    try (var f = new FederationTestFixture(root, sql)) {
+      var store = storage(f, sql);
+      store.load();
+      store.save(
+          NationStateCodec.toProperties(List.of(f.directory.get(f.a), f.directory.get(f.b))));
+      var registry = services();
+      var first = module(store, registry);
+      assertThat(first.disbandNation(f.a)).isTrue();
+      // The older checkpoint's completion did not touch a real federation authority.
+      var historical =
+          NationStateCodec.snapshot(store.load()).disbands().values().iterator().next();
+      var operation = historical.transaction().transactionId();
+      var federation = spy(f.service());
+      var id = f.create(federation, f.a, "Historical");
+      f.join(federation, id, f.a, f.b);
+      registry.register(AllianceService.class, federation);
+      var restarted = module(storage(f, sql), registry);
+      doThrow(new IllegalStateException("federation offline"))
+          .when(federation)
+          .retireNationFederation(any(), any());
+      assertThatThrownBy(restarted::recoverPendingDisband).hasMessage("federation offline");
+      assertThatThrownBy(() -> restarted.disbandNation(f.b))
+          .hasMessageContaining("Federation retirement recovery pending");
+      assertThatThrownBy(
+              () ->
+                  restarted.grantExperience(
+                      new NationExperienceService.Grant("blocked-upgrade", f.b, 5)))
+          .hasMessageContaining("Nation lifecycle recovery pending");
+      assertThat(restarted.experienceOf(f.b)).isZero();
+      doCallRealMethod().when(federation).retireNationFederation(any(), any());
+      restarted.recoverPendingDisband();
+      assertThat(federation.federationRetirementReceipt(f.a).orElseThrow().operationId())
+          .isEqualTo(operation);
+      assertThat(federation.getAlliance(id).orElseThrow().leaderId()).isEqualTo(f.b);
+      assertThat(NationStateCodec.snapshot(store.load()).disbands().get(operation))
+          .isEqualTo(historical);
+      restarted.recoverPendingDisband();
+      assertThat(federation.getAllianceMembers(id)).hasSize(1);
+    }
+  }
+
+  NationStateStorage storage(FederationTestFixture f, boolean sql) {
+    return sql
+        ? new SqlNationStateStorage(f.sql, new Properties(), Logger.getAnonymousLogger())
+        : new PersistenceNationStateStorage("nation", f.persistence);
+  }
+
+  NationModule module(NationStateStorage storage, ServiceRegistry services) throws Exception {
+    var module = new NationModule(NationDisbandTestAuthorities.territory(), storage);
+    var context = mock(StarCoreContext.class);
+    var plugin = mock(JavaPlugin.class);
+    when(plugin.getLogger()).thenReturn(Logger.getAnonymousLogger());
+    when(context.plugin()).thenReturn(plugin);
+    when(context.serviceRegistry()).thenReturn(services);
+    var field = NationModule.class.getDeclaredField("context");
+    field.setAccessible(true);
+    field.set(module, context);
+    return module;
+  }
+
+  ServiceRegistry services() {
+    var services = new ServiceRegistry();
+    NationDisbandTestAuthorities.install(services, true, true);
+    services.register(ReparationsService.class, mock(ReparationsService.class));
+    return services;
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void realFederationSurvivesCleanupReplyLossAndFreshModuleCompletesOriginalSharedIntent(
+      boolean sql) throws Exception {
+    try (var f = new FederationTestFixture(root, sql)) {
+      var store = storage(f, sql);
+      store.load();
+      store.save(
+          NationStateCodec.toProperties(List.of(f.directory.get(f.a), f.directory.get(f.b))));
+      var federation = spy(f.service());
+      var id = f.create(federation, f.a, "Alpha");
+      f.join(federation, id, f.a, f.b);
+      federation.setAnnouncement(id, "old leader", f.a);
+      federation.inviteNation(f.a, id, f.c);
+      var registry = services();
+      registry.register(AllianceService.class, federation);
+      var first = module(store, registry);
+      var armed = new AtomicBoolean(true);
+      doAnswer(
+              i -> {
+                var result = i.callRealMethod();
+                if (armed.getAndSet(false))
+                  throw new IllegalStateException("federation reply lost");
+                return result;
+              })
+          .when(federation)
+          .retireNationFederation(any(), any());
+      assertThatThrownBy(() -> first.disbandNation(f.a)).hasMessage("federation reply lost");
+      var pending = NationStateCodec.snapshot(store.load()).disbands().values().iterator().next();
+      assertThat(pending.state()).isEqualTo(NationDisbandOperation.State.CLEANUP_PENDING);
+      var operation = pending.transaction().transactionId();
+      var receipt = f.service().federationRetirementReceipt(f.a).orElseThrow();
+      assertThat(receipt.operationId()).isEqualTo(operation);
+      assertThat(receipt.successorId()).isEqualTo(f.b);
+      assertThat(receipt.clearedInvites()).isEqualTo(1);
+      assertThat(receipt.clearedAnnouncements()).isEqualTo(1);
+      var refreshed = f.service();
+      registry.register(AllianceService.class, refreshed);
+      var next = module(storage(f, sql), registry);
+      next.recoverPendingDisband();
+      var complete = NationStateCodec.snapshot(storage(f, sql).load());
+      assertThat(complete.disbands().get(operation).state())
+          .isEqualTo(NationDisbandOperation.State.COMPLETED);
+      assertThat(next.nationById(f.a)).isEmpty();
+      assertThat(next.nationById(f.b)).isPresent();
+      assertThat(refreshed.federationRetirementReceipt(f.a)).contains(receipt);
+      assertThat(refreshed.getAlliance(id).orElseThrow().leaderId()).isEqualTo(f.b);
+      assertThat(federation.createAlliance("Revive", f.a).success()).isFalse();
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void rootAndChildRetireWithSameOperationAndSurvivingMemberBecomesLeader(boolean sql)
+      throws Exception {
+    try (var f = new FederationTestFixture(root, sql)) {
+      var parent = f.directory.get(f.a);
+      var child =
+          new Nation(
+              f.b, "Child", parent.founderId(), "Founder", NationKind.CITY_STATE, parent.id());
+      var store = storage(f, sql);
+      store.load();
+      store.save(NationStateCodec.toProperties(List.of(parent, child, f.directory.get(f.c))));
+      var federation = f.service();
+      var id = f.create(federation, f.a, "Alpha");
+      f.join(federation, id, f.a, f.b);
+      f.join(federation, id, f.a, f.c);
+      var registry = services();
+      registry.register(AllianceService.class, federation);
+      var module = module(store, registry);
+      assertThat(module.disbandNation(f.a)).isTrue();
+      var state = NationStateCodec.snapshot(store.load());
+      var operation = state.disbands().values().iterator().next().transaction().transactionId();
+      var fresh = f.service();
+      assertThat(fresh.retireNationFederation(operation, f.a).operationId()).isEqualTo(operation);
+      assertThat(fresh.retireNationFederation(operation, f.b).operationId()).isEqualTo(operation);
+      assertThat(fresh.getAlliance(id).orElseThrow().leaderId()).isEqualTo(f.c);
+      assertThat(fresh.getAllianceMembers(id)).hasSize(1);
+    }
+  }
+}
