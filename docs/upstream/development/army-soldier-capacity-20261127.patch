+                DECIDED));
+  }
+
+  @Test
+  void cancellationMovesForwardToExactStationarySuccessorsWithoutChangingStats() {
+    var request = request();
+    var resolution = ArmyBattleSession.cancelled(request, DECIDED);
+    var session = new ArmyBattleSession(request, resolution);
+
+    assertEquals(ArmyBattleSession.Status.CANCELLED, resolution.status());
+    assertEquals(
+        terminal(request.attackerBefore(), 100, 90, 60, DECIDED), resolution.attackerAfter());
+    assertEquals(
+        terminal(request.defenderBefore(), 80, 75, 70, DECIDED), resolution.defenderAfter());
+    assertEquals(0, resolution.attackerDamage());
+    assertEquals(0, resolution.defenderDamage());
+    assertEquals(
+        request.attackerBefore().token().generation() + 2,
+        resolution.attackerAfter().token().generation());
+    assertEquals(
+        request.defenderBefore().token().generation() + 2,
+        resolution.defenderAfter().token().generation());
+    assertFalse(session.pending());
+    assertTrue(session.battleResult().isEmpty());
+  }
+
+  @ParameterizedTest
+  @ValueSource(
+      strings = {
+        "attackerSoldiers",
+        "attackerHealth",
+        "attackerMorale",
+        "defenderSoldiers",
+        "defenderHealth",
+        "defenderMorale"
+      })
+  void cancellationCannotChangeAnyParticipantStats(String field) {
+    var request = request();
+    var attacker = request.attackerBefore();
+    var defender = request.defenderBefore();
+    var attackerAfter =
+        terminal(
+            attacker,
+            attacker.soldiers() - (field.equals("attackerSoldiers") ? 1 : 0),
+            attacker.health() - (field.equals("attackerHealth") ? 1 : 0),
+            attacker.morale() - (field.equals("attackerMorale") ? 1 : 0),
+            DECIDED);
+    var defenderAfter =
+        terminal(
+            defender,
+            defender.soldiers() - (field.equals("defenderSoldiers") ? 1 : 0),
+            defender.health() - (field.equals("defenderHealth") ? 1 : 0),
+            defender.morale() - (field.equals("defenderMorale") ? 1 : 0),
+            DECIDED);
+
+    assertThrows(
+        IllegalArgumentException.class,
+        () ->
+            new ArmyBattleSession(
+                request,
+                resolution(
+                    ArmyBattleSession.Status.CANCELLED,
+                    attackerAfter,
+                    defenderAfter,
+                    0,
+                    0,
+                    DECIDED)));
+  }
+
+  @Test
+  void cancellationCannotInventDamageOrUseNonstationarySuccessors() {
+    var request = request();
+    var cancelled = ArmyBattleSession.cancelled(request, DECIDED);
+
+    assertThrows(
+        IllegalArgumentException.class,
+        () ->
+            new ArmyBattleSession(
+                request,
+                resolution(
+                    ArmyBattleSession.Status.CANCELLED,
+                    cancelled.attackerAfter(),
+                    cancelled.defenderAfter(),
+                    1,
+                    0,
+                    DECIDED)));
+    assertThrows(
+        IllegalArgumentException.class,
+        () ->
+            new ArmyBattleSession(
+                request,
+                resolution(
+                    ArmyBattleSession.Status.CANCELLED,
+                    cancelled.attackerAfter(),
+                    cancelled.defenderAfter(),
+                    0,
+                    1,
+                    DECIDED)));
+    assertThrows(
+        IllegalArgumentException.class,
+        () ->
+            new ArmyBattleSession(
+                request,
+                resolution(
+                    ArmyBattleSession.Status.CANCELLED,
+                    mutate(cancelled.attackerAfter(), "state"),
+                    cancelled.defenderAfter(),
+                    0,
+                    0,
+                    DECIDED)));
+  }
+
+  @ParameterizedTest
+  @ValueSource(strings = {"status", "attacker", "defender", "decided"})
+  void terminalResolutionRequiresEveryProofField(String field) {
+    var request = request();
+    var cancelled = ArmyBattleSession.cancelled(request, DECIDED);
+
+    assertThrows(
+        NullPointerException.class,
+        () ->
+            resolution(
+                field.equals("status") ? null : ArmyBattleSession.Status.CANCELLED,
+                field.equals("attacker") ? null : cancelled.attackerAfter(),
+                field.equals("defender") ? null : cancelled.defenderAfter(),
+                0,
+                0,
+                field.equals("decided") ? null : DECIDED));
+  }
+
+  @Test
+  void sessionAndCancellationFactoryRequireTheirSourceRequestAndDecisionTime() {
+    assertThrows(NullPointerException.class, () -> new ArmyBattleSession(null, null));
+    assertThrows(NullPointerException.class, () -> ArmyBattleSession.cancelled(null, DECIDED));
+    assertThrows(NullPointerException.class, () -> ArmyBattleSession.cancelled(request(), null));
+  }
+
+  private static ArmyBattleRequest request() {
+    return request(attacker(), defender(), ACCEPTED);
+  }
+
+  private static ArmyBattleRequest request(
+      ArmySnapshot attacker, ArmySnapshot defender, Instant acceptedAt) {
+    return new ArmyBattleRequest(SESSION_ID, ACTOR_ID, attacker, defender, acceptedAt);
+  }
+
+  private static ArmyBattleSession.Resolution resolution(
+      ArmyBattleSession.Status status,
+      ArmySnapshot attackerAfter,
+      ArmySnapshot defenderAfter,
+      double attackerDamage,
+      double defenderDamage,
+      Instant decidedAt) {
+    return new ArmyBattleSession.Resolution(
+        status, attackerAfter, defenderAfter, attackerDamage, defenderDamage, decidedAt);
+  }
+
+  private static ArmySnapshot attacker() {
+    return new ArmySnapshot(
+        new ArmyToken(ATTACKER_ID, new UUID(1, 3), 4),
+        ATTACKER_NATION,
+        ArmyType.INFANTRY,
+        100,
+        90,
+        60,
+        new ArmyPosition(null, "unresolved-world", 12.5, 68, -9.25, 37.5f, -16.25f),
+        ArmyState.MARCHING,
+        70,
+        21,
+        ACCEPTED.minusSeconds(120),
+        ACCEPTED.minusSeconds(1));
+  }
+
+  private static ArmySnapshot defender() {
+    return new ArmySnapshot(
+        new ArmyToken(DEFENDER_ID, new UUID(1, 4), 11),
+        DEFENDER_NATION,
+        ArmyType.INFANTRY,
+        80,
+        75,
+        70,
+        new ArmyPosition(null, "unresolved-world", 15.5, 68, -12.25, 17.5f, -6.25f),
+        ArmyState.STATIONARY,
+        60,
+        42,
+        ACCEPTED.minusSeconds(100),
+        ACCEPTED.minusSeconds(2));
+  }
+
+  private static ArmySnapshot phase(
+      ArmySnapshot source, ArmyState state, long generation, Instant updatedAt) {
+    return new ArmySnapshot(
+        new ArmyToken(source.token().armyId(), source.token().incarnation(), generation),
+        source.nationId(),
+        source.type(),
+        source.soldiers(),
+        source.health(),
+        source.morale(),
+        source.position(),
+        state,
+        source.supply(),
+        source.supplyConsumptionRemainder(),
+        source.createdAt(),
+        updatedAt);
+  }
+
+  private static ArmySnapshot stats(
+      ArmySnapshot source, int soldiers, double health, double morale) {
+    return new ArmySnapshot(
+        source.token(),
+        source.nationId(),
+        source.type(),
+        soldiers,
+        health,
+        morale,
+        source.position(),
+        source.state(),
+        source.supply(),
+        source.supplyConsumptionRemainder(),
+        source.createdAt(),
+        source.lastUpdated());
+  }
+
+  private static ArmySnapshot times(ArmySnapshot source, Instant createdAt, Instant updatedAt) {
+    return new ArmySnapshot(
+        source.token(),
+        source.nationId(),
+        source.type(),
+        source.soldiers(),
+        source.health(),
+        source.morale(),
+        source.position(),
+        source.state(),
+        source.supply(),
+        source.supplyConsumptionRemainder(),
+        createdAt,
+        updatedAt);
+  }
+
+  private static ArmySnapshot terminal(
+      ArmySnapshot before, int soldiers, double health, double morale, Instant decidedAt) {
+    return phase(
+        stats(before, soldiers, health, morale),
+        ArmyState.STATIONARY,
+        before.token().generation() + 2,
+        decidedAt);
+  }
+
+  private static ArmySnapshot mutate(ArmySnapshot source, String field) {
+    var token =
+        new ArmyToken(
+            field.equals("armyId") ? OTHER_ID : source.token().armyId(),
+            field.equals("incarnation") ? OTHER_ID : source.token().incarnation(),
+            source.token().generation() + (field.equals("generation") ? 1 : 0));
+    var position = source.position();
+    return new ArmySnapshot(
+        token,
+        field.equals("nation") ? OTHER_ID : source.nationId(),
+        field.equals("type")
+            ? Arrays.stream(ArmyType.values())
+                .filter(candidate -> candidate != source.type())
+                .findFirst()
+                .orElseThrow()
+            : source.type(),
+        source.soldiers(),
+        source.health(),
+        source.morale(),
+        field.equals("position")
+            ? new ArmyPosition(
+                position.worldId(),
+                position.worldName(),
+                position.x() + 1,
+                position.y(),
+                position.z(),
+                position.yaw(),
+                position.pitch())
+            : position,
+        field.equals("state") ? ArmyState.MARCHING : source.state(),
+        source.supply() + (field.equals("supply") ? 1 : 0),
+        source.supplyConsumptionRemainder() + (field.equals("remainder") ? 1 : 0),
+        field.equals("created") ? source.createdAt().plusNanos(1) : source.createdAt(),
+        field.equals("lastUpdated") ? source.lastUpdated().plusNanos(1) : source.lastUpdated());
+  }
+}
