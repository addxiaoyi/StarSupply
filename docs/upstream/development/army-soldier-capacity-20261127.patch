+package dev.starcore.starcore.module.army.model.authority;
+
+import java.util.HashMap;
+import java.util.Map;
+import java.util.Objects;
+import java.util.UUID;
+
+public record ArmyAuthoritySnapshot(
+    boolean initialized,
+    long revision,
+    Map<UUID, ArmySnapshot> armies,
+    Map<UUID, ArmyTombstone> tombstones,
+    Map<UUID, ArmyLogisticsReceipt> receipts,
+    ArmyMigrationEvidence migration,
+    int version,
+    Map<UUID, ArmyPaidOperation> paidOperations,
+    Map<UUID, ArmyBattleSession> battleSessions,
+    Map<UUID, ArmySkillUse> skillUses,
+    Map<UUID, ArmyNationClosure> nationClosures) {
+  public ArmyAuthoritySnapshot(
+      boolean initialized,
+      long revision,
+      Map<UUID, ArmySnapshot> armies,
+      Map<UUID, ArmyTombstone> tombstones,
+      Map<UUID, ArmyLogisticsReceipt> receipts,
+      ArmyMigrationEvidence migration) {
+    this(
+        initialized,
+        revision,
+        armies,
+        tombstones,
+        receipts,
+        migration,
+        1,
+        Map.of(),
+        Map.of(),
+        Map.of(),
+        Map.of());
+  }
+
+  public ArmyAuthoritySnapshot(
+      boolean initialized,
+      long revision,
+      Map<UUID, ArmySnapshot> armies,
+      Map<UUID, ArmyTombstone> tombstones,
+      Map<UUID, ArmyLogisticsReceipt> receipts,
+      ArmyMigrationEvidence migration,
+      int version,
+      Map<UUID, ArmyPaidOperation> paidOperations) {
+    this(
+        initialized,
+        revision,
+        armies,
+        tombstones,
+        receipts,
+        migration,
+        version,
+        paidOperations,
+        Map.of(),
+        Map.of(),
+        Map.of());
+  }
+
+  public ArmyAuthoritySnapshot(
+      boolean initialized,
+      long revision,
+      Map<UUID, ArmySnapshot> armies,
+      Map<UUID, ArmyTombstone> tombstones,
+      Map<UUID, ArmyLogisticsReceipt> receipts,
+      ArmyMigrationEvidence migration,
+      int version,
+      Map<UUID, ArmyPaidOperation> paidOperations,
+      Map<UUID, ArmyBattleSession> battleSessions) {
+    this(
+        initialized,
+        revision,
+        armies,
+        tombstones,
+        receipts,
+        migration,
+        version,
+        paidOperations,
+        battleSessions,
+        Map.of(),
+        Map.of());
+  }
+
+  public ArmyAuthoritySnapshot(
+      boolean initialized,
+      long revision,
+      Map<UUID, ArmySnapshot> armies,
+      Map<UUID, ArmyTombstone> tombstones,
+      Map<UUID, ArmyLogisticsReceipt> receipts,
+      ArmyMigrationEvidence migration,
+      int version,
+      Map<UUID, ArmyPaidOperation> paidOperations,
+      Map<UUID, ArmyBattleSession> battleSessions,
+      Map<UUID, ArmySkillUse> skillUses) {
+    this(
+        initialized,
+        revision,
+        armies,
+        tombstones,
+        receipts,
+        migration,
+        version,
+        paidOperations,
+        battleSessions,
+        skillUses,
+        Map.of());
+  }
+
+  public ArmyAuthoritySnapshot {
+    if (revision < 0) throw new IllegalArgumentException("Authority revision must not be negative");
+    armies = Map.copyOf(Objects.requireNonNull(armies, "armies"));
+    tombstones = Map.copyOf(Objects.requireNonNull(tombstones, "tombstones"));
+    receipts = Map.copyOf(Objects.requireNonNull(receipts, "receipts"));
+    paidOperations = Map.copyOf(Objects.requireNonNull(paidOperations, "paidOperations"));
+    battleSessions = Map.copyOf(Objects.requireNonNull(battleSessions, "battleSessions"));
+    skillUses = Map.copyOf(Objects.requireNonNull(skillUses, "skillUses"));
+    nationClosures = Map.copyOf(Objects.requireNonNull(nationClosures, "nationClosures"));
+    if (version < 1
+        || version > 7
+        || version == 1 && !paidOperations.isEmpty()
+        || version < 3 && !battleSessions.isEmpty()
+        || version < 4 && !skillUses.isEmpty()
+        || version < 5 && !nationClosures.isEmpty()
+        || version < 6
+            && battleSessions.values().stream()
+                .anyMatch(session -> !session.interventions().isEmpty())
+        || version < 7
+            && (paidOperations.values().stream()
+                    .anyMatch(op -> op.request().maximumNationSoldiers() != Long.MAX_VALUE)
+                || skillUses.values().stream()
+                    .anyMatch(use -> use.request().maximumNationSoldiers() != Long.MAX_VALUE))) {
+      throw new IllegalArgumentException("Invalid Army authority version or operation ledger");
+    }
+    if (initialized) {
+      Objects.requireNonNull(migration, "migration");
+    } else if (revision != 0
+        || !armies.isEmpty()
+        || !tombstones.isEmpty()
+        || !receipts.isEmpty()
+        || migration != null
+        || version != 1
+        || !paidOperations.isEmpty()
+        || !battleSessions.isEmpty()
+        || !skillUses.isEmpty()
+        || !nationClosures.isEmpty()) {
+      throw new IllegalArgumentException("Uninitialized authority must be the empty sentinel");
+    }
+  }
+
+  public static ArmyAuthoritySnapshot uninitialized() {
+    return new ArmyAuthoritySnapshot(false, 0, Map.of(), Map.of(), Map.of(), null);
+  }
+
+  public ArmyAuthoritySnapshot withRevision(long replacement) {
+    return new ArmyAuthoritySnapshot(
+        initialized,
+        replacement,
+        armies,
+        tombstones,
+        receipts,
+        migration,
+        version,
+        paidOperations,
+        battleSessions,
+        skillUses,
+        nationClosures);
+  }
+
+  public Map<UUID, Long> generations() {
+    Map<UUID, Long> result = new HashMap<>();
+    armies.forEach((armyId, army) -> result.put(armyId, army.token().generation()));
+    tombstones.forEach((armyId, tombstone) -> result.put(armyId, tombstone.token().generation()));
+    return Map.copyOf(result);
+  }
+
+  public Map<UUID, UUID> incarnations() {
+    Map<UUID, UUID> result = new HashMap<>();
+    armies.forEach((armyId, army) -> result.put(armyId, army.token().incarnation()));
+    tombstones.forEach((armyId, tombstone) -> result.put(armyId, tombstone.token().incarnation()));
+    return Map.copyOf(result);
+  }
+}
