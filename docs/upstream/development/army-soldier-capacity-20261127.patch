+package dev.starcore.starcore.treaty;
+
+import dev.starcore.starcore.module.diplomacy.DiplomacyTreatyOperationService;
+import dev.starcore.starcore.module.diplomacy.DiplomacyTreatyOperationService.ExactWar;
+import dev.starcore.starcore.module.diplomacy.DiplomacyTreatyOperationService.PairScope;
+import dev.starcore.starcore.module.nation.model.NationId;
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.DataInputStream;
+import java.io.DataOutputStream;
+import java.io.IOException;
+import java.math.BigDecimal;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.time.Instant;
+import java.util.ArrayList;
+import java.util.Base64;
+import java.util.Comparator;
+import java.util.HashSet;
+import java.util.HexFormat;
+import java.util.List;
+import java.util.Locale;
+import java.util.Objects;
+import java.util.UUID;
+
+public final class TreatyEffectManifest {
+  public static final int VERSION = 2;
+  public static final String DIPLOMACY = "diplomacy";
+  public static final int MAX_TERMS = 32;
+  public static final int MAX_SCOPES = 4096;
+  private static final int MAX_BYTES = 2 * 1024 * 1024;
+  private static final Comparator<PairScope> PAIR_ORDER =
+      Comparator.comparing((PairScope pair) -> pair.left().toString())
+          .thenComparing(pair -> pair.right().toString());
+
+  private TreatyEffectManifest() {}
+
+  public record OriginalTerm(int termIndex, String type, List<String> payload, String description) {
+    public OriginalTerm {
+      if (termIndex < 0 || termIndex >= MAX_TERMS)
+        throw new IllegalArgumentException("Invalid original treaty index");
+      requireText(type, 128);
+      requireText(description, 8192);
+      payload = List.copyOf(payload);
+      if (payload.size() > 256)
+        throw new IllegalArgumentException("Original treaty payload is too large");
+      for (var value : payload) requireText(value, 8192);
+      switch (type) {
+        case "PoliticalTerm" -> {
+          requireSize(payload, 1);
+          if (payload.getFirst().isBlank())
+            throw new IllegalArgumentException("Missing original political requirement");
+        }
+        case "ReparationTerm" -> {
+          requireSize(payload, 2);
+          var amount = new BigDecimal(payload.getFirst());
+          if (amount.signum() <= 0 || !amount.toString().equals(payload.getFirst()))
+            throw new IllegalArgumentException("Invalid original reparation amount");
+          requireInteger(payload.get(1), 1);
+        }
+        case "TerritorialCessionTerm" -> {
+          if (payload.isEmpty() || payload.stream().anyMatch(String::isBlank))
+            throw new IllegalArgumentException("Missing original territory identities");
+        }
+        case "MilitaryRestrictionTerm" -> {
+          requireSize(payload, 2);
+          requireInteger(payload.getFirst(), 0);
+          if (!payload.get(1).equals("true") && !payload.get(1).equals("false"))
+            throw new IllegalArgumentException("Invalid original disarmament flag");
+        }
+        case "ResourceTributeTerm" -> {
+          requireSize(payload, 3);
+          if (payload.getFirst().isBlank())
+            throw new IllegalArgumentException("Missing original resource identity");
+          requireInteger(payload.get(1), 1);
+          requireInteger(payload.get(2), 1);
+        }
+        default -> throw new IllegalArgumentException("Unknown original treaty term type");
+      }
+    }
+  }
+
+  public record Envelope(
+      int version,
+      UUID operationId,
+      UUID treatyId,
+      ExactWar war,
+      long warGeneration,
+      String warFingerprint,
+      NationId victor,
+      NationId defeated,
+      Instant preparedAt,
+      List<OriginalTerm> originalTerms) {
+    public Envelope {
+      if (version != VERSION || warGeneration < 0)
+        throw new IllegalArgumentException("Invalid treaty envelope version or generation");
+      Objects.requireNonNull(operationId);
+      Objects.requireNonNull(treatyId);
+      Objects.requireNonNull(war);
+      requireHash(warFingerprint);
+      Objects.requireNonNull(victor);
+      Objects.requireNonNull(defeated);
+      Objects.requireNonNull(preparedAt);
+      if (!war.opposing(victor, defeated))
+        throw new IllegalArgumentException("Treaty winners are not opposing participants");
+      originalTerms =
+          List.copyOf(originalTerms).stream()
+              .sorted(Comparator.comparingInt(OriginalTerm::termIndex))
+              .toList();
+      if (originalTerms.size() > MAX_TERMS)
+        throw new IllegalArgumentException("Too many original treaty terms");
+      int characters = 0;
+      for (int index = 0; index < originalTerms.size(); index++) {
+        var term = originalTerms.get(index);
+        if (term.termIndex() != index)
+          throw new IllegalArgumentException("Incomplete original treaty term indexes");
+        characters = Math.addExact(characters, term.description().length() + term.type().length());
+        for (var value : term.payload()) characters = Math.addExact(characters, value.length());
+        if (characters > 262144)
+          throw new IllegalArgumentException("Original treaty envelope is too large");
+      }
+    }
+  }
+
+  public record Entry(
+      String receiverId,
+      int receiverVersion,
+      List<Integer> assignedTermIndexes,
+      String localPlanHash,
+      List<PairScope> scopes) {
+    public Entry {
+      if (receiverId == null
+          || !receiverId.matches("[a-z][a-z0-9_-]{0,63}")
+          || receiverVersion <= 0)
+        throw new IllegalArgumentException("Invalid treaty receiver key");
+      requireHash(localPlanHash);
+      assignedTermIndexes = List.copyOf(assignedTermIndexes).stream().sorted().toList();
+      if (assignedTermIndexes.size() > MAX_TERMS
+          || new HashSet<>(assignedTermIndexes).size() != assignedTermIndexes.size()
+          || assignedTermIndexes.stream().anyMatch(index -> index < 0 || index >= MAX_TERMS))
+        throw new IllegalArgumentException("Invalid treaty receiver assignment");
+      scopes = orderedScopes(scopes);
+    }
+  }
+
+  public record Manifest(Envelope envelope, List<Entry> entries, List<PairScope> scopes) {
+    public Manifest {
+      Objects.requireNonNull(envelope);
+      entries =
+          List.copyOf(entries).stream()
+              .sorted(
+                  Comparator.comparing(Entry::receiverId).thenComparingInt(Entry::receiverVersion))
+              .toList();
+      if (entries.isEmpty() || entries.size() > 8)
+        throw new IllegalArgumentException("Invalid treaty receiver count");
+      scopes = orderedScopes(scopes);
+      var receivers = new HashSet<String>();
+      var indexes = new HashSet<Integer>();
+      var union = new HashSet<PairScope>();
+      int scopedCount = 0;
+      for (var entry : entries) {
+        if (!receivers.add(entry.receiverId()))
+          throw new IllegalArgumentException("Duplicate treaty receiver");
+        for (int index : entry.assignedTermIndexes())
+          if (index >= envelope.originalTerms().size() || !indexes.add(index))
+            throw new IllegalArgumentException("Duplicate or foreign treaty assignment");
+        union.addAll(entry.scopes());
+        scopedCount = Math.addExact(scopedCount, entry.scopes().size());
+        if (scopedCount > 8192)
+          throw new IllegalArgumentException("Treaty receiver scope is too large");
+      }
+      if (indexes.size() != envelope.originalTerms().size() || !union.equals(new HashSet<>(scopes)))
+        throw new IllegalArgumentException("Incomplete global treaty manifest");
+      var participants = envelope.war().participants();
+      for (int leftIndex = 0; leftIndex < participants.size(); leftIndex++)
+        for (int rightIndex = leftIndex + 1; rightIndex < participants.size(); rightIndex++)
+          if (!union.contains(
+              PairScope.of(participants.get(leftIndex), participants.get(rightIndex))))
+            throw new IllegalArgumentException("Missing original war participant scope");
+    }
+  }
+
+  public static Manifest singleDiplomacy(
+      Envelope envelope, String localPlanHash, List<PairScope> scopes) {
+    var indexes = envelope.originalTerms().stream().map(OriginalTerm::termIndex).toList();
+    var result =
+        new Manifest(
+            envelope,
+            List.of(new Entry(DIPLOMACY, VERSION, indexes, localPlanHash, scopes)),
+            scopes);
+    requireSupported(result);
+    return result;
+  }
+
+  public static void requireSupported(Manifest manifest) {
+    Objects.requireNonNull(manifest);
+    if (manifest.entries().size() != 1
+        || !manifest.entries().getFirst().receiverId().equals(DIPLOMACY)
+        || manifest.entries().getFirst().receiverVersion() != VERSION)
+      throw new IllegalArgumentException("Unsupported treaty receiver manifest");
+    for (var term : manifest.envelope().originalTerms())
+      if (!term.type().equals("PoliticalTerm")
+          || !DiplomacyTreatyOperationService.POLITICAL_REQUIREMENTS.contains(
+              term.payload().getFirst().toLowerCase(Locale.ROOT)))
+        throw new IllegalArgumentException("Unsupported complete original treaty terms");
+  }
+
+  public static String requestDigest(Envelope envelope) {
+    return hash(envelopeBytes(envelope));
+  }
+
+  public static String manifestHash(Manifest manifest) {
+    return hash(
+        bytes(
+            output -> {
+              output.writeUTF("starcore:treaty:global-manifest:v2");
+              output.writeUTF(requestDigest(manifest.envelope()));
+              entries(output, manifest.entries());
+              scopes(output, manifest.scopes());
+            }));
+  }
+
+  public static String encodeEnvelope(Envelope envelope) {
+    return Base64.getEncoder().encodeToString(envelopeBytes(envelope));
+  }
+
+  public static Envelope decodeEnvelope(String encoded) {
+    try (var input = input(encoded)) {
+      var result = envelope(input);
+      if (input.available() != 0 || !encodeEnvelope(result).equals(encoded))
+        throw new IllegalArgumentException("Noncanonical treaty envelope");
+      return result;
+    } catch (IOException failure) {
+      throw new IllegalArgumentException("Invalid treaty envelope encoding", failure);
+    }
+  }
+
+  public static String encodeManifest(Manifest manifest) {
+    return Base64.getEncoder()
+        .encodeToString(
+            bytes(
+                output -> {
+                  output.writeUTF("starcore:treaty:manifest-wire:v2");
+                  envelope(output, manifest.envelope());
+                  entries(output, manifest.entries());
+                  scopes(output, manifest.scopes());
+                }));
+  }
+
+  public static Manifest decodeManifest(String encoded) {
+    try (var input = input(encoded)) {
+      if (!input.readUTF().equals("starcore:treaty:manifest-wire:v2"))
+        throw new IllegalArgumentException("Unknown treaty manifest wire version");
+      var result = new Manifest(envelope(input), entries(input), scopes(input));
+      if (input.available() != 0 || !encodeManifest(result).equals(encoded))
+        throw new IllegalArgumentException("Noncanonical treaty manifest");
+      return result;
+    } catch (IOException failure) {
+      throw new IllegalArgumentException("Invalid treaty manifest encoding", failure);
+    }
+  }
+
+  private static byte[] envelopeBytes(Envelope envelope) {
+    return bytes(output -> envelope(output, envelope));
+  }
+
+  private static void envelope(DataOutputStream output, Envelope value) throws IOException {
+    output.writeUTF("starcore:treaty:request:v2");
+    output.writeInt(value.version());
+    uuid(output, value.operationId());
+    uuid(output, value.treatyId());
+    var war = value.war();
+    uuid(output, war.warId());
+    nation(output, war.attacker());
+    nation(output, war.defender());
+    time(output, war.declaredAt());
+    nations(output, war.attackerAllies());
+    nations(output, war.defenderAllies());
+    output.writeLong(value.warGeneration());
+    output.writeUTF(value.warFingerprint());
+    nation(output, value.victor());
+    nation(output, value.defeated());
+    time(output, value.preparedAt());
+    output.writeInt(value.originalTerms().size());
+    for (var term : value.originalTerms()) {
+      output.writeInt(term.termIndex());
+      output.writeUTF(term.type());
+      output.writeInt(term.payload().size());
+      for (var item : term.payload()) output.writeUTF(item);
+      output.writeUTF(term.description());
+    }
+  }
+
+  private static Envelope envelope(DataInputStream input) throws IOException {
+    if (!input.readUTF().equals("starcore:treaty:request:v2"))
+      throw new IllegalArgumentException("Unknown treaty request wire version");
+    int version = input.readInt();
+    UUID operationId = uuid(input);
+    UUID treatyId = uuid(input);
+    var war =
+        new ExactWar(
+            uuid(input), nation(input), nation(input), time(input), nations(input), nations(input));
+    long generation = input.readLong();
+    String fingerprint = input.readUTF();
+    var victor = nation(input);
+    var defeated = nation(input);
+    var preparedAt = time(input);
+    int count = count(input, MAX_TERMS);
+    var terms = new ArrayList<OriginalTerm>();
+    for (int index = 0; index < count; index++) {
+      int termIndex = input.readInt();
+      String type = input.readUTF();
+      int payloadCount = count(input, 256);
+      var payload = new ArrayList<String>();
+      for (int payloadIndex = 0; payloadIndex < payloadCount; payloadIndex++)
+        payload.add(input.readUTF());
+      terms.add(new OriginalTerm(termIndex, type, payload, input.readUTF()));
+    }
+    return new Envelope(
+        version,
+        operationId,
+        treatyId,
+        war,
+        generation,
+        fingerprint,
+        victor,
+        defeated,
+        preparedAt,
+        terms);
+  }
+
+  private static void entries(DataOutputStream output, List<Entry> entries) throws IOException {
+    output.writeInt(entries.size());
+    for (var entry : entries) {
+      output.writeUTF(entry.receiverId());
+      output.writeInt(entry.receiverVersion());
+      output.writeInt(entry.assignedTermIndexes().size());
+      for (int index : entry.assignedTermIndexes()) output.writeInt(index);
+      output.writeUTF(entry.localPlanHash());
+      scopes(output, entry.scopes());
+    }
+  }
+
+  private static List<Entry> entries(DataInputStream input) throws IOException {
+    int count = count(input, 8);
+    var entries = new ArrayList<Entry>();
+    for (int entryIndex = 0; entryIndex < count; entryIndex++) {
+      String receiver = input.readUTF();
+      int version = input.readInt();
+      int termCount = count(input, MAX_TERMS);
+      var indexes = new ArrayList<Integer>();
+      for (int termIndex = 0; termIndex < termCount; termIndex++) indexes.add(input.readInt());
+      entries.add(new Entry(receiver, version, indexes, input.readUTF(), scopes(input)));
+    }
+    return entries;
+  }
+
+  private static List<PairScope> orderedScopes(List<PairScope> scopes) {
+    var result = List.copyOf(scopes).stream().sorted(PAIR_ORDER).toList();
+    if (result.isEmpty()
+        || result.size() > MAX_SCOPES
+        || new HashSet<>(result).size() != result.size())
+      throw new IllegalArgumentException("Invalid treaty manifest scope");
+    return result;
+  }
+
+  private static void scopes(DataOutputStream output, List<PairScope> scopes) throws IOException {
+    output.writeInt(scopes.size());
+    for (var scope : scopes) {
+      nation(output, scope.left());
+      nation(output, scope.right());
+    }
+  }
+
+  private static List<PairScope> scopes(DataInputStream input) throws IOException {
+    int count = count(input, MAX_SCOPES);
+    var result = new ArrayList<PairScope>();
+    for (int index = 0; index < count; index++)
+      result.add(new PairScope(nation(input), nation(input)));
+    return result;
+  }
+
+  private static void nations(DataOutputStream output, List<NationId> nations) throws IOException {
+    output.writeInt(nations.size());
+    for (var nation : nations) nation(output, nation);
+  }
+
+  private static List<NationId> nations(DataInputStream input) throws IOException {
+    int count = count(input, 90);
+    var result = new ArrayList<NationId>();
+    for (int index = 0; index < count; index++) result.add(nation(input));
+    return result;
+  }
+
+  private static void nation(DataOutputStream output, NationId nation) throws IOException {
+    uuid(output, nation.value());
+  }
+
+  private static NationId nation(DataInputStream input) throws IOException {
+    return NationId.of(uuid(input));
+  }
+
+  private static void uuid(DataOutputStream output, UUID value) throws IOException {
+    output.writeLong(value.getMostSignificantBits());
+    output.writeLong(value.getLeastSignificantBits());
+  }
+
+  private static UUID uuid(DataInputStream input) throws IOException {
+    return new UUID(input.readLong(), input.readLong());
+  }
+
+  private static void time(DataOutputStream output, Instant time) throws IOException {
+    output.writeLong(time.getEpochSecond());
+    output.writeInt(time.getNano());
+  }
+
+  private static Instant time(DataInputStream input) throws IOException {
+    long seconds = input.readLong();
+    int nanos = input.readInt();
+    if (nanos < 0 || nanos >= 1000000000)
+      throw new IllegalArgumentException("Noncanonical treaty timestamp");
+    return Instant.ofEpochSecond(seconds, nanos);
+  }
+
+  private static int count(DataInputStream input, int maximum) throws IOException {
+    int value = input.readInt();
+    if (value < 0 || value > maximum)
+      throw new IllegalArgumentException("Invalid treaty manifest count");
+    return value;
+  }
+
+  private static DataInputStream input(String encoded) {
+    Objects.requireNonNull(encoded);
+    if (encoded.length() > (MAX_BYTES + 2) / 3 * 4)
+      throw new IllegalArgumentException("Treaty manifest encoding is too large");
+    var decoded = Base64.getDecoder().decode(encoded);
+    if (decoded.length > MAX_BYTES)
+      throw new IllegalArgumentException("Treaty manifest encoding is too large");
+    return new DataInputStream(new ByteArrayInputStream(decoded));
+  }
+
+  private interface Writer {
+    void write(DataOutputStream output) throws IOException;
+  }
+
+  private static byte[] bytes(Writer writer) {
+    try {
+      var bytes = new ByteArrayOutputStream();
+      try (var output = new DataOutputStream(bytes)) {
+        writer.write(output);
+      }
+      if (bytes.size() > MAX_BYTES)
+        throw new IllegalArgumentException("Treaty manifest encoding is too large");
+      return bytes.toByteArray();
+    } catch (IOException failure) {
+      throw new IllegalArgumentException("Unable to encode treaty manifest", failure);
+    }
+  }
+
+  private static String hash(byte[] value) {
+    try {
+      return HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256").digest(value));
+    } catch (NoSuchAlgorithmException failure) {
+      throw new IllegalStateException(failure);
+    }
+  }
+
+  private static void requireHash(String value) {
+    if (value == null || !value.matches("[0-9a-f]{64}"))
+      throw new IllegalArgumentException("Invalid treaty manifest hash");
+  }
+
+  private static void requireText(String value, int maximum) {
+    if (value == null || value.length() > maximum)
+      throw new IllegalArgumentException("Invalid original treaty text");
+  }
+
+  private static void requireSize(List<String> payload, int size) {
+    if (payload.size() != size)
+      throw new IllegalArgumentException("Incomplete original treaty payload");
+  }
+
+  private static void requireInteger(String value, int minimum) {
+    int parsed = Integer.parseInt(value);
+    if (parsed < minimum || !Integer.toString(parsed).equals(value))
+      throw new IllegalArgumentException("Invalid original treaty integer");
+  }
+}
