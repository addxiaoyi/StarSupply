+            original.nationId(),
+            original.type(),
+            original.soldiers(),
+            original.health(),
+            original.morale(),
+            original.position(),
+            original.state(),
+            original.supply(),
+            original.supplyConsumptionRemainder(),
+            ACCEPTED,
+            ACCEPTED);
+    return new ArmyPaidRequest(
+        OPERATION,
+        ACTOR,
+        ArmyPaidRequest.Kind.CREATE,
+        null,
+        candidate,
+        new BigDecimal("10.00"),
+        ACCEPTED,
