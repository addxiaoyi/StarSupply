+  private static void removeVersionedFields(com.google.gson.JsonElement element) {
+    if (element.isJsonObject()) {
+      var object = element.getAsJsonObject();
+      for (String field :
+          List.of(
+              "protocolVersion",
+              "envelope",
+              "assignedTermIndexes",
+              "manifest",
+              "binding",
+              "terminalEvidence")) object.remove(field);
+      for (var entry : object.entrySet()) removeVersionedFields(entry.getValue());
+    } else if (element.isJsonArray()) {
+      for (var value : element.getAsJsonArray()) removeVersionedFields(value);
+    }
+  }
