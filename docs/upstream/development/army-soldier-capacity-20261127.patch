+  @Test
+  void closeWaitsForAdmittedCallbackOnIndependentMonitorAndRejectsLaterCallbacks()
+      throws Exception {
+    var fixture = repaymentFixture();
+    Object lifecycleLock = fieldValue(fixture.listener(), "lifecycleLock");
+    assertThat(lifecycleLock).isNotSameAs(fixture.module());
+    var entered = new CountDownLatch(1);
+    var release = new CountDownLatch(1);
+    var closing = new CountDownLatch(1);
+    var closed = new CountDownLatch(1);
+    var mutations = new AtomicInteger();
+    var completionOrder = new ConcurrentLinkedQueue<String>();
+    var executor = newExecutor(2);
+    Consumer<String> callback =
+        input -> {
+          assertThat(Thread.holdsLock(lifecycleLock)).isTrue();
+          assertThat(Thread.holdsLock(fixture.module())).isFalse();
+          entered.countDown();
+          try {
+            if (!release.await(5, TimeUnit.SECONDS))
+              throw new AssertionError("Callback release timed out");
+          } catch (InterruptedException exception) {
+            Thread.currentThread().interrupt();
+            throw new AssertionError(exception);
+          }
+          mutations.incrementAndGet();
+          completionOrder.add("callback");
+        };
+    try (var support = mockStatic(BookInputSupport.class)) {
+      var open =
+          TreasuryMenuListener.class.getDeclaredMethod(
+              "openBookInput", Player.class, String.class, NationPermission.class, Consumer.class);
+      open.setAccessible(true);
+      open.invoke(
+          fixture.listener(), fixture.player(), "Amount", NationPermission.BANK_WITHDRAW, callback);
+      Consumer<String> guarded = pendingInput(fixture.listener(), fixture.playerId());
+      var submission = executor.submit(() -> guarded.accept("10"));
+      assertThat(entered.await(5, TimeUnit.SECONDS)).isTrue();
+      var shutdown =
+          executor.submit(
+              () -> {
+                closing.countDown();
+                fixture.listener().close();
+                completionOrder.add("close");
+                closed.countDown();
+              });
+      assertThat(closing.await(5, TimeUnit.SECONDS)).isTrue();
+      assertThat(closed.await(100, TimeUnit.MILLISECONDS)).isFalse();
+      release.countDown();
+      submission.get(5, TimeUnit.SECONDS);
+      shutdown.get(5, TimeUnit.SECONDS);
+      assertThat(completionOrder).containsExactly("callback", "close");
+      guarded.accept("20");
+      assertThat(mutations.get()).isEqualTo(1);
+    } finally {
+      release.countDown();
+      executor.shutdownNow();
+      assertThat(executor.awaitTermination(5, TimeUnit.SECONDS)).isTrue();
+    }
+  }
