+                                tx, NationDisbandOperation.State.CLEANUP_PENDING)))))
+        .hasStackTraceContaining("requires original admission receipt");
+    assertThat(store.load()).isEqualTo(pending);
+    assertThat(f.coordinator().recover(tx.transactionId()).state())
+        .isEqualTo(NationDisbandOperation.State.COMPLETED);
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void fileToSqlMigrationPreservesPendingAndTerminalHistory(boolean completed) {
+    var f = fixture(false);
+    var tx = request();
+    if (completed) f.coordinator().disband(tx);
+    else
+      assertThatThrownBy(
+          () ->
+              coordinator(
+                      f.storage(),
+                      ignored -> {
+                        throw new IllegalStateException("interrupted");
+                      })
+                  .disband(tx));
+    var before = f.storage().load();
+    var migrated = new SqlNationStateStorage(f.ds(), before, Logger.getAnonymousLogger());
+    assertThat(migrated.load()).isEqualTo(before);
+    coordinator(migrated, f::cleanup).recover(tx.transactionId());
+    var restarted =
+        new SqlNationStateStorage(
+            f.ds(),
+            NationStateCodec.toProperties(List.of(root, child, kept)),
+            Logger.getAnonymousLogger());
+    assertThat(
+            NationStateCodec.snapshot(restarted.load()).disbands().get(tx.transactionId()).state())
+        .isEqualTo(NationDisbandOperation.State.COMPLETED);
+    assertThat(NationStateCodec.snapshot(restarted.load()).nations()).hasSize(1);
