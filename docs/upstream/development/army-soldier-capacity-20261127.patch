+      assertEquals(30, commander.getSkillCooldown(player.getUniqueId(), SkillType.REINFORCE));
+      commander.useSkill(player, SkillType.REINFORCE, army.token().armyId());
+      assertEquals(130, f.current(army.token().armyId()).soldiers());
+      assertEquals(1, f.owner.snapshot().skillUses().size());
+    }
+  }
+
+  @ParameterizedTest
