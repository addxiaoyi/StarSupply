+
+  @ParameterizedTest
+  @ValueSource(
+      strings = {
+        "epoch",
+        "beforeEpoch",
+        "capacity",
+        "operation",
+        "actor",
+        "kind",
+        "after",
+        "amount",
+        "accepted"
+      })
+  void invalidIdentityCapacityAndAcceptanceFactsAreRejected(String field) {
+    Instant accepted =
+        field.equals("epoch")
+            ? Instant.EPOCH
+            : field.equals("beforeEpoch") ? Instant.EPOCH.minusNanos(1) : ACCEPTED;
+    ArmySnapshot after = field.equals("after") ? null : createdAt(accepted);
+
+    assertThrows(
+        RuntimeException.class,
+        () ->
+            new ArmyPaidRequest(
+                field.equals("operation") ? null : OPERATION_ID,
+                field.equals("actor") ? null : ACTOR_ID,
+                field.equals("kind") ? null : ArmyPaidRequest.Kind.CREATE,
