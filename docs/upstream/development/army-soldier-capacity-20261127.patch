+    var request = create(after, AMOUNT);
+
+    assertNull(request.before());
+    assertSame(after, request.after());
+    assertEquals(ARMY_ID, request.armyId());
+    assertEquals(NATION_ID, request.nationId());
+    assertTrue(request.requestDigest().matches("[0-9a-f]{64}"));
+    assertEquals(request.requestDigest(), request.requestDigest());
+    assertEquals(
+        new NationDebitService.Request(
+            OPERATION_ID,
+            new NationId(NATION_ID),
+            AMOUNT,
+            "army-paid:v1:" + request.requestDigest()),
+        request.debitRequest());
+  }
+
+  @ParameterizedTest
