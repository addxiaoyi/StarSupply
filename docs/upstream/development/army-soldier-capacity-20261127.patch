+  @Test
+  void forgedRetirementReasonIsRejectedEvenWhenItsOuterTombstoneMatches() throws Exception {
+    var retired = retired();
+    var properties =
+        ArmyAuthorityCodec.encode(
+            image(Map.of(), retired.retirements(), Map.of(NATION_ID, retired), 5));
+    var original = retired.retirements().get(FIRST_ARMY_ID);
