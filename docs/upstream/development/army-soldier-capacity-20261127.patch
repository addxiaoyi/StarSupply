+  private static ReleaseReceipt release(JsonObject json) {
+    var request = new ReleaseRequest(uuid(json, "operationId"), text(json, "planHash"));
+    var status = TerminalStatus.valueOf(text(json, "status"));
+    if (!json.has("protocolVersion") && !json.has("effectProofs"))
+      return new ReleaseReceipt(request, status);
+    int version = Math.toIntExact(number(json, "protocolVersion"));
+    if (version != TreatyEffectManifest.VERSION || !json.has("effectProofs"))
+      throw new IllegalArgumentException("Invalid explicit settlement release version");
+    var proofs = new ArrayList<EffectProof>();
+    var values = json.getAsJsonArray("effectProofs");
+    if (values.size() == 0 || values.size() > 8)
+      throw new IllegalArgumentException("Invalid settlement release proof count");
+    for (var proof : values) proofs.add(WarSettlementEffectProofCodec.decode(proof.getAsString()));
