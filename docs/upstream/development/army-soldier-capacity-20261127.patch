@@ -0,0 +1,323 @@
+package dev.starcore.starcore.module.war;
+
+import dev.starcore.starcore.module.diplomacy.DiplomacyTreatyOperationService.ExactWar;
+import dev.starcore.starcore.module.diplomacy.DiplomacyTreatyOperationService.PairScope;
+import dev.starcore.starcore.module.diplomacy.WarDiplomacyMirrorService.WarEntry;
+import dev.starcore.starcore.module.nation.model.NationId;
+import dev.starcore.starcore.module.war.WarSettlementAdmissionService.CancellationReceipt;
+import dev.starcore.starcore.module.war.WarSettlementAdmissionService.EndReceipt;
+import dev.starcore.starcore.module.war.WarSettlementAdmissionService.Request;
+import dev.starcore.starcore.module.war.WarSettlementEffectProofReader.EffectProof;
+import dev.starcore.starcore.module.war.WarSettlementEffectProofReader.Phase;
+import dev.starcore.starcore.module.war.WarSettlementEffectProofReader.TerminalBasis;
+import dev.starcore.starcore.module.war.WarSettlementEffectProofReader.TerminalEvidence;
+import dev.starcore.starcore.treaty.TreatyEffectManifest;
+import dev.starcore.starcore.treaty.TreatyEffectManifest.Entry;
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.DataInputStream;
+import java.io.DataOutputStream;
+import java.io.IOException;
+import java.io.OutputStream;
+import java.nio.ByteBuffer;
+import java.nio.charset.CodingErrorAction;
+import java.nio.charset.StandardCharsets;
+import java.time.DateTimeException;
+import java.time.Instant;
+import java.util.ArrayList;
+import java.util.Base64;
+import java.util.List;
+import java.util.Objects;
+import java.util.UUID;
+
+public final class WarSettlementEffectProofCodec {
+  public static final int MAX_DECODED_BYTES = 8 * 1024 * 1024;
+  public static final int MAX_ENCODED_LENGTH = (MAX_DECODED_BYTES + 2) / 3 * 4;
+  private static final int MAX_MANIFEST_TEXT_BYTES = (2 * 1024 * 1024 + 2) / 3 * 4;
+  private static final String DOMAIN = "starcore:war:settlement-effect-proof:v2";
+
+  private WarSettlementEffectProofCodec() {}
+
+  public static String encode(EffectProof proof) {
+    Objects.requireNonNull(proof);
+    int encodedLength = encodedLength(proof);
+    try {
+      var bytes = new ByteArrayOutputStream(encodedLength / 4 * 3);
+      try (var output = new DataOutputStream(bytes)) {
+        write(output, proof);
+      }
+      return Base64.getEncoder().encodeToString(bytes.toByteArray());
+    } catch (IOException failure) {
+      throw new IllegalArgumentException("Unable to encode settlement effect proof", failure);
+    }
+  }
+
+  public static int encodedLength(EffectProof proof) {
+    Objects.requireNonNull(proof);
+    var counter = new Counter();
+    try (var output = new DataOutputStream(counter)) {
+      write(output, proof);
+      return Math.toIntExact(Math.multiplyExact((counter.count + 2) / 3, 4));
+    } catch (IOException failure) {
+      throw new IllegalArgumentException("Settlement effect proof is too large", failure);
+    }
+  }
+
+  private static void write(DataOutputStream output, EffectProof proof) throws IOException {
+    text(output, DOMAIN, 64);
+    output.writeInt(TreatyEffectManifest.VERSION);
+    request(output, proof.binding());
+    entry(output, proof.entry());
+    text(output, proof.phase().name(), 32);
+    output.writeBoolean(proof.terminalAt() != null);
+    if (proof.terminalAt() != null) time(output, proof.terminalAt());
+    output.writeBoolean(proof.terminalEvidence() != null);
+    if (proof.terminalEvidence() != null) evidence(output, proof.terminalEvidence());
+  }
+
+  public static EffectProof decode(String encoded) {
+    Objects.requireNonNull(encoded);
+    if (encoded.length() > MAX_ENCODED_LENGTH || encoded.length() % 4 != 0)
+      throw new IllegalArgumentException(
+          "Settlement effect proof encoding is too large or incomplete");
+    int padding = encoded.endsWith("==") ? 2 : encoded.endsWith("=") ? 1 : 0;
+    long decodedLength = encoded.length() / 4L * 3 - padding;
+    if (decodedLength > MAX_DECODED_BYTES)
+      throw new IllegalArgumentException("Settlement effect proof encoding is too large");
+    byte[] decoded = Base64.getDecoder().decode(encoded);
+    try (var input = new DataInputStream(new ByteArrayInputStream(decoded))) {
+      if (!DOMAIN.equals(text(input, 64)) || input.readInt() != TreatyEffectManifest.VERSION)
+        throw new IllegalArgumentException("Unknown settlement effect proof version");
+      Request binding = request(input);
+      Entry entry = entry(input);
+      Phase phase = Phase.valueOf(text(input, 32));
+      Instant terminalAt = input.readBoolean() ? time(input) : null;
+      TerminalEvidence evidence = input.readBoolean() ? evidence(input) : null;
+      var proof = new EffectProof(binding, entry, phase, terminalAt, evidence);
+      if (input.available() != 0 || !encode(proof).equals(encoded))
+        throw new IllegalArgumentException("Noncanonical settlement effect proof encoding");
+      return proof;
+    } catch (IOException | DateTimeException | ArithmeticException failure) {
+      throw new IllegalArgumentException("Invalid settlement effect proof encoding", failure);
+    }
+  }
+
+  private static void request(DataOutputStream output, Request value) throws IOException {
+    if (value.protocolVersion() != TreatyEffectManifest.VERSION || value.manifest() == null)
+      throw new IllegalArgumentException("Only explicit v2 settlement requests are encodable");
+    output.writeInt(value.protocolVersion());
+    uuid(output, value.operationId());
+    uuid(output, value.treatyId());
+    exactWar(output, value.war());
+    output.writeLong(value.warGeneration());
+    text(output, value.warFingerprint(), 64);
+    scopes(output, value.scopes());
+    text(output, value.planHash(), 64);
+    time(output, value.preparedAt());
+    text(output, TreatyEffectManifest.encodeManifest(value.manifest()), MAX_MANIFEST_TEXT_BYTES);
+  }
+
+  private static Request request(DataInputStream input) throws IOException {
+    int version = input.readInt();
+    if (version != TreatyEffectManifest.VERSION)
+      throw new IllegalArgumentException("Unknown settlement request proof version");
+    UUID operationId = uuid(input);
+    UUID treatyId = uuid(input);
+    ExactWar war = exactWar(input);
+    long generation = input.readLong();
+    String fingerprint = text(input, 64);
+    List<PairScope> scopes = scopes(input);
+    String planHash = text(input, 64);
+    Instant preparedAt = time(input);
+    var manifest = TreatyEffectManifest.decodeManifest(text(input, MAX_MANIFEST_TEXT_BYTES));
+    return new Request(
+        operationId,
+        treatyId,
+        war,
+        generation,
+        fingerprint,
+        scopes,
+        planHash,
+        preparedAt,
+        version,
+        manifest);
+  }
+
+  private static void entry(DataOutputStream output, Entry value) throws IOException {
+    text(output, value.receiverId(), 64);
+    output.writeInt(value.receiverVersion());
+    output.writeInt(value.assignedTermIndexes().size());
+    for (int index : value.assignedTermIndexes()) output.writeInt(index);
+    text(output, value.localPlanHash(), 64);
+    scopes(output, value.scopes());
+  }
+
+  private static Entry entry(DataInputStream input) throws IOException {
+    String receiverId = text(input, 64);
+    int receiverVersion = input.readInt();
+    int size = count(input, TreatyEffectManifest.MAX_TERMS, Integer.BYTES);
+    var indexes = new ArrayList<Integer>(size);
+    for (int index = 0; index < size; index++) indexes.add(input.readInt());
+    return new Entry(receiverId, receiverVersion, indexes, text(input, 64), scopes(input));
+  }
+
+  private static void evidence(DataOutputStream output, TerminalEvidence value) throws IOException {
+    text(output, value.basis().name(), 32);
+    output.writeBoolean(value.endReceipt() != null);
+    if (value.endReceipt() != null) end(output, value.endReceipt());
+    output.writeBoolean(value.cancellationReceipt() != null);
+    if (value.cancellationReceipt() != null) request(output, value.cancellationReceipt().request());
+  }
+
+  private static TerminalEvidence evidence(DataInputStream input) throws IOException {
+    TerminalBasis basis = TerminalBasis.valueOf(text(input, 32));
+    EndReceipt end = input.readBoolean() ? end(input) : null;
+    CancellationReceipt cancellation =
+        input.readBoolean() ? new CancellationReceipt(request(input)) : null;
+    return new TerminalEvidence(basis, end, cancellation);
+  }
+
+  private static void end(DataOutputStream output, EndReceipt value) throws IOException {
+    request(output, value.request());
+    output.writeLong(value.beforeGeneration());
+    output.writeLong(value.afterGeneration());
+    time(output, value.endedAt());
+    output.writeLong(value.endedAuthorityRevision());
+    WarEntry war = value.endedWar();
+    uuid(output, war.warId());
+    nation(output, war.aggressor());
+    nation(output, war.defender());
+    time(output, war.declaredAt());
+    output.writeBoolean(war.active());
+  }
+
+  private static EndReceipt end(DataInputStream input) throws IOException {
+    Request request = request(input);
+    long before = input.readLong();
+    long after = input.readLong();
+    Instant endedAt = time(input);
+    long revision = input.readLong();
+    var war =
+        new WarEntry(uuid(input), nation(input), nation(input), time(input), input.readBoolean());
+    return new EndReceipt(request, before, after, endedAt, revision, war);
+  }
+
+  private static void exactWar(DataOutputStream output, ExactWar value) throws IOException {
+    uuid(output, value.warId());
+    nation(output, value.attacker());
+    nation(output, value.defender());
+    time(output, value.declaredAt());
+    nations(output, value.attackerAllies());
+    nations(output, value.defenderAllies());
+  }
+
+  private static ExactWar exactWar(DataInputStream input) throws IOException {
+    return new ExactWar(
+        uuid(input), nation(input), nation(input), time(input), nations(input), nations(input));
+  }
+
+  private static void scopes(DataOutputStream output, List<PairScope> values) throws IOException {
+    output.writeInt(values.size());
+    for (var scope : values) {
+      nation(output, scope.left());
+      nation(output, scope.right());
+    }
+  }
+
+  private static List<PairScope> scopes(DataInputStream input) throws IOException {
+    int size = count(input, TreatyEffectManifest.MAX_SCOPES, 32);
+    var result = new ArrayList<PairScope>(size);
+    for (int index = 0; index < size; index++)
+      result.add(new PairScope(nation(input), nation(input)));
+    return result;
+  }
+
+  private static void nations(DataOutputStream output, List<NationId> values) throws IOException {
+    output.writeInt(values.size());
+    for (var nation : values) nation(output, nation);
+  }
+
+  private static List<NationId> nations(DataInputStream input) throws IOException {
+    int size = count(input, 90, 16);
+    var result = new ArrayList<NationId>(size);
+    for (int index = 0; index < size; index++) result.add(nation(input));
+    return result;
+  }
+
+  private static void nation(DataOutputStream output, NationId value) throws IOException {
+    uuid(output, value.value());
+  }
+
+  private static NationId nation(DataInputStream input) throws IOException {
+    return NationId.of(uuid(input));
+  }
+
+  private static void uuid(DataOutputStream output, UUID value) throws IOException {
+    output.writeLong(value.getMostSignificantBits());
+    output.writeLong(value.getLeastSignificantBits());
+  }
+
+  private static UUID uuid(DataInputStream input) throws IOException {
+    return new UUID(input.readLong(), input.readLong());
+  }
+
+  private static void time(DataOutputStream output, Instant value) throws IOException {
+    output.writeLong(value.getEpochSecond());
+    output.writeInt(value.getNano());
+  }
+
+  private static Instant time(DataInputStream input) throws IOException {
+    long seconds = input.readLong();
+    int nanos = input.readInt();
+    if (nanos < 0 || nanos >= 1_000_000_000)
+      throw new IllegalArgumentException("Noncanonical settlement effect timestamp");
+    return Instant.ofEpochSecond(seconds, nanos);
+  }
+
+  private static void text(DataOutputStream output, String value, int maximum) throws IOException {
+    byte[] encoded = value.getBytes(StandardCharsets.UTF_8);
+    if (encoded.length > maximum)
+      throw new IllegalArgumentException("Settlement effect proof text is too large");
+    output.writeInt(encoded.length);
+    output.write(encoded);
+  }
+
+  private static String text(DataInputStream input, int maximum) throws IOException {
+    int size = count(input, maximum, 1);
+    byte[] encoded = input.readNBytes(size);
+    return StandardCharsets.UTF_8
+        .newDecoder()
+        .onMalformedInput(CodingErrorAction.REPORT)
+        .onUnmappableCharacter(CodingErrorAction.REPORT)
+        .decode(ByteBuffer.wrap(encoded))
+        .toString();
+  }
+
+  private static int count(DataInputStream input, int maximum, int elementBytes)
+      throws IOException {
+    int count = input.readInt();
+    if (count < 0 || count > maximum || (long) count * elementBytes > input.available())
+      throw new IllegalArgumentException("Invalid or truncated settlement effect proof count");
+    return count;
+  }
+
+  private static final class Counter extends OutputStream {
+    private long count;
+
+    @Override
+    public void write(int value) throws IOException {
+      advance(1);
+    }
+
+    @Override
+    public void write(byte[] bytes, int offset, int length) throws IOException {
+      Objects.checkFromIndexSize(offset, length, bytes.length);
+      advance(length);
+    }
+
+    private void advance(int length) throws IOException {
+      count = Math.addExact(count, length);
+      if (count > MAX_DECODED_BYTES) throw new IOException("Settlement effect proof is too large");
+    }
+  }
+}
