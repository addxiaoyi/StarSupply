diff --git a/src/main/java/dev/starcore/starcore/module/diplomacy/DiplomacyDerivedEventState.java b/src/main/java/dev/starcore/starcore/module/diplomacy/DiplomacyDerivedEventState.java
new file mode 100644
index 0000000000000000000000000000000000000000..f4650b57ea4a0500751ba0e3f0195279682d47ef
--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/module/diplomacy/DiplomacyDerivedEventState.java
@@ -0,0 +1,147 @@
+package dev.starcore.starcore.module.diplomacy;
+
+import dev.starcore.starcore.module.diplomacy.event.AllianceBrokenEvent;
+import dev.starcore.starcore.module.nation.model.NationId;
+import java.time.Instant;
+import java.util.*;
+
+/** Durable, retryable queue for committed alliance side effects. */
+record DiplomacyDerivedEventState(Map<UUID, Entry> pending) {
+  static final String PREFIX = "derived-event.";
+
+  record Entry(
+      UUID eventId,
+      NationId left,
+      NationId right,
+      DiplomacyRelation previous,
+      DiplomacyRelation current,
+      AllianceBrokenEvent.AllianceBreakReason breakReason,
+      Instant createdAt) {
+    Entry {
+      Objects.requireNonNull(eventId);
+      Objects.requireNonNull(left);
+      Objects.requireNonNull(right);
+      Objects.requireNonNull(previous);
+      Objects.requireNonNull(current);
+      Objects.requireNonNull(createdAt);
+      if (left.equals(right)) throw new IllegalArgumentException("Self diplomacy event");
+      if ((current == DiplomacyRelation.ALLIED) == (previous == DiplomacyRelation.ALLIED))
+        throw new IllegalArgumentException("Event must cross the alliance boundary");
+      if (current == DiplomacyRelation.ALLIED && breakReason != null)
+        throw new IllegalArgumentException("Alliance formed event has break reason");
+      if (previous == DiplomacyRelation.ALLIED
+          && current != DiplomacyRelation.ALLIED
+          && breakReason == null)
+        throw new IllegalArgumentException("Alliance broken event requires reason");
+    }
+
+    String encode() {
+      return left
+          + "|"
+          + right
+          + "|"
+          + previous
+          + "|"
+          + current
+          + "|"
+          + (breakReason == null ? "" : breakReason)
+          + "|"
+          + createdAt;
+    }
+
+    static Entry decode(UUID id, String raw) {
+      String[] parts = raw.split("\\|", -1);
+      if (parts.length != 6) throw new IllegalArgumentException("Invalid derived event");
+      var previous = DiplomacyRelation.valueOf(parts[2]);
+      var current = DiplomacyRelation.valueOf(parts[3]);
+      var reason =
+          parts[4].isEmpty() ? null : AllianceBrokenEvent.AllianceBreakReason.valueOf(parts[4]);
+      var entry =
+          new Entry(
+              id,
+              NationId.of(UUID.fromString(parts[0])),
+              NationId.of(UUID.fromString(parts[1])),
+              previous,
+              current,
+              reason,
+              Instant.parse(parts[5]));
+      if (!entry.encode().equals(raw))
+        throw new IllegalArgumentException("Noncanonical derived event");
+      return entry;
+    }
+  }
+
+  DiplomacyDerivedEventState {
+    pending = Map.copyOf(pending);
+    if (pending.size() > 100_000) throw new IllegalArgumentException("Derived event queue full");
+    pending.forEach(
+        (id, entry) -> {
+          if (!id.equals(entry.eventId()))
+            throw new IllegalArgumentException("Derived event id mismatch");
+        });
+  }
+
+  static DiplomacyDerivedEventState empty() {
+    return new DiplomacyDerivedEventState(Map.of());
+  }
+
+  DiplomacyDerivedEventState enqueue(Entry entry) {
+    var next = new HashMap<>(pending);
+    var prior = next.putIfAbsent(entry.eventId(), entry);
+    if (prior != null && !prior.equals(entry))
+      throw new IllegalArgumentException("Conflicting derived event id");
+    return new DiplomacyDerivedEventState(next);
+  }
+
+  DiplomacyDerivedEventState acknowledge(UUID eventId) {
+    var next = new HashMap<>(pending);
+    next.remove(Objects.requireNonNull(eventId));
+    return new DiplomacyDerivedEventState(next);
+  }
+
+  Properties write(Properties source) {
+    var result = DiplomacyAuthority.copy(source);
+    result.keySet().removeIf(k -> k instanceof String key && key.startsWith(PREFIX));
+    var ordered =
+        pending.values().stream()
+            .sorted(Comparator.comparing(e -> e.eventId().toString()))
+            .toList();
+    result.setProperty(PREFIX + "count", Integer.toString(ordered.size()));
+    for (int i = 0; i < ordered.size(); i++) {
+      var e = ordered.get(i);
+      result.setProperty(PREFIX + i + ".id", e.eventId().toString());
+      result.setProperty(PREFIX + i + ".value", e.encode());
+    }
+    return result;
+  }
+
+  static DiplomacyDerivedEventState read(Properties source) {
+    int count = Integer.parseInt(source.getProperty(PREFIX + "count", "0"));
+    if (count < 0 || count > 100_000)
+      throw new IllegalArgumentException("Invalid derived event count");
+    var result = new HashMap<UUID, Entry>();
+    for (int i = 0; i < count; i++) {
+      String idRaw = Objects.requireNonNull(source.getProperty(PREFIX + i + ".id"));
+      String value = Objects.requireNonNull(source.getProperty(PREFIX + i + ".value"));
+      UUID id = UUID.fromString(idRaw);
+      if (!id.toString().equals(idRaw))
+        throw new IllegalArgumentException("Noncanonical derived event id");
+      if (result.put(id, Entry.decode(id, value)) != null)
+        throw new IllegalArgumentException("Duplicate derived event id");
+    }
+    for (String key : source.stringPropertyNames()) {
+      if (!key.startsWith(PREFIX) || key.equals(PREFIX + "count")) continue;
+      String suffix = key.substring(PREFIX.length());
+      int dot = suffix.indexOf('.');
+      if (dot <= 0 || dot == suffix.length() - 1)
+        throw new IllegalArgumentException("Invalid derived event key");
+      int index = Integer.parseInt(suffix.substring(0, dot));
+      if (index < 0 || index >= count || !Integer.toString(index).equals(suffix.substring(0, dot)))
+        throw new IllegalArgumentException("Derived event outside declared count");
+      String field = suffix.substring(dot + 1);
+      if (!field.equals("id") && !field.equals("value"))
+        throw new IllegalArgumentException("Unknown derived event field");
+    }
+    return new DiplomacyDerivedEventState(result);
+  }
+}
