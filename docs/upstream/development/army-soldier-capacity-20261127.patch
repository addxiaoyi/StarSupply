+
+class ArmyRuntimeAuthorizationTest {
+  @TempDir Path root;
+
+  @Test
+  void allPlayerWritesRejectForeignOwnershipAndRemovedMembership() throws Exception {
+    try (var f = new ArmyRuntimeTestFixture(root, false)) {
+      var army = f.add();
+      var enemy = f.add(f.other, 100, 100, 75, 40);
+      var player = f.player(f.other);
+      UUID id = army.token().armyId();
+      var before = f.owner.snapshot();
+      assertThrows(
+          IllegalStateException.class,
+          () ->
+              f.service.createArmy(
+                  player, f.nation.id().value(), ArmyType.INFANTRY, 30, f.location()));
+      assertThrows(IllegalStateException.class, () -> f.service.disbandArmy(player, id));
+      assertThrows(IllegalStateException.class, () -> f.service.resupplyArmy(player, id));
+      assertThrows(IllegalStateException.class, () -> f.service.moveArmy(player, id, f.location()));
+      assertThrows(
+          IllegalStateException.class,
+          () -> f.service.setArmyState(player, id, ArmyState.DEFENDING));
+      assertThrows(
+          IllegalStateException.class, () -> f.service.attack(player, id, enemy.token().armyId()));
+      assertEquals(before, f.owner.snapshot());
+      var founder = f.player(f.nation);
+      f.catalog.remove(f.nation.id());
+      assertThrows(
+          IllegalStateException.class, () -> f.service.moveArmy(founder, id, f.location()));
+      assertEquals(0, f.debitApplies);
+    }
+  }
+
+  @Test
+  void ordinaryNationMemberCannotUseCommanderOrArmyMutationPrivileges() throws Exception {
+    try (var f = new ArmyRuntimeTestFixture(root, false)) {
+      var army = f.add();
+      var player = f.player(f.nation);
+      UUID member = UUID.randomUUID();
+      f.nation.addMember(member, "Member");
+      when(player.getUniqueId()).thenReturn(member);
+      assertThrows(
+          IllegalStateException.class,
+          () -> f.service.moveArmy(player, army.token().armyId(), f.location()));
+      assertThrows(
+          IllegalStateException.class,
+          () ->
+              f.service.useCommanderSkill(
+                  player,
+                  dev.starcore.starcore.module.army.commander.model.SkillType.INSPIRE,
+                  3,
+                  null));
+      assertTrue(f.owner.snapshot().skillUses().isEmpty());
+    }
+  }
+
+  @Test
+  void matchingPendingCreateRetriesOriginalDebitInsteadOfCreatingSecondArmy() throws Exception {
+    try (var f = new ArmyRuntimeTestFixture(root, false)) {
+      f.lostDebitResponse = true;
+      assertThrows(
+          IllegalStateException.class,
+          () -> f.service.createArmy(f.nation.id().value(), ArmyType.INFANTRY, 30, f.location()));
+      var original = f.lastPaid().request();
+      assertThrows(
+          IllegalStateException.class,
+          () -> f.service.createArmy(f.nation.id().value(), ArmyType.INFANTRY, 40, f.location()));
+      var army = f.service.createArmy(f.nation.id().value(), ArmyType.INFANTRY, 30, f.location());
+      assertEquals(original.armyId(), army.id());
+      assertEquals(1, f.debitApplies);
+      assertEquals(1, f.owner.snapshot().paidOperations().size());
+    }
+  }
+
+  @Test
+  void matchingPendingResupplyRetriesOriginalDebit() throws Exception {
+    try (var f = new ArmyRuntimeTestFixture(root, false)) {
+      var army = f.add();
+      f.lostDebitResponse = true;
+      assertThrows(
+          IllegalStateException.class, () -> f.service.resupplyArmy(army.token().armyId()));
+      var original = f.lastPaid().request();
+      f.service.resupplyArmy(army.token().armyId());
+      assertEquals(1, f.debitApplies);
+      assertEquals(1, f.owner.snapshot().paidOperations().size());
+      assertEquals(original.after(), f.current(army.token().armyId()));
+    }
+  }
+
+  @Test
+  void adminRecoveryCommandRetainsOriginalIdAndRejectsUnauthorizedConsole() throws Exception {
+    try (var f = new ArmyRuntimeTestFixture(root, false)) {
+      f.failDebit = true;
+      assertThrows(
+          IllegalStateException.class,
+          () -> f.service.createArmy(f.nation.id().value(), ArmyType.INFANTRY, 30, f.location()));
+      UUID id = f.lastPaid().request().operationId();
+      var command = new ArmyCommand(f.service, f.nations, mock(MessageService.class));
+      var sender = mock(CommandSender.class);
+      command.onCommand(
+          sender, mock(Command.class), "army", new String[] {"recovery", "cancel", id.toString()});
+      assertTrue(f.lastPaid().pending());
+      when(sender.hasPermission("starcore.admin")).thenReturn(true);
+      command.onCommand(
+          sender, mock(Command.class), "army", new String[] {"recovery", "show", id.toString()});
+      assertTrue(f.lastPaid().pending());
+      command.onCommand(
+          sender, mock(Command.class), "army", new String[] {"recovery", "cancel", id.toString()});
+      assertFalse(f.lastPaid().pending());
+      assertFalse(f.lastPaid().applied());
+      assertEquals(id, f.lastPaid().request().operationId());
+      assertEquals(1, f.debitApplies);
+    }
+  }
+}
