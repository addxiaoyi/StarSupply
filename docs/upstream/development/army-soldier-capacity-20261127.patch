+      TransactionRecord transaction,
+      Map<String, byte[]> entries,
+      List<String> errors) {
+    Map<String, Object> manifest = new LinkedHashMap<>();
+    manifest.put("schemaVersion", SCHEMA_VERSION);
+    manifest.put("generatedAt", Instant.now().toString());
+    manifest.put("transactionId", transactionId.toString());
+    manifest.put("owner", transaction.owner().name());
+    manifest.put("type", transaction.type().name());
+    List<Map<String, Object>> files = new ArrayList<>();
+    entries.entrySet().stream()
+        .sorted(Map.Entry.comparingByKey())
+        .forEach(
+            entry -> {
+              Map<String, Object> file = new LinkedHashMap<>();
+              file.put("name", entry.getKey());
+              file.put("bytes", entry.getValue().length);
+              file.put("sha256", sha256(entry.getValue()));
