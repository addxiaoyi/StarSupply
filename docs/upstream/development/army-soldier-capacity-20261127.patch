+package dev.starcore.starcore.foundation.gui;
+
+import dev.starcore.starcore.core.scheduler.CompatScheduler;
+import java.time.Duration;
+import java.util.Map;
+import java.util.Objects;
+import java.util.UUID;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.atomic.AtomicBoolean;
+import java.util.function.BiConsumer;
+import java.util.function.BooleanSupplier;
+import java.util.function.Consumer;
+import java.util.function.LongSupplier;
+import org.bukkit.entity.Player;
+import org.bukkit.event.EventHandler;
+import org.bukkit.event.HandlerList;
+import org.bukkit.event.Listener;
+import org.bukkit.event.player.PlayerQuitEvent;
+import org.bukkit.event.server.PluginDisableEvent;
+import org.bukkit.plugin.Plugin;
+import org.bukkit.scheduler.BukkitTask;
+
+final class NativeTextInput implements AutoCloseable, Listener {
+  static final Duration LIFETIME = Duration.ofMinutes(5);
+
+  record Prompt(String title, String initial, int maxLength) {
+    Prompt {
+      Objects.requireNonNull(title);
+      Objects.requireNonNull(initial);
+      if (maxLength < 1 || initial.length() > maxLength) {
+        throw new IllegalArgumentException("Invalid text input length");
+      }
+    }
+  }
+
+  interface View {
+    void show(
+        Player player, Prompt prompt, BiConsumer<Player, String> submit, Consumer<Player> cancel);
+  }
+
+  interface Dispatcher {
+    void execute(Player player, Runnable action, Runnable retired);
+  }
+
+  private static final class Session {
+    final Player player;
+    final long started;
+    final BooleanSupplier active;
+    final AtomicBoolean consumed = new AtomicBoolean();
+
+    Session(Player player, long started, BooleanSupplier active) {
+      this.player = player;
+      this.started = started;
+      this.active = active;
+    }
+  }
+
+  private final Plugin plugin;
+  private final View view;
+  private final Dispatcher dispatcher;
+  private final LongSupplier clock;
+  private final Map<UUID, Session> sessions = new ConcurrentHashMap<>();
+  private final Object publication = new Object();
+  private BukkitTask expiryTask;
+  private volatile boolean stopped;
+
+  NativeTextInput(Plugin plugin) {
+    this(
+        plugin,
+        new PaperTextDialog(),
+        (player, action, retired) -> CompatScheduler.entity(plugin, player, action, retired),
+        System::nanoTime);
+    plugin.getServer().getPluginManager().registerEvents(this, plugin);
+    try {
+      expiryTask = CompatScheduler.globalTimer(plugin, this::discardExpired, 1200, 1200);
+    } catch (RuntimeException | LinkageError failure) {
+      close();
+      try {
+        HandlerList.unregisterAll(this);
+      } catch (RuntimeException | LinkageError cleanupFailure) {
+        if (cleanupFailure != failure) failure.addSuppressed(cleanupFailure);
+      }
+      throw failure;
+    }
+  }
+
+  NativeTextInput(Plugin plugin, View view, Dispatcher dispatcher, LongSupplier clock) {
+    this.plugin = Objects.requireNonNull(plugin);
+    this.view = Objects.requireNonNull(view);
+    this.dispatcher = Objects.requireNonNull(dispatcher);
+    this.clock = Objects.requireNonNull(clock);
+  }
+
+  void open(Player player, Prompt prompt, Consumer<String> submit, Runnable cancel) {
+    open(player, prompt, () -> true, submit, cancel);
+  }
+
+  void open(
+      Player player,
+      Prompt prompt,
+      BooleanSupplier active,
+      Consumer<String> submit,
+      Runnable cancel) {
+    Objects.requireNonNull(player);
+    Objects.requireNonNull(prompt);
+    Objects.requireNonNull(submit);
+    Objects.requireNonNull(cancel);
+    Objects.requireNonNull(active);
+    final Session session;
+    synchronized (publication) {
+      if (stopped || !plugin.isEnabled()) throw new IllegalStateException("Text input stopped");
+      discardExpired();
+      session = new Session(player, clock.getAsLong(), active);
+      sessions.put(player.getUniqueId(), session);
+    }
+    try {
+      dispatcher.execute(
+          player,
+          () -> {
+            synchronized (publication) {
+              if (!current(session, player) || !player.isOnline() || !active(session)) {
+                sessions.remove(player.getUniqueId(), session);
+                return;
+              }
+              try {
+                view.show(
+                    player,
+                    prompt,
+                    (actor, text) ->
+                        respond(
+                            session,
+                            actor,
+                            () -> {
+                              if (text == null || text.length() > prompt.maxLength()) cancel.run();
+                              else submit.accept(text);
+                            }),
+                    actor -> respond(session, actor, cancel));
+              } catch (RuntimeException | LinkageError failure) {
+                sessions.remove(player.getUniqueId(), session);
+                throw failure;
+              }
+            }
+          },
+          () -> sessions.remove(player.getUniqueId(), session));
+    } catch (RuntimeException failure) {
+      sessions.remove(player.getUniqueId(), session);
+      throw failure;
+    }
+  }
+
+  private boolean current(Session session, Player actor) {
+    return !stopped
+        && plugin.isEnabled()
+        && session.player == actor
+        && sessions.get(actor.getUniqueId()) == session
+        && clock.getAsLong() - session.started < LIFETIME.toNanos();
+  }
+
+  private boolean active(Session session) {
+    try {
+      return session.active.getAsBoolean();
+    } catch (RuntimeException failure) {
+      return false;
+    }
+  }
+
+  private void respond(Session session, Player actor, Runnable callback) {
+    if (!current(session, actor) || !session.consumed.compareAndSet(false, true)) return;
+    try {
+      dispatcher.execute(
+          actor,
+          () -> {
+            synchronized (publication) {
+              if (!current(session, actor) || !actor.isOnline() || !active(session)) {
+                sessions.remove(actor.getUniqueId(), session);
+                return;
+              }
+              if (sessions.remove(actor.getUniqueId(), session)) callback.run();
+            }
+          },
+          () -> sessions.remove(actor.getUniqueId(), session));
+    } catch (RuntimeException failure) {
+      sessions.remove(actor.getUniqueId(), session);
+      throw failure;
+    }
+  }
+
+  private void discardExpired() {
+    sessions
+        .values()
+        .removeIf(session -> clock.getAsLong() - session.started >= LIFETIME.toNanos());
+  }
+
+  void cancel(Player player) {
+    sessions.computeIfPresent(
+        player.getUniqueId(), (id, session) -> session.player == player ? null : session);
+  }
+
+  boolean isStopped() {
+    return stopped;
+  }
+
+  @EventHandler
+  public void onQuit(PlayerQuitEvent event) {
+    cancel(event.getPlayer());
+  }
+
+  @EventHandler
+  public void onDisable(PluginDisableEvent event) {
+    if (event.getPlugin() == plugin) close();
+  }
+
+  public void close() {
+    synchronized (publication) {
+      stopped = true;
+      sessions.clear();
+      if (expiryTask != null) expiryTask.cancel();
+      expiryTask = null;
+    }
+  }
+}
