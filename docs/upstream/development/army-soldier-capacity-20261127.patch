diff --git a/src/main/java/dev/starcore/starcore/module/army/model/authority/ArmyMigrationEvidence.java b/src/main/java/dev/starcore/starcore/module/army/model/authority/ArmyMigrationEvidence.java
new file mode 100644
index 0000000000000000000000000000000000000000..3fb487801202a8bfb16ef1aed56f1951282aed29
--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/module/army/model/authority/ArmyMigrationEvidence.java
@@ -0,0 +1,78 @@
+package dev.starcore.starcore.module.army.model.authority;
+
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.util.Base64;
+import java.util.HexFormat;
+import java.util.Map;
+import java.util.Objects;
+
+public record ArmyMigrationEvidence(
+    String sourceSha256, Map<String, String> rawRecords, Map<String, String> inferences) {
+  public static final String SOURCE_PAYLOAD_BASE64 = "legacy.sourcePayloadBase64";
+  public static final String SOURCE_DESCRIPTOR = "legacy.sourceDescriptor";
+  public static final int MAX_SOURCE_BYTES = 8 * 1024 * 1024;
+
+  public ArmyMigrationEvidence {
+    Objects.requireNonNull(sourceSha256, "sourceSha256");
+    if (!sourceSha256.matches("[0-9a-f]{64}")) {
+      throw new IllegalArgumentException("Migration source hash must be canonical SHA-256");
+    }
+    rawRecords = Map.copyOf(Objects.requireNonNull(rawRecords, "rawRecords"));
+    inferences = Map.copyOf(Objects.requireNonNull(inferences, "inferences"));
+    String sourcePayload = inferences.get(SOURCE_PAYLOAD_BASE64);
+    if (sourcePayload != null) {
+      byte[] bytes = decodeSourcePayload(sourcePayload, MAX_SOURCE_BYTES);
+      try {
+        String actual =
+            HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256").digest(bytes));
+        if (!actual.equals(sourceSha256)) {
+          throw new IllegalArgumentException("Migration source hash does not match its payload");
+        }
+      } catch (NoSuchAlgorithmException impossible) {
+        throw new IllegalStateException("SHA-256 unavailable", impossible);
+      }
+    }
+  }
+
+  public byte[] sourceBytes() {
+    String payload = inferences.get(SOURCE_PAYLOAD_BASE64);
+    return payload == null ? new byte[0] : decodeSourcePayload(payload, MAX_SOURCE_BYTES);
+  }
+
+  static byte[] decodeSourcePayload(String payload, int byteBudget) {
+    if (byteBudget < 0 || byteBudget > MAX_SOURCE_BYTES) {
+      throw new IllegalArgumentException("Invalid migration source byte budget");
+    }
+    int length = payload.length();
+    if (length > (byteBudget + 2L) / 3 * 4 || length % 4 != 0) {
+      throw new IllegalArgumentException(
+          "Migration source Base64 exceeds its bound or is noncanonical");
+    }
+    int padding = length > 0 && payload.charAt(length - 1) == '=' ? 1 : 0;
+    if (padding == 1 && length > 1 && payload.charAt(length - 2) == '=') padding++;
+    long decodedLength = (long) length / 4 * 3 - padding;
+    if (decodedLength > byteBudget) {
+      throw new IllegalArgumentException("Migration source exceeds its decoded byte bound");
+    }
+    for (int index = 0; index < length - padding; index++) {
+      if (base64Value(payload.charAt(index)) < 0) {
+        throw new IllegalArgumentException("Invalid migration source Base64 character");
+      }
+    }
+    if (padding == 1 && (base64Value(payload.charAt(length - 2)) & 3) != 0
+        || padding == 2 && (base64Value(payload.charAt(length - 3)) & 15) != 0) {
+      throw new IllegalArgumentException("Noncanonical migration source Base64 padding bits");
+    }
+    return Base64.getDecoder().decode(payload);
+  }
+
+  private static int base64Value(char character) {
+    if (character >= 'A' && character <= 'Z') return character - 'A';
+    if (character >= 'a' && character <= 'z') return character - 'a' + 26;
+    if (character >= '0' && character <= '9') return character - '0' + 52;
+    if (character == '+') return 62;
+    if (character == '/') return 63;
+    return -1;
+  }
+}
diff --git a/src/main/java/dev/starcore/starcore/module/army/model/authority/ArmyNationClosure.java b/src/main/java/dev/starcore/starcore/module/army/model/authority/ArmyNationClosure.java
new file mode 100644
index 0000000000000000000000000000000000000000..93a6f1c21549caf50bf638fccc2ba0e23bc59813
--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/module/army/model/authority/ArmyNationClosure.java
@@ -0,0 +1,105 @@
+package dev.starcore.starcore.module.army.model.authority;
+
+import java.time.Instant;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.Objects;
+import java.util.UUID;
+
+public record ArmyNationClosure(
+    UUID operationId,
+    UUID nationId,
+    Instant acceptedAt,
+    Instant retiredAt,
+    Map<UUID, ArmyTombstone> retirements) {
+  public ArmyNationClosure {
+    Objects.requireNonNull(operationId, "operationId");
+    Objects.requireNonNull(nationId, "nationId");
+    Objects.requireNonNull(acceptedAt, "acceptedAt");
+    retirements = Map.copyOf(Objects.requireNonNull(retirements, "retirements"));
+    if (!acceptedAt.isAfter(Instant.EPOCH)) {
+      throw new IllegalArgumentException("Nation closing acceptance must be after the epoch");
+    }
+    if (retiredAt == null) {
+      if (!retirements.isEmpty()) {
+        throw new IllegalArgumentException(
+            "A closing nation cannot already contain retirement effects");
+      }
+    } else {
+      if (retiredAt.isBefore(acceptedAt)) {
+        throw new IllegalArgumentException("Nation retirement cannot precede closing acceptance");
+      }
+      for (var entry : retirements.entrySet()) {
+        var retirement = entry.getValue();
+        if (!entry.getKey().equals(retirement.token().armyId())
+            || !nationId.equals(retirement.nationId())
+            || !operationId.equals(retirement.operationId())
+            || !"nation-retired".equals(retirement.reason())
+            || !retiredAt.equals(retirement.retiredAt())
+            || retirement.createdAt().isAfter(retiredAt)
+            || retirement.token().generation() < 2) {
+          throw new IllegalArgumentException(
+              "Nation retirement requires exact canonical tombstones");
+        }
+      }
+    }
+  }
+
+  public static ArmyNationClosure closing(UUID operationId, UUID nationId, Instant acceptedAt) {
+    return new ArmyNationClosure(operationId, nationId, acceptedAt, null, Map.of());
+  }
+
+  public boolean pending() {
+    return retiredAt == null;
+  }
+
+  public ArmyNationClosure retired(Map<UUID, ArmySnapshot> armies, Instant at) {
+    if (!pending()) throw new IllegalStateException("Nation closure is already retired");
+    Objects.requireNonNull(armies, "armies");
+    Objects.requireNonNull(at, "at");
+    if (at.isBefore(acceptedAt)) {
+      throw new IllegalArgumentException("Nation retirement cannot precede closing acceptance");
+    }
+    Map<UUID, ArmyTombstone> effects = new HashMap<>();
+    for (var entry : armies.entrySet()) {
+      var before = Objects.requireNonNull(entry.getValue(), "army");
+      if (!nationId.equals(before.nationId())) continue;
+      if (!before.isAlive()) {
+        throw new IllegalArgumentException("Nation retirement requires live predecessor snapshots");
+      }
+      if (!Objects.requireNonNull(entry.getKey(), "army ID").equals(before.token().armyId())) {
+        throw new IllegalArgumentException(
+            "Nation retirement army key does not match its snapshot");
+      }
+      if (at.isBefore(before.createdAt()) || at.isBefore(before.lastUpdated())) {
+        throw new IllegalArgumentException("Nation retirement cannot precede an army snapshot");
+      }
+      if (before.token().generation() == Long.MAX_VALUE) {
+        throw new IllegalArgumentException("Nation retirement army has no generation headroom");
+      }
+      var token =
+          new ArmyToken(
+              before.token().armyId(),
+              before.token().incarnation(),
+              before.token().generation() + 1);
+      effects.put(
+          entry.getKey(),
+          new ArmyTombstone(
+              token,
+              nationId,
+              before.type(),
+              before.createdAt(),
+              at,
+              "nation-retired",
+              operationId));
+    }
+    return new ArmyNationClosure(operationId, nationId, acceptedAt, at, effects);
+  }
+
+  public boolean sameRequest(ArmyNationClosure other) {
+    return other != null
+        && operationId.equals(other.operationId())
+        && nationId.equals(other.nationId())
+        && acceptedAt.equals(other.acceptedAt());
+  }
+}
diff --git a/src/main/java/dev/starcore/starcore/module/army/model/authority/ArmyPaidOperation.java b/src/main/java/dev/starcore/starcore/module/army/model/authority/ArmyPaidOperation.java
