+    var envelope =
+        new Envelope(
+            2,
+            UUID.randomUUID(),
+            UUID.randomUUID(),
+            war,
+            1,
+            "a".repeat(64),
+            attacker,
+            defender,
+            AT,
+            originals);
+    var request =
+        new ReserveRequest(
+            envelope.operationId(),
+            envelope.treatyId(),
+            war,
+            1,
+            envelope.warFingerprint(),
+            attacker,
+            defender,
+            AT,
+            termCount,
+            terms,
+            2,
+            envelope,
+            terms.stream().map(IndexedTerm::termIndex).toList());
+    var plan =
+        new Plan(
+            request,
+            List.of(
+                new PairPlan(
+                    PairScope.of(attacker, defender),
+                    DiplomacyRelation.NEUTRAL,
+                    0,
+                    DiplomacyRelation.NEUTRAL)),
+            terms.stream()
+                .map(
+                    term ->
+                        new TermPlan(
+                            term.termIndex(),
+                            UUID.randomUUID(),
+                            AT,
+                            term.requirement(),
+                            term.description(),
+                            defender))
+                .toList(),
+            "b".repeat(64));
+    var batch = PeaceTreatyBatch.prepare(request).reserved(plan);
+    return batch.bound(batch.expectedBinding());
+  }
+
+  private EndReceipt end(PeaceTreatyBatch batch) {
+    var request = batch.binding();
+    return new EndReceipt(
+        request,
+        1,
+        2,
+        AT.plusNanos(1),
+        7,
+        new WarEntry(
+            request.war().warId(),
+            request.war().attacker(),
+            request.war().defender(),
+            request.war().declaredAt(),
+            false));
+  }
+
+  private String source(PeaceTreatyBatch batch) {
+    var request = batch.request();
+    var terms =
+        request.terms().stream()
+            .<PeaceTreaty.PeaceTerm>map(
+                term -> new PeaceTreaty.PoliticalTerm(term.requirement(), term.description()))
+            .toList();
+    var treaty =
+        new PeaceTreaty(
+            request.treatyId(),
+            request.war().warId(),
+            request.victor(),
+            request.defeated(),
+            terms,
+            AT);
+    var execution = PeaceTreatyExecution.create(terms);
+    execution.batch(batch);
+    return new PeaceTreatyStateCodec()
+        .encode(treaty, execution, List.of(), List.of(), List.of(), List.of());
+  }
