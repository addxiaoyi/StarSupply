--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/module/army/storage/authority/ArmyAuthorityBootstrap.java
@@ -0,0 +1,193 @@
+package dev.starcore.starcore.module.army.storage.authority;
+
+import com.google.gson.JsonObject;
+import dev.starcore.starcore.core.persistence.AtomicFilePersistence;
+import dev.starcore.starcore.module.army.model.authority.ArmyAuthoritySnapshot;
+import dev.starcore.starcore.module.army.model.authority.ArmyMigrationEvidence;
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.LinkOption;
+import java.nio.file.NoSuchFileException;
+import java.nio.file.Path;
+import java.nio.file.attribute.BasicFileAttributes;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.util.HexFormat;
+import java.util.Objects;
+
+public final class ArmyAuthorityBootstrap {
+  private ArmyAuthorityBootstrap() {}
+
+  public static ArmyAuthoritySnapshot initialize(ArmyAuthorityStorage storage, Path legacyFile) {
+    Objects.requireNonNull(storage, "storage");
+    var current = storage.load();
+    ArmyAuthorityState.validate(current);
+    if (current.initialized()) return current;
+    if (!current.equals(ArmyAuthoritySnapshot.uninitialized()))
+      throw new IllegalStateException("Army authority is not an uninitialized sentinel");
+
+    var normalized = Objects.requireNonNull(legacyFile, "legacyFile").toAbsolutePath().normalize();
+    LegacySource source;
+    try {
+      source = acquire(normalized);
+    } catch (IOException error) {
+      throw new IllegalStateException(
+          "Cannot acquire exact legacy army source: " + error.getMessage(), error);
+    }
+    var descriptor = descriptor(normalized, source);
+    var imported = ArmyLegacyImporter.inspect(source.bytes(), descriptor);
+    if (!imported.ready())
+      throw new IllegalStateException("Legacy army import is not ready: " + imported.diagnostics());
+    var expected = imported.baseline().orElseThrow().withRevision(1);
+    var confirmed = storage.initializeFromLegacy(imported);
+    ArmyAuthorityState.validate(confirmed);
+    if (!expected.equals(confirmed))
+      throw new IllegalStateException(
+          "Army authority confirmed image differs from legacy baseline");
+    return confirmed;
+  }
+
+  private static LegacySource acquire(Path file) throws IOException {
+    var before = sourceAttributes(file);
+    var backup = AtomicFilePersistence.backup(file);
+    var backupBefore = attributesIfPresent(backup);
+    rejectActiveRecoveryArtifacts(file);
+    if (before == null) {
+      if (backupBefore != null)
+        throw new IOException("Legacy army source requires explicit recovery: " + backup);
+      if (sourceAttributes(file) != null)
+        throw new IOException("Legacy army source changed during acquisition");
+      rejectActiveRecoveryArtifacts(file);
+      if (attributesIfPresent(backup) != null)
+        throw new IOException("Legacy army source changed during acquisition");
+      return new LegacySource(new byte[0], "MISSING", new BackupEvidence(backup, null, null));
+    }
+    if (before.size() > ArmyMigrationEvidence.MAX_SOURCE_BYTES)
+      throw new IOException("Legacy army source exceeds its 8 MiB byte limit");
+    if (backupBefore != null) {
+      if (backupBefore.isSymbolicLink() || !backupBefore.isRegularFile())
+        throw new IOException("Legacy army passive backup is not a regular file: " + backup);
+      if (backupBefore.size() > ArmyMigrationEvidence.MAX_SOURCE_BYTES)
+        throw new IOException("Legacy army passive backup exceeds its 8 MiB byte limit");
+    }
+    var bytes = new byte[Math.toIntExact(before.size())];
+    try (var input = Files.newInputStream(file, LinkOption.NOFOLLOW_LINKS)) {
+      int offset = 0;
+      while (offset < bytes.length) {
+        int count = input.read(bytes, offset, bytes.length - offset);
+        if (count < 0) throw new IOException("Legacy army source changed during acquisition");
+        if (count == 0) continue;
+        offset += count;
+      }
+      if (input.read() != -1)
+        throw new IOException("Legacy army source changed during acquisition");
+    }
+    var backupSha256 = backupBefore == null ? null : backupSha256(backup, backupBefore.size());
+    var after = sourceAttributes(file);
+    var backupAfter = attributesIfPresent(backup);
+    rejectActiveRecoveryArtifacts(file);
+    if (!sameAttributes(before, after) || !sameAttributes(backupBefore, backupAfter))
+      throw new IOException("Legacy army source changed during acquisition");
+    return new LegacySource(
+        bytes,
+        bytes.length == 0 ? "PRESENT_EMPTY" : "PRESENT",
+        new BackupEvidence(
+            backup, backupBefore == null ? null : backupBefore.size(), backupSha256));
+  }
+
+  private static String backupSha256(Path backup, long size) throws IOException {
+    MessageDigest digest;
+    try {
+      digest = MessageDigest.getInstance("SHA-256");
+    } catch (NoSuchAlgorithmException impossible) {
+      throw new IllegalStateException("SHA-256 is unavailable", impossible);
+    }
+    var buffer = new byte[8192];
+    try (var input = Files.newInputStream(backup, LinkOption.NOFOLLOW_LINKS)) {
+      long remaining = size;
+      while (remaining > 0) {
+        int count = input.read(buffer, 0, (int) Math.min(buffer.length, remaining));
+        if (count < 0)
+          throw new IOException("Legacy army passive backup changed during acquisition");
+        if (count == 0) continue;
+        digest.update(buffer, 0, count);
+        remaining -= count;
+      }
+      if (input.read() != -1)
+        throw new IOException("Legacy army passive backup changed during acquisition");
+    }
+    return HexFormat.of().formatHex(digest.digest());
+  }
+
+  private static boolean sameAttributes(BasicFileAttributes before, BasicFileAttributes after) {
+    if (before == null || after == null) return before == after;
+    return before.isRegularFile() == after.isRegularFile()
+        && before.isSymbolicLink() == after.isSymbolicLink()
+        && before.size() == after.size()
+        && before.lastModifiedTime().equals(after.lastModifiedTime())
+        && before.creationTime().equals(after.creationTime())
+        && Objects.equals(before.fileKey(), after.fileKey());
+  }
+
+  private static String descriptor(Path file, LegacySource source) {
+    var descriptor = new JsonObject();
+    descriptor.addProperty("source", "legacy-file");
+    var main = new JsonObject();
+    main.addProperty("path", file.toString());
+    main.addProperty("state", source.presence());
+    main.addProperty(
+        "read", source.presence().equals("MISSING") ? "ABSENT_EMPTY_BYTES" : "EXACT_RAW_BYTES");
+    main.addProperty("properties", "ISO-8859-1");
+    main.addProperty("size", source.bytes().length);
+    descriptor.add("main", main);
+    var backup = new JsonObject();
+    backup.addProperty("path", source.backup().path().toString());
+    backup.addProperty("state", source.backup().size() == null ? "MISSING" : "PRESENT");
+    backup.addProperty("size", source.backup().size());
+    backup.addProperty("sha256", source.backup().sha256());
+    backup.addProperty("policy", "OBSERVED_NOT_IMPORTED");
+    descriptor.add("passiveBackup", backup);
+    return descriptor.toString();
+  }
+
+  private static BasicFileAttributes sourceAttributes(Path file) throws IOException {
+    var cursor = file.getRoot();
+    BasicFileAttributes attributes = null;
+    for (var element : file) {
+      cursor = cursor.resolve(element);
+      attributes = attributesIfPresent(cursor);
+      if (attributes == null) return null;
+      if (attributes.isSymbolicLink())
+        throw new IOException("Legacy army source cannot use symbolic links: " + cursor);
+      if (!cursor.equals(file) && !attributes.isDirectory())
+        throw new IOException("Legacy army source ancestor is not a directory: " + cursor);
+    }
+    if (attributes == null || !attributes.isRegularFile())
+      throw new IOException("Legacy army source is not a regular file: " + file);
+    return attributes;
+  }
+
+  private static BasicFileAttributes attributesIfPresent(Path path) throws IOException {
+    try {
+      return Files.readAttributes(path, BasicFileAttributes.class, LinkOption.NOFOLLOW_LINKS);
+    } catch (NoSuchFileException missing) {
+      return null;
+    }
+  }
+
+  private static void rejectActiveRecoveryArtifacts(Path file) throws IOException {
+    var backup = AtomicFilePersistence.backup(file);
+    for (var artifact :
+        new Path[] {
+          AtomicFilePersistence.temp(file),
+          AtomicFilePersistence.deleteMarker(file),
+          AtomicFilePersistence.temp(backup)
+        })
+      if (attributesIfPresent(artifact) != null)
+        throw new IOException("Legacy army source requires explicit recovery: " + artifact);
+  }
+
+  private record BackupEvidence(Path path, Long size, String sha256) {}
+
+  private record LegacySource(byte[] bytes, String presence, BackupEvidence backup) {}
+}
