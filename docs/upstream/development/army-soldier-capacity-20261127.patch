+              new OperationView(
+                  operation.request(),
+                  operation.plan(),
+                  operation.status(),
+                  operation.terminalAt(),
+                  binding,
+                  null);
+          requireTreatyEffectProofPersistence(activeLifecycle);
+          return storeTreaty(bound, activeLifecycle);
+        });
