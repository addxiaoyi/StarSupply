+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void emptyFirstBootRequiresOneExplicitDurableBaselineAndCannotReimport(boolean sql)
+      throws Exception {
+    var backend = backend(sql);
+    var storage = backend.storage();
+    assertThat(storage.load()).isEqualTo(ArmyAuthoritySnapshot.uninitialized());
+    var imported = ArmyLegacyImporter.inspect(new byte[0], "configured-empty-legacy-source");
+    assertThat(imported.ready()).isTrue();
+    assertThatThrownBy(() -> storage.commit(storage.snapshot(), imported.baseline().orElseThrow()))
+        .hasMessageContaining("explicit initialization");
+    var baseline = storage.initializeFromLegacy(imported);
+    assertThat(baseline.initialized()).isTrue();
+    assertThat(baseline.revision()).isEqualTo(1);
+    assertThat(baseline.armies()).isEmpty();
+    assertThat(backend.storage().load()).isEqualTo(baseline);
+    assertThatThrownBy(() -> storage.initializeFromLegacy(imported))
+        .hasMessageContaining("reimport is forbidden");
+    if (sql)
+      assertThat(Files.exists(backend.directory().resolve("authority.properties"))).isFalse();
+  }
