+            Map.of(),
+            Map.of());
+    var use =
+        ArmySkillUse.completed(
+            request(USE_ID, ACTOR, null, ACCEPTED.plusSeconds(1), Map.of(ARMY_ID, before)));
+    var next =
+        new ArmyAuthoritySnapshot(
+            true,
+            3,
+            use.effects(),
+            Map.of(),
+            Map.of(),
+            migration(),
+            4,
+            previous.paidOperations(),
+            Map.of(),
+            Map.of(USE_ID, use));
+    assertDoesNotThrow(() -> ArmyAuthorityState.validateCommit(previous, next));
+  }
+
+  private static ArmySkillRequest request(
+      UUID operationId,
+      UUID actorId,
+      UUID previous,
+      Instant acceptedAt,
+      Map<UUID, ArmySnapshot> targets) {
+    return new ArmySkillRequest(
+        operationId,
+        actorId,
+        NATION_ID,
+        SkillType.INSPIRE,
+        1,
+        1,
+        previous,
+        acceptedAt,
+        null,
+        targets);
+  }
+
+  private static ArmyAuthoritySnapshot applied(
+      ArmyAuthoritySnapshot before, ArmySkillRequest request) {
+    var use = ArmySkillUse.completed(request);
+    var armies = new HashMap<>(before.armies());
+    var tombstones = new HashMap<>(before.tombstones());
+    use.effects()
+        .forEach(
+            (armyId, effect) -> {
+              if (effect.isAlive()) armies.put(armyId, effect);
+              else {
+                armies.remove(armyId);
+                tombstones.put(armyId, ArmySkillState.defeated(effect, request.operationId()));
+              }
+            });
+    var uses = new HashMap<>(before.skillUses());
+    uses.put(request.operationId(), use);
+    return image(before.revision() + 1, armies, tombstones, uses);
+  }
+
+  private static ArmyAuthoritySnapshot image(
+      long revision,
+      Map<UUID, ArmySnapshot> armies,
+      Map<UUID, ArmyTombstone> tombstones,
+      Map<UUID, ArmySkillUse> uses) {
+    return new ArmyAuthoritySnapshot(
+        true, revision, armies, tombstones, Map.of(), migration(), 4, Map.of(), Map.of(), uses);
+  }
+}
