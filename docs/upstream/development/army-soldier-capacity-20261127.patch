+        source.morale(),
+        source.position(),
+        source.state(),
+        source.supply(),
+        source.supplyConsumptionRemainder(),
+        ACCEPTED.minusSeconds(60),
+        ACCEPTED.minusSeconds(1));
+  }
+
+  private static ArmySnapshot supplied(ArmySnapshot before, int supply, Instant accepted) {
+    return new ArmySnapshot(
+        new ArmyToken(
+            before.token().armyId(), before.token().incarnation(), before.token().generation() + 1),
+        before.nationId(),
+        before.type(),
+        before.soldiers(),
+        before.health(),
+        before.morale(),
+        before.position(),
+        before.state(),
+        supply,
+        before.supplyConsumptionRemainder(),
+        before.createdAt(),
