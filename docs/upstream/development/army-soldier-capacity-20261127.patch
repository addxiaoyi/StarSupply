diff --git a/src/main/java/dev/starcore/starcore/war/PaidWarDeclaration.java b/src/main/java/dev/starcore/starcore/war/PaidWarDeclaration.java
new file mode 100644
index 0000000000000000000000000000000000000000..8e7850eee88468e5c3328fcc558b37bf54152972
--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/war/PaidWarDeclaration.java
@@ -0,0 +1,258 @@
+package dev.starcore.starcore.war;
+
+import com.google.gson.*;
+import dev.starcore.starcore.module.nation.model.NationId;
+import dev.starcore.starcore.module.treasury.NationDebitService;
+import dev.starcore.starcore.module.war.WarDeclarationRecoveryService.*;
+import java.math.BigDecimal;
+import java.time.Instant;
+import java.util.*;
+
+/** Intent and outcome live beside the war, not in a separate overwriteable journal. */
+record PaidWarDeclaration(Receipt receipt, NationDebitService.Receipt debit, String initialWar) {
+  static final String PREFIX = "declaration.";
+  static final String ENFORCED = "paidDeclarations.enforced";
+  private static final Gson GSON = new Gson();
+
+  PaidWarDeclaration {
+    Objects.requireNonNull(receipt);
+    if ((receipt.status() == Status.DECLARED) != (initialWar != null))
+      throw new IllegalArgumentException("Declaration war evidence mismatch");
+    if (receipt.status() == Status.PENDING && debit != null
+        || receipt.cost().signum() == 0 && (debit != null || receipt.status() == Status.REJECTED))
+      throw new IllegalArgumentException("Invalid declaration fee evidence");
+    if (receipt.cost().signum() > 0 && receipt.status() != Status.PENDING) {
+      if (debit == null
+          || !debit.request().equals(debitRequest(receipt))
+          || !switch (receipt.status()) {
+            case DECLARED -> debit.status() == NationDebitService.Status.APPLIED;
+            case CANCELLED -> debit.status() == NationDebitService.Status.CANCELLED;
+            case REJECTED ->
+                debit.status() == NationDebitService.Status.INSUFFICIENT_FUNDS
+                    || debit.status() == NationDebitService.Status.RETIRED;
+            case PENDING -> false;
+          }) throw new IllegalArgumentException("Declaration requires its original debit decision");
+    }
+  }
+
+  static NationDebitService.Request debitRequest(Receipt r) {
+    return new NationDebitService.Request(
+        r.request().operationId(),
+        r.request().aggressor(),
+        r.cost(),
+        "war-declaration:" + r.request().operationId());
+  }
+
+  boolean pending() {
+    return receipt.status() == Status.PENDING;
+  }
+
+  Set<NationId> nations() {
+    return Set.of(receipt.request().aggressor(), receipt.request().defender());
+  }
+
+  static boolean samePair(Request a, Request b) {
+    return Set.of(a.aggressor(), a.defender()).equals(Set.of(b.aggressor(), b.defender()));
+  }
+
+  static boolean pair(Request r, War w) {
+    return Set.of(r.aggressor(), r.defender()).equals(Set.of(w.aggressor(), w.defender()));
+  }
+
+  String encode() {
+    var j = new JsonObject();
+    var r = receipt.request();
+    j.addProperty("actor", r.actorId().toString());
+    j.addProperty("aggressor", r.aggressor().toString());
+    j.addProperty("defender", r.defender().toString());
+    j.addProperty("goal", r.goal().name());
+    j.addProperty("cost", receipt.cost().toPlainString());
+    j.addProperty("requestedAt", receipt.requestedAt().toEpochMilli());
+    j.addProperty("status", receipt.status().name());
+    j.add(
+        "declaredAt",
+        receipt.declaredAt() == null
+            ? JsonNull.INSTANCE
+            : new JsonPrimitive(receipt.declaredAt().toEpochMilli()));
+    if (debit == null) j.add("debit", JsonNull.INSTANCE);
+    else {
+      var d = new JsonObject();
+      d.addProperty("status", debit.status().name());
+      d.addProperty("decidedAt", debit.decidedAt().toEpochMilli());
+      j.add("debit", d);
+    }
+    j.add("initialWar", initialWar == null ? JsonNull.INSTANCE : new JsonPrimitive(initialWar));
+    return j.toString();
+  }
+
+  static Map<UUID, PaidWarDeclaration> operations(Properties p) {
+    var result = new HashMap<UUID, PaidWarDeclaration>();
+    WarAuthority.family(p, PREFIX)
+        .forEach(
+            (id, json) -> {
+              var j = JsonParser.parseString(json).getAsJsonObject();
+              var request =
+                  new Request(
+                      id,
+                      nation(j, "actor"),
+                      nation(j, "aggressor"),
+                      nation(j, "defender"),
+                      WarGoal.valueOf(j.get("goal").getAsString()));
+              var receipt =
+                  new Receipt(
+                      request,
+                      new BigDecimal(j.get("cost").getAsString()),
+                      Instant.ofEpochMilli(j.get("requestedAt").getAsLong()),
+                      Status.valueOf(j.get("status").getAsString()),
+                      j.get("declaredAt").isJsonNull()
+                          ? null
+                          : Instant.ofEpochMilli(j.get("declaredAt").getAsLong()));
+              NationDebitService.Receipt debit = null;
+              if (!j.get("debit").isJsonNull()) {
+                var d = j.getAsJsonObject("debit");
+                debit =
+                    new NationDebitService.Receipt(
+                        debitRequest(receipt),
+                        NationDebitService.Status.valueOf(d.get("status").getAsString()),
+                        Instant.ofEpochMilli(d.get("decidedAt").getAsLong()));
+              }
+              var operation =
+                  new PaidWarDeclaration(
+                      receipt,
+                      debit,
+                      j.get("initialWar").isJsonNull() ? null : j.get("initialWar").getAsString());
+              if (!operation.encode().equals(json))
+                throw new IllegalArgumentException("Noncanonical declaration intent");
+              result.put(id, operation);
+            });
+    return Map.copyOf(result);
+  }
+
+  private static NationId nation(JsonObject j, String key) {
+    return NationId.of(UUID.fromString(j.get(key).getAsString()));
+  }
+
+  static void validate(Properties state, WarAuthority authority) {
+    if (state.containsKey(ENFORCED) && !"1".equals(state.getProperty(ENFORCED)))
+      throw new IllegalArgumentException("Invalid paid declaration protocol marker");
+    var ops = operations(state);
+    var pending = ops.values().stream().filter(PaidWarDeclaration::pending).toList();
+    var fenced = WarDisbandAdmission.reserved(state);
+    var retired = WarAuthority.receipts(state);
+    for (var op : ops.values()) {
+      var r = op.receipt();
+      UUID id = r.warId();
+      if (op.pending()) {
+        if (state.containsKey(WarAuthority.WAR + id)
+            || state.containsKey(WarAuthority.ARCHIVED_WAR + id)
+            || state.containsKey(WarAuthority.DELETED + id))
+          throw new IllegalStateException("Pending declaration war ID already used");
+        if (op.nations().stream().anyMatch(n -> fenced.containsKey(n) || retired.containsKey(n)))
+          throw new IllegalStateException("Pending declaration blocks nation retirement");
+        if (pending.stream()
+            .anyMatch(other -> other != op && samePair(r.request(), other.receipt().request())))
+          throw new IllegalStateException("Conflicting pending declaration pair");
+        for (var e : WarAuthority.family(state, WarAuthority.WAR).entrySet())
+          if (pair(r.request(), authority.decodeWar(e.getKey(), e.getValue()))
+              && authority.decodeWar(e.getKey(), e.getValue()).isActive())
+            throw new IllegalStateException("Pending declaration reserves its pair");
+      } else if (r.status() == Status.REJECTED || r.status() == Status.CANCELLED) {
+        if (state.containsKey(WarAuthority.WAR + id)
+            || state.containsKey(WarAuthority.ARCHIVED_WAR + id)
+            || state.containsKey(WarAuthority.DELETED + id))
+          throw new IllegalStateException("Unpaid declaration cannot create war history");
+      } else if (r.status() == Status.DECLARED) {
+        var initial = authority.decodeWar(id, op.initialWar());
+        String json =
+            state.getProperty(
+                WarAuthority.WAR + id, state.getProperty(WarAuthority.ARCHIVED_WAR + id));
+        if (json == null) throw new IllegalStateException("Declared war history missing");
+        var actual = authority.decodeWar(id, json);
+        if (initial.status() != WarStatus.PREPARATION
+            || !initial.aggressor().equals(r.request().aggressor())
+            || !initial.defender().equals(r.request().defender())
+            || initial.goal() != r.request().goal()
+            || !initial.declaredAt().equals(r.declaredAt())
+            || !actual.aggressor().equals(initial.aggressor())
+            || !actual.defender().equals(initial.defender())
+            || actual.goal() != initial.goal()
+            || !actual.declaredAt().equals(initial.declaredAt()))
+          throw new IllegalArgumentException("Declaration original war changed");
+      }
+    }
+  }
+
+  static void transition(Properties previous, Properties next, WarAuthority authority) {
+    if ("1".equals(previous.getProperty(ENFORCED))) {
+      if (!"1".equals(next.getProperty(ENFORCED)))
+        throw new IllegalArgumentException("Paid declaration protocol cannot be disabled");
+      requirePaidNewWars(previous, next, authority);
+    }
+    var before = operations(previous);
+    var after = operations(next);
+    for (var e : before.entrySet()) {
+      var a = e.getValue();
+      var b = after.get(e.getKey());
+      if (b == null
+          || !a.receipt().request().equals(b.receipt().request())
+          || !a.receipt().cost().equals(b.receipt().cost())
+          || !a.receipt().requestedAt().equals(b.receipt().requestedAt())
+          || !a.pending() && !a.equals(b))
+        throw new IllegalArgumentException("Declaration history is immutable");
+    }
+    validate(next, authority);
+  }
+
+  static void commit(Properties previous, Properties next, WarAuthority authority) {
+    if ("1".equals(next.getProperty(ENFORCED))) requirePaidNewWars(previous, next, authority);
+    var before = operations(previous);
+    var after = operations(next);
+    int changes = 0;
+    var unchanged = new Properties();
+    unchanged.putAll(next);
+    for (var e : after.entrySet())
+      if (!e.getValue().equals(before.get(e.getKey()))) {
+        changes++;
+        var op = e.getValue();
+        var old = before.get(e.getKey());
+        if (old == null) {
+          if (!op.pending())
+            throw new IllegalArgumentException("Declaration must persist its intent first");
+          unchanged.remove(PREFIX + e.getKey());
+        } else {
+          unchanged.setProperty(PREFIX + e.getKey(), old.encode());
+          if (op.receipt().status() == Status.DECLARED) {
+            if (previous.containsKey(WarAuthority.WAR + e.getKey())
+                || previous.containsKey(WarAuthority.DELETED + e.getKey())
+                || !op.initialWar().equals(next.getProperty(WarAuthority.WAR + e.getKey())))
+              throw new IllegalArgumentException(
+                  "Declaration must publish original war with outcome");
+            unchanged.remove(WarAuthority.WAR + e.getKey());
+          }
+        }
+      }
+    if (changes > 1 || changes == 1 && !unchanged.equals(previous))
+      throw new IllegalArgumentException("Declaration commit cannot change unrelated authority");
+  }
+
+  private static void requirePaidNewWars(
+      Properties previous, Properties next, WarAuthority authority) {
+    var declarations = operations(next);
+    for (var id : WarAuthority.family(next, WarAuthority.WAR).keySet())
+      if (!previous.containsKey(WarAuthority.WAR + id)) {
+        var operation = declarations.get(id);
+        if (operation == null || operation.receipt().status() != Status.DECLARED)
+          throw new IllegalStateException("New war requires a paid declaration outcome");
+      } else {
+        var before = authority.decodeWar(id, previous.getProperty(WarAuthority.WAR + id));
+        var after = authority.decodeWar(id, next.getProperty(WarAuthority.WAR + id));
+        if (!before.aggressor().equals(after.aggressor())
+            || !before.defender().equals(after.defender())
+            || before.goal() != after.goal()
+            || !before.declaredAt().equals(after.declaredAt())
+            || before.isEnded() && !after.isEnded())
+          throw new IllegalStateException(
+              "Original war identity and terminal status cannot be changed");
+      }
+  }
+}
