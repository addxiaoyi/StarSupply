+package dev.starcore.starcore.module.army.storage.authority;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.Objects;
+
+public final class ArmyFileAuthorityStorage extends AbstractArmyAuthorityStorage {
+  public ArmyFileAuthorityStorage(Path armyDirectory) {
+    this(armyDirectory, MAX_AUTHORITY_BYTES);
+  }
+
+  ArmyFileAuthorityStorage(Path armyDirectory, long maximumAuthorityBytes) {
+    super(authorityPath(armyDirectory), null, maximumAuthorityBytes);
+  }
+
+  private static Path authorityPath(Path armyDirectory) {
+    var directory =
+        Objects.requireNonNull(armyDirectory, "armyDirectory").toAbsolutePath().normalize();
+    try {
+      Files.createDirectories(directory);
+    } catch (IOException error) {
+      throw new IllegalStateException("Army authority directory is unavailable", error);
+    }
+    return directory.resolve("authority.properties");
+  }
+}
diff --git a/src/main/java/dev/starcore/starcore/module/army/storage/authority/ArmyLegacyImporter.java b/src/main/java/dev/starcore/starcore/module/army/storage/authority/ArmyLegacyImporter.java
new file mode 100644
index 0000000000000000000000000000000000000000..8ab9975b68b97f56cc7678085c1741163d9d0080
--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/module/army/storage/authority/ArmyLegacyImporter.java
@@ -0,0 +1,406 @@
+package dev.starcore.starcore.module.army.storage.authority;
+
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import com.google.gson.stream.JsonReader;
+import com.google.gson.stream.JsonToken;
+import dev.starcore.starcore.module.army.model.ArmyState;
+import dev.starcore.starcore.module.army.model.ArmyType;
+import dev.starcore.starcore.module.army.model.authority.ArmyAuthoritySnapshot;
+import dev.starcore.starcore.module.army.model.authority.ArmyLogisticsReceipt;
+import dev.starcore.starcore.module.army.model.authority.ArmyMigrationEvidence;
+import dev.starcore.starcore.module.army.model.authority.ArmyPosition;
+import dev.starcore.starcore.module.army.model.authority.ArmySnapshot;
+import dev.starcore.starcore.module.army.model.authority.ArmyToken;
+import dev.starcore.starcore.module.army.model.authority.ArmyTombstone;
+import java.io.ByteArrayInputStream;
+import java.io.IOException;
+import java.io.StringReader;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.time.Instant;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Base64;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.HexFormat;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import java.util.Optional;
+import java.util.Properties;
+import java.util.Set;
+import java.util.TreeMap;
+import java.util.UUID;
+
+public final class ArmyLegacyImporter {
+  private static final String RECEIPT_PREFIX = "logistics-supply:";
+  private static final String SOURCE_PAYLOAD = "legacy.sourcePayloadBase64";
+  private static final String SOURCE_DESCRIPTOR = "legacy.sourceDescriptor";
+  private static final Set<String> UNIT_FIELDS =
+      Set.of(
+          "id",
+          "nationId",
+          "type",
+          "soldiers",
+          "health",
+          "morale",
+          "state",
+          "supply",
+          "supplyConsumptionRemainder",
+          "createdAt",
+          "lastUpdated",
+          "location");
+  private static final Set<String> POSITION_FIELDS =
+      Set.of("world", "worldId", "x", "y", "z", "yaw", "pitch");
+
+  private ArmyLegacyImporter() {}
+
+  public enum Readiness {
+    READY,
+    NOT_READY
+  }
+
+  public record Limits(int maximumSourceBytes, int maximumRecords, int maximumRecordCharacters) {
+    public Limits {
+      if (maximumSourceBytes < 0
+          || maximumSourceBytes > ArmyMigrationEvidence.MAX_SOURCE_BYTES
+          || maximumRecords < 0
+          || maximumRecordCharacters < 1)
+        throw new IllegalArgumentException("Invalid legacy army import limits");
+    }
+
+    public static Limits defaults() {
+      return new Limits(ArmyMigrationEvidence.MAX_SOURCE_BYTES, 4096, 256 * 1024);
+    }
+  }
+
+  public static final class ImportResult {
+    private final byte[] sourceBytes;
+    private final String sourceDescriptor;
+    private final String sourceSha256;
+    private final Map<String, String> rawRecords;
+    private final List<String> diagnostics;
+    private final ArmyAuthoritySnapshot baseline;
+
+    private ImportResult(
+        byte[] sourceBytes,
+        String sourceDescriptor,
+        String sourceSha256,
+        Map<String, String> rawRecords,
+        List<String> diagnostics,
+        ArmyAuthoritySnapshot baseline) {
+      this.sourceBytes = sourceBytes.clone();
+      this.sourceDescriptor = sourceDescriptor;
+      this.sourceSha256 = sourceSha256;
+      this.rawRecords = Map.copyOf(rawRecords);
+      this.diagnostics = List.copyOf(diagnostics);
+      this.baseline = baseline;
+    }
+
+    public byte[] sourceBytes() {
+      return sourceBytes.clone();
+    }
+
+    public String sourceDescriptor() {
+      return sourceDescriptor;
+    }
+
+    public String sourceSha256() {
+      return sourceSha256;
+    }
+
+    public Map<String, String> rawRecords() {
+      return rawRecords;
+    }
+
+    public List<String> diagnostics() {
+      return diagnostics;
+    }
+
+    public Readiness readiness() {
+      return baseline == null ? Readiness.NOT_READY : Readiness.READY;
+    }
+
+    public boolean ready() {
+      return readiness() == Readiness.READY;
+    }
+
+    public Optional<ArmyAuthoritySnapshot> baseline() {
+      return Optional.ofNullable(baseline);
+    }
+  }
+
+  public static ImportResult inspect(byte[] sourceBytes, String sourceDescriptor) {
+    return inspect(sourceBytes, sourceDescriptor, Limits.defaults());
+  }
+
+  public static ImportResult inspect(byte[] sourceBytes, String sourceDescriptor, Limits limits) {
+    Objects.requireNonNull(sourceBytes, "sourceBytes");
+    Objects.requireNonNull(sourceDescriptor, "sourceDescriptor");
+    Objects.requireNonNull(limits, "limits");
+    if (sourceDescriptor.isBlank() || sourceDescriptor.length() > 2048)
+      throw new IllegalArgumentException("Invalid legacy army source descriptor");
+    if (sourceBytes.length > limits.maximumSourceBytes())
+      throw new IllegalArgumentException("Legacy army source exceeds its byte limit");
+    byte[] preserved = Arrays.copyOf(sourceBytes, sourceBytes.length);
+    String digest = sha256(preserved);
+    var rawRecords = new TreeMap<String, String>();
+    var diagnostics = new ArrayList<String>();
+    var properties = new UniqueProperties();
+    try {
+      properties.load(new ByteArrayInputStream(preserved));
+    } catch (IOException | RuntimeException error) {
+      diagnostics.add("Legacy properties are unreadable or ambiguous: " + error.getMessage());
+    }
+    for (String key : properties.stringPropertyNames())
+      rawRecords.put(key, properties.getProperty(key));
+    if (rawRecords.size() > limits.maximumRecords())
+      diagnostics.add("Legacy army source exceeds its record limit");
+    if (!diagnostics.isEmpty())
+      return new ImportResult(preserved, sourceDescriptor, digest, rawRecords, diagnostics, null);
+
+    var armies = new HashMap<UUID, ArmySnapshot>();
+    var tombstones = new HashMap<UUID, ArmyTombstone>();
+    var receipts = new HashMap<UUID, ArmyLogisticsReceipt>();
+    var inferences = new TreeMap<String, String>();
+    inferences.put(SOURCE_PAYLOAD, Base64.getEncoder().encodeToString(preserved));
+    inferences.put(SOURCE_DESCRIPTOR, sourceDescriptor);
+    for (var entry : rawRecords.entrySet()) {
+      String key = entry.getKey();
+      String value = entry.getValue();
+      try {
+        if (key.length() > 256 || value.length() > limits.maximumRecordCharacters())
+          throw new IllegalArgumentException("Legacy record exceeds its size limit");
+        if (key.startsWith(RECEIPT_PREFIX)) {
+          var requestId = uuid(key.substring(RECEIPT_PREFIX.length()));
+          var receipt = receipt(requestId, value);
+          if (receipts.putIfAbsent(requestId, receipt) != null)
+            throw new IllegalArgumentException("Duplicate legacy logistics request");
+        } else {
+          var armyId = uuid(key);
+          var unit = unit(armyId, value, inferences);
+          if (unit.army() != null) armies.put(armyId, unit.army());
+          else tombstones.put(armyId, unit.tombstone());
+        }
+      } catch (IOException | RuntimeException error) {
+        diagnostics.add("Legacy record " + key + " is not safe to import: " + error.getMessage());
+      }
+    }
+    var owners = new HashMap<UUID, UUID>();
+    for (var receipt : receipts.values()) {
+      var priorOwner = owners.putIfAbsent(receipt.armyId(), receipt.nationId());
+      var army = armies.get(receipt.armyId());
+      var retired = tombstones.get(receipt.armyId());
+      if (priorOwner != null && !priorOwner.equals(receipt.nationId())
+          || army != null && !army.nationId().equals(receipt.nationId())
+          || retired != null && !retired.nationId().equals(receipt.nationId()))
+        diagnostics.add("Legacy logistics ownership is ambiguous for " + receipt.armyId());
+    }
+    ArmyAuthoritySnapshot baseline = null;
+    if (diagnostics.isEmpty())
+      try {
+        baseline =
+            new ArmyAuthoritySnapshot(
+                true,
+                0,
+                armies,
+                tombstones,
+                receipts,
+                new ArmyMigrationEvidence(digest, rawRecords, inferences));
+        ArmyAuthorityState.validate(baseline.withRevision(1));
+        AbstractArmyAuthorityStorage.serializedEnvelopeSize(
+            ArmyAuthorityCodec.encode(baseline.withRevision(1)),
+            AbstractArmyAuthorityStorage.MAX_AUTHORITY_BYTES);
+      } catch (RuntimeException error) {
+        diagnostics.add("Legacy baseline is not safe to publish: " + error.getMessage());
+        baseline = null;
+      }
+    return new ImportResult(preserved, sourceDescriptor, digest, rawRecords, diagnostics, baseline);
+  }
+
+  private static ParsedUnit unit(UUID armyId, String value, Map<String, String> inferences)
+      throws IOException {
+    requireUniqueJsonFields(value);
+    var json = JsonParser.parseString(value).getAsJsonObject();
+    requireFields(json, UNIT_FIELDS);
+    if (!uuid(text(json, "id")).equals(armyId))
+      throw new IllegalArgumentException("Legacy key and embedded army ID differ");
+    var nationId = uuid(text(json, "nationId"));
+    var rawType = text(json, "type");
+    var rawState = text(json, "state");
+    var type = ArmyType.fromString(rawType);
+    var state = ArmyState.fromString(rawState);
+    if (!type.key().equals(rawType)) {
+      inferences.put(
+          "army." + armyId + ".type", "legacy-known-alias:" + rawType + "->" + type.key());
+    }
+    if (!state.key().equals(rawState)) {
+      inferences.put(
+          "army." + armyId + ".state", "legacy-known-alias:" + rawState + "->" + state.key());
+    }
+    int soldiers = integer(json, "soldiers");
+    double health = decimal(json, "health");
+    double morale = decimal(json, "morale");
+    int supply = integer(json, "supply");
+    int remainder =
+        json.has("supplyConsumptionRemainder") ? integer(json, "supplyConsumptionRemainder") : 0;
+    if (soldiers < 0
+        || health < 0
+        || health > 100
+        || morale < 0
+        || morale > 100
+        || supply < 0
+        || supply > 100
+        || remainder < 0
+        || remainder >= 60) throw new IllegalArgumentException("Invalid legacy army scalar range");
+    var createdAt = Instant.ofEpochMilli(longInteger(json, "createdAt"));
+    var updatedAt =
+        json.has("lastUpdated")
+            ? Instant.ofEpochMilli(longInteger(json, "lastUpdated"))
+            : createdAt;
+    if (!json.has("lastUpdated"))
+      inferences.put("army." + armyId + ".lastUpdated", "legacy-missing:createdAt");
+    if (!json.has("supplyConsumptionRemainder"))
+      inferences.put("army." + armyId + ".supplyConsumptionRemainder", "legacy-missing:0");
+    var location = json.getAsJsonObject("location");
+    if (location == null) throw new IllegalArgumentException("Legacy army location is missing");
+    requireFields(location, POSITION_FIELDS);
+    String worldName = text(location, "world");
+    UUID worldId = location.has("worldId") ? uuid(text(location, "worldId")) : null;
+    float yaw = location.has("yaw") ? rotation(location, "yaw") : 0;
+    float pitch = location.has("pitch") ? rotation(location, "pitch") : 0;
+    if (!location.has("yaw")) inferences.put("army." + armyId + ".yaw", "legacy-missing:0");
+    if (!location.has("pitch")) inferences.put("army." + armyId + ".pitch", "legacy-missing:0");
+    var position =
+        new ArmyPosition(
+            worldId,
+            worldName,
+            decimal(location, "x"),
+            decimal(location, "y"),
+            decimal(location, "z"),
+            yaw,
+            pitch);
+    var token = new ArmyToken(armyId, UUID.randomUUID(), 1);
+    if (soldiers == 0 || health == 0)
+      return new ParsedUnit(
+          null,
+          new ArmyTombstone(token, nationId, type, createdAt, updatedAt, "LEGACY_DESTROYED", null));
+    return new ParsedUnit(
+        new ArmySnapshot(
+            token, nationId, type, soldiers, health, morale, position, state, supply, remainder,
+            createdAt, updatedAt),
+        null);
+  }
+
+  private static ArmyLogisticsReceipt receipt(UUID requestId, String value) {
+    var parts = value.split("\\|", -1);
+    if (parts.length != 4)
+      throw new IllegalArgumentException("Invalid legacy logistics receipt tuple");
+    return new ArmyLogisticsReceipt(
+        requestId,
+        uuid(parts[0]),
+        uuid(parts[1]),
+        Integer.parseInt(parts[2]),
+        Integer.parseInt(parts[3]),
+        null);
+  }
+
+  private static UUID uuid(String value) {
+    var parsed = UUID.fromString(value);
+    if (!parsed.toString().equals(value))
+      throw new IllegalArgumentException("Noncanonical legacy UUID");
+    return parsed;
+  }
+
+  private static String text(JsonObject json, String name) {
+    var value = json.get(name);
+    if (value == null || !value.isJsonPrimitive() || !value.getAsJsonPrimitive().isString())
+      throw new IllegalArgumentException("Missing or non-text legacy field: " + name);
+    return value.getAsString();
+  }
+
+  private static java.math.BigDecimal number(JsonObject json, String name) {
+    var value = json.get(name);
+    if (value == null || !value.isJsonPrimitive() || !value.getAsJsonPrimitive().isNumber())
+      throw new IllegalArgumentException("Missing or nonnumeric legacy field: " + name);
+    return value.getAsBigDecimal();
+  }
+
+  private static int integer(JsonObject json, String name) {
+    return number(json, name).intValueExact();
+  }
+
+  private static long longInteger(JsonObject json, String name) {
+    return number(json, name).longValueExact();
+  }
+
+  private static double decimal(JsonObject json, String name) {
+    double value = number(json, name).doubleValue();
+    if (!Double.isFinite(value))
+      throw new IllegalArgumentException("Non-finite legacy field: " + name);
+    return value;
+  }
+
+  private static float rotation(JsonObject json, String name) {
+    float value = number(json, name).floatValue();
+    if (!Float.isFinite(value))
+      throw new IllegalArgumentException("Non-finite legacy rotation: " + name);
+    return value;
+  }
+
+  private static void requireFields(JsonObject json, Set<String> allowed) {
+    for (String field : json.keySet())
+      if (!allowed.contains(field))
+        throw new IllegalArgumentException("Unknown legacy field: " + field);
+  }
+
+  private static void requireUniqueJsonFields(String value) throws IOException {
+    try (var reader = new JsonReader(new StringReader(value))) {
+      reader.setLenient(false);
+      scanJson(reader, 0);
+      if (reader.peek() != JsonToken.END_DOCUMENT)
+        throw new IllegalArgumentException("Trailing legacy JSON content");
+    }
+  }
+
+  private static void scanJson(JsonReader reader, int depth) throws IOException {
+    if (depth > 3) throw new IllegalArgumentException("Legacy JSON nesting is too deep");
+    switch (reader.peek()) {
+      case BEGIN_OBJECT -> {
+        reader.beginObject();
+        var fields = new HashSet<String>();
+        while (reader.hasNext()) {
+          String name = reader.nextName();
+          if (!fields.add(name) || fields.size() > 32)
+            throw new IllegalArgumentException("Duplicate or excessive legacy JSON fields");
+          scanJson(reader, depth + 1);
+        }
+        reader.endObject();
+      }
+      case STRING, NUMBER -> reader.nextString();
+      case BOOLEAN -> reader.nextBoolean();
+      case NULL -> reader.nextNull();
+      default -> throw new IllegalArgumentException("Unsupported legacy JSON value");
+    }
+  }
+
+  private static String sha256(byte[] bytes) {
+    try {
+      return HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256").digest(bytes));
+    } catch (NoSuchAlgorithmException error) {
+      throw new IllegalStateException(error);
+    }
+  }
+
+  private record ParsedUnit(ArmySnapshot army, ArmyTombstone tombstone) {}
+
+  private static final class UniqueProperties extends Properties {
+    @Override
+    public synchronized Object put(Object key, Object value) {
+      if (containsKey(key)) throw new IllegalArgumentException("Duplicate legacy property: " + key);
+      return super.put(key, value);
+    }
+  }
+}
diff --git a/src/main/java/dev/starcore/starcore/module/army/storage/authority/ArmyNationClosureState.java b/src/main/java/dev/starcore/starcore/module/army/storage/authority/ArmyNationClosureState.java
new file mode 100644
index 0000000000000000000000000000000000000000..f5232c87041e1ed75512ad34a13886c7055d4a20
--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/module/army/storage/authority/ArmyNationClosureState.java
@@ -0,0 +1,346 @@
+package dev.starcore.starcore.module.army.storage.authority;
+
+import dev.starcore.starcore.module.army.commander.model.SkillType;
+import dev.starcore.starcore.module.army.model.authority.ArmyAuthoritySnapshot;
+import dev.starcore.starcore.module.army.model.authority.ArmyNationClosure;
+import dev.starcore.starcore.module.army.model.authority.ArmySnapshot;
+import java.time.Instant;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.UUID;
+
+final class ArmyNationClosureState {
+  private ArmyNationClosureState() {}
+
+  static void validate(ArmyAuthoritySnapshot image) {
+    var operations = new HashSet<UUID>();
+    for (var entry : image.nationClosures().entrySet()) {
+      var closure = entry.getValue();
+      if (!entry.getKey().equals(closure.nationId())
+          || !operations.add(closure.operationId())
+          || image.receipts().containsKey(closure.operationId())
+          || image.paidOperations().containsKey(closure.operationId())
+          || image.battleSessions().containsKey(closure.operationId())
+          || image.skillUses().containsKey(closure.operationId())) {
+        throw new IllegalArgumentException("Army nation closure identity is ambiguous");
+      }
+      if (closure.pending()) {
+        image.armies().values().stream()
+            .filter(army -> army.nationId().equals(closure.nationId()))
+            .forEach(ArmyNationClosureState::requireRetirementHeadroom);
+        image.paidOperations().values().stream()
+            .filter(
+                operation ->
+                    operation.pending()
+                        && operation.request().nationId().equals(closure.nationId()))
+            .forEach(operation -> requireRetirementHeadroom(operation.request().after()));
+        image.battleSessions().values().stream()
+            .filter(session -> session.pending())
+            .forEach(
+                session -> {
+                  for (var army :
+                      new ArmySnapshot[] {
+                        session.currentHeads().attacker(), session.currentHeads().defender()
+                      }) {
+                    if (army.nationId().equals(closure.nationId())
+                        && army.token().generation() >= Long.MAX_VALUE - 1) {
+                      throw new IllegalArgumentException(
+                          "Army battle has no later retirement token");
+                    }
+                  }
+                });
+      } else {
+        requireDrained(image, closure.nationId());
+        if (image.armies().values().stream()
+            .anyMatch(army -> army.nationId().equals(closure.nationId()))) {
+          throw new IllegalArgumentException("Retired Army nation still has live armies");
+        }
+        closure
+            .retirements()
+            .forEach(
+                (armyId, proof) -> {
+                  if (!proof.equals(image.tombstones().get(armyId))) {
+                    throw new IllegalArgumentException("Army nation retirement proof disappeared");
+                  }
+                });
+      }
+    }
+    image
+        .tombstones()
+        .forEach(
+            (armyId, tombstone) -> {
+              if (tombstone.reason().equals("nation-retired")) {
+                var closure = image.nationClosures().get(tombstone.nationId());
+                if (closure == null
+                    || closure.pending()
+                    || !tombstone.equals(closure.retirements().get(armyId))) {
+                  throw new IllegalArgumentException(
+                      "Army nation tombstone has no retirement proof");
+                }
+              }
+            });
+  }
+
+  static long remainingRevisions(ArmyAuthoritySnapshot image) {
+    return image.nationClosures().values().stream().filter(ArmyNationClosure::pending).count();
+  }
+
+  static void validateObservation(ArmyAuthoritySnapshot previous, ArmyAuthoritySnapshot next) {
+    previous
+        .nationClosures()
+        .forEach(
+            (nationId, before) -> {
+              var after = next.nationClosures().get(nationId);
+              if (after == null
+                  || !before.sameRequest(after)
+                  || !before.pending() && !before.equals(after)) {
+                throw new IllegalArgumentException(
+                    "Army nation closure was lost, reopened or replaced");
+              }
+            });
+    next.nationClosures()
+        .forEach(
+            (nationId, closure) -> {
+              if (!previous.nationClosures().containsKey(nationId)) {
+                requireAcceptanceTime(previous, closure);
+              }
+            });
+    next.paidOperations()
+        .forEach(
+            (operationId, operation) -> {
+              if (!previous.paidOperations().containsKey(operationId)) {
+                requireOpen(previous, operation.request().nationId());
+              }
+            });
+    next.battleSessions()
+        .forEach(
+            (sessionId, session) -> {
+              if (!previous.battleSessions().containsKey(sessionId)) {
+                requireOpen(previous, session.request().attackerBefore().nationId());
+                requireOpen(previous, session.request().defenderBefore().nationId());
+              }
+            });
+    next.skillUses()
+        .forEach(
+            (operationId, use) -> {
+              if (!previous.skillUses().containsKey(operationId)) {
+                requireOpen(previous, use.request().nationId());
+                if (use.request().skillType() != SkillType.SCOUT) {
+                  use.request()
+                      .targets()
+                      .values()
+                      .forEach(army -> requireOpen(previous, army.nationId()));
+                }
+              }
+            });
+    next.receipts()
+        .forEach(
+            (requestId, receipt) -> {
+              if (!previous.receipts().containsKey(requestId))
+                requireOpen(previous, receipt.nationId());
+            });
+    for (var closure : previous.nationClosures().values()) {
+      if (!closure.pending()) continue;
+      var nationId = closure.nationId();
+      var after = next.nationClosures().get(nationId);
+      var expected = new HashMap<UUID, ArmySnapshot>();
+      previous
+          .armies()
+          .forEach(
+              (armyId, army) -> {
+                if (army.nationId().equals(nationId)) expected.put(armyId, army);
+              });
+      previous
+          .paidOperations()
+          .forEach(
+              (operationId, operation) -> {
+                if (operation.pending()
+                    && operation.request().nationId().equals(nationId)
+                    && next.paidOperations().get(operationId).applied()) {
+                  expected.put(operation.request().armyId(), operation.request().after());
+                }
+              });
+      previous
+          .battleSessions()
+          .forEach(
+              (sessionId, session) -> {
+                var terminal = next.battleSessions().get(sessionId);
+                if (session.pending() && !terminal.pending()) {
+                  for (var effect :
+                      new ArmySnapshot[] {
+                        terminal.resolution().attackerAfter(), terminal.resolution().defenderAfter()
+                      }) {
+                    if (effect.nationId().equals(nationId)) {
+                      if (effect.isAlive()) expected.put(effect.token().armyId(), effect);
+                      else expected.remove(effect.token().armyId());
+                    }
+                  }
+                }
+              });
+      if (after.pending()) {
+        var actual = new HashMap<UUID, ArmySnapshot>();
+        next.armies()
+            .forEach(
+                (armyId, army) -> {
+                  if (army.nationId().equals(nationId)) actual.put(armyId, army);
+                });
+        if (!expected.equals(actual)) {
+          throw new IllegalArgumentException(
+              "Closing Army nation permits only exact accepted effects");
+        }
+      } else if (!closure.retired(expected, after.retiredAt()).equals(after)) {
+        throw new IllegalArgumentException(
+            "Observed Army retirement differs from accepted effects");
+      }
+    }
+  }
+
+  static void validateCommit(ArmyAuthoritySnapshot previous, ArmyAuthoritySnapshot next) {
+    var changed =
+        next.nationClosures().entrySet().stream()
+            .filter(
+                entry -> !entry.getValue().equals(previous.nationClosures().get(entry.getKey())))
+            .toList();
+    if (changed.isEmpty()) return;
+    if (changed.size() != 1
+        || !previous.receipts().equals(next.receipts())
+        || !previous.paidOperations().equals(next.paidOperations())
+        || !previous.battleSessions().equals(next.battleSessions())
+        || !previous.skillUses().equals(next.skillUses())) {
+      throw new IllegalArgumentException("One Army commit may advance only one isolated closure");
+    }
+    var after = changed.getFirst().getValue();
+    var before = previous.nationClosures().get(after.nationId());
+    var armies = new HashMap<>(previous.armies());
+    var tombstones = new HashMap<>(previous.tombstones());
+    if (before == null) {
+      if (!after.pending()) {
+        throw new IllegalArgumentException("Army nation closure must start pending");
+      }
+      requireAcceptanceTime(previous, after);
+    } else {
+      if (!before.pending() || after.pending()) {
+        throw new IllegalArgumentException("Army nation closure must advance to retirement");
+      }
+      requireDrained(previous, after.nationId());
+      var expected = before.retired(previous.armies(), after.retiredAt());
+      if (!expected.equals(after)) {
+        throw new IllegalArgumentException(
+            "Army nation retirement must include all current armies");
+      }
+      after
+          .retirements()
+          .forEach(
+              (armyId, proof) -> {
+                armies.remove(armyId);
+                tombstones.put(armyId, proof);
+              });
+    }
+    if (!armies.equals(next.armies()) || !tombstones.equals(next.tombstones())) {
+      throw new IllegalArgumentException("Army closure and exact retirement must commit together");
+    }
+  }
+
+  static ArmyAuthoritySnapshot maximumCompletionImage(ArmyAuthoritySnapshot image) {
+    if (image.nationClosures().values().stream().noneMatch(ArmyNationClosure::pending))
+      return image;
+    var armies = new HashMap<>(image.armies());
+    var tombstones = new HashMap<>(image.tombstones());
+    var closures = new HashMap<>(image.nationClosures());
+    image
+        .nationClosures()
+        .forEach(
+            (nationId, closure) -> {
+              if (closure.pending()) {
+                var terminal = closure.retired(image.armies(), Instant.MAX);
+                closures.put(nationId, terminal);
+                terminal
+                    .retirements()
+                    .forEach(
+                        (armyId, proof) -> {
+                          armies.remove(armyId);
+                          tombstones.put(armyId, proof);
+                        });
+              }
+            });
+    return new ArmyAuthoritySnapshot(
+        true,
+        image.revision(),
+        armies,
+        tombstones,
+        image.receipts(),
+        image.migration(),
+        image.version(),
+        image.paidOperations(),
+        image.battleSessions(),
+        image.skillUses(),
+        closures);
+  }
+
+  private static void requireRetirementHeadroom(ArmySnapshot army) {
+    if (army.token().generation() == Long.MAX_VALUE) {
+      throw new IllegalArgumentException("Army nation closure requires a retirement successor");
+    }
+  }
+
+  private static void requireDrained(ArmyAuthoritySnapshot image, UUID nationId) {
+    if (image.paidOperations().values().stream()
+            .anyMatch(
+                operation -> operation.pending() && operation.request().nationId().equals(nationId))
+        || image.battleSessions().values().stream()
+            .anyMatch(
+                session ->
+                    session.pending()
+                        && (session.request().attackerBefore().nationId().equals(nationId)
+                            || session.request().defenderBefore().nationId().equals(nationId)))) {
+      throw new IllegalArgumentException("Army nation has unresolved paid operations or battles");
+    }
+  }
+
+  private static void requireOpen(ArmyAuthoritySnapshot image, UUID nationId) {
+    if (image.nationClosures().containsKey(nationId)) {
+      throw new IllegalArgumentException("Army nation is closing or retired");
+    }
+  }
+
+  private static void requireAcceptanceTime(
+      ArmyAuthoritySnapshot image, ArmyNationClosure closure) {
+    var accepted = closure.acceptedAt();
+    var nationId = closure.nationId();
+    image.armies().values().stream()
+        .filter(army -> army.nationId().equals(nationId))
+        .forEach(
+            army -> {
+              requireNotEarlier(accepted, army.createdAt());
+              requireNotEarlier(accepted, army.lastUpdated());
+            });
+    image.tombstones().values().stream()
+        .filter(proof -> proof.nationId().equals(nationId))
+        .forEach(proof -> requireNotEarlier(accepted, proof.retiredAt()));
+    image.paidOperations().values().stream()
+        .filter(operation -> operation.request().nationId().equals(nationId))
+        .forEach(operation -> requireNotEarlier(accepted, operation.request().acceptedAt()));
+    image.battleSessions().values().stream()
+        .filter(
+            session ->
+                session.request().attackerBefore().nationId().equals(nationId)
+                    || session.request().defenderBefore().nationId().equals(nationId))
+        .forEach(
+            session -> {
+              requireNotEarlier(accepted, session.request().acceptedAt());
+              session
+                  .interventions()
+                  .forEach(intervention -> requireNotEarlier(accepted, intervention.acceptedAt()));
+              if (!session.pending()) requireNotEarlier(accepted, session.resolution().decidedAt());
+            });
+    image.skillUses().values().stream()
+        .filter(use -> use.request().nationId().equals(nationId))
+        .forEach(use -> requireNotEarlier(accepted, use.request().acceptedAt()));
+  }
+
+  private static void requireNotEarlier(Instant accepted, Instant previous) {
+    if (accepted.isBefore(previous)) {
+      throw new IllegalArgumentException("Army nation closure precedes its accepted history");
+    }
+  }
+}
diff --git a/src/main/java/dev/starcore/starcore/module/army/storage/authority/ArmyPaidState.java b/src/main/java/dev/starcore/starcore/module/army/storage/authority/ArmyPaidState.java
