+    var state = state(batch);
+    state.setProperty(
+        WarSettlementState.ADMISSION + batch.request().operationId(),
+        WarSettlementState.encode(new Admission(batch.binding(), Decision.CONFLICTING_SCOPE)));
+    long before = WarSettlementFileCapacity.requiredBytes(state, Long.MAX_VALUE);
+    var cancelled = new Properties();
+    cancelled.putAll(state);
+    String key = WarSettlementState.CANCEL + batch.request().operationId();
+    String seal = WarSettlementState.encode(new CancellationReceipt(batch.binding()));
+    cancelled.setProperty(key, seal);
+    long after = WarSettlementFileCapacity.requiredBytes(cancelled, Long.MAX_VALUE);
+    assertThat(before - serializedBytes(state))
+        .isEqualTo(
+            after
+                - serializedBytes(cancelled)
+                + WarSettlementFileCapacity.propertyBytes(key, seal));
+    assertThat(after).isLessThanOrEqualTo(before);
+    assertThatCode(() -> WarSettlementFileCapacity.validate(cancelled, before))
+        .doesNotThrowAnyException();
