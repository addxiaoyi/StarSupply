index 0000000000000000000000000000000000000000..07c11147f8b2bc91484d87b56658526d4fab74c6
--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/module/war/WarSettlementAdmissionService.java
@@ -0,0 +1,220 @@
+package dev.starcore.starcore.module.war;
+
+import dev.starcore.starcore.module.diplomacy.DiplomacyTreatyOperationService.ExactWar;
+import dev.starcore.starcore.module.diplomacy.DiplomacyTreatyOperationService.PairScope;
+import dev.starcore.starcore.module.diplomacy.WarDiplomacyMirrorService.WarEntry;
+import dev.starcore.starcore.module.war.WarSettlementEffectProofReader.EffectProof;
+import dev.starcore.starcore.module.war.WarSettlementEffectProofReader.Phase;
+import dev.starcore.starcore.treaty.TreatyEffectManifest;
+import dev.starcore.starcore.treaty.TreatyEffectManifest.Manifest;
+import java.time.Instant;
+import java.util.*;
+
+public interface WarSettlementAdmissionService extends WarSettlementEndReceiptService {
+  default void requireEffectProofPersistence() {
+    throw new UnsupportedOperationException("Settlement effect proof persistence unsupported");
+  }
+
+  WarSnapshot snapshot(UUID warId);
+
+  Admission prepareSettlement(Request request);
+
+  Optional<Admission> settlementAdmission(UUID operationId);
+
+  EndReceipt endSettlement(UUID operationId, String planHash);
+
+  CancellationReceipt cancelSettlement(Request request);
+
+  ReleaseReceipt releaseSettlement(ReleaseRequest request);
+
+  record WarSnapshot(ExactWar war, long generation, String fingerprint, boolean active) {
+    public WarSnapshot {
+      Objects.requireNonNull(war);
+      if (generation < 0) throw new IllegalArgumentException("Negative war generation");
+      requireHash(fingerprint);
+    }
+  }
+
+  record Request(
+      UUID operationId,
+      UUID treatyId,
+      ExactWar war,
+      long warGeneration,
+      String warFingerprint,
+      List<PairScope> scopes,
+      String planHash,
+      Instant preparedAt,
+      int protocolVersion,
+      Manifest manifest) {
+    public Request(
+        UUID operationId,
+        UUID treatyId,
+        ExactWar war,
+        long warGeneration,
+        String warFingerprint,
+        List<PairScope> scopes,
+        String planHash,
+        Instant preparedAt) {
+      this(
+          operationId,
+          treatyId,
+          war,
+          warGeneration,
+          warFingerprint,
+          scopes,
+          planHash,
+          preparedAt,
+          1,
+          null);
+    }
+
+    public Request {
+      Objects.requireNonNull(operationId);
+      Objects.requireNonNull(treatyId);
+      Objects.requireNonNull(war);
+      Objects.requireNonNull(preparedAt);
+      if (warGeneration < 0) throw new IllegalArgumentException("Negative war generation");
+      requireHash(warFingerprint);
+      requireHash(planHash);
+      var ordered = new ArrayList<>(Objects.requireNonNull(scopes));
+      ordered.sort(
+          Comparator.comparing((PairScope pair) -> pair.left().toString())
+              .thenComparing(pair -> pair.right().toString()));
+      if (ordered.isEmpty()
+          || ordered.size() > 4096
+          || new HashSet<>(ordered).size() != ordered.size())
+        throw new IllegalArgumentException("Invalid settlement scopes");
+      scopes = List.copyOf(ordered);
+      if (protocolVersion == 1) {
+        if (manifest != null)
+          throw new IllegalArgumentException("Legacy settlement cannot contain a manifest");
+      } else if (protocolVersion == TreatyEffectManifest.VERSION && manifest != null) {
+        var envelope = manifest.envelope();
+        if (!operationId.equals(envelope.operationId())
+            || !treatyId.equals(envelope.treatyId())
+            || !war.equals(envelope.war())
+            || warGeneration != envelope.warGeneration()
+            || !warFingerprint.equals(envelope.warFingerprint())
+            || !preparedAt.equals(envelope.preparedAt())
+            || !scopes.equals(manifest.scopes())
+            || !planHash.equals(TreatyEffectManifest.manifestHash(manifest)))
+          throw new IllegalArgumentException(
+              "Settlement request does not match its exact manifest");
+      } else {
+        throw new IllegalArgumentException("Unknown or incomplete settlement request version");
+      }
+    }
+  }
+
+  enum Decision {
+    ACCEPTED,
+    WAR_MISMATCH,
+    INACTIVE_WAR,
+    CONFLICTING_SCOPE,
+    PENDING_EFFECT,
+    RETIRED,
+    CANCELLED
+  }
+
+  record Admission(Request request, Decision decision) {
+    public Admission {
+      Objects.requireNonNull(request);
+      Objects.requireNonNull(decision);
+    }
+
+    public boolean accepted() {
+      return decision == Decision.ACCEPTED;
+    }
+  }
+
+  record EndReceipt(
+      Request request,
+      long beforeGeneration,
+      long afterGeneration,
+      Instant endedAt,
+      long endedAuthorityRevision,
+      WarEntry endedWar) {
+    public EndReceipt {
+      Objects.requireNonNull(request);
+      Objects.requireNonNull(endedAt);
+      Objects.requireNonNull(endedWar);
+      var original = request.war();
+      if (beforeGeneration != request.warGeneration()
+          || afterGeneration != Math.addExact(beforeGeneration, 1)
+          || endedAuthorityRevision <= 0
+          || endedWar.active()
+          || !endedWar.warId().equals(original.warId())
+          || !endedWar.aggressor().equals(original.attacker())
+          || !endedWar.defender().equals(original.defender())
+          || !endedWar.declaredAt().equals(original.declaredAt()))
+        throw new IllegalArgumentException("Invalid exact settlement end receipt");
+    }
+  }
+
+  record ReleaseRequest(UUID operationId, String planHash) {
+    public ReleaseRequest {
+      Objects.requireNonNull(operationId);
+      requireHash(planHash);
+    }
+  }
+
+  record CancellationReceipt(Request request) {
+    public CancellationReceipt {
+      Objects.requireNonNull(request);
+    }
+  }
+
+  enum TerminalStatus {
+    APPLIED,
+    SUPERSEDED,
+    CANCELLED
+  }
+
+  record ReleaseReceipt(
+      ReleaseRequest request,
+      TerminalStatus status,
+      int protocolVersion,
+      List<EffectProof> effectProofs) {
+    public ReleaseReceipt(ReleaseRequest request, TerminalStatus status) {
+      this(request, status, 1, List.of());
+    }
+
+    public ReleaseReceipt {
+      Objects.requireNonNull(request);
+      Objects.requireNonNull(status);
+      effectProofs = List.copyOf(Objects.requireNonNull(effectProofs));
+      if (protocolVersion == 1) {
+        if (!effectProofs.isEmpty())
+          throw new IllegalArgumentException("Legacy release cannot contain effect proofs");
+      } else if (protocolVersion == TreatyEffectManifest.VERSION && !effectProofs.isEmpty()) {
+        var binding = effectProofs.getFirst().binding();
+        var entries = binding.manifest().entries();
+        var expectedPhase =
+            switch (status) {
+              case APPLIED -> Phase.APPLIED;
+              case CANCELLED -> Phase.CANCELLED;
+              case SUPERSEDED -> Phase.SUPERSEDED;
+            };
+        if (!request.operationId().equals(binding.operationId())
+            || !request.planHash().equals(binding.planHash())
+            || entries.size() != effectProofs.size())
+          throw new IllegalArgumentException("Release does not cover its exact manifest");
+        for (int index = 0; index < entries.size(); index++) {
+          var proof = effectProofs.get(index);
+          if (!proof.binding().equals(binding)
+              || !proof.entry().equals(entries.get(index))
+              || proof.phase() != expectedPhase)
+            throw new IllegalArgumentException(
+                "Release requires one uniform complete proof vector");
+        }
+      } else {
+        throw new IllegalArgumentException("Unknown or incomplete settlement release version");
+      }
+    }
+  }
+
+  private static void requireHash(String value) {
+    if (value == null || !value.matches("[0-9a-f]{64}"))
+      throw new IllegalArgumentException("Invalid settlement fingerprint");
+  }
+}
