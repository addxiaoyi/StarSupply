+class ArmySoldierCapacityRuntimeTest {
+  @TempDir Path root;
+
+  private void configure(ArmyRuntimeTestFixture f, long limit) {
+    f.service.shutdown();
+    f.config = new ArmyService.ArmyConfig(10, 1000, true, limit);
+    f.open(false);
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void creationUsesExactAggregateLimitAndLeavesOtherNationsIndependent(boolean sql)
+      throws Exception {
+    try (var f = new ArmyRuntimeTestFixture(root, sql)) {
+      configure(f, 150);
+      f.add();
+      f.service.createArmy(f.nation.id().value(), ArmyType.INFANTRY, 30, f.location());
+      f.service.createArmy(f.nation.id().value(), ArmyType.INFANTRY, 20, f.location());
+      var state = f.owner.snapshot();
+      int debits = f.debitApplies;
+      assertThrows(
+          IllegalStateException.class,
+          () -> f.service.createArmy(f.nation.id().value(), ArmyType.INFANTRY, 10, f.location()));
+      assertEquals(state, f.owner.snapshot());
+      assertEquals(debits, f.debitApplies);
+      assertEquals(
+          new ArmySoldierCapacity(150, 0, 150), f.service.soldierCapacity(f.nation.id().value()));
+      f.service.createArmy(f.other.id().value(), ArmyType.INFANTRY, 150, f.location());
+      assertEquals(150, f.service.soldierCapacity(f.other.id().value()).live());
+      assertEquals(7, f.owner.snapshot().version());
+      f.service.shutdown();
+      f.open(false);
+      assertEquals(150, f.service.soldierCapacity(f.nation.id().value()).live());
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void pendingCreationReservesSoldiersUntilAnOriginalNegativeDecision(boolean sql)
+      throws Exception {
+    try (var f = new ArmyRuntimeTestFixture(root, sql)) {
+      configure(f, 150);
+      f.add();
+      f.failDebit = true;
+      assertThrows(
+          IllegalStateException.class,
+          () -> f.service.createArmy(f.nation.id().value(), ArmyType.INFANTRY, 40, f.location()));
+      var request = f.lastPaid().request();
+      assertEquals(150, request.maximumNationSoldiers());
+      assertEquals(
+          new ArmySoldierCapacity(100, 40, 150), f.service.soldierCapacity(f.nation.id().value()));
+      var state = f.owner.snapshot();
+      assertThrows(
+          IllegalStateException.class,
+          () ->
+              f.service.createArmy(
+                  f.player(f.nation), f.nation.id().value(), ArmyType.INFANTRY, 20, f.location()));
+      assertEquals(state, f.owner.snapshot());
+      assertEquals(1, f.debitApplies);
+      f.service.cancelPaidOperation(request.operationId());
+      assertEquals(
+          new ArmySoldierCapacity(100, 0, 150), f.service.soldierCapacity(f.nation.id().value()));
+      f.failDebit = false;
+      f.service.createArmy(f.nation.id().value(), ArmyType.INFANTRY, 50, f.location());
+      assertEquals(150, f.service.soldierCapacity(f.nation.id().value()).live());
+    }
+  }
+
+  @ParameterizedTest
