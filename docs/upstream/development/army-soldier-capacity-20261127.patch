+package dev.starcore.starcore.module.army.storage.authority;
+
+import dev.starcore.starcore.module.army.model.authority.ArmyAuthoritySnapshot;
+import dev.starcore.starcore.module.army.model.authority.ArmyLogisticsReceipt;
+import dev.starcore.starcore.module.army.model.authority.ArmySnapshot;
+import dev.starcore.starcore.module.army.model.authority.ArmyTombstone;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import java.util.Properties;
+import java.util.UUID;
+
+public final class ArmyAuthorityState {
+  private ArmyAuthorityState() {}
+
+  public static void validate(Properties properties) {
+    ArmyAuthorityCodec.decode(properties);
+  }
+
+  public static void validate(ArmyAuthoritySnapshot image) {
+    Objects.requireNonNull(image, "image");
+    if (!image.initialized()) return;
+    if (image.revision() < 1) {
+      throw new IllegalArgumentException(
+          "Initialized durable authority requires a positive revision");
+    }
+    Map<UUID, UUID> owners = new HashMap<>();
+    image
+        .armies()
+        .forEach(
+            (armyId, army) -> {
+              if (!armyId.equals(army.token().armyId()) || !army.isAlive()) {
+                throw new IllegalArgumentException("Live army key or alive state is invalid");
+              }
+              if (image.tombstones().containsKey(armyId)) {
+                throw new IllegalArgumentException("Army cannot be both live and retired");
+              }
+              owners.put(armyId, army.nationId());
+            });
+    image
+        .tombstones()
+        .forEach(
+            (armyId, tombstone) -> {
+              if (!armyId.equals(tombstone.token().armyId())) {
+                throw new IllegalArgumentException("Tombstone key differs from its army identity");
+              }
+              owners.put(armyId, tombstone.nationId());
+            });
+    Map<UUID, UUID> incarnations = image.incarnations();
+    image
+        .receipts()
+        .forEach(
+            (requestId, receipt) -> {
+              if (!requestId.equals(receipt.requestId())) {
+                throw new IllegalArgumentException("Receipt key differs from its request identity");
+              }
+              UUID existingOwner = owners.putIfAbsent(receipt.armyId(), receipt.nationId());
+              if (existingOwner != null && !existingOwner.equals(receipt.nationId())) {
+                throw new IllegalArgumentException("Army receipt ownership is ambiguous");
+              }
+              if (!receipt.legacy()) {
+                UUID incarnation = incarnations.get(receipt.armyId());
+                if (!receipt.incarnation().equals(incarnation)) {
+                  throw new IllegalArgumentException(
+                      "Bound receipt has no matching army incarnation");
+                }
+              }
+            });
+    ArmyPaidState.validate(image);
+    ArmyBattleState.validate(image);
+    ArmySkillState.validate(image);
+    ArmyNationClosureState.validate(image);
+    Math.addExact(
+        image.revision(),
+        Math.addExact(
+            Math.addExact(
+                ArmyPaidState.remainingRevisions(image), ArmyBattleState.remainingRevisions(image)),
+            ArmyNationClosureState.remainingRevisions(image)));
+  }
+
+  public static void validateObservation(Properties previous, Properties next) {
+    validateObservation(ArmyAuthorityCodec.decode(previous), ArmyAuthorityCodec.decode(next));
+  }
+
+  public static void validateObservation(
+      ArmyAuthoritySnapshot previous, ArmyAuthoritySnapshot next) {
+    validate(previous);
+    validate(next);
+    if (next.revision() < previous.revision()) {
+      throw new IllegalArgumentException("Army authority revision moved backwards");
+    }
+    if (next.revision() == previous.revision()) {
+      if (!previous.equals(next)) {
+        throw new IllegalArgumentException("Unequal Army images at the same revision");
+      }
+      return;
+    }
+    if (!next.initialized()) throw new IllegalArgumentException("Army authority downgrade");
+    if (!previous.initialized()) return;
+    if (!previous.migration().equals(next.migration())) {
+      throw new IllegalArgumentException("Army migration evidence is immutable");
+    }
+    ArmyPaidState.validateObservation(previous, next);
+    ArmyBattleState.validateObservation(previous, next);
+    ArmySkillState.validateObservation(previous, next);
+    ArmyNationClosureState.validateObservation(previous, next);
+    requireRetainedRecords(previous, next);
+    previous
+        .armies()
+        .forEach(
+            (armyId, before) -> {
+              ArmySnapshot after = next.armies().get(armyId);
+              ArmyTombstone retired = next.tombstones().get(armyId);
+              if (after != null) {
+                requireIdentity(before, after);
+                if (after.token().generation() < before.token().generation()
+                    || after.token().generation() == before.token().generation()
+                        && !before.equals(after)) {
+                  throw new IllegalArgumentException(
+                      "Army generation did not cover its observed change");
+                }
+              } else if (retired != null) {
+                requireIdentity(before, retired);
+                if (retired.token().generation() <= before.token().generation()) {
+                  throw new IllegalArgumentException(
+                      "Army retirement did not advance its generation");
+                }
+              } else {
+                throw new IllegalArgumentException("Army identity disappeared without a tombstone");
+              }
+            });
+    next.armies()
+        .forEach(
+            (armyId, army) -> {
+              if (!previous.armies().containsKey(armyId)
+                  && !previous.tombstones().containsKey(armyId)
+                  && receiptTargets(previous, armyId)) {
+                throw new IllegalArgumentException("Legacy receipt target UUID cannot be reused");
+              }
+            });
+    next.tombstones()
+        .forEach(
+            (armyId, tombstone) -> {
+              if (!previous.armies().containsKey(armyId)
+                  && !previous.tombstones().containsKey(armyId)
+                  && receiptTargets(previous, armyId)) {
+                throw new IllegalArgumentException(
+                    "Legacy receipt target UUID cannot be retired anew");
+              }
+            });
+    next.receipts()
+        .forEach(
+            (requestId, receipt) -> {
+              if (!previous.receipts().containsKey(requestId) && receipt.legacy()) {
+                throw new IllegalArgumentException(
+                    "Legacy receipt import cannot recur after initialization");
+              }
+            });
+  }
+
+  public static void validateCommit(Properties previous, Properties next) {
+    validateCommit(ArmyAuthorityCodec.decode(previous), ArmyAuthorityCodec.decode(next));
+  }
+
+  public static void validateCommit(ArmyAuthoritySnapshot previous, ArmyAuthoritySnapshot next) {
+    validate(previous);
+    validate(next);
+    if (!next.initialized() || next.revision() != Math.addExact(previous.revision(), 1)) {
+      throw new IllegalArgumentException("Army commit must advance the authority exactly once");
+    }
+    if (!previous.initialized()) {
+      if (next.version() != 1
+          || !next.paidOperations().isEmpty()
+          || !next.battleSessions().isEmpty()
+          || !next.skillUses().isEmpty()
+          || !next.nationClosures().isEmpty()) {
+        throw new IllegalArgumentException("Army initialization cannot fabricate paid operations");
+      }
+      if (next.generations().values().stream().anyMatch(generation -> generation != 1)) {
+        throw new IllegalArgumentException("Initial Army tokens must start at generation one");
+      }
+      if (next.receipts().values().stream().anyMatch(receipt -> !receipt.legacy())) {
+        throw new IllegalArgumentException("Initial receipt import must preserve legacy tuples");
+      }
+      return;
+    }
+    validateObservation(previous, next);
+    previous
+        .armies()
+        .forEach(
+            (armyId, before) -> {
+              ArmySnapshot after = next.armies().get(armyId);
+              if (after != null) {
+                if (!before.equals(after)
+                    && after.token().generation()
+                        != Math.addExact(before.token().generation(), 1)) {
+                  throw new IllegalArgumentException(
+                      "Army update must advance its generation once");
+                }
+              } else if (next.tombstones().get(armyId).token().generation()
+                  != Math.addExact(before.token().generation(), 1)) {
+                throw new IllegalArgumentException(
+                    "Army retirement must advance its generation once");
+              }
+            });
+    next.armies()
+        .forEach(
+            (armyId, army) -> {
+              if (!previous.armies().containsKey(armyId)) {
+                if (previous.tombstones().containsKey(armyId)
+                    || receiptTargets(previous, armyId)
+                    || army.token().generation() != 1) {
+                  throw new IllegalArgumentException("Invalid Army creation or retired UUID reuse");
+                }
+              }
+            });
+    next.tombstones()
+        .forEach(
+            (armyId, tombstone) -> {
+              if (!previous.tombstones().containsKey(armyId)
+                  && !previous.armies().containsKey(armyId)) {
+                throw new IllegalArgumentException("New tombstone requires a live predecessor");
+              }
+            });
+    validateNewReceipt(previous, next);
+    ArmyPaidState.validateCommit(previous, next);
+    ArmyBattleState.validateCommit(previous, next);
+    ArmySkillState.validateCommit(previous, next);
+    ArmyNationClosureState.validateCommit(previous, next);
+  }
+
+  private static void validateNewReceipt(
+      ArmyAuthoritySnapshot previous, ArmyAuthoritySnapshot next) {
+    List<ArmyLogisticsReceipt> added =
+        next.receipts().entrySet().stream()
+            .filter(entry -> !previous.receipts().containsKey(entry.getKey()))
+            .map(Map.Entry::getValue)
+            .toList();
+    if (added.isEmpty()) return;
+    if (added.size() != 1) {
+      throw new IllegalArgumentException("One Army commit may add only one logistics receipt");
+    }
+    ArmyLogisticsReceipt receipt = added.getFirst();
+    ArmySnapshot before = previous.armies().get(receipt.armyId());
+    ArmySnapshot after = next.armies().get(receipt.armyId());
+    if (receipt.legacy()
+        || before == null
+        || after == null
+        || !receipt.incarnation().equals(before.token().incarnation())
+        || !receipt.nationId().equals(before.nationId())
+        || after.token().generation() != Math.addExact(before.token().generation(), 1)) {
+      throw new IllegalArgumentException("New supply receipt requires a bound Army successor");
+    }
+    int applied = Math.min(receipt.requestedPoints(), 100 - before.supply());
+    if (receipt.appliedPoints() != applied || after.supply() != before.supply() + applied) {
+      throw new IllegalArgumentException("Supply receipt does not match its exact capped effect");
+    }
+    ArmySnapshot expected =
+        new ArmySnapshot(
+            after.token(),
+            before.nationId(),
+            before.type(),
+            before.soldiers(),
+            before.health(),
+            before.morale(),
+            before.position(),
+            before.state(),
+            before.supply() + applied,
+            before.supplyConsumptionRemainder(),
+            before.createdAt(),
+            after.lastUpdated());
+    if (!expected.equals(after)
+        || !previous.tombstones().equals(next.tombstones())
+        || previous.armies().size() != next.armies().size()) {
+      throw new IllegalArgumentException("Supply receipt commit may change only its Army supply");
+    }
+    previous
+        .armies()
+        .forEach(
+            (armyId, army) -> {
+              if (!armyId.equals(receipt.armyId()) && !army.equals(next.armies().get(armyId))) {
+                throw new IllegalArgumentException("Supply receipt commit changed another Army");
+              }
+            });
+  }
+
+  private static void requireRetainedRecords(
+      ArmyAuthoritySnapshot previous, ArmyAuthoritySnapshot next) {
+    previous
+        .tombstones()
+        .forEach(
+            (armyId, tombstone) -> {
+              if (!tombstone.equals(next.tombstones().get(armyId))
+                  || next.armies().containsKey(armyId)) {
+                throw new IllegalArgumentException("Army tombstone is immutable and permanent");
+              }
+            });
+    previous
+        .receipts()
+        .forEach(
+            (requestId, receipt) -> {
+              if (!receipt.equals(next.receipts().get(requestId))) {
+                throw new IllegalArgumentException("Army receipt is immutable and permanent");
+              }
+            });
+  }
+
+  private static boolean receiptTargets(ArmyAuthoritySnapshot image, UUID armyId) {
+    return image.receipts().values().stream().anyMatch(receipt -> receipt.armyId().equals(armyId));
+  }
+
+  private static void requireIdentity(ArmySnapshot before, ArmySnapshot after) {
+    if (!before.token().armyId().equals(after.token().armyId())
+        || !before.token().incarnation().equals(after.token().incarnation())
+        || !before.nationId().equals(after.nationId())
+        || before.type() != after.type()
+        || !before.createdAt().equals(after.createdAt())) {
+      throw new IllegalArgumentException("Army immutable identity changed");
+    }
+  }
+
+  private static void requireIdentity(ArmySnapshot before, ArmyTombstone after) {
+    if (!before.token().armyId().equals(after.token().armyId())
+        || !before.token().incarnation().equals(after.token().incarnation())
+        || !before.nationId().equals(after.nationId())
+        || before.type() != after.type()
+        || !before.createdAt().equals(after.createdAt())) {
+      throw new IllegalArgumentException("Army retirement changed immutable identity");
+    }
+  }
+}
diff --git a/src/main/java/dev/starcore/starcore/module/army/storage/authority/ArmyAuthorityStorage.java b/src/main/java/dev/starcore/starcore/module/army/storage/authority/ArmyAuthorityStorage.java
