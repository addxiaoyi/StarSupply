+  private static List<Map.Entry<UUID, byte[]>> entries(
+      ArmyNationClosure closure, Properties properties) {
+    List<Map.Entry<UUID, byte[]>> entries = new ArrayList<>();
+    for (UUID armyId : new TreeMap<>(closure.retirements()).keySet()) {
+      entries.add(Map.entry(armyId, body(properties.getProperty("armyTombstone." + armyId))));
+    }
+    return entries;
+  }
+
+  private static String rawRow(ArmyNationClosure closure, List<Map.Entry<UUID, byte[]>> retirements)
+      throws Exception {
+    return rawRow(
+        closure.operationId(),
+        closure.nationId(),
+        closure.acceptedAt(),
+        closure.retiredAt(),
+        retirements);
+  }
+
+  private static String rawRow(
+      UUID operationId,
+      UUID nationId,
+      Instant acceptedAt,
+      Instant retiredAt,
+      List<Map.Entry<UUID, byte[]>> retirements)
+      throws Exception {
+    var buffer = new ByteArrayOutputStream();
+    try (var output = new DataOutputStream(buffer)) {
+      output.writeInt(0x41524D59);
+      output.writeByte(1);
+      output.writeByte(8);
+      writeUuid(output, operationId);
+      writeUuid(output, nationId);
+      writeInstant(output, acceptedAt);
+      output.writeBoolean(retiredAt != null);
+      if (retiredAt != null) writeInstant(output, retiredAt);
+      output.writeInt(retirements.size());
+      for (var retirement : retirements) {
+        writeUuid(output, retirement.getKey());
+        output.write(retirement.getValue());
+      }
+    }
+    return Base64.getEncoder().encodeToString(buffer.toByteArray());
+  }
+
+  private static void writeUuid(DataOutputStream output, UUID value) throws Exception {
+    output.writeLong(value.getMostSignificantBits());
+    output.writeLong(value.getLeastSignificantBits());
+  }
+
+  private static void writeInstant(DataOutputStream output, Instant value) throws Exception {
+    output.writeLong(value.getEpochSecond());
+    output.writeInt(value.getNano());
+  }
+
+  private static byte[] body(String row) {
+    var bytes = bytes(row);
+    return Arrays.copyOfRange(bytes, ROW_HEADER_BYTES, bytes.length);
+  }
+
+  private static byte[] bytes(String row) {
+    return Base64.getDecoder().decode(row);
+  }
+
+  private static void assertRejectsRow(Properties original, byte[] row) {
+    var malformed = copy(original);
+    malformed.setProperty(CLOSURE_KEY, Base64.getEncoder().encodeToString(row));
+    assertThrows(IllegalArgumentException.class, () -> ArmyAuthorityCodec.decode(malformed));
+  }
+
+  private static Properties copy(Properties original) {
+    var copy = new Properties();
+    copy.putAll(original);
+    return copy;
+  }
+
+  private static ArmySnapshot army(UUID armyId, UUID nationId, int supply) {
+    return new ArmySnapshot(
+        new ArmyToken(armyId, new UUID(2, armyId.getLeastSignificantBits()), 1),
+        nationId,
+        ArmyType.INFANTRY,
+        42,
+        73.5,
+        64.25,
+        new ArmyPosition(null, "unresolved-world", 12.5, 68, -9.25, 37.5f, -16.25f),
+        ArmyState.MARCHING,
+        supply,
+        37,
+        ACCEPTED.minusSeconds(60),
+        ACCEPTED.minusSeconds(1));
+  }
+}
