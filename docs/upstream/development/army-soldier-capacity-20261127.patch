+    var cancelled = resolved(pending, ArmyBattleSession.cancelled(request(pending), ACCEPTED));
+    var complete = resolved(pending, completed(pending, false, false));
+    byte[] pendingRow = row(pending);
+    byte[] cancelledRow = row(cancelled);
+    byte[] completeRow = row(complete);
+    assertEquals(pendingRow.length, cancelledRow.length);
+    assertEquals(pendingRow.length, completeRow.length);
+
+    int phaseOffset = -1;
+    for (int offset = 0; offset < pendingRow.length; offset++) {
+      if (pendingRow[offset] != cancelledRow[offset]) {
+        assertEquals(-1, phaseOffset);
+        phaseOffset = offset;
+      }
+    }
+    assertTrue(phaseOffset >= 0);
+    assertEquals(0, pendingRow[phaseOffset]);
+    assertEquals(1, completeRow[phaseOffset]);
+    assertEquals(2, cancelledRow[phaseOffset]);
+
+    for (int offset : new int[] {phaseOffset + 1, pendingRow.length - 1}) {
+      byte[] corrupt = row(pending);
+      corrupt[offset] ^= 1;
+      rejectsRow(pending, corrupt);
+    }
+    byte[] unknownPhase = row(pending);
+    unknownPhase[phaseOffset] = 3;
+    rejectsRow(pending, unknownPhase);
+    rejectsRow(pending, Arrays.copyOf(pendingRow, pendingRow.length - 1));
+    rejectsRow(pending, Arrays.copyOf(pendingRow, pendingRow.length + 1));
+    rejectsRow(complete, Arrays.copyOf(completeRow, completeRow.length + 1));
+  }
