+package dev.starcore.starcore.module.army.model.authority;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+import java.nio.charset.StandardCharsets;
+import java.util.Base64;
+import org.junit.jupiter.api.Test;
+
+class ArmyMigrationEvidenceTest {
+  @Test
+  void sourceDecodeChecksSmallEncodedAndPredictedDecodedBudgetsBeforeAllocation() {
+    byte[] source = "source".getBytes(StandardCharsets.UTF_8);
+    String encoded = Base64.getEncoder().encodeToString(source);
+    assertArrayEquals(source, ArmyMigrationEvidence.decodeSourcePayload(encoded, source.length));
+    assertThrows(
+        IllegalArgumentException.class,
+        () -> ArmyMigrationEvidence.decodeSourcePayload(encoded, source.length - 1));
+    assertThrows(
+        IllegalArgumentException.class, () -> ArmyMigrationEvidence.decodeSourcePayload("AAAA", 1));
+    assertArrayEquals(new byte[0], ArmyMigrationEvidence.decodeSourcePayload("", 0));
+  }
+
+  @Test
+  void sourceDecodeRejectsMissingPaddingInvalidCharactersAndNonzeroPaddingBits() {
+    assertArrayEquals(new byte[] {1}, ArmyMigrationEvidence.decodeSourcePayload("AQ==", 1));
+    for (String invalid : new String[] {"AQ", "AR==", "AAB=", "A===", "AQ==\n", "!!!!"}) {
+      assertThrows(
+          IllegalArgumentException.class,
+          () -> ArmyMigrationEvidence.decodeSourcePayload(invalid, 8));
+    }
+  }
+}
