+package dev.starcore.starcore.module.army.storage.authority;
+
+import static org.assertj.core.api.Assertions.*;
+
+import java.math.BigDecimal;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Path;
+import java.time.Instant;
+import java.util.Arrays;
+import java.util.Properties;
+import java.util.UUID;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+
+class ArmyLegacyImporterTest {
+  @TempDir Path root;
+  final UUID armyId = UUID.randomUUID();
+  final UUID nationId = UUID.randomUUID();
+
+  ArmyAuthorityStorage storage(boolean sql) throws Exception {
+    var directory = root.resolve("army");
+    return sql
+        ? new ArmySqlAuthorityStorage(
+            directory, ArmyAuthorityStorageTest.source("jdbc:sqlite:" + root.resolve("import.db")))
+        : new ArmyFileAuthorityStorage(directory);
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void baselinePreservesExactRawSourceReceiptsUnresolvedWorldAndStableInferredTimes(boolean sql)
+      throws Exception {
+    var records = new Properties();
+    records.setProperty(
+        armyId.toString(), ArmyAuthorityStorageTest.legacyUnit(armyId, nationId, 75).toString());
+    UUID requestId = UUID.randomUUID();
+    String receipt = armyId + "|" + nationId + "|100|0";
+    records.setProperty("logistics-supply:" + requestId, receipt);
+    byte[] source = ArmyAuthorityStorageTest.bytes(records);
+    byte[] expectedSource = source.clone();
+    var imported = ArmyLegacyImporter.inspect(source, "actual-configured-persistence-source");
+    assertThat(imported.ready()).isTrue();
+    assertThat(imported.diagnostics()).isEmpty();
+    assertThat(imported.sourceBytes()).isEqualTo(expectedSource);
+    source[0] ^= 1;
+    var returned = imported.sourceBytes();
+    returned[0] ^= 1;
+    assertThat(imported.sourceBytes()).isEqualTo(expectedSource);
+    var storage = storage(sql);
+    var baseline = storage.initializeFromLegacy(imported);
+    var army = baseline.armies().get(armyId);
+    assertThat(army.position().worldId()).isNull();
+    assertThat(army.position().worldName()).isEqualTo("unresolved-legacy-world");
+    assertThat(army.position().yaw()).isZero();
+    assertThat(army.position().pitch()).isZero();
+    assertThat(army.lastUpdated()).isEqualTo(Instant.ofEpochMilli(1700000000123L));
+    assertThat(army.createdAt()).isEqualTo(army.lastUpdated());
+    assertThat(army.supplyConsumptionRemainder()).isZero();
+    assertThat(baseline.migration().sourceBytes()).isEqualTo(expectedSource);
+    assertThat(baseline.migration().sourceSha256()).isEqualTo(imported.sourceSha256());
+    assertThat(baseline.migration().rawRecords().get(armyId.toString()))
+        .isEqualTo(records.getProperty(armyId.toString()));
+    assertThat(baseline.migration().rawRecords().get("logistics-supply:" + requestId))
+        .isEqualTo(receipt);
+    assertThat(baseline.migration().inferences())
+        .containsEntry("army." + armyId + ".lastUpdated", "legacy-missing:createdAt")
+        .containsEntry("army." + armyId + ".supplyConsumptionRemainder", "legacy-missing:0")
+        .containsEntry("army." + armyId + ".yaw", "legacy-missing:0")
+        .containsEntry("army." + armyId + ".pitch", "legacy-missing:0");
+    var persistedReceipt = baseline.receipts().get(requestId);
+    assertThat(persistedReceipt.requestId()).isEqualTo(requestId);
+    assertThat(persistedReceipt.armyId()).isEqualTo(armyId);
+    assertThat(persistedReceipt.nationId()).isEqualTo(nationId);
+    assertThat(persistedReceipt.requestedPoints()).isEqualTo(100);
+    assertThat(persistedReceipt.appliedPoints()).isZero();
+    assertThat(persistedReceipt.incarnation()).isNull();
+    assertThat(storage(sql).load()).isEqualTo(baseline);
+  }
+
+  @Test
+  void knownTypeAndStateAliasesRecordCanonicalizationInferences() throws Exception {
+    var records = new Properties();
+    var unit = ArmyAuthorityStorageTest.legacyUnit(armyId, nationId, 75);
+    records.setProperty(armyId.toString(), unit.toString());
+    var canonical =
+        ArmyLegacyImporter.inspect(
+            ArmyAuthorityStorageTest.bytes(records), "canonical-legacy-source");
+    assertThat(canonical.ready()).isTrue();
+    assertThat(canonical.baseline().orElseThrow().migration().inferences())
+        .doesNotContainKeys("army." + armyId + ".type", "army." + armyId + ".state");
+
+    unit.addProperty("type", "INFANTRY");
+    unit.addProperty("state", "STATIONARY");
+    records.setProperty(armyId.toString(), unit.toString());
+    var imported =
+        ArmyLegacyImporter.inspect(ArmyAuthorityStorageTest.bytes(records), "legacy-source");
+    assertThat(imported.ready()).isTrue();
+    var baseline = imported.baseline().orElseThrow();
+    assertThat(baseline.armies().get(armyId).type().key()).isEqualTo("infantry");
+    assertThat(baseline.armies().get(armyId).state().key()).isEqualTo("stationary");
+    assertThat(baseline.migration().inferences())
+        .containsEntry("army." + armyId + ".type", "legacy-known-alias:INFANTRY->infantry")
+        .containsEntry("army." + armyId + ".state", "legacy-known-alias:STATIONARY->stationary");
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void validDestroyedLegacyUnitBecomesGenerationOneTombstoneAndOrphanReceiptSurvives(boolean sql)
+      throws Exception {
+    var records = new Properties();
+    var destroyed = ArmyAuthorityStorageTest.legacyUnit(armyId, nationId, 0);
+    destroyed.addProperty("lastUpdated", 1700000000456L);
+    records.setProperty(armyId.toString(), destroyed.toString());
+    var orphanId = UUID.randomUUID();
+    var requestId = UUID.randomUUID();
+    records.setProperty("logistics-supply:" + requestId, orphanId + "|" + nationId + "|10|10");
+    var imported =
+        ArmyLegacyImporter.inspect(ArmyAuthorityStorageTest.bytes(records), "legacy-source");
+    assertThat(imported.ready()).isTrue();
+    var baseline = storage(sql).initializeFromLegacy(imported);
+    assertThat(baseline.armies()).isEmpty();
+    assertThat(baseline.tombstones().get(armyId).token().generation()).isEqualTo(1);
+    assertThat(baseline.tombstones().get(armyId).retiredAt())
+        .isEqualTo(Instant.ofEpochMilli(1700000000456L));
+    assertThat(baseline.tombstones().get(armyId).reason()).isEqualTo("LEGACY_DESTROYED");
+    assertThat(baseline.receipts().get(requestId).armyId()).isEqualTo(orphanId);
+    assertThat(storage(sql).load()).isEqualTo(baseline);
+    assertThatThrownBy(() -> storage(sql).initializeFromLegacy(imported))
+        .hasMessageContaining("reimport is forbidden");
+  }
+
+  @ParameterizedTest
+  @ValueSource(
+      strings = {
+        "ID_MISMATCH",
+        "NATION_MISSING",
+        "UNKNOWN_KEY",
+        "DUPLICATE_JSON",
+        "FRACTIONAL_SOLDIERS",
+        "NONFINITE",
+        "OUT_OF_RANGE",
+        "BAD_RECEIPT",
+        "AMBIGUOUS_OWNER",
+        "UNKNOWN_FIELD",
+        "DESTROYED_BAD_POSITION"
+      })
+  void anyUnsafeRowPreservesEverySourceByteAndBlocksTheWholeBaseline(String failure)
+      throws Exception {
+    var records = new Properties();
+    var unit = ArmyAuthorityStorageTest.legacyUnit(armyId, nationId, 50);
+    switch (failure) {
+      case "ID_MISMATCH" -> unit.addProperty("id", UUID.randomUUID().toString());
+      case "NATION_MISSING" -> unit.remove("nationId");
+      case "UNKNOWN_KEY" -> records.setProperty("opaque-ownership", "{\"soldiers\":100}");
+      case "FRACTIONAL_SOLDIERS" -> unit.addProperty("soldiers", new BigDecimal("10.5"));
+      case "NONFINITE" -> unit.addProperty("health", new BigDecimal("1e9999"));
+      case "OUT_OF_RANGE" -> unit.addProperty("health", 101);
+      case "BAD_RECEIPT" -> records.setProperty("logistics-supply:" + UUID.randomUUID(), "bad");
+      case "AMBIGUOUS_OWNER" ->
+          records.setProperty(
+              "logistics-supply:" + UUID.randomUUID(), armyId + "|" + UUID.randomUUID() + "|10|5");
+      case "UNKNOWN_FIELD" -> unit.addProperty("unrecognized-effect", true);
+      case "DESTROYED_BAD_POSITION" -> {
+        unit.addProperty("soldiers", 0);
+        unit.getAsJsonObject("location").addProperty("x", "not-a-number");
+      }
+      case "DUPLICATE_JSON" -> {}
+      default -> throw new IllegalArgumentException(failure);
+    }
+    String value = unit.toString();
+    if (failure.equals("DUPLICATE_JSON"))
+      value = value.substring(0, value.length() - 1) + ",\"id\":\"" + armyId + "\"}";
+    records.setProperty(armyId.toString(), value);
+    byte[] source = ArmyAuthorityStorageTest.bytes(records);
+    var imported = ArmyLegacyImporter.inspect(source, "actual-legacy-source");
+    assertThat(imported.readiness()).isEqualTo(ArmyLegacyImporter.Readiness.NOT_READY);
+    assertThat(imported.baseline()).isEmpty();
+    assertThat(imported.diagnostics()).isNotEmpty();
+    assertThat(imported.sourceBytes()).isEqualTo(source);
+    assertThat(imported.rawRecords().get(armyId.toString())).isEqualTo(value);
+    assertThatThrownBy(() -> storage(false).initializeFromLegacy(imported))
+        .hasMessageContaining("not ready");
+    assertThat(storage(false).load().initialized()).isFalse();
+  }
+
+  @Test
+  void duplicatePropertiesRemainAvailableAsExactRawEvidenceAndNeverProduceAnImage() {
+    byte[] source = "same=value-one\nsame=value-two\n".getBytes(StandardCharsets.ISO_8859_1);
+    var imported = ArmyLegacyImporter.inspect(source, "ambiguous-properties-source");
+    assertThat(imported.ready()).isFalse();
+    assertThat(imported.diagnostics())
+        .anyMatch(value -> value.contains("Duplicate legacy property"));
+    assertThat(imported.sourceBytes()).isEqualTo(source);
+    assertThat(imported.baseline()).isEmpty();
+  }
+
+  @Test
+  void sourceRecordAndRowBoundsFailBeforeAnyPublicationWithoutDiscardingTheInput()
+      throws Exception {
+    var records = new Properties();
+    records.setProperty(
+        armyId.toString(), ArmyAuthorityStorageTest.legacyUnit(armyId, nationId, 50).toString());
+    byte[] source = ArmyAuthorityStorageTest.bytes(records);
+    byte[] original = Arrays.copyOf(source, source.length);
+    assertThatThrownBy(
+            () ->
+                ArmyLegacyImporter.inspect(
+                    source,
+                    "too-large-source",
+                    new ArmyLegacyImporter.Limits(source.length - 1, 1, 4096)))
+        .hasMessageContaining("byte limit");
+    var recordLimited =
+        ArmyLegacyImporter.inspect(
+            source, "too-many-records", new ArmyLegacyImporter.Limits(source.length, 0, 4096));
+    assertThat(recordLimited.ready()).isFalse();
+    assertThat(recordLimited.sourceBytes()).isEqualTo(original);
+    var rowLimited =
+        ArmyLegacyImporter.inspect(
+            source, "too-large-row", new ArmyLegacyImporter.Limits(source.length, 1, 4));
+    assertThat(rowLimited.ready()).isFalse();
+    assertThat(rowLimited.sourceBytes()).isEqualTo(original);
+    assertThat(source).isEqualTo(original);
+    assertThat(storage(false).load().initialized()).isFalse();
+  }
+
+  @Test
+  void configurableSourceLimitCanOnlyNarrowTheMigrationEvidenceHardBound() {
+    int hardLimit =
+        dev.starcore.starcore.module.army.model.authority.ArmyMigrationEvidence.MAX_SOURCE_BYTES;
+    assertThat(ArmyLegacyImporter.Limits.defaults().maximumSourceBytes()).isEqualTo(hardLimit);
+    assertThatThrownBy(() -> new ArmyLegacyImporter.Limits(hardLimit + 1, 1, 1))
+        .hasMessageContaining("import limits");
+    assertThatThrownBy(() -> new ArmyLegacyImporter.Limits(-1, 1, 1))
+        .hasMessageContaining("import limits");
+    var restricted =
+        ArmyLegacyImporter.inspect(
+            new byte[0], "empty-source", new ArmyLegacyImporter.Limits(0, 0, 1));
+    assertThat(restricted.ready()).isTrue();
+  }
+}
