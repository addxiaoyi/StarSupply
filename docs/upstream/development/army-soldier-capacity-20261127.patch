--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/module/army/storage/authority/ArmyPaidState.java
@@ -0,0 +1,196 @@
+package dev.starcore.starcore.module.army.storage.authority;
+
+import dev.starcore.starcore.module.army.model.authority.ArmyAuthoritySnapshot;
+import dev.starcore.starcore.module.army.model.authority.ArmyPaidOperation;
+import dev.starcore.starcore.module.army.model.authority.ArmyPaidRequest;
+import dev.starcore.starcore.module.army.model.authority.ArmySnapshot;
+import dev.starcore.starcore.module.army.model.authority.ArmySoldierCapacity;
+import dev.starcore.starcore.module.treasury.NationDebitService;
+import java.time.Instant;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.UUID;
+
+final class ArmyPaidState {
+  private ArmyPaidState() {}
+
+  static void validate(ArmyAuthoritySnapshot image) {
+    var creationTargets = new HashSet<UUID>();
+    var pendingTargets = new HashSet<UUID>();
+    for (var entry : image.paidOperations().entrySet()) {
+      var operation = entry.getValue();
+      var request = operation.request();
+      if (!entry.getKey().equals(request.operationId())
+          || image.receipts().containsKey(entry.getKey())) {
+        throw new IllegalArgumentException("Army paid operation identity is ambiguous");
+      }
+      if (request.kind() == ArmyPaidRequest.Kind.CREATE && !creationTargets.add(request.armyId())) {
+        throw new IllegalArgumentException("Paid Army creation identity has already been used");
+      }
+      if (operation.pending()) {
+        if (!pendingTargets.add(request.armyId())) {
+          throw new IllegalArgumentException("Army target already has a pending paid operation");
+        }
+        if (request.kind() == ArmyPaidRequest.Kind.CREATE) {
+          requireUnused(image, request.armyId());
+          long live =
+              image.armies().values().stream()
+                  .filter(army -> army.nationId().equals(request.nationId()))
+                  .count();
+          long reserved =
+              image.paidOperations().values().stream()
+                  .filter(
+                      other ->
+                          other.pending()
+                              && other.request().kind() == ArmyPaidRequest.Kind.CREATE
+                              && other.request().nationId().equals(request.nationId()))
+                  .count();
+          if (Math.addExact(live, reserved) > request.maximumNationArmies()) {
+            throw new IllegalArgumentException("Paid Army creation capacity is already reserved");
+          }
+          var capacity =
+              ArmySoldierCapacity.of(image, request.nationId(), request.maximumNationSoldiers());
+          if (capacity.committed() > capacity.maximum())
+            throw new IllegalArgumentException("Paid Army soldier capacity is already reserved");
+        } else if (!request.before().equals(image.armies().get(request.armyId()))) {
+          throw new IllegalArgumentException("Pending paid resupply target changed");
+        }
+      } else if (operation.applied()) {
+        requireEffectIdentity(image, request.after());
+      } else if (request.kind() == ArmyPaidRequest.Kind.CREATE) {
+        requireUnused(image, request.armyId());
+      } else {
+        requireEffectIdentity(image, request.before());
+      }
+    }
+  }
+
+  static long remainingRevisions(ArmyAuthoritySnapshot image) {
+    long remaining = 0;
+    for (var operation : image.paidOperations().values()) {
+      if (operation.pending()) {
+        remaining = Math.addExact(remaining, operation.cancellationRequested() ? 1 : 2);
+      }
+    }
+    return remaining;
+  }
+
+  static void validateObservation(ArmyAuthoritySnapshot previous, ArmyAuthoritySnapshot next) {
+    if (next.version() < previous.version()) {
+      throw new IllegalArgumentException("Army authority schema moved backwards");
+    }
+    previous
+        .paidOperations()
+        .forEach(
+            (operationId, before) -> {
+              var after = next.paidOperations().get(operationId);
+              if (after == null
+                  || !before.request().equals(after.request())
+                  || before.cancellationRequested() && !after.cancellationRequested()
+                  || !before.pending() && !before.equals(after)) {
+                throw new IllegalArgumentException(
+                    "Army paid request or decision was lost or replaced");
+              }
+            });
+  }
+
+  static void validateCommit(ArmyAuthoritySnapshot previous, ArmyAuthoritySnapshot next) {
+    var changed =
+        next.paidOperations().entrySet().stream()
+            .filter(
+                entry -> !entry.getValue().equals(previous.paidOperations().get(entry.getKey())))
+            .toList();
+    if (changed.isEmpty()) return;
+    if (changed.size() != 1
+        || !previous.receipts().equals(next.receipts())
+        || !previous.tombstones().equals(next.tombstones())
+        || !previous.battleSessions().equals(next.battleSessions())) {
+      throw new IllegalArgumentException(
+          "One Army commit may advance only one isolated paid operation");
+    }
+    var entry = changed.getFirst();
+    var before = previous.paidOperations().get(entry.getKey());
+    var after = entry.getValue();
+    var expectedArmies = new HashMap<>(previous.armies());
+    if (before == null) {
+      if (!after.pending() || after.cancellationRequested()) {
+        throw new IllegalArgumentException("New Army paid operation must start prepared");
+      }
+    } else if (!after.pending() && after.applied()) {
+      expectedArmies.put(after.request().armyId(), after.request().after());
+    }
+    if (!expectedArmies.equals(next.armies())) {
+      throw new IllegalArgumentException(
+          "Army paid decision and exact effect must commit together");
+    }
+  }
+
+  static ArmyAuthoritySnapshot maximumCompletionImage(ArmyAuthoritySnapshot image) {
+    if (image.paidOperations().values().stream().noneMatch(ArmyPaidOperation::pending))
+      return image;
+    var armies = new HashMap<>(image.armies());
+    var operations = new HashMap<>(image.paidOperations());
+    image
+        .paidOperations()
+        .forEach(
+            (operationId, operation) -> {
+              if (operation.pending()) {
+                var request = operation.request();
+                armies.put(request.armyId(), request.after());
+                operations.put(
+                    operationId,
+                    new ArmyPaidOperation(
+                        request,
+                        operation.cancellationRequested(),
+                        new NationDebitService.Receipt(
+                            request.debitRequest(),
+                            NationDebitService.Status.APPLIED,
+                            Instant.ofEpochMilli(1))));
+              }
+            });
+    return new ArmyAuthoritySnapshot(
+        true,
+        image.nationClosures().values().stream().anyMatch(closure -> closure.pending())
+            ? image.revision()
+            : Long.MAX_VALUE,
+        armies,
+        image.tombstones(),
+        image.receipts(),
+        image.migration(),
+        image.version(),
+        operations,
+        image.battleSessions(),
+        image.skillUses(),
+        image.nationClosures());
+  }
+
+  private static void requireUnused(ArmyAuthoritySnapshot image, UUID armyId) {
+    if (image.armies().containsKey(armyId)
+        || image.tombstones().containsKey(armyId)
+        || image.receipts().values().stream()
+            .anyMatch(receipt -> receipt.armyId().equals(armyId))) {
+      throw new IllegalArgumentException("Paid Army creation target is not unused");
+    }
+  }
+
+  private static void requireEffectIdentity(ArmyAuthoritySnapshot image, ArmySnapshot proof) {
+    var live = image.armies().get(proof.token().armyId());
+    var retired = image.tombstones().get(proof.token().armyId());
+    boolean valid =
+        live != null
+            ? live.token().incarnation().equals(proof.token().incarnation())
+                && live.token().generation() >= proof.token().generation()
+                && live.nationId().equals(proof.nationId())
+                && live.type() == proof.type()
+                && live.createdAt().equals(proof.createdAt())
+                && (live.token().generation() != proof.token().generation() || live.equals(proof))
+            : retired != null
+                && retired.token().incarnation().equals(proof.token().incarnation())
+                && retired.token().generation() > proof.token().generation()
+                && retired.nationId().equals(proof.nationId())
+                && retired.type() == proof.type()
+                && retired.createdAt().equals(proof.createdAt());
+    if (!valid)
+      throw new IllegalArgumentException("Paid Army effect identity or evidence disappeared");
+  }
+}
diff --git a/src/main/java/dev/starcore/starcore/module/army/storage/authority/ArmySkillState.java b/src/main/java/dev/starcore/starcore/module/army/storage/authority/ArmySkillState.java
