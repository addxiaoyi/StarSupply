+  private static Envelope envelope(List<OriginalTerm> terms) {
+    var war =
+        new ExactWar(
+            uuid(101),
+            ATTACKER,
+            DEFENDER,
+            DECLARED_AT,
+            List.of(nation(3), nation(5)),
+            List.of(nation(4)));
+    return new Envelope(
