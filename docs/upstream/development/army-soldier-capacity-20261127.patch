+  @Test
+  void rowAndEnvelopeReservationRetainsHistoryForEveryOrdinarySurvivalOutcome() throws Exception {
+    var owner = seed(false, root, 80);
+    owner.beginNationClosure(CLOSURE, ENEMY_NATION, TIME);
+    owner.useSkill(national(owner, 14, TIME.plusSeconds(1)));
+    var current = owner.snapshot();
+    var encoded = ArmyAuthorityCodec.encode(current);
+    int rowBudget =
+        encoded.stringPropertyNames().stream()
+            .filter(key -> key.startsWith("armyBattle."))
+            .mapToInt(key -> Base64.getDecoder().decode(encoded.getProperty(key)).length)
+            .max()
+            .orElseThrow();
+    assertThrows(
+        IllegalArgumentException.class,
+        () -> ArmyAuthorityCodec.encodeWithRowBudget(current, rowBudget - 1));
+    assertEquals(
+        current,
+        ArmyAuthorityCodec.decode(ArmyAuthorityCodec.encodeWithRowBudget(current, rowBudget)));
+    long envelope = capacity(current);
+    for (int outcome = 0; outcome < 16; outcome++) {
+      var first =
+          settled(current, BATTLE, (outcome & 1) != 0, (outcome & 2) != 0, current.revision() + 1);
+      ArmyAuthorityState.validateCommit(current, first);
+      var second =
+          settled(
+              first, OTHER_BATTLE, (outcome & 4) != 0, (outcome & 8) != 0, first.revision() + 1);
+      ArmyAuthorityState.validateCommit(first, second);
+      for (var image : List.of(first, second)) {
+        assertEquals(
+            image,
+            ArmyAuthorityCodec.decode(ArmyAuthorityCodec.encodeWithRowBudget(image, rowBudget)));
+        assertTrue(capacity(image) <= envelope);
+      }
+      var retired =
+          ArmyNationClosureState.maximumCompletionImage(second).withRevision(second.revision() + 1);
+      ArmyAuthorityState.validateCommit(second, retired);
+      assertTrue(capacity(retired) <= envelope);
+    }
+  }
