@@ -0,0 +1,381 @@
+package dev.starcore.starcore.module.army.runtime;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotSame;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+import dev.starcore.starcore.module.army.model.ArmyState;
+import dev.starcore.starcore.module.army.model.ArmyType;
+import dev.starcore.starcore.module.army.model.ArmyUnit;
+import dev.starcore.starcore.module.army.model.authority.ArmyPosition;
+import dev.starcore.starcore.module.army.model.authority.ArmySnapshot;
+import dev.starcore.starcore.module.army.model.authority.ArmyToken;
+import dev.starcore.starcore.module.army.runtime.ArmySnapshotViews.ArmyWorldUnavailableException;
+import dev.starcore.starcore.module.army.runtime.ArmySnapshotViews.LegacyWorldPolicy;
+import java.lang.reflect.Proxy;
+import java.time.Instant;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Optional;
+import java.util.UUID;
+import org.bukkit.Location;
+import org.bukkit.World;
+import org.junit.jupiter.api.Test;
+
+class ArmySnapshotViewsTest {
+  private static final UUID ARMY_ID = UUID.fromString("00000000-0000-0000-0000-000000000001");
+  private static final UUID NATION_ID = UUID.fromString("00000000-0000-0000-0000-000000000002");
+  private static final UUID WORLD_ID = UUID.fromString("00000000-0000-0000-0000-000000000003");
+  private static final UUID OTHER_WORLD_ID =
+      UUID.fromString("00000000-0000-0000-0000-000000000004");
+  private static final ArmyToken TOKEN =
+      new ArmyToken(ARMY_ID, UUID.fromString("00000000-0000-0000-0000-000000000005"), 7);
+  private static final Instant CREATED_AT = Instant.parse("2026-11-27T12:34:56.123456789Z");
+  private static final Instant LAST_UPDATED = Instant.parse("2026-11-26T11:22:33.987654321Z");
+
+  @Test
+  void uuidResolutionPreservesEveryFieldAndFullTimestampPrecision() {
+    World world = world(WORLD_ID, "world");
+    TrackingResolver resolver = new TrackingResolver(world, null);
+    ArmySnapshot snapshot = snapshot(position(WORLD_ID, "world"));
+
+    ArmyUnit detached =
+        ArmySnapshotViews.toDetachedUnit(snapshot, resolver, LegacyWorldPolicy.REJECT_NAME_ONLY);
+
+    assertEquals(snapshot, ArmySnapshotViews.fromDetachedUnit(detached, TOKEN));
+    assertSame(world, detached.location().getWorld());
+    assertEquals(List.of(WORLD_ID), resolver.idLookups);
+    assertEquals(List.of(), resolver.nameLookups);
+    assertEquals(CREATED_AT, detached.createdAt());
+    assertEquals(LAST_UPDATED, detached.lastUpdated());
+    assertEquals(59, detached.supplyConsumptionRemainder());
+  }
+
+  @Test
+  void uuidResolutionAllowsRenamedWorldWithoutChangingSnapshot() {
+    World renamed = world(WORLD_ID, "renamed-world");
+    TrackingResolver resolver = new TrackingResolver(renamed, null);
+    ArmySnapshot snapshot = snapshot(position(WORLD_ID, "original-world"));
+
+    ArmyUnit detached =
+        ArmySnapshotViews.toDetachedUnit(snapshot, resolver, LegacyWorldPolicy.BY_EXACT_NAME);
+
+    assertSame(renamed, detached.location().getWorld());
+    assertEquals("original-world", snapshot.position().worldName());
+    assertEquals(
+        "renamed-world",
+        ArmySnapshotViews.fromDetachedUnit(detached, TOKEN).position().worldName());
+    assertEquals(List.of(WORLD_ID), resolver.idLookups);
+    assertEquals(List.of(), resolver.nameLookups);
+  }
+
+  @Test
+  void missingUuidDoesNotFallBackToMatchingName() {
+    TrackingResolver resolver = new TrackingResolver(null, world(WORLD_ID, "world"));
+    ArmySnapshot snapshot = snapshot(position(WORLD_ID, "world"));
+
+    ArmyWorldUnavailableException failure =
+        assertThrows(
+            ArmyWorldUnavailableException.class,
+            () ->
+                ArmySnapshotViews.toDetachedUnit(
+                    snapshot, resolver, LegacyWorldPolicy.BY_EXACT_NAME));
+
+    assertEquals(WORLD_ID, failure.worldId());
+    assertEquals("world", failure.worldName());
+    assertEquals(List.of(WORLD_ID), resolver.idLookups);
+    assertEquals(List.of(), resolver.nameLookups);
+    assertEquals(snapshot(position(WORLD_ID, "world")), snapshot);
+  }
+
+  @Test
+  void mismatchedUuidIsRejectedWithoutNameFallback() {
+    TrackingResolver resolver =
+        new TrackingResolver(world(OTHER_WORLD_ID, "world"), world(WORLD_ID, "world"));
+
+    ArmyWorldUnavailableException failure =
+        assertThrows(
+            ArmyWorldUnavailableException.class,
+            () ->
+                ArmySnapshotViews.toDetachedUnit(
+                    snapshot(position(WORLD_ID, "world")),
+                    resolver,
+                    LegacyWorldPolicy.BY_EXACT_NAME));
+
+    assertEquals(WORLD_ID, failure.worldId());
+    assertEquals("world", failure.worldName());
+    assertEquals(List.of(WORLD_ID), resolver.idLookups);
+    assertEquals(List.of(), resolver.nameLookups);
+  }
+
+  @Test
+  void nameOnlyWorldRequiresExplicitLegacyPolicy() {
+    TrackingResolver resolver = new TrackingResolver(null, world(WORLD_ID, "world"));
+
+    ArmyWorldUnavailableException failure =
+        assertThrows(
+            ArmyWorldUnavailableException.class,
+            () ->
+                ArmySnapshotViews.toDetachedUnit(
+                    snapshot(position(null, "world")),
+                    resolver,
+                    LegacyWorldPolicy.REJECT_NAME_ONLY));
+
+    assertNull(failure.worldId());
+    assertEquals("world", failure.worldName());
+    assertEquals(List.of(), resolver.idLookups);
+    assertEquals(List.of(), resolver.nameLookups);
+  }
+
+  @Test
+  void explicitNamePolicyResolvesOnlyExactName() {
+    World world = world(WORLD_ID, "Exact World");
+    TrackingResolver resolver = new TrackingResolver(null, world);
+    ArmySnapshot snapshot = snapshot(position(null, "Exact World"));
+
+    ArmyUnit detached =
+        ArmySnapshotViews.toDetachedUnit(snapshot, resolver, LegacyWorldPolicy.BY_EXACT_NAME);
+
+    assertSame(world, detached.location().getWorld());
+    assertEquals(List.of(), resolver.idLookups);
+    assertEquals(List.of("Exact World"), resolver.nameLookups);
+    assertNull(snapshot.position().worldId());
+  }
+
+  @Test
+  void nameLookupCannotReturnCaseInsensitiveAlias() {
+    TrackingResolver resolver = new TrackingResolver(null, world(WORLD_ID, "exact world"));
+
+    ArmyWorldUnavailableException failure =
+        assertThrows(
+            ArmyWorldUnavailableException.class,
+            () ->
+                ArmySnapshotViews.toDetachedUnit(
+                    snapshot(position(null, "Exact World")),
+                    resolver,
+                    LegacyWorldPolicy.BY_EXACT_NAME));
+
+    assertNull(failure.worldId());
+    assertEquals("Exact World", failure.worldName());
+    assertEquals(List.of(), resolver.idLookups);
+    assertEquals(List.of("Exact World"), resolver.nameLookups);
+  }
+
+  @Test
+  void missingLegacyWorldIsRejected() {
+    TrackingResolver resolver = new TrackingResolver(null, null);
+
+    assertThrows(
+        ArmyWorldUnavailableException.class,
+        () ->
+            ArmySnapshotViews.toDetachedUnit(
+                snapshot(position(null, "world")), resolver, LegacyWorldPolicy.BY_EXACT_NAME));
+
+    assertEquals(List.of(), resolver.idLookups);
+    assertEquals(List.of("world"), resolver.nameLookups);
+  }
+
+  @Test
+  void nullResolverResultIsUnavailableRatherThanAWorldlessLocation() {
+    ArmySnapshotViews.WorldResolver resolver =
+        new ArmySnapshotViews.WorldResolver() {
+          @Override
+          public Optional<World> byId(UUID worldId) {
+            return null;
+          }
+
+          @Override
+          public Optional<World> byName(String worldName) {
+            return null;
+          }
+        };
+
+    assertThrows(
+        ArmyWorldUnavailableException.class,
+        () ->
+            ArmySnapshotViews.toDetachedUnit(
+                snapshot(position(WORLD_ID, "world")),
+                resolver,
+                LegacyWorldPolicy.REJECT_NAME_ONLY));
+    assertThrows(
+        ArmyWorldUnavailableException.class,
+        () ->
+            ArmySnapshotViews.toDetachedUnit(
+                snapshot(position(null, "world")), resolver, LegacyWorldPolicy.BY_EXACT_NAME));
+  }
+
+  @Test
+  void materializedUnitsDoNotAliasLocationsOrSnapshotState() {
+    TrackingResolver resolver = new TrackingResolver(world(WORLD_ID, "world"), null);
+    ArmySnapshot snapshot = snapshot(position(WORLD_ID, "world"));
+    ArmyUnit first =
+        ArmySnapshotViews.toDetachedUnit(snapshot, resolver, LegacyWorldPolicy.REJECT_NAME_ONLY);
+    ArmyUnit second =
+        ArmySnapshotViews.toDetachedUnit(snapshot, resolver, LegacyWorldPolicy.REJECT_NAME_ONLY);
+
+    assertNotSame(first.location(), second.location());
+    first.location().setX(900.0);
+    first.location().setYaw(17.0f);
+    first.setState(ArmyState.ATTACKING);
+
+    assertEquals(-123.25, snapshot.position().x());
+    assertEquals(135.5f, snapshot.position().yaw());
+    assertEquals(ArmyState.SIEGING, snapshot.state());
+    assertEquals(-123.25, second.location().getX());
+    assertEquals(135.5f, second.location().getYaw());
+    assertEquals(ArmyState.SIEGING, second.state());
+    assertEquals(LAST_UPDATED, second.lastUpdated());
+  }
+
+  @Test
+  void captureUsesProvidedTokenAndRemainsDetachedAfterUnitMutation() {
+    Location location =
+        new Location(world(WORLD_ID, "world"), -123.25, 64.75, 987.5, 135.5f, -37.25f);
+    ArmyUnit unit = unit(17, 73.25, location);
+    ArmyToken replacement =
+        new ArmyToken(ARMY_ID, UUID.fromString("00000000-0000-0000-0000-000000000006"), 91);
+
+    ArmySnapshot captured = ArmySnapshotViews.fromDetachedUnit(unit, replacement);
+    location.setX(1234.0);
+    location.setPitch(9.5f);
+    unit.setState(ArmyState.MARCHING);
+
+    assertEquals(snapshot(position(WORLD_ID, "world")).withToken(replacement), captured);
+    assertSame(replacement, captured.token());
+    assertEquals(-123.25, captured.position().x());
+    assertEquals(-37.25f, captured.position().pitch());
+    assertEquals(LAST_UPDATED, captured.lastUpdated());
+  }
+
+  @Test
+  void captureRejectsDifferentArmyToken() {
+    ArmyUnit unit = unit(17, 73.25, new Location(world(WORLD_ID, "world"), 0, 64, 0));
+    ArmyToken other =
+        new ArmyToken(
+            UUID.fromString("00000000-0000-0000-0000-000000000007"), TOKEN.incarnation(), 1);
+
+    assertThrows(
+        IllegalArgumentException.class, () -> ArmySnapshotViews.fromDetachedUnit(unit, other));
+  }
+
+  @Test
+  void captureRejectsArmyWithNoSoldiers() {
+    ArmyUnit unit = unit(0, 73.25, new Location(world(WORLD_ID, "world"), 0, 64, 0));
+
+    assertThrows(
+        IllegalArgumentException.class, () -> ArmySnapshotViews.fromDetachedUnit(unit, TOKEN));
+  }
+
+  @Test
+  void captureRejectsArmyWithNoHealth() {
+    ArmyUnit unit = unit(17, 0, new Location(world(WORLD_ID, "world"), 0, 64, 0));
+
+    assertThrows(
+        IllegalArgumentException.class, () -> ArmySnapshotViews.fromDetachedUnit(unit, TOKEN));
+  }
+
+  @Test
+  void captureRejectsArmyWithNoWorld() {
+    ArmyUnit unit = unit(17, 73.25, new Location(null, 0, 64, 0));
+
+    assertThrows(
+        IllegalArgumentException.class, () -> ArmySnapshotViews.fromDetachedUnit(unit, TOKEN));
+  }
+
+  @Test
+  void conversionRequiresAllArguments() {
+    ArmySnapshot snapshot = snapshot(position(WORLD_ID, "world"));
+    TrackingResolver resolver = new TrackingResolver(world(WORLD_ID, "world"), null);
+    ArmyUnit unit = unit(17, 73.25, new Location(world(WORLD_ID, "world"), 0, 64, 0));
+
+    assertThrows(
+        NullPointerException.class,
+        () -> ArmySnapshotViews.toDetachedUnit(null, resolver, LegacyWorldPolicy.REJECT_NAME_ONLY));
+    assertThrows(
+        NullPointerException.class,
+        () -> ArmySnapshotViews.toDetachedUnit(snapshot, null, LegacyWorldPolicy.REJECT_NAME_ONLY));
+    assertThrows(
+        NullPointerException.class,
+        () -> ArmySnapshotViews.toDetachedUnit(snapshot, resolver, null));
+    assertThrows(NullPointerException.class, () -> ArmySnapshotViews.fromDetachedUnit(null, TOKEN));
+    assertThrows(NullPointerException.class, () -> ArmySnapshotViews.fromDetachedUnit(unit, null));
+  }
+
+  private static ArmyPosition position(UUID worldId, String worldName) {
+    return new ArmyPosition(worldId, worldName, -123.25, 64.75, 987.5, 135.5f, -37.25f);
+  }
+
+  private static ArmySnapshot snapshot(ArmyPosition position) {
+    return new ArmySnapshot(
+        TOKEN,
+        NATION_ID,
+        ArmyType.CAVALRY,
+        17,
+        73.25,
+        61.5,
+        position,
+        ArmyState.SIEGING,
+        42,
+        59,
+        CREATED_AT,
+        LAST_UPDATED);
+  }
+
+  private static ArmyUnit unit(int soldiers, double health, Location location) {
+    return new ArmyUnit(
+        ARMY_ID,
+        NATION_ID,
+        ArmyType.CAVALRY,
+        soldiers,
+        health,
+        61.5,
+        location,
+        ArmyState.SIEGING,
+        42,
+        CREATED_AT,
+        LAST_UPDATED,
+        59);
+  }
+
+  private static World world(UUID worldId, String worldName) {
+    return (World)
+        Proxy.newProxyInstance(
+            World.class.getClassLoader(),
+            new Class<?>[] {World.class},
+            (proxy, method, arguments) ->
+                switch (method.getName()) {
+                  case "getUID" -> worldId;
+                  case "getName" -> worldName;
+                  case "equals" -> proxy == arguments[0];
+                  case "hashCode" -> System.identityHashCode(proxy);
+                  case "toString" -> "World[" + worldId + "," + worldName + "]";
+                  default -> throw new UnsupportedOperationException(method.getName());
+                });
+  }
+
+  private static final class TrackingResolver implements ArmySnapshotViews.WorldResolver {
+    private final World byId;
+    private final World byName;
+    private final List<UUID> idLookups = new ArrayList<>();
+    private final List<String> nameLookups = new ArrayList<>();
+
+    private TrackingResolver(World byId, World byName) {
+      this.byId = byId;
+      this.byName = byName;
+    }
+
+    @Override
+    public Optional<World> byId(UUID worldId) {
+      idLookups.add(worldId);
+      return Optional.ofNullable(byId);
+    }
+
+    @Override
+    public Optional<World> byName(String worldName) {
+      nameLookups.add(worldName);
+      return Optional.ofNullable(byName);
+    }
+  }
+}
