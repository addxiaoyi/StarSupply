+  private static final class DebitProbe implements NationDebitService {
+    private final NationDebitService delegate;
+    private int queries;
+    private int applies;
+    private int cancels;
+    private Request lastApplied;
+    private Request lastCancelled;
+    private RuntimeException queryFailure;
+    private RuntimeException beforeApplyFailure;
+    private RuntimeException afterApplyFailure;
+    private RuntimeException afterCancelFailure;
+    private Receipt queriedOverride;
+    private Receipt returnedOverride;
+    private Runnable beforeCancel;
+
+    private DebitProbe(NationDebitService delegate) {
+      this.delegate = delegate;
+    }
+
+    @Override
+    public Receipt applyDebit(Request request) {
+      applies++;
+      lastApplied = request;
+      if (beforeApplyFailure != null) throw beforeApplyFailure;
+      var receipt = delegate.applyDebit(request);
+      if (afterApplyFailure != null) throw afterApplyFailure;
+      return returnedOverride == null ? receipt : returnedOverride;
+    }
+
+    @Override
+    public Optional<Receipt> debitReceipt(UUID operationId) {
+      queries++;
+      if (queryFailure != null) throw queryFailure;
+      return queriedOverride == null
+          ? delegate.debitReceipt(operationId)
+          : Optional.of(queriedOverride);
+    }
+
+    @Override
+    public Receipt cancelDebit(Request request) {
+      cancels++;
+      lastCancelled = request;
+      if (beforeCancel != null) beforeCancel.run();
+      var receipt = delegate.cancelDebit(request);
+      if (afterCancelFailure != null) throw afterCancelFailure;
+      return returnedOverride == null ? receipt : returnedOverride;
+    }
+  }
