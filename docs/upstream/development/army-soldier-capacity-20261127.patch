+        at,
+        10);
+  }
+
+  private static ArmyPaidRequest createPaid(UUID operation, Instant at) {
+    var original = army(NEW_ARMY, NATION);
+    var created =
+        new ArmySnapshot(
+            original.token(),
+            original.nationId(),
+            original.type(),
+            original.soldiers(),
+            original.health(),
+            original.morale(),
+            original.position(),
+            original.state(),
+            original.supply(),
+            original.supplyConsumptionRemainder(),
+            at,
+            at);
+    return new ArmyPaidRequest(
+        operation,
+        ACTOR,
+        ArmyPaidRequest.Kind.CREATE,
+        null,
+        created,
+        new BigDecimal("1.00"),
+        at,
+        10);
+  }
+
+  private static ArmySkillRequest skill(
+      ArmyAuthorityOwner owner, UUID operation, UUID nation, SkillType type, Instant at) {
+    var targets = new HashMap<UUID, ArmySnapshot>();
+    owner
+        .snapshot()
+        .armies()
+        .forEach(
+            (armyId, army) -> {
+              if (type == SkillType.SCOUT
+                  || type == SkillType.CAVALRY_CHARGE && armyId.equals(ARMY)
+                  || type != SkillType.CAVALRY_CHARGE && army.nationId().equals(nation)) {
+                targets.put(armyId, army);
+              }
+            });
+    return new ArmySkillRequest(
+        operation,
+        ACTOR,
+        nation,
+        type,
+        1,
+        1,
+        null,
+        at,
+        type == SkillType.SCOUT ? ORIGIN : null,
+        targets);
+  }
+
+  private static ArmySnapshot stats(ArmySnapshot before, int soldiers, double health) {
+    return new ArmySnapshot(
+        before.token(),
+        before.nationId(),
+        before.type(),
+        soldiers,
+        health,
+        before.morale(),
+        before.position(),
+        before.state(),
+        before.supply(),
+        before.supplyConsumptionRemainder(),
+        before.createdAt(),
+        before.lastUpdated());
+  }
