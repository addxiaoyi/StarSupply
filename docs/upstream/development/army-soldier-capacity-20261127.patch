+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void nationwideSkillCommitsAllBattlesAndOrdinaryTargetsTogetherAndReplaysAfterCancellation(
+      boolean sqlite) throws Exception {
+    var owner = seed(sqlite, root, 80);
+    var before = owner.snapshot();
+    var request = national(owner, 1, TIME.plusSeconds(1));
+    var proof = owner.useSkill(request);
+    var after = owner.snapshot();
+    assertEquals(before.revision() + 1, after.revision());
+    assertEquals(6, after.version());
+    assertEquals(3, proof.effects().size());
+    assertEquals(1, after.battleSessions().get(BATTLE).interventions().size());
+    assertEquals(1, after.battleSessions().get(OTHER_BATTLE).interventions().size());
+    for (var effect : proof.effects().values())
+      assertEquals(effect, after.armies().get(effect.token().armyId()));
+    assertEquals(before.armies().get(id(2)), after.armies().get(id(2)));
+    assertEquals(before.armies().get(id(4)), after.armies().get(id(4)));
+    assertEquals(after, storage(sqlite, root, UNBOUNDED).load());
+    var restarted = reopen(sqlite, root, UNBOUNDED);
+    restarted.cancelBattle(BATTLE, TIME.plusSeconds(2));
+    restarted.cancelBattle(OTHER_BATTLE, TIME.plusSeconds(2));
+    var terminal = restarted.snapshot();
+    assertEquals(proof, restarted.useSkill(request));
+    assertEquals(terminal, restarted.snapshot());
+    assertEquals(50, restarted.army(id(1)).orElseThrow().morale());
+    assertEquals(50, restarted.army(id(3)).orElseThrow().morale());
+    assertEquals(terminal, storage(sqlite, root, UNBOUNDED).load());
+    ArmyAuthorityState.validateObservation(before, terminal);
