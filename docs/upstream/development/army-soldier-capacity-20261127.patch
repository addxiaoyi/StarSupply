+
+  @Test
+  void terminalMayBeDecidedAtTheExactAcceptanceBoundary() {
+    var request = request();
+    var resolution = ArmyBattleSession.cancelled(request, ACCEPTED);
+
+    assertEquals(ACCEPTED, resolution.decidedAt());
+    assertDoesNotThrow(() -> new ArmyBattleSession(request, resolution));
