+    try (var f = new ArmyRuntimeTestFixture(root, sql)) {
+      var army = f.add();
+      var enemy = f.add(f.other, 100, 100, 75, 40);
+      var session =
+          f.service.startBattle(
+              UUID.randomUUID(), UUID.randomUUID(), army.token().armyId(), enemy.token().armyId());
+      var commander = commander(f, f.nation.founderId());
+      commander.useSkill(f.player(f.nation), SkillType.TACTICAL_RETREAT, army.token().armyId());
+      var terminal = f.service.finishBattle(session.request().sessionId());
+      assertEquals(ArmyBattleSession.Status.RETREATED, terminal.resolution().status());
+      assertTrue(terminal.battleResult().isEmpty());
+      assertEquals(ArmyState.MARCHING, f.current(army.token().armyId()).state());
+      assertEquals(ArmyState.STATIONARY, f.current(enemy.token().armyId()).state());
+      assertEquals(3, f.current(army.token().armyId()).token().generation());
+      var before = f.owner.snapshot();
+      f.service.finishBattle(session.request().sessionId());
+      assertEquals(before, f.owner.snapshot());
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void combatUsesLatestReinforcedHeadsAndComparesTotalHealth(boolean sql) throws Exception {
+    try (var f = new ArmyRuntimeTestFixture(root, sql)) {
+      var army = f.add(f.nation, 100, 73.5, 75, 40);
+      var enemy = f.add(f.other, 100, 73.5, 75, 40);
+      var session =
+          f.service.startBattle(
+              UUID.randomUUID(), UUID.randomUUID(), army.token().armyId(), enemy.token().armyId());
+      commander(f, f.nation.founderId())
+          .useSkill(f.player(f.nation), SkillType.REINFORCE, army.token().armyId());
+      var terminal = f.service.finishBattle(session.request().sessionId());
+      assertEquals(ArmyBattleSession.Status.COMPLETED, terminal.resolution().status());
+      var result = terminal.battleResult().orElseThrow();
+      assertEquals(
+          130 - terminal.resolution().attackerAfter().soldiers(), result.attackerCasualties());
+      assertTrue(terminal.resolution().attackerAfter().health() > 73.5);
+      assertTrue(
+          terminal.resolution().attackerAfter().soldiers()
+                  * terminal.resolution().attackerAfter().health()
+              <= 130 * 73.5);
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void uuidHashCollisionsHaveIndependentCooldowns(boolean sql) throws Exception {
+    try (var f = new ArmyRuntimeTestFixture(root, sql)) {
+      UUID a = new UUID(0, 1), b = new UUID(1, 0);
+      assertEquals(a.hashCode(), b.hashCode());
+      var first = new Nation(NationId.random(), "CollisionOne", a, "One");
+      var second = new Nation(NationId.random(), "CollisionTwo", b, "Two");
+      f.catalog.put(first.id(), first);
+      f.catalog.put(second.id(), second);
+      f.add(first, 100, 100, 75, 40);
+      f.add(second, 100, 100, 75, 40);
+      var commander = commander(f, a, b);
+      commander.useSkill(f.player(first), SkillType.INSPIRE, null);
+      assertEquals(0, commander.getSkillCooldown(b, SkillType.INSPIRE));
+      commander.useSkill(f.player(second), SkillType.INSPIRE, null);
+      assertEquals(60, commander.getSkillCooldown(a, SkillType.INSPIRE));
+      assertEquals(60, commander.getSkillCooldown(b, SkillType.INSPIRE));
+      assertEquals(2, f.owner.snapshot().skillUses().size());
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void offlineRemovedAndClosedActorsCannotCast(boolean sql) throws Exception {
+    try (var f = new ArmyRuntimeTestFixture(root, sql)) {
+      f.add();
+      var commander = commander(f, f.nation.founderId());
+      var player = f.player(f.nation);
+      when(player.isOnline()).thenReturn(false);
+      assertFalse(commander.canUseSkill(player, SkillType.INSPIRE));
+      assertThrows(
+          IllegalStateException.class, () -> commander.useSkill(player, SkillType.INSPIRE, null));
+      when(player.isOnline()).thenReturn(true);
+      f.catalog.remove(f.nation.id());
+      assertThrows(
+          IllegalStateException.class, () -> commander.useSkill(player, SkillType.INSPIRE, null));
+      assertTrue(f.owner.snapshot().skillUses().isEmpty());
+      commander.shutdownAsync().join();
+      assertThrows(
+          IllegalStateException.class, () -> commander.useSkill(player, SkillType.INSPIRE, null));
+    }
+  }
+}
