+  @Test
+  void boundedCounterAndExactSmallLimitRejectBeforeFutureCapacityIsConsumed() {
+    var state = state(batch());
+    long required = WarSettlementFileCapacity.requiredBytes(state, Long.MAX_VALUE);
+    assertThat(required).isLessThan(256 * 1024);
+    assertThatCode(() -> WarSettlementFileCapacity.validate(state, required))
+        .doesNotThrowAnyException();
+    assertThatThrownBy(() -> WarSettlementFileCapacity.validate(state, required - 1))
+        .isInstanceOf(IllegalStateException.class)
+        .hasMessageContaining("capacity");
+    assertThatThrownBy(() -> WarSettlementFileCapacity.requiredBytes(state, 128))
+        .isInstanceOf(IllegalStateException.class)
+        .hasMessageContaining("capacity");
+  }
+
+  @Test
+  void multipleNativeReservationsAddTheirCompleteFutureReceipts() throws Exception {
+    var first = batch();
+    var second = batch();
+    var left = WarAuthority.empty();
+    left.setProperty(
+        WarSettlementState.ADMISSION + first.request().operationId(),
+        WarSettlementState.encode(new Admission(first.binding(), Decision.ACCEPTED)));
+    var right = WarAuthority.empty();
+    right.setProperty(
+        WarSettlementState.ADMISSION + second.request().operationId(),
+        WarSettlementState.encode(new Admission(second.binding(), Decision.ACCEPTED)));
+    var both = WarAuthority.empty();
+    both.putAll(left);
+    both.putAll(right);
+    long leftGrowth =
+        WarSettlementFileCapacity.requiredBytes(left, Long.MAX_VALUE) - serializedBytes(left);
+    long rightGrowth =
+        WarSettlementFileCapacity.requiredBytes(right, Long.MAX_VALUE) - serializedBytes(right);
+    long bothGrowth =
+        WarSettlementFileCapacity.requiredBytes(both, Long.MAX_VALUE) - serializedBytes(both);
+    assertThat(bothGrowth).isEqualTo(leftGrowth + rightGrowth - 512);
+    long oneOnlyLimit = serializedBytes(both) + Math.max(leftGrowth, rightGrowth);
+    assertThatThrownBy(() -> WarSettlementFileCapacity.validate(both, oneOnlyLimit))
+        .isInstanceOf(IllegalStateException.class)
+        .hasMessageContaining("capacity");
+  }
