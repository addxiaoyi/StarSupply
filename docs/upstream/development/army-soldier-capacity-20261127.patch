+
+final class ArmyAuthorityFixtures {
+  static final UUID ARMY_ID = UUID.fromString("00000000-0000-0000-0000-000000000001");
+  static final UUID NATION_ID = UUID.fromString("00000000-0000-0000-0000-000000000002");
+  static final UUID INCARNATION = UUID.fromString("00000000-0000-0000-0000-000000000003");
+  static final UUID REQUEST_ID = UUID.fromString("00000000-0000-0000-0000-000000000004");
+  static final UUID OTHER_ID = UUID.fromString("00000000-0000-0000-0000-000000000005");
+  static final Instant CREATED = Instant.parse("2026-11-27T00:00:00.123456789Z");
+  static final Instant UPDATED = Instant.parse("2026-11-27T01:00:00.987654321Z");
+  static final String EMPTY_SHA256 =
+      "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855";
+
+  private ArmyAuthorityFixtures() {}
+
+  static ArmyMigrationEvidence migration() {
+    return new ArmyMigrationEvidence(
+        EMPTY_SHA256,
+        Map.of(),
+        Map.of(
+            ArmyMigrationEvidence.SOURCE_PAYLOAD_BASE64,
+            "",
+            ArmyMigrationEvidence.SOURCE_DESCRIPTOR,
+            "fixture"));
+  }
+
+  static ArmySnapshot army(long generation) {
+    return army(generation, 42, 73.5, 64.25, 38, 37, UPDATED);
+  }
+
+  static ArmySnapshot army(
+      long generation,
+      int soldiers,
+      double health,
+      double morale,
+      int supply,
+      int remainder,
+      Instant updated) {
+    return new ArmySnapshot(
+        new ArmyToken(ARMY_ID, INCARNATION, generation),
+        NATION_ID,
+        ArmyType.INFANTRY,
+        soldiers,
+        health,
+        morale,
+        new ArmyPosition(null, "missing-world", 12.5, 68, -9.25, 37.5f, -16.25f),
+        ArmyState.MARCHING,
+        supply,
+        remainder,
+        CREATED,
+        updated);
+  }
+
+  static ArmyTombstone tombstone(ArmySnapshot before, long generation) {
+    return new ArmyTombstone(
+        new ArmyToken(before.token().armyId(), before.token().incarnation(), generation),
+        before.nationId(),
+        before.type(),
+        before.createdAt(),
+        UPDATED,
+        "test-retirement",
+        null);
+  }
+
+  static ArmyAuthoritySnapshot image(
+      long revision,
+      Map<UUID, ArmySnapshot> armies,
+      Map<UUID, ArmyTombstone> tombstones,
+      Map<UUID, ArmyLogisticsReceipt> receipts) {
+    return new ArmyAuthoritySnapshot(true, revision, armies, tombstones, receipts, migration());
+  }
+
+  static ArmyAuthoritySnapshot live(long revision, long generation) {
+    return image(revision, Map.of(ARMY_ID, army(generation)), Map.of(), Map.of());
+  }
+}
