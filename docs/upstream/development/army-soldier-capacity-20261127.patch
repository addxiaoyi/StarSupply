+  private static ArmyAuthorityStorage lostAckStorage(
+      ArmyAuthorityStorage delegate, AtomicBoolean loseAcknowledgement, AtomicInteger commits) {
+    var storage = mock(ArmyAuthorityStorage.class, delegatesTo(delegate));
+    doAnswer(
+            invocation -> {
+              var committed =
+                  delegate.commit(
+                      invocation.getArgument(0, ArmyAuthoritySnapshot.class),
+                      invocation.getArgument(1, ArmyAuthoritySnapshot.class));
+              commits.incrementAndGet();
+              if (loseAcknowledgement.getAndSet(false)) {
+                throw new IllegalStateException("Committed battle acknowledgement was lost");
+              }
+              return committed;
+            })
+        .when(storage)
+        .commit(any(ArmyAuthoritySnapshot.class), any(ArmyAuthoritySnapshot.class));
+    return storage;
