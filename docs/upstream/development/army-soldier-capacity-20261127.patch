+    long preparedBytes =
+        AbstractArmyAuthorityStorage.serializedEnvelopeSize(
+            ArmyAuthorityCodec.encode(pending), Long.MAX_VALUE);
+    long futureBytes =
+        AbstractArmyAuthorityStorage.serializedEnvelopeSize(
+            ArmyAuthorityCodec.encode(ArmyPaidState.maximumCompletionImage(pending)),
+            Long.MAX_VALUE);
+    assertTrue(futureBytes > preparedBytes);
+    var storage = storage(sqlite, preparedBytes);
+    var initial = storage.initializeFromLegacy(imported());
+    var owner = new ArmyAuthorityOwner(storage);
+    owner.refresh();
+    assertThrows(IllegalArgumentException.class, () -> owner.preparePaid(request));
+    assertFalse(owner.isReady());
+    assertEquals(initial, storage(sqlite, preparedBytes).load());
+    assertEquals(initial, owner.refresh());
+  }
