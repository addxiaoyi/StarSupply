+        "soldiers",
+        "health",
+        "morale",
+        "worldId",
+        "worldName",
+        "x",
+        "y",
+        "z",
+        "yaw",
+        "pitch",
+        "state",
+        "remainder",
+        "created",
+        "lastUpdated"
