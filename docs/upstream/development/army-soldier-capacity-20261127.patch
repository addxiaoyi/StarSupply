+    return ArmyNationClosure.closing(OPERATION_ID, NATION_ID, ACCEPTED)
+        .retired(
+            Map.of(
+                FIRST_ARMY_ID,
+                army(FIRST_ARMY_ID, NATION_ID, 38),
