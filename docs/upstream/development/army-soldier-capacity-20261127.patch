+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void failedFinalizeKeepsOriginalIntentAndMergesLatestUnrelatedState(boolean sql) {
+    try (var fixture = new AllianceRetirementFixture(root, sql)) {
