+package dev.starcore.starcore.module.army.model.authority;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import dev.starcore.starcore.module.army.model.ArmyState;
+import dev.starcore.starcore.module.army.model.ArmyType;
+import java.time.Instant;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.UUID;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+
+class ArmyNationClosureTest {
+  private static final UUID OPERATION = new UUID(0, 1);
+  private static final UUID NATION = new UUID(0, 2);
+  private static final UUID ARMY = new UUID(0, 3);
+  private static final UUID OTHER = new UUID(0, 4);
+  private static final UUID SECOND = new UUID(0, 5);
+  private static final UUID INCARNATION = new UUID(0, 6);
+  private static final Instant ACCEPTED = Instant.parse("2026-11-27T04:05:06.123456789Z");
+  private static final Instant RETIRED = ACCEPTED.plusSeconds(10);
+
+  @Test
+  void closingRetainsItsExactRequestAndHasNoRetirementEffects() {
+    var closing = closing();
+
+    assertEquals(OPERATION, closing.operationId());
+    assertEquals(NATION, closing.nationId());
+    assertEquals(ACCEPTED, closing.acceptedAt());
+    assertNull(closing.retiredAt());
+    assertTrue(closing.pending());
+    assertTrue(closing.retirements().isEmpty());
+    assertThrows(UnsupportedOperationException.class, () -> closing.retirements().clear());
+    assertEquals(new ArmyNationClosure(OPERATION, NATION, ACCEPTED, null, Map.of()), closing);
+  }
+
+  @ParameterizedTest
+  @ValueSource(strings = {"operation", "nation", "accepted", "retirements"})
+  void constructorRequiresEveryNonOptionalFact(String field) {
+    assertThrows(
+        NullPointerException.class,
+        () ->
+            new ArmyNationClosure(
+                field.equals("operation") ? null : OPERATION,
+                field.equals("nation") ? null : NATION,
+                field.equals("accepted") ? null : ACCEPTED,
+                null,
+                field.equals("retirements") ? null : Map.of()));
+  }
+
+  @ParameterizedTest
+  @ValueSource(strings = {"1970-01-01T00:00:00Z", "1969-12-31T23:59:59.999999999Z"})
+  void closingAcceptanceMustBeStrictlyAfterTheEpoch(String accepted) {
+    assertThrows(
+        IllegalArgumentException.class,
+        () -> ArmyNationClosure.closing(OPERATION, NATION, Instant.parse(accepted)));
+  }
+
+  @Test
+  void closingCannotContainTerminalEffects() {
+    assertThrows(
+        IllegalArgumentException.class,
+        () -> new ArmyNationClosure(OPERATION, NATION, ACCEPTED, null, Map.of(ARMY, tombstone())));
+  }
+
+  @Test
+  void terminalTimeCannotPrecedeClosingEvenWhenThereAreNoArmies() {
+    assertThrows(
+        IllegalArgumentException.class,
+        () -> new ArmyNationClosure(OPERATION, NATION, ACCEPTED, ACCEPTED.minusNanos(1), Map.of()));
+    assertThrows(
+        IllegalArgumentException.class, () -> closing().retired(Map.of(), ACCEPTED.minusNanos(1)));
+  }
+
+  @ParameterizedTest
+  @ValueSource(
+      strings = {
+        "army",
+        "nation",
+        "operation",
+        "nullOperation",
+        "reason",
+        "retired",
+        "created",
+        "generation"
+      })
+  void terminalRecordsRejectEveryNonCanonicalTombstoneFact(String field) {
+    var original = tombstone();
+    var forged =
+        new ArmyTombstone(
+            new ArmyToken(
+                field.equals("army") ? OTHER : ARMY,
+                INCARNATION,
+                field.equals("generation") ? 1 : original.token().generation()),
+            field.equals("nation") ? OTHER : NATION,
+            original.type(),
+            field.equals("created") ? RETIRED.plusNanos(1) : original.createdAt(),
+            field.equals("retired") ? RETIRED.plusNanos(1) : RETIRED,
+            field.equals("reason") ? "Nation-retired" : "nation-retired",
+            field.equals("nullOperation") ? null : field.equals("operation") ? OTHER : OPERATION);
+
+    assertThrows(
+        IllegalArgumentException.class,
+        () -> new ArmyNationClosure(OPERATION, NATION, ACCEPTED, RETIRED, Map.of(ARMY, forged)));
+  }
+
+  @Test
+  void terminalMapKeysMustMatchTheirTombstonesArmyIds() {
+    assertThrows(
+        IllegalArgumentException.class,
+        () ->
+            new ArmyNationClosure(
+                OPERATION, NATION, ACCEPTED, RETIRED, Map.of(OTHER, tombstone())));
+  }
+
+  @ParameterizedTest
+  @ValueSource(strings = {"key", "value"})
+  void terminalMapRejectsNullEntries(String field) {
+    Map<UUID, ArmyTombstone> effects = new HashMap<>();
+    effects.put(field.equals("key") ? null : ARMY, field.equals("value") ? null : tombstone());
+
+    assertThrows(
+        NullPointerException.class,
+        () -> new ArmyNationClosure(OPERATION, NATION, ACCEPTED, RETIRED, effects));
+  }
+
+  @Test
+  void terminalConstructorCopiesItsMapAndKeepsEveryCanonicalField() {
+    var tombstone = tombstone();
+    Map<UUID, ArmyTombstone> effects = new HashMap<>(Map.of(ARMY, tombstone));
+    var closure = new ArmyNationClosure(OPERATION, NATION, ACCEPTED, RETIRED, effects);
+    effects.clear();
+
+    assertFalse(closure.pending());
+    assertEquals(RETIRED, closure.retiredAt());
+    assertSame(tombstone, closure.retirements().get(ARMY));
+    assertThrows(UnsupportedOperationException.class, () -> closure.retirements().clear());
+  }
+
+  @Test
+  void retirementSelectsAllAndOnlyTheSuppliedNationsArmiesWithoutChangingInputs() {
+    var first = army(ARMY, NATION, 7, ACCEPTED.minusSeconds(3600), ACCEPTED.minusSeconds(1));
+    var second = army(SECOND, NATION, 1, ACCEPTED.minusSeconds(20), ACCEPTED);
+    var foreign =
+        army(OTHER, OTHER, Long.MAX_VALUE, RETIRED.plusSeconds(1), RETIRED.plusSeconds(2));
+    Map<UUID, ArmySnapshot> current =
+        new HashMap<>(Map.of(ARMY, first, SECOND, second, OTHER, foreign));
+    var closing = closing();
+    var retired = closing.retired(current, RETIRED);
+
+    assertEquals(
+        Map.of(ARMY, expected(first, RETIRED), SECOND, expected(second, RETIRED)),
+        retired.retirements());
+    assertFalse(retired.pending());
+    assertEquals(RETIRED, retired.retiredAt());
+    assertEquals(OPERATION, retired.operationId());
+    assertEquals(NATION, retired.nationId());
+    assertEquals(ACCEPTED, retired.acceptedAt());
+    assertTrue(closing.pending());
+    assertTrue(closing.retirements().isEmpty());
+    assertEquals(Map.of(ARMY, first, SECOND, second, OTHER, foreign), current);
+    assertEquals(7, first.token().generation());
+    assertEquals(1, second.token().generation());
+    assertEquals(Long.MAX_VALUE, foreign.token().generation());
+    assertFalse(retired.retirements().containsKey(OTHER));
+    current.clear();
+    assertEquals(2, retired.retirements().size());
+  }
+
+  @Test
+  void emptyAndEntirelyForeignMapsCanFinishAClosingWithoutInventedTombstones() {
+    var empty = closing().retired(Map.of(), ACCEPTED);
+    var foreign = army(OTHER, OTHER, 7, ACCEPTED.minusSeconds(10), ACCEPTED.minusSeconds(1));
+    var foreignOnly = closing().retired(Map.of(OTHER, foreign), RETIRED);
+
+    assertFalse(empty.pending());
+    assertEquals(ACCEPTED, empty.retiredAt());
+    assertTrue(empty.retirements().isEmpty());
+    assertFalse(foreignOnly.pending());
+    assertTrue(foreignOnly.retirements().isEmpty());
+  }
+
+  @ParameterizedTest
+  @ValueSource(strings = {"armies", "time"})
+  void retirementRequiresItsCurrentMapAndDecisionTime(String field) {
+    assertThrows(
+        NullPointerException.class,
+        () ->
+            closing()
+                .retired(
+                    field.equals("armies") ? null : Map.of(),
+                    field.equals("time") ? null : RETIRED));
+  }
+
+  @Test
+  void selectedArmyMapKeysMustMatchTheirSnapshots() {
+    var before = army(ARMY, NATION, 7, ACCEPTED.minusSeconds(10), ACCEPTED.minusSeconds(1));
+    assertThrows(
+        IllegalArgumentException.class, () -> closing().retired(Map.of(OTHER, before), RETIRED));
+  }
+
+  @ParameterizedTest
+  @ValueSource(strings = {"key", "value"})
+  void selectedArmyMapRejectsNullEntries(String field) {
+    Map<UUID, ArmySnapshot> current = new HashMap<>();
+    current.put(
+        field.equals("key") ? null : ARMY,
+        field.equals("value") ? null : army(ARMY, NATION, 7, ACCEPTED.minusSeconds(10), ACCEPTED));
+    assertThrows(NullPointerException.class, () -> closing().retired(current, RETIRED));
+  }
+
+  @ParameterizedTest
+  @ValueSource(strings = {"created", "updated"})
+  void retirementCannotPrecedeEitherSelectedSnapshotTimestamp(String field) {
+    var before =
+        army(
+            ARMY,
+            NATION,
+            7,
+            field.equals("created") ? RETIRED.plusNanos(1) : ACCEPTED.minusSeconds(10),
+            field.equals("updated") ? RETIRED.plusNanos(1) : ACCEPTED);
+
+    assertThrows(
+        IllegalArgumentException.class, () -> closing().retired(Map.of(ARMY, before), RETIRED));
+  }
+
+  @Test
+  void retirementMayExactlyEqualAllSnapshotAndClosureTimes() {
+    var before = army(ARMY, NATION, 1, ACCEPTED, ACCEPTED);
+    var retired = closing().retired(Map.of(ARMY, before), ACCEPTED);
+
+    assertEquals(expected(before, ACCEPTED), retired.retirements().get(ARMY));
+    assertEquals(2, retired.retirements().get(ARMY).token().generation());
+    assertEquals(ACCEPTED.getNano(), retired.retiredAt().getNano());
+    assertDoesNotThrow(
+        () -> new ArmyNationClosure(OPERATION, NATION, ACCEPTED, ACCEPTED, retired.retirements()));
+  }
+
+  @Test
+  void retirementUsesTheLastAvailableGenerationAndRejectsExhaustion() {
+    var last = army(ARMY, NATION, Long.MAX_VALUE - 1, ACCEPTED.minusSeconds(10), ACCEPTED);
+    var exhausted = last.withToken(new ArmyToken(ARMY, INCARNATION, Long.MAX_VALUE));
+    var retired = closing().retired(Map.of(ARMY, last), RETIRED);
+
+    assertEquals(Long.MAX_VALUE, retired.retirements().get(ARMY).token().generation());
+    assertThrows(
+        IllegalArgumentException.class, () -> closing().retired(Map.of(ARMY, exhausted), RETIRED));
+  }
+
+  @Test
+  void retirementPreservesEachSelectedTypeIncarnationAndCreationTime() {
+    var original = army(ARMY, NATION, 7, ACCEPTED.minusSeconds(10), ACCEPTED);
+    var cavalry =
+        new ArmySnapshot(
+            new ArmyToken(ARMY, OTHER, 7),
+            NATION,
+            ArmyType.CAVALRY,
+            original.soldiers(),
+            original.health(),
+            original.morale(),
+            original.position(),
+            original.state(),
+            original.supply(),
+            original.supplyConsumptionRemainder(),
+            original.createdAt(),
+            original.lastUpdated());
+    var tombstone = closing().retired(Map.of(ARMY, cavalry), RETIRED).retirements().get(ARMY);
+
+    assertEquals(new ArmyToken(ARMY, OTHER, 8), tombstone.token());
+    assertEquals(ArmyType.CAVALRY, tombstone.type());
+    assertEquals(cavalry.createdAt(), tombstone.createdAt());
+    assertEquals("nation-retired", tombstone.reason());
+    assertEquals(OPERATION, tombstone.operationId());
+  }
+
+  @Test
+  void terminalInstancesCannotRunTheRetirementTransitionAgainEvenWithTheSameTime() {
+    var retired = closing().retired(Map.of(), RETIRED);
+
+    assertThrows(IllegalStateException.class, () -> retired.retired(Map.of(), RETIRED));
+    assertThrows(
+        IllegalStateException.class, () -> retired.retired(Map.of(), RETIRED.plusNanos(1)));
+  }
+
+  @Test
+  void sameRequestComparesOnlyFrozenAdmissionFactsAcrossStages() {
+    var closing = closing();
+    var retired =
+        new ArmyNationClosure(OPERATION, NATION, ACCEPTED, RETIRED, Map.of(ARMY, tombstone()));
+    var emptyRetired = closing.retired(Map.of(), RETIRED.plusSeconds(1));
+
+    assertTrue(closing.sameRequest(closing()));
+    assertTrue(closing.sameRequest(retired));
+    assertTrue(retired.sameRequest(closing));
+    assertTrue(retired.sameRequest(emptyRetired));
+    assertNotEquals(retired, emptyRetired);
+    assertFalse(closing.sameRequest(null));
+  }
+
+  @ParameterizedTest
+  @ValueSource(strings = {"operation", "nation", "accepted"})
