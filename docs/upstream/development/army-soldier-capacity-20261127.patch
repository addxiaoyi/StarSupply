+    var terminal = retired(closing);
+    ArmyAuthorityState.validateCommit(closing, terminal);
+    assertEquals(Long.MAX_VALUE, terminal.revision());
+    var exhausted = baseline().withRevision(Long.MAX_VALUE - 1);
