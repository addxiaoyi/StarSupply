+  @Test
+  void legacyEndAndTerminalConstructorsRetainTheirOriginalV1Evidence() {
+    var fixture = new Fixture();
+    var request = fixture.legacyRequest();
+    var plan = plan(request, LOCAL_HASH);
+    var batch = new PeaceTreatyBatch(request, plan, Stage.WAR_PREPARED, null, null);
+    var end = end(batch.warRequest());
+    var terminal = new OperationView(request, plan, Status.APPLIED, PREPARED_AT.plusNanos(2));
+    var acknowledged = new PeaceTreatyBatch(request, plan, Stage.ACKED, end, terminal, true);
+    var released = acknowledged.advance(Stage.RELEASED);
+
+    assertEquals(end, released.endReceipt());
+    assertEquals(terminal, released.terminalReceipt());
+    assertEquals(1, released.request().protocolVersion());
+    assertEquals(1, released.warRequest().protocolVersion());
+    assertNull(released.binding());
+    assertNull(released.terminalReceipt().binding());
+    assertNull(released.terminalReceipt().terminalEvidence());
+    assertTrue(released.cancelRequested());
+    assertTrue(released.terminal());
+    assertDoesNotThrow(() -> batch.validateSuccessor(acknowledged));
