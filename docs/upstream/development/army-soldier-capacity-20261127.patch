+final class AllianceIntentCodec {
+  private AllianceIntentCodec() {}
+
+  static String encodeIntent(AllianceOperationIntent intent) {
+    var request = intent.request();
+    return String.join(
+        "|",
+        "1",
+        intent.source().name(),
+        request.action().name(),
+        request.left().toString(),
+        request.right().toString(),
+        request.actor().toString(),
+        request.occurredAt().toString(),
+        request.expectedRelation().name(),
+        Long.toString(request.expectedGeneration()),
+        intent.originalInvite() == null ? "" : intent.originalInvite().inviter().toString(),
+        intent.originalInvite() == null ? "" : intent.originalInvite().invited().toString(),
+        instant(intent.originalInviteAt()),
+        alliance(intent.originalAlliance()),
+        alliance(intent.proposedAlliance()),
+        instant(intent.originalCooldown()),
+        instant(intent.proposedCooldown()),
+        Boolean.toString(intent.cancellationRequested()),
+        intent.status().name(),
+        intent.outcome() == null ? "" : intent.outcome().name(),
+        Long.toString(intent.receiptGeneration()));
+  }
+
+  static AllianceOperationIntent decodeIntent(UUID id, String raw) {
+    String[] values = fields(raw, 20);
+    if (!"1".equals(values[0]) || !values[16].equals("true") && !values[16].equals("false"))
+      throw new IllegalArgumentException("Invalid alliance intent encoding");
+    AllianceInviteKey invite = null;
+    if (!values[9].isEmpty() || !values[10].isEmpty())
+      invite = new AllianceInviteKey(nation(values[9]), nation(values[10]));
+    return new AllianceOperationIntent(
+        new Request(
+            id,
+            nation(values[3]),
+            nation(values[4]),
+            Action.valueOf(values[2]),
+            nation(values[5]),
+            Instant.parse(values[6]),
+            DiplomacyRelation.valueOf(values[7]),
+            Long.parseLong(values[8])),
+        AllianceOperationIntent.Source.valueOf(values[1]),
+        invite,
+        time(values[11]),
+        alliance(values[12]),
+        alliance(values[13]),
+        time(values[14]),
+        time(values[15]),
+        Boolean.parseBoolean(values[16]),
+        AllianceRecoveryService.Status.valueOf(values[17]),
+        values[18].isEmpty() ? null : Outcome.valueOf(values[18]),
+        Long.parseLong(values[19]));
+  }
+
+  private static String instant(Instant value) {
+    return value == null ? "" : value.toString();
+  }
+
+  private static Instant time(String value) {
+    return value.isEmpty() ? null : Instant.parse(value);
+  }
+
+  private static NationId nation(String value) {
+    return NationId.of(UUID.fromString(value));
+  }
+
+  private static String alliance(AllianceInfoData value) {
+    return value == null
+        ? ""
+        : encode(
+            String.join(
+                "|",
+                value.nation1().toString(),
+                value.nation2().toString(),
+                encode(value.nation1Name()),
+                encode(value.nation2Name()),
+                value.formedAt().toString()));
+  }
+
+  private static AllianceInfoData alliance(String value) {
+    if (value.isEmpty()) return null;
+    String[] parts = fields(name(value, true), 5);
+    return new AllianceInfoData(
+        nation(parts[0]),
+        nation(parts[1]),
+        name(parts[2], true),
+        name(parts[3], true),
+        Instant.parse(parts[4]));
+  }
+}
