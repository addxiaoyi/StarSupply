+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void forgedSameRevisionPreimageAndCallerAssignedRevisionCannotBypassStrictCommit(boolean sql)
+      throws Exception {
+    var storage = backend(sql).storage();
+    var initial = storage.initializeFromLegacy(imported());
+    var forged = initial;
+    for (int count = 0; count < 9; count++)
+      forged = replace(forged, advance(forged.armies().get(firstId)));
+    var expected = forged;
+    var draft = replace(forged, advance(forged.armies().get(firstId)));
+    assertThatThrownBy(() -> storage.commit(expected, draft))
+        .hasMessageContaining("predecessor conflict");
+    assertThatThrownBy(() -> storage.commit(initial, draft.withRevision(initial.revision() + 1)))
+        .hasMessageContaining("draft revision");
+    assertThat(storage.snapshot()).isEqualTo(initial);
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void reloadObservesSkippedRevisionsAndPermanentDeletionWithoutEnablingRestoration(boolean sql)
+      throws Exception {
+    var backend = backend(sql);
+    var writer = backend.storage();
+    var initial = writer.initializeFromLegacy(imported());
+    var reader = backend.storage();
+    reader.load();
+    var updated = writer.commit(initial, replace(initial, advance(initial.armies().get(firstId))));
+    var retired = writer.commit(updated, retire(updated, firstId));
+    assertThat(reader.load()).isEqualTo(retired);
+    assertThat(retired.receipts()).isEqualTo(initial.receipts());
+    assertThat(retired.generations().get(firstId)).isEqualTo(3);
+    assertThatThrownBy(
+            () -> reader.commit(retired, replace(retired, initial.armies().get(firstId))))
+        .isInstanceOf(RuntimeException.class);
+    assertThatThrownBy(() -> reader.initializeFromLegacy(imported()))
+        .hasMessageContaining("reimport is forbidden");
+    assertThat(backend.storage().load()).isEqualTo(retired);
+  }
