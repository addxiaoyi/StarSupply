+  private static final String SKILL = "armySkill.";
+  private static final String NATION_CLOSURE = "armyNationClosure.";
+  private static final String GENERATION = "armyGeneration.";
+  private static final String INCARNATION = "armyIncarnation.";
+  private static final String ENVELOPE_VERSION = "authority.version";
+  private static final String ENVELOPE_HASH = "authority.sha256";
+  private static final int MAGIC = 0x41524D59;
+  private static final int MAX_ROW_BYTES = 16 * 1024 * 1024;
+  private static final int MAX_ENTRIES = 100_000;
+
+  private ArmyAuthorityCodec() {}
+
+  public static Properties encode(ArmyAuthoritySnapshot image) {
+    return encodeWithRowBudget(image, MAX_ROW_BYTES);
+  }
+
+  static Properties encodeWithRowBudget(ArmyAuthoritySnapshot image, int rowBudget) {
+    if (rowBudget < 1 || rowBudget > MAX_ROW_BYTES) {
+      throw new IllegalArgumentException("Invalid Army row budget");
+    }
+    ArmyAuthorityState.validate(image);
+    if (image.version() == 1 && !image.paidOperations().isEmpty()) {
+      throw new IllegalArgumentException("Army authority version 1 cannot contain paid operations");
+    }
+    if (image.version() < 3 && !image.battleSessions().isEmpty()) {
+      throw new IllegalArgumentException("Army authority versions 1 and 2 cannot contain battles");
+    }
+    if (image.version() < 4 && !image.skillUses().isEmpty()) {
+      throw new IllegalArgumentException(
+          "Army authority versions 1 through 3 cannot contain skills");
+    }
+    if (image.version() < 5 && !image.nationClosures().isEmpty()) {
+      throw new IllegalArgumentException(
+          "Army authority versions 1 through 4 cannot contain nation closures");
+    }
+    if (image.version() < 6
+        && image.battleSessions().values().stream()
+            .anyMatch(session -> !session.interventions().isEmpty())) {
+      throw new IllegalArgumentException(
+          "Army authority versions 1 through 5 cannot contain battle interventions");
+    }
+    Properties result = new Properties();
+    if (!image.initialized()) return result;
+    result.setProperty(REVISION, Long.toString(image.revision()));
+    result.setProperty(VERSION, Integer.toString(image.version()));
+    result.setProperty(INITIALIZED, "true");
+    result.setProperty(
+        MIGRATION, encodeRow(4, output -> writeMigration(output, image.migration()), rowBudget));
+    image
+        .armies()
+        .forEach(
+            (armyId, army) ->
+                result.setProperty(
+                    ARMY + armyId, encodeRow(1, output -> writeArmy(output, army), rowBudget)));
+    image
+        .tombstones()
+        .forEach(
+            (armyId, tombstone) ->
+                result.setProperty(
+                    TOMBSTONE + armyId,
+                    encodeRow(2, output -> writeTombstone(output, tombstone), rowBudget)));
+    image
+        .receipts()
+        .forEach(
+            (requestId, receipt) ->
+                result.setProperty(
+                    RECEIPT + requestId,
+                    encodeRow(3, output -> writeReceipt(output, receipt), rowBudget)));
+    image
+        .paidOperations()
+        .forEach(
+            (operationId, operation) ->
+                result.setProperty(
+                    PAID + operationId,
+                    encodeRow(
+                        operation.request().maximumNationSoldiers() == Long.MAX_VALUE ? 5 : 10,
+                        output -> writePaidOperation(output, operation),
+                        rowBudget)));
+    image
+        .battleSessions()
+        .forEach(
+            (sessionId, session) ->
+                result.setProperty(
+                    BATTLE + sessionId,
+                    encodeRow(
+                        session.interventions().isEmpty() ? 6 : 9,
+                        output -> writeBattleSession(output, session),
+                        rowBudget)));
+    image
+        .skillUses()
+        .forEach(
+            (operationId, use) ->
+                result.setProperty(
+                    SKILL + operationId,
+                    encodeRow(
+                        use.request().maximumNationSoldiers() == Long.MAX_VALUE ? 7 : 11,
+                        output -> writeSkillUse(output, use),
+                        rowBudget)));
+    image
+        .nationClosures()
+        .forEach(
+            (nationId, closure) ->
+                result.setProperty(
+                    NATION_CLOSURE + nationId,
+                    encodeRow(8, output -> writeNationClosure(output, closure), rowBudget)));
+    image
+        .generations()
+        .forEach(
+            (armyId, generation) ->
+                result.setProperty(GENERATION + armyId, Long.toString(generation)));
+    image
+        .incarnations()
+        .forEach(
+            (armyId, incarnation) ->
+                result.setProperty(INCARNATION + armyId, incarnation.toString()));
+    return result;
+  }
+
+  public static ArmyAuthoritySnapshot decode(Properties properties) {
+    Objects.requireNonNull(properties, "properties");
+    if (properties.size() != properties.stringPropertyNames().size()) {
+      throw new IllegalArgumentException("Army authority properties must be direct text entries");
+    }
+    if (properties.isEmpty()
+        || properties.size() == 1 && "0".equals(properties.getProperty(REVISION))) {
+      return ArmyAuthoritySnapshot.uninitialized();
+    }
+    String schemaVersion = properties.getProperty(VERSION);
+    if ((!"1".equals(schemaVersion)
+            && !"2".equals(schemaVersion)
+            && !"3".equals(schemaVersion)
+            && !"4".equals(schemaVersion)
+            && !"5".equals(schemaVersion)
+            && !"6".equals(schemaVersion)
+            && !"7".equals(schemaVersion))
+        || !"true".equals(properties.getProperty(INITIALIZED))) {
+      throw new IllegalArgumentException("Unknown or incomplete Army authority schema");
+    }
+    int version = Integer.parseInt(schemaVersion);
+    long revision = positiveLong(required(properties, REVISION));
+    Map<UUID, ArmySnapshot> armies = new HashMap<>();
+    Map<UUID, ArmyTombstone> tombstones = new HashMap<>();
+    Map<UUID, ArmyLogisticsReceipt> receipts = new HashMap<>();
+    Map<UUID, ArmyPaidOperation> paidOperations = new HashMap<>();
+    Map<UUID, ArmyBattleSession> battleSessions = new HashMap<>();
+    Map<UUID, ArmySkillUse> skillUses = new HashMap<>();
+    Map<UUID, ArmyNationClosure> nationClosures = new HashMap<>();
+    Map<UUID, Long> generations = new HashMap<>();
+    Map<UUID, UUID> incarnations = new HashMap<>();
+    for (String key : properties.stringPropertyNames()) {
+      String value = properties.getProperty(key);
+      if (key.startsWith(ARMY)) {
+        armies.put(
+            canonicalUuid(key.substring(ARMY.length())),
+            decodeRow(value, 1, ArmyAuthorityCodec::readArmy));
+      } else if (key.startsWith(TOMBSTONE)) {
+        tombstones.put(
+            canonicalUuid(key.substring(TOMBSTONE.length())),
+            decodeRow(value, 2, ArmyAuthorityCodec::readTombstone));
+      } else if (key.startsWith(RECEIPT)) {
+        receipts.put(
+            canonicalUuid(key.substring(RECEIPT.length())),
+            decodeRow(value, 3, ArmyAuthorityCodec::readReceipt));
+      } else if (key.startsWith(PAID)) {
+        if (version == 1) {
+          throw new IllegalArgumentException(
+              "Army authority version 1 cannot contain paid operations");
+        }
+        paidOperations.put(
+            canonicalUuid(key.substring(PAID.length())),
+            decodeRow(value, 5, 10, (input, kind) -> readPaidOperation(input, kind == 10)));
+      } else if (key.startsWith(BATTLE)) {
+        if (version < 3) {
+          throw new IllegalArgumentException(
+              "Army authority versions 1 and 2 cannot contain battles");
+        }
+        battleSessions.put(canonicalUuid(key.substring(BATTLE.length())), decodeBattleRow(value));
+      } else if (key.startsWith(SKILL)) {
+        if (version < 4) {
+          throw new IllegalArgumentException(
+              "Army authority versions 1 through 3 cannot contain skills");
+        }
+        skillUses.put(
+            canonicalUuid(key.substring(SKILL.length())),
+            decodeRow(value, 7, 11, (input, kind) -> readSkillUse(input, kind == 11)));
+      } else if (key.startsWith(NATION_CLOSURE)) {
+        if (version < 5) {
+          throw new IllegalArgumentException(
+              "Army authority versions 1 through 4 cannot contain nation closures");
+        }
+        UUID nationId = canonicalUuid(key.substring(NATION_CLOSURE.length()));
+        ArmyNationClosure closure = decodeRow(value, 8, ArmyAuthorityCodec::readNationClosure);
+        if (!nationId.equals(closure.nationId())) {
+          throw new IllegalArgumentException("Army nation closure key differs from its identity");
+        }
+        nationClosures.put(nationId, closure);
+      } else if (key.startsWith(GENERATION)) {
+        generations.put(canonicalUuid(key.substring(GENERATION.length())), positiveLong(value));
+      } else if (key.startsWith(INCARNATION)) {
+        incarnations.put(canonicalUuid(key.substring(INCARNATION.length())), canonicalUuid(value));
+      } else if (!key.equals(REVISION)
+          && !key.equals(VERSION)
+          && !key.equals(INITIALIZED)
+          && !key.equals(MIGRATION)
+          && !key.equals(ENVELOPE_VERSION)
+          && !key.equals(ENVELOPE_HASH)) {
+        throw new IllegalArgumentException("Unknown Army authority property: " + key);
+      }
+    }
+    ArmyMigrationEvidence migration =
+        decodeRow(required(properties, MIGRATION), 4, ArmyAuthorityCodec::readMigration);
+    ArmyAuthoritySnapshot result =
+        new ArmyAuthoritySnapshot(
+            true,
+            revision,
+            armies,
+            tombstones,
+            receipts,
+            migration,
+            version,
+            paidOperations,
+            battleSessions,
+            skillUses,
+            nationClosures);
+    ArmyAuthorityState.validate(result);
+    if (!generations.equals(result.generations()) || !incarnations.equals(result.incarnations())) {
+      throw new IllegalArgumentException(
+          "Army token ledgers do not match live and retired identities");
+    }
+    validateEnvelope(properties);
+    return result;
+  }
+
+  private static void validateEnvelope(Properties properties) {
+    boolean hasVersion = properties.containsKey(ENVELOPE_VERSION);
+    boolean hasHash = properties.containsKey(ENVELOPE_HASH);
+    if (!hasVersion && !hasHash) return;
+    if (!hasVersion || !hasHash || !"1".equals(properties.getProperty(ENVELOPE_VERSION))) {
+      throw new IllegalArgumentException("Incomplete or unknown shared authority envelope");
+    }
+    String expected = properties.getProperty(ENVELOPE_HASH);
+    try {
+      MessageDigest digest = MessageDigest.getInstance("SHA-256");
+      byte[] buffer = new byte[4096];
+      for (String key : new TreeSet<>(properties.stringPropertyNames())) {
+        if (key.equals(ENVELOPE_HASH)) continue;
+        for (String part : new String[] {key, properties.getProperty(key)}) {
+          digest.update(ByteBuffer.allocate(4).putInt(part.length()).array());
+          for (int offset = 0; offset < part.length(); offset += buffer.length) {
+            int count = Math.min(buffer.length, part.length() - offset);
+            for (int index = 0; index < count; index++) {
+              char character = part.charAt(offset + index);
+              if (character > 0x7f) {
+                throw new IllegalArgumentException("Noncanonical non-ASCII Army envelope field");
+              }
+              buffer[index] = (byte) character;
+            }
+            digest.update(buffer, 0, count);
+          }
+        }
+      }
+      if (!HexFormat.of().formatHex(digest.digest()).equals(expected)) {
+        throw new IllegalArgumentException("Shared Army authority checksum mismatch");
+      }
+    } catch (NoSuchAlgorithmException impossible) {
+      throw new IllegalStateException("SHA-256 unavailable", impossible);
+    }
+  }
+
+  private static String required(Properties properties, String key) {
+    String value = properties.getProperty(key);
+    if (value == null)
+      throw new IllegalArgumentException("Missing Army authority property: " + key);
+    return value;
+  }
+
+  private static long positiveLong(String value) {
+    if (!value.matches("[1-9][0-9]*")) {
+      throw new IllegalArgumentException("Expected canonical positive integer");
+    }
+    try {
+      return Long.parseLong(value);
+    } catch (NumberFormatException invalid) {
+      throw new IllegalArgumentException("Army integer is outside the supported range", invalid);
+    }
+  }
+
+  private static UUID canonicalUuid(String value) {
+    UUID result;
+    try {
+      result = UUID.fromString(value);
+    } catch (IllegalArgumentException invalid) {
+      throw new IllegalArgumentException("Invalid Army UUID", invalid);
+    }
+    if (!result.toString().equals(value))
+      throw new IllegalArgumentException("Noncanonical Army UUID");
+    return result;
+  }
+
+  private static String encodeRow(int kind, BinaryWriter writer, int rowBudget) {
+    try {
+      CountingOutputStream counter = new CountingOutputStream(rowBudget);
+      try (DataOutputStream output = new DataOutputStream(counter)) {
+        writeRow(output, kind, writer);
+      }
+      FixedOutputStream bytes = new FixedOutputStream(counter.count);
+      try (DataOutputStream output = new DataOutputStream(bytes)) {
+        writeRow(output, kind, writer);
+      }
+      if (bytes.offset != bytes.bytes.length) {
+        throw new IllegalArgumentException("Army row size changed during encoding");
+      }
+      return Base64.getEncoder().encodeToString(bytes.bytes);
+    } catch (IOException invalid) {
+      throw new IllegalArgumentException("Unable to encode Army row", invalid);
+    }
+  }
+
+  private static void writeRow(DataOutputStream output, int kind, BinaryWriter writer)
+      throws IOException {
+    output.writeInt(MAGIC);
+    output.writeByte(1);
+    output.writeByte(kind);
+    writer.write(output);
+  }
+
+  private static <Value> Value decodeRow(String encoded, int kind, BinaryReader<Value> reader) {
+    return decodeRow(encoded, kind, kind, (input, actualKind) -> reader.read(input));
+  }
+
+  private static ArmyBattleSession decodeBattleRow(String encoded) {
+    return decodeRow(
+        encoded,
+        6,
+        9,
+        (input, kind) -> kind == 6 ? readBattleSession(input) : readExtendedBattleSession(input));
+  }
+
+  private static <Value> Value decodeRow(
+      String encoded, int kind, int otherKind, BinaryKindReader<Value> reader) {
+    int length = encoded.length();
+    if (length > (MAX_ROW_BYTES + 2L) / 3 * 4 || length % 4 != 0) {
+      throw new IllegalArgumentException("Army row exceeds size bound");
+    }
+    int padding = length > 0 && encoded.charAt(length - 1) == '=' ? 1 : 0;
+    if (padding == 1 && length > 1 && encoded.charAt(length - 2) == '=') padding++;
+    if ((long) length / 4 * 3 - padding > MAX_ROW_BYTES) {
+      throw new IllegalArgumentException("Decoded Army row exceeds size bound");
+    }
+    for (int index = 0; index < length - padding; index++) {
+      if (base64Value(encoded.charAt(index)) < 0) {
+        throw new IllegalArgumentException("Invalid Army row Base64 character");
+      }
+    }
+    if (padding == 1 && (base64Value(encoded.charAt(length - 2)) & 3) != 0
+        || padding == 2 && (base64Value(encoded.charAt(length - 3)) & 15) != 0) {
+      throw new IllegalArgumentException("Noncanonical Army row Base64 padding bits");
+    }
+    byte[] bytes = Base64.getDecoder().decode(encoded);
+    try (DataInputStream input = new DataInputStream(new ByteArrayInputStream(bytes))) {
+      if (input.readInt() != MAGIC || input.readUnsignedByte() != 1) {
+        throw new IllegalArgumentException("Unknown Army row type or version");
+      }
+      int actualKind = input.readUnsignedByte();
+      if (actualKind != kind && actualKind != otherKind) {
+        throw new IllegalArgumentException("Unknown Army row type or version");
+      }
+      Value result = reader.read(input, actualKind);
+      if (input.available() != 0) throw new IllegalArgumentException("Trailing Army row bytes");
+      return result;
+    } catch (IOException invalid) {
+      throw new IllegalArgumentException("Malformed Army row", invalid);
+    }
+  }
+
+  private static int base64Value(char character) {
+    if (character >= 'A' && character <= 'Z') return character - 'A';
+    if (character >= 'a' && character <= 'z') return character - 'a' + 26;
+    if (character >= '0' && character <= '9') return character - '0' + 52;
+    if (character == '+') return 62;
+    if (character == '/') return 63;
+    return -1;
+  }
+
+  private static void writeArmy(DataOutputStream output, ArmySnapshot army) throws IOException {
+    writeToken(output, army.token());
+    writeUuid(output, army.nationId());
+    writeString(output, army.type().key());
+    output.writeInt(army.soldiers());
+    output.writeDouble(army.health());
+    output.writeDouble(army.morale());
+    ArmyPosition position = army.position();
+    writeNullableUuid(output, position.worldId());
+    writeString(output, position.worldName());
+    output.writeDouble(position.x());
+    output.writeDouble(position.y());
+    output.writeDouble(position.z());
+    output.writeFloat(position.yaw());
+    output.writeFloat(position.pitch());
+    writeString(output, army.state().key());
+    output.writeInt(army.supply());
+    output.writeInt(army.supplyConsumptionRemainder());
+    writeInstant(output, army.createdAt());
+    writeInstant(output, army.lastUpdated());
+  }
+
+  private static ArmySnapshot readArmy(DataInputStream input) throws IOException {
+    ArmyToken token = readToken(input);
+    UUID nationId = readUuid(input);
+    ArmyType type = readType(input);
+    int soldiers = input.readInt();
+    double health = input.readDouble();
+    double morale = input.readDouble();
+    ArmyPosition position =
+        new ArmyPosition(
+            readNullableUuid(input),
+            readString(input),
+            input.readDouble(),
+            input.readDouble(),
+            input.readDouble(),
+            input.readFloat(),
+            input.readFloat());
+    return new ArmySnapshot(
+        token,
+        nationId,
+        type,
+        soldiers,
+        health,
+        morale,
+        position,
+        readState(input),
+        input.readInt(),
+        input.readInt(),
+        readInstant(input),
+        readInstant(input));
+  }
+
+  private static void writeTombstone(DataOutputStream output, ArmyTombstone tombstone)
+      throws IOException {
+    writeToken(output, tombstone.token());
+    writeUuid(output, tombstone.nationId());
+    writeString(output, tombstone.type().key());
+    writeInstant(output, tombstone.createdAt());
+    writeInstant(output, tombstone.retiredAt());
+    writeString(output, tombstone.reason());
+    writeNullableUuid(output, tombstone.operationId());
+  }
+
+  private static ArmyTombstone readTombstone(DataInputStream input) throws IOException {
+    return new ArmyTombstone(
+        readToken(input),
+        readUuid(input),
+        readType(input),
+        readInstant(input),
+        readInstant(input),
+        readString(input),
+        readNullableUuid(input));
+  }
+
+  private static void writeReceipt(DataOutputStream output, ArmyLogisticsReceipt receipt)
+      throws IOException {
+    writeUuid(output, receipt.requestId());
+    writeUuid(output, receipt.armyId());
+    writeUuid(output, receipt.nationId());
+    output.writeInt(receipt.requestedPoints());
+    output.writeInt(receipt.appliedPoints());
+    writeNullableUuid(output, receipt.incarnation());
+  }
+
+  private static ArmyLogisticsReceipt readReceipt(DataInputStream input) throws IOException {
+    return new ArmyLogisticsReceipt(
+        readUuid(input),
+        readUuid(input),
+        readUuid(input),
+        input.readInt(),
+        input.readInt(),
+        readNullableUuid(input));
+  }
+
+  private static void writeBattleSession(DataOutputStream output, ArmyBattleSession session)
+      throws IOException {
+    if (!session.interventions().isEmpty()) {
+      writeExtendedBattleSession(output, session);
+      return;
+    }
+    ArmyBattleRequest request = session.request();
+    writeUuid(output, request.sessionId());
+    writeUuid(output, request.actorId());
+    writeArmy(output, request.attackerBefore());
+    writeArmy(output, request.defenderBefore());
+    writeInstant(output, request.acceptedAt());
+    ArmyBattleSession.Resolution resolution = session.resolution();
+    int phase =
+        resolution == null
+            ? 0
+            : switch (resolution.status()) {
+              case COMPLETED -> 1;
+              case CANCELLED -> 2;
+              default ->
+                  throw new IllegalArgumentException(
+                      "Legacy battle row cannot contain skill termination");
+            };
+    output.writeByte(phase);
+    if (resolution == null) {
+      resolution = ArmyBattleSession.cancelled(request, request.acceptedAt());
+    }
+    writeArmy(output, resolution.attackerAfter());
+    writeArmy(output, resolution.defenderAfter());
+    output.writeDouble(resolution.attackerDamage());
+    output.writeDouble(resolution.defenderDamage());
+    writeInstant(output, resolution.decidedAt());
+  }
+
+  private static ArmyBattleSession readBattleSession(DataInputStream input) throws IOException {
+    ArmyBattleRequest request =
+        new ArmyBattleRequest(
+            readUuid(input), readUuid(input), readArmy(input), readArmy(input), readInstant(input));
+    int phase = input.readUnsignedByte();
+    if (phase > 2) {
+      throw new IllegalArgumentException("Unknown Army battle phase");
+    }
+    ArmyBattleSession.Resolution resolution =
+        new ArmyBattleSession.Resolution(
+            phase == 1 ? ArmyBattleSession.Status.COMPLETED : ArmyBattleSession.Status.CANCELLED,
+            readArmy(input),
+            readArmy(input),
+            input.readDouble(),
+            input.readDouble(),
+            readInstant(input));
+    ArmyBattleSession resolved = new ArmyBattleSession(request, resolution);
+    if (phase == 0) {
+      if (!resolution.equals(ArmyBattleSession.cancelled(request, request.acceptedAt()))) {
+        throw new IllegalArgumentException("Noncanonical Army pending battle padding");
+      }
+      return new ArmyBattleSession(request, null);
+    }
+    return resolved;
+  }
+
+  private static void writeExtendedBattleSession(DataOutputStream output, ArmyBattleSession session)
+      throws IOException {
+    var request = session.request();
+    writeUuid(output, request.sessionId());
+    writeUuid(output, request.actorId());
+    writeArmy(output, request.attackerBefore());
+    writeArmy(output, request.defenderBefore());
+    writeInstant(output, request.acceptedAt());
+    output.writeInt(session.interventions().size());
+    for (var intervention : session.interventions()) {
+      writeUuid(output, intervention.skillOperationId());
+      output.writeByte(intervention.skillType().ordinal());
+      writeInstant(output, intervention.acceptedAt());
+      writeArmy(output, intervention.before().attacker());
+      writeArmy(output, intervention.before().defender());
+      writeArmy(output, intervention.after().attacker());
+      writeArmy(output, intervention.after().defender());
+      output.writeByte(intervention.outcome().ordinal());
+    }
+    var resolution = session.resolution();
+    output.writeByte(resolution == null ? 0 : resolution.status().ordinal() + 1);
+    if (resolution == null) {
+      var heads = session.currentHeads();
+      Instant latest =
+          heads.attacker().lastUpdated().isAfter(heads.defender().lastUpdated())
+              ? heads.attacker().lastUpdated()
+              : heads.defender().lastUpdated();
+      resolution = ArmyBattleSession.cancelled(session, latest);
+    }
+    writeArmy(output, resolution.attackerAfter());
+    writeArmy(output, resolution.defenderAfter());
+    output.writeDouble(resolution.attackerDamage());
+    output.writeDouble(resolution.defenderDamage());
+    writeInstant(output, resolution.decidedAt());
+  }
+
+  private static ArmyBattleSession readExtendedBattleSession(DataInputStream input)
+      throws IOException {
+    var request =
+        new ArmyBattleRequest(
+            readUuid(input), readUuid(input), readArmy(input), readArmy(input), readInstant(input));
+    int count = input.readInt();
+    if (count < 1
+        || count > ArmyBattleSession.MAX_INTERVENTIONS
+        || count > input.available() / 642) {
+      throw new IllegalArgumentException("Invalid Army battle intervention count");
+    }
+    List<ArmyBattleIntervention> history = new ArrayList<>(count);
+    for (int index = 0; index < count; index++) {
+      UUID skillId = readUuid(input);
+      int skill = input.readUnsignedByte();
+      if (skill >= SkillType.values().length) {
+        throw new IllegalArgumentException("Invalid Army battle skill type");
+      }
+      Instant accepted = readInstant(input);
+      var before = new ArmyBattleHeads(readArmy(input), readArmy(input));
+      var after = new ArmyBattleHeads(readArmy(input), readArmy(input));
+      int outcome = input.readUnsignedByte();
+      if (outcome >= ArmyBattleIntervention.Outcome.values().length) {
+        throw new IllegalArgumentException("Invalid Army battle intervention outcome");
+      }
+      history.add(
+          new ArmyBattleIntervention(
+              skillId,
+              SkillType.values()[skill],
+              accepted,
+              before,
+              after,
+              ArmyBattleIntervention.Outcome.values()[outcome]));
+    }
+    int phase = input.readUnsignedByte();
+    if (phase > ArmyBattleSession.Status.values().length) {
+      throw new IllegalArgumentException("Invalid extended Army battle phase");
+    }
+    var resolution =
+        new ArmyBattleSession.Resolution(
+            phase == 0
+                ? ArmyBattleSession.Status.CANCELLED
+                : ArmyBattleSession.Status.values()[phase - 1],
+            readArmy(input),
+            readArmy(input),
+            input.readDouble(),
+            input.readDouble(),
+            readInstant(input));
+    if (phase == 0) {
+      var pending = new ArmyBattleSession(request, null, history);
+      var heads = pending.currentHeads();
+      Instant latest =
+          heads.attacker().lastUpdated().isAfter(heads.defender().lastUpdated())
+              ? heads.attacker().lastUpdated()
+              : heads.defender().lastUpdated();
+      if (!resolution.equals(ArmyBattleSession.cancelled(pending, latest))) {
+        throw new IllegalArgumentException("Noncanonical extended Army pending battle padding");
+      }
+      return pending;
+    }
+    return new ArmyBattleSession(request, resolution, history);
+  }
+
+  private static void writePaidOperation(DataOutputStream output, ArmyPaidOperation operation)
+      throws IOException {
+    ArmyPaidRequest request = operation.request();
+    writeUuid(output, request.operationId());
+    writeUuid(output, request.actorId());
+    output.writeByte(request.kind().ordinal());
+    output.writeBoolean(request.before() != null);
+    if (request.before() != null) writeArmy(output, request.before());
+    writeArmy(output, request.after());
+    writeString(output, request.amount().toPlainString());
+    writeInstant(output, request.acceptedAt());
+    output.writeInt(request.maximumNationArmies());
+    if (request.maximumNationSoldiers() != Long.MAX_VALUE)
+      output.writeLong(request.maximumNationSoldiers());
+    output.writeBoolean(operation.cancellationRequested());
+    NationDebitService.Receipt receipt = operation.debitReceipt();
+    if (receipt == null) {
+      output.writeByte(-1);
+      output.writeLong(0);
+      output.writeInt(0);
+    } else {
+      output.writeByte(receipt.status().ordinal());
+      writeInstant(output, receipt.decidedAt());
+    }
+  }
+
+  private static ArmyPaidOperation readPaidOperation(DataInputStream input, boolean bounded)
+      throws IOException {
+    UUID operationId = readUuid(input);
+    UUID actorId = readUuid(input);
+    int kindOrdinal = input.readUnsignedByte();
+    if (kindOrdinal > 1) {
+      throw new IllegalArgumentException("Unknown Army paid operation kind");
+    }
+    ArmyPaidRequest.Kind kind = ArmyPaidRequest.Kind.values()[kindOrdinal];
+    ArmySnapshot before = readPaidBoolean(input) ? readArmy(input) : null;
+    ArmySnapshot after = readArmy(input);
+    String encodedAmount = readString(input);
+    if (encodedAmount.length() > 19
+        || !encodedAmount.matches("(?:0|[1-9][0-9]{0,15})\\.[0-9]{2}")) {
+      throw new IllegalArgumentException("Noncanonical Army paid amount");
+    }
+    BigDecimal amount = new BigDecimal(encodedAmount);
+    Instant acceptedAt = readInstant(input);
+    int maximumNationArmies = input.readInt();
+    long maximumNationSoldiers = bounded ? readSoldierLimit(input) : Long.MAX_VALUE;
+    ArmyPaidRequest request =
+        new ArmyPaidRequest(
+            operationId,
+            actorId,
+            kind,
+            before,
+            after,
+            amount,
+            acceptedAt,
+            maximumNationArmies,
+            maximumNationSoldiers);
+    if (!encodedAmount.equals(request.amount().toPlainString())) {
+      throw new IllegalArgumentException("Noncanonical Army paid amount");
+    }
+    boolean cancellationRequested = readPaidBoolean(input);
+    int statusOrdinal = input.readByte();
+    NationDebitService.Receipt receipt = null;
+    if (statusOrdinal == -1) {
+      long paddingSeconds = input.readLong();
+      int paddingNanos = input.readInt();
+      if (paddingSeconds != 0 || paddingNanos != 0) {
+        throw new IllegalArgumentException("Nonzero Army paid pending proof padding");
+      }
+    } else {
+      if (statusOrdinal < 0 || statusOrdinal > 3) {
+        throw new IllegalArgumentException("Unknown Army paid debit status");
+      }
+      Instant decidedAt = readInstant(input);
+      receipt =
+          new NationDebitService.Receipt(
+              request.debitRequest(), NationDebitService.Status.values()[statusOrdinal], decidedAt);
+      if (!decidedAt.equals(receipt.decidedAt())) {
+        throw new IllegalArgumentException("Noncanonical Army paid debit decision time");
+      }
+    }
+    return new ArmyPaidOperation(request, cancellationRequested, receipt);
+  }
+
+  private static boolean readPaidBoolean(DataInputStream input) throws IOException {
+    int value = input.readUnsignedByte();
+    if (value != 0 && value != 1) {
+      throw new IllegalArgumentException("Invalid Army paid boolean flag");
+    }
+    return value == 1;
+  }
+
+  private static void writeMigration(DataOutputStream output, ArmyMigrationEvidence migration)
+      throws IOException {
+    writeString(output, migration.sourceSha256());
+    writeMap(output, migration.rawRecords());
+    writeMap(output, migration.inferences());
+  }
+
+  private static ArmyMigrationEvidence readMigration(DataInputStream input) throws IOException {
+    return new ArmyMigrationEvidence(readString(input), readMap(input), readMap(input));
+  }
+
+  private static void writeToken(DataOutputStream output, ArmyToken token) throws IOException {
+    writeUuid(output, token.armyId());
+    writeUuid(output, token.incarnation());
+    output.writeLong(token.generation());
+  }
+
+  private static ArmyToken readToken(DataInputStream input) throws IOException {
+    return new ArmyToken(readUuid(input), readUuid(input), input.readLong());
+  }
+
+  private static void writeUuid(DataOutputStream output, UUID value) throws IOException {
+    output.writeLong(value.getMostSignificantBits());
+    output.writeLong(value.getLeastSignificantBits());
+  }
+
+  private static UUID readUuid(DataInputStream input) throws IOException {
+    return new UUID(input.readLong(), input.readLong());
+  }
+
+  private static void writeNullableUuid(DataOutputStream output, UUID value) throws IOException {
+    output.writeBoolean(value != null);
+    if (value != null) writeUuid(output, value);
+  }
+
+  private static UUID readNullableUuid(DataInputStream input) throws IOException {
+    int present = input.readUnsignedByte();
+    if (present != 0 && present != 1)
+      throw new IllegalArgumentException("Invalid UUID presence flag");
+    return present == 0 ? null : readUuid(input);
+  }
+
+  private static void writeInstant(DataOutputStream output, Instant value) throws IOException {
+    output.writeLong(value.getEpochSecond());
+    output.writeInt(value.getNano());
+  }
+
+  private static Instant readInstant(DataInputStream input) throws IOException {
+    long epochSecond = input.readLong();
+    int nano = input.readInt();
+    if (nano < 0 || nano >= 1_000_000_000)
+      throw new IllegalArgumentException("Invalid Instant nanos");
+    try {
+      return Instant.ofEpochSecond(epochSecond, nano);
+    } catch (DateTimeException invalid) {
+      throw new IllegalArgumentException("Instant is outside the supported range", invalid);
+    }
+  }
+
+  private static ArmyType readType(DataInputStream input) throws IOException {
+    String key = readString(input);
+    for (ArmyType type : ArmyType.values()) {
+      if (type.key().equals(key)) return type;
+    }
+    throw new IllegalArgumentException("Unknown canonical ArmyType key");
+  }
+
+  private static ArmyState readState(DataInputStream input) throws IOException {
+    String key = readString(input);
+    for (ArmyState state : ArmyState.values()) {
+      if (state.key().equals(key)) return state;
+    }
+    throw new IllegalArgumentException("Unknown canonical ArmyState key");
+  }
+
+  private static void writeString(DataOutputStream output, String value) throws IOException {
+    output.writeInt(utf8Length(value, MAX_ROW_BYTES));
+    for (int index = 0; index < value.length(); index++) {
+      int codePoint = value.charAt(index);
+      if (Character.isHighSurrogate((char) codePoint)) {
+        codePoint = Character.toCodePoint((char) codePoint, value.charAt(++index));
+      }
+      if (codePoint <= 0x7f) {
+        output.writeByte(codePoint);
+      } else if (codePoint <= 0x7ff) {
+        output.writeByte(0xc0 | codePoint >>> 6);
+        output.writeByte(0x80 | codePoint & 0x3f);
+      } else if (codePoint <= 0xffff) {
+        output.writeByte(0xe0 | codePoint >>> 12);
+        output.writeByte(0x80 | codePoint >>> 6 & 0x3f);
+        output.writeByte(0x80 | codePoint & 0x3f);
+      } else {
+        output.writeByte(0xf0 | codePoint >>> 18);
+        output.writeByte(0x80 | codePoint >>> 12 & 0x3f);
+        output.writeByte(0x80 | codePoint >>> 6 & 0x3f);
+        output.writeByte(0x80 | codePoint & 0x3f);
+      }
+    }
+  }
+
+  static int utf8Length(String value, int byteBudget) {
+    long length = 0;
+    for (int index = 0; index < value.length(); index++) {
+      char current = value.charAt(index);
+      if (current <= 0x7f) {
+        length++;
+      } else if (current <= 0x7ff) {
+        length += 2;
+      } else if (Character.isHighSurrogate(current)) {
+        if (index + 1 >= value.length() || !Character.isLowSurrogate(value.charAt(index + 1))) {
+          throw new IllegalArgumentException("Unpaired high surrogate in Army evidence");
+        }
+        index++;
+        length += 4;
+      } else if (Character.isLowSurrogate(current)) {
+        throw new IllegalArgumentException("Unpaired low surrogate in Army evidence");
+      } else {
+        length += 3;
+      }
+      if (length > byteBudget)
+        throw new IllegalArgumentException("Army UTF-8 string exceeds budget");
+    }
+    return (int) length;
+  }
+
+  private static void writeNationClosure(DataOutputStream output, ArmyNationClosure closure)
+      throws IOException {
+    writeUuid(output, closure.operationId());
+    writeUuid(output, closure.nationId());
+    writeInstant(output, closure.acceptedAt());
+    output.writeBoolean(closure.retiredAt() != null);
+    if (closure.retiredAt() != null) writeInstant(output, closure.retiredAt());
+    if (closure.retirements().size() > MAX_ENTRIES) {
+      throw new IllegalArgumentException("Too many Army nation closure retirements");
+    }
+    output.writeInt(closure.retirements().size());
+    for (var entry : new TreeMap<>(closure.retirements()).entrySet()) {
+      writeUuid(output, entry.getKey());
+      writeTombstone(output, entry.getValue());
+    }
+  }
+
+  private static ArmyNationClosure readNationClosure(DataInputStream input) throws IOException {
+    UUID operationId = readUuid(input);
+    UUID nationId = readUuid(input);
+    Instant acceptedAt = readInstant(input);
+    int retiredFlag = input.readUnsignedByte();
+    if (retiredFlag > 1) {
+      throw new IllegalArgumentException("Invalid Army nation closure retirement flag");
+    }
+    Instant retiredAt = retiredFlag == 1 ? readInstant(input) : null;
+    int count = input.readInt();
+    if (count < 0 || count > MAX_ENTRIES || count > input.available() / 16) {
+      throw new IllegalArgumentException("Invalid Army nation closure retirement count");
+    }
+    Map<UUID, ArmyTombstone> retirements = new HashMap<>();
+    UUID previous = null;
+    for (int index = 0; index < count; index++) {
+      UUID armyId = readUuid(input);
+      if (previous != null && previous.compareTo(armyId) >= 0) {
+        throw new IllegalArgumentException(
+            "Army nation closure retirements are duplicate or unsorted");
+      }
+      ArmyTombstone tombstone = readTombstone(input);
+      if (!armyId.equals(tombstone.token().armyId())) {
+        throw new IllegalArgumentException(
+            "Army nation closure retirement key differs from its identity");
+      }
+      retirements.put(armyId, tombstone);
+      previous = armyId;
+    }
+    return new ArmyNationClosure(operationId, nationId, acceptedAt, retiredAt, retirements);
+  }
+
+  private static void writeSkillUse(DataOutputStream output, ArmySkillUse use) throws IOException {
+    var request = use.request();
+    writeUuid(output, request.operationId());
+    writeUuid(output, request.actorId());
+    writeUuid(output, request.nationId());
+    writeString(output, request.skillType().name());
+    output.writeInt(request.level());
+    output.writeInt(request.rulesVersion());
+    if (request.maximumNationSoldiers() != Long.MAX_VALUE)
+      output.writeLong(request.maximumNationSoldiers());
+    writeSkillNullableUuid(output, request.previousUseId());
+    writeInstant(output, request.acceptedAt());
+    output.writeBoolean(request.origin() != null);
+    if (request.origin() != null) {
+      var origin = request.origin();
+      writeSkillNullableUuid(output, origin.worldId());
+      writeString(output, origin.worldName());
+      output.writeDouble(origin.x());
+      output.writeDouble(origin.y());
+      output.writeDouble(origin.z());
+      output.writeFloat(origin.yaw());
+      output.writeFloat(origin.pitch());
+    }
+    writeSkillArmyMap(output, request.targets());
+    writeSkillArmyMap(output, use.effects());
+    writeInstant(output, use.readyAt());
+  }
+
+  private static ArmySkillUse readSkillUse(DataInputStream input, boolean bounded)
+      throws IOException {
+    UUID operationId = readUuid(input);
+    UUID actorId = readUuid(input);
+    UUID nationId = readUuid(input);
+    SkillType skillType = SkillType.valueOf(readString(input));
+    int level = input.readInt();
+    int rulesVersion = input.readInt();
+    long maximumNationSoldiers = bounded ? readSoldierLimit(input) : Long.MAX_VALUE;
+    UUID previousUseId = readSkillNullableUuid(input);
+    Instant acceptedAt = readInstant(input);
+    ArmyPosition origin = null;
+    if (readSkillBoolean(input)) {
+      origin =
+          new ArmyPosition(
+              readSkillNullableUuid(input),
+              readString(input),
+              input.readDouble(),
+              input.readDouble(),
+              input.readDouble(),
+              input.readFloat(),
+              input.readFloat());
+    }
+    var request =
+        new ArmySkillRequest(
+            operationId,
+            actorId,
+            nationId,
+            skillType,
+            level,
+            rulesVersion,
+            previousUseId,
+            acceptedAt,
+            origin,
+            readSkillArmyMap(input),
+            maximumNationSoldiers);
+    return new ArmySkillUse(request, readSkillArmyMap(input), readInstant(input));
+  }
+
+  private static long readSoldierLimit(DataInputStream input) throws IOException {
+    long limit = input.readLong();
+    if (limit < 0 || limit == Long.MAX_VALUE)
+      throw new IllegalArgumentException("Noncanonical Army total soldier limit");
+    return limit;
+  }
+
+  private static void writeSkillNullableUuid(DataOutputStream output, UUID value)
+      throws IOException {
+    output.writeBoolean(value != null);
+    if (value != null) writeUuid(output, value);
+  }
+
+  private static UUID readSkillNullableUuid(DataInputStream input) throws IOException {
+    return readSkillBoolean(input) ? readUuid(input) : null;
+  }
+
+  private static boolean readSkillBoolean(DataInputStream input) throws IOException {
+    int flag = input.readUnsignedByte();
+    if (flag > 1) throw new IllegalArgumentException("Invalid Army skill flag");
+    return flag == 1;
+  }
+
+  private static void writeSkillArmyMap(DataOutputStream output, Map<UUID, ArmySnapshot> armies)
+      throws IOException {
+    if (armies.size() > MAX_ENTRIES) {
+      throw new IllegalArgumentException("Too many Army skill targets");
+    }
+    output.writeInt(armies.size());
+    for (var entry : new TreeMap<>(armies).entrySet()) {
+      writeUuid(output, entry.getKey());
+      writeArmy(output, entry.getValue());
+    }
+  }
+
+  private static Map<UUID, ArmySnapshot> readSkillArmyMap(DataInputStream input)
+      throws IOException {
+    int count = input.readInt();
+    if (count < 0 || count > MAX_ENTRIES || count > input.available() / 16) {
+      throw new IllegalArgumentException("Invalid Army skill target count");
+    }
+    Map<UUID, ArmySnapshot> result = new HashMap<>();
+    UUID previous = null;
+    for (int index = 0; index < count; index++) {
+      UUID armyId = readUuid(input);
+      if (previous != null && previous.compareTo(armyId) >= 0) {
+        throw new IllegalArgumentException("Army skill targets are duplicate or unsorted");
+      }
+      ArmySnapshot army = readArmy(input);
+      if (!armyId.equals(army.token().armyId())) {
+        throw new IllegalArgumentException("Army skill target key differs from its identity");
+      }
+      result.put(armyId, army);
+      previous = armyId;
+    }
+    return result;
+  }
+
+  private static String readString(DataInputStream input) throws IOException {
+    int length = input.readInt();
+    if (length < 0 || length > MAX_ROW_BYTES || length > input.available()) {
+      throw new IllegalArgumentException("Invalid Army string length");
+    }
+    byte[] bytes = input.readNBytes(length);
+    return StandardCharsets.UTF_8
+        .newDecoder()
+        .onMalformedInput(CodingErrorAction.REPORT)
+        .onUnmappableCharacter(CodingErrorAction.REPORT)
+        .decode(ByteBuffer.wrap(bytes))
+        .toString();
+  }
+
+  private static void writeMap(DataOutputStream output, Map<String, String> values)
+      throws IOException {
+    if (values.size() > MAX_ENTRIES)
+      throw new IllegalArgumentException("Too many Army evidence entries");
+    output.writeInt(values.size());
+    for (Map.Entry<String, String> entry : new TreeMap<>(values).entrySet()) {
+      writeString(output, entry.getKey());
+      writeString(output, entry.getValue());
+    }
+  }
+
+  private static Map<String, String> readMap(DataInputStream input) throws IOException {
+    int count = input.readInt();
+    if (count < 0 || count > MAX_ENTRIES)
+      throw new IllegalArgumentException("Invalid Army map size");
+    Map<String, String> result = new HashMap<>();
+    String previous = null;
+    for (int index = 0; index < count; index++) {
+      String key = readString(input);
+      if (previous != null && previous.compareTo(key) >= 0) {
+        throw new IllegalArgumentException("Army evidence keys are duplicate or unsorted");
+      }
+      result.put(key, readString(input));
+      previous = key;
+    }
+    return result;
+  }
+
+  private static final class CountingOutputStream extends OutputStream {
+    private final int budget;
+    private int count;
+
+    private CountingOutputStream(int budget) {
+      this.budget = budget;
+    }
+
+    @Override
+    public void write(int value) {
+      add(1);
+    }
+
+    @Override
+    public void write(byte[] bytes, int offset, int length) {
+      Objects.checkFromIndexSize(offset, length, bytes.length);
+      add(length);
+    }
+
+    private void add(int length) {
+      if (length > budget - count) {
+        throw new IllegalArgumentException("Army row exceeds size bound");
+      }
+      count += length;
+    }
+  }
+
+  private static final class FixedOutputStream extends OutputStream {
+    private final byte[] bytes;
+    private int offset;
+
+    private FixedOutputStream(int length) {
+      bytes = new byte[length];
+    }
+
+    @Override
+    public void write(int value) {
+      if (offset >= bytes.length)
+        throw new IllegalArgumentException("Army row exceeded exact size");
+      bytes[offset++] = (byte) value;
+    }
+
+    @Override
+    public void write(byte[] values, int sourceOffset, int length) {
+      Objects.checkFromIndexSize(sourceOffset, length, values.length);
+      if (length > bytes.length - offset) {
+        throw new IllegalArgumentException("Army row exceeded exact size");
+      }
+      System.arraycopy(values, sourceOffset, bytes, offset, length);
+      offset += length;
+    }
+  }
+
+  @FunctionalInterface
+  private interface BinaryWriter {
+    void write(DataOutputStream output) throws IOException;
+  }
+
+  @FunctionalInterface
+  private interface BinaryReader<Value> {
+    Value read(DataInputStream input) throws IOException;
+  }
+
+  @FunctionalInterface
+  private interface BinaryKindReader<Value> {
+    Value read(DataInputStream input, int kind) throws IOException;
+  }
+}
