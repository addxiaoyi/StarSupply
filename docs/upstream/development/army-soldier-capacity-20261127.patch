+      f.service.recoverPaidOperation(request.operationId());
+      assertEquals(
+          new ArmySoldierCapacity(130, 0, 130), f.service.soldierCapacity(f.nation.id().value()));
+      f.service.shutdown();
+      f.open(false);
+      assertEquals(use, f.owner.snapshot().skillUses().get(use.request().operationId()));
+    }
+  }
