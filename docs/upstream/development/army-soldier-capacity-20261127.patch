+    Objects.requireNonNull(amount);
+    Objects.requireNonNull(category);
+    Objects.requireNonNull(description);
+    Objects.requireNonNull(paidBefore);
+    Objects.requireNonNull(preparedAt);
+    if (!id.equals(UUID.nameUUIDFromBytes(transactionId.getBytes(StandardCharsets.UTF_8)))
+        || !transactionId.startsWith("peace-treaty:" + treatyId + ":")
+        || payer.equals(receiver)
+        || amount.signum() <= 0
+        || amount.scale() > 2
+        || paidBefore.signum() < 0
+        || installmentsBefore < 0
+        || completedAt != null && completedAt.isBefore(preparedAt)
+        || category != NationTransferService.TransferCategory.REPARATION
+            && category != NationTransferService.TransferCategory.TRIBUTE)
+      throw new IllegalArgumentException("Invalid treaty payment intent");
+  }
+
+  static PeaceTreatyPayment prepare(
+      UUID treaty,
+      UUID record,
+      NationTransferService.TransferRequest request,
+      BigDecimal paidBefore,
+      int installmentsBefore) {
+    return new PeaceTreatyPayment(
+        UUID.nameUUIDFromBytes(request.transactionId().getBytes(StandardCharsets.UTF_8)),
+        treaty,
+        record,
+        request.transactionId(),
+        request.payerId(),
+        request.receiverId(),
+        request.amount(),
+        request.category(),
+        request.description(),
+        paidBefore,
+        installmentsBefore,
+        Instant.now(),
+        null);
+  }
+
+  NationTransferService.TransferRequest request() {
+    return new NationTransferService.TransferRequest(
+        transactionId, payer, receiver, amount, category, description);
+  }
+
+  boolean completed() {
+    return completedAt != null;
+  }
+
+  PeaceTreatyPayment complete() {
+    return completed()
+        ? this
+        : new PeaceTreatyPayment(
+            id,
+            treatyId,
+            recordId,
+            transactionId,
+            payer,
+            receiver,
+            amount,
+            category,
+            description,
+            paidBefore,
+            installmentsBefore,
+            preparedAt,
+            Instant.now());
+  }
+
+  boolean sameRequest(PeaceTreatyPayment other) {
+    return other != null
+        && id.equals(other.id)
+        && treatyId.equals(other.treatyId)
+        && recordId.equals(other.recordId)
+        && transactionId.equals(other.transactionId)
+        && payer.equals(other.payer)
+        && receiver.equals(other.receiver)
+        && amount.compareTo(other.amount) == 0
+        && category == other.category
+        && description.equals(other.description)
+        && paidBefore.compareTo(other.paidBefore) == 0
+        && installmentsBefore == other.installmentsBefore
+        && preparedAt.equals(other.preparedAt);
+  }
+}
