+  @Test
+  void rowNineRoundTripsAndRejectsDowngradeWrongKindCountsFlagsAndTruncation() throws Exception {
+    var owner = seed(false, root, 80);
+    var old = ArmyAuthorityCodec.encode(owner.snapshot());
+    assertEquals(6, Base64.getDecoder().decode(old.getProperty("armyBattle." + BATTLE))[5]);
+    owner.useSkill(national(owner, 11, TIME.plusSeconds(1)));
+    var current = owner.snapshot();
+    var encoded = ArmyAuthorityCodec.encode(current);
+    var row = Base64.getDecoder().decode(encoded.getProperty("armyBattle." + BATTLE));
+    assertEquals(9, row[5]);
+    assertEquals(current, ArmyAuthorityCodec.decode(encoded));
+    var cancelled = owner.cancelBattle(BATTLE, TIME.plusSeconds(2));
+    assertEquals(
+        cancelled,
+        ArmyAuthorityCodec.decode(ArmyAuthorityCodec.encode(owner.snapshot()))
+            .battleSessions()
+            .get(BATTLE));
+    for (int version = 1; version <= 5; version++) {
+      var downgraded = ArmyAuthorityCodec.encode(current);
+      downgraded.setProperty(ArmyAuthorityCodec.VERSION, Integer.toString(version));
+      assertThrows(IllegalArgumentException.class, () -> ArmyAuthorityCodec.decode(downgraded));
+    }
+    var oldRow = Base64.getDecoder().decode(old.getProperty("armyBattle." + BATTLE));
+    int countOffset = (oldRow.length - 6 - 2 * 16 - 12 - 1 - 16 - 12) / 2 + 6 + 2 * 16 + 12;
+    assertEquals(1, ByteBuffer.wrap(row).getInt(countOffset));
+    for (int count :
+        new int[] {-1, 0, ArmyBattleSession.MAX_INTERVENTIONS + 1, Integer.MAX_VALUE}) {
+      var malformed = row.clone();
+      ByteBuffer.wrap(malformed).putInt(countOffset, count);
+      rejectsRow(current, malformed);
+    }
+    var wrongKind = row.clone();
+    wrongKind[5] = 6;
+    rejectsRow(current, wrongKind);
+    var wrongSkill = row.clone();
+    wrongSkill[countOffset + 4 + 16] = (byte) 255;
+    rejectsRow(current, wrongSkill);
+    int terminalBytes = oldRow.length - countOffset;
+    var wrongOutcome = row.clone();
+    wrongOutcome[row.length - terminalBytes - 1] = (byte) 255;
+    rejectsRow(current, wrongOutcome);
+    var wrongPhase = row.clone();
+    wrongPhase[row.length - terminalBytes] = (byte) 255;
+    rejectsRow(current, wrongPhase);
+    var wrongPadding = row.clone();
+    wrongPadding[wrongPadding.length - 1] ^= 1;
+    rejectsRow(current, wrongPadding);
+    rejectsRow(current, Arrays.copyOf(row, row.length - 1));
+    rejectsRow(current, Arrays.copyOf(row, countOffset + 4));
+    rejectsRow(current, Arrays.copyOf(row, row.length + 1));
+  }
