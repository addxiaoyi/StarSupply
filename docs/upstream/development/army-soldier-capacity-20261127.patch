+      var diplomacy = mock(dev.starcore.starcore.module.diplomacy.DiplomacyService.class);
+      var wars =
+          new WarServiceImpl(f.plugin, diplomacy, storage, WarServiceImpl.WarConfig.defaults());
+      var treaties =
+          new PeaceTreatyService(
+              f.plugin,
+              wars,
+              storage,
+              f.treasury,
+              mock(dev.starcore.starcore.territory.TerritoryService.class),
+              mock(dev.starcore.starcore.module.army.ArmyService.class),
+              diplomacy,
+              PeaceTreatyService.PeaceTreatyConfig.defaults(),
+              () -> Optional.of(module));
+      try {
+        var terms =
+            List.<PeaceTreaty.PeaceTerm>of(
+                new PeaceTreaty.ReparationTerm(new BigDecimal("1000"), 2));
+        assertThatThrownBy(() -> treaties.proposeTreaty(war.id(), receiver, payer, terms))
+            .isInstanceOf(IllegalArgumentException.class)
+            .hasMessage("TREATY_DURABLE_TERMS_UNSUPPORTED");
+        assertThat(treaties.getTreatyForWar(war.id())).isEmpty();
+        assertThat(storage.loadAllTreatyData()).isEmpty();
+        assertThat(module.getAllReparations()).isEmpty();
+        assertThat(storage.loadWar(war.id()).status()).isEqualTo(war.status());
+        assertThat(storage.loadWar(war.id()).isActive()).isTrue();
+        f.balances("2000", "0");
+        var treaty =
+            new PeaceTreaty(UUID.randomUUID(), war.id(), receiver, payer, terms, Instant.now());
+        var debt =
+            module.createTreatyReparation(
+                UUID.randomUUID(), treaty.id(), payer, receiver, new BigDecimal("1000"), 2);
+        f.storage().saveTreatyData(
+            treaty.id(),
+            "STATE",
+                """
+                {"version":2,"treaty":{"id":"%s","warId":"%s","victor":"%s",
+                "defeated":"%s","terms":[{"type":"REPARATION","amount":"1000",
+                "installments":2}],"status":"ACCEPTED","proposedAt":%d,"acceptedAt":%d},
+                "execution":{"status":"COMPLETED","steps":[{"index":0,"type":"ReparationTerm",
+                "status":"APPLIED","compensationData":{"legacy":"accepted"}}]},
+                "reparations":[],"militaryRestrictions":[],"resourceTributes":[],
+                "politicalRestrictions":[],"payments":[]}
+                """
+                .formatted(
+                    treaty.id(),
+                    war.id(),
+                    receiver,
+                    payer,
+                    treaty.proposedAt().toEpochMilli(),
+                    Instant.now().toEpochMilli()));
+        treaties.reload();
+        assertThat(treaties.getTreaty(treaty.id()).orElseThrow().status())
+            .isEqualTo(PeaceTreaty.PeaceTreatyStatus.ACCEPTED);
+        assertThat(module.getReparationsForTreaty(treaty.id()))
+            .extracting(WarReparation::id)
+            .containsExactly(debt.id());
+        assertThat(module.getAllReparations()).hasSize(1);
+        doThrow(new IllegalStateException("provider unavailable")).when(f.treasury).transfer(any());
+        assertThat(module.payReparation(debt.id(), BigDecimal.TEN)).isFalse();
+        assertThatThrownBy(() -> f.storage().deleteWar(war.id()))
+            .hasMessageContaining("Pending reparation");
+        doCallRealMethod().when(f.treasury).transfer(any());
+        module.recoverSettlements();
+        f.storage().deleteWar(war.id());
+        assertThat(module.payReparation(debt.id(), BigDecimal.TEN)).isFalse();
+        assertThat(f.module(f.storage()).getActiveReparations()).isEmpty();
+        f.balances("1990", "10");
+      } finally {
+        treaties.shutdown();
+        wars.shutdown();
+      }
+    }
+  }
+
+  private void writeLegacy(ReparationsSnapshotCodec.Snapshot snapshot) throws Exception {
+    var file = root.resolve("reparations/reparations.dat");
+    Files.createDirectories(file.getParent());
+    try (var out = Files.newOutputStream(file)) {
+      ReparationsSnapshotCodec.toProperties(snapshot).store(out, "legacy");
+    }
+  }
+
+  private static void set(Object target, String name, Object value) throws Exception {
+    var field = target.getClass().getDeclaredField(name);
+    field.setAccessible(true);
+    field.set(target, value);
+  }
+}
