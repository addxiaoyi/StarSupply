diff --git a/src/test/java/dev/starcore/starcore/core/persistence/FileAuthorityProcessProbe.java b/src/test/java/dev/starcore/starcore/core/persistence/FileAuthorityProcessProbe.java
new file mode 100644
index 0000000000000000000000000000000000000000..2e830dd1674168e1b723bc211e7959448e4f6aa2
--- /dev/null
+++ b/src/test/java/dev/starcore/starcore/core/persistence/FileAuthorityProcessProbe.java
@@ -0,0 +1,258 @@
+package dev.starcore.starcore.core.persistence;
+
+import com.google.gson.Gson;
+import dev.starcore.starcore.core.database.DatabaseService;
+import dev.starcore.starcore.foundation.territory.TerritoryRetirementService;
+import dev.starcore.starcore.module.city.CityRetirementService;
+import dev.starcore.starcore.module.diplomacy.alliance.storage.AllianceStorage;
+import dev.starcore.starcore.module.diplomacy.military.storage.MilitaryAllianceStorage;
+import dev.starcore.starcore.module.nation.model.*;
+import dev.starcore.starcore.module.treasury.TreasuryRetirementService;
+import java.io.*;
+import java.lang.reflect.*;
+import java.math.BigDecimal;
+import java.nio.file.*;
+import java.util.*;
+import java.util.logging.Logger;
+
+/** Child-JVM entry point. No Bukkit bootstrap or mocked storage participates in these probes. */
+public final class FileAuthorityProcessProbe {
+  static final String PREFIX = "dev.starcore.starcore.";
+  static final NationId NATION =
+      NationId.of(UUID.fromString("10000000-0000-0000-0000-000000000001"));
+
+  static Path authorityPath(Path root, String kind) {
+    return root.resolve(
+        switch (kind) {
+          case "NATION" -> "nation/nations.properties";
+          case "TERRITORY" -> "territory/claims.properties";
+          case "TREASURY" -> "treasury/treasury.properties";
+          case "DIPLOMACY" -> "diplomacy/relations.properties";
+          case "CITY" -> "cities/ledger.json";
+          case "BILATERAL" -> "diplomacy/alliance_state.properties";
+          case "MILITARY" -> "military-alliance/military_alliance_state.properties";
+          case "FEDERATION" -> "alliance/federation-authority.properties";
+          case "WAR" -> "wars/authority.properties";
+          default -> "snapshot.properties";
+        });
+  }
+
+  public static void main(String[] args) throws Exception {
+    String mode = args[0], kind = args[1], token = args[3];
+    Path root = Path.of(args[2]);
+    Path path = authorityPath(root, kind);
+    if (mode.equals("hold")) {
+      try (var lock = FileAuthorityLock.acquire(path)) {
+        signal(root, token, "ready", "held");
+        new BufferedReader(new InputStreamReader(System.in)).readLine();
+      }
+      return;
+    }
+    if (mode.equals("atomic-interrupt")) {
+      AtomicFilePersistence.replace(
+          path,
+          temp -> {
+            Files.writeString(temp, "unconfirmed");
+            signal(root, token, "ready", "temp-written");
+            new BufferedReader(new InputStreamReader(System.in)).readLine();
+          });
+      return;
+    }
+    if (mode.equals("snapshot-save")) {
+      var store =
+          new DurablePropertiesStore(
+              path, null, "starcore_probe", Properties::new, p -> {}, (a, b) -> {});
+      store.load();
+      var value = new Properties();
+      value.setProperty("winner", token);
+      store.save(value);
+      signal(root, token, "ready", "committed");
+      new BufferedReader(new InputStreamReader(System.in)).readLine();
+      return;
+    }
+    if (mode.equals("read")) signal(root, token, "loading", "before-load");
+    var work = prepare(root, kind, UUID.fromString(token), mode.equals("race"));
+    signal(root, token, "ready", "selected");
+    if (mode.equals("read")) return;
+    if (new BufferedReader(new InputStreamReader(System.in)).readLine() == null) return;
+    signal(root, token, "started", "saving");
+    try {
+      work.run();
+      signal(root, token, "result", "OK");
+    } catch (RuntimeException error) {
+      String trace = stack(error);
+      if (!trace.toLowerCase(Locale.ROOT).matches("(?s).*(conflict|changed|stale).*")) {
+        signal(root, token, "result", "ERROR\n" + trace);
+        throw error;
+      }
+      signal(root, token, "result", "CONFLICT\n" + trace);
+    }
+  }
+
+  static Runnable prepare(Path root, String kind, UUID operation) throws Exception {
+    return prepare(root, kind, operation, true);
+  }
+
+  static Runnable prepare(Path root, String kind, UUID operation, boolean write) throws Exception {
+    var persistence =
+        new PersistenceService(null, null) {
+          @Override
+          public Path namespacePath(String namespace) throws IOException {
+            return Files.createDirectories(root.resolve(namespace));
+          }
+        };
+    if (kind.equals("BILATERAL")) {
+      var storage = new AllianceStorage(null, persistence, null);
+      storage.loadStateSnapshot();
+      return () -> storage.retire(operation, NATION);
+    }
+    if (kind.equals("MILITARY")) {
+      var storage = new MilitaryAllianceStorage(null, persistence, null);
+      storage.loadState();
+      return () -> storage.retire(operation, NATION);
+    }
+    if (kind.equals("WAR")) {
+      Object backend = create("war.WarStorageBackend", new DatabaseService(null, null));
+      Object codec = create("war.WarJsonCodec", new Gson(), Logger.getAnonymousLogger());
+      java.util.function.Supplier<Properties> empty =
+          () -> (Properties) call(type("war.WarAuthority"), "empty");
+      Object storage =
+          create(
+              "war.WarAuthority",
+              root.resolve("wars"),
+              backend,
+              codec,
+              empty,
+              (java.util.function.Supplier<Properties>) Properties::new);
+      var selected = (Properties) call(storage, "load");
+      selected.setProperty(
+          "disbandAdmission." + operation,
+          "{\"nations\":[\"" + NATION + "\"],\"decision\":\"ACCEPTED\"}");
+      return () -> call(storage, "save", selected);
+    }
+    if (kind.equals("FEDERATION")) {
+      var storage =
+          new dev.starcore.starcore.module.alliance.AllianceStorage(
+              new DatabaseService(null, null), persistence, null);
+      var selected = call(storage, "loadSnapshot");
+      if (!write) return () -> {};
+      var candidate = call(selected, "retire", operation, NATION);
+      return () -> call(storage, "saveSnapshot", selected, candidate);
+    }
+    if (kind.equals("CITY")) {
+      var storage = create("module.city.FileCityLedgerStorage", root.resolve("cities"));
+      var selected = call(storage, "load");
+      var receipt = new CityRetirementService.CityRetirementReceipt(operation, NATION, List.of());
+      var candidate = call(selected, "next", Map.of(), Set.of(), Map.of(NATION, receipt));
+      return () -> call(storage, "save", candidate);
+    }
+    if (kind.equals("TERRITORY")) {
+      var storage = create("foundation.territory.FileTerritoryLedgerStorage", persistence);
+      call(storage, "load");
+      var receipt =
+          new TerritoryRetirementService.RetirementReceipt(operation, NATION.toString(), 0);
+      var candidate =
+          create(
+              "foundation.territory.TerritoryLedger",
+              Map.of(),
+              Map.of(),
+              Map.of(),
+              Map.of(NATION.toString(), receipt));
+      return () -> call(storage, "save", candidate);
+    }
+    String domain = kind.toLowerCase(Locale.ROOT);
+    String name =
+        "module."
+            + domain
+            + ".Persistence"
+            + switch (kind) {
+              case "NATION" -> "Nation";
+              case "TREASURY" -> "Treasury";
+              case "DIPLOMACY" -> "Diplomacy";
+              default -> throw new IllegalArgumentException(kind);
+            }
+            + "StateStorage";
+    var storage = create(name, domain, persistence);
+    var selected = (Properties) call(storage, "load");
+    if (!write) return () -> {};
+    final Object candidate;
+    if (kind.equals("NATION")) {
+      var nation =
+          new Nation(NATION, "Writer" + operation.toString().substring(0, 8), operation, "Founder");
+      candidate = call(type("module.nation.NationStateCodec"), "toProperties", List.of(nation));
+    } else if (kind.equals("TREASURY")) {
+      var receipt =
+          new TreasuryRetirementService.TreasuryRetirementReceipt(
+              operation, NATION, BigDecimal.ZERO);
+      var state =
+          create(
+              "module.treasury.TreasuryStateCodec$TreasuryState",
+              Map.of(),
+              Map.of(),
+              Map.of(),
+              Map.of(),
+              Map.of(NATION, receipt));
+      candidate = call(type("module.treasury.TreasuryStateCodec"), "toProperties", state);
+    } else
+      candidate =
+          call(type("module.diplomacy.DiplomacyAuthority"), "retire", selected, operation, NATION);
+    return () -> call(storage, "save", candidate);
+  }
+
+  static Class<?> type(String name) {
+    try {
+      return Class.forName(PREFIX + name);
+    } catch (ClassNotFoundException error) {
+      throw new IllegalStateException(error);
+    }
+  }
+
+  static boolean matches(Class<?>[] types, Object[] args) {
+    if (types.length != args.length) return false;
+    for (int i = 0; i < types.length; i++)
+      if (args[i] != null && !types[i].isInstance(args[i])) return false;
+    return true;
+  }
+
+  static Object create(String name, Object... args) {
+    try {
+      for (var c : type(name).getDeclaredConstructors())
+        if (matches(c.getParameterTypes(), args)) {
+          c.setAccessible(true);
+          return c.newInstance(args);
+        }
+      throw new IllegalStateException("No constructor " + name);
+    } catch (ReflectiveOperationException error) {
+      throw unwrap(error);
+    }
+  }
+
+  static Object call(Object target, String name, Object... args) {
+    Class<?> type = target instanceof Class<?> c ? c : target.getClass();
+    try {
+      for (var m : type.getDeclaredMethods())
+        if (m.getName().equals(name) && matches(m.getParameterTypes(), args)) {
+          m.setAccessible(true);
+          return m.invoke(target instanceof Class<?> ? null : target, args);
+        }
+      throw new IllegalStateException("No method " + type.getName() + "." + name);
+    } catch (ReflectiveOperationException error) {
+      throw unwrap(error);
+    }
+  }
+
+  static RuntimeException unwrap(ReflectiveOperationException error) {
+    var cause = error instanceof InvocationTargetException ? error.getCause() : error;
+    return cause instanceof RuntimeException r ? r : new IllegalStateException(cause);
+  }
+
+  static void signal(Path root, String token, String state, String text) throws IOException {
+    Files.writeString(root.resolve(token + "." + state), text);
+  }
+
+  static String stack(Throwable error) {
+    var text = new StringWriter();
+    error.printStackTrace(new PrintWriter(text));
+    return text.toString();
+  }
+}
diff --git a/src/test/java/dev/starcore/starcore/core/persistence/FileAuthorityProcessTest.java b/src/test/java/dev/starcore/starcore/core/persistence/FileAuthorityProcessTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..3dcbf333b9bac5f9bb1e32d2698d308620bd6769
--- /dev/null
+++ b/src/test/java/dev/starcore/starcore/core/persistence/FileAuthorityProcessTest.java
@@ -0,0 +1,302 @@
+package dev.starcore.starcore.core.persistence;
+
+import static org.assertj.core.api.Assertions.*;
+
+import java.io.*;
+import java.net.URLClassLoader;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.*;
+import java.util.*;
+import java.util.concurrent.*;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+
+class FileAuthorityProcessTest {
+  @TempDir Path root;
+
+  final class Child implements AutoCloseable {
+    final String token = UUID.randomUUID().toString();
+    final Process process;
+    final ByteArrayOutputStream output = new ByteArrayOutputStream();
+    final Thread reader;
+
+    Child(String mode, String kind) throws Exception {
+      var cp = new LinkedHashSet<String>();
+      String configured = System.getProperty("surefire.test.class.path");
+      if (configured != null)
+        cp.addAll(List.of(configured.split(java.util.regex.Pattern.quote(File.pathSeparator))));
+      for (var loader = FileAuthorityProcessProbe.class.getClassLoader();
+          loader != null;
+          loader = loader.getParent())
+        if (loader instanceof URLClassLoader urls)
+          for (var url : urls.getURLs())
+            if (url.getProtocol().equals("file")) cp.add(Path.of(url.toURI()).toString());
+      cp.add(
+          Path.of(
+                  FileAuthorityProcessProbe.class
+                      .getProtectionDomain()
+                      .getCodeSource()
+                      .getLocation()
+                      .toURI())
+              .toString());
+      cp.add(
+          Path.of(
+                  FileAuthorityLock.class
+                      .getProtectionDomain()
+                      .getCodeSource()
+                      .getLocation()
+                      .toURI())
+              .toString());
+      Path args = root.resolve(token + ".args");
+      var lines =
+          new ArrayList<>(
+              List.of(
+                  "-Xms8m",
+                  "-Xmx64m",
+                  "-XX:+UseSerialGC",
+                  "-XX:ActiveProcessorCount=1",
+                  "-XX:TieredStopAtLevel=1",
+                  "-classpath",
+                  quote(String.join(File.pathSeparator, cp)),
+                  FileAuthorityProcessProbe.class.getName(),
+                  mode,
+                  kind,
+                  quote(root.toString()),
+                  token));
+      Files.write(args, lines, StandardCharsets.UTF_8);
+      String executable =
+          System.getProperty("os.name").toLowerCase(Locale.ROOT).contains("win")
+              ? "java.exe"
+              : "java";
+      process =
+          new ProcessBuilder(
+                  Path.of(System.getProperty("java.home"), "bin", executable).toString(),
+                  "@" + args)
+              .redirectErrorStream(true)
+              .start();
+      reader =
+          Thread.ofVirtual()
+              .start(
+                  () -> {
+                    try (var input = process.getInputStream()) {
+                      input.transferTo(output);
+                    } catch (IOException failure) {
+                      throw new UncheckedIOException(failure);
+                    }
+                  });
+    }
+
+    void await(String state) throws Exception {
+      Path signal = root.resolve(token + "." + state);
+      long deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(15);
+      while (!Files.exists(signal) && process.isAlive() && System.nanoTime() < deadline)
+        Thread.sleep(10);
+      assertThat(signal)
+          .withFailMessage(
+              "Child %s did not signal %s: %s",
+              process.pid(), state, output.toString(StandardCharsets.UTF_8))
+          .exists();
+    }
+
+    void go() throws IOException {
+      process.getOutputStream().write("go\n".getBytes(StandardCharsets.UTF_8));
+      process.getOutputStream().flush();
+    }
+
+    String result() throws Exception {
+      assertThat(process.waitFor(15, TimeUnit.SECONDS)).isTrue();
+      reader.join(2000);
+      assertThat(process.exitValue())
+          .withFailMessage(output.toString(StandardCharsets.UTF_8))
+          .isZero();
+      return Files.readString(root.resolve(token + ".result")).split("\n")[0];
+    }
+
+    void kill() throws Exception {
+      process.destroyForcibly();
+      assertThat(process.waitFor(10, TimeUnit.SECONDS)).isTrue();
+    }
+
+    public void close() throws Exception {
+      if (process.isAlive()) kill();
+      process.getOutputStream().close();
+      reader.join(2000);
+      assertThat(reader.isAlive()).isFalse();
+    }
+  }
+
+  static String quote(String value) {
+    return "\"" + value.replace("\\", "\\\\").replace("\"", "\\\"") + "\"";
+  }
+
+  @ParameterizedTest
+  @ValueSource(
+      strings = {
+        "NATION",
+        "TERRITORY",
+        "TREASURY",
+        "CITY",
+        "DIPLOMACY",
+        "BILATERAL",
+        "MILITARY",
+        "FEDERATION",
+        "WAR"
+      })
+  void independentJvmsCannotBothCommitTheSameOriginalSelection(String kind) throws Exception {
+    // Initialize ledgers which publish their empty snapshot on load before either child selects it.
+    FileAuthorityProcessProbe.prepare(root, kind, UUID.randomUUID());
+    try (var first = new Child("race", kind);
+        var second = new Child("race", kind)) {
+      first.await("ready");
+      second.await("ready");
+      Path path = FileAuthorityProcessProbe.authorityPath(root, kind);
+      try (var lock = FileAuthorityLock.acquire(path)) {
+        first.go();
+        second.go();
+        first.await("started");
+        second.await("started");
+        Thread.sleep(250);
+        assertThat(root.resolve(first.token + ".result")).doesNotExist();
+        assertThat(root.resolve(second.token + ".result")).doesNotExist();
+      }
+      String a = first.result(), b = second.result();
+      assertThat(List.of(a, b)).containsExactlyInAnyOrder("OK", "CONFLICT");
+      String winner = a.equals("OK") ? first.token : second.token;
+      String loser = a.equals("OK") ? second.token : first.token;
+      assertThat(Files.readString(path)).contains(winner).doesNotContain(loser);
+      // Reads also wait for the shared lock, then reload in a fresh JVM.
+      try (var lock = FileAuthorityLock.acquire(path);
+          var fresh = new Child("read", kind)) {
+        fresh.await("loading");
+        Thread.sleep(250);
+        assertThat(root.resolve(fresh.token + ".ready")).doesNotExist();
+        lock.close();
+        fresh.await("ready");
+        assertThat(fresh.process.waitFor(15, TimeUnit.SECONDS)).isTrue();
+        assertThat(fresh.process.exitValue()).isZero();
+      }
+    }
+  }
+
+  @Test
+  void killedOwnerReleasesTheOsLockAndKeepsTheSidecarIdentity() throws Exception {
+    Path path = FileAuthorityProcessProbe.authorityPath(root, "SNAPSHOT");
+    try (var child = new Child("hold", "SNAPSHOT")) {
+      child.await("ready");
+      assertThatThrownBy(() -> FileAuthorityLock.acquire(path))
+          .isInstanceOf(IOException.class)
+          .hasMessageContaining("busy");
+      child.kill();
+      try (var lock = FileAuthorityLock.acquire(path)) {
+        AtomicFilePersistence.replace(path, temp -> Files.writeString(temp, "after-owner-exit"));
+      }
+      assertThat(path.resolveSibling(path.getFileName() + ".lock")).isRegularFile();
+      assertThat(Files.readString(path)).isEqualTo("after-owner-exit");
+    }
+  }
+
+  @Test
+  void killedReplacementCannotLoseTheLastConfirmedSnapshotOrBlockRecovery() throws Exception {
+    Path path = FileAuthorityProcessProbe.authorityPath(root, "SNAPSHOT");
+    AtomicFilePersistence.replace(path, temp -> Files.writeString(temp, "confirmed"));
+    try (var child = new Child("atomic-interrupt", "SNAPSHOT")) {
+      child.await("ready");
+      assertThat(Files.readString(AtomicFilePersistence.temp(path))).isEqualTo("unconfirmed");
+      assertThatThrownBy(() -> AtomicFilePersistence.recover(path, Files::isRegularFile))
+          .isInstanceOf(IOException.class)
+          .hasMessageContaining("busy");
+      assertThat(AtomicFilePersistence.temp(path)).exists();
+      child.kill();
+      assertThat(AtomicFilePersistence.recover(path, Files::isRegularFile))
+          .isEqualTo(AtomicFilePersistence.RecoverySource.CURRENT);
+      assertThat(Files.readString(path)).isEqualTo("confirmed");
+      assertThat(AtomicFilePersistence.temp(path)).doesNotExist();
+    }
+  }
+
+  @Test
+  void processExitAfterConfirmedCommitKeepsTheDurableSnapshot() throws Exception {
+    try (var child = new Child("snapshot-save", "SNAPSHOT")) {
+      child.await("ready");
+      child.kill();
+      var store =
+          new DurablePropertiesStore(
+              FileAuthorityProcessProbe.authorityPath(root, "SNAPSHOT"),
+              null,
+              "starcore_probe",
+              Properties::new,
+              p -> {},
+              (a, b) -> {});
+      assertThat(store.load()).containsEntry("winner", child.token);
+    }
+  }
+
+  @Test
+  void deleteCannotRemoveAnotherProcessesUnfinishedReplacement() throws Exception {
+    Path path = FileAuthorityProcessProbe.authorityPath(root, "SNAPSHOT");
+    AtomicFilePersistence.replace(path, temp -> Files.writeString(temp, "confirmed"));
+    try (var child = new Child("atomic-interrupt", "SNAPSHOT")) {
+      child.await("ready");
+      assertThatThrownBy(() -> AtomicFilePersistence.delete(path))
+          .isInstanceOf(IOException.class)
+          .hasMessageContaining("busy");
+      assertThat(Files.readString(path)).isEqualTo("confirmed");
+      assertThat(Files.readString(AtomicFilePersistence.temp(path))).isEqualTo("unconfirmed");
+      child.kill();
+      AtomicFilePersistence.delete(path);
+      assertThat(path).doesNotExist();
+      assertThat(AtomicFilePersistence.temp(path)).doesNotExist();
+      assertThat(AtomicFilePersistence.backup(path)).doesNotExist();
+      assertThat(AtomicFilePersistence.deleteMarker(path)).doesNotExist();
+      assertThat(path.resolveSibling(path.getFileName() + ".lock")).isRegularFile();
+      assertThat(AtomicFilePersistence.recoveryTargets(root, ".properties")).isEmpty();
+    }
+  }
+
+  @Test
+  void failedSidecarOpenReleasesTheLocalLock() throws Exception {
+    Path path = root.resolve("state.properties"), sidecar = root.resolve("state.properties.lock");
+    Files.createDirectory(sidecar);
+    assertThatThrownBy(() -> FileAuthorityLock.acquire(path)).isInstanceOf(IOException.class);
+    Files.delete(sidecar);
+    try (var lock = FileAuthorityLock.acquire(path)) {
+      AtomicFilePersistence.replace(path, temp -> Files.writeString(temp, "retry"));
+    }
+    assertThat(Files.readString(path)).isEqualTo("retry");
+  }
+
+  @Test
+  void reentrantAliasesAndInterruptedWaitDoNotLeakLocalOrNativeLocks() throws Exception {
+    Path path = root.resolve("nested/state.properties");
+    try (var outer = FileAuthorityLock.acquire(path);
+        var inner = FileAuthorityLock.acquire(root.resolve("nested/../nested/state.properties"))) {
+      AtomicFilePersistence.replace(path, temp -> Files.writeString(temp, "nested"));
+      var started = new CountDownLatch(1);
+      var failure = new java.util.concurrent.atomic.AtomicReference<Throwable>();
+      var interrupted = new java.util.concurrent.atomic.AtomicBoolean();
+      var waiter =
+          new Thread(
+              () -> {
+                started.countDown();
+                try (var ignored = FileAuthorityLock.acquire(path)) {
+                  failure.set(new AssertionError("unexpected acquisition"));
+                } catch (Throwable error) {
+                  failure.set(error);
+                  interrupted.set(Thread.currentThread().isInterrupted());
+                }
+              });
+      waiter.start();
+      assertThat(started.await(1, TimeUnit.SECONDS)).isTrue();
+      waiter.interrupt();
+      waiter.join(2000);
+      assertThat(waiter.isAlive()).isFalse();
+      assertThat(failure.get()).isInstanceOf(IOException.class);
+      assertThat(interrupted).isTrue();
+    }
+    try (var next = FileAuthorityLock.acquire(path)) {
+      assertThat(Files.readString(path)).isEqualTo("nested");
+    }
+  }
+}
