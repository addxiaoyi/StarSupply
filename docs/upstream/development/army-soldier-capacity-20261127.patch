+      var store = fixture.storage(f, sql);
+      store.load();
+      store.save(NationStateCodec.toProperties(List.of(f.directory.get(f.a))));
+      var services = fixture.services();
+      var federation = spy(f.service());
+      f.create(federation, f.a, "Alpha");
+      services.register(AllianceService.class, federation);
