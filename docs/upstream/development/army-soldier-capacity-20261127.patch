+    var source = legacyDirectory.resolve("armies.dat");
+    byte[] original = legacyBytes();
+    Files.write(source, original);
+    var modified = Files.getLastModifiedTime(source);
+    var supplied = legacyDirectory.resolve("not-created").resolve("..").resolve("armies.dat");
+    var baseline = ArmyAuthorityBootstrap.initialize(storage(sql, "authority"), supplied);
+    assertThat(baseline.initialized()).isTrue();
+    assertThat(baseline.revision()).isEqualTo(1);
+    assertThat(baseline.armies()).containsKey(armyId);
+    assertThat(baseline.armies().get(armyId).position().worldName())
+        .isEqualTo("caf" + (char) 0xe9 + "-legacy-world");
+    assertThat(baseline.migration().sourceBytes()).isEqualTo(original);
+    var main = descriptor(baseline).getAsJsonObject("main");
+    assertThat(main.get("state").getAsString()).isEqualTo("PRESENT");
+    assertThat(main.get("read").getAsString()).isEqualTo("EXACT_RAW_BYTES");
+    assertThat(main.get("properties").getAsString()).isEqualTo("ISO-8859-1");
+    assertThat(main.get("path").getAsString())
+        .isEqualTo(source.toAbsolutePath().normalize().toString());
+    assertThat(main.get("size").getAsLong()).isEqualTo(original.length);
+    assertBackupEvidence(baseline, source, null);
+    assertThat(Files.readAllBytes(source)).isEqualTo(original);
