index 0000000000000000000000000000000000000000..cb79b3ed7ced0968525ed036a6919316fcd2fcec
--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/module/army/storage/authority/ArmySkillState.java
@@ -0,0 +1,255 @@
+package dev.starcore.starcore.module.army.storage.authority;
+
+import dev.starcore.starcore.module.army.commander.model.SkillType;
+import dev.starcore.starcore.module.army.model.authority.ArmyAuthoritySnapshot;
+import dev.starcore.starcore.module.army.model.authority.ArmySnapshot;
+import dev.starcore.starcore.module.army.model.authority.ArmySoldierCapacity;
+import dev.starcore.starcore.module.army.model.authority.ArmyToken;
+import dev.starcore.starcore.module.army.model.authority.ArmyTombstone;
+import dev.starcore.starcore.module.treasury.NationDebitService;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.Map;
+import java.util.Objects;
+import java.util.UUID;
+
+final class ArmySkillState {
+  private ArmySkillState() {}
+
+  static void validate(ArmyAuthoritySnapshot image) {
+    requireSnapshotConsistency(image);
+    Map<CooldownKey, Integer> roots = new HashMap<>();
+    var keys = new HashSet<CooldownKey>();
+    var successors = new HashSet<UUID>();
+    for (var entry : image.skillUses().entrySet()) {
+      var use = entry.getValue();
+      var request = use.request();
+      if (!entry.getKey().equals(request.operationId())
+          || image.receipts().containsKey(entry.getKey())
+          || image.paidOperations().containsKey(entry.getKey())
+          || image.battleSessions().containsKey(entry.getKey())) {
+        throw new IllegalArgumentException("Army skill operation identity is ambiguous");
+      }
+      var key = new CooldownKey(request.actorId(), request.skillType());
+      keys.add(key);
+      if (request.previousUseId() == null) {
+        roots.merge(key, 1, Math::addExact);
+      } else {
+        var previous = image.skillUses().get(request.previousUseId());
+        if (previous == null
+            || !key.equals(
+                new CooldownKey(previous.request().actorId(), previous.request().skillType()))
+            || request.acceptedAt().isBefore(previous.readyAt())
+            || !successors.add(request.previousUseId())) {
+          throw new IllegalArgumentException(
+              "Army skill cooldown chain is missing, forked or premature");
+        }
+      }
+      if (request.skillType() == SkillType.SCOUT) {
+        request.targets().values().forEach(observed -> requireIdentity(image, observed));
+      } else {
+        use.effects().values().forEach(effect -> requireEffect(image, effect, entry.getKey()));
+      }
+    }
+    for (var key : keys) {
+      if (roots.getOrDefault(key, 0) != 1) {
+        throw new IllegalArgumentException("Army skill cooldown key must have one permanent root");
+      }
+    }
+  }
+
+  static void validateObservation(ArmyAuthoritySnapshot previous, ArmyAuthoritySnapshot next) {
+    if (next.version() < previous.version()) {
+      throw new IllegalArgumentException("Army authority schema cannot move backwards");
+    }
+    previous
+        .skillUses()
+        .forEach(
+            (operationId, use) -> {
+              if (!use.equals(next.skillUses().get(operationId))) {
+                throw new IllegalArgumentException("Army skill proof is immutable and permanent");
+              }
+            });
+  }
+
+  static void validateCommit(ArmyAuthoritySnapshot previous, ArmyAuthoritySnapshot next) {
+    var added =
+        next.skillUses().entrySet().stream()
+            .filter(entry -> !previous.skillUses().containsKey(entry.getKey()))
+            .toList();
+    if (added.isEmpty()) return;
+    if (added.size() != 1
+        || !previous.receipts().equals(next.receipts())
+        || !previous.paidOperations().equals(next.paidOperations())
+        || !previous.nationClosures().equals(next.nationClosures())) {
+      throw new IllegalArgumentException("One Army commit may record only one isolated skill use");
+    }
+    var use = added.getFirst().getValue();
+    var request = use.request();
+    if (request.skillType() == SkillType.REINFORCE)
+      ArmySoldierCapacity.of(previous, request.nationId(), request.maximumNationSoldiers())
+          .requireGrowth(10L * request.level());
+    var head =
+        previous.skillUses().values().stream()
+            .filter(
+                candidate ->
+                    candidate.request().actorId().equals(request.actorId())
+                        && candidate.request().skillType() == request.skillType())
+            .max(java.util.Comparator.comparing(candidate -> candidate.request().acceptedAt()));
+    if (!Objects.equals(
+            request.previousUseId(),
+            head.map(candidate -> candidate.request().operationId()).orElse(null))
+        || head.isPresent() && request.acceptedAt().isBefore(head.orElseThrow().readyAt())) {
+      throw new IllegalArgumentException("Army skill use must extend the current cooldown head");
+    }
+    request.requireSelection(previous.armies());
+    var armies = new HashMap<>(previous.armies());
+    var tombstones = new HashMap<>(previous.tombstones());
+    use.effects()
+        .forEach(
+            (armyId, effect) -> {
+              if (effect.isAlive()) {
+                armies.put(armyId, effect);
+              } else {
+                armies.remove(armyId);
+                tombstones.put(armyId, defeated(effect, request.operationId()));
+              }
+            });
+    var sessions = new HashMap<>(previous.battleSessions());
+    previous
+        .battleSessions()
+        .forEach(
+            (sessionId, session) -> {
+              var heads = session.currentHeads();
+              if (session.pending()
+                  && (use.effects().containsKey(heads.attacker().token().armyId())
+                      || use.effects().containsKey(heads.defender().token().armyId()))) {
+                var advanced = session.intervene(use);
+                sessions.put(sessionId, advanced);
+                for (var effect :
+                    new ArmySnapshot[] {
+                      advanced.currentHeads().attacker(), advanced.currentHeads().defender()
+                    }) {
+                  if (effect.isAlive()) armies.put(effect.token().armyId(), effect);
+                  else {
+                    armies.remove(effect.token().armyId());
+                    tombstones.put(
+                        effect.token().armyId(), defeated(effect, request.operationId()));
+                  }
+                }
+              }
+            });
+    if (!armies.equals(next.armies())
+        || !tombstones.equals(next.tombstones())
+        || !sessions.equals(next.battleSessions())) {
+      throw new IllegalArgumentException(
+          "Army skill effects and cooldown proof must commit together");
+    }
+  }
+
+  static ArmyTombstone defeated(ArmySnapshot effect, UUID operationId) {
+    return new ArmyTombstone(
+        effect.token(),
+        effect.nationId(),
+        effect.type(),
+        effect.createdAt(),
+        effect.lastUpdated(),
+        "skill-defeated",
+        operationId);
+  }
+
+  private static void requireEffect(
+      ArmyAuthoritySnapshot image, ArmySnapshot effect, UUID operationId) {
+    if (!effect.isAlive()) {
+      if (!defeated(effect, operationId).equals(image.tombstones().get(effect.token().armyId()))
+          || image.armies().containsKey(effect.token().armyId())) {
+        throw new IllegalArgumentException(
+            "Defeated skill target requires its permanent exact tombstone");
+      }
+      return;
+    }
+    requireIdentity(image, effect);
+  }
+
+  private static void requireIdentity(ArmyAuthoritySnapshot image, ArmySnapshot proof) {
+    var armyId = proof.token().armyId();
+    var live = image.armies().get(armyId);
+    var retired = image.tombstones().get(armyId);
+    if (live != null) {
+      if (!proof.token().incarnation().equals(live.token().incarnation())
+          || !proof.nationId().equals(live.nationId())
+          || proof.type() != live.type()
+          || !proof.createdAt().equals(live.createdAt())
+          || live.token().generation() < proof.token().generation()
+          || live.token().generation() == proof.token().generation() && !proof.equals(live)) {
+        throw new IllegalArgumentException("Army skill live proof identity or generation differs");
+      }
+    } else if (retired == null
+        || !proof.token().incarnation().equals(retired.token().incarnation())
+        || !proof.nationId().equals(retired.nationId())
+        || proof.type() != retired.type()
+        || !proof.createdAt().equals(retired.createdAt())
+        || retired.token().generation() <= proof.token().generation()) {
+      throw new IllegalArgumentException(
+          "Army skill proof has no later matching live or retired identity");
+    }
+  }
+
+  private static void requireSnapshotConsistency(ArmyAuthoritySnapshot image) {
+    if (image.skillUses().isEmpty()) return;
+    Map<ArmyToken, ArmySnapshot> snapshots = new HashMap<>();
+    image.armies().values().forEach(army -> remember(snapshots, army));
+    image
+        .skillUses()
+        .values()
+        .forEach(
+            use -> {
+              use.request().targets().values().forEach(army -> remember(snapshots, army));
+              use.effects().values().forEach(army -> remember(snapshots, army));
+            });
+    image
+        .paidOperations()
+        .values()
+        .forEach(
+            operation -> {
+              if (operation.request().before() != null)
+                remember(snapshots, operation.request().before());
+              if (operation.debitReceipt() != null
+                  && operation.debitReceipt().status() == NationDebitService.Status.APPLIED) {
+                remember(snapshots, operation.request().after());
+              }
+            });
+    image
+        .battleSessions()
+        .values()
+        .forEach(
+            session -> {
+              remember(snapshots, session.request().attackerBefore());
+              remember(snapshots, session.request().defenderBefore());
+              remember(snapshots, session.request().attackerStarted());
+              remember(snapshots, session.request().defenderStarted());
+              session
+                  .interventions()
+                  .forEach(
+                      intervention -> {
+                        remember(snapshots, intervention.before().attacker());
+                        remember(snapshots, intervention.before().defender());
+                        remember(snapshots, intervention.after().attacker());
+                        remember(snapshots, intervention.after().defender());
+                      });
+              if (!session.pending()) {
+                remember(snapshots, session.resolution().attackerAfter());
+                remember(snapshots, session.resolution().defenderAfter());
+              }
+            });
+  }
+
+  private static void remember(Map<ArmyToken, ArmySnapshot> snapshots, ArmySnapshot snapshot) {
+    var existing = snapshots.putIfAbsent(snapshot.token(), snapshot);
+    if (existing != null && !existing.equals(snapshot)) {
+      throw new IllegalArgumentException("Army history has contradictory snapshots for one token");
+    }
+  }
+
+  private record CooldownKey(UUID actorId, SkillType skillType) {}
+}
