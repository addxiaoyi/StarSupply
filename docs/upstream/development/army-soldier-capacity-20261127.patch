+++ b/src/main/java/dev/starcore/starcore/module/army/model/authority/ArmyBattleRequest.java
@@ -0,0 +1,68 @@
+package dev.starcore.starcore.module.army.model.authority;
+
+import dev.starcore.starcore.module.army.model.ArmyState;
+import java.time.Instant;
+import java.util.Objects;
+import java.util.UUID;
+
+public record ArmyBattleRequest(
+    UUID sessionId,
+    UUID actorId,
+    ArmySnapshot attackerBefore,
+    ArmySnapshot defenderBefore,
+    Instant acceptedAt) {
+  public ArmyBattleRequest {
+    Objects.requireNonNull(sessionId, "sessionId");
+    Objects.requireNonNull(actorId, "actorId");
+    Objects.requireNonNull(attackerBefore, "attackerBefore");
+    Objects.requireNonNull(defenderBefore, "defenderBefore");
+    Objects.requireNonNull(acceptedAt, "acceptedAt");
+    if (attackerBefore.token().armyId().equals(defenderBefore.token().armyId())
+        || attackerBefore.nationId().equals(defenderBefore.nationId())) {
+      throw new IllegalArgumentException("Battle requires distinct armies from distinct nations");
+    }
+    if (!acceptedAt.isAfter(Instant.EPOCH)) {
+      throw new IllegalArgumentException("Battle acceptance must be after the epoch");
+    }
+    requireParticipant(attackerBefore, acceptedAt);
+    requireParticipant(defenderBefore, acceptedAt);
+  }
+
+  public ArmySnapshot attackerStarted() {
+    return started(attackerBefore, ArmyState.ATTACKING);
+  }
+
+  public ArmySnapshot defenderStarted() {
+    return started(defenderBefore, ArmyState.DEFENDING);
+  }
+
+  private ArmySnapshot started(ArmySnapshot before, ArmyState state) {
+    return new ArmySnapshot(
+        new ArmyToken(
+            before.token().armyId(), before.token().incarnation(), before.token().generation() + 1),
+        before.nationId(),
+        before.type(),
+        before.soldiers(),
+        before.health(),
+        before.morale(),
+        before.position(),
+        state,
+        before.supply(),
+        before.supplyConsumptionRemainder(),
+        before.createdAt(),
+        acceptedAt);
+  }
+
+  private static void requireParticipant(ArmySnapshot before, Instant acceptedAt) {
+    if (!before.isAlive()
+        || before.token().generation() > Long.MAX_VALUE - 2
+        || before.state() == ArmyState.ATTACKING
+        || before.state() == ArmyState.SIEGING) {
+      throw new IllegalArgumentException(
+          "Battle participant is unavailable or lacks token headroom");
+    }
+    if (acceptedAt.isBefore(before.createdAt()) || acceptedAt.isBefore(before.lastUpdated())) {
+      throw new IllegalArgumentException("Battle acceptance precedes its participant snapshot");
+    }
+  }
+}
diff --git a/src/main/java/dev/starcore/starcore/module/army/model/authority/ArmyBattleSession.java b/src/main/java/dev/starcore/starcore/module/army/model/authority/ArmyBattleSession.java
new file mode 100644
index 0000000000000000000000000000000000000000..862b370e3e878fd4a4c13de626e04b6bca39f586
--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/module/army/model/authority/ArmyBattleSession.java
@@ -0,0 +1,280 @@
+package dev.starcore.starcore.module.army.model.authority;
+
+import dev.starcore.starcore.module.army.model.ArmyState;
+import dev.starcore.starcore.module.army.model.BattleResult;
+import java.time.Instant;
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Objects;
+import java.util.Optional;
+import java.util.Set;
+import java.util.UUID;
+
+public record ArmyBattleSession(
+    ArmyBattleRequest request, Resolution resolution, List<ArmyBattleIntervention> interventions) {
+  public static final int MAX_INTERVENTIONS = 1024;
+
+  public ArmyBattleSession(ArmyBattleRequest request, Resolution resolution) {
+    this(request, resolution, List.of());
+  }
+
+  public ArmyBattleSession {
+    Objects.requireNonNull(request, "request");
+    interventions = List.copyOf(Objects.requireNonNull(interventions, "interventions"));
+    validate(request, resolution, interventions);
+  }
+
+  private static void validate(
+      ArmyBattleRequest request,
+      Resolution resolution,
+      List<ArmyBattleIntervention> interventions) {
+    if (interventions.size() > MAX_INTERVENTIONS) {
+      throw new IllegalArgumentException("Too many Army battle interventions");
+    }
+    ArmyBattleHeads heads =
+        new ArmyBattleHeads(request.attackerStarted(), request.defenderStarted());
+    Set<UUID> operationIds = new HashSet<>();
+    ArmyBattleIntervention terminalIntervention = null;
+    for (int index = 0; index < interventions.size(); index++) {
+      ArmyBattleIntervention intervention = interventions.get(index);
+      if (!operationIds.add(intervention.skillOperationId())) {
+        throw new IllegalArgumentException("A battle cannot repeat a skill operation");
+      }
+      if (!intervention.before().equals(heads)) {
+        throw new IllegalArgumentException("Battle intervention chain has a stale head");
+      }
+      if (intervention.acceptedAt().isBefore(request.acceptedAt())) {
+        throw new IllegalArgumentException("Battle intervention precedes battle acceptance");
+      }
+      heads = intervention.after();
+      if (intervention.outcome() != ArmyBattleIntervention.Outcome.CONTINUED) {
+        if (index != interventions.size() - 1) {
+          throw new IllegalArgumentException("A terminal battle intervention must be last");
+        }
+        terminalIntervention = intervention;
+      }
+    }
+    if (resolution == null) {
+      if (terminalIntervention != null) {
+        throw new IllegalArgumentException("A terminal skill intervention requires a resolution");
+      }
+      if (heads.attacker().token().generation() == Long.MAX_VALUE
+          || heads.defender().token().generation() == Long.MAX_VALUE) {
+        throw new IllegalArgumentException("Active battle requires terminal token headroom");
+      }
+      return;
+    }
+    requireDecisionTime(request, resolution.decidedAt());
+    if (terminalIntervention != null) {
+      if (resolution.status() != status(terminalIntervention.outcome())
+          || !resolution.decidedAt().equals(terminalIntervention.acceptedAt())
+          || !resolution.attackerAfter().equals(heads.attacker())
+          || !resolution.defenderAfter().equals(heads.defender())
+          || resolution.attackerDamage() != 0
+          || resolution.defenderDamage() != 0) {
+        throw new IllegalArgumentException(
+            "Terminal skill intervention proof differs from resolution");
+      }
+      return;
+    }
+    ArmyBattleHeads beforeResolution = heads;
+    requireSuccessor(
+        beforeResolution.attacker(), resolution.attackerAfter(), resolution.decidedAt());
+    requireSuccessor(
+        beforeResolution.defender(), resolution.defenderAfter(), resolution.decidedAt());
+    if (resolution.status() == Status.COMPLETED) {
+      requireNoGrowth(beforeResolution.attacker(), resolution.attackerAfter());
+      requireNoGrowth(beforeResolution.defender(), resolution.defenderAfter());
+    } else if (resolution.status() != Status.CANCELLED
+        || !stationary(beforeResolution.attacker(), resolution.decidedAt())
+            .equals(resolution.attackerAfter())
+        || !stationary(beforeResolution.defender(), resolution.decidedAt())
+            .equals(resolution.defenderAfter())
+        || resolution.attackerDamage() != 0
+        || resolution.defenderDamage() != 0) {
+      throw new IllegalArgumentException(
+          "Cancelled battle must retain exact current participant stats");
+    }
+  }
+
+  public boolean pending() {
+    return resolution == null;
+  }
+
+  public ArmyBattleHeads currentHeads() {
+    ArmyBattleHeads heads =
+        new ArmyBattleHeads(request.attackerStarted(), request.defenderStarted());
+    for (var intervention : interventions) heads = intervention.after();
+    return heads;
+  }
+
+  public ArmyBattleSession intervene(ArmySkillUse use) {
+    if (!pending()) throw new IllegalStateException("A terminal battle cannot be intervened");
+    var intervention = ArmyBattleIntervention.from(use, currentHeads());
+    var history = new ArrayList<>(interventions);
+    history.add(intervention);
+    Resolution terminal = null;
+    if (intervention.outcome() != ArmyBattleIntervention.Outcome.CONTINUED) {
+      terminal =
+          new Resolution(
+              status(intervention.outcome()),
+              intervention.after().attacker(),
+              intervention.after().defender(),
+              0,
+              0,
+              intervention.acceptedAt());
+    }
+    return new ArmyBattleSession(request, terminal, history);
+  }
+
+  public static Resolution cancelled(ArmyBattleRequest request, Instant decidedAt) {
+    Objects.requireNonNull(request, "request");
+    requireDecisionTime(request, decidedAt);
+    return new Resolution(
+        Status.CANCELLED,
+        stationary(request.attackerStarted(), decidedAt),
+        stationary(request.defenderStarted(), decidedAt),
+        0,
+        0,
+        decidedAt);
+  }
+
+  public static Resolution cancelled(ArmyBattleSession session, Instant decidedAt) {
+    Objects.requireNonNull(session, "session");
+    if (!session.pending()) throw new IllegalStateException("Battle is already terminal");
+    requireDecisionTime(session.request(), decidedAt);
+    var heads = session.currentHeads();
+    return new Resolution(
+        Status.CANCELLED,
+        stationary(heads.attacker(), decidedAt),
+        stationary(heads.defender(), decidedAt),
+        0,
+        0,
+        decidedAt);
+  }
+
+  public Optional<BattleResult> battleResult() {
+    if (pending() || resolution.status() != Status.COMPLETED) return Optional.empty();
+    ArmyBattleHeads before =
+        interventions.isEmpty()
+            ? new ArmyBattleHeads(request.attackerStarted(), request.defenderStarted())
+            : interventions.getLast().after();
+    return Optional.of(
+        BattleResult.create(
+            request.attackerBefore().token().armyId(),
+            request.defenderBefore().token().armyId(),
+            resolution.attackerDamage(),
+            resolution.defenderDamage(),
+            before.attacker().soldiers() - resolution.attackerAfter().soldiers(),
+            before.defender().soldiers() - resolution.defenderAfter().soldiers(),
+            resolution.attackerAfter().isAlive(),
+            resolution.defenderAfter().isAlive()));
+  }
+
+  private static Status status(ArmyBattleIntervention.Outcome outcome) {
+    return switch (outcome) {
+      case RETREATED -> Status.RETREATED;
+      case SKILL_DEFEAT -> Status.SKILL_DEFEAT;
+      case CONTINUED ->
+          throw new IllegalArgumentException("Continued skill has no terminal status");
+    };
+  }
+
+  private static void requireDecisionTime(ArmyBattleRequest request, Instant decidedAt) {
+    Objects.requireNonNull(decidedAt, "decidedAt");
+    if (decidedAt.isBefore(request.acceptedAt())) {
+      throw new IllegalArgumentException("Battle decision precedes its acceptance");
+    }
+  }
+
+  private static void requireSuccessor(
+      ArmySnapshot started, ArmySnapshot after, Instant decidedAt) {
+    if (started.token().generation() == Long.MAX_VALUE
+        || decidedAt.isBefore(started.lastUpdated())) {
+      throw new IllegalArgumentException("Battle terminal participant lacks token headroom");
+    }
+    var expected =
+        new ArmySnapshot(
+            new ArmyToken(
+                started.token().armyId(),
+                started.token().incarnation(),
+                started.token().generation() + 1),
+            started.nationId(),
+            started.type(),
+            after.soldiers(),
+            after.health(),
+            after.morale(),
+            started.position(),
+            ArmyState.STATIONARY,
+            started.supply(),
+            started.supplyConsumptionRemainder(),
+            started.createdAt(),
+            decidedAt);
+    if (!expected.equals(after)) {
+      throw new IllegalArgumentException(
+          "Battle terminal participant differs from its exact successor");
+    }
+  }
+
+  private static void requireNoGrowth(ArmySnapshot started, ArmySnapshot after) {
+    // Health is a percentage of the surviving soldiers, so casualties may raise the percentage.
+    // Compare total remaining health with the fixed unit type instead.
+    if (after.soldiers() > started.soldiers()
+        || after.soldiers() * after.health() > started.soldiers() * started.health()) {
+      throw new IllegalArgumentException("Completed battle cannot grow soldiers or health");
+    }
+  }
+
+  private static ArmySnapshot stationary(ArmySnapshot started, Instant decidedAt) {
+    Objects.requireNonNull(decidedAt, "decidedAt");
+    if (started.token().generation() == Long.MAX_VALUE
+        || decidedAt.isBefore(started.lastUpdated())) {
+      throw new IllegalArgumentException("Battle cancellation lacks token headroom");
+    }
+    return new ArmySnapshot(
+        new ArmyToken(
+            started.token().armyId(),
+            started.token().incarnation(),
+            started.token().generation() + 1),
+        started.nationId(),
+        started.type(),
+        started.soldiers(),
+        started.health(),
+        started.morale(),
+        started.position(),
+        ArmyState.STATIONARY,
+        started.supply(),
+        started.supplyConsumptionRemainder(),
+        started.createdAt(),
+        decidedAt);
+  }
+
+  public enum Status {
+    COMPLETED,
+    CANCELLED,
+    RETREATED,
+    SKILL_DEFEAT
+  }
+
+  public record Resolution(
+      Status status,
+      ArmySnapshot attackerAfter,
+      ArmySnapshot defenderAfter,
+      double attackerDamage,
+      double defenderDamage,
+      Instant decidedAt) {
+    public Resolution {
+      Objects.requireNonNull(status, "status");
+      Objects.requireNonNull(attackerAfter, "attackerAfter");
+      Objects.requireNonNull(defenderAfter, "defenderAfter");
+      Objects.requireNonNull(decidedAt, "decidedAt");
+      if (!Double.isFinite(attackerDamage)
+          || !Double.isFinite(defenderDamage)
+          || attackerDamage < 0
+          || defenderDamage < 0) {
+        throw new IllegalArgumentException("Battle damage must be finite and nonnegative");
+      }
+    }
+  }
+}
