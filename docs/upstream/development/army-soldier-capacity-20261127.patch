+    assertRejected(() -> ArmyAuthorityState.validateCommit(exhausted, closing(exhausted)));
+    var lastArmies = new HashMap<>(before.armies());
+    lastArmies.put(ARMY, army(ARMY, NATION, Long.MAX_VALUE - 1));
+    var last = image(before, lastArmies, Map.of(), Map.of());
+    var closing = closing(last);
+    ArmyAuthorityState.validateCommit(last, closing);
+    var terminal = retired(closing);
+    ArmyAuthorityState.validateCommit(closing, terminal);
