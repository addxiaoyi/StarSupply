+  private static ArmySkillUse skill(ArmyAuthoritySnapshot source, UUID nation, SkillType type) {
+    var targets = new HashMap<UUID, ArmySnapshot>();
+    source
+        .armies()
+        .forEach(
+            (armyId, army) -> {
+              if (type == SkillType.SCOUT || armyId.equals(ARMY)) targets.put(armyId, army);
+            });
+    return ArmySkillUse.completed(
+        new ArmySkillRequest(
+            SKILL,
+            ACTOR,
+            nation,
+            type,
+            1,
+            1,
+            null,
+            CLOSED,
+            type == SkillType.SCOUT ? ORIGIN : null,
+            targets));
+  }
+
+  private static ArmyAuthoritySnapshot withSkill(ArmyAuthoritySnapshot source, ArmySkillUse use) {
+    var armies = new HashMap<>(source.armies());
+    var tombstones = new HashMap<>(source.tombstones());
+    use.effects()
+        .forEach(
+            (armyId, effect) -> {
+              if (effect.isAlive()) {
+                armies.put(armyId, effect);
+              } else {
+                armies.remove(armyId);
+                tombstones.put(
+                    armyId,
+                    new ArmyTombstone(
+                        effect.token(),
+                        effect.nationId(),
+                        effect.type(),
+                        effect.createdAt(),
+                        effect.lastUpdated(),
+                        "skill-defeated",
+                        SKILL));
+              }
+            });
+    return new ArmyAuthoritySnapshot(
+        true,
+        source.revision() + 1,
+        armies,
+        tombstones,
+        source.receipts(),
+        source.migration(),
+        5,
+        source.paidOperations(),
+        source.battleSessions(),
+        Map.of(SKILL, use),
+        source.nationClosures());
+  }
+
+  private static void assertRejected(Executable action) {
+    var rejected = assertThrows(RuntimeException.class, action);
+    assertTrue(
+        rejected instanceof IllegalArgumentException || rejected instanceof IllegalStateException,
+        () -> "Unexpected rejection: " + rejected);
+  }
+}
