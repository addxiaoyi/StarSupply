+import org.bukkit.inventory.ItemStack;
+import org.junit.jupiter.api.Test;
+
+class PlayerTradeNativeInputReopenTest {
+  @Test
+  void amountAndPriceSubmissionsRestoreRegisteredConfirmationAfterActualCloseHooks() {
+    Player player = mock(Player.class);
+    Player target = mock(Player.class);
+    UUID playerId = UUID.randomUUID();
+    UUID targetId = UUID.randomUUID();
+    when(player.getUniqueId()).thenReturn(playerId);
+    when(target.getUniqueId()).thenReturn(targetId);
+    when(target.getName()).thenReturn("Target");
+    PlayerTradeService trades = mock(PlayerTradeService.class);
+    NationService nations = mock(NationService.class);
+    when(nations.nationOf(any())).thenReturn(Optional.empty());
+    BaseGuiListener listener = new BaseGuiListener(null);
+    AtomicReference<Inventory> current = new AtomicReference<>();
+    doAnswer(
+            invocation -> {
+              close(listener, player, current.getAndSet(invocation.getArgument(0)));
+              return null;
+            })
+        .when(player)
+        .openInventory(any(Inventory.class));
+    doAnswer(
+            invocation -> {
+              close(listener, player, current.getAndSet(null));
+              return null;
+            })
+        .when(player)
+        .closeInventory();
+    List<Consumer<String>> submissions = new ArrayList<>();
+    List<String> titles = new ArrayList<>();
+    try (var bukkit = mockStatic(Bukkit.class);
+        var animations = mockStatic(GuiAnimationRegistry.class);
+        var items = mockConstruction(ItemStack.class);
+        var input =
+            mockStatic(
+                BookInputSupport.class,
+                invocation -> {
+                  if (invocation.getMethod().getName().equals("prepare")) {
+                    Consumer<String> submit =
+                        invocation.getArgument(invocation.getArguments().length - 2);
+                    submissions.add(submit);
+                    titles.add(invocation.getArgument(1));
+                    player.closeInventory();
+                  }
+                  return null;
+                })) {
+      animations
+          .when(GuiAnimationRegistry::getInstance)
+          .thenThrow(new IllegalStateException("not initialized"));
+      bukkit
+          .when(
+              () ->
+                  Bukkit.createInventory(
+                      any(InventoryHolder.class), anyInt(), any(Component.class)))
+          .thenAnswer(
+              invocation -> {
+                Inventory inventory = mock(Inventory.class);
+                when(inventory.getSize()).thenReturn(invocation.getArgument(1, Integer.class));
+                return inventory;
+              });
+      bukkit.when(Bukkit::getOnlinePlayers).thenReturn(List.of(player, target));
+      bukkit.when(() -> Bukkit.getPlayer(targetId)).thenReturn(target);
+      PlayerTradeGui gui =
+          new PlayerTradeGui(player, null, trades, nations, ignored -> {}, ignored -> {});
+      gui.openCreate();
+      assertThat(gui.handleClick(player, 10)).isTrue();
+      assertThat(gui.handleClick(player, 10)).isTrue();
+
+      assertThat(titles).containsExactly("Trade quantity");
+      assertThat(BaseGuiListener.hasGui(player)).isFalse();
+
+      submissions.getFirst().accept("5");
+
+      assertThat(BaseGuiListener.getGui(player)).isSameAs(gui);
+      InventoryClickEvent price = click(player, current.get(), 30);
+      listener.onInventoryClick(price);
+      verify(price).setCancelled(true);
+      assertThat(titles).containsExactly("Trade quantity", "Trade unit price");
+      assertThat(BaseGuiListener.hasGui(player)).isFalse();
+
+      submissions.getLast().accept("2.50");
+
+      assertThat(BaseGuiListener.getGui(player)).isSameAs(gui);
+      InventoryDragEvent drag = mock(InventoryDragEvent.class);
+      when(drag.getWhoClicked()).thenReturn(player);
+      listener.onInventoryDrag(drag);
+      verify(drag).setCancelled(true);
+      InventoryClickEvent send = click(player, current.get(), 32);
+      listener.onInventoryClick(send);
+      verify(send).setCancelled(true);
+      verify(trades).createTradeOffer(playerId, null, targetId, null, "mineral", 5, 2.5, 300);
+    } finally {
+      BaseGuiListener.unregisterGui(player);
+      PlayerTradeGui.forget(player);
+    }
+  }
+
+  private static void close(BaseGuiListener listener, Player player, Inventory inventory) {
+    if (inventory == null) return;
+    InventoryCloseEvent event = mock(InventoryCloseEvent.class);
+    when(event.getPlayer()).thenReturn(player);
+    when(event.getInventory()).thenReturn(inventory);
+    listener.onInventoryClose(event);
+  }
+
+  private static InventoryClickEvent click(Player player, Inventory inventory, int slot) {
+    InventoryClickEvent event = mock(InventoryClickEvent.class);
+    InventoryView view = mock(InventoryView.class);
+    when(view.getTopInventory()).thenReturn(inventory);
+    when(event.getWhoClicked()).thenReturn(player);
+    when(event.getView()).thenReturn(view);
+    when(event.getInventory()).thenReturn(inventory);
+    when(event.getClickedInventory()).thenReturn(inventory);
+    when(event.getRawSlot()).thenReturn(slot);
+    when(event.getClick()).thenReturn(ClickType.LEFT);
+    return event;
+  }
+}
