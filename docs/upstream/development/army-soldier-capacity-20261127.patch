+  private Properties state(PeaceTreatyBatch batch) {
+    var state = WarAuthority.empty();
+    state.setProperty(
+        WarAuthority.TREATY + batch.request().treatyId(),
+        WarAuthority.encodeTreaty(Map.of("STATE", source(batch))));
+    return state;
+  }
+
+  private long serializedBytes(Properties state) throws Exception {
+    var output = new ByteArrayOutputStream();
+    state.store(output, "STARCORE snapshot authority");
+    return output.size();
+  }
