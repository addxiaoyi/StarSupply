+package dev.starcore.starcore.module.army;
+
+import dev.starcore.starcore.module.army.model.authority.ArmyNationClosure;
+import java.nio.charset.StandardCharsets;
+import java.util.Objects;
+import java.util.Optional;
+import java.util.UUID;
+
+/**
+ * Durable closing before directory removal; original obligations drain before treasury retirement.
+ */
+public interface ArmyDisbandService {
+  ArmyNationClosure closeNation(UUID disbandId, UUID nationId);
+
+  ArmyNationClosure retireNation(UUID disbandId, UUID nationId);
+
+  Optional<ArmyNationClosure> nationClosure(UUID nationId);
+
+  static UUID closureId(UUID disbandId, UUID nationId) {
+    Objects.requireNonNull(disbandId, "disbandId");
+    Objects.requireNonNull(nationId, "nationId");
+    return UUID.nameUUIDFromBytes(
+        ("army:nation-disband:v1:" + disbandId + ":" + nationId).getBytes(StandardCharsets.UTF_8));
+  }
+}
