+  private static ArmySnapshot withLife(ArmySnapshot source, int soldiers, double health) {
+    return new ArmySnapshot(
+        source.token(),
+        source.nationId(),
+        source.type(),
+        soldiers,
+        health,
+        source.morale(),
+        source.position(),
+        source.state(),
+        source.supply(),
+        source.supplyConsumptionRemainder(),
+        source.createdAt(),
+        source.lastUpdated());
+  }
+
+  private static ArmySnapshot withWorld(ArmySnapshot source, ArmyPosition position) {
+    return new ArmySnapshot(
+        source.token(),
+        source.nationId(),
+        source.type(),
+        source.soldiers(),
+        source.health(),
+        source.morale(),
+        position,
+        source.state(),
+        source.supply(),
+        source.supplyConsumptionRemainder(),
+        source.createdAt(),
+        source.lastUpdated());
+  }
+
+  private static ArmySnapshot mutate(ArmySnapshot source, String field) {
+    var position = source.position();
+    var changedPosition =
+        new ArmyPosition(
+            field.equals("worldId") ? OTHER_ID : position.worldId(),
+            field.equals("worldName") ? position.worldName() + "|changed" : position.worldName(),
+            field.equals("x") ? position.x() + 1 : position.x(),
+            field.equals("y") ? position.y() + 1 : position.y(),
+            field.equals("z") ? position.z() + 1 : position.z(),
+            field.equals("yaw") ? position.yaw() + 1 : position.yaw(),
+            field.equals("pitch") ? position.pitch() + 1 : position.pitch());
+    var token =
+        new ArmyToken(
+            field.equals("armyId") ? OTHER_ID : source.token().armyId(),
+            field.equals("incarnation") ? OTHER_ID : source.token().incarnation(),
+            field.equals("generation")
+                ? source.token().generation() + 1
+                : source.token().generation());
+    return new ArmySnapshot(
+        token,
+        field.equals("nation") ? OTHER_ID : source.nationId(),
+        field.equals("type")
+            ? Arrays.stream(ArmyType.values())
+                .filter(candidate -> candidate != source.type())
+                .findFirst()
+                .orElseThrow()
+            : source.type(),
+        field.equals("soldiers") ? source.soldiers() + 1 : source.soldiers(),
+        field.equals("health") ? source.health() + 1 : source.health(),
+        field.equals("morale") ? source.morale() + 1 : source.morale(),
+        changedPosition,
+        field.equals("state")
+            ? Arrays.stream(ArmyState.values())
+                .filter(candidate -> candidate != source.state())
+                .findFirst()
+                .orElseThrow()
+            : source.state(),
+        field.equals("supply") ? source.supply() + 1 : source.supply(),
+        field.equals("remainder")
+            ? source.supplyConsumptionRemainder() + 1
+            : source.supplyConsumptionRemainder(),
+        field.equals("created") ? source.createdAt().plusNanos(1) : source.createdAt(),
+        field.equals("lastUpdated") ? source.lastUpdated().plusNanos(1) : source.lastUpdated());
+  }
+}
