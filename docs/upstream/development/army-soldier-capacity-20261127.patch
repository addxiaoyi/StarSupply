--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/module/army/model/authority/ArmySkillUse.java
@@ -0,0 +1,38 @@
+package dev.starcore.starcore.module.army.model.authority;
+
+import java.time.Duration;
+import java.time.Instant;
+import java.util.Map;
+import java.util.Objects;
+import java.util.UUID;
+
+public record ArmySkillUse(
+    ArmySkillRequest request, Map<UUID, ArmySnapshot> effects, Instant readyAt) {
+  public ArmySkillUse {
+    Objects.requireNonNull(request, "request");
+    effects = Map.copyOf(Objects.requireNonNull(effects, "effects"));
+    Objects.requireNonNull(readyAt, "readyAt");
+    if (!effects.equals(request.effects())) {
+      throw new IllegalArgumentException(
+          "Skill effects do not match the requested deterministic effects");
+    }
+    if (!readyAt.equals(request.readyAt())) {
+      throw new IllegalArgumentException("Skill cooldown does not match the requested deadline");
+    }
+  }
+
+  public static ArmySkillUse completed(ArmySkillRequest request) {
+    Objects.requireNonNull(request, "request");
+    return new ArmySkillUse(request, request.effects(), request.readyAt());
+  }
+
+  public boolean ready(Instant now) {
+    return !Objects.requireNonNull(now, "now").isBefore(readyAt);
+  }
+
+  public long remainingSeconds(Instant now) {
+    if (ready(now)) return 0;
+    Duration remaining = Duration.between(now, readyAt);
+    return Math.addExact(remaining.getSeconds(), remaining.getNano() == 0 ? 0 : 1);
+  }
+}
