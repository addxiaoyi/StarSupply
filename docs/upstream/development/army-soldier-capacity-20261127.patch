+        var complete = image(pending, armies, decisions).withRevision(Long.MAX_VALUE);
+        ArmyAuthorityState.validate(complete);
+        assertEquals(complete, ArmyAuthorityCodec.decode(ArmyAuthorityCodec.encode(complete)));
+        assertTrue(
