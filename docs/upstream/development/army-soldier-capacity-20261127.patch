+                      PairScope.of(participants.get(leftIndex), participants.get(rightIndex))))
+                    throw new IllegalArgumentException("Incomplete original war political scope");
+              for (int index = 0; index < plan.terms().size(); index++) {
+                var term = plan.terms().get(index);
+                var original = request.terms().get(index);
+                var fixedId =
+                    UUID.nameUUIDFromBytes(
+                        (request.operationId() + ":restriction:" + original.termIndex())
+                            .getBytes(java.nio.charset.StandardCharsets.UTF_8));
+                if (!original.type().equals("PoliticalTerm")
+                    || term.termIndex() != original.termIndex()
+                    || !term.restrictionId().equals(fixedId)
+                    || !term.imposedAt().equals(request.preparedAt())
+                    || !term.requirement()
+                        .equals(original.requirement().toLowerCase(java.util.Locale.ROOT))
+                    || !term.description().equals(original.description())
+                    || !term.nationId().equals(request.defeated()))
+                  throw new IllegalArgumentException("Treaty plan lost an original term identity");
+              }
+              if (view.status() == Status.APPLIED) {
+                var proof = state.proofs.get(request.operationId());
+                if (proof == null)
+                  throw new IllegalArgumentException("Applied treaty lacks exact release proof");
+                var principal = PairScope.of(request.war().attacker(), request.war().defender());
+                for (var pair : plan.pairs()) {
+                  long appliedGeneration =
+                      Math.addExact(
+                          pair.expectedGeneration(), pair.pair().equals(principal) ? 2 : 1);
+                  if (generations.generation(
+                          DiplomacyPairKey.of(pair.pair().left(), pair.pair().right()))
+                      < appliedGeneration)
+                    throw new IllegalArgumentException("Missing applied treaty generation history");
+                }
+              }
+            });
