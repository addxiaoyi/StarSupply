+      Math.addExact(
+          pair.expectedGeneration(),
+          principal.equals(DiplomacyPairKey.of(pair.pair().left(), pair.pair().right())) ? 2 : 1);
+  }
+
+  static void requireRevision(Properties properties, long revision) {
+    requireRevision(DiplomacyTreatyOperationState.read(properties), revision);
+  }
+
+  static void requireRevision(DiplomacyTreatyOperationState state, long revision) {
+    long remaining = 0;
+    for (var operation : state.operations().values())
+      if (pending(operation))
+        remaining =
+            Math.addExact(
+                remaining, state.proofs().containsKey(operation.request().operationId()) ? 1 : 2);
+    Math.addExact(revision, remaining);
+  }
+
+  static void requireMirrorRevision(DiplomacyTreatyOperationState state, long revision) {
+    long remaining =
+        state.operations().values().stream()
+            .filter(DiplomacyTreatyCapacity::pending)
+            .filter(operation -> !state.proofs().containsKey(operation.request().operationId()))
+            .count();
+    Math.addExact(revision, remaining);
+  }
+
+  private static boolean pending(OperationView operation) {
+    return operation.request().protocolVersion() == TreatyEffectManifest.VERSION
+        && operation.binding() != null
+        && !operation.terminal();
+  }
+
+  private static long measure(
+      Properties properties, DiplomacyTreatyOperationState state, long maximumBytes) {
+    var counter = new Counter(maximumBytes);
+    snapshot(properties, counter);
+    var pending =
+        state.operations().values().stream().filter(DiplomacyTreatyCapacity::pending).toList();
+    if (pending.isEmpty()) return counter.bytes;
+    var relations = DiplomacyStateCodec.fromProperties(properties);
+    var times = DiplomacyTemporalStateCodec.relationChangesFromProperties(properties);
+    var events = DiplomacyDerivedEventState.read(properties);
+    var generations = DiplomacyAllianceOperationState.read(properties);
+    var mirror = WarDiplomacyMirrorState.read(properties);
+    requireMirrorRevision(state, mirror.revision());
+    var missingRelations = new HashSet<DiplomacyPairKey>();
+    var missingTimes = new HashSet<DiplomacyPairKey>();
+    var futureEvents = new HashSet<UUID>();
+    var visitedPairs = new HashSet<DiplomacyPairKey>();
+    grow(properties, "diplomacyAuthority.version", "1", counter);
+    grow(properties, "diplomacyAuthority.sha256", "0".repeat(64), counter);
+    grow(properties, WarDiplomacyMirrorState.PREFIX + "revision", MAX_GENERATION, counter);
+    grow(properties, WarDiplomacyMirrorState.PREFIX + "fingerprint", "0".repeat(64), counter);
+    grow(properties, DiplomacyAllianceOperationState.PREFIX + "version", "1", counter);
+    for (var operation : pending) {
+      requireCompletable(operation.plan());
+      boolean released = state.proofs().containsKey(operation.request().operationId());
+      reserveTerminal(properties, operation, counter);
+      reserveRelease(properties, state, operation, counter);
+      var war = operation.request().war();
+      grow(
+          properties,
+          WarDiplomacyMirrorState.PREFIX + "receipt." + war.warId(),
+          WarDiplomacyMirrorState.encode(
+              new WarDiplomacyMirrorService.WarEntry(
+                  war.warId(), war.attacker(), war.defender(), war.declaredAt(), false)),
+          counter);
+      for (var planned : operation.plan().pairs()) {
+        var pair = DiplomacyPairKey.of(planned.pair().left(), planned.pair().right());
+        long expected = planned.expectedGeneration();
+        if (released && pair.equals(DiplomacyPairKey.of(war.attacker(), war.defender())))
+          expected = Math.addExact(expected, 1);
+        if (generations.generation(pair) != expected)
+          throw new IllegalArgumentException(
+              "Bound treaty generation no longer matches its reservation");
+        if (visitedPairs.add(pair)) {
+          var relation = relations.get(pair);
+          if (relation == null) {
+            missingRelations.add(pair);
+            row("relation." + MAX_FAMILY_ENTRIES + ".", pair, "relation", MAX_RELATION, counter);
+          } else {
+            counter.add(Math.max(0, valueBytes(MAX_RELATION) - valueBytes(relation.name())));
+          }
+          var time = times.get(pair);
+          if (time == null) {
+            missingTimes.add(pair);
+            row("relation-time." + MAX_FAMILY_ENTRIES + ".", pair, "at", MAX_TIME, counter);
+          } else {
+            counter.add(Math.max(0, valueBytes(MAX_TIME) - valueBytes(time.toString())));
+          }
+          String endpoints = pair.left() + "." + pair.right();
+          grow(
+              properties,
+              DiplomacyAllianceOperationState.PREFIX + "pair." + endpoints,
+              MAX_GENERATION + "|-",
+              counter);
+          grow(
+              properties,
+              DiplomacyTreatyOperationState.PREFIX + "owner." + endpoints,
+              operation.request().operationId() + "|" + MAX_GENERATION,
+              counter);
+        }
+        UUID eventId =
+            UUID.nameUUIDFromBytes(
+                (operation.request().operationId() + ":pair:" + pair.left() + ":" + pair.right())
+                    .getBytes(StandardCharsets.UTF_8));
+        if (!events.pending().containsKey(eventId) && futureEvents.add(eventId)) {
+          String prefix = DiplomacyDerivedEventState.PREFIX + MAX_DERIVED_EVENTS + ".";
+          counter.property(prefix + "id", eventId.toString());
+          counter.property(
+              prefix + "value",
+              pair.left()
+                  + "|"
+                  + pair.right()
+                  + "|"
+                  + MAX_RELATION
+                  + "|"
+                  + MAX_RELATION
+                  + "|UNILATERAL_BREAK|"
+                  + MAX_TIME);
+        }
+      }
+    }
+    reserveCount(properties, "count", missingRelations.size(), MAX_FAMILY_ENTRIES, counter);
+    reserveCount(
+        properties, "relation-time.count", missingTimes.size(), MAX_FAMILY_ENTRIES, counter);
+    reserveCount(
+        properties,
+        DiplomacyDerivedEventState.PREFIX + "count",
+        futureEvents.size(),
+        MAX_DERIVED_EVENTS,
+        counter);
+    return counter.bytes;
+  }
+
+  private static void reserveTerminal(
+      Properties properties, OperationView operation, Counter counter) {
+    var binding = operation.binding();
+    var war = binding.war();
+    var end =
+        new EndReceipt(
+            binding,
+            binding.warGeneration(),
+            Math.addExact(binding.warGeneration(), 1),
+            Instant.MAX,
+            Long.MAX_VALUE,
+            new WarDiplomacyMirrorService.WarEntry(
+                war.warId(), war.attacker(), war.defender(), war.declaredAt(), false));
+    var cancellation = new CancellationReceipt(binding);
+    List<OperationView> terminalViews =
+        List.of(
+            terminal(operation, Status.APPLIED, TerminalBasis.END_APPLIED, end, null),
+            terminal(operation, Status.CANCELLED, TerminalBasis.END_REJECTED, end, null),
+            terminal(operation, Status.CANCELLED, TerminalBasis.CANCEL_SEAL, null, cancellation),
+            operation.superseded(Instant.MAX));
+    long maximum = 0;
+    for (var terminal : terminalViews) {
+      maximum = Math.max(maximum, DiplomacyTreatyOperationCodec.encodedValueBytes(terminal));
+    }
+    String key =
+        DiplomacyTreatyOperationState.PREFIX + "operation." + operation.request().operationId();
+    counter.add(Math.max(0, maximum - valueBytes(properties.getProperty(key))));
+  }
+
+  private static OperationView terminal(
+      OperationView operation,
+      Status status,
+      TerminalBasis basis,
+      EndReceipt end,
+      CancellationReceipt cancellation) {
+    return new OperationView(
+        operation.request(),
+        operation.plan(),
+        status,
+        Instant.MAX,
+        operation.binding(),
+        new TerminalEvidence(basis, end, cancellation));
+  }
+
+  private static void reserveRelease(
+      Properties properties,
+      DiplomacyTreatyOperationState state,
+      OperationView operation,
+      Counter counter) {
+    if (state.proofs().containsKey(operation.request().operationId())) return;
+    grow(
+        properties,
+        DiplomacyTreatyOperationState.PREFIX + "proof." + operation.request().operationId(),
+        "2|"
+            + operation.binding().planHash()
+            + "|"
+            + operation.planHash()
+            + "|"
+            + operation.request().war().warId()
+            + "|"
+            + MAX_GENERATION
+            + "|"
+            + MAX_GENERATION
+            + "|"
+            + MAX_GENERATION,
+        counter);
+  }
+
+  private static void reserveCount(
+      Properties properties, String key, int additional, int maximum, Counter counter) {
+    int total = Math.addExact(Integer.parseInt(properties.getProperty(key, "0")), additional);
+    if (total > maximum)
+      throw new IllegalArgumentException(
+          "Treaty terminal metadata exceeds diplomacy entry capacity");
+    grow(properties, key, Integer.toString(total), counter);
+  }
+
+  private static void row(
+      String prefix, DiplomacyPairKey pair, String field, String value, Counter counter) {
+    counter.property(prefix + "left", pair.left().toString());
+    counter.property(prefix + "right", pair.right().toString());
+    counter.property(prefix + field, value);
+  }
+
+  private static void grow(Properties properties, String key, String future, Counter counter) {
+    String previous = properties.getProperty(key);
+    if (previous == null) counter.property(key, future);
+    else counter.add(Math.max(0, valueBytes(future) - valueBytes(previous)));
+  }
+
+  private static void snapshot(Properties properties, Counter counter) {
+    counter.add(PROPERTY_HEADER_BYTES);
+    for (String key : properties.stringPropertyNames())
+      counter.property(key, properties.getProperty(key));
+  }
+
+  private static long valueBytes(String value) {
+    var counter = new Counter(Long.MAX_VALUE);
+    counter.text(value, false);
+    return counter.bytes;
+  }
+
+  private static final class Counter {
+    private final long maximum;
+    private long bytes;
+
+    Counter(long maximum) {
+      if (maximum < 0) throw new IllegalArgumentException("Negative diplomacy snapshot capacity");
+      this.maximum = maximum;
+    }
+
+    void add(long amount) {
+      bytes = Math.addExact(bytes, amount);
+      if (bytes > maximum)
+        throw new IllegalArgumentException("Diplomacy v2 treaty terminal capacity is exhausted");
+    }
+
+    void property(String key, String value) {
+      text(key, true);
+      add(1);
+      text(value, false);
+      add(2);
+    }
+
+    void text(String text, boolean key) {
+      for (int index = 0; index < text.length(); index++) {
+        char character = text.charAt(index);
+        long size =
+            switch (character) {
+              case '\\', '\t', '\n', '\r', '\f', '=', ':', '#', '!' -> 2;
+              case ' ' -> key || index == 0 ? 2 : 1;
+              default -> character < 0x20 || character > 0x7e ? 6 : 1;
+            };
+        add(size);
+      }
+    }
+  }
+}
