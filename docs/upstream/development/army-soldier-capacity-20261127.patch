@@ -0,0 +1,96 @@
+package dev.starcore.starcore.module.war;
+
+import dev.starcore.starcore.module.war.WarSettlementAdmissionService.CancellationReceipt;
+import dev.starcore.starcore.module.war.WarSettlementAdmissionService.EndReceipt;
+import dev.starcore.starcore.module.war.WarSettlementAdmissionService.Request;
+import dev.starcore.starcore.treaty.TreatyEffectManifest;
+import dev.starcore.starcore.treaty.TreatyEffectManifest.Entry;
+import java.time.Instant;
+import java.util.Objects;
+import java.util.Optional;
+import java.util.UUID;
+
+public interface WarSettlementEffectProofReader {
+  Optional<EffectProof> settlementEffect(String receiverId, int receiverVersion, UUID operationId);
+
+  enum Phase {
+    BOUND,
+    APPLIED,
+    CANCELLED,
+    SUPERSEDED
+  }
+
+  enum TerminalBasis {
+    END_APPLIED,
+    END_REJECTED,
+    CANCEL_SEAL,
+    LOCAL_SUPERSEDED
+  }
+
+  record TerminalEvidence(
+      TerminalBasis basis, EndReceipt endReceipt, CancellationReceipt cancellationReceipt) {
+    public TerminalEvidence {
+      Objects.requireNonNull(basis);
+      switch (basis) {
+        case END_APPLIED, END_REJECTED -> {
+          if (endReceipt == null || cancellationReceipt != null)
+            throw new IllegalArgumentException("End outcome requires only its exact end receipt");
+          requireV2(endReceipt.request());
+        }
+        case CANCEL_SEAL -> {
+          if (endReceipt != null || cancellationReceipt == null)
+            throw new IllegalArgumentException("Cancellation outcome requires only its exact seal");
+          requireV2(cancellationReceipt.request());
+        }
+        case LOCAL_SUPERSEDED -> {
+          if (endReceipt != null || cancellationReceipt != null)
+            throw new IllegalArgumentException("Local supersession cannot claim a source decision");
+        }
+      }
+    }
+  }
+
+  record EffectProof(
+      Request binding,
+      Entry entry,
+      Phase phase,
+      Instant terminalAt,
+      TerminalEvidence terminalEvidence) {
+    public EffectProof {
+      requireV2(binding);
+      Objects.requireNonNull(entry);
+      Objects.requireNonNull(phase);
+      if (!binding.manifest().entries().contains(entry))
+        throw new IllegalArgumentException("Effect proof is not in its exact bound manifest");
+      if (phase == Phase.BOUND) {
+        if (terminalAt != null || terminalEvidence != null)
+          throw new IllegalArgumentException("Bound effect cannot contain terminal evidence");
+      } else {
+        if (terminalAt == null || terminalEvidence == null)
+          throw new IllegalArgumentException("Terminal effect requires its exact outcome evidence");
+        boolean matchingBasis =
+            switch (phase) {
+              case APPLIED -> terminalEvidence.basis() == TerminalBasis.END_APPLIED;
+              case CANCELLED ->
+                  terminalEvidence.basis() == TerminalBasis.END_REJECTED
+                      || terminalEvidence.basis() == TerminalBasis.CANCEL_SEAL;
+              case SUPERSEDED -> terminalEvidence.basis() == TerminalBasis.LOCAL_SUPERSEDED;
+              case BOUND -> false;
+            };
+        if (!matchingBasis)
+          throw new IllegalArgumentException("Effect phase does not match terminal evidence");
+        if (terminalEvidence.endReceipt() != null
+                && !terminalEvidence.endReceipt().request().equals(binding)
+            || terminalEvidence.cancellationReceipt() != null
+                && !terminalEvidence.cancellationReceipt().request().equals(binding))
+          throw new IllegalArgumentException("Effect outcome does not match its exact binding");
+      }
+    }
+  }
+
+  private static void requireV2(Request request) {
+    Objects.requireNonNull(request);
+    if (request.protocolVersion() != TreatyEffectManifest.VERSION || request.manifest() == null)
+      throw new IllegalArgumentException("Effect proof requires an explicit v2 binding");
+  }
+}
