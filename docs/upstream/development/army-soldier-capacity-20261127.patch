+        soldiers,
+        health,
+        morale,
+        before.position(),
+        before.state(),
+        supply,
+        before.supplyConsumptionRemainder(),
+        before.createdAt(),
+        before.lastUpdated());
+  }
+
+  private static ArmySnapshot located(ArmySnapshot before, ArmyPosition position) {
+    return new ArmySnapshot(
+        before.token(),
+        before.nationId(),
+        before.type(),
+        before.soldiers(),
+        before.health(),
+        before.morale(),
+        position,
+        before.state(),
+        before.supply(),
+        before.supplyConsumptionRemainder(),
+        before.createdAt(),
+        before.lastUpdated());
+  }
+
+  private static ArmyPosition position(UUID world, double x, double y, double z) {
+    return new ArmyPosition(world, "world", x, y, z, 0, 0);
+  }
+}
diff --git a/src/test/java/dev/starcore/starcore/module/army/model/authority/ArmySkillUseTest.java b/src/test/java/dev/starcore/starcore/module/army/model/authority/ArmySkillUseTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..a34c0eb269349e61e97bf407c61ef8a4c1919bac
--- /dev/null
+++ b/src/test/java/dev/starcore/starcore/module/army/model/authority/ArmySkillUseTest.java
@@ -0,0 +1,221 @@
+package dev.starcore.starcore.module.army.model.authority;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import dev.starcore.starcore.module.army.commander.model.SkillType;
+import dev.starcore.starcore.module.army.model.ArmyState;
+import dev.starcore.starcore.module.army.model.ArmyType;
+import java.time.Instant;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.UUID;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+
+class ArmySkillUseTest {
+  private static final UUID OPERATION = new UUID(0, 1);
+  private static final UUID ACTOR = new UUID(0, 2);
+  private static final UUID NATION = new UUID(0, 3);
+  private static final UUID ARMY = new UUID(0, 4);
+  private static final UUID OTHER = new UUID(0, 5);
+  private static final Instant ACCEPTED = Instant.parse("2026-11-27T04:05:06.123456789Z");
+
+  @Test
+  void completionRetainsItsExactRequestEffectsAndDeadline() {
+    var request = request();
+    var use = ArmySkillUse.completed(request);
+
+    assertSame(request, use.request());
+    assertEquals(request.effects(), use.effects());
+    assertEquals(request.readyAt(), use.readyAt());
+    assertEquals(use, new ArmySkillUse(request, request.effects(), request.readyAt()));
+  }
+
+  @Test
+  void completedEffectsAreDefensivelyCopiedAndImmutable() {
+    var request = request();
+    Map<UUID, ArmySnapshot> effects = new HashMap<>(request.effects());
+    var use = new ArmySkillUse(request, effects, request.readyAt());
+    effects.clear();
+
+    assertEquals(request.effects(), use.effects());
+    assertThrows(UnsupportedOperationException.class, () -> use.effects().clear());
+  }
+
+  @ParameterizedTest
+  @ValueSource(strings = {"request", "effects", "deadline"})
+  void completionRequiresEveryTerminalFact(String field) {
+    var request = request();
+    assertThrows(
+        NullPointerException.class,
+        () ->
+            new ArmySkillUse(
+                field.equals("request") ? null : request,
+                field.equals("effects") ? null : request.effects(),
+                field.equals("deadline") ? null : request.readyAt()));
+    assertThrows(NullPointerException.class, () -> ArmySkillUse.completed(null));
+  }
+
+  @Test
+  void missingExtraOrMiskeyedEffectsCannotMasqueradeAsCompletion() {
+    var request = request();
+    var after = request.effects().get(ARMY);
+    assertThrows(
+        IllegalArgumentException.class,
+        () -> new ArmySkillUse(request, Map.of(), request.readyAt()));
+    assertThrows(
+        IllegalArgumentException.class,
+        () -> new ArmySkillUse(request, Map.of(OTHER, after), request.readyAt()));
+    assertThrows(
+        IllegalArgumentException.class,
+        () -> new ArmySkillUse(request, Map.of(ARMY, after, OTHER, after), request.readyAt()));
+    assertThrows(
+        IllegalArgumentException.class,
+        () -> new ArmySkillUse(request, request.targets(), request.readyAt()));
+  }
+
+  @ParameterizedTest
+  @ValueSource(
+      strings = {
+        "soldiers",
+        "health",
+        "morale",
+        "supply",
+        "remainder",
+        "generation",
+        "incarnation",
+        "nation",
+        "type",
+        "position",
+        "state",
+        "created",
+        "updated"
+      })
+  void everyForgedAfterFieldIsRejected(String field) {
+    var request = request();
+    var after = request.effects().get(ARMY);
+    var forged =
+        new ArmySnapshot(
+            new ArmyToken(
+                ARMY,
+                field.equals("incarnation") ? ACTOR : after.token().incarnation(),
+                after.token().generation() + (field.equals("generation") ? 1 : 0)),
+            field.equals("nation") ? OTHER : after.nationId(),
+            field.equals("type") ? ArmyType.CAVALRY : after.type(),
+            after.soldiers() + (field.equals("soldiers") ? 1 : 0),
+            after.health() + (field.equals("health") ? 1 : 0),
+            after.morale() + (field.equals("morale") ? 1 : 0),
+            field.equals("position")
+                ? new ArmyPosition(OTHER, "other", 1, 2, 3, 4, 5)
+                : after.position(),
+            field.equals("state")
+                ? (after.state() == ArmyState.MARCHING ? ArmyState.STATIONARY : ArmyState.MARCHING)
+                : after.state(),
+            after.supply() + (field.equals("supply") ? 1 : 0),
+            after.supplyConsumptionRemainder() + (field.equals("remainder") ? 1 : 0),
+            after.createdAt().plusNanos(field.equals("created") ? 1 : 0),
+            after.lastUpdated().plusNanos(field.equals("updated") ? 1 : 0));
+
+    assertNotEquals(after, forged, field);
+    assertThrows(
+        IllegalArgumentException.class,
+        () -> new ArmySkillUse(request, Map.of(ARMY, forged), request.readyAt()));
+  }
+
+  @ParameterizedTest
+  @ValueSource(longs = {-1, 1})
+  void deadlineMustMatchTheRequestAtNanosecondPrecision(long nanos) {
+    var request = request();
+    assertThrows(
+        IllegalArgumentException.class,
+        () -> new ArmySkillUse(request, request.effects(), request.readyAt().plusNanos(nanos)));
+  }
+
+  @Test
+  void readinessUsesTheExactDeadlineRatherThanDisplayedSeconds() {
+    var use = ArmySkillUse.completed(request());
+    assertFalse(use.ready(use.readyAt().minusNanos(1)));
+    assertTrue(use.ready(use.readyAt()));
+    assertTrue(use.ready(use.readyAt().plusNanos(1)));
+    assertTrue(use.ready(Instant.MAX));
+  }
+
+  @ParameterizedTest
+  @ValueSource(longs = {1, 999_999, 1_000_000, 999_999_999, 1_000_000_000})
+  void everyPositiveSubsecondRemainderRoundsUpToOneSecond(long nanos) {
+    var use = ArmySkillUse.completed(request());
+    assertEquals(1, use.remainingSeconds(use.readyAt().minusNanos(nanos)));
+  }
+
+  @Test
+  void remainingSecondsRoundsUpOnlyTheFractionalSecondAndStopsAtTheDeadline() {
+    var use = ArmySkillUse.completed(request());
+    assertEquals(60, use.remainingSeconds(ACCEPTED));
+    assertEquals(2, use.remainingSeconds(use.readyAt().minusSeconds(1).minusNanos(1)));
+    assertEquals(2, use.remainingSeconds(use.readyAt().minusSeconds(2)));
+    assertEquals(0, use.remainingSeconds(use.readyAt()));
+    assertEquals(0, use.remainingSeconds(use.readyAt().plusNanos(1)));
+    assertTrue(use.remainingSeconds(Instant.MIN) > 0);
+  }
+
+  @Test
+  void timeQueriesRequireAnExplicitInstant() {
+    var use = ArmySkillUse.completed(request());
+    assertThrows(NullPointerException.class, () -> use.ready(null));
+    assertThrows(NullPointerException.class, () -> use.remainingSeconds(null));
+  }
+
+  @Test
+  void scoutingCompletionHasNoArmyEffectsButStillEnforcesItsCooldown() {
+    var before = request().targets().get(ARMY);
+    var request =
+        new ArmySkillRequest(
+            OPERATION,
+            ACTOR,
+            NATION,
+            SkillType.SCOUT,
+            1,
+            1,
+            null,
+            ACCEPTED,
+            before.position(),
+            Map.of(ARMY, before));
+    var use = ArmySkillUse.completed(request);
+
+    assertTrue(use.effects().isEmpty());
+    assertEquals(15, use.remainingSeconds(ACCEPTED));
+    assertFalse(use.ready(use.readyAt().minusNanos(1)));
+    assertThrows(
+        IllegalArgumentException.class,
+        () -> new ArmySkillUse(request, request.targets(), request.readyAt()));
+  }
+
+  private static ArmySkillRequest request() {
+    var before =
+        new ArmySnapshot(
+            new ArmyToken(ARMY, OTHER, 7),
+            NATION,
+            ArmyType.INFANTRY,
+            40,
+            80,
+            60,
+            new ArmyPosition(OTHER, "world", 0, 0, 0, 0, 0),
+            ArmyState.STATIONARY,
+            30,
+            17,
+            ACCEPTED.minusSeconds(3600),
+            ACCEPTED.minusSeconds(1));
+    return new ArmySkillRequest(
+        OPERATION,
+        ACTOR,
+        NATION,
+        SkillType.INSPIRE,
+        1,
+        1,
+        null,
+        ACCEPTED,
+        null,
+        Map.of(ARMY, before));
+  }
+}
diff --git a/src/test/java/dev/starcore/starcore/module/army/runtime/ArmySnapshotViewsTest.java b/src/test/java/dev/starcore/starcore/module/army/runtime/ArmySnapshotViewsTest.java
