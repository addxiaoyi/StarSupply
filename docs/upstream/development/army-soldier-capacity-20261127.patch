+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void exactCapacityKeepsLatestHistoryThroughCancellationAndRetirementAndOneByteShortRejects(
+      boolean sqlite) throws Exception {
+    var reference = seed(sqlite, root.resolve("reference"), 80);
+    reference.beginNationClosure(CLOSURE, ENEMY_NATION, TIME);
+    reference.useSkill(national(reference, 12, TIME.plusSeconds(1)));
+    long budget = capacity(reference.snapshot());
+    for (boolean enough : new boolean[] {false, true}) {
+      var path = root.resolve(enough ? "exact" : "short");
+      var prepared = seed(sqlite, path, 80);
+      prepared.beginNationClosure(CLOSURE, ENEMY_NATION, TIME);
+      var original = prepared.snapshot();
+      var bounded = reopen(sqlite, path, budget - (enough ? 0 : 1));
