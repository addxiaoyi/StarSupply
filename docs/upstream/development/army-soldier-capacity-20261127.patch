+  private static ArmySnapshot successor(ArmySnapshot before, Instant at, int supply) {
+    return new ArmySnapshot(
+        new ArmyToken(
+            before.token().armyId(), before.token().incarnation(), before.token().generation() + 1),
+        before.nationId(),
+        before.type(),
+        before.soldiers(),
+        before.health(),
+        before.morale(),
+        before.position(),
+        before.state(),
+        supply,
+        before.supplyConsumptionRemainder(),
+        before.createdAt(),
