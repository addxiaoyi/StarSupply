+
+    assertThrows(
+        IllegalArgumentException.class,
+        () ->
+            new ArmyBattleSession(
+                request,
+                resolution(
+                    ArmyBattleSession.Status.COMPLETED,
+                    attackerAfter,
+                    defenderAfter,
