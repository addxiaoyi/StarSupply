+            var prepared = storage.loadStateSnapshot();
+            assertThat(prepared.intents().get(receipt.request().operationId()).status())
+                .isEqualTo(AllianceRecoveryService.Status.PREPARED);
+            assertThat(prepared.invites()).containsKey(new AllianceInviteKey(fixture.a, fixture.b));
