+              } else {
+                armies.remove(armyId);
+                tombstones.put(
+                    armyId,
+                    new ArmyTombstone(
+                        effect.token(),
+                        effect.nationId(),
+                        effect.type(),
+                        effect.createdAt(),
+                        effect.lastUpdated(),
+                        "skill-defeated",
+                        request.operationId()));
+              }
+            });
+    var uses = new HashMap<>(confirmed.skillUses());
+    uses.put(request.operationId(), use);
+    var sessions = new HashMap<>(confirmed.battleSessions());
+    confirmed
+        .battleSessions()
+        .forEach(
+            (sessionId, session) -> {
+              var heads = session.currentHeads();
+              if (session.pending()
+                  && (use.effects().containsKey(heads.attacker().token().armyId())
+                      || use.effects().containsKey(heads.defender().token().armyId()))) {
+                var advanced = session.intervene(use);
+                sessions.put(sessionId, advanced);
+                for (var effect :
+                    new ArmySnapshot[] {
+                      advanced.currentHeads().attacker(), advanced.currentHeads().defender()
+                    }) {
+                  if (effect.isAlive()) armies.put(effect.token().armyId(), effect);
+                  else {
+                    armies.remove(effect.token().armyId());
+                    tombstones.put(
+                        effect.token().armyId(),
+                        new ArmyTombstone(
+                            effect.token(),
+                            effect.nationId(),
+                            effect.type(),
+                            effect.createdAt(),
+                            effect.lastUpdated(),
+                            "skill-defeated",
+                            request.operationId()));
+                  }
+                }
+              }
+            });
+    return commit(
+            new ArmyAuthoritySnapshot(
+                true,
+                confirmed.revision(),
+                armies,
+                tombstones,
+                confirmed.receipts(),
+                confirmed.migration(),
+                Math.max(
+                    request.maximumNationSoldiers() != Long.MAX_VALUE
+                        ? 7
+                        : sessions.equals(confirmed.battleSessions()) ? 4 : 6,
+                    confirmed.version()),
+                confirmed.paidOperations(),
+                sessions,
+                uses,
+                confirmed.nationClosures()))
+        .skillUses()
+        .get(request.operationId());
+  }
+
+  public synchronized ArmyBattleSession startBattle(ArmyBattleRequest request) {
+    requireReady();
+    Objects.requireNonNull(request, "request");
+    var previous = confirmed.battleSessions().get(request.sessionId());
+    if (previous != null) {
+      if (!previous.request().equals(request)) {
+        throw new IllegalArgumentException("Battle session has incompatible request facts");
+      }
+      return previous;
+    }
+    var armies = new HashMap<>(confirmed.armies());
+    armies.put(request.attackerStarted().token().armyId(), request.attackerStarted());
+    armies.put(request.defenderStarted().token().armyId(), request.defenderStarted());
+    var sessions = new HashMap<>(confirmed.battleSessions());
+    sessions.put(request.sessionId(), new ArmyBattleSession(request, null));
+    return commitBattle(armies, confirmed.tombstones(), sessions)
+        .battleSessions()
+        .get(request.sessionId());
+  }
+
+  public synchronized ArmyBattleSession completeBattle(
+      UUID sessionId, ArmyBattleSession.Resolution resolution) {
+    requireReady();
+    var previous = requireBattle(sessionId);
+    Objects.requireNonNull(resolution, "resolution");
+    if (!previous.pending()) {
+      if (!previous.resolution().equals(resolution)) {
+        throw new IllegalArgumentException(
+            "Battle terminal proof differs from its recorded decision");
+      }
+      return previous;
+    }
+    var terminal = new ArmyBattleSession(previous.request(), resolution, previous.interventions());
+    var armies = new HashMap<>(confirmed.armies());
+    var tombstones = new HashMap<>(confirmed.tombstones());
+    for (var effect : new ArmySnapshot[] {resolution.attackerAfter(), resolution.defenderAfter()}) {
+      var armyId = effect.token().armyId();
+      if (effect.isAlive()) {
+        armies.put(armyId, effect);
+      } else {
+        armies.remove(armyId);
+        tombstones.put(
+            armyId,
+            new ArmyTombstone(
+                effect.token(),
+                effect.nationId(),
+                effect.type(),
+                effect.createdAt(),
+                resolution.decidedAt(),
+                "battle-defeated",
+                sessionId));
+      }
+    }
+    var sessions = new HashMap<>(confirmed.battleSessions());
+    sessions.put(sessionId, terminal);
+    return commitBattle(armies, tombstones, sessions).battleSessions().get(sessionId);
+  }
+
+  public synchronized ArmyBattleSession cancelBattle(UUID sessionId, Instant decidedAt) {
+    requireReady();
+    Objects.requireNonNull(decidedAt, "decidedAt");
+    var session = requireBattle(sessionId);
+    if (!session.pending()) return session;
+    return completeBattle(sessionId, ArmyBattleSession.cancelled(session, decidedAt));
+  }
+
+  private ArmyBattleSession requireBattle(UUID sessionId) {
+    var session = confirmed.battleSessions().get(Objects.requireNonNull(sessionId, "sessionId"));
+    if (session == null) throw new IllegalArgumentException("Army battle session does not exist");
+    return session;
+  }
+
+  private ArmyAuthoritySnapshot commitBattle(
+      Map<UUID, ArmySnapshot> armies,
+      Map<UUID, ArmyTombstone> tombstones,
+      Map<UUID, ArmyBattleSession> sessions) {
+    return commit(
+        new ArmyAuthoritySnapshot(
+            true,
+            confirmed.revision(),
+            armies,
+            tombstones,
+            confirmed.receipts(),
+            confirmed.migration(),
+            Math.max(3, confirmed.version()),
+            confirmed.paidOperations(),
+            sessions,
+            confirmed.skillUses(),
+            confirmed.nationClosures()));
+  }
+
+  public synchronized ArmyPaidOperation preparePaid(ArmyPaidRequest request) {
+    requireReady();
+    Objects.requireNonNull(request, "request");
+    var previous = confirmed.paidOperations().get(request.operationId());
+    if (previous != null) {
+      if (!previous.request().equals(request)) {
+        throw new IllegalArgumentException("Army paid operation has incompatible request facts");
+      }
+      return previous;
+    }
+    var operations = new HashMap<>(confirmed.paidOperations());
+    operations.put(request.operationId(), new ArmyPaidOperation(request, false, null));
+    return commitPaid(confirmed.armies(), operations).paidOperations().get(request.operationId());
+  }
+
+  public synchronized ArmyPaidOperation cancelPaid(UUID operationId) {
+    requireReady();
+    var operation = requirePaid(operationId);
+    if (!operation.pending() || operation.cancellationRequested()) return operation;
+    var operations = new HashMap<>(confirmed.paidOperations());
+    operations.put(operationId, new ArmyPaidOperation(operation.request(), true, null));
+    return commitPaid(confirmed.armies(), operations).paidOperations().get(operationId);
+  }
+
+  public synchronized ArmyPaidOperation confirmPaid(
+      UUID operationId, NationDebitService.Receipt debitReceipt) {
+    requireReady();
+    var operation = requirePaid(operationId);
+    Objects.requireNonNull(debitReceipt, "debitReceipt");
+    if (!operation.pending()) {
+      if (!debitReceipt.equals(operation.debitReceipt())) {
+        throw new IllegalArgumentException("Army paid terminal receipt differs from its decision");
+      }
+      return operation;
+    }
+    var terminal =
+        new ArmyPaidOperation(operation.request(), operation.cancellationRequested(), debitReceipt);
+    var armies = new HashMap<>(confirmed.armies());
+    if (terminal.applied()) armies.put(operation.request().armyId(), operation.request().after());
+    var operations = new HashMap<>(confirmed.paidOperations());
+    operations.put(operationId, terminal);
+    return commitPaid(armies, operations).paidOperations().get(operationId);
+  }
+
+  private ArmyPaidOperation requirePaid(UUID operationId) {
+    var operation =
+        confirmed.paidOperations().get(Objects.requireNonNull(operationId, "operationId"));
+    if (operation == null) throw new IllegalArgumentException("Army paid operation does not exist");
+    return operation;
+  }
+
+  private ArmyAuthoritySnapshot commitPaid(
+      Map<UUID, ArmySnapshot> armies, Map<UUID, ArmyPaidOperation> operations) {
+    return commit(
+        new ArmyAuthoritySnapshot(
+            true,
+            confirmed.revision(),
+            armies,
+            confirmed.tombstones(),
+            confirmed.receipts(),
+            confirmed.migration(),
+            Math.max(
+                operations.values().stream()
+                        .anyMatch(op -> op.request().maximumNationSoldiers() != Long.MAX_VALUE)
+                    ? 7
+                    : 2,
+                confirmed.version()),
+            operations,
+            confirmed.battleSessions(),
+            confirmed.skillUses(),
+            confirmed.nationClosures()));
+  }
+
+  public synchronized ArmyAuthoritySnapshot create(ArmySnapshot candidate) {
+    requireReady();
+    Objects.requireNonNull(candidate, "candidate");
+    if (candidate.token().generation() != 1) {
+      throw new IllegalArgumentException("New army generation must be one");
+    }
+    UUID armyId = candidate.token().armyId();
+    if (confirmed.armies().containsKey(armyId)
+        || confirmed.tombstones().containsKey(armyId)
+        || confirmed.receipts().values().stream()
+            .anyMatch(receipt -> receipt.armyId().equals(armyId))) {
+      throw new IllegalArgumentException("Army identity has already been used");
+    }
+    var armies = new HashMap<>(confirmed.armies());
+    armies.put(armyId, candidate);
+    return commit(armies, confirmed.tombstones(), confirmed.receipts());
+  }
+
+  public synchronized ArmyAuthoritySnapshot replace(ArmyToken expected, ArmySnapshot replacement) {
+    return transition(Map.of(expected, replacement), Map.of());
+  }
+
+  public synchronized ArmyAuthoritySnapshot retire(ArmyToken expected, Retirement retirement) {
+    return transition(Map.of(), Map.of(expected, retirement));
+  }
+
+  public synchronized ArmyAuthoritySnapshot transition(
+      Map<ArmyToken, ArmySnapshot> replacements, Map<ArmyToken, Retirement> retirements) {
+    requireReady();
+    var requestedReplacements = Map.copyOf(Objects.requireNonNull(replacements, "replacements"));
+    var requestedRetirements = Map.copyOf(Objects.requireNonNull(retirements, "retirements"));
+    if (requestedReplacements.isEmpty() && requestedRetirements.isEmpty()) {
+      throw new IllegalArgumentException("Army transition must contain an update or retirement");
+    }
+    Set<UUID> targets = new HashSet<>();
+    var armies = new HashMap<>(confirmed.armies());
+    var tombstones = new HashMap<>(confirmed.tombstones());
+    requestedReplacements.forEach(
+        (expected, replacement) -> {
+          requireUnique(targets, expected);
+          requireCurrent(expected);
+          if (!replacement.token().equals(expected)) {
+            throw new IllegalArgumentException("Replacement must retain its expected army token");
+          }
+          armies.put(expected.armyId(), replacement.withToken(nextToken(expected)));
+        });
+    requestedRetirements.forEach(
+        (expected, retirement) -> {
+          requireUnique(targets, expected);
+          var before = requireCurrent(expected);
+          armies.remove(expected.armyId());
+          tombstones.put(
+              expected.armyId(),
+              new ArmyTombstone(
+                  nextToken(expected),
+                  before.nationId(),
+                  before.type(),
+                  before.createdAt(),
+                  retirement.retiredAt(),
+                  retirement.reason(),
+                  retirement.operationId()));
+        });
+    return commit(armies, tombstones, confirmed.receipts());
+  }
+
+  public synchronized ArmyLogisticsReceipt applyLogisticsSupply(
+      UUID requestId, UUID nationId, ArmyToken expected, int requestedPoints, Instant appliedAt) {
+    requireReady();
+    Objects.requireNonNull(requestId, "requestId");
+    Objects.requireNonNull(nationId, "nationId");
+    Objects.requireNonNull(expected, "expected");
+    Objects.requireNonNull(appliedAt, "appliedAt");
+    if (requestedPoints < 1 || requestedPoints > 100) {
+      throw new IllegalArgumentException("Logistics points must be between 1 and 100");
+    }
+    var previous = confirmed.receipts().get(requestId);
+    if (previous != null) {
+      if (!previous.armyId().equals(expected.armyId())
+          || !previous.nationId().equals(nationId)
+          || previous.requestedPoints() != requestedPoints
+          || !previous.legacy() && !previous.incarnation().equals(expected.incarnation())) {
+        throw new IllegalArgumentException("Logistics request identity has incompatible facts");
+      }
+      return previous;
+    }
+    var before = requireCurrent(expected);
+    if (!before.nationId().equals(nationId)) {
+      throw new IllegalArgumentException("Logistics target belongs to another nation");
+    }
+    int appliedPoints = Math.min(requestedPoints, 100 - before.supply());
+    var receipt =
+        new ArmyLogisticsReceipt(
+            requestId,
+            expected.armyId(),
+            nationId,
+            requestedPoints,
+            appliedPoints,
+            expected.incarnation());
+    var after =
+        new ArmySnapshot(
+            nextToken(expected),
+            before.nationId(),
+            before.type(),
+            before.soldiers(),
+            before.health(),
+            before.morale(),
+            before.position(),
+            before.state(),
+            before.supply() + appliedPoints,
+            before.supplyConsumptionRemainder(),
+            before.createdAt(),
+            appliedAt);
+    var armies = new HashMap<>(confirmed.armies());
+    armies.put(expected.armyId(), after);
+    var receipts = new HashMap<>(confirmed.receipts());
+    receipts.put(requestId, receipt);
+    return commit(armies, confirmed.tombstones(), receipts).receipts().get(requestId);
+  }
+
+  private ArmyAuthoritySnapshot commit(
+      Map<UUID, ArmySnapshot> armies,
+      Map<UUID, ArmyTombstone> tombstones,
+      Map<UUID, ArmyLogisticsReceipt> receipts) {
+    var expected = confirmed;
+    var draft =
+        new ArmyAuthoritySnapshot(
+            true,
+            expected.revision(),
+            armies,
+            tombstones,
+            receipts,
+            expected.migration(),
+            expected.version(),
+            expected.paidOperations(),
+            expected.battleSessions(),
+            expected.skillUses(),
+            expected.nationClosures());
+    return commit(draft);
+  }
+
+  private ArmyAuthoritySnapshot commit(ArmyAuthoritySnapshot draft) {
+    var expected = confirmed;
+    var intended = draft.withRevision(Math.addExact(expected.revision(), 1));
+    ArmyAuthorityState.validateCommit(expected, intended);
+    requireIdle();
+    ready = false;
+    storageBusy = true;
+    try {
+      var result = storage.commit(expected, draft);
+      if (!intended.equals(result)) {
+        throw new IllegalStateException("Army authority confirmation differs from intended image");
+      }
+      confirmed = result;
+      ready = true;
+      return result;
+    } finally {
+      storageBusy = false;
+    }
+  }
+
+  private ArmySnapshot requireCurrent(ArmyToken expected) {
+    Objects.requireNonNull(expected, "expected");
+    var current = confirmed.armies().get(expected.armyId());
+    if (current == null || !current.token().equals(expected)) {
+      throw new IllegalStateException("Army target is missing, retired or has a stale token");
+    }
+    return current;
+  }
+
+  private static ArmyToken nextToken(ArmyToken token) {
+    return new ArmyToken(token.armyId(), token.incarnation(), Math.addExact(token.generation(), 1));
+  }
+
+  private static void requireUnique(Set<UUID> targets, ArmyToken expected) {
+    if (!targets.add(expected.armyId())) {
+      throw new IllegalArgumentException("Army transition contains a duplicate target");
+    }
+  }
+
+  private void requireIdle() {
+    if (storageBusy) {
+      throw new IllegalStateException("Army authority storage operation is already in progress");
+    }
+  }
+
+  private void requireReady() {
+    if (!isReady()) {
+      throw new IllegalStateException("Army authority is not ready");
+    }
+  }
+
+  public record Retirement(Instant retiredAt, String reason, UUID operationId) {
+    public Retirement {
+      Objects.requireNonNull(retiredAt, "retiredAt");
+      Objects.requireNonNull(reason, "reason");
+      if (reason.isBlank()) {
+        throw new IllegalArgumentException("Army retirement reason must not be blank");
+      }
+    }
+  }
+}
