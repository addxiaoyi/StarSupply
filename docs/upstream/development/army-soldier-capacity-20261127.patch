+      return this;
+    }
+
+    public Instant instant() {
+      return at;
+    }
+  }
+
+  public static final class Probe implements ArmyAuthorityStorage {
+    final ArmyAuthorityStorage delegate;
+    public int failIn = -1;
+    public boolean commitBeforeFailure;
+    public boolean failLoad;
+    public int commits;
+
+    Probe(ArmyAuthorityStorage delegate) {
+      this.delegate = delegate;
+    }
+
+    public ArmyAuthoritySnapshot load() {
+      if (failLoad) throw new IllegalStateException("injected read failure");
+      return delegate.load();
+    }
+
+    public ArmyAuthoritySnapshot snapshot() {
+      return delegate.snapshot();
+    }
+
+    public ArmyAuthoritySnapshot initializeFromLegacy(ArmyLegacyImporter.ImportResult imported) {
+      return delegate.initializeFromLegacy(imported);
+    }
+
+    public ArmyAuthoritySnapshot commit(
+        ArmyAuthoritySnapshot expected, ArmyAuthoritySnapshot draft) {
+      commits++;
+      if (failIn == 0) {
+        failIn = -1;
+        if (commitBeforeFailure) delegate.commit(expected, draft);
+        throw new IllegalStateException("injected Army commit failure");
+      }
+      if (failIn > 0) failIn--;
+      return delegate.commit(expected, draft);
+    }
+  }
