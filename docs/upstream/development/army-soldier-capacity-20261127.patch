diff --git a/src/main/java/dev/starcore/starcore/module/event/EventAuthorityState.java b/src/main/java/dev/starcore/starcore/module/event/EventAuthorityState.java
new file mode 100644
index 0000000000000000000000000000000000000000..6bc7d2c546eceeb03c5106a7e4a0a687c6282813
--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/module/event/EventAuthorityState.java
@@ -0,0 +1,217 @@
+package dev.starcore.starcore.module.event;
+
+import dev.starcore.starcore.module.nation.model.NationId;
+import java.nio.charset.StandardCharsets;
+import java.time.Instant;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import java.util.Properties;
+import java.util.Set;
+import java.util.UUID;
+
+record EventAuthorityState(
+    Map<NationId, List<NationEventRecord>> events, Map<UUID, AllianceReceipt> receipts) {
+  private static final String RECEIPT_PREFIX = "alliance-receipt.";
+  private static final Set<String> EVENT_FIELDS =
+      Set.of("id", "nationId", "occurredAt", "type", "message", "context");
+
+  record AllianceReceipt(
+      UUID eventId, NationId left, NationId right, boolean formed, Instant occurredAt) {
+    AllianceReceipt {
+      Objects.requireNonNull(eventId);
+      Objects.requireNonNull(left);
+      Objects.requireNonNull(right);
+      Objects.requireNonNull(occurredAt);
+      if (left.equals(right)) throw new IllegalArgumentException("Self alliance event");
+    }
+
+    String encode() {
+      return left + "|" + right + "|" + formed + "|" + occurredAt;
+    }
+
+    NationEventRecord recordFor(NationId nation, NationId other) {
+      UUID recordId =
+          UUID.nameUUIDFromBytes(
+              ("starcore:alliance-event:" + eventId + ":" + nation)
+                  .getBytes(StandardCharsets.UTF_8));
+      return new NationEventRecord(
+          recordId,
+          nation,
+          occurredAt,
+          formed ? "alliance-formed" : "alliance-broken",
+          "与 " + other + (formed ? " 建立联盟" : " 的联盟破裂"),
+          "diplomacy-event:" + eventId);
+    }
+
+    List<NationEventRecord> records() {
+      return List.of(recordFor(left, right), recordFor(right, left));
+    }
+  }
+
+  EventAuthorityState {
+    Map<NationId, List<NationEventRecord>> copied = new HashMap<>();
+    Set<UUID> ids = new HashSet<>();
+    events.forEach(
+        (nation, records) -> {
+          Objects.requireNonNull(nation);
+          for (var record : records) {
+            if (!nation.equals(record.nationId())
+                || record.id() == null
+                || !ids.add(record.id())
+                || record.occurredAt() == null
+                || record.type() == null
+                || record.type().isBlank()
+                || record.message() == null
+                || record.message().isBlank()
+                || record.context() == null)
+              throw new IllegalArgumentException("Invalid event record");
+          }
+          if (!records.isEmpty())
+            copied.put(
+                nation,
+                records.stream()
+                    .sorted(
+                        java.util.Comparator.comparing(NationEventRecord::occurredAt)
+                            .thenComparing(record -> record.id().toString()))
+                    .toList());
+        });
+    events = Map.copyOf(copied);
+    receipts = Map.copyOf(receipts);
+    Map<UUID, NationEventRecord> visible = new HashMap<>();
+    events.values().forEach(records -> records.forEach(record -> visible.put(record.id(), record)));
+    receipts.forEach(
+        (id, receipt) -> {
+          if (!id.equals(receipt.eventId()))
+            throw new IllegalArgumentException("Invalid event receipt identity");
+          for (var expected : receipt.records()) {
+            var actual = visible.get(expected.id());
+            if (actual != null && !actual.equals(expected))
+              throw new IllegalArgumentException("Event receipt record mismatch");
+          }
+        });
+  }
+
+  static EventAuthorityState empty() {
+    return new EventAuthorityState(Map.of(), Map.of());
+  }
+
+  EventAuthorityState add(NationEventRecord record) {
+    var next = mutableEvents();
+    next.computeIfAbsent(record.nationId(), ignored -> new ArrayList<>()).add(record);
+    return new EventAuthorityState(next, receipts);
+  }
+
+  EventAuthorityState accept(AllianceReceipt receipt) {
+    var previous = receipts.get(receipt.eventId());
+    if (previous != null) {
+      if (!previous.equals(receipt))
+        throw new IllegalArgumentException("Conflicting alliance event payload");
+      return this;
+    }
+    var nextEvents = mutableEvents();
+    for (var record : receipt.records())
+      nextEvents.computeIfAbsent(record.nationId(), ignored -> new ArrayList<>()).add(record);
+    var nextReceipts = new HashMap<>(receipts);
+    nextReceipts.put(receipt.eventId(), receipt);
+    return new EventAuthorityState(nextEvents, nextReceipts);
+  }
+
+  EventAuthorityState clear(NationId nation) {
+    var next = mutableEvents();
+    next.remove(nation);
+    return new EventAuthorityState(next, receipts);
+  }
+
+  private Map<NationId, List<NationEventRecord>> mutableEvents() {
+    Map<NationId, List<NationEventRecord>> result = new HashMap<>();
+    events.forEach((nation, records) -> result.put(nation, new ArrayList<>(records)));
+    return result;
+  }
+
+  Properties write() {
+    var result = EventStateCodec.toProperties(events);
+    receipts.forEach((id, receipt) -> result.setProperty(RECEIPT_PREFIX + id, receipt.encode()));
+    return result;
+  }
+
+  static EventAuthorityState read(Properties value) {
+    int count = Integer.parseInt(value.getProperty("count", "0"));
+    if (count < 0 || count > 1_000_000) throw new IllegalArgumentException("Invalid event count");
+    Map<NationId, List<NationEventRecord>> records = new HashMap<>();
+    for (int index = 0; index < count; index++) {
+      String prefix = "event." + index + ".";
+      NationId nation = NationId.of(uuid(value.getProperty(prefix + "nationId")));
+      var record =
+          new NationEventRecord(
+              uuid(value.getProperty(prefix + "id")),
+              nation,
+              Instant.parse(Objects.requireNonNull(value.getProperty(prefix + "occurredAt"))),
+              Objects.requireNonNull(value.getProperty(prefix + "type")),
+              Objects.requireNonNull(value.getProperty(prefix + "message")),
+              value.getProperty(prefix + "context", ""));
+      records.computeIfAbsent(nation, ignored -> new ArrayList<>()).add(record);
+    }
+    Map<UUID, AllianceReceipt> receipts = new HashMap<>();
+    for (String key : value.stringPropertyNames()) {
+      if (key.startsWith("event.")) {
+        String suffix = key.substring("event.".length());
+        int dot = suffix.indexOf('.');
+        if (dot <= 0) throw new IllegalArgumentException("Invalid event property");
+        int index = Integer.parseInt(suffix.substring(0, dot));
+        if (index < 0
+            || index >= count
+            || !Integer.toString(index).equals(suffix.substring(0, dot))
+            || !EVENT_FIELDS.contains(suffix.substring(dot + 1)))
+          throw new IllegalArgumentException("Unexpected event property");
+      } else if (key.startsWith(RECEIPT_PREFIX)) {
+        UUID id = uuid(key.substring(RECEIPT_PREFIX.length()));
+        String[] parts = value.getProperty(key).split("\\|", -1);
+        if (parts.length != 4 || !Set.of("true", "false").contains(parts[2]))
+          throw new IllegalArgumentException("Invalid alliance receipt");
+        var receipt =
+            new AllianceReceipt(
+                id,
+                NationId.of(uuid(parts[0])),
+                NationId.of(uuid(parts[1])),
+                Boolean.parseBoolean(parts[2]),
+                Instant.parse(parts[3]));
+        if (!receipt.encode().equals(value.getProperty(key)))
+          throw new IllegalArgumentException("Noncanonical alliance receipt");
+        receipts.put(id, receipt);
+      }
+    }
+    return new EventAuthorityState(records, receipts);
+  }
+
+  private static UUID uuid(String value) {
+    UUID parsed = UUID.fromString(Objects.requireNonNull(value));
+    if (!parsed.toString().equals(value))
+      throw new IllegalArgumentException("Noncanonical event UUID");
+    return parsed;
+  }
+
+  static void validate(Properties value) {
+    read(value);
+  }
+
+  static void transition(Properties previous, Properties next) {
+    var before = read(previous);
+    var after = read(next);
+    before.receipts.forEach(
+        (id, receipt) -> {
+          if (!receipt.equals(after.receipts.get(id)))
+            throw new IllegalArgumentException("Alliance event receipts are immutable");
+        });
+    Set<NationEventRecord> visible = new HashSet<>();
+    after.events.values().forEach(visible::addAll);
+    after.receipts.forEach(
+        (id, receipt) -> {
+          if (!before.receipts.containsKey(id) && !visible.containsAll(receipt.records()))
+            throw new IllegalArgumentException("Alliance event must commit both recipients");
+        });
+  }
+}
