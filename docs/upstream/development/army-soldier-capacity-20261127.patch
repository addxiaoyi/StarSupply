@@ -0,0 +1,73 @@
+package dev.starcore.starcore.module.diplomacy.alliance.storage;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+import dev.starcore.starcore.module.diplomacy.AllianceRetirementFixture;
+import dev.starcore.starcore.module.diplomacy.RelationshipValues;
+import dev.starcore.starcore.module.diplomacy.alliance.AlliancePairKey;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.time.Instant;
+import java.util.Properties;
+import java.util.UUID;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+
+class AllianceStorageSchemaTest {
+  @TempDir Path root;
+
+  @ParameterizedTest
+  @ValueSource(strings = {"1", "2"})
+  void legacySchemaNamesAndEpochTimestampsMigrateToVersionThree(String version) throws Exception {
+    try (var fixture = new AllianceRetirementFixture(root, false)) {
+      var pair = AlliancePairKey.of(fixture.a, fixture.b);
+      var legacy = new Properties();
+      legacy.setProperty("format.version", version);
+      String name = "2".equals(version) ? RelationshipValues.encode("Alpha|甲") : "Alpha甲";
+      String other = "2".equals(version) ? RelationshipValues.encode("Bravo") : "Bravo";
+      legacy.setProperty("alliance." + fixture.a + ":" + fixture.b, name + "|" + other + "|1234");
+      fixture.persistence.saveProperties("diplomacy", "alliance_state.properties", legacy);
+      var storage = fixture.allianceStorage();
+      var restored = storage.loadStateSnapshot();
+      assertThat(restored.alliances().get(pair).nation1Name())
+          .isEqualTo("2".equals(version) ? "Alpha|甲" : "Alpha甲");
+      assertThat(restored.alliances().get(pair).formedAt()).isEqualTo(Instant.ofEpochMilli(1234));
+      storage.saveInvitesSync(restored.invites());
+      var current = fixture.persistence.loadProperties("diplomacy", "alliance_state.properties");
+      assertThat(current.getProperty("format.version")).isEqualTo("3");
+      assertThat(fixture.allianceStorage().loadStateSnapshot().alliances())
+          .isEqualTo(restored.alliances());
+    }
+  }
+
+  @Test
+  void retirementOnlyFirstWriteUsesVersionThree() {
+    try (var fixture = new AllianceRetirementFixture(root, false)) {
+      fixture.allianceStorage().retire(UUID.randomUUID(), fixture.a);
+      assertThat(
+              fixture
+                  .persistence
+                  .loadProperties("diplomacy", "alliance_state.properties")
+                  .getProperty("format.version"))
+          .isEqualTo("3");
+    }
+  }
+
+  @Test
+  void futureSchemaFailsClosedWithoutWriting() throws Exception {
+    try (var fixture = new AllianceRetirementFixture(root, false)) {
+      var future = new Properties();
+      future.setProperty("format.version", "4");
+      fixture.persistence.saveProperties("diplomacy", "alliance_state.properties", future);
+      var path =
+          fixture.persistence.namespacePath("diplomacy").resolve("alliance_state.properties");
+      byte[] before = Files.readAllBytes(path);
+      assertThatThrownBy(() -> fixture.allianceStorage().loadStateSnapshot())
+          .hasMessageContaining("Unsupported alliance state schema");
+      assertThat(Files.readAllBytes(path)).isEqualTo(before);
+    }
+  }
+}
