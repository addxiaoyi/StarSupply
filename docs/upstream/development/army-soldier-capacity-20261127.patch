+
+class FederationMigrationTest {
+  @TempDir Path root;
+
+  @ParameterizedTest
+  @ValueSource(ints = {0, 1, 2, 3, 4, 5})
+  void everyLegacyFamilyMustExistOnceMigrationHasData(int missing) throws Exception {
+    try (var f = new FederationTestFixture(root, false)) {
+      seed(f);
+      Files.delete(f.persistence.namespacePath("alliance").resolve(FAMILIES.get(missing)));
+      assertThatThrownBy(f::service).hasMessageContaining("Missing legacy federation authority");
+    }
+  }
+
+  static final List<String> FAMILIES =
+      List.of(
+          "alliance_data.properties",
+          "alliance_members.properties",
+          "nation_alliance_map.properties",
+          "alliance_invites.properties",
+          "alliance_relations.properties",
+          "alliance_announcements.properties");
+
+  Properties properties(String... values) {
+    var p = new Properties();
+    for (int i = 0; i < values.length; i += 2) p.setProperty(values[i], values[i + 1]);
+    return p;
+  }
+
+  void write(FederationTestFixture f, String file, Properties p) throws Exception {
+    try (var out = Files.newOutputStream(f.persistence.namespacePath("alliance").resolve(file))) {
+      p.store(out, "legacy");
+    }
+  }
+
+  UUID seed(FederationTestFixture f) throws Exception {
+    var id = UUID.randomUUID();
+    String a = id.toString(), n = f.a.toString();
+    write(
+        f,
+        FAMILIES.get(0),
+        properties(
+            a + ".name", "Alpha|甲", a + ".leader", n, a + ".created", "1234", a + ".emblem", ""));
+    write(f, FAMILIES.get(1), properties(a, n + ",LEADER,1234"));
+    write(f, FAMILIES.get(2), properties(n, a));
+    write(
+        f,
+        FAMILIES.get(3),
+        properties(f.b.toString(), a + "|Alpha|甲|1234|" + n + "|9999999999999"));
+    write(f, FAMILIES.get(4), new Properties());
+    write(f, FAMILIES.get(5), properties(a, "hello|world\n甲|" + n + "|1234|" + a));
+    return id;
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void migrationPreservesDelimiterTextAndSealsAllFamiliesWithoutEditingLegacy(boolean sql)
+      throws Exception {
+    try (var f = new FederationTestFixture(root, sql)) {
+      var id = seed(f);
