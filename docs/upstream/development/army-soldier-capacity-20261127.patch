+  @CsvSource({"false,false", "true,false", "false,true", "true,true"})
+  void schemaThreePreparedAndReservedOperationsRecoverAsV1WithoutBindingOrUpgrade(
+      boolean sql, boolean reserved) throws Exception {
+    try (var fixture = new Fixture(root, sql)) {
+      War war = fixture.seed();
+      Session first = fixture.open();
+      List<PeaceTreaty.PeaceTerm> terms =
+          List.of(new PeaceTreaty.PoliticalTerm("EMBARGO", "Original legacy requirement"));
+      PeaceTreaty treaty = first.treaties.proposeTreaty(war.id(), attacker, defender, terms);
+      var snapshot = first.wars.snapshot(war.id());
+      var request =
+          new ReserveRequest(
+              UUID.randomUUID(),
+              treaty.id(),
+              snapshot.war(),
+              snapshot.generation(),
+              snapshot.fingerprint(),
+              attacker,
+              defender,
+              declaredAt.plusSeconds(1).plusNanos(37),
+              terms.size(),
+              List.of(
+                  new IndexedTerm(0, "PoliticalTerm", "EMBARGO", "Original legacy requirement")));
+      var original = PeaceTreatyBatch.prepare(request);
+      if (reserved) original = original.reserved(first.receiver.reserveTreaty(request).plan());
+      var execution = PeaceTreatyExecution.create(terms);
+      treaty.beginExecution();
+      execution.begin();
+      execution.batch(original);
+      var legacy =
+          JsonParser.parseString(
+                  new PeaceTreatyStateCodec()
+                      .encode(treaty, execution, List.of(), List.of(), List.of(), List.of()))
+              .getAsJsonObject();
+      legacy.addProperty("version", 3);
+      var batchJson = legacy.getAsJsonObject("execution").getAsJsonObject("batch");
+      batchJson.remove("binding");
+      removeLegacyReserveProtocol(batchJson.getAsJsonObject("request"));
+      if (batchJson.has("plan"))
+        removeLegacyReserveProtocol(batchJson.getAsJsonObject("plan").getAsJsonObject("request"));
+      first.storage.saveTreatyData(treaty.id(), "STATE", legacy.toString());
+      assertEquals(original, first.batch(treaty.id()));
+      first.close();
+
+      Session restarted = fixture.open();
+      assertEquals(original, restarted.batch(treaty.id()));
+      assertEquals(1, restarted.treaties.recoverTreatyExecutions(25));
+      var completed = restarted.batch(treaty.id());
+      assertEquals(request, completed.request());
+      assertEquals(1, completed.request().protocolVersion());
+      assertNull(completed.request().envelope());
+      assertNull(completed.binding());
+      assertEquals(1, completed.warRequest().protocolVersion());
+      assertNull(completed.warRequest().manifest());
+      assertEquals(completed.plan().planHash(), completed.warRequest().planHash());
+      assertEquals(declaredAt.plusSeconds(1).plusNanos(37), completed.request().preparedAt());
+      assertEquals(PeaceTreatyBatch.Stage.RELEASED, completed.stage());
+      assertEquals(Status.APPLIED, completed.terminalReceipt().status());
+      assertNull(completed.terminalReceipt().binding());
+      assertNull(completed.terminalReceipt().terminalEvidence());
+      var release = restarted.storage.settlementRelease(request.operationId()).orElseThrow();
+      assertEquals(1, release.protocolVersion());
+      assertTrue(release.effectProofs().isEmpty());
+      assertFalse(fixture.storage().loadWar(war.id()).isActive());
+      assertEquals(1, restarted.treaties.getPoliticalRestrictions(defender.value()).size());
+      verify(restarted.receiver, never()).bindManifest(any(), anyString(), any());
+      verify(restarted.receiver, never()).requireEffectProofPersistence();
+      verify(restarted.wars, never()).requireEffectProofPersistence();
+      restarted.close();
+
+      Session replay = fixture.open();
+      assertEquals(completed, replay.batch(treaty.id()));
+      assertEquals(
+          release,
+          replay.wars.releaseSettlement(
+              new ReleaseRequest(request.operationId(), completed.warRequest().planHash())));
+      assertEquals(0, replay.treaties.recoverTreatyExecutions(25));
+      verifyNoInteractions(fixture.treasury, fixture.army, fixture.territory);
+    }
