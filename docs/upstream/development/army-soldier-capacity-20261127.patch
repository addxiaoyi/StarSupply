+        assertThat(fresh.treasury.balance(f.child)).isEqualByComparingTo("2000");
+      }
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void missingOrConflictingAdmissionReadbackNeverRemovesTheDirectory(boolean sql) throws Exception {
+    var f = fixture();
+    try (var first = f.new Session(sql, true)) {
+      doReturn(Optional.empty()).when(first.wars).disbandAdmission(any());
+      assertThatThrownBy(() -> first.nations.disbandNation(f.parent))
+          .hasMessageContaining("could not be verified");
+      var op = first.operation();
+      assertThat(op.state()).isEqualTo(NationDisbandOperation.State.ADMISSION_PENDING);
+      doReturn(
+              Optional.of(
+                  new Receipt(
+                      new Request(op.transaction().transactionId(), List.of(f.parent)),
+                      Decision.ACCEPTED)))
+          .when(first.wars)
+          .disbandAdmission(any());
+      assertThatThrownBy(() -> first.nations.recoverDisband(op.transaction().transactionId()))
+          .hasMessageContaining("could not be verified");
+      assertThat(first.nations.nationById(f.parent)).isPresent();
+      assertThat(first.receipts()).isEmpty();
+      try (var fresh = f.new Session(sql, false)) {
+        fresh.nations.recoverPendingDisband();
+        fresh.assertComplete(op.transaction().transactionId());
+      }
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void originalDecisionRejectsChangedTargetSetAndDirectoryCannotSkipAdmission(boolean sql)
+      throws Exception {
+    var f = fixture();
+    try (var first = f.new Session(sql, true)) {
+      first.fail(NationDisbandJointTest.Endpoint.WAR, false, f.parent);
+      assertThatThrownBy(() -> first.nations.disbandNation(f.parent));
+      var original = first.operation();
+      var storage = new WarStateStorage(first.plugin, first.database);
+      assertThatThrownBy(
+              () ->
+                  storage.prepareDisband(
+                      new Request(original.transaction().transactionId(), List.of(f.parent))))
+          .hasMessageContaining("Conflicting");
+      assertThatThrownBy(() -> storage.retireNationWars(UUID.randomUUID(), f.parent))
+          .hasMessageContaining("Conflicting");
