+        (id, proof) -> {
+          var view = state.operations.get(id);
+          if (view == null
+              || view.plan() == null
+              || !proof.planHash().equals(view.planHash())
+              || !proof.warId().equals(view.request().war().warId())
+              || !matchesProofVersion(view, proof)
+              || mirror.revision() < proof.sourceRevision()
+              || !exactEntry(view.request().war(), mirror.receipts().get(proof.warId()))
+              || mirror.receipts().get(proof.warId()).active())
+            throw new IllegalArgumentException("Orphan treaty release proof");
+        });
