+        90,
+        75,
+        new ArmyPosition(null, "w", 1, 64, -1, 0, 0),
+        ArmyState.STATIONARY,
+        30,
+        17,
+        ACCEPTED.minusSeconds(2),
+        ACCEPTED.minusSeconds(1));
+  }
+
+  private static ArmyBattleRequest request(ArmyAuthoritySnapshot image) {
+    var existing = image.battleSessions().get(SESSION);
+    if (existing != null) return existing.request();
+    return new ArmyBattleRequest(
+        SESSION, ACTOR, image.armies().get(ATTACKER), image.armies().get(DEFENDER), ACCEPTED);
+  }
+
+  private static ArmyAuthoritySnapshot started(
+      ArmyAuthoritySnapshot before, ArmyBattleRequest request) {
+    var armies = new HashMap<>(before.armies());
+    armies.put(ATTACKER, request.attackerStarted());
+    armies.put(DEFENDER, request.defenderStarted());
+    return image(
+            before,
+            armies,
+            before.tombstones(),
+            Map.of(SESSION, new ArmyBattleSession(request, null)))
+        .withRevision(before.revision() + 1);
+  }
+
+  private static ArmyBattleSession.Resolution completed(
+      ArmyAuthoritySnapshot pending, boolean attackerDead, boolean defenderDead) {
+    var cancellation = ArmyBattleSession.cancelled(request(pending), DECIDED);
+    return new ArmyBattleSession.Resolution(
+        ArmyBattleSession.Status.COMPLETED,
+        stats(cancellation.attackerAfter(), attackerDead ? 0 : 80, attackerDead ? 0 : 60, 40),
+        stats(cancellation.defenderAfter(), defenderDead ? 0 : 70, defenderDead ? 0 : 50, 30),
+        10,
+        20,
+        DECIDED);
+  }
+
+  private static ArmySnapshot stats(
+      ArmySnapshot original, int soldiers, double health, double morale) {
+    return new ArmySnapshot(
+        original.token(),
+        original.nationId(),
+        original.type(),
+        soldiers,
+        health,
+        morale,
+        original.position(),
+        original.state(),
+        original.supply(),
+        original.supplyConsumptionRemainder(),
+        original.createdAt(),
+        original.lastUpdated());
+  }
+
+  private static ArmyAuthoritySnapshot resolved(
+      ArmyAuthoritySnapshot pending, ArmyBattleSession.Resolution resolution) {
+    var armies = new HashMap<>(pending.armies());
+    var tombstones = new HashMap<>(pending.tombstones());
+    for (var effect : new ArmySnapshot[] {resolution.attackerAfter(), resolution.defenderAfter()}) {
+      UUID armyId = effect.token().armyId();
+      if (effect.isAlive()) {
+        armies.put(armyId, effect);
+      } else {
+        armies.remove(armyId);
+        tombstones.put(
+            armyId,
+            new ArmyTombstone(
+                effect.token(),
+                effect.nationId(),
+                effect.type(),
+                effect.createdAt(),
+                effect.lastUpdated(),
+                "battle-defeated",
+                SESSION));
+      }
+    }
+    return image(
+            pending,
+            armies,
+            tombstones,
+            Map.of(SESSION, new ArmyBattleSession(request(pending), resolution)))
+        .withRevision(pending.revision() + 1);
+  }
+
+  private static ArmyAuthoritySnapshot image(
+      ArmyAuthoritySnapshot source,
+      Map<UUID, ArmySnapshot> armies,
+      Map<UUID, ArmyTombstone> tombstones,
+      Map<UUID, ArmyBattleSession> sessions) {
+    return new ArmyAuthoritySnapshot(
+        true,
+        source.revision(),
+        armies,
+        tombstones,
+        source.receipts(),
+        source.migration(),
+        3,
+        source.paidOperations(),
+        sessions);
+  }
+
+  private static byte[] row(ArmyAuthoritySnapshot image) {
+    return Base64.getDecoder()
+        .decode(ArmyAuthorityCodec.encode(image).getProperty("armyBattle." + SESSION));
+  }
+
+  private static void rejectsRow(ArmyAuthoritySnapshot image, byte[] replacement) {
+    var properties = ArmyAuthorityCodec.encode(image);
+    properties.setProperty(
+        "armyBattle." + SESSION, Base64.getEncoder().encodeToString(replacement));
+    assertThrows(IllegalArgumentException.class, () -> ArmyAuthorityCodec.decode(properties));
+  }
+
+  private static long serializedSize(ArmyAuthoritySnapshot image) {
+    return AbstractArmyAuthorityStorage.serializedEnvelopeSize(
+        ArmyAuthorityCodec.encode(image), Long.MAX_VALUE);
+  }
+}
