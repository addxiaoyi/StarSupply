+    var positiveRequest = resupply(before, supplied(before, 70, ACCEPTED), ACCEPTED);
+    var negativeRequest = resupply(negative, supplied(negative, 70, ACCEPTED), ACCEPTED);
+    var laterRequest =
+        resupply(before, supplied(before, 70, ACCEPTED.plusNanos(1)), ACCEPTED.plusNanos(1));
