+  public synchronized void recoverPendingDisband() {
+    if (context == null || stateStorage == null || territoryService == null) return;
+    requireDisbandAccess();
+    requireLegacyJournalsClear();
+    disbandExecuting = true;
+    try {
+      var coordinator =
+          new NationDisbandCoordinator(
+              stateStorage,
+              this::completeDisbandCleanup,
+              this::applySnapshot,
+              this::prepareDisbandAdmission);
+      federationRecoveryPending = !disbandOperations.isEmpty();
+      for (var op : List.copyOf(disbandOperations.values())) {
+        if (op.state().pending()) coordinator.recover(op.transaction().transactionId());
+        else if (op.state() == NationDisbandOperation.State.COMPLETED) {
+          // Earlier development checkpoints completed seven authorities. The immutable original
+          // request also safely backfills federation receipts without rewriting completed history.
+          completeFederationDisband(op.transaction(), requireFederationRetirementAuthority());
+          for (var nationId : op.transaction().nationIds()) {
+            NationDisbandRecovery.retireArmy(
+                op.transaction(), nationId, requireArmyDisbandAuthority());
+          }
+        }
+      }
+      federationRecoveryPending = false;
+    } finally {
+      finishDisbandAction();
+    }
+  }
