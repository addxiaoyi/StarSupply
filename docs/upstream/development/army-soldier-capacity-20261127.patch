+    storage.saveWar(war);
+    var request = fixture.request(storage, war.id());
+    storage.prepareSettlement(request);
+    var ending = setup.storage();
+    var cancelling = setup.storage();
+    var ready = new CountDownLatch(2);
+    var start = new CountDownLatch(1);
+    var workers = Executors.newFixedThreadPool(2);
+    try {
+      var end =
+          workers.submit(
+              () -> {
+                ready.countDown();
+                if (!start.await(10, TimeUnit.SECONDS))
+                  throw new AssertionError("End gate timed out");
+                try {
+                  return ending.endSettlement(request.operationId(), request.planHash());
+                } catch (RuntimeException failure) {
+                  return failure;
+                }
+              });
+      var cancel =
+          workers.submit(
+              () -> {
+                ready.countDown();
+                if (!start.await(10, TimeUnit.SECONDS))
+                  throw new AssertionError("Cancellation gate timed out");
+                try {
+                  return cancelling.cancelSettlement(request);
+                } catch (RuntimeException failure) {
+                  return failure;
+                }
+              });
+      assertThat(ready.await(10, TimeUnit.SECONDS)).isTrue();
+      start.countDown();
+      Object endResult = end.get(10, TimeUnit.SECONDS);
+      Object cancelResult = cancel.get(10, TimeUnit.SECONDS);
+      var restarted = setup.storage();
+      boolean ended = restarted.settlementEnd(request.operationId()).isPresent();
+      boolean cancelled = restarted.settlementCancellation(request.operationId()).isPresent();
+      assertThat(ended).isNotEqualTo(cancelled);
+      assertThat(endResult instanceof WarStateStorage.SettlementEndResult).isEqualTo(ended);
+      assertThat(cancelResult instanceof CancellationReceipt).isEqualTo(cancelled);
+      assertThat(restarted.loadWar(war.id()).isEnded()).isEqualTo(ended);
+      assertThat(restarted.settlementSnapshot(war.id()).generation())
+          .isEqualTo(request.warGeneration() + (ended ? 1 : 0));
+    } finally {
+      start.countDown();
+      workers.shutdownNow();
+      assertThat(workers.awaitTermination(5, TimeUnit.SECONDS)).isTrue();
+    }
+  }
