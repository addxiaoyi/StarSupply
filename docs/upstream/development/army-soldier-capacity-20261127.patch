@@ -0,0 +1,131 @@
+package dev.starcore.starcore.module.army.runtime;
+
+import dev.starcore.starcore.module.army.model.ArmyUnit;
+import dev.starcore.starcore.module.army.model.authority.ArmyPosition;
+import dev.starcore.starcore.module.army.model.authority.ArmySnapshot;
+import dev.starcore.starcore.module.army.model.authority.ArmyToken;
+import java.util.Objects;
+import java.util.Optional;
+import java.util.UUID;
+import org.bukkit.Location;
+import org.bukkit.World;
+
+public final class ArmySnapshotViews {
+  private ArmySnapshotViews() {}
+
+  public static ArmyUnit toDetachedUnit(
+      ArmySnapshot snapshot, WorldResolver resolver, LegacyWorldPolicy legacyWorldPolicy) {
+    Objects.requireNonNull(snapshot, "snapshot");
+    Objects.requireNonNull(resolver, "resolver");
+    Objects.requireNonNull(legacyWorldPolicy, "legacyWorldPolicy");
+    ArmyPosition position = snapshot.position();
+    World world = resolveWorld(position, resolver, legacyWorldPolicy);
+    Location location =
+        new Location(
+            world, position.x(), position.y(), position.z(), position.yaw(), position.pitch());
+    return new ArmyUnit(
+        snapshot.token().armyId(),
+        snapshot.nationId(),
+        snapshot.type(),
+        snapshot.soldiers(),
+        snapshot.health(),
+        snapshot.morale(),
+        location,
+        snapshot.state(),
+        snapshot.supply(),
+        snapshot.createdAt(),
+        snapshot.lastUpdated(),
+        snapshot.supplyConsumptionRemainder());
+  }
+
+  public static ArmySnapshot fromDetachedUnit(ArmyUnit unit, ArmyToken token) {
+    Objects.requireNonNull(unit, "unit");
+    Objects.requireNonNull(token, "token");
+    ArmyUnit detached = unit.copy();
+    if (!detached.id().equals(token.armyId())) {
+      throw new IllegalArgumentException("Army token belongs to a different army");
+    }
+    if (!detached.isAlive()) {
+      throw new IllegalArgumentException("Cannot capture an inactive army");
+    }
+    Location location = detached.location();
+    World world = location.getWorld();
+    if (world == null) {
+      throw new IllegalArgumentException("Cannot capture an army without a world");
+    }
+    ArmyPosition position =
+        new ArmyPosition(
+            world.getUID(),
+            world.getName(),
+            location.getX(),
+            location.getY(),
+            location.getZ(),
+            location.getYaw(),
+            location.getPitch());
+    return new ArmySnapshot(
+        token,
+        detached.nationId(),
+        detached.type(),
+        detached.soldiers(),
+        detached.health(),
+        detached.morale(),
+        position,
+        detached.state(),
+        detached.supply(),
+        detached.supplyConsumptionRemainder(),
+        detached.createdAt(),
+        detached.lastUpdated());
+  }
+
+  private static World resolveWorld(
+      ArmyPosition position, WorldResolver resolver, LegacyWorldPolicy legacyWorldPolicy) {
+    if (position.worldId() != null) {
+      Optional<World> resolved = resolver.byId(position.worldId());
+      if (resolved != null
+          && resolved.isPresent()
+          && position.worldId().equals(resolved.get().getUID())) {
+        return resolved.get();
+      }
+    } else if (legacyWorldPolicy == LegacyWorldPolicy.BY_EXACT_NAME) {
+      Optional<World> resolved = resolver.byName(position.worldName());
+      if (resolved != null
+          && resolved.isPresent()
+          && position.worldName().equals(resolved.get().getName())) {
+        return resolved.get();
+      }
+    }
+    throw new ArmyWorldUnavailableException(position.worldId(), position.worldName());
+  }
+
+  public interface WorldResolver {
+    Optional<World> byId(UUID worldId);
+
+    Optional<World> byName(String worldName);
+  }
+
+  public enum LegacyWorldPolicy {
+    REJECT_NAME_ONLY,
+    BY_EXACT_NAME
+  }
+
+  public static final class ArmyWorldUnavailableException extends IllegalStateException {
+    private static final long serialVersionUID = 1L;
+
+    private final UUID worldId;
+    private final String worldName;
+
+    public ArmyWorldUnavailableException(UUID worldId, String worldName) {
+      super("Army world is unavailable (id=" + worldId + ", name=" + worldName + ")");
+      this.worldId = worldId;
+      this.worldName = worldName;
+    }
+
+    public UUID worldId() {
+      return worldId;
+    }
+
+    public String worldName() {
+      return worldName;
+    }
+  }
+}
