+              f.nation.founderId(),
+              f.nation.id().value(),
+              SkillType.REINFORCE,
+              1,
+              1,
+              null,
+              ArmyRuntimeTestFixture.START,
+              null,
+              Map.of(army.token().armyId(), army),
+              110);
+      f.owner.useSkill(skill);
+      var image = f.owner.snapshot();
+      var encoded = ArmyAuthorityCodec.encode(image);
+      String key = "armySkill." + skill.operationId();
+      var bytes = Base64.getDecoder().decode(encoded.getProperty(key));
+      assertEquals(11, bytes[5]);
+      assertEquals(image, ArmyAuthorityCodec.decode(encoded));
+      assertEquals(encoded, ArmyAuthorityCodec.encodeWithRowBudget(image, bytes.length));
+      assertThrows(
+          IllegalArgumentException.class,
+          () -> ArmyAuthorityCodec.encodeWithRowBudget(image, bytes.length - 1));
+      // Header + three UUIDs + length-prefixed skill name + level/rules = quota offset.
+      int offset = 6 + 48 + 4 + skill.skillType().name().length() + 8;
+      java.nio.ByteBuffer.wrap(bytes).putLong(offset, Long.MAX_VALUE);
+      encoded.setProperty(key, Base64.getEncoder().encodeToString(bytes));
+      assertThrows(IllegalArgumentException.class, () -> ArmyAuthorityCodec.decode(encoded));
+      var downgraded = ArmyAuthorityCodec.encode(image);
+      downgraded.setProperty(ArmyAuthorityCodec.VERSION, "6");
+      assertThrows(IllegalArgumentException.class, () -> ArmyAuthorityCodec.decode(downgraded));
