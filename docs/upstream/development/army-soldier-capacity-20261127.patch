+  @Override
+  public OperationView reserveTreaty(ReserveRequest request) {
+    Objects.requireNonNull(request);
+    return withAllianceAuthority(
+        activeLifecycle -> {
+          var existing = existingTreaty(request);
+          if (existing != null) return existing;
+          if (request.protocolVersion() == TreatyEffectManifest.VERSION)
+            requireTreatyEffectProofPersistence(activeLifecycle);
+          Plan plan;
+          try {
+            plan = freezeTreatyPlan(request);
+            DiplomacyTreatyCapacity.requireCompletable(plan);
+          } catch (IllegalArgumentException unsupported) {
+            return storeTreaty(
+                new OperationView(request, null, Status.REJECTED, timingPolicy.now()),
+                activeLifecycle);
+          }
+          for (var pair : plan.pairs())
+            if (retirements.containsKey(pair.pair().left())
+                || retirements.containsKey(pair.pair().right()))
+              return storeTreaty(
+                  new OperationView(request, plan, Status.SUPERSEDED, timingPolicy.now()),
+                  activeLifecycle);
+          var principal = DiplomacyPairKey.of(request.war().attacker(), request.war().defender());
+          var originalEntry = warMirror.receipts().get(request.war().warId());
+          if (!request.war().warId().equals(warMirror.owners().get(principal))
+              || originalEntry == null
+              || !originalEntry.active()
+              || !DiplomacyTreatyOperationState.exactEntry(request.war(), originalEntry))
+            return storeTreaty(
+                new OperationView(request, plan, Status.SUPERSEDED, timingPolicy.now()),
+                activeLifecycle);
+          for (var pairPlan : plan.pairs()) {
+            var pair = DiplomacyPairKey.of(pairPlan.pair().left(), pairPlan.pair().right());
+            if (!pair.equals(principal)
+                && (warMirror.owners().containsKey(pair)
+                    || warRecords.containsKey(pair)
+                    || pairPlan.expectedRelation() == DiplomacyRelation.WAR))
