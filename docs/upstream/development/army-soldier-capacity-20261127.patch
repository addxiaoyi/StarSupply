@@ -0,0 +1,44 @@
+package dev.starcore.starcore.module.army.model.authority;
+
+import java.util.Objects;
+import java.util.UUID;
+
+/** Counts current soldiers and already accepted creation obligations without double counting. */
+public record ArmySoldierCapacity(long live, long reserved, long maximum) {
+  public ArmySoldierCapacity {
+    if (live < 0 || reserved < 0 || maximum < 0)
+      throw new IllegalArgumentException("Army soldier capacity cannot be negative");
+    Math.addExact(live, reserved);
+  }
+
+  public long committed() {
+    return Math.addExact(live, reserved);
+  }
+
+  public long available() {
+    return Math.max(0, maximum - committed());
+  }
+
+  public void requireGrowth(long soldiers) {
+    if (soldiers < 0 || soldiers > available())
+      throw new IllegalArgumentException("Army total soldier quota exceeded");
+  }
+
+  public static ArmySoldierCapacity of(ArmyAuthoritySnapshot image, UUID nationId, long maximum) {
+    Objects.requireNonNull(image);
+    Objects.requireNonNull(nationId);
+    long live = 0, reserved = 0;
+    for (var army : image.armies().values())
+      if (army.nationId().equals(nationId)) live = Math.addExact(live, army.soldiers());
+    for (var operation : image.paidOperations().values()) {
+      var request = operation.request();
+      if (operation.pending()
+          && request.kind() == ArmyPaidRequest.Kind.CREATE
+          && request.nationId().equals(nationId)) {
+        reserved = Math.addExact(reserved, request.after().soldiers());
+        maximum = Math.min(maximum, request.maximumNationSoldiers());
+      }
+    }
+    return new ArmySoldierCapacity(live, reserved, maximum);
+  }
+}
