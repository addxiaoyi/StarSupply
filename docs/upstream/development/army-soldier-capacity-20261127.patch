+  @Test
+  void sourceQuotaSurvivesNativeReleaseAndCoversEndedAndAcknowledgedSnapshots() throws Exception {
+    var batch = batch();
+    var end = end(batch);
+    var terminal =
+        new OperationView(
+            batch.request(),
