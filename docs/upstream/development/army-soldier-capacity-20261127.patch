+  void lostAcknowledgementsRecoverTheAlreadyCommittedClosureAndExactRetirement(boolean sqlite)
+      throws Exception {
+    initialize(sqlite);
+    var delegate = storage(sqlite);
+    var uncertain = mock(ArmyAuthorityStorage.class, delegatesTo(delegate));
+    var failNext = new AtomicBoolean(true);
+    doAnswer(
+            invocation -> {
+              var committed = delegate.commit(invocation.getArgument(0), invocation.getArgument(1));
+              if (failNext.compareAndSet(true, false)) {
+                throw new IllegalStateException("lost closure acknowledgement");
+              }
+              return committed;
+            })
+        .when(uncertain)
+        .commit(any(), any());
+    var owner = new ArmyAuthorityOwner(uncertain);
+    owner.refresh();
+    assertRejected(() -> owner.beginNationClosure(CLOSURE, NATION, CLOSED));
+    assertTrue(reopen(sqlite).nationClosure(NATION).orElseThrow().pending());
+    owner.refresh();
+    var pending = owner.beginNationClosure(CLOSURE, NATION, CLOSED);
+    assertTrue(pending.pending());
+    failNext.set(true);
+    assertRejected(() -> owner.retireNation(CLOSURE, NATION, RETIRED));
+    var restarted = reopen(sqlite);
+    var terminal = restarted.nationClosure(NATION).orElseThrow();
+    assertFalse(terminal.pending());
+    assertEquals(terminal, restarted.retireNation(CLOSURE, NATION, RETIRED.plusSeconds(1)));
+    owner.refresh();
+    assertEquals(restarted.snapshot(), owner.snapshot());
+  }
