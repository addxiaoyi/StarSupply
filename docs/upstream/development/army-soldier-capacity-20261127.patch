+
+class ArmyCommanderRuntimeTest {
+  @TempDir Path root;
+
+  private CommanderServiceImpl commander(ArmyRuntimeTestFixture f, UUID... actors) {
+    var persistence = mock(PersistenceService.class);
+    Properties stored = new Properties();
+    for (UUID actor : actors) {
+      String data = "exp=1000;updated=1795773600000;";
+      for (var skill : SkillType.values()) data += skill.name() + "=3;";
+      stored.setProperty(actor.toString(), data);
+    }
+    when(persistence.loadProperties(anyString(), anyString())).thenReturn(stored);
+    var messages =
+        mock(
+            MessageService.class,
+            call -> {
+              if (call.getMethod().getName().equals("format")) return call.getArgument(0);
+              return RETURNS_DEFAULTS.answer(call);
+            });
+    return new CommanderServiceImpl(
+        f.plugin, f.nations, f.service, messages, CommanderConfig.defaults(), persistence);
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void acceptedSkillPersistsEffectAndExactCooldownAcrossRestart(boolean sql) throws Exception {
+    try (var f = new ArmyRuntimeTestFixture(root, sql)) {
+      var army = f.add();
+      var commander = commander(f, f.nation.founderId());
+      var player = f.player(f.nation);
+      commander.useSkill(player, SkillType.INSPIRE, null);
+      assertEquals(100, f.current(army.token().armyId()).morale());
+      assertEquals(60, commander.getSkillCooldown(player.getUniqueId(), SkillType.INSPIRE));
+      var before = f.owner.snapshot();
+      commander.useSkill(player, SkillType.INSPIRE, null);
+      assertEquals(before, f.owner.snapshot());
+      f.service.shutdown();
+      f.open(false);
+      var restarted = commander(f, f.nation.founderId());
+      assertEquals(60, restarted.getSkillCooldown(player.getUniqueId(), SkillType.INSPIRE));
+      f.clock.at = f.clock.at.plusSeconds(60);
+      assertEquals(0, restarted.getSkillCooldown(player.getUniqueId(), SkillType.INSPIRE));
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void invalidFriendlyTargetDoesNotApplyOrConsumeCooldown(boolean sql) throws Exception {
+    try (var f = new ArmyRuntimeTestFixture(root, sql)) {
+      f.add();
+      var enemy = f.add(f.other, 100, 100, 75, 40);
+      var commander = commander(f, f.nation.founderId());
+      var player = f.player(f.nation);
+      var before = f.owner.snapshot();
+      assertThrows(
+          IllegalArgumentException.class,
+          () -> commander.useSkill(player, SkillType.REINFORCE, enemy.token().armyId()));
+      assertThrows(
+          IllegalArgumentException.class,
+          () -> commander.useSkill(player, SkillType.REINFORCE, null));
+      assertEquals(0, commander.getSkillCooldown(player.getUniqueId(), SkillType.REINFORCE));
+      assertEquals(before, f.owner.snapshot());
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void chargingRequiresCurrentHostilityAndReinforcementRespectsArmyLimit(boolean sql)
+      throws Exception {
+    try (var f = new ArmyRuntimeTestFixture(root, sql)) {
+      var army = f.add(f.nation, 990, 100, 75, 40);
+      var enemy = f.add(f.other, 100, 100, 75, 40);
+      var commander = commander(f, f.nation.founderId());
+      var player = f.player(f.nation);
+      f.hostile = false;
+      assertThrows(
+          IllegalStateException.class,
+          () -> commander.useSkill(player, SkillType.CAVALRY_CHARGE, enemy.token().armyId()));
+      assertThrows(
+          IllegalStateException.class,
+          () -> commander.useSkill(player, SkillType.REINFORCE, army.token().armyId()));
+      assertTrue(f.owner.snapshot().skillUses().isEmpty());
+      assertEquals(enemy, f.current(enemy.token().armyId()));
+    }
+  }
