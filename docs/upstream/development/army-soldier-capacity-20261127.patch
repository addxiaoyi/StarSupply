+      InventoryDragEvent reopenedDrag = drag(player, current.get());
+      listener.onInventoryDrag(reopenedDrag);
+      verify(reopenedDrag).setCancelled(true);
+      InventoryClickEvent statistics = click(player, current.get(), 49, Material.BOOK);
+      listener.onInventoryClick(statistics);
+      verify(statistics).setCancelled(true);
+      assertThat(gui.getMode()).isEqualTo(WarehouseGUI.GUIMode.PERMISSION_STATS);
+      InventoryDragEvent statisticsDrag = drag(player, current.get());
+      listener.onInventoryDrag(statisticsDrag);
+      verify(statisticsDrag).setCancelled(true);
+    }
