@@ -0,0 +1,19 @@
+package dev.starcore.starcore.module.army.model.authority;
+
+import java.util.Objects;
+import java.util.UUID;
+
+public record ArmyPosition(
+    UUID worldId, String worldName, double x, double y, double z, float yaw, float pitch) {
+  public ArmyPosition {
+    Objects.requireNonNull(worldName, "worldName");
+    if (worldName.isBlank()) throw new IllegalArgumentException("World name must not be blank");
+    if (!Double.isFinite(x)
+        || !Double.isFinite(y)
+        || !Double.isFinite(z)
+        || !Float.isFinite(yaw)
+        || !Float.isFinite(pitch)) {
+      throw new IllegalArgumentException("Army position must be finite");
+    }
+  }
+}
diff --git a/src/main/java/dev/starcore/starcore/module/army/model/authority/ArmySkillRequest.java b/src/main/java/dev/starcore/starcore/module/army/model/authority/ArmySkillRequest.java
new file mode 100644
index 0000000000000000000000000000000000000000..08ae61db2e978238ad05a5a44395937fdf4e411e
--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/module/army/model/authority/ArmySkillRequest.java
@@ -0,0 +1,246 @@
+package dev.starcore.starcore.module.army.model.authority;
+
+import dev.starcore.starcore.module.army.commander.model.SkillType;
+import dev.starcore.starcore.module.army.model.ArmyState;
+import java.time.DateTimeException;
+import java.time.Instant;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.Objects;
+import java.util.UUID;
+
+public record ArmySkillRequest(
+    UUID operationId,
+    UUID actorId,
+    UUID nationId,
+    SkillType skillType,
+    int level,
+    int rulesVersion,
+    UUID previousUseId,
+    Instant acceptedAt,
+    ArmyPosition origin,
+    Map<UUID, ArmySnapshot> targets,
+    long maximumNationSoldiers) {
+  public ArmySkillRequest(
+      UUID operationId,
+      UUID actorId,
+      UUID nationId,
+      SkillType skillType,
+      int level,
+      int rulesVersion,
+      UUID previousUseId,
+      Instant acceptedAt,
+      ArmyPosition origin,
+      Map<UUID, ArmySnapshot> targets) {
+    this(
+        operationId,
+        actorId,
+        nationId,
+        skillType,
+        level,
+        rulesVersion,
+        previousUseId,
+        acceptedAt,
+        origin,
+        targets,
+        Long.MAX_VALUE);
+  }
+
+  public ArmySkillRequest {
+    Objects.requireNonNull(operationId, "operationId");
+    Objects.requireNonNull(actorId, "actorId");
+    Objects.requireNonNull(nationId, "nationId");
+    Objects.requireNonNull(skillType, "skillType");
+    Objects.requireNonNull(acceptedAt, "acceptedAt");
+    targets = Map.copyOf(Objects.requireNonNull(targets, "targets"));
+    if (maximumNationSoldiers < 0)
+      throw new IllegalArgumentException("Army skill soldier quota cannot be negative");
+    if (rulesVersion != 1) throw new IllegalArgumentException("Unsupported skill rules version");
+    if (level < 1 || level > 3)
+      throw new IllegalArgumentException("Skill level must be 1 through 3");
+    if (operationId.equals(previousUseId)) {
+      throw new IllegalArgumentException("A skill use cannot precede itself");
+    }
+    if (!acceptedAt.isAfter(Instant.EPOCH)) {
+      throw new IllegalArgumentException("Skill acceptance time must be after the epoch");
+    }
+    if (usesOrigin(skillType)) {
+      Objects.requireNonNull(origin, "origin");
+      if (origin.worldId() == null) {
+        throw new IllegalArgumentException("Range skills require an identified origin world");
+      }
+    } else if (origin != null) {
+      throw new IllegalArgumentException("This skill does not use a spatial origin");
+    }
+    if (singleTarget(skillType) && targets.size() != 1) {
+      throw new IllegalArgumentException("This skill requires exactly one target");
+    }
+    deadline(acceptedAt, skillType);
+    for (var entry : targets.entrySet()) {
+      var before = entry.getValue();
+      if (!entry.getKey().equals(before.token().armyId())) {
+        throw new IllegalArgumentException("Skill target key does not match its army");
+      }
+      if (!before.isAlive()) throw new IllegalArgumentException("Skill targets must be alive");
+      boolean sameNation = nationId.equals(before.nationId());
+      if (skillType == SkillType.CAVALRY_CHARGE
+          ? sameNation
+          : skillType != SkillType.SCOUT && !sameNation) {
+        throw new IllegalArgumentException("Skill target has an incompatible nation");
+      }
+      if (acceptedAt.isBefore(before.createdAt()) || acceptedAt.isBefore(before.lastUpdated())) {
+        throw new IllegalArgumentException("Skill acceptance precedes a target snapshot");
+      }
+      if (skillType != SkillType.SCOUT && before.token().generation() == Long.MAX_VALUE) {
+        throw new IllegalArgumentException("Skill target has no generation headroom");
+      }
+      if (usesOrigin(skillType) && !withinRange(origin, before.position(), skillType, level)) {
+        throw new IllegalArgumentException("Skill target is outside the selected range");
+      }
+      if (skillType == SkillType.REINFORCE) {
+        try {
+          if (Math.addExact(before.soldiers(), Math.multiplyExact(10, level))
+              > maximumNationSoldiers)
+            throw new IllegalArgumentException(
+                "Skill reinforcement exceeds its total soldier quota");
+        } catch (ArithmeticException overflow) {
+          throw new IllegalArgumentException(
+              "Skill reinforcement exceeds the soldier limit", overflow);
+        }
+      }
+    }
+  }
+
+  public Instant readyAt() {
+    return deadline(acceptedAt, skillType);
+  }
+
+  public Map<UUID, ArmySnapshot> effects() {
+    if (skillType == SkillType.SCOUT) return Map.of();
+    Map<UUID, ArmySnapshot> effects = new HashMap<>();
+    targets.forEach((armyId, before) -> effects.put(armyId, effect(before)));
+    return Map.copyOf(effects);
+  }
+
+  public void requireSelection(Map<UUID, ArmySnapshot> current) {
+    Objects.requireNonNull(current, "current");
+    if (singleTarget(skillType)) {
+      var entry = targets.entrySet().iterator().next();
+      if (!entry.getValue().equals(current.get(entry.getKey()))) {
+        throw new IllegalArgumentException("Skill target no longer matches its selected snapshot");
+      }
+      return;
+    }
+    Map<UUID, ArmySnapshot> selected = new HashMap<>();
+    for (var entry : current.entrySet()) {
+      var before = Objects.requireNonNull(entry.getValue(), "current target");
+      if (!Objects.requireNonNull(entry.getKey(), "current army ID")
+          .equals(before.token().armyId())) {
+        throw new IllegalArgumentException("Current army key does not match its snapshot");
+      }
+      if (skillType != SkillType.SCOUT && !nationId.equals(before.nationId())) continue;
+      if (!usesOrigin(skillType) || withinRange(origin, before.position(), skillType, level)) {
+        selected.put(entry.getKey(), before);
+      }
+    }
+    if (!targets.equals(selected)) {
+      throw new IllegalArgumentException(
+          "Skill targets do not match the complete current selection");
+    }
+  }
+
+  private ArmySnapshot effect(ArmySnapshot before) {
+    int soldiers = before.soldiers();
+    double health = before.health();
+    double morale = before.morale();
+    int supply = before.supply();
+    ArmyState state = before.state();
+    switch (skillType) {
+      case RALLY -> morale = clamp(morale + 5 * level);
+      case INSPIRE, PHALANX -> morale = clamp(morale + 10 * level);
+      case REINFORCE -> soldiers = Math.addExact(soldiers, Math.multiplyExact(10, level));
+      case TACTICAL_RETREAT -> {
+        state = ArmyState.MARCHING;
+        health = clamp(health + 20 * level);
+        morale = clamp(morale + 5 * level);
+      }
+      case SIEGE_MASTERY, MORALE_BOOST -> morale = clamp(morale + 15 * level);
+      case CAVALRY_CHARGE -> {
+        double maximumHealth = (double) soldiers * before.type().baseHealth();
+        double damage = maximumHealth * (0.1 * level);
+        double totalHealth = maximumHealth * (health / 100.0);
+        totalHealth -= damage;
+        if (totalHealth <= 0) {
+          soldiers = 0;
+          health = 0;
+        } else {
+          double healthPerSoldier = before.type().baseHealth();
+          soldiers = (int) Math.ceil(totalHealth / healthPerSoldier);
+          health = clamp((totalHealth / (soldiers * healthPerSoldier)) * 100.0);
+        }
+      }
+      case SUPPLY_LINE -> supply = Math.max(0, Math.min(100, supply + 25 * level));
+      case SCOUT -> throw new IllegalStateException("Scouting has no army mutation");
+    }
+    return new ArmySnapshot(
+        new ArmyToken(
+            before.token().armyId(), before.token().incarnation(), before.token().generation() + 1),
+        before.nationId(),
+        before.type(),
+        soldiers,
+        health,
+        morale,
+        before.position(),
+        state,
+        supply,
+        before.supplyConsumptionRemainder(),
+        before.createdAt(),
+        acceptedAt);
+  }
+
+  private static Instant deadline(Instant acceptedAt, SkillType skillType) {
+    long millis =
+        switch (skillType) {
+          case RALLY, CAVALRY_CHARGE -> 90_000L;
+          case INSPIRE, PHALANX -> 60_000L;
+          case REINFORCE, MORALE_BOOST -> 30_000L;
+          case TACTICAL_RETREAT, SUPPLY_LINE -> 45_000L;
+          case SIEGE_MASTERY -> 75_000L;
+          case SCOUT -> 15_000L;
+        };
+    try {
+      return acceptedAt.plusMillis(millis);
+    } catch (DateTimeException | ArithmeticException overflow) {
+      throw new IllegalArgumentException(
+          "Skill cooldown deadline exceeds the supported time range", overflow);
+    }
+  }
+
+  private static boolean singleTarget(SkillType skillType) {
+    return switch (skillType) {
+      case REINFORCE, TACTICAL_RETREAT, SIEGE_MASTERY, CAVALRY_CHARGE, PHALANX -> true;
+      default -> false;
+    };
+  }
+
+  private static boolean usesOrigin(SkillType skillType) {
+    return skillType == SkillType.RALLY || skillType == SkillType.SCOUT;
+  }
+
+  private static boolean withinRange(
+      ArmyPosition origin, ArmyPosition target, SkillType skillType, int level) {
+    if (target.worldId() == null) {
+      throw new IllegalArgumentException("A range candidate has no identified world");
+    }
+    if (!origin.worldId().equals(target.worldId())) return false;
+    double radius = skillType == SkillType.RALLY ? 50 + 10 * level : 200 + 100 * level;
+    double deltaX = origin.x() - target.x();
+    double deltaY = origin.y() - target.y();
+    double deltaZ = origin.z() - target.z();
+    return deltaX * deltaX + deltaY * deltaY + deltaZ * deltaZ <= radius * radius;
+  }
+
+  private static double clamp(double value) {
+    return Math.max(0, Math.min(100, value));
+  }
+}
diff --git a/src/main/java/dev/starcore/starcore/module/army/model/authority/ArmySkillUse.java b/src/main/java/dev/starcore/starcore/module/army/model/authority/ArmySkillUse.java
new file mode 100644
