index 0000000000000000000000000000000000000000..f550d3a7cdc8796c7dc9441fc98254597fb7863e
--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/module/diplomacy/alliance/AllianceOperationIntent.java
@@ -0,0 +1,128 @@
+package dev.starcore.starcore.module.diplomacy.alliance;
+
+import dev.starcore.starcore.module.diplomacy.DiplomacyAllianceOperationService.Action;
+import dev.starcore.starcore.module.diplomacy.DiplomacyAllianceOperationService.Outcome;
+import dev.starcore.starcore.module.diplomacy.DiplomacyAllianceOperationService.Receipt;
+import dev.starcore.starcore.module.diplomacy.DiplomacyAllianceOperationService.Request;
+import java.time.Instant;
+import java.util.Objects;
+import java.util.UUID;
+
+public record AllianceOperationIntent(
+    Request request,
+    Source source,
+    AllianceInviteKey originalInvite,
+    Instant originalInviteAt,
+    AllianceInfoData originalAlliance,
+    AllianceInfoData proposedAlliance,
+    Instant originalCooldown,
+    Instant proposedCooldown,
+    boolean cancellationRequested,
+    AllianceRecoveryService.Status status,
+    Outcome outcome,
+    long receiptGeneration) {
+  public enum Source {
+    ACCEPT_INVITE,
+    CREATE_ALLIANCE,
+    BREAK_ALLIANCE
+  }
+
+  public AllianceOperationIntent {
+    Objects.requireNonNull(request);
+    Objects.requireNonNull(source);
+    Objects.requireNonNull(status);
+    if ((originalInvite == null) != (originalInviteAt == null))
+      throw new IllegalArgumentException("Incomplete original alliance invitation");
+    if (source == Source.ACCEPT_INVITE) {
+      if (originalInvite == null
+          || !pair(request)
+              .equals(AlliancePairKey.of(originalInvite.inviter(), originalInvite.invited()))
+          || !request.actor().equals(originalInvite.invited()))
+        throw new IllegalArgumentException("Invalid accepted alliance invitation");
+    } else if (originalInvite != null) {
+      throw new IllegalArgumentException("Unexpected alliance invitation payload");
+    }
+    if (request.action() == Action.FORM) {
+      if (source == Source.BREAK_ALLIANCE || proposedAlliance == null)
+        throw new IllegalArgumentException("Invalid alliance formation intent");
+    } else if (source != Source.BREAK_ALLIANCE
+        || originalAlliance == null
+        || proposedAlliance != null
+        || proposedCooldown == null) {
+      throw new IllegalArgumentException("Invalid alliance break intent");
+    }
+    if (originalAlliance != null
+        && !pair(request)
+            .equals(AlliancePairKey.of(originalAlliance.nation1(), originalAlliance.nation2())))
+      throw new IllegalArgumentException("Original alliance pair mismatch");
+    if (proposedAlliance != null
+        && !pair(request)
+            .equals(AlliancePairKey.of(proposedAlliance.nation1(), proposedAlliance.nation2())))
+      throw new IllegalArgumentException("Proposed alliance pair mismatch");
+    if (status == AllianceRecoveryService.Status.PREPARED) {
+      if (outcome != null || receiptGeneration != -1)
+        throw new IllegalArgumentException("Prepared alliance intent has a terminal receipt");
+    } else if (outcome == null || receiptGeneration < 0) {
+      throw new IllegalArgumentException("Acknowledged alliance intent lacks a receipt");
+    }
+  }
+
+  public UUID operationId() {
+    return request.operationId();
+  }
+
+  public AlliancePairKey pair() {
+    return pair(request);
+  }
+
+  private static AlliancePairKey pair(Request request) {
+    return AlliancePairKey.of(request.left(), request.right());
+  }
+
+  public boolean samePayload(AllianceOperationIntent other) {
+    return other != null
+        && request.equals(other.request)
+        && source == other.source
+        && Objects.equals(originalInvite, other.originalInvite)
+        && Objects.equals(originalInviteAt, other.originalInviteAt)
+        && Objects.equals(originalAlliance, other.originalAlliance)
+        && Objects.equals(proposedAlliance, other.proposedAlliance)
+        && Objects.equals(originalCooldown, other.originalCooldown)
+        && Objects.equals(proposedCooldown, other.proposedCooldown);
+  }
+
+  public AllianceOperationIntent requestCancellation() {
+    if (status == AllianceRecoveryService.Status.ACKNOWLEDGED || cancellationRequested) return this;
+    return new AllianceOperationIntent(
+        request,
+        source,
+        originalInvite,
+        originalInviteAt,
+        originalAlliance,
+        proposedAlliance,
+        originalCooldown,
+        proposedCooldown,
+        true,
+        status,
+        outcome,
+        receiptGeneration);
+  }
+
+  public AllianceOperationIntent acknowledge(Receipt receipt) {
+    if (!request.equals(receipt.request()))
+      throw new IllegalArgumentException("Alliance receiver receipt payload mismatch");
+    return new AllianceOperationIntent(
+        request,
+        source,
+        originalInvite,
+        originalInviteAt,
+        originalAlliance,
+        proposedAlliance,
+        originalCooldown,
+        proposedCooldown,
+        cancellationRequested,
+        AllianceRecoveryService.Status.ACKNOWLEDGED,
+        receipt.outcome(),
+        receipt.generation());
+  }
+}
