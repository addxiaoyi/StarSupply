+  private ArmyAuthorityOwner initializeCapacityOwner(boolean sqlite, Path path, long maximum)
+      throws Exception {
+    var source = capacityStorage(sqlite, path, maximum);
+    source.initializeFromLegacy(capacityImport());
+    var owner = new ArmyAuthorityOwner(source);
+    owner.refresh();
+    owner.create(army(ATTACKER, ATTACKER_NATION, ArmyType.INFANTRY));
+    owner.create(army(DEFENDER, DEFENDER_NATION, ArmyType.INFANTRY));
+    assertEquals(capacityBaseline(), owner.snapshot());
+    return owner;
+  }
+
+  private ArmyAuthorityStorage capacityStorage(boolean sqlite, Path path, long maximum)
+      throws Exception {
+    Files.createDirectories(path);
+    if (!sqlite) return new ArmyFileAuthorityStorage(path.resolve("authority"), maximum);
+    DataSource source = mock(DataSource.class);
+    when(source.getConnection())
+        .thenAnswer(call -> DriverManager.getConnection("jdbc:sqlite:" + path.resolve("army.db")));
+    return new ArmySqlAuthorityStorage(path.resolve("authority"), source, maximum);
+  }
+
+  private static ArmyBattleSession.Resolution completedAt(
+      ArmyAuthoritySnapshot pending,
+      boolean attackerDead,
+      boolean defenderDead,
+      Instant decidedAt) {
+    var cancellation = ArmyBattleSession.cancelled(request(pending), decidedAt);
+    return new ArmyBattleSession.Resolution(
+        ArmyBattleSession.Status.COMPLETED,
+        stats(cancellation.attackerAfter(), attackerDead ? 0 : 80, attackerDead ? 0 : 60, 40),
+        stats(cancellation.defenderAfter(), defenderDead ? 0 : 70, defenderDead ? 0 : 50, 30),
+        Double.MAX_VALUE,
+        Double.MAX_VALUE,
+        decidedAt);
+  }
