+  void blockedConsumerAllowsDisableButCannotAcknowledgeOrReenableAcrossLifecycle()
+      throws Exception {
+    try (var fixture = new DiplomacyRetirementTestFixture(root, false)) {
+      var module = fixture.open();
+      module.setRelation(left, right, DiplomacyRelation.ALLIED);
+      var original = pending(fixture).pending().values().iterator().next();
+      var entered = new CountDownLatch(1);
+      var releaseConsumer = new CountDownLatch(1);
+      var consumer = mock(EventService.class);
+      when(consumer.recordAllianceOnce(any(), any(), any(), anyBoolean(), any()))
+          .thenAnswer(
+              invocation -> {
+                assertThat(Thread.holdsLock(module)).isFalse();
+                entered.countDown();
+                if (!releaseConsumer.await(5, TimeUnit.SECONDS))
+                  throw new IllegalStateException("timed out waiting to finish consumer");
+                return true;
+              });
+      var context = attach(module, consumer);
+      var bus = new StarCoreEventBus(Logger.getAnonymousLogger());
+      var delivered = new ArrayList<AllianceFormedEvent>();
+      bus.subscribe(AllianceFormedEvent.class, delivered::add);
+      DiplomacyRetirementTestFixture.field(module, "eventBus", bus);
+      var executor = Executors.newFixedThreadPool(2);
+      try {
+        var retry = executor.submit(module::retryPendingDerivedEvents);
+        assertThat(entered.await(5, TimeUnit.SECONDS)).isTrue();
+        executor.submit(() -> module.disable(context)).get(5, TimeUnit.SECONDS);
+        assertThatThrownBy(() -> module.enable(context))
+            .hasMessageContaining("previous operation still running");
+        releaseConsumer.countDown();
+        assertThat(retry.get(5, TimeUnit.SECONDS)).isZero();
+        assertThat(delivered).isEmpty();
+        assertThat(pending(fixture).pending()).containsEntry(original.eventId(), original);
+      } finally {
+        releaseConsumer.countDown();
+        executor.shutdownNow();
+        assertThat(executor.awaitTermination(5, TimeUnit.SECONDS)).isTrue();
+      }
+    }
+  }
