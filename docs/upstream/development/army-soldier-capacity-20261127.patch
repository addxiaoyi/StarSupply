+  private static NationDebitService.Request conflictingRequest(
+      NationDebitService.Request expected, int field) {
+    return switch (field) {
+      case 0 ->
+          new NationDebitService.Request(
+              OTHER_OPERATION_ID, expected.nationId(), expected.amount(), expected.purpose());
+      case 1 ->
+          new NationDebitService.Request(
+              expected.operationId(),
+              new NationId(OTHER_ID),
+              expected.amount(),
+              expected.purpose());
+      case 2 ->
+          new NationDebitService.Request(
+              expected.operationId(),
+              expected.nationId(),
+              expected.amount().add(BigDecimal.ONE),
+              expected.purpose());
+      case 3 ->
+          new NationDebitService.Request(
+              expected.operationId(),
+              expected.nationId(),
+              expected.amount(),
+              expected.purpose() + ":conflict");
+      default -> throw new IllegalArgumentException("Unknown debit request field");
+    };
