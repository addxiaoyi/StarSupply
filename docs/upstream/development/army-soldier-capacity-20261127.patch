+import dev.starcore.starcore.module.army.storage.authority.ArmyLegacyImporter;
+import java.time.Instant;
+import java.util.Map;
+import java.util.UUID;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+
+class ArmyAuthorityOwnerTest {
+  private static final UUID ARMY_ID = new UUID(0, 1);
+  private static final UUID OTHER_ID = new UUID(0, 2);
+  private static final UUID NATION_ID = new UUID(0, 3);
+  private static final UUID REQUEST_ID = new UUID(0, 4);
+  private static final Instant CREATED = Instant.parse("2026-11-27T00:00:00.123456789Z");
+  private static final Instant UPDATED = Instant.parse("2026-11-27T00:01:00.987654321Z");
+
+  @Test
+  void constructionAndUninitializedLoadNeverExposeAnEmptyReadyAuthority() {
+    var storage = new TestStorage(ArmyAuthoritySnapshot.uninitialized());
+    var owner = new ArmyAuthorityOwner(storage);
+
+    assertFalse(owner.isReady());
+    assertEquals(0, storage.loads);
+    assertUnavailable(owner);
+    assertThrows(IllegalStateException.class, owner::refresh);
+    assertUnavailable(owner);
+    assertEquals(1, storage.loads);
+    assertEquals(0, storage.commits);
+    assertEquals(0, storage.initializations);
+  }
+
+  @Test
+  void explicitlyInitializedEmptyImageIsAReadyEmptyResult() {
+    var storage = new TestStorage(image(1, Map.of(), Map.of(), Map.of()));
+    var owner = open(storage);
+
+    assertTrue(owner.isReady());
+    assertTrue(owner.army(ARMY_ID).isEmpty());
+    assertTrue(owner.nationArmies(NATION_ID).isEmpty());
+    assertTrue(owner.receipt(REQUEST_ID).isEmpty());
+  }
+
+  @Test
+  void closingPermanentlyFencesAnOldOwnerWithoutStorageWrites() {
+    var storage = new TestStorage(live(army(ARMY_ID, 1)));
+    var owner = open(storage);
+
+    owner.close();
+    owner.close();
+
+    assertUnavailable(owner);
+    assertThrows(IllegalStateException.class, owner::refresh);
+    assertThrows(IllegalStateException.class, () -> owner.create(army(OTHER_ID, 1)));
+    assertEquals(1, storage.loads);
+    assertEquals(0, storage.commits);
+  }
+
+  @Test
+  void successfulCreatePublishesOnlyTheConfirmedImageAndKeepsOldViewsImmutable() {
+    var storage = new TestStorage(image(1, Map.of(), Map.of(), Map.of()));
+    var owner = open(storage);
+    var original = owner.snapshot();
+    var candidate = army(ARMY_ID, 1);
+    storage.commitHook = () -> assertUnavailable(owner);
+
+    var result = owner.create(candidate);
+
+    assertSame(storage.durable, result);
+    assertEquals(candidate, owner.army(ARMY_ID).orElseThrow());
+    assertEquals(2, result.revision());
+    assertTrue(original.armies().isEmpty());
+    assertThrows(UnsupportedOperationException.class, () -> result.armies().clear());
+    assertThrows(UnsupportedOperationException.class, () -> owner.nationArmies(NATION_ID).clear());
+    assertEquals(1, storage.commits);
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void failedOrUncertainCommitClosesEveryReadAndWriteUntilAnExplicitRefresh(boolean durable) {
+    var before = army(ARMY_ID, 1);
+    var storage = new TestStorage(live(before));
+    var owner = open(storage);
+    storage.failBefore = !durable;
+    storage.failAfter = durable;
+
+    assertThrows(
+        IllegalStateException.class, () -> owner.replace(before.token(), supply(before, 71)));
+    assertUnavailable(owner);
+    assertThrows(IllegalStateException.class, () -> owner.replace(before.token(), before));
+    assertEquals(1, storage.loads);
+    assertEquals(1, storage.commits);
+
+    storage.failBefore = false;
+    storage.failAfter = false;
+    var refreshed = owner.refresh();
+
+    assertEquals(durable ? 71 : 38, refreshed.armies().get(ARMY_ID).supply());
+    assertEquals(durable ? 2 : 1, refreshed.armies().get(ARMY_ID).token().generation());
+    assertEquals(2, storage.loads);
+    assertEquals(1, storage.commits);
+    if (durable) {
+      assertThrows(IllegalStateException.class, () -> owner.replace(before.token(), before));
+      assertEquals(1, storage.commits);
+    }
+  }
+
+  @Test
+  void errorsAlsoCloseTheGateWithoutRetrying() {
+    var before = army(ARMY_ID, 1);
+    var storage = new TestStorage(live(before));
+    var owner = open(storage);
+    storage.commitHook =
+        () -> {
+          throw new AssertionError("storage failure");
+        };
+
+    assertThrows(AssertionError.class, () -> owner.replace(before.token(), before));
+    assertUnavailable(owner);
+    assertEquals(1, storage.commits);
+    storage.commitHook = null;
+    owner.refresh();
+    assertTrue(owner.isReady());
+  }
