+
+    assertNotEquals(original.requestDigest(), changed.requestDigest());
+    assertNotEquals(original.debitRequest(), changed.debitRequest());
+  }
+
+  @ParameterizedTest
+  @ValueSource(
+      strings = {
+        "armyId",
+        "incarnation",
+        "generation",
+        "nation",
+        "type",
+        "soldiers",
+        "health",
+        "morale",
+        "worldId",
+        "worldName",
+        "x",
+        "y",
+        "z",
+        "yaw",
+        "pitch",
+        "state",
+        "supply",
+        "remainder",
+        "created",
+        "lastUpdated"
+      })
+  void everySnapshotFieldContributesToTheCanonicalDigest(String field) {
+    var before = before();
+    var changedBefore = mutate(before, field);
+    var original = resupply(before, supplied(before, 70, ACCEPTED), ACCEPTED);
+    var changed = resupply(changedBefore, supplied(changedBefore, 70, ACCEPTED), ACCEPTED);
+
+    assertNotEquals(original.requestDigest(), changed.requestDigest());
+  }
+
+  @Test
+  void finiteFloatingPointSignAndSubmillisecondTimesRemainExactDigestFacts() {
+    var before =
+        withWorld(before(), new ArmyPosition(null, "world", 0.0, 68, -9.25, 37.5f, -16.25f));
