+  void invalidAmountsAreRejectedWithoutRounding(String amount) {
+    assertThrows(IllegalArgumentException.class, () -> create(created(), new BigDecimal(amount)));
+  }
+
+  @Test
+  void exactMaximumAmountIsAccepted() {
