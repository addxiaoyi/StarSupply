+package dev.starcore.starcore.module.army.model.authority;
+
+import java.util.Objects;
+
+public record ArmyBattleHeads(ArmySnapshot attacker, ArmySnapshot defender) {
+  public ArmyBattleHeads {
+    Objects.requireNonNull(attacker, "attacker");
+    Objects.requireNonNull(defender, "defender");
+    if (attacker.token().armyId().equals(defender.token().armyId())) {
+      throw new IllegalArgumentException("Battle heads require distinct armies");
+    }
+    if (attacker.nationId().equals(defender.nationId())) {
+      throw new IllegalArgumentException("Battle heads require distinct nations");
+    }
+  }
+}
diff --git a/src/main/java/dev/starcore/starcore/module/army/model/authority/ArmyBattleIntervention.java b/src/main/java/dev/starcore/starcore/module/army/model/authority/ArmyBattleIntervention.java
