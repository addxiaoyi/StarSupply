+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void exactFutureBudgetAllowsConfirmedEffectAfterCancelIntentAndRestart(boolean sqlite)
+      throws Exception {
+    var request = create(OPERATION, ARMY, 1);
+    var pending = prepared(baseline(), request);
+    long futureBytes =
+        AbstractArmyAuthorityStorage.serializedEnvelopeSize(
+            ArmyAuthorityCodec.encode(ArmyPaidState.maximumCompletionImage(pending)),
+            Long.MAX_VALUE);
+    var source = storage(sqlite, futureBytes);
+    source.initializeFromLegacy(imported());
+    var owner = new ArmyAuthorityOwner(source);
+    owner.refresh();
+    owner.preparePaid(request);
+    owner.cancelPaid(OPERATION);
+    owner.close();
+    owner = new ArmyAuthorityOwner(storage(sqlite, futureBytes));
+    owner.refresh();
+    var applied =
+        owner.confirmPaid(
+            OPERATION,
+            new NationDebitService.Receipt(
+                request.debitRequest(),
+                NationDebitService.Status.APPLIED,
+                Instant.ofEpochMilli(Long.MAX_VALUE)));
+    assertTrue(applied.applied());
+    assertTrue(applied.cancellationRequested());
+    assertEquals(request.after(), owner.army(ARMY).orElseThrow());
+    assertEquals(owner.snapshot(), storage(sqlite, futureBytes).load());
+  }
