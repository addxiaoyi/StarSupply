+    Map<String, Object> receipts() {
+      var result = new TreeMap<String, Object>();
+      for (var id : List.of(parent, child)) {
+        wars.warRetirementReceipt(id).ifPresent(r -> result.put("war:" + id, r));
+        territory.retirementReceipt(id.toString()).ifPresent(r -> result.put("territory:" + id, r));
+        cities.cityRetirementReceipt(id).ifPresent(r -> result.put("city:" + id, r));
+        Optional<DiplomacyRetirementService.RetirementReceipt> diplomacyReceipt;
+        try {
+          diplomacyReceipt = diplomacy.diplomacyRetirementReceipt(id);
+        } catch (DiplomacyStateConflictException stateChanged) {
+          diplomacyReceipt = diplomacy.diplomacyRetirementReceipt(id);
+        }
+        diplomacyReceipt.ifPresent(r -> result.put("diplomacy:" + id, r));
+        bilateral.allianceRetirementReceipt(id).ifPresent(r -> result.put("bilateral:" + id, r));
+        military
+            .militaryAllianceRetirementReceipt(id)
+            .ifPresent(r -> result.put("military:" + id, r));
+        treasury.treasuryRetirementReceipt(id).ifPresent(r -> result.put("treasury:" + id, r));
+        federation
+            .federationRetirementReceipt(id)
+            .ifPresent(r -> result.put("federation:" + id, r));
+      }
+      return result;
+    }
