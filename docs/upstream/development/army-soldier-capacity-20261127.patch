+
+class WarRetirementTest {
+  @TempDir Path root;
+  final NationId a = NationId.random(),
+      b = NationId.random(),
+      c = NationId.random(),
+      d = NationId.random();
+  final Logger logger = Logger.getAnonymousLogger();
+  final WarJsonCodec codec = new WarJsonCodec(new Gson(), logger);
+
+  record Fixture(JavaPlugin plugin, DatabaseService database, String url) {
+    WarStateStorage storage() {
+      return new WarStateStorage(plugin, database);
+    }
+
+    WarServiceImpl service(WarStateStorage storage) {
+      return new WarServiceImpl(
+          plugin, mock(DiplomacyService.class), storage, WarServiceImpl.WarConfig.defaults());
+    }
+  }
+
+  Fixture fixture(boolean sql) throws Exception {
+    var plugin = mock(JavaPlugin.class);
+    var database = mock(DatabaseService.class);
+    when(plugin.getLogger()).thenReturn(logger);
+    when(plugin.getDataFolder()).thenReturn(root.toFile());
+    var server = mock(Server.class);
+    var scheduler = mock(BukkitScheduler.class);
+    when(plugin.getServer()).thenReturn(server);
+    when(server.getScheduler()).thenReturn(scheduler);
+    when(scheduler.runTaskTimer(eq(plugin), any(Runnable.class), anyLong(), anyLong()))
+        .thenReturn(mock(BukkitTask.class));
+    when(database.isRunning()).thenReturn(sql);
+    String url = "jdbc:sqlite:" + root.resolve("retirement.db");
+    if (sql) {
+      var source = mock(DataSource.class);
+      when(source.getConnection()).thenAnswer(call -> DriverManager.getConnection(url));
+      when(database.dataSource()).thenReturn(Optional.of(source));
+    }
+    return new Fixture(plugin, database, url);
+  }
+
+  record Seed(
+      War active,
+      War history,
+      War unrelated,
+      UUID treaty,
+      String treatyState,
+      String battlefield) {}
+
+  Seed seed(WarStateStorage store) {
+    var active = War.declare("active", a, b, WarGoal.TERRITORIAL);
+    var history = War.declare("history", a, c, WarGoal.TERRITORIAL);
+    history.end();
+    var unrelated = War.declare("other", c, d, WarGoal.TERRITORIAL);
+    store.saveAllWars(List.of(active, history, unrelated));
+    var treaty = new PeaceTreaty(UUID.randomUUID(), active.id(), a, b, List.of(), Instant.now());
+    var state =
+        new PeaceTreatyStateCodec()
+            .encode(
+                treaty,
+                PeaceTreatyExecution.create(List.of()),
+                List.of(),
+                List.of(),
+                List.of(),
+                List.of());
+    store.saveTreatyData(treaty.id(), "STATE", state);
+    String battlefield =
+        "{\"schemaVersion\":1,\"warId\":\""
+            + active.id()
+            + "\",\"battlefields\":[],\"strongholds\":[],\"supplyLines\":[]}";
+    store.saveBattlefieldState(active.id(), battlefield);
+    return new Seed(active, history, unrelated, treaty.id(), state, battlefield);
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void retirementAtomicallyRemovesActiveStateAndRetainsOriginalEvidence(boolean sql)
+      throws Exception {
+    var f = fixture(sql);
+    var store = f.storage();
+    var seed = seed(store);
+    var op = UUID.randomUUID();
+    var first = store.retireNationWars(op, a);
+    assertThat(first.warIds()).containsExactly(seed.active.id());
+    assertThat(first.treatyIds()).containsExactly(seed.treaty);
+    assertThat(first.battlefieldIds()).containsExactly(seed.active.id());
+    var restarted = f.storage();
+    assertThat(restarted.retireNationWars(op, a)).isEqualTo(first);
+    assertThat(restarted.loadAllWars())
+        .extracting(War::id)
+        .containsExactlyInAnyOrder(seed.history.id(), seed.unrelated.id());
+    assertThat(restarted.loadTreatyData(seed.treaty)).isEmpty();
+    assertThat(restarted.loadAllBattlefieldStates()).isEmpty();
+    assertThat(restarted.currentAuthority().getProperty(WarAuthority.ARCHIVE + seed.treaty))
+        .contains(seed.treaty.toString());
+    assertThatThrownBy(() -> restarted.saveWar(seed.active))
+        .isInstanceOf(IllegalStateException.class)
+        .hasMessage("Archived war identity cannot be reused");
+    assertThat(restarted.loadWar(seed.active.id())).isNull();
+    assertThat(
+            restarted.currentAuthority().getProperty(WarAuthority.ARCHIVED_WAR + seed.active.id()))
+        .isEqualTo(codec.serialize(seed.active));
+    assertThatThrownBy(() -> restarted.saveBattlefieldState(seed.active.id(), seed.battlefield))
+        .isInstanceOf(IllegalArgumentException.class);
+    assertThatThrownBy(() -> restarted.saveTreatyData(seed.treaty, "STATE", seed.treatyState))
+        .isInstanceOf(IllegalArgumentException.class);
+    assertThatThrownBy(() -> restarted.retireNationWars(UUID.randomUUID(), a))
+        .hasMessageContaining("Conflicting");
+    assertThat(f.storage().warRetirementReceipt(a)).contains(first);
+  }
