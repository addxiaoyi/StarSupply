+  @Test
+  void originalPayloadFactoryPreservesEveryKnownTermAndItsExactDescription() {
+    var amount = new BigDecimal("1E+3");
+    var territories = new ArrayList<>(List.of("zone-b", "zone-a", "zone-b"));
+    List<PeaceTerm> terms =
+        List.of(
+            new PeaceTreaty.PoliticalTerm("ReGiMe_ChAnGe", "Original political wording"),
+            new PeaceTreaty.ReparationTerm(amount, 3),
+            new PeaceTreaty.TerritorialCessionTerm(territories, "Original territory wording"),
+            new PeaceTreaty.MilitaryRestrictionTerm(0, true),
+            new PeaceTreaty.ResourceTributeTerm("minecraft:iron_ingot", 7, 12));
+    var originals = PeaceTreatyBatch.originalTerms(terms);
+
+    assertEquals(List.of(0, 1, 2, 3, 4), originals.stream().map(OriginalTerm::termIndex).toList());
+    assertEquals(
+        List.of(
+            "PoliticalTerm",
+            "ReparationTerm",
+            "TerritorialCessionTerm",
+            "MilitaryRestrictionTerm",
+            "ResourceTributeTerm"),
+        originals.stream().map(OriginalTerm::type).toList());
+    assertEquals(List.of("ReGiMe_ChAnGe"), originals.get(0).payload());
+    assertEquals(List.of("1E+3", "3"), originals.get(1).payload());
+    assertEquals(amount, new BigDecimal(originals.get(1).payload().getFirst()));
+    assertEquals(-3, new BigDecimal(originals.get(1).payload().getFirst()).scale());
+    assertEquals(List.of("zone-b", "zone-a", "zone-b"), originals.get(2).payload());
+    assertEquals(List.of("0", "true"), originals.get(3).payload());
+    assertEquals(List.of("minecraft:iron_ingot", "7", "12"), originals.get(4).payload());
+    assertEquals(
+        terms.stream().map(PeaceTerm::description).toList(),
+        originals.stream().map(OriginalTerm::description).toList());
+    territories.clear();
+    assertEquals(List.of("zone-b", "zone-a", "zone-b"), originals.get(2).payload());
+    assertThrows(UnsupportedOperationException.class, originals::clear);
+    assertThrows(UnsupportedOperationException.class, () -> originals.get(2).payload().clear());
+  }
