index 0000000000000000000000000000000000000000..5e5dcc2e30d7578c5243215d76cfebb98010a59b
--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/module/army/storage/authority/ArmyAuthorityStorage.java
@@ -0,0 +1,187 @@
+package dev.starcore.starcore.module.army.storage.authority;
+
+import dev.starcore.starcore.core.persistence.DurablePropertiesStore;
+import dev.starcore.starcore.module.army.model.authority.ArmyAuthoritySnapshot;
+import java.io.IOException;
+import java.io.OutputStream;
+import java.nio.file.Path;
+import java.util.Objects;
+import java.util.Properties;
+import java.util.function.Supplier;
+import javax.sql.DataSource;
+
+public interface ArmyAuthorityStorage {
+  ArmyAuthoritySnapshot load();
+
+  ArmyAuthoritySnapshot snapshot();
+
+  ArmyAuthoritySnapshot commit(ArmyAuthoritySnapshot expected, ArmyAuthoritySnapshot draft);
+
+  ArmyAuthoritySnapshot initializeFromLegacy(ArmyLegacyImporter.ImportResult imported);
+}
+
+abstract class AbstractArmyAuthorityStorage implements ArmyAuthorityStorage {
+  static final long MAX_AUTHORITY_BYTES = 64L * 1024 * 1024;
+  private final DurablePropertiesStore store;
+  private final long maximumAuthorityBytes;
+
+  AbstractArmyAuthorityStorage(Path file, Supplier<DataSource> dataSource) {
+    this(file, dataSource, MAX_AUTHORITY_BYTES);
+  }
+
+  AbstractArmyAuthorityStorage(
+      Path file, Supplier<DataSource> dataSource, long maximumAuthorityBytes) {
+    if (maximumAuthorityBytes < 0 || maximumAuthorityBytes > MAX_AUTHORITY_BYTES)
+      throw new IllegalArgumentException("Army authority size budget is outside its hard limit");
+    this.maximumAuthorityBytes = maximumAuthorityBytes;
+    store =
+        new DurablePropertiesStore(
+            file,
+            dataSource,
+            "starcore_army_authority",
+            Properties::new,
+            ArmyAuthorityState::validate,
+            ArmyAuthorityState::validateObservation);
+  }
+
+  @Override
+  public final synchronized ArmyAuthoritySnapshot load() {
+    return ArmyAuthorityCodec.decode(store.load());
+  }
+
+  @Override
+  public final synchronized ArmyAuthoritySnapshot snapshot() {
+    return ArmyAuthorityCodec.decode(store.snapshot());
+  }
+
+  @Override
+  public final synchronized ArmyAuthoritySnapshot commit(
+      ArmyAuthoritySnapshot expected, ArmyAuthoritySnapshot draft) {
+    var actual = snapshot();
+    if (!actual.initialized())
+      throw new IllegalStateException("Army authority requires explicit initialization");
+    return commitExact(actual, expected, draft);
+  }
+
+  @Override
+  public final synchronized ArmyAuthoritySnapshot initializeFromLegacy(
+      ArmyLegacyImporter.ImportResult imported) {
+    var actual = snapshot();
+    if (actual.initialized())
+      throw new IllegalStateException(
+          "Army authority is already initialized; reimport is forbidden");
+    Objects.requireNonNull(imported, "imported");
+    if (!imported.ready())
+      throw new IllegalArgumentException(
+          "Legacy army import is not ready: " + imported.diagnostics());
+    var baseline = imported.baseline().orElseThrow();
+    return commitExact(actual, actual, baseline);
+  }
+
+  private ArmyAuthoritySnapshot commitExact(
+      ArmyAuthoritySnapshot actual, ArmyAuthoritySnapshot expected, ArmyAuthoritySnapshot draft) {
+    Objects.requireNonNull(expected, "expected");
+    Objects.requireNonNull(draft, "draft");
+    if (!actual.equals(expected))
+      throw new IllegalStateException(
+          "Army authority predecessor conflict: expected "
+              + expected.revision()
+              + ", found "
+              + actual.revision());
+    if (draft.revision() != expected.revision())
+      throw new IllegalArgumentException(
+          "Army authority draft revision must match its predecessor");
+    var intended = draft.withRevision(Math.addExact(actual.revision(), 1));
+    ArmyAuthorityState.validateCommit(actual, intended);
+    var update = ArmyAuthorityCodec.encode(intended);
+    serializedEnvelopeSize(update, maximumAuthorityBytes);
+    serializedEnvelopeSize(completionCapacity(intended), maximumAuthorityBytes);
+    store.save(update);
+    var confirmed = ArmyAuthorityCodec.decode(store.snapshot());
+    if (!confirmed.equals(intended))
+      throw new IllegalStateException("Army authority confirmation does not match intended image");
+    return confirmed;
+  }
+
+  static Properties completionCapacity(ArmyAuthoritySnapshot intended) {
+    var maximumCompletion =
+        ArmyBattleState.maximumCompletionImage(ArmyPaidState.maximumCompletionImage(intended));
+    if (intended.nationClosures().values().stream().noneMatch(closure -> closure.pending())) {
+      return ArmyAuthorityCodec.encode(maximumCompletion);
+    }
+    var maximumRetirement = ArmyNationClosureState.maximumCompletionImage(maximumCompletion);
+    var reserved = ArmyAuthorityCodec.encode(intended);
+    mergeCapacity(reserved, ArmyAuthorityCodec.encode(maximumCompletion));
+    mergeCapacity(reserved, ArmyAuthorityCodec.encode(maximumRetirement));
+    reserved.setProperty(ArmyAuthorityCodec.REVISION, Long.toString(Long.MAX_VALUE));
+    return reserved;
+  }
+
+  private static void mergeCapacity(Properties reserved, Properties candidate) {
+    candidate
+        .stringPropertyNames()
+        .forEach(
+            key -> {
+              var value = candidate.getProperty(key);
+              var current = reserved.getProperty(key);
+              if (current == null || capacityLength(value) > capacityLength(current)) {
+                reserved.setProperty(key, value);
+              }
+            });
+  }
+
+  private static int capacityLength(String value) {
+    return Math.addExact(
+        value.length(),
+        (int)
+            value
+                .chars()
+                .filter(
+                    character ->
+                        character == '='
+                            || character == ':'
+                            || character == '#'
+                            || character == '!'
+                            || character == '\\')
+                .count());
+  }
+
+  static long serializedEnvelopeSize(Properties update, long maximum) {
+    if (maximum < 0) throw new IllegalArgumentException("Negative army authority size limit");
+    var complete = DurablePropertiesStore.copy(update);
+    complete.setProperty("authority.version", "1");
+    complete.setProperty("authority.sha256", "0".repeat(64));
+    var output = new CountingOutputStream(maximum);
+    try {
+      complete.store(output, "STARCORE snapshot authority");
+    } catch (IOException error) {
+      throw new IllegalArgumentException("Army authority exceeds its serialized size limit", error);
+    }
+    return output.count;
+  }
+
+  private static final class CountingOutputStream extends OutputStream {
+    private final long maximum;
+    private long count;
+
+    private CountingOutputStream(long maximum) {
+      this.maximum = maximum;
+    }
+
+    @Override
+    public void write(int value) throws IOException {
+      add(1);
+    }
+
+    @Override
+    public void write(byte[] values, int offset, int length) throws IOException {
+      Objects.checkFromIndexSize(offset, length, values.length);
+      add(length);
+    }
+
+    private void add(int length) throws IOException {
+      if (length > maximum - count) throw new IOException("Army authority size limit exceeded");
+      count += length;
+    }
+  }
+}
diff --git a/src/main/java/dev/starcore/starcore/module/army/storage/authority/ArmyBattleState.java b/src/main/java/dev/starcore/starcore/module/army/storage/authority/ArmyBattleState.java
new file mode 100644
index 0000000000000000000000000000000000000000..273479352c75b5b171355ffdc1d26097565354e9
--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/module/army/storage/authority/ArmyBattleState.java
@@ -0,0 +1,249 @@
+package dev.starcore.starcore.module.army.storage.authority;
+
+import dev.starcore.starcore.module.army.model.authority.ArmyAuthoritySnapshot;
+import dev.starcore.starcore.module.army.model.authority.ArmyBattleIntervention;
+import dev.starcore.starcore.module.army.model.authority.ArmyBattleSession;
+import dev.starcore.starcore.module.army.model.authority.ArmySnapshot;
+import dev.starcore.starcore.module.army.model.authority.ArmyTombstone;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.UUID;
+import java.util.stream.Collectors;
+
+final class ArmyBattleState {
+  private ArmyBattleState() {}
+
+  static void validate(ArmyAuthoritySnapshot image) {
+    var occupied = new HashSet<UUID>();
+    var paidTargets =
+        image.paidOperations().values().stream()
+            .filter(operation -> operation.pending())
+            .map(operation -> operation.request().armyId())
+            .collect(Collectors.toSet());
+    for (var entry : image.battleSessions().entrySet()) {
+      var session = entry.getValue();
+      var request = session.request();
+      if (!entry.getKey().equals(request.sessionId())
+          || image.receipts().containsKey(entry.getKey())
+          || image.paidOperations().containsKey(entry.getKey())
+          || image.skillUses().containsKey(entry.getKey())) {
+        throw new IllegalArgumentException("Army battle operation identity is ambiguous");
+      }
+      for (var intervention : session.interventions()) {
+        var use = image.skillUses().get(intervention.skillOperationId());
+        if (use == null
+            || !intervention.equals(ArmyBattleIntervention.from(use, intervention.before()))) {
+          throw new IllegalArgumentException(
+              "Army battle intervention has no exact permanent skill proof");
+        }
+      }
+      if (session.pending()) {
+        for (var started :
+            new ArmySnapshot[] {
+              session.currentHeads().attacker(), session.currentHeads().defender()
+            }) {
+          var armyId = started.token().armyId();
+          if (!occupied.add(armyId)
+              || paidTargets.contains(armyId)
+              || !started.equals(image.armies().get(armyId))) {
+            throw new IllegalArgumentException(
+                "Active battle requires exclusive frozen participants");
+          }
+        }
+      } else {
+        requireEffectIdentity(image, session.resolution().attackerAfter(), session);
+        requireEffectIdentity(image, session.resolution().defenderAfter(), session);
+      }
+    }
+  }
+
+  static long remainingRevisions(ArmyAuthoritySnapshot image) {
+    return image.battleSessions().values().stream().filter(ArmyBattleSession::pending).count();
+  }
+
+  static void validateObservation(ArmyAuthoritySnapshot previous, ArmyAuthoritySnapshot next) {
+    next.battleSessions()
+        .forEach(
+            (sessionId, session) -> {
+              if (!previous.battleSessions().containsKey(sessionId)
+                  && session.interventions().stream()
+                      .anyMatch(
+                          intervention ->
+                              previous.skillUses().containsKey(intervention.skillOperationId()))) {
+                throw new IllegalArgumentException(
+                    "A new battle cannot add effects to historical skills");
+              }
+            });
+    previous
+        .battleSessions()
+        .forEach(
+            (sessionId, before) -> {
+              var after = next.battleSessions().get(sessionId);
+              if (after == null
+                  || !before.request().equals(after.request())
+                  || after.interventions().size() < before.interventions().size()
+                  || !before
+                      .interventions()
+                      .equals(after.interventions().subList(0, before.interventions().size()))
+                  || !before.pending() && !before.equals(after)) {
+                throw new IllegalArgumentException(
+                    "Army battle request or terminal proof disappeared");
+              }
+              for (var appended :
+                  after
+                      .interventions()
+                      .subList(before.interventions().size(), after.interventions().size())) {
+                if (previous.skillUses().containsKey(appended.skillOperationId())) {
+                  throw new IllegalArgumentException(
+                      "An already committed skill cannot acquire a later battle effect");
+                }
+              }
+            });
+  }
+
+  static void validateCommit(ArmyAuthoritySnapshot previous, ArmyAuthoritySnapshot next) {
+    var changed =
+        next.battleSessions().entrySet().stream()
+            .filter(
+                entry -> !entry.getValue().equals(previous.battleSessions().get(entry.getKey())))
+            .toList();
+    if (changed.isEmpty()) return;
+    if (!previous.skillUses().equals(next.skillUses())) return;
+    if (changed.size() != 1
+        || !previous.receipts().equals(next.receipts())
+        || !previous.paidOperations().equals(next.paidOperations())
+        || !previous.nationClosures().equals(next.nationClosures())) {
+      throw new IllegalArgumentException("One Army commit may advance only one isolated battle");
+    }
+    var entry = changed.getFirst();
+    var before = previous.battleSessions().get(entry.getKey());
+    var after = entry.getValue();
+    var armies = new HashMap<>(previous.armies());
+    var tombstones = new HashMap<>(previous.tombstones());
+    if (before == null) {
+      if (!after.pending()
+          || !after.interventions().isEmpty()
+          || !after
+              .request()
+              .attackerBefore()
+              .equals(armies.get(after.request().attackerBefore().token().armyId()))
+          || !after
+              .request()
+              .defenderBefore()
+              .equals(armies.get(after.request().defenderBefore().token().armyId()))) {
+        throw new IllegalArgumentException("Battle must start with its exact live predecessors");
+      }
+      armies.put(
+          after.request().attackerStarted().token().armyId(), after.request().attackerStarted());
+      armies.put(
+          after.request().defenderStarted().token().armyId(), after.request().defenderStarted());
+    } else {
+      if (!before.pending()
+          || after.pending()
+          || !before.interventions().equals(after.interventions())) {
+        throw new IllegalArgumentException("Battle may advance only from active to terminal");
+      }
+      for (var effect :
+          new ArmySnapshot[] {
+            after.resolution().attackerAfter(), after.resolution().defenderAfter()
+          }) {
+        var armyId = effect.token().armyId();
+        if (effect.isAlive()) {
+          armies.put(armyId, effect);
+        } else {
+          armies.remove(armyId);
+          tombstones.put(armyId, defeated(effect, after));
+        }
+      }
+    }
+    if (!armies.equals(next.armies()) || !tombstones.equals(next.tombstones())) {
+      throw new IllegalArgumentException(
+          "Battle participants and terminal proof must commit together");
+    }
+  }
+
+  static ArmyTombstone defeated(ArmySnapshot effect, UUID sessionId) {
+    return new ArmyTombstone(
+        effect.token(),
+        effect.nationId(),
+        effect.type(),
+        effect.createdAt(),
+        effect.lastUpdated(),
+        "battle-defeated",
+        sessionId);
+  }
+
+  private static ArmyTombstone defeated(ArmySnapshot effect, ArmyBattleSession session) {
+    if (session.resolution().status() == ArmyBattleSession.Status.SKILL_DEFEAT) {
+      return ArmySkillState.defeated(effect, session.interventions().getLast().skillOperationId());
+    }
+    return defeated(effect, session.request().sessionId());
+  }
+
+  static ArmyAuthoritySnapshot maximumCompletionImage(ArmyAuthoritySnapshot image) {
+    if (image.battleSessions().values().stream().noneMatch(ArmyBattleSession::pending))
+      return image;
+    var armies = new HashMap<>(image.armies());
+    var sessions = new HashMap<>(image.battleSessions());
+    image
+        .battleSessions()
+        .forEach(
+            (sessionId, session) -> {
+              if (session.pending()) {
+                var heads = session.currentHeads();
+                var latest =
+                    heads.attacker().lastUpdated().isAfter(heads.defender().lastUpdated())
+                        ? heads.attacker().lastUpdated()
+                        : heads.defender().lastUpdated();
+                var resolution = ArmyBattleSession.cancelled(session, latest);
+                var terminal =
+                    new ArmyBattleSession(session.request(), resolution, session.interventions());
+                sessions.put(sessionId, terminal);
+                armies.put(resolution.attackerAfter().token().armyId(), resolution.attackerAfter());
+                armies.put(resolution.defenderAfter().token().armyId(), resolution.defenderAfter());
+              }
+            });
+    return new ArmyAuthoritySnapshot(
+        true,
+        image.nationClosures().values().stream().anyMatch(closure -> closure.pending())
+            ? image.revision()
+            : Long.MAX_VALUE,
+        armies,
+        image.tombstones(),
+        image.receipts(),
+        image.migration(),
+        image.version(),
+        image.paidOperations(),
+        sessions,
+        image.skillUses(),
+        image.nationClosures());
+  }
+
+  private static void requireEffectIdentity(
+      ArmyAuthoritySnapshot image, ArmySnapshot proof, ArmyBattleSession session) {
+    var live = image.armies().get(proof.token().armyId());
+    var retired = image.tombstones().get(proof.token().armyId());
+    if (!proof.isAlive()) {
+      if (live != null || !defeated(proof, session).equals(retired)) {
+        throw new IllegalArgumentException(
+            "Defeated battle participant requires its permanent tombstone");
+      }
+      return;
+    }
+    boolean valid =
+        live != null
+            ? live.token().incarnation().equals(proof.token().incarnation())
+                && live.token().generation() >= proof.token().generation()
+                && live.nationId().equals(proof.nationId())
+                && live.type() == proof.type()
+                && live.createdAt().equals(proof.createdAt())
+                && (live.token().generation() != proof.token().generation() || live.equals(proof))
+            : retired != null
+                && retired.token().incarnation().equals(proof.token().incarnation())
+                && retired.token().generation() > proof.token().generation()
+                && retired.nationId().equals(proof.nationId())
+                && retired.type() == proof.type()
+                && retired.createdAt().equals(proof.createdAt());
+    if (!valid) throw new IllegalArgumentException("Army battle effect evidence disappeared");
+  }
+}
