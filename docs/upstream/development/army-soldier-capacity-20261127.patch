@@ -0,0 +1,368 @@
+package dev.starcore.starcore.module.army.storage.authority;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import dev.starcore.starcore.module.army.authority.ArmyAuthorityOwner;
+import dev.starcore.starcore.module.army.model.ArmyState;
+import dev.starcore.starcore.module.army.model.ArmyType;
+import dev.starcore.starcore.module.army.model.authority.ArmyAuthoritySnapshot;
+import dev.starcore.starcore.module.army.model.authority.ArmyBattleRequest;
+import dev.starcore.starcore.module.army.model.authority.ArmyBattleSession;
+import dev.starcore.starcore.module.army.model.authority.ArmyNationClosure;
+import dev.starcore.starcore.module.army.model.authority.ArmyPaidOperation;
+import dev.starcore.starcore.module.army.model.authority.ArmyPaidRequest;
+import dev.starcore.starcore.module.army.model.authority.ArmyPosition;
+import dev.starcore.starcore.module.army.model.authority.ArmySnapshot;
+import dev.starcore.starcore.module.army.model.authority.ArmyToken;
+import dev.starcore.starcore.module.treasury.NationDebitService;
+import java.math.BigDecimal;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.time.Instant;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.Properties;
+import java.util.UUID;
+import org.junit.jupiter.api.io.TempDir;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+import org.sqlite.SQLiteDataSource;
+
+class ArmyNationClosureCapacityTest {
+  private static final UUID ATTACKER = new UUID(1, 1);
+  private static final UUID DEFENDER = new UUID(1, 2);
+  private static final UUID FIRST_CREATED = new UUID(1, 3);
+  private static final UUID SECOND_CREATED = new UUID(1, 4);
+  private static final UUID FIRST_NATION = new UUID(2, 1);
+  private static final UUID SECOND_NATION = new UUID(2, 2);
+  private static final UUID ACTOR = new UUID(3, 1);
+  private static final UUID SESSION = new UUID(4, 1);
+  private static final UUID FIRST_PAID = new UUID(5, 1);
+  private static final UUID SECOND_PAID = new UUID(5, 2);
+  private static final UUID FIRST_CLOSURE = new UUID(7, 1);
+  private static final UUID SECOND_CLOSURE = new UUID(7, 2);
+  private static final Instant ACCEPTED = Instant.parse("2026-11-27T00:00:00.123456789Z");
+  private static final Instant CLOSING = ACCEPTED.plusSeconds(1);
+  private static final String LARGE_WORLD = "world:" + "w".repeat(8192);
+  @TempDir Path directory;
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void oneByteBelowClosingReservationLeavesPreparedAuthorityUnchanged(boolean sqlite)
+      throws Exception {
+    var prepared = prepared();
+    var closing = closing(prepared, FIRST_CLOSURE, FIRST_NATION);
+    long required = reservationBytes(closing);
+    assertTrue(reservationBytes(prepared) <= required - 1);
+    assertTrue(serializedBytes(ArmyAuthorityCodec.encode(closing)) < required);
+
+    var path = directory.resolve("blocked");
+    var owner = initializePreparedOwner(sqlite, path, required - 1);
+    assertThrows(
+        IllegalArgumentException.class,
+        () -> owner.beginNationClosure(FIRST_CLOSURE, FIRST_NATION, CLOSING));
+    assertFalse(owner.isReady());
+    assertEquals(prepared, storage(sqlite, path, required - 1).load());
+    assertEquals(prepared, owner.refresh());
+    assertTrue(owner.snapshot().nationClosures().isEmpty());
+    owner.close();
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void exactUnionBudgetDrainsEveryPaidStatusAndBattleOutcomeAcrossTwoClosures(boolean sqlite)
+      throws Exception {
+    var firstClosing = closing(prepared(), FIRST_CLOSURE, FIRST_NATION);
+    var bothClosing = closing(firstClosing, SECOND_CLOSURE, SECOND_NATION);
+    long required = reservationBytes(bothClosing);
+    var completed =
+        ArmyBattleState.maximumCompletionImage(ArmyPaidState.maximumCompletionImage(bothClosing));
+    var retired = ArmyNationClosureState.maximumCompletionImage(completed);
+    assertTrue(required > serializedBytes(ArmyAuthorityCodec.encode(completed)));
+    assertTrue(required > serializedBytes(ArmyAuthorityCodec.encode(retired)));
+    assertTrue(reservationBytes(firstClosing) <= required);
+    assertEquals(
+        Long.toString(Long.MAX_VALUE),
+        AbstractArmyAuthorityStorage.completionCapacity(bothClosing)
+            .getProperty(ArmyAuthorityCodec.REVISION));
+
+    var statuses =
+        new NationDebitService.Status[] {
+          NationDebitService.Status.APPLIED,
+          NationDebitService.Status.INSUFFICIENT_FUNDS,
+          NationDebitService.Status.RETIRED,
+          NationDebitService.Status.CANCELLED
+        };
+    for (var firstStatus : statuses) {
+      for (var secondStatus : statuses) {
+        for (int outcome = 0; outcome < 4; outcome++) {
+          var path =
+              directory.resolve(firstStatus.name() + "-" + secondStatus.name() + "-" + outcome);
+          var owner = initializePreparedOwner(sqlite, path, required);
+          owner.beginNationClosure(FIRST_CLOSURE, FIRST_NATION, CLOSING);
+          assertEquals(firstClosing, owner.snapshot());
+          owner.beginNationClosure(SECOND_CLOSURE, SECOND_NATION, CLOSING);
+          assertEquals(bothClosing, owner.snapshot());
+          owner.cancelPaid(FIRST_PAID);
+          owner.cancelPaid(SECOND_PAID);
+          assertPersisted(owner, sqlite, path, required);
+          owner = restart(owner, sqlite, path, required);
+          assertTrue(owner.nationClosure(FIRST_NATION).orElseThrow().pending());
+          assertTrue(owner.nationClosure(SECOND_NATION).orElseThrow().pending());
+
+          var firstReceipt = receipt(firstPaid(), firstStatus);
+          var secondReceipt = receipt(secondPaid(), secondStatus);
+          owner.confirmPaid(FIRST_PAID, firstReceipt);
+          assertPersisted(owner, sqlite, path, required);
+          owner = restart(owner, sqlite, path, required);
+          owner.confirmPaid(SECOND_PAID, secondReceipt);
+          assertPersisted(owner, sqlite, path, required);
+          owner = restart(owner, sqlite, path, required);
+
+          boolean attackerDead = (outcome & 1) != 0;
+          boolean defenderDead = (outcome & 2) != 0;
+          var resolution = completedBattle(attackerDead, defenderDead);
+          owner.completeBattle(SESSION, resolution);
+          assertPersisted(owner, sqlite, path, required);
+          owner = restart(owner, sqlite, path, required);
+          assertEquals(resolution, owner.battleSession(SESSION).orElseThrow().resolution());
+
+          UUID firstNation = outcome % 2 == 0 ? FIRST_NATION : SECOND_NATION;
+          UUID firstOperation = outcome % 2 == 0 ? FIRST_CLOSURE : SECOND_CLOSURE;
+          UUID secondNation = outcome % 2 == 0 ? SECOND_NATION : FIRST_NATION;
+          UUID secondOperation = outcome % 2 == 0 ? SECOND_CLOSURE : FIRST_CLOSURE;
+          owner.retireNation(firstOperation, firstNation, Instant.MAX);
+          assertPersisted(owner, sqlite, path, required);
+          owner = restart(owner, sqlite, path, required);
+          assertFalse(owner.nationClosure(firstNation).orElseThrow().pending());
+          assertTrue(owner.nationClosure(secondNation).orElseThrow().pending());
+          owner.retireNation(secondOperation, secondNation, Instant.MAX);
+          assertPersisted(owner, sqlite, path, required);
+          owner = restart(owner, sqlite, path, required);
+
+          assertTrue(owner.snapshot().armies().isEmpty());
+          assertBattleRetirement(owner.snapshot(), ATTACKER, FIRST_NATION, attackerDead);
+          assertBattleRetirement(owner.snapshot(), DEFENDER, SECOND_NATION, defenderDead);
+          assertPaidRetirement(owner.snapshot(), firstPaid(), firstReceipt);
+          assertPaidRetirement(owner.snapshot(), secondPaid(), secondReceipt);
+          var terminal = owner.snapshot();
+          owner.beginNationClosure(FIRST_CLOSURE, FIRST_NATION, CLOSING);
+          owner.beginNationClosure(SECOND_CLOSURE, SECOND_NATION, CLOSING);
+          owner.confirmPaid(FIRST_PAID, firstReceipt);
+          owner.confirmPaid(SECOND_PAID, secondReceipt);
+          owner.completeBattle(SESSION, resolution);
+          owner.retireNation(FIRST_CLOSURE, FIRST_NATION, Instant.MAX);
+          owner.retireNation(SECOND_CLOSURE, SECOND_NATION, Instant.MAX);
+          assertEquals(terminal, owner.snapshot());
+          assertPersisted(owner, sqlite, path, required);
+          owner.close();
+        }
+      }
+    }
+  }
+
+  private static void assertBattleRetirement(
+      ArmyAuthoritySnapshot image, UUID armyId, UUID nationId, boolean defeated) {
+    var proof = image.tombstones().get(armyId);
+    assertEquals(defeated ? "battle-defeated" : "nation-retired", proof.reason());
+    assertEquals(defeated ? SESSION : closureOperation(nationId), proof.operationId());
+    assertEquals(defeated ? 3 : 4, proof.token().generation());
+    var closure = image.nationClosures().get(nationId);
+    assertFalse(closure.pending());
+    assertEquals(!defeated, closure.retirements().containsKey(armyId));
+    if (!defeated) assertEquals(proof, closure.retirements().get(armyId));
+  }
+
+  private static void assertPaidRetirement(
+      ArmyAuthoritySnapshot image, ArmyPaidRequest request, NationDebitService.Receipt receipt) {
+    var operation = image.paidOperations().get(request.operationId());
+    assertEquals(receipt, operation.debitReceipt());
+    assertTrue(operation.cancellationRequested());
+    boolean applied = receipt.status() == NationDebitService.Status.APPLIED;
+    assertEquals(applied, operation.applied());
+    assertEquals(applied, image.tombstones().containsKey(request.armyId()));
+    var closure = image.nationClosures().get(request.nationId());
+    assertEquals(applied, closure.retirements().containsKey(request.armyId()));
+    if (applied) {
+      var proof = image.tombstones().get(request.armyId());
+      assertEquals("nation-retired", proof.reason());
+      assertEquals(closureOperation(request.nationId()), proof.operationId());
+      assertEquals(request.after().token().generation() + 1, proof.token().generation());
+      assertEquals(proof, closure.retirements().get(request.armyId()));
+    }
+  }
+
+  private static UUID closureOperation(UUID nationId) {
+    return nationId.equals(FIRST_NATION) ? FIRST_CLOSURE : SECOND_CLOSURE;
+  }
+
+  private static NationDebitService.Receipt receipt(
+      ArmyPaidRequest request, NationDebitService.Status status) {
+    return new NationDebitService.Receipt(
+        request.debitRequest(), status, Instant.ofEpochMilli(Long.MAX_VALUE));
+  }
+
+  private static ArmyBattleSession.Resolution completedBattle(
+      boolean attackerDead, boolean defenderDead) {
+    var cancelled = ArmyBattleSession.cancelled(battle(), Instant.MAX);
+    return new ArmyBattleSession.Resolution(
+        ArmyBattleSession.Status.COMPLETED,
+        stats(cancelled.attackerAfter(), attackerDead),
+        stats(cancelled.defenderAfter(), defenderDead),
+        Double.MAX_VALUE,
+        Double.MAX_VALUE,
+        Instant.MAX);
+  }
+
+  private static ArmySnapshot stats(ArmySnapshot source, boolean dead) {
+    return new ArmySnapshot(
+        source.token(),
+        source.nationId(),
+        source.type(),
+        dead ? 0 : 80,
+        dead ? 0 : 60,
+        40,
+        source.position(),
+        source.state(),
+        source.supply(),
+        source.supplyConsumptionRemainder(),
+        source.createdAt(),
+        source.lastUpdated());
+  }
+
+  private static ArmyAuthoritySnapshot prepared() {
+    var battle = battle();
+    return new ArmyAuthoritySnapshot(
+        true,
+        6,
+        Map.of(ATTACKER, battle.attackerStarted(), DEFENDER, battle.defenderStarted()),
+        Map.of(),
+        Map.of(),
+        imported().baseline().orElseThrow().migration(),
+        3,
+        Map.of(
+            FIRST_PAID, new ArmyPaidOperation(firstPaid(), false, null),
+            SECOND_PAID, new ArmyPaidOperation(secondPaid(), false, null)),
+        Map.of(SESSION, new ArmyBattleSession(battle, null)),
+        Map.of(),
+        Map.of());
+  }
+
+  private static ArmyAuthoritySnapshot closing(
+      ArmyAuthoritySnapshot before, UUID operationId, UUID nationId) {
+    var closures = new HashMap<>(before.nationClosures());
+    closures.put(nationId, ArmyNationClosure.closing(operationId, nationId, CLOSING));
+    return new ArmyAuthoritySnapshot(
+        true,
+        before.revision() + 1,
+        before.armies(),
+        before.tombstones(),
+        before.receipts(),
+        before.migration(),
+        5,
+        before.paidOperations(),
+        before.battleSessions(),
+        before.skillUses(),
+        closures);
+  }
+
+  private static ArmyBattleRequest battle() {
+    return new ArmyBattleRequest(
+        SESSION,
+        ACTOR,
+        army(ATTACKER, FIRST_NATION, LARGE_WORLD, false),
+        army(DEFENDER, SECOND_NATION, "w", false),
+        ACCEPTED);
+  }
+
+  private static ArmyPaidRequest firstPaid() {
+    return paid(FIRST_PAID, FIRST_CREATED, FIRST_NATION, "w");
+  }
+
+  private static ArmyPaidRequest secondPaid() {
+    return paid(SECOND_PAID, SECOND_CREATED, SECOND_NATION, LARGE_WORLD);
+  }
+
+  private static ArmyPaidRequest paid(UUID operationId, UUID armyId, UUID nationId, String world) {
+    return new ArmyPaidRequest(
+        operationId,
+        ACTOR,
+        ArmyPaidRequest.Kind.CREATE,
+        null,
+        army(armyId, nationId, world, true),
+        new BigDecimal("10.00"),
+        ACCEPTED,
+        10);
+  }
+
+  private static ArmySnapshot army(
+      UUID armyId, UUID nationId, String world, boolean createdByPayment) {
+    return new ArmySnapshot(
+        new ArmyToken(armyId, new UUID(6, armyId.getLeastSignificantBits()), 1),
+        nationId,
+        ArmyType.INFANTRY,
+        100,
+        90,
+        75,
+        new ArmyPosition(null, world, 1, 64, -1, 0, 0),
+        ArmyState.STATIONARY,
+        30,
+        17,
+        createdByPayment ? ACCEPTED : ACCEPTED.minusSeconds(2),
+        createdByPayment ? ACCEPTED : ACCEPTED.minusSeconds(1));
+  }
+
+  private static ArmyLegacyImporter.ImportResult imported() {
+    return ArmyLegacyImporter.inspect(new byte[0], "nation-closure-capacity");
+  }
+
+  private ArmyAuthorityOwner initializePreparedOwner(boolean sqlite, Path path, long maximum)
+      throws Exception {
+    var source = storage(sqlite, path, maximum);
+    source.initializeFromLegacy(imported());
+    var owner = new ArmyAuthorityOwner(source);
+    owner.refresh();
+    owner.create(battle().attackerBefore());
+    owner.create(battle().defenderBefore());
+    owner.preparePaid(firstPaid());
+    owner.preparePaid(secondPaid());
+    owner.startBattle(battle());
+    assertEquals(prepared(), owner.snapshot());
+    return owner;
+  }
+
+  private ArmyAuthorityOwner restart(
+      ArmyAuthorityOwner owner, boolean sqlite, Path path, long maximum) throws Exception {
+    var expected = owner.snapshot();
+    owner.close();
+    var restarted = new ArmyAuthorityOwner(storage(sqlite, path, maximum));
+    assertEquals(expected, restarted.refresh());
+    return restarted;
+  }
+
+  private void assertPersisted(ArmyAuthorityOwner owner, boolean sqlite, Path path, long maximum)
+      throws Exception {
+    assertEquals(owner.snapshot(), storage(sqlite, path, maximum).load());
+    assertTrue(serializedBytes(ArmyAuthorityCodec.encode(owner.snapshot())) <= maximum);
+    assertTrue(reservationBytes(owner.snapshot()) <= maximum);
+  }
+
+  private ArmyAuthorityStorage storage(boolean sqlite, Path path, long maximum) throws Exception {
+    Files.createDirectories(path);
+    if (!sqlite) return new ArmyFileAuthorityStorage(path.resolve("authority"), maximum);
+    var source = new SQLiteDataSource();
+    source.setUrl("jdbc:sqlite:" + path.resolve("army.db"));
+    return new ArmySqlAuthorityStorage(path.resolve("authority"), source, maximum);
+  }
+
+  private static long reservationBytes(ArmyAuthoritySnapshot image) {
+    return serializedBytes(AbstractArmyAuthorityStorage.completionCapacity(image));
+  }
+
+  private static long serializedBytes(Properties properties) {
+    return AbstractArmyAuthorityStorage.serializedEnvelopeSize(properties, Long.MAX_VALUE);
+  }
+}
