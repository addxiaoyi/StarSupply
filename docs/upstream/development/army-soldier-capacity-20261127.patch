+              && before.operations.containsKey(owner.operationId())
+              && before.operations.get(owner.operationId()).terminal())
+            throw new IllegalArgumentException("Treaty projection cannot be reacquired");
+        });
+  }
+
+  static void validateCommitTransitions(Properties previous, Properties next) {
+    var before = read(previous);
+    var after = read(next);
+    after.operations.forEach(
+        (id, operation) -> validateOperationTransition(before.operations.get(id), operation, true));
+    validateProofTransitions(previous, next);
+  }
+
+  static void validateProofTransitions(Properties previous, Properties next) {
+    var before = read(previous);
+    var after = read(next);
+    var oldMirror = WarDiplomacyMirrorState.read(previous);
+    var newMirror = WarDiplomacyMirrorState.read(next);
+    var oldGenerations = DiplomacyAllianceOperationState.read(previous);
+    var newGenerations = DiplomacyAllianceOperationState.read(next);
+    after.proofs.forEach(
+        (id, proof) -> {
+          if (before.proofs.containsKey(id)) return;
+          var operation = before.operations.get(id);
+          if (operation == null || operation.status() != Status.RESERVED)
+            throw new IllegalArgumentException(
+                "Release proof requires an existing reserved treaty");
+          if (!matchesProofVersion(operation, proof))
+            throw new IllegalArgumentException("Release proof requires an existing exact binding");
+          var war = operation.request().war();
+          var pair = DiplomacyPairKey.of(war.attacker(), war.defender());
+          var oldEntry = oldMirror.receipts().get(war.warId());
+          var newEntry = newMirror.receipts().get(war.warId());
+          if (!war.warId().equals(oldMirror.owners().get(pair))
+              || oldEntry == null
+              || !oldEntry.active()
+              || newEntry == null
+              || newEntry.active()
+              || !exactEntry(war, oldEntry)
+              || !exactEntry(war, newEntry)
+              || newMirror.owners().containsKey(pair)
+              || proof.fromGeneration() != oldGenerations.generation(pair)
+              || proof.toGeneration() != newGenerations.generation(pair)
+              || proof.sourceRevision() != newMirror.revision())
+            throw new IllegalArgumentException("Unproven exact original war release");
+        });
+  }
+
+  static boolean exactEntry(ExactWar war, WarDiplomacyMirrorService.WarEntry entry) {
+    return entry != null
+        && war.warId().equals(entry.warId())
+        && war.attacker().equals(entry.aggressor())
+        && war.defender().equals(entry.defender())
+        && war.declaredAt().equals(entry.declaredAt());
+  }
+
+  private static boolean matchesProofVersion(OperationView operation, ReleaseProof proof) {
+    return operation.request().protocolVersion() == proof.protocolVersion()
+        && (proof.protocolVersion() == 1
+            || operation.binding() != null
+                && operation.binding().planHash().equals(proof.globalManifestHash()));
+  }
+
+  private static void validateOperationTransition(
+      OperationView old, OperationView next, boolean commit) {
+    if (old == null) {
+      if (commit && next.binding() != null)
+        throw new IllegalArgumentException(
+            "Treaty binding requires an existing reserved operation");
+      return;
+    }
+    if (!old.request().equals(next.request())
+        || !Objects.equals(old.plan(), next.plan())
+        || old.terminal() && !old.equals(next)
+        || old.binding() != null && !old.binding().equals(next.binding())
+        || commit
+            && old.binding() == null
+            && next.binding() != null
+            && (old.status() != Status.RESERVED || next.status() != Status.RESERVED))
+      throw new IllegalArgumentException(
+          "Treaty operation payload, binding or receipt is immutable");
+  }
+}
