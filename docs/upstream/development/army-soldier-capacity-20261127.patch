+    var creation = create(SECOND_OPERATION, OTHER, 3);
+    var pending = prepared(prepared(before, supply), creation);
+    ArmyAuthorityState.validate(pending);
+    long maximum =
+        AbstractArmyAuthorityStorage.serializedEnvelopeSize(
+            ArmyAuthorityCodec.encode(ArmyPaidState.maximumCompletionImage(pending)),
+            Long.MAX_VALUE);
+    for (var supplyStatus : NationDebitService.Status.values()) {
+      for (var createStatus : NationDebitService.Status.values()) {
+        var armies = new HashMap<>(before.armies());
+        if (supplyStatus == NationDebitService.Status.APPLIED) armies.put(ARMY, supply.after());
+        if (createStatus == NationDebitService.Status.APPLIED) armies.put(OTHER, creation.after());
+        var decidedAt = Instant.ofEpochMilli(Long.MAX_VALUE);
+        var decisions =
+            Map.of(
+                OPERATION,
+                    new ArmyPaidOperation(
