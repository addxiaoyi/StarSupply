+
+  @ParameterizedTest
+  @ValueSource(doubles = {Double.NaN, Double.POSITIVE_INFINITY, Double.NEGATIVE_INFINITY, -0.01})
+  void damageMustBeFiniteAndNonnegativeOnBothSides(double damage) {
