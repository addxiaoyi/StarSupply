new file mode 100644
index 0000000000000000000000000000000000000000..4f1568c3df5757fbc3620cf51150c1f8a32115e8
--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/module/army/authority/ArmyPaidCoordinator.java
@@ -0,0 +1,51 @@
+package dev.starcore.starcore.module.army.authority;
+
+import dev.starcore.starcore.module.army.model.authority.ArmyPaidOperation;
+import dev.starcore.starcore.module.army.model.authority.ArmyPaidRequest;
+import dev.starcore.starcore.module.treasury.NationDebitService;
+import java.util.Objects;
+import java.util.UUID;
+
+/** Synchronous boundary for persisted army intents and original debit decisions. */
+public final class ArmyPaidCoordinator {
+  private final ArmyAuthorityOwner owner;
+  private final NationDebitService debits;
+
+  public ArmyPaidCoordinator(ArmyAuthorityOwner owner, NationDebitService debits) {
+    this.owner = Objects.requireNonNull(owner, "owner");
+    this.debits = Objects.requireNonNull(debits, "debits");
+  }
+
+  public synchronized ArmyPaidOperation execute(ArmyPaidRequest request) {
+    Objects.requireNonNull(request, "request");
+    owner.preparePaid(request);
+    return resume(request.operationId());
+  }
+
+  public synchronized ArmyPaidOperation resume(UUID operationId) {
+    Objects.requireNonNull(operationId, "operationId");
+    var operation =
+        owner
+            .paidOperation(operationId)
+            .orElseThrow(() -> new IllegalArgumentException("Unknown army paid operation"));
+    if (!operation.pending()) return operation;
+
+    var expected = operation.request().debitRequest();
+    var recorded = Objects.requireNonNull(debits.debitReceipt(operationId), "Debit receipt query");
+    var receipt =
+        recorded.orElseGet(
+            () ->
+                operation.cancellationRequested()
+                    ? debits.cancelDebit(expected)
+                    : debits.applyDebit(expected));
+    if (receipt == null || !expected.equals(receipt.request()))
+      throw new IllegalStateException("Original debit receipt conflicts with army paid operation");
+    return owner.confirmPaid(operationId, receipt);
+  }
+
+  public synchronized ArmyPaidOperation cancel(UUID operationId) {
+    Objects.requireNonNull(operationId, "operationId");
+    owner.cancelPaid(operationId);
+    return resume(operationId);
+  }
+}
