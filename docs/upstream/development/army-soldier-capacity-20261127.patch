+              150);
+      f.owner.preparePaid(request);
+      var image = f.owner.snapshot();
+      var encoded = ArmyAuthorityCodec.encode(image);
+      String key = "armyPaid." + request.operationId();
+      var row = Base64.getDecoder().decode(encoded.getProperty(key));
+      assertEquals(encoded, ArmyAuthorityCodec.encodeWithRowBudget(image, row.length));
+      assertThrows(
+          IllegalArgumentException.class,
+          () -> ArmyAuthorityCodec.encodeWithRowBudget(image, row.length - 1));
+      for (long invalid : new long[] {-1, 29, Long.MAX_VALUE}) {
+        var changed = row.clone();
+        java.nio.ByteBuffer.wrap(changed).putLong(row.length - 22, invalid);
+        var bad = new Properties();
+        bad.putAll(encoded);
+        bad.setProperty(key, Base64.getEncoder().encodeToString(changed));
+        assertThrows(IllegalArgumentException.class, () -> ArmyAuthorityCodec.decode(bad));
+      }
+      var truncated = new Properties();
+      truncated.putAll(encoded);
+      truncated.setProperty(
+          key, Base64.getEncoder().encodeToString(Arrays.copyOf(row, row.length - 1)));
+      assertThrows(IllegalArgumentException.class, () -> ArmyAuthorityCodec.decode(truncated));
+      assertThrows(
+          IllegalArgumentException.class,
+          () ->
+              new ArmyPaidRequest(
+                  request.operationId(),
+                  request.actorId(),
+                  request.kind(),
+                  null,
+                  request.after(),
+                  request.amount(),
+                  request.acceptedAt(),
+                  10,
+                  29));
