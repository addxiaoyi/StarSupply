+    when(receiver.settlementEffect("diplomacy", 2, request.operationId()))
+        .thenAnswer(
+            call -> {
+              assertThat(
+                      service
+                          .prepareDisband(
+                              new dev.starcore.starcore.module.war.WarDisbandAdmissionService
+                                  .Request(UUID.randomUUID(), List.of(fixture.c)))
+                          .accepted())
+                  .isTrue();
+              service.shutdown();
+              return Optional.of(proof(request, Phase.BOUND, null));
+            });
+    assertThatThrownBy(() -> service.prepareSettlement(request)).hasMessageContaining("stopped");
+    assertThat(setup.storage().settlementAdmission(request.operationId())).isEmpty();
+    assertThat(setup.storage().loadWar(war.id()).isActive()).isTrue();
+  }
