+  private static double distanceSquared(ArmyPosition a, ArmyPosition b) {
+    boolean sameWorld =
+        a.worldId() != null && b.worldId() != null
+            ? a.worldId().equals(b.worldId())
+            : a.worldName().equals(b.worldName());
+    if (!sameWorld) return Double.POSITIVE_INFINITY;
+    double x = a.x() - b.x(), y = a.y() - b.y(), z = a.z() - b.z();
+    return x * x + y * y + z * z;
