@@ -0,0 +1,189 @@
+package dev.starcore.starcore.module.diplomacy.alliance.command;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+import dev.starcore.starcore.foundation.player.OnlinePlayerDirectory;
+import dev.starcore.starcore.module.diplomacy.alliance.AllianceRecoveryService;
+import dev.starcore.starcore.module.diplomacy.alliance.AllianceRecoveryService.PendingView;
+import dev.starcore.starcore.module.diplomacy.alliance.AllianceRecoveryService.Status;
+import dev.starcore.starcore.module.diplomacy.alliance.AllianceService;
+import dev.starcore.starcore.module.nation.NationService;
+import dev.starcore.starcore.module.nation.model.NationId;
+import java.time.Instant;
+import java.util.List;
+import java.util.Optional;
+import java.util.UUID;
+import java.util.stream.IntStream;
+import org.bukkit.command.CommandSender;
+import org.junit.jupiter.api.Test;
+
+class AllianceRecoveryCommandTest {
+  private final AllianceService service =
+      mock(AllianceService.class, withSettings().extraInterfaces(AllianceRecoveryService.class));
+  private final AllianceRecoveryService recovery = (AllianceRecoveryService) service;
+  private final NationService nations = mock(NationService.class);
+  private final OnlinePlayerDirectory players = mock(OnlinePlayerDirectory.class);
+  private final CommandSender sender = mock(CommandSender.class);
+  private final AllianceCommand command = new AllianceCommand(service, nations, players);
+
+  private PendingView view(Status status, String reason) {
+    return new PendingView(
+        UUID.randomUUID(),
+        "FORM",
+        NationId.random(),
+        NationId.random(),
+        Instant.EPOCH,
+        status,
+        reason);
+  }
+
+  private void run(String... args) {
+    assertTrue(command.onCommand(sender, null, "alliance", args));
+  }
+
+  @Test
+  void unauthorizedSenderCannotReadOrMutateRecovery() {
+    for (String action : List.of("list", "show", "retry", "cancel")) {
+      run("recovery", action, UUID.randomUUID().toString());
+    }
+    verifyNoInteractions(service, nations, players);
+  }
+
+  @Test
+  void consoleCanListAndShowWithoutResolvingPlayersOrNations() {
+    when(sender.hasPermission("starcore.alliance.admin")).thenReturn(true);
+    var pending = view(Status.PREPARED, "pending");
+    when(recovery.pendingAllianceOperations()).thenReturn(List.of(pending));
+    when(recovery.allianceOperation(pending.operationId())).thenReturn(Optional.of(pending));
+    run("recovery", "list");
+    run("recovery", "show", pending.operationId().toString());
+    verify(recovery).pendingAllianceOperations();
+    verify(recovery).allianceOperation(pending.operationId());
+    verifyNoMoreInteractions(service);
+    verifyNoInteractions(nations, players);
+    verify(sender, atLeastOnce()).sendMessage(contains(pending.operationId().toString()));
+  }
+
+  @Test
+  void retryUsesOnlyOriginalOperationId() {
+    when(sender.hasPermission("starcore.alliance.admin")).thenReturn(true);
+    var pending = view(Status.PREPARED, "unknown");
+    when(recovery.retryAllianceOperation(pending.operationId())).thenReturn(pending);
+    run("recovery", "retry", pending.operationId().toString());
+    verify(recovery).retryAllianceOperation(pending.operationId());
+    verifyNoMoreInteractions(service);
+  }
+
+  @Test
+  void cancelShowsReceiverResultWithoutAssumingReversal() {
+    when(sender.hasPermission("starcore.alliance.admin")).thenReturn(true);
+    var completed = view(Status.ACKNOWLEDGED, "APPLIED");
+    when(recovery.cancelAllianceOperation(completed.operationId())).thenReturn(completed);
+    run("recovery", "cancel", completed.operationId().toString());
+    verify(recovery).cancelAllianceOperation(completed.operationId());
+    verify(sender).sendMessage("§7结果: APPLIED");
+    verifyNoMoreInteractions(service);
+  }
+
+  @Test
+  void invalidIdsAndArgumentCountsCannotCreateOperations() {
+    when(sender.hasPermission("starcore.alliance.admin")).thenReturn(true);
+    for (String action : List.of("show", "retry", "cancel")) {
+      for (String bad : List.of("invalid", "1-1-1-1-1", "")) run("recovery", action, bad);
+      run("recovery", action);
+      run("recovery", action, UUID.randomUUID().toString(), "extra");
+    }
+    run("recovery", "other");
+    run("recovery", "list", "0");
+    run("recovery", "list", "2147483648");
+    verifyNoInteractions(service, nations, players);
+  }
+
+  @Test
+  void listIsPaginatedWithoutMutatingPending() {
+    when(sender.hasPermission("starcore.alliance.admin")).thenReturn(true);
+    var pending =
+        IntStream.range(0, 21).mapToObj(index -> view(Status.PREPARED, "pending")).toList();
+    when(recovery.pendingAllianceOperations()).thenReturn(pending);
+    run("recovery", "list", "2");
+    verify(sender).sendMessage("§6联盟待恢复操作: 21，第 2/3 页");
+    for (int index = 0; index < pending.size(); index++) {
+      verify(sender, index >= 10 && index < 20 ? times(1) : never())
+          .sendMessage(contains(pending.get(index).operationId().toString()));
+    }
+    verify(recovery).pendingAllianceOperations();
+    verifyNoMoreInteractions(service);
+  }
+
+  @Test
+  void missingHistoryAndEmptyListAreExplicit() {
+    when(sender.hasPermission("starcore.alliance.admin")).thenReturn(true);
+    UUID operationId = UUID.randomUUID();
+    when(recovery.pendingAllianceOperations()).thenReturn(List.of());
+    when(recovery.allianceOperation(operationId)).thenReturn(Optional.empty());
+    run("recovery", "list");
+    run("recovery", "show", operationId.toString());
+    verify(sender).sendMessage("§6联盟待恢复操作: 0，第 1/1 页");
+    verify(sender).sendMessage("§c未找到该联盟操作");
+  }
+
+  @Test
+  void unknownReceiverResponseDoesNotRetryOrCancelAutomatically() {
+    when(sender.hasPermission("starcore.alliance.admin")).thenReturn(true);
+    UUID operationId = UUID.randomUUID();
+    when(recovery.retryAllianceOperation(operationId))
+        .thenThrow(new IllegalStateException("secret"));
+    run("recovery", "retry", operationId.toString());
+    verify(sender).sendMessage("§c无法确认恢复结果；请使用原操作 UUID 查询或重试，勿创建替代操作");
+    verify(recovery).retryAllianceOperation(operationId);
+    verifyNoMoreInteractions(service);
+  }
+
+  @Test
+  void unavailableProtocolDoesNotFallBackToLegacyService() {
+    when(sender.hasPermission("starcore.alliance.admin")).thenReturn(true);
+    var legacy = mock(AllianceService.class);
+    var legacyCommand = new AllianceCommand(legacy, nations, players);
+    legacyCommand.onCommand(sender, null, "alliance", new String[] {"recovery", "list"});
+    verify(sender).sendMessage("§c当前联盟服务不支持耐久恢复协议");
+    verifyNoInteractions(legacy, nations, players);
+  }
+
+  @Test
+  void unsupportedProtocolDoesNotLeakExceptionDetails() {
+    when(sender.hasPermission("starcore.alliance.admin")).thenReturn(true);
+    when(recovery.pendingAllianceOperations())
+        .thenThrow(new UnsupportedOperationException("secret"));
+    run("recovery", "list");
+    verify(sender).sendMessage("§c当前联盟服务不支持耐久恢复协议");
+  }
+
+  @Test
+  void recoverySuggestionsRequireAdminAndNeverReadPendingOperations() {
+    assertFalse(
+        command.onTabComplete(sender, null, "alliance", new String[] {"rec"}).contains("recovery"));
+    assertTrue(
+        command.onTabComplete(sender, null, "alliance", new String[] {"recovery", ""}).isEmpty());
+    when(sender.hasPermission("starcore.alliance.admin")).thenReturn(true);
+    assertEquals(
+        List.of("recovery"), command.onTabComplete(sender, null, "alliance", new String[] {"rec"}));
+    assertEquals(
+        List.of("cancel"),
+        command.onTabComplete(sender, null, "alliance", new String[] {"recovery", "ca"}));
+    assertTrue(
+        command
+            .onTabComplete(sender, null, "alliance", new String[] {"recovery", "retry", ""})
+            .isEmpty());
+    verifyNoInteractions(service, nations, players);
+  }
+
+  @Test
+  void storedReasonCannotInjectFormattingOrNewMessageLines() {
+    when(sender.hasPermission("starcore.alliance.admin")).thenReturn(true);
+    var pending = view(Status.PREPARED, "§4error\nnext\r\tend");
+    when(recovery.allianceOperation(pending.operationId())).thenReturn(Optional.of(pending));
+    run("recovery", "show", pending.operationId().toString());
+    verify(sender).sendMessage("§7结果: ?4error next  end");
+  }
+}
