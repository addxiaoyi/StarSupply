+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void exactMixedFutureBudgetSurvivesRestartCancellationAndEveryDefeatOutcome(boolean sqlite)
+      throws Exception {
+    var prepared = withPendingCreation(capacityBaseline());
+    var active = started(prepared, request(prepared));
+    long budget =
+        serializedSize(
+            ArmyBattleState.maximumCompletionImage(ArmyPaidState.maximumCompletionImage(active)));
+    for (int outcome = 0; outcome <= 4; outcome++) {
+      var path = directory.resolve("outcome-" + outcome);
+      var owner = initializeCapacityOwner(sqlite, path, budget);
+      owner.preparePaid(paidCreation());
+      owner.startBattle(request(prepared));
+      assertEquals(active, owner.snapshot());
+      owner.cancelPaid(OPERATION);
+      owner.close();
+      owner = new ArmyAuthorityOwner(capacityStorage(sqlite, path, budget));
+      owner.refresh();
+      owner.confirmPaid(
+          OPERATION,
+          new NationDebitService.Receipt(
+              paidCreation().debitRequest(),
+              NationDebitService.Status.APPLIED,
+              Instant.ofEpochMilli(Long.MAX_VALUE)));
+      var original = owner.snapshot();
+      var resolution =
+          outcome == 4
+              ? ArmyBattleSession.cancelled(request(active), Instant.MAX)
+              : completedAt(original, (outcome & 1) != 0, (outcome & 2) != 0, Instant.MAX);
+      owner.completeBattle(SESSION, resolution);
+      assertFalse(owner.battleSession(SESSION).orElseThrow().pending());
+      assertTrue(owner.paidOperation(OPERATION).orElseThrow().applied());
+      assertTrue(owner.paidOperation(OPERATION).orElseThrow().cancellationRequested());
+      assertEquals(owner.snapshot(), capacityStorage(sqlite, path, budget).load());
+      assertTrue(serializedSize(owner.snapshot()) <= budget);
+    }
+  }
