+    var war = new ExactWar(UUID.randomUUID(), attacker, defender, AT, List.of(), List.of());
+    var terms =
+        java.util.stream.IntStream.range(0, termCount)
+            .mapToObj(
+                index ->
+                    new IndexedTerm(index, "PoliticalTerm", "neutrality", "\u0001\"\\中".repeat(64)))
