+import org.junit.jupiter.api.Test;
+
+class ArmyAuthorityStateTest {
+  @Test
+  void baselineAcceptsGenerationOneTombstonesAndOrphanLegacyReceipts() {
+    ArmyTombstone retired = tombstone(army(1), 1);
+    ArmyLogisticsReceipt orphan =
+        new ArmyLogisticsReceipt(REQUEST_ID, OTHER_ID, NATION_ID, 25, 0, null);
+    ArmyAuthoritySnapshot baseline =
+        image(1, Map.of(), Map.of(ARMY_ID, retired), Map.of(REQUEST_ID, orphan));
+    assertDoesNotThrow(
+        () -> ArmyAuthorityState.validateCommit(ArmyAuthoritySnapshot.uninitialized(), baseline));
+    assertEquals(baseline, ArmyAuthorityCodec.decode(ArmyAuthorityCodec.encode(baseline)));
+    ArmyAuthoritySnapshot skipped = image(1, Map.of(ARMY_ID, army(2)), Map.of(), Map.of());
+    assertThrows(
+        IllegalArgumentException.class,
+        () -> ArmyAuthorityState.validateCommit(ArmyAuthoritySnapshot.uninitialized(), skipped));
+  }
+
+  @Test
+  void exactGenerationSuccessorAndExplicitSameValueUpdateAreLegal() {
+    ArmyAuthoritySnapshot before = live(1, 1);
+    ArmyAuthoritySnapshot after = live(2, 2);
+    assertDoesNotThrow(() -> ArmyAuthorityState.validateCommit(before, after));
+    assertDoesNotThrow(() -> ArmyAuthorityState.validateCommit(before, before.withRevision(2)));
+    assertThrows(
+        IllegalArgumentException.class,
+        () -> ArmyAuthorityState.validateCommit(before, live(2, 3)));
+    assertThrows(
+        IllegalArgumentException.class,
+        () -> ArmyAuthorityState.validateCommit(before, after.withRevision(3)));
+  }
+
+  @Test
+  void newLiveIdentityAfterInitializationMustStartAtGenerationOne() {
+    ArmyAuthoritySnapshot empty = image(1, Map.of(), Map.of(), Map.of());
+    assertDoesNotThrow(() -> ArmyAuthorityState.validateCommit(empty, live(2, 1)));
+    assertThrows(
+        IllegalArgumentException.class, () -> ArmyAuthorityState.validateCommit(empty, live(2, 2)));
+  }
+
+  @Test
+  void observationMaySkipSeveralLegalCommitsAndThenObserveRetirement() {
+    ArmyAuthoritySnapshot before = live(1, 1);
+    ArmyAuthoritySnapshot unseenUpdates = live(4, 4);
+    assertDoesNotThrow(() -> ArmyAuthorityState.validateObservation(before, unseenUpdates));
+    ArmyAuthoritySnapshot retired =
+        image(6, Map.of(), Map.of(ARMY_ID, tombstone(army(4), 6)), Map.of());
+    assertDoesNotThrow(() -> ArmyAuthorityState.validateObservation(before, retired));
+    assertThrows(
+        IllegalArgumentException.class, () -> ArmyAuthorityState.validateCommit(before, retired));
+    assertThrows(
+        IllegalArgumentException.class,
+        () -> ArmyAuthorityState.validateObservation(unseenUpdates, before));
+  }
+
+  @Test
+  void changedArmyFieldsRequireGenerationAndImmutableIdentityCannotChange() {
+    ArmySnapshot before = army(1);
+    ArmySnapshot changedWithoutGeneration = army(1, 42, 73.5, 64.25, 39, 37, UPDATED);
+    ArmyAuthoritySnapshot original = live(1, 1);
+    assertThrows(
+        IllegalArgumentException.class,
+        () ->
+            ArmyAuthorityState.validateObservation(
+                original, image(2, Map.of(ARMY_ID, changedWithoutGeneration), Map.of(), Map.of())));
+    ArmySnapshot differentOwner =
+        new ArmySnapshot(
+            new ArmyToken(ARMY_ID, INCARNATION, 2),
+            OTHER_ID,
+            before.type(),
+            before.soldiers(),
+            before.health(),
+            before.morale(),
+            before.position(),
