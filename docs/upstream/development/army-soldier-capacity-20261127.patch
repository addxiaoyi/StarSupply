+  @Test
+  void moduleDisableDoesNotReverseLoanAndTreasuryMonitorOrder() throws Exception {
+    var module = new TreasuryModule();
+    var fixture = repaymentFixture(module);
+    var listener = spy(fixture.listener());
+    setField(module, "treasuryMenuListener", listener);
+    Object lifecycleLock = fieldValue(listener, "lifecycleLock");
+    var loan = new LoanServiceImpl();
+    var loanEntered = new CountDownLatch(1);
+    var callbackEntered = new CountDownLatch(1);
+    var closeEntered = new CountDownLatch(1);
+    var completionOrder = new ConcurrentLinkedQueue<String>();
+    var mutations = new AtomicInteger();
+    var executor = newExecutor(3);
+    doAnswer(
+            invocation -> {
+              try {
+                assertThat(Thread.holdsLock(module)).isFalse();
+              } finally {
+                closeEntered.countDown();
+              }
+              return invocation.callRealMethod();
+            })
+        .when(listener)
+        .close();
+    Consumer<String> callback =
+        input -> {
+          assertThat(Thread.holdsLock(lifecycleLock)).isTrue();
+          assertThat(Thread.holdsLock(module)).isFalse();
+          callbackEntered.countDown();
+          synchronized (loan) {
+            module.balance(fixture.nation().id());
+            mutations.incrementAndGet();
+            completionOrder.add("callback");
+          }
+        };
+    try (var support = mockStatic(BookInputSupport.class)) {
+      var open =
+          TreasuryMenuListener.class.getDeclaredMethod(
+              "openBookInput", Player.class, String.class, NationPermission.class, Consumer.class);
+      open.setAccessible(true);
+      open.invoke(listener, fixture.player(), "Amount", NationPermission.BANK_WITHDRAW, callback);
+      Consumer<String> guarded = pendingInput(listener, fixture.playerId());
+      var loanOperation =
+          executor.submit(
+              () -> {
+                synchronized (loan) {
+                  loanEntered.countDown();
+                  await(closeEntered);
+                  synchronized (module) {
+                    module.balance(fixture.nation().id());
+                    completionOrder.add("loan-module");
+                  }
+                }
+              });
+      assertThat(loanEntered.await(5, TimeUnit.SECONDS)).isTrue();
+      var submission = executor.submit(() -> guarded.accept("10"));
+      assertThat(callbackEntered.await(5, TimeUnit.SECONDS)).isTrue();
+      var shutdown =
+          executor.submit(
+              () -> {
+                module.disable(null);
+                completionOrder.add("disable");
+              });
+      loanOperation.get(5, TimeUnit.SECONDS);
+      submission.get(5, TimeUnit.SECONDS);
+      shutdown.get(5, TimeUnit.SECONDS);
+      assertThat(completionOrder).containsExactly("loan-module", "callback", "disable");
+      guarded.accept("20");
+      assertThat(mutations.get()).isEqualTo(1);
+      assertThatThrownBy(() -> module.balance(fixture.nation().id()))
+          .isInstanceOf(IllegalStateException.class)
+          .hasMessageContaining("stopped");
+    } finally {
+      closeEntered.countDown();
+      executor.shutdownNow();
+      assertThat(executor.awaitTermination(5, TimeUnit.SECONDS)).isTrue();
+    }
+  }
