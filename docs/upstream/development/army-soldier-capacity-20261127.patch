+              }
+
+              public ArmyAuthoritySnapshot commit(
+                  ArmyAuthoritySnapshot expected, ArmyAuthoritySnapshot draft) {
+                var result = delegate.commit(expected, draft);
+                if (loseAck.getAndSet(false))
+                  throw new IllegalStateException("lost committed acknowledgement");
+                return result;
+              }
+            });
+    owner.refresh();
+    var stale = reopen(sqlite, root, UNBOUNDED);
+    var request = national(owner, 2, TIME.plusSeconds(1));
+    var losingRequest = national(stale, 3, TIME.plusSeconds(1));
+    assertThrows(IllegalStateException.class, () -> owner.useSkill(request));
+    assertFalse(owner.isReady());
+    var actual = storage(sqlite, root, UNBOUNDED).load();
+    assertEquals(1, actual.skillUses().size());
+    assertThrows(RuntimeException.class, () -> stale.useSkill(losingRequest));
+    assertFalse(stale.isReady());
+    owner.refresh();
+    assertEquals(actual.skillUses().get(request.operationId()), owner.useSkill(request));
+    assertEquals(actual, owner.snapshot());
+    assertEquals(actual, stale.refresh());
+    assertThrows(IllegalArgumentException.class, () -> stale.useSkill(losingRequest));
