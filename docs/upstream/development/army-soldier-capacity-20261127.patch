+
+  private static ArmySnapshot createdAt(Instant accepted) {
+    return new ArmySnapshot(
+        new ArmyToken(ARMY_ID, INCARNATION, 1),
+        NATION_ID,
+        ArmyType.INFANTRY,
+        42,
