+
+    @Override
+    public ArmyAuthoritySnapshot commit(
+        ArmyAuthoritySnapshot expected, ArmyAuthoritySnapshot draft) {
+      commits++;
+      if (commitHook != null) commitHook.run();
+      if (failBefore) throw new IllegalStateException("write failed before commit");
+      if (!expected.equals(durable)) throw new IllegalStateException("predecessor conflict");
+      var next = draft.withRevision(Math.addExact(expected.revision(), 1));
+      ArmyAuthorityState.validateCommit(expected, next);
+      durable = next;
+      if (failAfter) throw new IllegalStateException("confirmation lost after commit");
+      return confirmationOverride != null ? confirmationOverride : durable;
+    }
+
+    @Override
+    public ArmyAuthoritySnapshot initializeFromLegacy(ArmyLegacyImporter.ImportResult imported) {
+      initializations++;
+      throw new AssertionError("Owner refresh must not initialize or import");
+    }
+  }
