+  private static ArmyAuthoritySnapshot settled(
+      ArmyAuthoritySnapshot image,
+      UUID sessionId,
+      boolean attackerDead,
+      boolean defenderDead,
+      long revision) {
+    var session = image.battleSessions().get(sessionId);
+    var cancellation = ArmyBattleSession.cancelled(session, TIME.plusSeconds(3));
+    var attacker = terminalArmy(cancellation.attackerAfter(), attackerDead);
+    var defender = terminalArmy(cancellation.defenderAfter(), defenderDead);
+    var resolution =
+        new ArmyBattleSession.Resolution(
+            ArmyBattleSession.Status.COMPLETED, attacker, defender, 0, 0, TIME.plusSeconds(3));
+    var sessions = new HashMap<>(image.battleSessions());
+    sessions.put(
+        sessionId, new ArmyBattleSession(session.request(), resolution, session.interventions()));
+    var armies = new HashMap<>(image.armies());
+    var tombstones = new HashMap<>(image.tombstones());
+    for (var effect : List.of(attacker, defender)) {
+      if (effect.isAlive()) armies.put(effect.token().armyId(), effect);
+      else {
+        armies.remove(effect.token().armyId());
+        tombstones.put(effect.token().armyId(), ArmyBattleState.defeated(effect, sessionId));
+      }
+    }
+    return copy(image, revision, armies, tombstones, sessions, image.skillUses());
+  }
+
+  private static ArmySnapshot terminalArmy(ArmySnapshot source, boolean dead) {
+    return new ArmySnapshot(
+        source.token(),
+        source.nationId(),
+        source.type(),
+        dead ? 0 : source.soldiers(),
+        dead ? 0 : source.health(),
+        source.morale(),
+        source.position(),
+        source.state(),
+        source.supply(),
+        source.supplyConsumptionRemainder(),
+        source.createdAt(),
+        source.lastUpdated());
+  }
+
+  private static void rejectsRow(ArmyAuthoritySnapshot image, byte[] bytes) {
+    var properties = ArmyAuthorityCodec.encode(image);
+    properties.setProperty("armyBattle." + BATTLE, Base64.getEncoder().encodeToString(bytes));
+    assertThrows(IllegalArgumentException.class, () -> ArmyAuthorityCodec.decode(properties));
+  }
