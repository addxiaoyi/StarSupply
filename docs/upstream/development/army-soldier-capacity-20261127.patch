+  private ArmyAuthoritySnapshot image(
+      Map<UUID, ArmySnapshot> armies,
+      Map<UUID, ArmyTombstone> tombstones,
+      Map<UUID, ArmyNationClosure> closures,
+      int version)
+      throws Exception {
+    return new ArmyAuthoritySnapshot(
+        true,
+        7,
+        armies,
+        tombstones,
+        Map.of(),
+        base().migration(),
+        version,
+        Map.of(),
