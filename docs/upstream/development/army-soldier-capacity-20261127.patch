+    removed.remove(WarAuthority.REPARATIONS);
+    assertThatThrownBy(() -> authority.save(removed)).hasMessageContaining("downgraded");
+    assertThat(setup.storage().prepareDisband(receipt.request())).isEqualTo(receipt);
+  }
