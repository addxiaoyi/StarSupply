+    }
+  }
+
+  private record BatchDto(
+      ReserveRequest request,
+      Plan plan,
+      PeaceTreatyBatch.Stage stage,
+      EndReceipt endReceipt,
+      OperationView terminalReceipt,
+      JsonElement cancelRequested,
+      Request binding) {
+    static BatchDto from(PeaceTreatyBatch batch) {
+      return new BatchDto(
+          batch.request(),
+          batch.plan(),
+          batch.stage(),
+          batch.endReceipt(),
+          batch.terminalReceipt(),
+          new JsonPrimitive(batch.cancelRequested()),
+          batch.binding());
+    }
+
+    PeaceTreatyBatch toDomain() {
+      if (cancelRequested != null
+          && (!cancelRequested.isJsonPrimitive()
+              || !cancelRequested.getAsJsonPrimitive().isBoolean()))
+        throw new IllegalArgumentException("Treaty cancellation intent must be a boolean");
+      return new PeaceTreatyBatch(
+          request,
+          plan,
+          stage,
+          endReceipt,
+          terminalReceipt,
+          cancelRequested != null && cancelRequested.getAsBoolean(),
+          binding);
     }
   }
 
