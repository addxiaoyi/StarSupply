+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Locale;
+import java.util.Objects;
+
+record PeaceTreatyBatch(
+    ReserveRequest request,
+    Plan plan,
+    Stage stage,
+    EndReceipt endReceipt,
+    OperationView terminalReceipt,
+    boolean cancelRequested,
+    Request binding) {
+  PeaceTreatyBatch(
+      ReserveRequest request,
+      Plan plan,
+      Stage stage,
+      EndReceipt endReceipt,
+      OperationView terminalReceipt) {
+    this(request, plan, stage, endReceipt, terminalReceipt, false, null);
+  }
+
+  PeaceTreatyBatch(
+      ReserveRequest request,
+      Plan plan,
+      Stage stage,
+      EndReceipt endReceipt,
+      OperationView terminalReceipt,
+      boolean cancelRequested) {
+    this(request, plan, stage, endReceipt, terminalReceipt, cancelRequested, null);
+  }
+
+  PeaceTreatyBatch {
+    Objects.requireNonNull(request, "request");
+    Objects.requireNonNull(stage, "stage");
+    if (plan != null && !plan.request().equals(request))
+      throw new IllegalArgumentException("Treaty batch plan request mismatch");
+    if (plan != null) {
+      var originals =
+          new HashMap<
+              Integer,
+              dev.starcore.starcore.module.diplomacy.DiplomacyTreatyOperationService.IndexedTerm>();
+      for (var term : request.terms()) originals.put(term.termIndex(), term);
+      var indexes = new HashSet<Integer>();
+      var restrictionIds = new HashSet<java.util.UUID>();
+      for (var term : plan.terms()) {
+        var original = originals.get(term.termIndex());
+        if (original == null
+            || !indexes.add(term.termIndex())
+            || !restrictionIds.add(term.restrictionId()))
+          throw new IllegalArgumentException("Treaty batch restriction manifest mismatch");
+        if (!term.requirement().equals(original.requirement().toLowerCase(Locale.ROOT))
+            || !term.description().equals(original.description())
+            || !term.nationId().equals(request.defeated())
+            || !term.imposedAt().equals(request.preparedAt()))
+          throw new IllegalArgumentException("Treaty batch restriction payload mismatch");
+      }
+      if (indexes.size() != request.terms().size())
+        throw new IllegalArgumentException("Treaty batch restriction manifest incomplete");
+    }
+    if (stage.ordinal() >= Stage.RESERVED.ordinal()
+        && stage.ordinal() <= Stage.WAR_ENDED.ordinal()
+        && plan == null) throw new IllegalArgumentException("Treaty batch plan missing");
+    if (binding != null
+        && (request.protocolVersion() != 2
+            || plan == null
+            || !expectedWarRequest(request, plan).equals(binding)))
+      throw new IllegalArgumentException("Treaty batch manifest binding mismatch");
+    if (request.protocolVersion() == 2
+        && binding == null
+        && (stage == Stage.MANIFEST_BOUND
+            || stage == Stage.WAR_PREPARED
+            || stage == Stage.WAR_ENDED))
+      throw new IllegalArgumentException("Treaty batch manifest binding missing");
+    if (request.protocolVersion() == 1 && stage == Stage.MANIFEST_BOUND)
+      throw new IllegalArgumentException("Legacy treaty batch cannot bind a manifest");
+    if (terminalReceipt != null
+        && (!terminalReceipt.request().equals(request)
+            || !terminalReceipt.terminal()
+            || !Objects.equals(terminalReceipt.plan(), plan)
+            || !Objects.equals(terminalReceipt.binding(), binding)))
+      throw new IllegalArgumentException("Treaty batch terminal receipt mismatch");
+    if (stage.ordinal() >= Stage.ACKED.ordinal() && terminalReceipt == null)
+      throw new IllegalArgumentException("Treaty batch terminal evidence missing");
+    if (endReceipt != null
+        && (plan == null
+            || request.protocolVersion() == 2 && binding == null
+            || !expectedWarRequest(request, plan).equals(endReceipt.request())))
+      throw new IllegalArgumentException("Treaty batch war end evidence mismatch");
+  }
+
+  static PeaceTreatyBatch prepare(ReserveRequest request) {
+    return new PeaceTreatyBatch(request, null, Stage.PREPARED, null, null);
+  }
+
+  PeaceTreatyBatch reserved(Plan value) {
+    return new PeaceTreatyBatch(
+        request, value, Stage.RESERVED, endReceipt, terminalReceipt, cancelRequested, binding);
+  }
+
+  PeaceTreatyBatch bound(Request value) {
+    if (binding != null && !binding.equals(value))
+      throw new IllegalArgumentException("Treaty batch manifest binding is immutable");
+    return new PeaceTreatyBatch(
+        request,
+        plan,
+        stage.ordinal() < Stage.MANIFEST_BOUND.ordinal() ? Stage.MANIFEST_BOUND : stage,
+        endReceipt,
+        terminalReceipt,
+        cancelRequested,
+        Objects.requireNonNull(value));
+  }
+
+  Request expectedBinding() {
+    return expectedWarRequest(request, Objects.requireNonNull(plan, "plan"));
+  }
+
+  PeaceTreatyBatch advance(Stage value) {
+    return new PeaceTreatyBatch(
+        request, plan, value, endReceipt, terminalReceipt, cancelRequested, binding);
+  }
+
+  PeaceTreatyBatch ended(EndReceipt receipt) {
+    return new PeaceTreatyBatch(
+        request, plan, Stage.WAR_ENDED, receipt, terminalReceipt, cancelRequested, binding);
+  }
+
+  PeaceTreatyBatch acknowledged(OperationView receipt) {
+    return new PeaceTreatyBatch(
+        request, receipt.plan(), Stage.ACKED, endReceipt, receipt, cancelRequested, binding);
+  }
+
+  PeaceTreatyBatch requestedCancellation() {
+    return new PeaceTreatyBatch(request, plan, stage, endReceipt, terminalReceipt, true, binding);
+  }
+
+  boolean terminal() {
+    return stage == Stage.RELEASED;
+  }
+
+  Request warRequest() {
+    if (request.protocolVersion() == 2) return Objects.requireNonNull(binding, "manifest binding");
+    return expectedBinding();
+  }
+
+  private static Request expectedWarRequest(ReserveRequest request, Plan plan) {
+    var scopes = plan.pairs().stream().map(pair -> pair.pair()).toList();
+    var manifest =
+        request.protocolVersion() == 2
+            ? TreatyEffectManifest.singleDiplomacy(request.envelope(), plan.planHash(), scopes)
+            : null;
+    return new Request(
+        request.operationId(),
+        request.treatyId(),
+        request.war(),
+        request.warGeneration(),
+        request.warFingerprint(),
+        scopes,
+        manifest == null ? plan.planHash() : TreatyEffectManifest.manifestHash(manifest),
+        request.preparedAt(),
+        request.protocolVersion(),
+        manifest);
+  }
+
+  static List<OriginalTerm> originalTerms(List<PeaceTreaty.PeaceTerm> terms) {
+    var result = new ArrayList<OriginalTerm>();
+    for (int index = 0; index < terms.size(); index++) {
+      var term = terms.get(index);
+      List<String> payload =
+          switch (term) {
+            case PeaceTreaty.PoliticalTerm value -> List.of(value.requirement());
+            case PeaceTreaty.ReparationTerm value ->
+                List.of(value.amount().toString(), Integer.toString(value.installments()));
+            case PeaceTreaty.TerritorialCessionTerm value -> List.copyOf(value.territoryIds());
+            case PeaceTreaty.MilitaryRestrictionTerm value ->
+                List.of(
+                    Integer.toString(value.maxArmySize()), Boolean.toString(value.disarmament()));
+            case PeaceTreaty.ResourceTributeTerm value ->
+                List.of(
+                    value.resourceType(),
+                    Integer.toString(value.amount()),
+                    Integer.toString(value.durationMonths()));
+            default -> throw new IllegalArgumentException("Unknown original treaty term type");
+          };
+      result.add(
+          new OriginalTerm(index, term.getClass().getSimpleName(), payload, term.description()));
+    }
+    return List.copyOf(result);
+  }
+
+  void validateTreaty(PeaceTreaty treaty) {
+    if (!request.treatyId().equals(treaty.id())
+        || !request.war().warId().equals(treaty.warId())
+        || !request.victor().equals(treaty.victor())
+        || !request.defeated().equals(treaty.defeated())
+        || request.originalTermCount() != treaty.terms().size()
+        || request.terms().size() != treaty.terms().size())
+      throw new IllegalArgumentException("Treaty batch identity mismatch");
+    if (request.protocolVersion() == 2
+        && !request.envelope().originalTerms().equals(originalTerms(treaty.terms())))
+      throw new IllegalArgumentException("Treaty batch full original payload mismatch");
+    for (int index = 0; index < treaty.terms().size(); index++) {
+      if (!(treaty.terms().get(index) instanceof PeaceTreaty.PoliticalTerm political))
+        throw new IllegalArgumentException("Treaty batch contains unsupported original terms");
+      var term = request.terms().get(index);
+      if (term.termIndex() != index
+          || !term.type().equals("PoliticalTerm")
+          || !term.requirement().equals(political.requirement())
+          || !term.description().equals(political.description()))
+        throw new IllegalArgumentException("Treaty batch original term mismatch");
+    }
+  }
+
+  void validateSuccessor(PeaceTreatyBatch next) {
+    if (!request.equals(next.request)
+        || plan != null && !plan.equals(next.plan)
+        || binding != null && !binding.equals(next.binding)
+        || endReceipt != null && !endReceipt.equals(next.endReceipt)
+        || terminalReceipt != null && !terminalReceipt.equals(next.terminalReceipt)
+        || cancelRequested && !next.cancelRequested
+        || next.stage.ordinal() < stage.ordinal()
+        || terminal() && !equals(next))
+      throw new IllegalArgumentException("Treaty batch evidence is immutable");
+  }
+
+  enum Stage {
+    PREPARED,
+    RESERVED,
+    MANIFEST_BOUND,
+    WAR_PREPARED,
+    WAR_ENDED,
+    ACKED,
+    RELEASED
+  }
+}
