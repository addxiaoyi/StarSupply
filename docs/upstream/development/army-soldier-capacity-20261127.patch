+package dev.starcore.starcore.module.army.model.authority;
+
+import dev.starcore.starcore.module.treasury.NationDebitService;
+import java.util.Objects;
+
+public record ArmyPaidOperation(
+    ArmyPaidRequest request,
+    boolean cancellationRequested,
+    NationDebitService.Receipt debitReceipt) {
+  public ArmyPaidOperation {
+    Objects.requireNonNull(request, "request");
+    if (debitReceipt != null && !request.debitRequest().equals(debitReceipt.request())) {
+      throw new IllegalArgumentException("Paid Army receipt differs from its exact debit request");
+    }
+  }
+
+  public boolean pending() {
+    return debitReceipt == null;
+  }
+
+  public boolean applied() {
+    return debitReceipt != null && debitReceipt.status() == NationDebitService.Status.APPLIED;
+  }
+}
diff --git a/src/main/java/dev/starcore/starcore/module/army/model/authority/ArmyPaidRequest.java b/src/main/java/dev/starcore/starcore/module/army/model/authority/ArmyPaidRequest.java
new file mode 100644
index 0000000000000000000000000000000000000000..00af641b7873d15f304046684328f6380c961d7b
--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/module/army/model/authority/ArmyPaidRequest.java
@@ -0,0 +1,229 @@
+package dev.starcore.starcore.module.army.model.authority;
+
+import dev.starcore.starcore.module.nation.model.NationId;
+import dev.starcore.starcore.module.treasury.NationDebitService;
+import java.io.DataOutputStream;
+import java.io.IOException;
+import java.io.OutputStream;
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.nio.charset.StandardCharsets;
+import java.security.DigestOutputStream;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.time.Instant;
+import java.util.HexFormat;
+import java.util.Objects;
+import java.util.UUID;
+
+public record ArmyPaidRequest(
+    UUID operationId,
+    UUID actorId,
+    Kind kind,
+    ArmySnapshot before,
+    ArmySnapshot after,
+    BigDecimal amount,
+    Instant acceptedAt,
+    int maximumNationArmies,
+    long maximumNationSoldiers) {
+  private static final BigDecimal MAXIMUM_AMOUNT = new BigDecimal("1000000000000000.00");
+  private static final BigDecimal MINIMUM_AMOUNT = new BigDecimal("0.01");
+  private static final String FUNDING_POLICY = "TREASURY_DIRECT";
+
+  /** Legacy requests keep their original digest and unrestricted aggregate quota. */
+  public ArmyPaidRequest(
+      UUID operationId,
+      UUID actorId,
+      Kind kind,
+      ArmySnapshot before,
+      ArmySnapshot after,
+      BigDecimal amount,
+      Instant acceptedAt,
+      int maximumNationArmies) {
+    this(
+        operationId,
+        actorId,
+        kind,
+        before,
+        after,
+        amount,
+        acceptedAt,
+        maximumNationArmies,
+        Long.MAX_VALUE);
+  }
+
+  public ArmyPaidRequest {
+    Objects.requireNonNull(operationId, "operationId");
+    Objects.requireNonNull(actorId, "actorId");
+    Objects.requireNonNull(kind, "kind");
+    Objects.requireNonNull(after, "after");
+    Objects.requireNonNull(amount, "amount");
+    Objects.requireNonNull(acceptedAt, "acceptedAt");
+    if (amount.compareTo(MINIMUM_AMOUNT) < 0 || amount.compareTo(MAXIMUM_AMOUNT) > 0) {
+      throw new IllegalArgumentException("Paid Army amount must be between 0.01 and 10^15");
+    }
+    try {
+      amount = amount.setScale(2, RoundingMode.UNNECESSARY);
+    } catch (ArithmeticException error) {
+      throw new IllegalArgumentException(
+          "Paid Army amount must have at most two decimal places", error);
+    }
+    if (!acceptedAt.isAfter(Instant.EPOCH)) {
+      throw new IllegalArgumentException("Paid Army acceptance must be after the epoch");
+    }
+    if (maximumNationArmies < 1) {
+      throw new IllegalArgumentException("Paid Army capacity must be positive");
+    }
+    if (maximumNationSoldiers < 0
+        || kind == Kind.CREATE && after.soldiers() > maximumNationSoldiers) {
+      throw new IllegalArgumentException("Paid Army creation exceeds its total soldier quota");
+    }
+    requireUnicode(after.position().worldName());
+    if (!after.isAlive() || !after.lastUpdated().equals(acceptedAt)) {
+      throw new IllegalArgumentException("Paid Army effect must be alive and accepted at its time");
+    }
+    if (kind == Kind.CREATE) {
+      if (before != null
+          || after.token().generation() != 1
+          || !after.createdAt().equals(acceptedAt)) {
+        throw new IllegalArgumentException("Paid Army creation requires a fresh accepted identity");
+      }
+    } else {
+      Objects.requireNonNull(before, "before");
+      requireUnicode(before.position().worldName());
+      if (!before.isAlive()
+          || before.token().generation() == Long.MAX_VALUE
+          || after.supply() <= before.supply()) {
+        throw new IllegalArgumentException(
+            "Paid Army resupply requires a live increasing successor");
+      }
+      var expected =
+          new ArmySnapshot(
+              new ArmyToken(
+                  before.token().armyId(),
+                  before.token().incarnation(),
+                  before.token().generation() + 1),
+              before.nationId(),
+              before.type(),
+              before.soldiers(),
+              before.health(),
+              before.morale(),
+              before.position(),
+              before.state(),
+              after.supply(),
+              before.supplyConsumptionRemainder(),
+              before.createdAt(),
+              acceptedAt);
+      if (!expected.equals(after)) {
+        throw new IllegalArgumentException(
+            "Paid Army resupply may change only supply and its token");
+      }
+    }
+  }
+
+  public String requestDigest() {
+    MessageDigest digest;
+    try {
+      digest = MessageDigest.getInstance("SHA-256");
+    } catch (NoSuchAlgorithmException impossible) {
+      throw new IllegalStateException("SHA-256 unavailable", impossible);
+    }
+    try (var output =
+        new DataOutputStream(new DigestOutputStream(OutputStream.nullOutputStream(), digest))) {
+      writeString(
+          output,
+          maximumNationSoldiers == Long.MAX_VALUE
+              ? "army-paid-request:v1"
+              : "army-paid-request:v2");
+      writeString(output, FUNDING_POLICY);
+      writeUuid(output, operationId);
+      writeUuid(output, actorId);
+      writeString(output, kind.name());
+      output.writeBoolean(before != null);
+      if (before != null) writeSnapshot(output, before);
+      writeSnapshot(output, after);
+      writeString(output, amount.toPlainString());
+      writeInstant(output, acceptedAt);
+      output.writeInt(maximumNationArmies);
+      if (maximumNationSoldiers != Long.MAX_VALUE) output.writeLong(maximumNationSoldiers);
+    } catch (IOException impossible) {
+      throw new IllegalStateException("Unable to encode paid Army request", impossible);
+    }
+    return HexFormat.of().formatHex(digest.digest());
+  }
+
+  public NationDebitService.Request debitRequest() {
+    return new NationDebitService.Request(
+        operationId, new NationId(nationId()), amount, "army-paid:v1:" + requestDigest());
+  }
+
+  public UUID armyId() {
+    return after.token().armyId();
+  }
+
+  public UUID nationId() {
+    return after.nationId();
+  }
+
+  private static void writeSnapshot(DataOutputStream output, ArmySnapshot snapshot)
+      throws IOException {
+    writeUuid(output, snapshot.token().armyId());
+    writeUuid(output, snapshot.token().incarnation());
+    output.writeLong(snapshot.token().generation());
+    writeUuid(output, snapshot.nationId());
+    writeString(output, snapshot.type().name());
+    output.writeInt(snapshot.soldiers());
+    output.writeLong(Double.doubleToLongBits(snapshot.health()));
+    output.writeLong(Double.doubleToLongBits(snapshot.morale()));
+    ArmyPosition position = snapshot.position();
+    output.writeBoolean(position.worldId() != null);
+    if (position.worldId() != null) writeUuid(output, position.worldId());
+    writeString(output, position.worldName());
+    output.writeLong(Double.doubleToLongBits(position.x()));
+    output.writeLong(Double.doubleToLongBits(position.y()));
+    output.writeLong(Double.doubleToLongBits(position.z()));
+    output.writeInt(Float.floatToIntBits(position.yaw()));
+    output.writeInt(Float.floatToIntBits(position.pitch()));
+    writeString(output, snapshot.state().name());
+    output.writeInt(snapshot.supply());
+    output.writeInt(snapshot.supplyConsumptionRemainder());
+    writeInstant(output, snapshot.createdAt());
+    writeInstant(output, snapshot.lastUpdated());
+  }
+
+  private static void writeUuid(DataOutputStream output, UUID value) throws IOException {
+    output.writeLong(value.getMostSignificantBits());
+    output.writeLong(value.getLeastSignificantBits());
+  }
+
+  private static void writeInstant(DataOutputStream output, Instant value) throws IOException {
+    output.writeLong(value.getEpochSecond());
+    output.writeInt(value.getNano());
+  }
+
+  private static void writeString(DataOutputStream output, String value) throws IOException {
+    requireUnicode(value);
+    byte[] bytes = value.getBytes(StandardCharsets.UTF_8);
+    output.writeInt(bytes.length);
+    output.write(bytes);
+  }
+
+  private static void requireUnicode(String value) {
+    for (int index = 0; index < value.length(); index++) {
+      char character = value.charAt(index);
+      if (Character.isHighSurrogate(character)) {
+        if (index + 1 == value.length() || !Character.isLowSurrogate(value.charAt(index + 1))) {
+          throw new IllegalArgumentException("Paid Army text contains an unpaired surrogate");
+        }
+        index++;
+      } else if (Character.isLowSurrogate(character)) {
+        throw new IllegalArgumentException("Paid Army text contains an unpaired surrogate");
+      }
+    }
+  }
+
+  public enum Kind {
+    CREATE,
+    RESUPPLY
+  }
+}
diff --git a/src/main/java/dev/starcore/starcore/module/army/model/authority/ArmyPosition.java b/src/main/java/dev/starcore/starcore/module/army/model/authority/ArmyPosition.java
