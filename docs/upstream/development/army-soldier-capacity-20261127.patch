+/**
+ * Actual war file/SQLite authority; the controlled money receiver isolates the war-side protocol.
+ */
+class WarDeclarationRecoveryTest {
+  @TempDir Path root;
+  final NationId a = NationId.random(), b = NationId.random();
+  final List<WarServiceImpl> services = new ArrayList<>();
+
+  @AfterEach
