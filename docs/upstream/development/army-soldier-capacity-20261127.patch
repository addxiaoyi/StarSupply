+  private ArmyAuthorityOwner seed(boolean sqlite, Path path, double health) throws Exception {
+    var store = storage(sqlite, path, UNBOUNDED);
+    store.initializeFromLegacy(ArmyLegacyImporter.inspect(new byte[0], "battle-intervention"));
+    var owner = new ArmyAuthorityOwner(store);
+    owner.refresh();
+    for (long identity = 1; identity <= 5; identity++) owner.create(army(identity, health));
+    owner.startBattle(
+        new ArmyBattleRequest(BATTLE, new UUID(9, 1), army(1, health), army(2, health), TIME));
+    owner.startBattle(
+        new ArmyBattleRequest(
+            OTHER_BATTLE, new UUID(9, 2), army(4, health), army(3, health), TIME));
+    return owner;
+  }
+
+  private ArmyAuthorityOwner reopen(boolean sqlite, Path path, long maximum) throws Exception {
+    var owner = new ArmyAuthorityOwner(storage(sqlite, path, maximum));
+    owner.refresh();
+    return owner;
+  }
+
+  private ArmyAuthorityStorage storage(boolean sqlite, Path path, long maximum) throws Exception {
+    Files.createDirectories(path);
+    if (!sqlite) return new ArmyFileAuthorityStorage(path.resolve("authority"), maximum);
+    var source = new SQLiteDataSource();
+    source.setUrl("jdbc:sqlite:" + path.resolve("army.db"));
+    return new ArmySqlAuthorityStorage(path.resolve("authority"), source, maximum);
+  }
+
+  private static ArmySkillRequest national(ArmyAuthorityOwner owner, long operation, Instant at) {
+    var targets = new HashMap<UUID, ArmySnapshot>();
+    owner.nationArmies(NATION).forEach(army -> targets.put(army.token().armyId(), army));
+    return new ArmySkillRequest(
+        new UUID(4, operation),
+        new UUID(7, operation),
+        NATION,
+        SkillType.INSPIRE,
+        1,
+        1,
+        null,
+        at,
+        null,
+        targets);
+  }
+
+  private static ArmySkillRequest targeted(
+      ArmyAuthorityOwner owner, UUID armyId, SkillType type, long operation, Instant at) {
+    var target = owner.army(armyId).orElseThrow();
+    return new ArmySkillRequest(
+        new UUID(4, operation),
+        new UUID(7, operation),
+        type == SkillType.CAVALRY_CHARGE ? NATION : target.nationId(),
+        type,
+        1,
+        1,
+        null,
+        at,
+        null,
+        Map.of(armyId, target));
+  }
+
+  private static ArmySnapshot army(long identity, double health) {
+    return new ArmySnapshot(
+        new ArmyToken(id(identity), new UUID(1, identity), 1),
+        identity == 2 ? ENEMY_NATION : identity == 4 ? new UUID(2, 3) : NATION,
+        ArmyType.INFANTRY,
+        100,
+        health,
+        40,
+        new ArmyPosition(new UUID(0, 100), "world: = 漢字", 0, 64, 0, 0, 0),
+        ArmyState.STATIONARY,
+        30,
+        17,
+        TIME.minusSeconds(10),
+        TIME.minusSeconds(1));
+  }
+
+  private static UUID id(long value) {
+    return new UUID(0, value);
+  }
+
+  private static long capacity(ArmyAuthoritySnapshot image) {
+    return AbstractArmyAuthorityStorage.serializedEnvelopeSize(
+        AbstractArmyAuthorityStorage.completionCapacity(image), Long.MAX_VALUE);
+  }
+
+  private static ArmyAuthoritySnapshot copy(
+      ArmyAuthoritySnapshot image,
+      long revision,
+      Map<UUID, ArmySnapshot> armies,
+      Map<UUID, ArmyTombstone> tombstones,
+      Map<UUID, ArmyBattleSession> battles,
+      Map<UUID, ArmySkillUse> skills) {
+    return new ArmyAuthoritySnapshot(
+        true,
+        revision,
+        armies,
+        tombstones,
+        image.receipts(),
+        image.migration(),
+        6,
+        image.paidOperations(),
+        battles,
+        skills,
+        image.nationClosures());
+  }
