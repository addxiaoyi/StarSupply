+  void assertBackupEvidence(ArmyAuthoritySnapshot baseline, Path file, byte[] bytes)
+      throws Exception {
+    var backup = descriptor(baseline).getAsJsonObject("passiveBackup");
+    assertThat(backup.get("path").getAsString())
+        .isEqualTo(AtomicFilePersistence.backup(file).toString());
+    assertThat(backup.get("policy").getAsString()).isEqualTo("OBSERVED_NOT_IMPORTED");
+    if (bytes == null) {
+      assertThat(backup.get("state").getAsString()).isEqualTo("MISSING");
+      assertThat(backup.get("size").isJsonNull()).isTrue();
+      assertThat(backup.get("sha256").isJsonNull()).isTrue();
+    } else {
+      assertThat(backup.get("state").getAsString()).isEqualTo("PRESENT");
+      assertThat(backup.get("size").getAsLong()).isEqualTo(bytes.length);
+      assertThat(backup.get("sha256").getAsString())
+          .isEqualTo(HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256").digest(bytes)));
+    }
+  }
