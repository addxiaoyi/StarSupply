+class EventAllianceInboxTest {
+  @TempDir Path root;
+  final NationId left = NationId.random();
+  final NationId right = NationId.random();
+  final Instant occurredAt = Instant.parse("2026-11-27T00:00:00Z");
+  final UUID eventId = UUID.randomUUID();
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void repeatedDeliveryAcrossRestartCommitsBothRecipientsOnce(boolean sql) {
+    try (var fixture = new Fixture(root, sql)) {
+      var module = fixture.open();
+      assertThat(module.recordAllianceOnce(eventId, left, right, true, occurredAt)).isTrue();
+      var original = List.copyOf(module.eventsOf(left));
+      assertThat(original).hasSize(1);
+      assertThat(original.getFirst().occurredAt()).isEqualTo(occurredAt);
