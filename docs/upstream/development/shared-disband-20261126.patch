+package dev.starcore.starcore.module.war;
+
+import dev.starcore.starcore.module.nation.model.NationId;
+import java.util.Objects;
+import java.util.Set;
+import java.util.UUID;
+
+/** Original retirement result, including identities needed to reject delayed snapshots. */
+public record WarRetirementReceipt(
+    UUID operationId,
+    NationId nationId,
+    Set<UUID> warIds,
+    Set<UUID> treatyIds,
+    Set<UUID> battlefieldIds) {
+  public WarRetirementReceipt {
+    Objects.requireNonNull(operationId);
+    Objects.requireNonNull(nationId);
+    warIds = Set.copyOf(warIds);
+    treatyIds = Set.copyOf(treatyIds);
+    battlefieldIds = Set.copyOf(battlefieldIds);
+  }
+}
