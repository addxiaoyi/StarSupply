+  @Test
+  void committedResponseLossIsConfirmedOrFrozenUntilReload() throws Exception {
+    var f = fixture(true);
+    var source = f.database.dataSource().orElseThrow();
+    var armed = new java.util.concurrent.atomic.AtomicBoolean();
+    var loseRead = new java.util.concurrent.atomic.AtomicBoolean();
+    var offline = new java.util.concurrent.atomic.AtomicBoolean();
+    DataSource proxy =
+        (DataSource)
+            java.lang.reflect.Proxy.newProxyInstance(
+                getClass().getClassLoader(),
+                new Class<?>[] {DataSource.class},
+                (p, m, args) -> {
+                  if (!m.getName().equals("getConnection")) return invoke(source, m, args);
+                  if (offline.get()) throw new SQLException("readback offline");
+                  Connection actual = (Connection) invoke(source, m, args);
+                  return java.lang.reflect.Proxy.newProxyInstance(
+                      getClass().getClassLoader(),
+                      new Class<?>[] {Connection.class},
+                      (cp, cm, ca) -> {
+                        Object value = invoke(actual, cm, ca);
+                        if (cm.getName().equals("commit") && armed.compareAndSet(true, false)) {
+                          if (loseRead.get()) offline.set(true);
+                          throw new SQLException("committed but response lost");
+                        }
+                        return value;
+                      });
+                });
+    when(f.database.dataSource()).thenReturn(Optional.of(proxy));
+    var store = f.storage();
+    seed(store);
+    var first = UUID.randomUUID();
+    armed.set(true);
+    assertThat(store.retireNationWars(first, a).operationId()).isEqualTo(first);
+    var next = UUID.randomUUID();
+    loseRead.set(true);
+    armed.set(true);
+    assertThatThrownBy(() -> store.retireNationWars(next, b))
+        .isInstanceOf(IllegalStateException.class);
+    assertThatThrownBy(() -> store.saveWar(War.declare("late", c, d, WarGoal.TERRITORIAL)))
+        .hasMessageContaining("unavailable");
+    offline.set(false);
+    store.loadAllWars();
+    assertThat(store.retireNationWars(next, b).operationId()).isEqualTo(next);
+    assertThat(f.storage().warRetirementReceipt(a).orElseThrow().operationId()).isEqualTo(first);
+  }
+
+  private static Object invoke(Object target, java.lang.reflect.Method method, Object[] args)
+      throws Throwable {
+    try {
+      return method.invoke(target, args);
+    } catch (java.lang.reflect.InvocationTargetException error) {
+      throw error.getCause();
+    }
+  }
