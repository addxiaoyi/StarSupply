diff --git a/src/main/java/dev/starcore/starcore/core/persistence/DurablePropertiesStore.java b/src/main/java/dev/starcore/starcore/core/persistence/DurablePropertiesStore.java
new file mode 100644
--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/core/persistence/DurablePropertiesStore.java
@@ -0,0 +1,416 @@
+package dev.starcore.starcore.core.persistence;
+
+import java.io.*;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.*;
+import java.security.MessageDigest;
+import java.sql.*;
+import java.util.*;
+import java.util.function.*;
+import javax.sql.DataSource;
+
+/** One fixed file/SQL authority; full snapshots use CAS and readback confirmation. */
+public final class DurablePropertiesStore {
+  public static final String REVISION = "state.revision";
+  private static final String HASH = "authority.sha256", VERSION = "authority.version";
+  private static final int MAX_BYTES = 64 * 1024 * 1024;
+  private static final Object[] GUARDS = new Object[64];
+
+  static {
+    Arrays.setAll(GUARDS, ignored -> new Object());
+  }
+
+  private final Supplier<DataSource> dataSource;
+  private final Path file;
+  private final String table;
+  private final boolean sql;
+  private final Supplier<Properties> legacy;
+  private final Consumer<Properties> validator;
+  private final BiConsumer<Properties, Properties> transitionValidator;
+  private final BiFunction<Long, Long, RuntimeException> conflict;
+  private Properties observed;
+  private byte[] expectedFile;
+  private boolean failed, fileSeen;
+
+  public DurablePropertiesStore(
+      Path file,
+      Supplier<DataSource> dataSource,
+      String table,
+      Supplier<Properties> legacy,
+      Consumer<Properties> validator,
+      BiConsumer<Properties, Properties> transitionValidator) {
+    this.file = Objects.requireNonNull(file).toAbsolutePath().normalize();
+    this.dataSource = dataSource;
+    this.sql = dataSource != null;
+    if (!table.matches("starcore_[a-z_]+"))
+      throw new IllegalArgumentException("Invalid authority table");
+    this.table = table;
+    this.legacy = Objects.requireNonNull(legacy);
+    this.validator = Objects.requireNonNull(validator);
+    this.transitionValidator = Objects.requireNonNull(transitionValidator);
+    this.conflict =
+        (expected, actual) ->
+            new IllegalStateException(
+                "Authority version conflict: expected " + expected + ", found " + actual);
+  }
+
+  public synchronized Properties load() {
+    try {
+      Properties value;
+      if (sql) {
+        try (Connection connection = connection()) {
+          initializeTable(connection);
+          value = readSql(connection);
+        }
+        if (isEmptySql(value)) {
+          if (revision(value) != 0 || observed != null && !isEmptySql(observed))
+            throw new IllegalStateException("Missing snapshot SQL authority");
+          Properties migrated = legacy.get();
+          validate(migrated);
+          if (!migrated.isEmpty()) {
+            Properties candidate = copy(migrated);
+            candidate.setProperty(REVISION, "1");
+            candidate = seal(candidate);
+            writeSql(candidate, value);
+            value = candidate;
+          }
+        }
+      } else {
+        Path path = path();
+        byte[] bytes = readFile(path);
+        if (bytes == null
+            && (fileSeen
+                || Files.exists(AtomicFilePersistence.backup(path))
+                || Files.exists(AtomicFilePersistence.temp(path))
+                || Files.exists(initializedMarker())))
+          throw new IllegalStateException("Missing snapshot file authority");
+        value = bytes == null ? legacy.get() : decode(bytes);
+        if (bytes != null) validatePersisted(value);
+        validate(value);
+        expectedFile = bytes;
+        fileSeen |= bytes != null;
+      }
+      validate(value);
+      if (observed != null) transition(observed, value);
+      observed = copy(value);
+      failed = false;
+      return copy(value);
+    } catch (IOException | SQLException | RuntimeException error) {
+      failed = true;
+      if (error instanceof RuntimeException runtime) throw runtime;
+      throw new IllegalStateException("Unable to load snapshot authority", error);
+    }
+  }
+
+  public synchronized Properties snapshot() {
+    if (observed == null) return load();
+    if (failed) throw new IllegalStateException("Snapshot authority unavailable");
+    return copy(observed);
+  }
+
+  private static boolean isEmptySql(Properties value) {
+    return value.isEmpty() || value.size() == 1 && value.containsKey(REVISION);
+  }
+
+  /** Replaces the complete domain snapshot after verifying its observed predecessor. */
+  public synchronized void save(Properties update) {
+    if (observed == null) load();
+    if (failed) throw new IllegalStateException("Snapshot authority unavailable; reload required");
+    Properties candidate = copy(update);
+    candidate.setProperty(REVISION, Long.toString(Math.addExact(revision(observed), 1)));
+    candidate = seal(candidate);
+    transition(observed, candidate);
+    try {
+      if (sql) writeSql(candidate, observed);
+      else writeFile(candidate);
+      observed = copy(candidate);
+    } catch (RuntimeException error) {
+      try {
+        Properties actual = load();
+        if (actual.equals(candidate)) return;
+      } catch (RuntimeException unreadable) {
+        failed = true;
+        error.addSuppressed(unreadable);
+      }
+      throw error;
+    }
+  }
+
+  private void writeFile(Properties candidate) {
+    try {
+      Path path = path();
+      synchronized (GUARDS[Math.floorMod(path.hashCode(), GUARDS.length)]) {
+        byte[] current = readFile(path);
+        if (!Arrays.equals(expectedFile, current))
+          throw conflict.apply(
+              revision(observed), revision(current == null ? new Properties() : decode(current)));
+        if (!Files.exists(initializedMarker()))
+          AtomicFilePersistence.replace(
+              initializedMarker(), temp -> Files.writeString(temp, "1\n"));
+        var output = new ByteArrayOutputStream();
+        candidate.store(output, "STARCORE snapshot authority");
+        byte[] bytes = output.toByteArray();
+        if (bytes.length > MAX_BYTES) throw new IOException("Snapshot too large");
+        AtomicFilePersistence.replace(path, temp -> Files.write(temp, bytes));
+        if (!Arrays.equals(readFile(path), bytes)) throw new IOException("Snapshot not published");
+        expectedFile = bytes;
+        fileSeen = true;
+      }
+    } catch (IOException error) {
+      throw new IllegalStateException("Unable to save snapshot authority", error);
+    }
+  }
+
+  private void writeSql(Properties candidate, Properties expected) {
+    for (int attempt = 0; ; attempt++) {
+      try (Connection connection = connection()) {
+        initializeTable(connection);
+        connection.setAutoCommit(false);
+        try {
+          Properties current = readSql(connection);
+          if (!current.equals(expected))
+            throw conflict.apply(revision(expected), revision(current));
+          validate(current);
+          transition(current, candidate);
+          try (var update =
+              connection.prepareStatement(
+                  "UPDATE "
+                      + table
+                      + " SET property_value=? WHERE property_key=? AND property_value=?")) {
+            update.setString(1, candidate.getProperty(REVISION));
+            update.setString(2, REVISION);
+            update.setString(3, Long.toString(revision(expected)));
+            if (update.executeUpdate() != 1)
+              throw conflict.apply(revision(expected), revision(readSql(connection)));
+          }
+          try (var delete =
+              connection.prepareStatement("DELETE FROM " + table + " WHERE property_key<>?")) {
+            delete.setString(1, REVISION);
+            delete.executeUpdate();
+          }
+          try (var insert =
+              connection.prepareStatement(
+                  "INSERT INTO " + table + " (property_key, property_value) VALUES (?,?)")) {
+            for (String key : candidate.stringPropertyNames()) {
+              if (REVISION.equals(key)) continue;
+              insert.setString(1, key);
+              insert.setString(2, candidate.getProperty(key));
+              insert.addBatch();
+            }
+            insert.executeBatch();
+          }
+          if (!sqlInitialized(connection)) {
+            try (var marker =
+                connection.prepareStatement(
+                    "INSERT INTO "
+                        + table
+                        + "_metadata (singleton_id, format_version) VALUES (1,1)")) {
+              marker.executeUpdate();
+            }
+          }
+          connection.commit();
+          return;
+        } catch (SQLException | RuntimeException error) {
+          try {
+            connection.rollback();
+          } catch (SQLException rollback) {
+            error.addSuppressed(rollback);
+          }
+          throw error;
+        }
+      } catch (SQLException error) {
+        if (attempt >= 3 || !sqliteBusy(error))
+          throw new IllegalStateException("Unable to save snapshot SQL authority", error);
+        try {
+          Thread.sleep(25L * (attempt + 1));
+        } catch (InterruptedException interrupted) {
+          Thread.currentThread().interrupt();
+          throw new IllegalStateException(interrupted);
+        }
+      }
+    }
+  }
+
+  private static boolean sqliteBusy(SQLException error) {
+    String message = Objects.toString(error.getMessage(), "").toLowerCase(Locale.ROOT);
+    return message.contains("sqlite_busy")
+        || message.contains("sqlite_locked")
+        || message.contains("database is locked");
+  }
+
+  private Connection connection() throws SQLException {
+    return Objects.requireNonNull(dataSource.get(), "Authority database unavailable")
+        .getConnection();
+  }
+
+  private Path path() {
+    return file;
+  }
+
+  private Path initializedMarker() {
+    return file.resolveSibling(file.getFileName() + ".initialized");
+  }
+
+  private void initializeTable(Connection connection) throws SQLException {
+    try (var statement = connection.createStatement()) {
+      statement.execute(
+          "CREATE TABLE IF NOT EXISTS "
+              + table
+              + " (property_key VARCHAR(191) PRIMARY KEY, property_value TEXT NOT NULL)");
+      statement.execute(
+          "CREATE TABLE IF NOT EXISTS "
+              + table
+              + "_metadata (singleton_id INTEGER PRIMARY KEY, format_version INTEGER NOT NULL)");
+    }
+    if (!revisionExists(connection)) {
+      if (sqlInitialized(connection))
+        throw new IllegalStateException("Missing snapshot SQL authority revision");
+      try (var statement = connection.createStatement();
+          var rows = statement.executeQuery("SELECT COUNT(*) FROM " + table)) {
+        if (rows.next() && rows.getLong(1) != 0)
+          throw new IllegalStateException("Missing snapshot SQL authority revision");
+      }
+      try (var insert =
+          connection.prepareStatement(
+              "INSERT INTO " + table + " (property_key, property_value) VALUES (?,?)")) {
+        insert.setString(1, REVISION);
+        insert.setString(2, "0");
+        try {
+          insert.executeUpdate();
+        } catch (SQLException race) {
+          if (!revisionExists(connection)) throw race;
+        }
+      }
+    }
+  }
+
+  private boolean revisionExists(Connection connection) throws SQLException {
+    try (var statement =
+        connection.prepareStatement("SELECT 1 FROM " + table + " WHERE property_key=?")) {
+      statement.setString(1, REVISION);
+      try (var rows = statement.executeQuery()) {
+        return rows.next();
+      }
+    }
+  }
+
+  private Properties readSql(Connection connection) throws SQLException {
+    var value = new Properties();
+    try (var statement = connection.createStatement();
+        var rows = statement.executeQuery("SELECT property_key, property_value FROM " + table)) {
+      while (rows.next()) value.setProperty(rows.getString(1), rows.getString(2));
+    }
+    if (isEmptySql(value)) {
+      if (sqlInitialized(connection))
+        throw new IllegalStateException("Missing snapshot SQL authority");
+    } else {
+      if (!sqlInitialized(connection))
+        throw new IllegalStateException("Missing snapshot SQL authority marker");
+      validatePersisted(value);
+    }
+    return value;
+  }
+
+  private boolean sqlInitialized(Connection connection) throws SQLException {
+    try (var statement = connection.createStatement();
+        var rows =
+            statement.executeQuery(
+                "SELECT singleton_id,format_version FROM " + table + "_metadata")) {
+      if (!rows.next()) return false;
+      if (rows.getInt(1) != 1 || rows.getInt(2) != 1 || rows.next())
+        throw new IllegalStateException("Invalid snapshot SQL authority marker");
+      return true;
+    }
+  }
+
+  private static byte[] readFile(Path path) throws IOException {
+    if (!Files.exists(path)) return null;
+    if (!Files.isRegularFile(path) || Files.size(path) > MAX_BYTES)
+      throw new IOException("Invalid snapshot file");
+    try (var input = Files.newInputStream(path)) {
+      byte[] bytes = input.readNBytes(MAX_BYTES + 1);
+      if (bytes.length > MAX_BYTES) throw new IOException("Snapshot file too large");
+      return bytes;
+    }
+  }
+
+  private static Properties decode(byte[] bytes) throws IOException {
+    var value =
+        new Properties() {
+          @Override
+          public synchronized Object put(Object key, Object value) {
+            if (containsKey(key)) throw new IllegalArgumentException("Duplicate snapshot property");
+            return super.put(key, value);
+          }
+        };
+    value.load(new ByteArrayInputStream(bytes));
+    if (value.isEmpty()) throw new IOException("Empty snapshot authority");
+    return value;
+  }
+
+  public static Properties copy(Properties value) {
+    var result = new Properties();
+    result.putAll(value);
+    return result;
+  }
+
+  public static long revision(Properties value) {
+    long revision = Long.parseLong(value.getProperty(REVISION, "0"));
+    if (revision < 0) throw new IllegalArgumentException("Negative snapshot revision");
+    return revision;
+  }
+
+  private static String checksum(Properties value) {
+    try {
+      var hash = MessageDigest.getInstance("SHA-256");
+      for (String key : new TreeSet<>(value.stringPropertyNames()))
+        if (!key.equals(HASH))
+          for (String part : List.of(key, value.getProperty(key))) {
+            byte[] bytes = part.getBytes(StandardCharsets.UTF_8);
+            hash.update(java.nio.ByteBuffer.allocate(4).putInt(bytes.length).array());
+            hash.update(bytes);
+          }
+      return HexFormat.of().formatHex(hash.digest());
+    } catch (java.security.NoSuchAlgorithmException error) {
+      throw new IllegalStateException(error);
+    }
+  }
+
+  private Properties seal(Properties value) {
+    var result = copy(value);
+    result.setProperty(VERSION, "1");
+    result.setProperty(HASH, checksum(result));
+    validate(result);
+    return result;
+  }
+
+  private void validate(Properties value) {
+    if (value.size() != value.stringPropertyNames().size())
+      throw new IllegalArgumentException("Non-text authority property");
+    if (value.containsKey(VERSION) || value.containsKey(HASH))
+      if (!"1".equals(value.getProperty(VERSION))
+          || !checksum(value).equals(value.getProperty(HASH)))
+        throw new IllegalArgumentException("Authority checksum/version mismatch");
+    revision(value);
+    validator.accept(copy(value));
+  }
+
+  private void validatePersisted(Properties value) {
+    if (!value.containsKey(VERSION)
+        || !value.containsKey(HASH)
+        || !value.containsKey(REVISION)
+        || revision(value) == 0)
+      throw new IllegalArgumentException("Missing persisted authority envelope");
+    validate(value);
+  }
+
+  private void transition(Properties previous, Properties next) {
+    validate(previous);
+    validate(next);
+    if (revision(next) < revision(previous))
+      throw new IllegalArgumentException("Authority revision moved backwards");
+    if (previous.containsKey(VERSION) && !next.containsKey(VERSION))
+      throw new IllegalArgumentException("Authority downgrade");
+    transitionValidator.accept(copy(previous), copy(next));
+  }
+}
