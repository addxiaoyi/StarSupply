+  private static Answer<RelationshipRetirementReceipt> relationships() {
+    Map<NationId, RelationshipRetirementReceipt> receipts = new HashMap<>();
+    return i -> {
+      UUID id = i.getArgument(0);
+      NationId nation = i.getArgument(1);
+      var receipt =
+          receipts.computeIfAbsent(
