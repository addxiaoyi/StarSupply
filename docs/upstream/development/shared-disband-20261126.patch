+  final EconomyInsuranceService insurance = mock(EconomyInsuranceService.class);
+  final NationTransferService transfers = mock(NationTransferService.class);
+  final PluginCommand command = mock(PluginCommand.class);
+  final AtomicReference<CommandExecutor> executor =
+      new AtomicReference<>(mock(CommandExecutor.class));
+  final AtomicReference<TabCompleter> completer = new AtomicReference<>(mock(TabCompleter.class));
+
+  StarCoreContext context() {
+    when(plugin.getLogger()).thenReturn(Logger.getAnonymousLogger());
+    when(plugin.getDataFolder()).thenReturn(root.toFile());
+    when(plugin.getConfig()).thenReturn(new YamlConfiguration());
+    var server = mock(Server.class);
+    when(plugin.getServer()).thenReturn(server);
+    when(server.getPluginManager()).thenReturn(mock(PluginManager.class));
+    when(plugin.getCommand("reparations")).thenReturn(command);
+    when(command.getExecutor()).thenAnswer(c -> executor.get());
+    when(command.getTabCompleter()).thenAnswer(c -> completer.get());
+    doAnswer(
+            c -> {
+              executor.set(c.getArgument(0));
+              return null;
+            })
+        .when(command)
+        .setExecutor(any());
+    doAnswer(
+            c -> {
+              completer.set(c.getArgument(0));
+              return null;
+            })
+        .when(command)
+        .setTabCompleter(any());
+    registry.register(NationService.class, mock(NationService.class));
+    registry.register(TreasuryService.class, mock(TreasuryService.class));
+    registry.register(NationTransferService.class, transfers);
+    registry.register(MessageService.class, mock(MessageService.class));
+    registry.register(EvidenceReplayService.class, replay);
+    registry.register(IncidentBundleService.class, bundles);
+    registry.register(EconomyInsuranceService.class, insurance);
+    return new StarCoreContext(
+        plugin,
+        null,
+        null,
+        mock(StarCoreScheduler.class),
+        new StarCoreEventBus(Logger.getAnonymousLogger()),
+        null,
+        mock(DatabaseService.class),
+        null,
+        null,
+        null,
+        registry);
+  }
+
+  @Test
+  void enableFailureUnregistersProvidersAndRestoresOwnedCommand() {
+    var context = context();
+    var before = executor.get();
+    var tabs = completer.get();
+    var module = new ReparationsModule();
+    try (var timers = mockStatic(CompatScheduler.class)) {
+      timers
+          .when(() -> CompatScheduler.asyncTimer(eq(plugin), any(), anyLong(), anyLong()))
+          .thenThrow(new IllegalStateException("timer failed"));
+      assertThatThrownBy(() -> module.enable(context)).hasMessage("timer failed");
+      assertThat(executor.get()).isSameAs(before);
+      assertThat(completer.get()).isSameAs(tabs);
+      assertThat(registry.find(ReparationsService.class)).isEmpty();
+      assertThat(registry.find(AsyncReparationsService.class)).isEmpty();
+      verify(replay).unregisterProvider(any());
+      verify(bundles).unregisterArtifactProvider(eq("reparation-journal"), any());
+      verify(insurance).unregisterSettlementHandler(eq(RefundOwner.REPARATIONS), any());
+      assertThat(module.payReparation(UUID.randomUUID(), BigDecimal.ONE)).isFalse();
+      verifyNoInteractions(transfers);
+    }
+  }
+
+  @Test
+  void failingTaskCancellationStillCleansProvidersAndPreservesReplacement() {
+    var context = context();
+    var module = new ReparationsModule();
+    var task = mock(BukkitTask.class);
+    try (var timers = mockStatic(CompatScheduler.class)) {
+      timers
+          .when(() -> CompatScheduler.asyncTimer(eq(plugin), any(), anyLong(), anyLong()))
+          .thenReturn(task);
+      module.enable(context);
+      var replacement = mock(ReparationsService.class);
+      registry.register(ReparationsService.class, replacement);
+      var nextExecutor = mock(CommandExecutor.class);
+      executor.set(nextExecutor);
+      doThrow(new IllegalStateException("cancel failed")).when(task).cancel();
+      assertThatThrownBy(() -> module.disable(context)).hasMessage("cancel failed");
+      assertThat(registry.find(ReparationsService.class)).contains(replacement);
+      assertThat(executor.get()).isSameAs(nextExecutor);
+      verify(replay).unregisterProvider(any());
+      verify(bundles).unregisterArtifactProvider(anyString(), any());
+      verify(insurance).unregisterSettlementHandler(eq(RefundOwner.REPARATIONS), any());
+      assertThat(module.payReparation(UUID.randomUUID(), BigDecimal.ONE)).isFalse();
+    }
+  }
+
+  @Test
+  void oldTimerCannotMutateAfterReenableAndEventCallbackCannotReenter() {
+    var context = context();
+    var module = new ReparationsModule();
+    var callbacks = new ArrayList<Runnable>();
+    try (var timers = mockStatic(CompatScheduler.class)) {
+      timers
+          .when(() -> CompatScheduler.asyncTimer(eq(plugin), any(), anyLong(), anyLong()))
+          .thenAnswer(
+              c -> {
+                callbacks.add(c.getArgument(1));
+                return mock(BukkitTask.class);
+              });
+      module.enable(context);
+      module.disable(context);
+      module.enable(context);
+      var failed = new AtomicReference<Throwable>();
+      context
+          .eventBus()
+          .subscribe(
+              dev.starcore.starcore.module.war.reparations.event.ReparationCreatedEvent.class,
+              event -> {
+                try {
+                  module.createReparation(
+                      UUID.randomUUID(),
+                      NationId.random(),
+                      NationId.random(),
+                      new BigDecimal("1000"),
+                      1);
+                } catch (RuntimeException error) {
+                  failed.set(error);
+                }
+              });
+      var debt =
+          module.createReparation(
+              UUID.randomUUID(), NationId.random(), NationId.random(), new BigDecimal("1000"), 1);
+      assertThat(failed.get()).hasMessage("REPARATIONS_MUTATION_UNAVAILABLE");
+      assertThat(module.getAllReparations()).hasSize(1);
+      var file = root.resolve("wars/authority.properties");
+      try {
+        java.nio.file.Files.delete(file);
+      } catch (java.io.IOException failure) {
+        throw new java.io.UncheckedIOException(failure);
+      }
+      callbacks.getFirst().run();
+      // A stale timer must not even reload the new lifecycle's unavailable authority.
+      assertThat(field(module, "stateLoaded")).isEqualTo(true);
+      assertThat(module.getReparation(debt.id())).isPresent();
+      module.disable(context);
+      verifyNoInteractions(transfers);
+    }
+  }
+
+  private static Object field(Object target, String name) {
+    try {
+      var field = target.getClass().getDeclaredField(name);
+      field.setAccessible(true);
+      return field.get(target);
+    } catch (ReflectiveOperationException failure) {
+      throw new IllegalStateException(failure);
+    }
+  }
+}
