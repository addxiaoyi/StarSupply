+              return new DiplomacyRetirementService.RetirementReceipt(
+                  receipt.operationId(), receipt.nationId(), receipt.clearedEntries());
+            });
+    services.register(DiplomacyRelationService.class, diplomacy);
+    var alliance =
+        mock(
+            AllianceService.class, withSettings().extraInterfaces(AllianceRetirementService.class));
+    when(((AllianceRetirementService) alliance).retireAlliances(any(), any()))
+        .thenAnswer(relationships());
+    services.register(AllianceService.class, alliance);
