+package dev.starcore.starcore.war;
+
+import dev.starcore.starcore.module.nation.model.NationId;
+import dev.starcore.starcore.module.treasury.NationTransferService;
+import java.math.BigDecimal;
+import java.nio.charset.StandardCharsets;
+import java.time.Instant;
+import java.util.Objects;
+import java.util.UUID;
+
+/**
+ * The original transfer request survives response loss until its ledger commits with completion.
+ */
+record PeaceTreatyPayment(
+    UUID id,
+    UUID treatyId,
+    UUID recordId,
+    String transactionId,
+    NationId payer,
+    NationId receiver,
+    BigDecimal amount,
+    NationTransferService.TransferCategory category,
+    String description,
+    BigDecimal paidBefore,
+    int installmentsBefore,
+    Instant preparedAt,
+    Instant completedAt) {
+  PeaceTreatyPayment {
+    Objects.requireNonNull(id);
+    Objects.requireNonNull(treatyId);
+    Objects.requireNonNull(recordId);
+    Objects.requireNonNull(transactionId);
+    Objects.requireNonNull(payer);
+    Objects.requireNonNull(receiver);
+    Objects.requireNonNull(amount);
+    Objects.requireNonNull(category);
+    Objects.requireNonNull(description);
+    Objects.requireNonNull(paidBefore);
+    Objects.requireNonNull(preparedAt);
+    if (!id.equals(UUID.nameUUIDFromBytes(transactionId.getBytes(StandardCharsets.UTF_8)))
+        || !transactionId.startsWith("peace-treaty:" + treatyId + ":")
+        || payer.equals(receiver)
+        || amount.signum() <= 0
+        || amount.scale() > 2
+        || paidBefore.signum() < 0
+        || installmentsBefore < 0
+        || completedAt != null && completedAt.isBefore(preparedAt)
+        || category != NationTransferService.TransferCategory.REPARATION
+            && category != NationTransferService.TransferCategory.TRIBUTE)
+      throw new IllegalArgumentException("Invalid treaty payment intent");
+  }
+
+  static PeaceTreatyPayment prepare(
+      UUID treaty,
+      UUID record,
+      NationTransferService.TransferRequest request,
+      BigDecimal paidBefore,
+      int installmentsBefore) {
+    return new PeaceTreatyPayment(
+        UUID.nameUUIDFromBytes(request.transactionId().getBytes(StandardCharsets.UTF_8)),
