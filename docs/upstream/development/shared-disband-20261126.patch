@@ -0,0 +1,248 @@
+package dev.starcore.starcore.module.war.reparations;
+
+import com.google.gson.Gson;
+import com.google.gson.stream.JsonReader;
+import com.google.gson.stream.JsonToken;
+import dev.starcore.starcore.core.persistence.AtomicFilePersistence;
+import dev.starcore.starcore.war.WarReparation;
+import java.io.StringReader;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.*;
+
+/** Validation bridge for the reparations portion of the shared war authority. */
+public final class ReparationAuthorityState {
+  private ReparationAuthorityState() {}
+
+  private static final Gson GSON = new Gson();
+
+  public static Properties readLegacy(Path file) {
+    var properties =
+        new Properties() {
+          @Override
+          public synchronized Object put(Object key, Object value) {
+            if (containsKey(key))
+              throw new IllegalArgumentException("Duplicate legacy reparation property: " + key);
+            return super.put(key, value);
+          }
+        };
+    try {
+      if (Files.exists(file))
+        try (var input = Files.newInputStream(file)) {
+          properties.load(input);
+        }
+      else if (Files.exists(AtomicFilePersistence.backup(file))
+          || Files.exists(AtomicFilePersistence.temp(file)))
+        throw new IllegalStateException(
+            "Missing original reparation ledger; reconciliation required");
+    } catch (java.io.IOException error) {
+      throw new IllegalStateException("Unable to read legacy reparations", error);
+    }
+    return canonical(properties);
+  }
+
+  public static Properties canonical(Properties properties) {
+    Objects.requireNonNull(properties);
+    var snapshot = ReparationsSnapshotCodec.fromProperties(properties);
+    var expected = ReparationsSnapshotCodec.toProperties(snapshot);
+    // Old UUID-keyed ledgers and current counted ledgers are supported, never mixed.
+    if (properties.containsKey("reparation.count")) {
+      for (String key : properties.stringPropertyNames())
+        if (!expected.containsKey(key))
+          throw new IllegalArgumentException("Unknown reparation property: " + key);
+    } else {
+      for (String key : properties.stringPropertyNames()) {
+        if (key.startsWith("settlement.") || key.startsWith("archived.")) {
+          if (!expected.containsKey(key))
+            throw new IllegalArgumentException("Unknown reparation property: " + key);
+        } else if (!snapshot.reparations().containsKey(UUID.fromString(key)))
+          throw new IllegalArgumentException("Unknown legacy reparation property: " + key);
+      }
+    }
+    for (var debt : snapshot.reparations().values()) {
+      if (debt.payerId().equals(debt.receiverId())
+          || debt.totalAmount().signum() <= 0
+          || debt.paidAmount().signum() < 0
+          || debt.paidAmount().compareTo(debt.totalAmount()) > 0
+          || debt.totalAmount().stripTrailingZeros().scale() > 2
+          || debt.paidAmount().stripTrailingZeros().scale() > 2)
+        throw new IllegalArgumentException("Invalid reparation balance or parties");
+      if (debt.status() == WarReparation.ReparationStatus.COMPLETED
+          && debt.remainingAmount().signum() != 0)
+        throw new IllegalArgumentException("Unpaid completed reparation");
+    }
+    for (var payment : snapshot.settlements().values()) {
+      if (payment.state() == ReparationSettlementState.REFUNDED)
+        throw new IllegalArgumentException(
+            "Legacy refunded reparation requires independent cancellation evidence");
+      var debt = snapshot.reparations().get(payment.reparationId());
+      if (payment.updatedAt().isBefore(payment.createdAt())
+          || payment.amount().stripTrailingZeros().scale() > 2
+          || payment.expectedPaidAmount().stripTrailingZeros().scale() > 2
+          || payment.expectedPaidAmount().add(payment.amount()).compareTo(debt.totalAmount()) > 0)
+        throw new IllegalArgumentException("Invalid original reparation settlement");
+      if (!payment.completed()
+          && (!payment.matchesBase(debt) || debt.status() != WarReparation.ReparationStatus.ACTIVE))
+        throw new IllegalArgumentException("Pending reparation settlement base mismatch");
+      if (payment.state() == ReparationSettlementState.COMPLETED
+          && (debt.paidAmount().compareTo(payment.expectedPaidAmount().add(payment.amount())) < 0
+              || debt.paidInstallments() < payment.expectedPaidInstallments() + 1))
+        throw new IllegalArgumentException("Completed reparation settlement ledger mismatch");
+    }
+    return expected;
+  }
+
+  public static String encode(Properties properties) {
+    var map = new TreeMap<String, String>();
+    canonical(properties).forEach((k, v) -> map.put((String) k, (String) v));
+    return GSON.toJson(map);
+  }
+
+  public static Properties decode(String json) {
+    if (json == null) throw new IllegalArgumentException("Missing reparations authority");
+    var result = new Properties();
+    try (var reader = new JsonReader(new StringReader(json))) {
+      reader.beginObject();
+      while (reader.hasNext()) {
+        String key = reader.nextName();
+        if (reader.peek() != JsonToken.STRING || result.containsKey(key))
+          throw new IllegalArgumentException("Duplicate or non-text reparation authority property");
+        result.setProperty(key, reader.nextString());
+      }
+      reader.endObject();
+      if (reader.peek() != JsonToken.END_DOCUMENT)
+        throw new IllegalArgumentException("Trailing reparations data");
+    } catch (java.io.IOException error) {
+      throw new IllegalArgumentException("Invalid reparations authority", error);
+    }
+    return canonical(result);
+  }
+
+  public static void validateRetirement(
+      Properties state, Set<UUID> retiredNations, Set<UUID> archivedTreaties) {
+    var snapshot = ReparationsSnapshotCodec.fromProperties(canonical(state));
+    for (var debt : snapshot.reparations().values()) {
+      boolean affected =
+          retiredNations.contains(debt.payerId())
+              || retiredNations.contains(debt.receiverId())
+              || archivedTreaties.contains(debt.treatyId());
+      if (affected != snapshot.archived().contains(debt.id()))
+        throw new IllegalArgumentException(
+            "Reparation archive must match permanent nation or treaty retirement");
+    }
+  }
+
+  public static Properties retire(Properties state, Set<UUID> nations, Set<UUID> treaties) {
+    var snapshot = ReparationsSnapshotCodec.fromProperties(canonical(state));
+    var archive = new HashSet<>(snapshot.archived());
+    for (var debt : snapshot.reparations().values())
+      if (nations.contains(debt.payerId())
+          || nations.contains(debt.receiverId())
+          || treaties.contains(debt.treatyId())) {
+        if (snapshot.settlements().values().stream()
+            .anyMatch(p -> p.reparationId().equals(debt.id()) && !p.completed()))
+          throw new IllegalStateException(
+              "Pending reparation settlement must settle before retirement: " + debt.id());
+        archive.add(debt.id());
+      }
+    return ReparationsSnapshotCodec.toProperties(
+        new ReparationsSnapshotCodec.Snapshot(
+            snapshot.reparations(), snapshot.settlements(), archive));
+  }
+
+  /** Monotonic evidence check also used when a reader skips multiple valid revisions. */
+  public static void transition(Properties before, Properties after, boolean directCommit) {
+    var old = ReparationsSnapshotCodec.fromProperties(canonical(before));
+    var next = ReparationsSnapshotCodec.fromProperties(canonical(after));
+    if (!next.archived().containsAll(old.archived()))
+      throw new IllegalArgumentException("Archived reparations are immutable");
+    for (var debt : old.reparations().values()) {
+      var current = next.reparations().get(debt.id());
+      if (current == null
+          || !debt.treatyId().equals(current.treatyId())
+          || !debt.payerId().equals(current.payerId())
+          || !debt.receiverId().equals(current.receiverId())
+          || debt.totalAmount().compareTo(current.totalAmount()) != 0
+          || debt.totalInstallments() != current.totalInstallments()
+          || !debt.startDate().equals(current.startDate()))
+        throw new IllegalArgumentException("Original reparation evidence is immutable");
+      if (old.archived().contains(debt.id())
+          && !ReparationsStateCodec.encode(debt).equals(ReparationsStateCodec.encode(current)))
+        throw new IllegalArgumentException("Archived reparation cannot change");
+      if (current.paidAmount().compareTo(debt.paidAmount()) < 0
+          || current.paidInstallments() < debt.paidInstallments())
+        throw new IllegalArgumentException("Reparation progress cannot regress");
+      if (debt.status() != WarReparation.ReparationStatus.ACTIVE
+          && !ReparationsStateCodec.encode(debt).equals(ReparationsStateCodec.encode(current))
+          && !(debt.status() == WarReparation.ReparationStatus.DEFAULTED
+              && current.status() == WarReparation.ReparationStatus.FORGIVEN
+              && current.paidAmount().compareTo(debt.paidAmount()) == 0
+              && current.paidInstallments() == debt.paidInstallments()
+              && Objects.equals(current.lastPaymentDate(), debt.lastPaymentDate())))
+        throw new IllegalArgumentException("Terminal reparation cannot be reopened");
+      if (directCommit) {
+        var completions =
+            next.settlements().values().stream()
+                .filter(
+                    p ->
+                        p.reparationId().equals(debt.id())
+                            && p.state() == ReparationSettlementState.COMPLETED
+                            && old.settlements().containsKey(p.settlementId())
+                            && !old.settlements().get(p.settlementId()).completed())
+                .toList();
+        if (completions.size() > 1)
+          throw new IllegalArgumentException(
+              "Only one original payment may complete per ledger commit");
+        if (completions.isEmpty()
+            && (current.paidAmount().compareTo(debt.paidAmount()) != 0
+                || current.paidInstallments() != debt.paidInstallments()
+                || !Objects.equals(current.lastPaymentDate(), debt.lastPaymentDate())))
+          throw new IllegalArgumentException(
+              "Ledger progress requires a completed original settlement");
+      }
+    }
+    for (var payment : old.settlements().values()) {
+      var current = next.settlements().get(payment.settlementId());
+      if (current == null
+          || !payment.reparationId().equals(current.reparationId())
+          || payment.amount().compareTo(current.amount()) != 0
+          || payment.expectedPaidAmount().compareTo(current.expectedPaidAmount()) != 0
+          || payment.expectedPaidInstallments() != current.expectedPaidInstallments()
+          || !payment.createdAt().equals(current.createdAt())
+          || current.updatedAt().isBefore(payment.updatedAt())
+          || payment.completed() && !payment.equals(current))
+        throw new IllegalArgumentException("Original settlement evidence is immutable");
+    }
+    if (directCommit) {
+      for (var debt : next.reparations().values())
+        if (!old.reparations().containsKey(debt.id())
+            && (debt.paidAmount().signum() != 0
+                || debt.paidInstallments() != 0
+                || debt.status() != WarReparation.ReparationStatus.ACTIVE
+                || next.archived().contains(debt.id())))
+          throw new IllegalArgumentException("New reparation must start unpaid and active");
+      for (var payment : next.settlements().values()) {
+        var prior = old.settlements().get(payment.settlementId());
+        if (prior == null
+            && (payment.state() != ReparationSettlementState.PREPARED
+                || !old.reparations().containsKey(payment.reparationId())))
+          throw new IllegalArgumentException("Settlement must be prepared before effect");
+        if (prior != null
+            && !prior.completed()
+            && payment.state() == ReparationSettlementState.COMPLETED) {
+          var debt = next.reparations().get(payment.reparationId());
+          if (prior.state() != ReparationSettlementState.TRANSFERRED
+              || debt.paidAmount().compareTo(payment.expectedPaidAmount().add(payment.amount()))
+                  != 0
+              || debt.paidInstallments() != payment.expectedPaidInstallments() + 1)
+            throw new IllegalArgumentException(
+                "Settlement completion must commit its exact ledger progress");
+        }
+        if (prior != null
+            && prior.state() == ReparationSettlementState.TRANSFERRED
+            && payment.state() == ReparationSettlementState.PREPARED)
+          throw new IllegalArgumentException("Transferred settlement cannot return to prepared");
+      }
+    }
+  }
+}
