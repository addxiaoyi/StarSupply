+          nextWars.put(pair, new WarRecord(e.aggressor(), e.defender(), e.declaredAt()));
+          nextTimes.put(pair, e.declaredAt());
+        }
+      }
+      var nextMirror = new WarDiplomacyMirrorState(snapshot.revision(), fingerprint, entries, owners);
+      WarDiplomacyMirrorState.transition(warMirror, nextMirror);
+      var update = DiplomacyCombinedStateCodec.toProperties(nextRelations, nextWars, nextTimes, allianceInvitations);
+      var candidate = DiplomacyAuthority.merge(authority, nextMirror.write(update));
