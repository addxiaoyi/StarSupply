+package dev.starcore.starcore.module.diplomacy;
+
+import dev.starcore.starcore.module.nation.model.NationId;
+import dev.starcore.starcore.module.diplomacy.WarDiplomacyMirrorService.*;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.time.Instant;
+import java.util.*;
+
+/** Permanent receipts are retained after removable pair ownership is released. */
+record WarDiplomacyMirrorState(long revision, String fingerprint,
+    Map<UUID, WarEntry> receipts, Map<DiplomacyPairKey, UUID> owners) {
+  static final String PREFIX = "warMirror.";
+  WarDiplomacyMirrorState {
+    receipts = Map.copyOf(receipts);
+    owners = Map.copyOf(owners);
+  }
+  static WarDiplomacyMirrorState empty() {
+    return new WarDiplomacyMirrorState(-1, "", Map.of(), Map.of());
+  }
+  static String encode(WarEntry e) {
+    return e.aggressor() + "|" + e.defender() + "|" + e.declaredAt() + "|" + e.active();
+  }
+  static WarEntry decode(UUID id, String text) {
+    String[] parts = text.split("\\|", -1);
+    if (parts.length != 4 || !(parts[3].equals("true") || parts[3].equals("false")))
+      throw new IllegalArgumentException("Invalid war mirror receipt");
+    var e = new WarEntry(id, NationId.of(UUID.fromString(parts[0])),
+        NationId.of(UUID.fromString(parts[1])), Instant.parse(parts[2]), Boolean.parseBoolean(parts[3]));
+    if (!encode(e).equals(text)) throw new IllegalArgumentException("Noncanonical war receipt");
+    return e;
+  }
+  static String fingerprint(Collection<WarEntry> entries) {
+    try {
+      var digest = MessageDigest.getInstance("SHA-256");
+      entries.stream().sorted(Comparator.comparing(e -> e.warId().toString())).forEach(e ->
+          digest.update((e.warId() + "|" + encode(e) + "\n").getBytes(StandardCharsets.UTF_8)));
+      return HexFormat.of().formatHex(digest.digest());
+    } catch (java.security.NoSuchAlgorithmException failure) {
+      throw new IllegalStateException(failure);
+    }
+  }
+  static Map<UUID, WarEntry> entries(SourceSnapshot snapshot) {
+    var result = new HashMap<UUID, WarEntry>();
+    var activePairs = new HashSet<DiplomacyPairKey>();
+    for (var e : snapshot.wars()) {
+      if (result.putIfAbsent(e.warId(), e) != null)
+        throw new IllegalArgumentException("Duplicate war mirror identity");
+      if (e.active() && !activePairs.add(DiplomacyPairKey.of(e.aggressor(), e.defender())))
+        throw new IllegalArgumentException("Multiple active wars for diplomacy pair");
+    }
+    return result;
+  }
+  Properties write(Properties properties) {
+    var result = DiplomacyAuthority.copy(properties);
+    result.keySet().removeIf(k -> k instanceof String s && s.startsWith(PREFIX));
+    if (revision < 0) return result;
+    result.setProperty(PREFIX + "revision", Long.toString(revision));
+    result.setProperty(PREFIX + "fingerprint", fingerprint);
+    receipts.forEach((id, e) -> result.setProperty(PREFIX + "receipt." + id, encode(e)));
+    owners.forEach((pair, id) -> result.setProperty(PREFIX + "owner." + pair.left() + "." + pair.right(), id.toString()));
+    return result;
+  }
+  static WarDiplomacyMirrorState read(Properties properties) {
+    var keys = properties.stringPropertyNames().stream().filter(k -> k.startsWith(PREFIX)).toList();
+    if (keys.isEmpty()) return empty();
+    long revision = Long.parseLong(Objects.requireNonNull(properties.getProperty(PREFIX + "revision")));
+    String hash = Objects.requireNonNull(properties.getProperty(PREFIX + "fingerprint"));
+    if (revision < 0 || !Long.toString(revision).equals(properties.getProperty(PREFIX + "revision"))
+        || !hash.matches("[0-9a-f]{64}")) throw new IllegalArgumentException("Invalid war mirror fence");
+    var receipts = new HashMap<UUID, WarEntry>();
+    var owners = new HashMap<DiplomacyPairKey, UUID>();
+    for (String key : keys) {
+      String suffix = key.substring(PREFIX.length());
+      if (suffix.startsWith("receipt.")) {
+        String rawId = suffix.substring(8);
+        UUID id = UUID.fromString(rawId);
+        if (!id.toString().equals(rawId)) throw new IllegalArgumentException("Invalid receipt UUID");
+        receipts.put(id, decode(id, properties.getProperty(key)));
+      } else if (suffix.startsWith("owner.")) {
+        String[] ids = suffix.substring(6).split("\\.", -1);
+        if (ids.length != 2) throw new IllegalArgumentException("Invalid owner pair");
+        var pair = DiplomacyPairKey.of(NationId.of(UUID.fromString(ids[0])), NationId.of(UUID.fromString(ids[1])));
+        if (pair.left().equals(pair.right()) || !(pair.left() + "." + pair.right()).equals(suffix.substring(6)))
+          throw new IllegalArgumentException("Noncanonical owner pair");
+        String owner = properties.getProperty(key);
+        UUID id = UUID.fromString(owner);
+        if (!id.toString().equals(owner)) throw new IllegalArgumentException("Invalid owner UUID");
+        owners.put(pair, id);
+      } else if (!suffix.equals("revision") && !suffix.equals("fingerprint"))
+        throw new IllegalArgumentException("Unknown war mirror property");
+    }
+    if (!fingerprint(receipts.values()).equals(hash)) throw new IllegalArgumentException("War fingerprint mismatch");
+    entries(new SourceSnapshot(revision, List.copyOf(receipts.values())));
+    var retired = DiplomacyAuthority.receipts(properties);
+    var relations = DiplomacyStateCodec.fromProperties(properties);
+    var wars = DiplomacyWarCodec.fromProperties(properties);
+    owners.forEach((pair, id) -> {
+      var e = receipts.get(id);
+      var war = wars.get(pair);
+      if (e == null || !e.active() || !pair.equals(DiplomacyPairKey.of(e.aggressor(), e.defender()))
+          || retired.containsKey(pair.left()) || retired.containsKey(pair.right())
+          || relations.get(pair) != DiplomacyRelation.WAR || war == null
+          || !war.declarer().equals(e.aggressor()) || !war.target().equals(e.defender())
+          || war.declaredAt().toEpochMilli() != e.declaredAt().toEpochMilli())
+        throw new IllegalArgumentException("Invalid war mirror ownership");
+    });
+    return new WarDiplomacyMirrorState(revision, hash, receipts, owners);
+  }
+  static void transition(WarDiplomacyMirrorState before, WarDiplomacyMirrorState after) {
+    if (after.revision < before.revision) throw new IllegalArgumentException("War source revision rollback");
+    if (before.revision == after.revision && !before.fingerprint.equals(after.fingerprint))
+      throw new IllegalArgumentException("Conflicting source revision");
+    before.receipts.forEach((id, old) -> {
+      var next = after.receipts.get(id);
+      if (next == null || !old.aggressor().equals(next.aggressor())
+          || !old.defender().equals(next.defender()) || !old.declaredAt().equals(next.declaredAt())
+          || (!old.active() && next.active()))
+        throw new IllegalArgumentException("War receipt identity or terminal state changed");
+    });
+    after.owners.forEach((pair, id) -> {
+      if (!id.equals(before.owners.get(pair)) && before.receipts.containsKey(id))
+        throw new IllegalArgumentException("Released owner cannot be reacquired");
+    });
+  }
+  WarDiplomacyMirrorState release(DiplomacyPairKey pair) {
+    var next = new HashMap<>(owners);
+    next.remove(pair);
+    return new WarDiplomacyMirrorState(revision, fingerprint, receipts, next);
+  }
+}
