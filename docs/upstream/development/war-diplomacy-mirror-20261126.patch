+package dev.starcore.starcore.module.diplomacy;
+
+import static org.assertj.core.api.Assertions.*;
+
+import dev.starcore.starcore.module.diplomacy.WarDiplomacyMirrorService.*;
+import dev.starcore.starcore.module.nation.model.NationId;
+import java.nio.file.Path;
+import java.time.Instant;
+import java.util.List;
+import java.util.Properties;
+import java.util.UUID;
+import org.junit.jupiter.api.io.TempDir;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+
+class WarDiplomacyMirrorTest {
+  @TempDir Path root;
+  final NationId a = NationId.random(), b = NationId.random(), c = NationId.random();
+  final UUID firstId = UUID.randomUUID(), secondId = UUID.randomUUID();
+  final Instant firstTime = Instant.parse("2026-11-25T12:00:00Z");
+  final Instant secondTime = firstTime.plusSeconds(60);
+
+  WarEntry first(boolean active) {
+    return new WarEntry(firstId, a, b, firstTime, active);
+  }
+
+  WarEntry second(boolean active) {
+    return new WarEntry(secondId, a, b, secondTime, active);
+  }
+
+  SourceSnapshot snapshot(long revision, WarEntry... wars) {
+    return new SourceSnapshot(revision, List.of(wars));
+  }
+
+  WarDiplomacyMirrorService mirror(DiplomacyModule module) {
+    return (WarDiplomacyMirrorService) module;
+  }
+
+  void assertSecondWar(DiplomacyModule module) {
+    assertThat(module.relationBetween(a, b)).isEqualTo(DiplomacyRelation.WAR);
+    assertThat(module.getWarRecord(a, b)).contains(new WarRecord(a, b, secondTime));
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void endedWarReplayPreservesLaterAllianceAcrossRestart(boolean sql) {
+    try (var f = new DiplomacyRetirementTestFixture(root, sql)) {
+      var module = f.open();
+      mirror(module).reconcile(snapshot(1, first(true)));
+      var ended = snapshot(2, first(false));
+      var receipt = mirror(module).reconcile(ended);
+      assertThat(module.getWarRecord(a, b)).isEmpty();
+      module.setRelation(a, b, DiplomacyRelation.ALLIED);
+      var restarted = f.open();
+      var replay = mirror(restarted).reconcile(ended);
+      assertThat(replay.revision()).isEqualTo(receipt.revision());
+      assertThat(replay.fingerprint()).isEqualTo(receipt.fingerprint());
+      assertThat(replay.replay()).isTrue();
+      assertThat(restarted.relationBetween(a, b)).isEqualTo(DiplomacyRelation.ALLIED);
+      assertThat(restarted.getWarRecord(a, b)).isEmpty();
+      mirror(restarted).reconcile(snapshot(3, first(false)));
+      assertThat(f.open().relationBetween(a, b)).isEqualTo(DiplomacyRelation.ALLIED);
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void lateFirstWarSnapshotCannotOverwriteSecondWar(boolean sql) {
+    try (var f = new DiplomacyRetirementTestFixture(root, sql)) {
+      var module = f.open();
+      mirror(module).reconcile(snapshot(1, first(true)));
+      var oldEnd = snapshot(2, first(false));
+      mirror(module).reconcile(oldEnd);
+      mirror(module).reconcile(snapshot(3, first(false), second(true)));
+      assertThatThrownBy(() -> mirror(module).reconcile(oldEnd))
+          .isInstanceOf(RuntimeException.class);
+      assertSecondWar(module);
+      assertSecondWar(f.open());
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void oldDeclarationCannotResurrectEndedWar(boolean sql) {
+    try (var f = new DiplomacyRetirementTestFixture(root, sql)) {
+      var module = f.open();
+      var declaration = snapshot(1, first(true));
+      mirror(module).reconcile(declaration);
+      mirror(module).reconcile(snapshot(2, first(false)));
+      module.setRelation(a, b, DiplomacyRelation.ALLIED);
+      var restart = f.open();
+      assertThatThrownBy(() -> mirror(restart).reconcile(declaration))
+          .isInstanceOf(RuntimeException.class);
+      assertThat(restart.relationBetween(a, b)).isEqualTo(DiplomacyRelation.ALLIED);
+      assertThat(restart.getWarRecord(a, b)).isEmpty();
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void sameRevisionReplaysOriginalFingerprintAndRejectsChangedContent(boolean sql) {
+    try (var f = new DiplomacyRetirementTestFixture(root, sql)) {
+      var module = f.open();
+      var original = snapshot(1, first(true));
+      var receipt = mirror(module).reconcile(original);
+      assertThat(receipt.revision()).isEqualTo(1);
+      assertThat(receipt.fingerprint()).isNotBlank();
+      assertThat(receipt.replay()).isFalse();
+      var restart = f.open();
+      var replay = mirror(restart).reconcile(original);
+      assertThat(replay.fingerprint()).isEqualTo(receipt.fingerprint());
+      assertThat(replay.replay()).isTrue();
+      assertThatThrownBy(() -> mirror(restart).reconcile(snapshot(1, first(false))))
+          .isInstanceOf(RuntimeException.class);
+      assertThat(f.open().getWarRecord(a, b)).contains(new WarRecord(a, b, firstTime));
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void sourceRevisionRejectsOldSnapshotEvenForUnrelatedPair(boolean sql) {
+    try (var f = new DiplomacyRetirementTestFixture(root, sql)) {
+      var module = f.open();
+      mirror(module).reconcile(snapshot(10, first(true)));
+      var unrelated = new WarEntry(UUID.randomUUID(), b, c, secondTime, true);
+      assertThatThrownBy(() -> mirror(module).reconcile(snapshot(9, unrelated)))
+          .isInstanceOf(RuntimeException.class);
+      assertThat(f.open().getWarRecord(b, c)).isEmpty();
+      assertThat(f.open().getWarRecord(a, b)).contains(new WarRecord(a, b, firstTime));
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void independentStaleWriterCannotReplaceNewerSnapshot(boolean sql) {
+    try (var f = new DiplomacyRetirementTestFixture(root, sql)) {
+      var winner = f.open();
+      var stale = f.open();
+      mirror(winner).reconcile(snapshot(2, first(false), second(true)));
+      assertThatThrownBy(() -> mirror(stale).reconcile(snapshot(1, first(true))))
+          .isInstanceOf(RuntimeException.class);
+      assertSecondWar(f.open());
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void failedSaveCanRetryOriginalSnapshotAfterRestart(boolean sql) {
+    try (var f = new DiplomacyRetirementTestFixture(root, sql)) {
+      var faults = new FaultStorage(new MergingDiplomacyStateStorage(f.storage()));
+      var module = f.open(faults);
+      faults.mode = "before";
+      var original = snapshot(1, first(true));
+      assertThatThrownBy(() -> mirror(module).reconcile(original))
+          .isInstanceOf(RuntimeException.class);
+      var restart = f.open();
+      assertThat(restart.getWarRecord(a, b)).isEmpty();
+      assertThat(mirror(restart).reconcile(original).replay()).isFalse();
+      assertThat(f.open().getWarRecord(a, b)).contains(new WarRecord(a, b, firstTime));
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void committedLostResponseReturnsDurableReceiptAndDoesNotRepeatEndedEffect(boolean sql) {
+    try (var f = new DiplomacyRetirementTestFixture(root, sql)) {
+      var faults = new FaultStorage(new MergingDiplomacyStateStorage(f.storage()));
+      var module = f.open(faults);
+      mirror(module).reconcile(snapshot(1, first(true)));
+      faults.mode = "after";
+      var ended = snapshot(2, first(false));
+      var receipt = mirror(module).reconcile(ended);
+      faults.mode = "";
+      module.setRelation(a, b, DiplomacyRelation.ALLIED);
+      var restart = f.open();
+      var replay = mirror(restart).reconcile(ended);
+      assertThat(replay.fingerprint()).isEqualTo(receipt.fingerprint());
+      assertThat(replay.replay()).isTrue();
+      assertThat(restart.relationBetween(a, b)).isEqualTo(DiplomacyRelation.ALLIED);
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void unknownCommitFreezesWriterAndRestartReadsOriginalReceipt(boolean sql) {
+    try (var f = new DiplomacyRetirementTestFixture(root, sql)) {
+      var faults = new FaultStorage(new MergingDiplomacyStateStorage(f.storage()));
+      var module = f.open(faults);
+      faults.mode = "unknown";
+      var original = snapshot(1, first(true));
+      assertThatThrownBy(() -> mirror(module).reconcile(original))
+          .isInstanceOf(RuntimeException.class);
+      faults.mode = "";
+      faults.unreadable = false;
+      assertThatThrownBy(() -> module.setRelation(b, c, DiplomacyRelation.ALLIED))
+          .isInstanceOf(RuntimeException.class);
+      var restart = f.open();
+      assertThat(mirror(restart).reconcile(original).replay()).isTrue();
+      assertThat(restart.getWarRecord(a, b)).contains(new WarRecord(a, b, firstTime));
+    }
+  }
+
+  static final class FaultStorage implements DiplomacyStateStorage {
+    final DiplomacyStateStorage delegate;
+    String mode = "";
+    boolean unreadable;
+
+    FaultStorage(DiplomacyStateStorage delegate) {
+      this.delegate = delegate;
+    }
+
+    public Properties load() {
+      if (unreadable) throw new IllegalStateException("read unavailable");
+      return delegate.load();
+    }
+
+    public void save(Properties value) {
+      if (mode.equals("before")) throw new IllegalStateException("before commit");
+      delegate.save(value);
+      if (mode.equals("unknown")) unreadable = true;
+      if (mode.equals("after") || mode.equals("unknown"))
+        throw new IllegalStateException("lost response");
+    }
+  }
+}
