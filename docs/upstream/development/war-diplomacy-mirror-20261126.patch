+package dev.starcore.starcore.module.diplomacy;
+
+import dev.starcore.starcore.module.nation.model.NationId;
+import java.time.Instant;
+import java.util.*;
+
+/** Durable receiver of complete war authority snapshots, including archived wars. */
+public interface WarDiplomacyMirrorService {
+  /** Accepts one complete revision atomically; stale and contradictory revisions are rejected. */
+  SnapshotReceipt reconcile(SourceSnapshot snapshot);
+  record SourceSnapshot(long revision, List<WarEntry> wars) {
+    public SourceSnapshot {
+      if (revision < 0) throw new IllegalArgumentException("Negative source revision");
+      wars = List.copyOf(wars);
+    }
+  }
+  record WarEntry(UUID warId, NationId aggressor, NationId defender, Instant declaredAt, boolean active) {
+    public WarEntry {
+      Objects.requireNonNull(warId);
+      Objects.requireNonNull(aggressor);
+      Objects.requireNonNull(defender);
+      Objects.requireNonNull(declaredAt);
+      if (aggressor.equals(defender)) throw new IllegalArgumentException("Self war mirror");
+    }
+  }
+  record SnapshotReceipt(long revision, String fingerprint, boolean replay) {}
+}
