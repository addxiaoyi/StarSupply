+  @Override
+  public SnapshotReceipt reconcile(SourceSnapshot snapshot) {
+    Objects.requireNonNull(snapshot);
+    return mutate(() -> {
+      requireStorage();
+      var entries = WarDiplomacyMirrorState.entries(snapshot);
+      String fingerprint = WarDiplomacyMirrorState.fingerprint(entries.values());
+      if (snapshot.revision() < warMirror.revision())
+        throw new IllegalArgumentException("Stale war source snapshot revision");
+      if (snapshot.revision() == warMirror.revision()) {
+        if (!fingerprint.equals(warMirror.fingerprint()))
+          throw new IllegalArgumentException("Conflicting war source snapshot revision");
+        return new SnapshotReceipt(warMirror.revision(), fingerprint, true);
+      }
+      var owners = new HashMap<>(warMirror.owners());
+      var nextRelations = new HashMap<>(relations);
+      var nextWars = new HashMap<>(warRecords);
+      var nextTimes = new HashMap<>(relationChangeTimestamps);
+      var active = new HashMap<DiplomacyPairKey, WarEntry>();
+      for (var e : entries.values()) {
+        if (e.active()) {
+          requireActive(e.aggressor(), e.defender());
+          active.put(DiplomacyPairKey.of(e.aggressor(), e.defender()), e);
+        }
+      }
+      // A legacy WAR with no UUID must be matched explicitly, never erased as an orphan.
+      for (var pair : relations.keySet()) {
+        if (relations.get(pair) == DiplomacyRelation.WAR && !owners.containsKey(pair)) {
+          var source = active.get(pair);
+          var legacy = warRecords.get(pair);
+          if (source == null || legacy == null || !legacy.declarer().equals(source.aggressor())
+              || !legacy.target().equals(source.defender())
+              || legacy.declaredAt().toEpochMilli() != source.declaredAt().toEpochMilli())
+            throw new IllegalStateException("Unidentified legacy WAR requires explicit reconciliation: " + pair);
+        }
+      }
+      for (var owned : warMirror.owners().entrySet()) {
+        var e = entries.get(owned.getValue());
+        if (e == null) throw new IllegalArgumentException("Complete source snapshot lost war history");
+        if (!e.active()) {
+          var pair = owned.getKey();
+          owners.remove(pair);
+          nextRelations.put(pair, DiplomacyRelation.NEUTRAL);
+          nextWars.remove(pair);
+          nextTimes.put(pair, timingPolicy.now());
+        }
+      }
+      for (var item : active.entrySet()) {
+        var pair = item.getKey();
+        var e = item.getValue();
+        if (!warMirror.receipts().containsKey(e.warId())) {
+          owners.put(pair, e.warId());
