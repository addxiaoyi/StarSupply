+  @ParameterizedTest(name = "sql={0}, {1}, after={2}, child={3}")
+  @MethodSource("retirementBoundaries")
+  void everyRealEndpointRecoversOriginalParentAndChildAfterRestart(
+      boolean sql, Endpoint endpoint, boolean after, boolean second) throws Exception {
+    try (var first = new Session(sql, true)) {
+      first.fail(endpoint, after, second ? child : parent);
+      assertThatThrownBy(() -> first.nations.disbandNation(parent))
+          .hasMessage("joint boundary " + endpoint);
+      var pending = first.operation();
+      assertThat(pending.state()).isEqualTo(NationDisbandOperation.State.CLEANUP_PENDING);
+      var operation = pending.transaction().transactionId();
+      var committed = first.receipts();
+      assertThatThrownBy(
+              () ->
+                  first.nations.grantExperience(
+                      new NationExperienceService.Grant("pending", survivor, 1)))
+          .hasMessageContaining("recovery pending");
+      try (var restarted = new Session(sql, false)) {
+        restarted.nations.recoverPendingDisband();
+        restarted.assertComplete(operation);
+        assertThat(restarted.receipts()).containsAllEntriesOf(committed);
+        var receipts = restarted.receipts();
+        restarted.nations.recoverDisband(operation);
+        restarted.nations.recoverPendingDisband();
+        assertThat(restarted.receipts()).isEqualTo(receipts);
+        try (var independent = new Session(sql, false)) {
+          independent.nations.recoverDisband(operation);
+          independent.assertComplete(operation);
+          assertThat(independent.receipts()).isEqualTo(receipts);
+        }
+      }
+    }
+    try (var durable = new Session(sql, false)) {
+      // Includes disposal of stale instances: their stop flush must not undo any receipt.
+      durable.assertComplete(durable.operation().transaction().transactionId());
+    }
+  }
