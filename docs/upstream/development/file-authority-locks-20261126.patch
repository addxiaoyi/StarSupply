+  private static boolean affected(
+      Properties state,
+      String prefix,
+      UUID id,
+      String json,
+      Set<NationId> nations,
+      WarAuthority authority) {
+    if (prefix.equals(WarAuthority.WAR))
+      return authority.decodeWar(id, json).allParticipants().stream().anyMatch(nations::contains);
+    UUID warId = id;
+    if (prefix.equals(WarAuthority.TREATY)) {
+      var data = WarAuthority.treatyData(json);
+      if (WarAuthority.treatyNations(id, data).stream().anyMatch(nations::contains)) return true;
+      if (!data.containsKey("STATE")) return false;
+      warId = new PeaceTreatyStateCodec().decode(data.get("STATE")).treaty().warId();
+    } else if (WarAuthority.battlefieldNations(id, json).stream().anyMatch(nations::contains))
+      return true;
+    var war =
+        state.getProperty(
+            WarAuthority.WAR + warId, state.getProperty(WarAuthority.ARCHIVED_WAR + warId));
+    return war != null
+        && authority.decodeWar(warId, war).allParticipants().stream().anyMatch(nations::contains);
+  }
+
+  private static Set<UUID> uuids(Set<NationId> nations) {
+    return nations.stream().map(NationId::value).collect(java.util.stream.Collectors.toSet());
+  }
+}
