+package dev.starcore.starcore.core.persistence;
+
+import static org.assertj.core.api.Assertions.*;
+
+import java.io.*;
+import java.net.URLClassLoader;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.*;
+import java.util.*;
+import java.util.concurrent.*;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+
+class FileAuthorityProcessTest {
+  @TempDir Path root;
+
+  final class Child implements AutoCloseable {
+    final String token = UUID.randomUUID().toString();
+    final Process process;
+    final ByteArrayOutputStream output = new ByteArrayOutputStream();
+    final Thread reader;
+
+    Child(String mode, String kind) throws Exception {
+      var cp = new LinkedHashSet<String>();
+      String configured = System.getProperty("surefire.test.class.path");
+      if (configured != null)
+        cp.addAll(List.of(configured.split(java.util.regex.Pattern.quote(File.pathSeparator))));
+      for (var loader = FileAuthorityProcessProbe.class.getClassLoader();
+          loader != null;
+          loader = loader.getParent())
+        if (loader instanceof URLClassLoader urls)
+          for (var url : urls.getURLs())
+            if (url.getProtocol().equals("file")) cp.add(Path.of(url.toURI()).toString());
+      cp.add(
+          Path.of(
+                  FileAuthorityProcessProbe.class
+                      .getProtectionDomain()
+                      .getCodeSource()
+                      .getLocation()
+                      .toURI())
+              .toString());
+      cp.add(
+          Path.of(
+                  FileAuthorityLock.class
+                      .getProtectionDomain()
+                      .getCodeSource()
+                      .getLocation()
+                      .toURI())
+              .toString());
+      Path args = root.resolve(token + ".args");
+      var lines =
+          new ArrayList<>(
+              List.of(
+                  "-Xms8m",
+                  "-Xmx64m",
+                  "-XX:+UseSerialGC",
+                  "-XX:ActiveProcessorCount=1",
+                  "-XX:TieredStopAtLevel=1",
+                  "-classpath",
+                  quote(String.join(File.pathSeparator, cp)),
+                  FileAuthorityProcessProbe.class.getName(),
+                  mode,
+                  kind,
+                  quote(root.toString()),
+                  token));
+      Files.write(args, lines, StandardCharsets.UTF_8);
+      String executable =
+          System.getProperty("os.name").toLowerCase(Locale.ROOT).contains("win")
+              ? "java.exe"
+              : "java";
+      process =
+          new ProcessBuilder(
+                  Path.of(System.getProperty("java.home"), "bin", executable).toString(),
+                  "@" + args)
+              .redirectErrorStream(true)
+              .start();
+      reader =
+          Thread.ofVirtual()
+              .start(
+                  () -> {
+                    try (var input = process.getInputStream()) {
+                      input.transferTo(output);
+                    } catch (IOException failure) {
+                      throw new UncheckedIOException(failure);
+                    }
+                  });
+    }
+
+    void await(String state) throws Exception {
+      Path signal = root.resolve(token + "." + state);
+      long deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(15);
+      while (!Files.exists(signal) && process.isAlive() && System.nanoTime() < deadline)
+        Thread.sleep(10);
+      assertThat(signal)
+          .withFailMessage(
+              "Child %s did not signal %s: %s",
+              process.pid(), state, output.toString(StandardCharsets.UTF_8))
+          .exists();
+    }
+
+    void go() throws IOException {
+      process.getOutputStream().write("go\n".getBytes(StandardCharsets.UTF_8));
+      process.getOutputStream().flush();
+    }
+
+    String result() throws Exception {
+      assertThat(process.waitFor(15, TimeUnit.SECONDS)).isTrue();
+      reader.join(2000);
+      assertThat(process.exitValue())
+          .withFailMessage(output.toString(StandardCharsets.UTF_8))
+          .isZero();
+      return Files.readString(root.resolve(token + ".result")).split("\n")[0];
+    }
+
+    void kill() throws Exception {
+      process.destroyForcibly();
+      assertThat(process.waitFor(10, TimeUnit.SECONDS)).isTrue();
+    }
+
+    public void close() throws Exception {
+      if (process.isAlive()) kill();
+      process.getOutputStream().close();
+      reader.join(2000);
+      assertThat(reader.isAlive()).isFalse();
+    }
+  }
+
+  static String quote(String value) {
+    return "\"" + value.replace("\\", "\\\\").replace("\"", "\\\"") + "\"";
+  }
+
+  @ParameterizedTest
+  @ValueSource(
+      strings = {
+        "NATION",
+        "TERRITORY",
+        "TREASURY",
+        "CITY",
+        "DIPLOMACY",
+        "BILATERAL",
+        "MILITARY",
+        "FEDERATION",
+        "WAR"
+      })
+  void independentJvmsCannotBothCommitTheSameOriginalSelection(String kind) throws Exception {
+    // Initialize ledgers which publish their empty snapshot on load before either child selects it.
+    FileAuthorityProcessProbe.prepare(root, kind, UUID.randomUUID());
+    try (var first = new Child("race", kind);
+        var second = new Child("race", kind)) {
+      first.await("ready");
+      second.await("ready");
+      Path path = FileAuthorityProcessProbe.authorityPath(root, kind);
+      try (var lock = FileAuthorityLock.acquire(path)) {
+        first.go();
+        second.go();
+        first.await("started");
+        second.await("started");
+        Thread.sleep(250);
+        assertThat(root.resolve(first.token + ".result")).doesNotExist();
+        assertThat(root.resolve(second.token + ".result")).doesNotExist();
+      }
+      String a = first.result(), b = second.result();
+      assertThat(List.of(a, b)).containsExactlyInAnyOrder("OK", "CONFLICT");
+      String winner = a.equals("OK") ? first.token : second.token;
+      String loser = a.equals("OK") ? second.token : first.token;
+      assertThat(Files.readString(path)).contains(winner).doesNotContain(loser);
+      // Reads also wait for the shared lock, then reload in a fresh JVM.
+      try (var lock = FileAuthorityLock.acquire(path);
+          var fresh = new Child("read", kind)) {
+        fresh.await("loading");
+        Thread.sleep(250);
+        assertThat(root.resolve(fresh.token + ".ready")).doesNotExist();
+        lock.close();
+        fresh.await("ready");
+        assertThat(fresh.process.waitFor(15, TimeUnit.SECONDS)).isTrue();
+        assertThat(fresh.process.exitValue()).isZero();
+      }
+    }
+  }
