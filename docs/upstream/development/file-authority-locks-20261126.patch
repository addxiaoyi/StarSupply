@@ -0,0 +1,672 @@
+package dev.starcore.starcore.war;
+
+import com.google.gson.*;
+import dev.starcore.starcore.core.persistence.AtomicFilePersistence;
+import dev.starcore.starcore.core.persistence.DurablePropertiesStore;
+import dev.starcore.starcore.module.nation.model.NationId;
+import dev.starcore.starcore.module.war.WarRetirementReceipt;
+import dev.starcore.starcore.module.war.reparations.ReparationAuthorityState;
+import java.nio.file.*;
+import java.util.*;
+import java.util.function.Supplier;
+
+/** Wars, battlefields, treaties and permanent retirement evidence share one commit. */
+final class WarAuthority {
+  static final String WAR = "war.",
+      FIELD = "battlefield.",
+      TREATY = "treaty.",
+      RETIRED = "retired.",
+      DELETED = "deletedWar.",
+      ARCHIVE = "archivedTreaty.",
+      ARCHIVED_WAR = "archivedWar.",
+      ARCHIVED_FIELD = "archivedBattlefield.";
+  static final String REPARATIONS = "reparations.state";
+  private static final Gson GSON = new Gson();
+  private final WarJsonCodec codec;
+  private final DurablePropertiesStore store;
+  private final WarStorageBackend backend;
+  private final Supplier<Properties> legacyReparations;
+
+  WarAuthority(
+      Path folder,
+      WarStorageBackend backend,
+      WarJsonCodec codec,
+      Supplier<Properties> legacy,
+      Supplier<Properties> legacyReparations) {
+    this.codec = codec;
+    this.backend = backend;
+    this.legacyReparations = legacyReparations;
+    Path file = folder.resolve("authority.properties");
+    this.store =
+        new DurablePropertiesStore(
+            file,
+            backend.selectedDatabase()
+                ? () ->
+                    backend
+                        .dataSource()
+                        .orElseThrow(() -> new IllegalStateException("War database unavailable"))
+                : null,
+            "starcore_war_authority",
+            () -> {
+              if (backend.selectedDatabase()
+                  && (Files.exists(file)
+                      || Files.exists(file.resolveSibling(file.getFileName() + ".initialized"))
+                      || Files.exists(AtomicFilePersistence.backup(file))
+                      || Files.exists(AtomicFilePersistence.temp(file)))) {
+                // Import the sealed current authority, including receipts, instead of old tables.
+                return new DurablePropertiesStore(
+                        file,
+                        null,
+                        "starcore_war_authority",
+                        () -> {
+                          throw new IllegalStateException("Missing war file authority");
+                        },
+                        this::validate,
+                        this::transition)
+                    .load();
+              }
+              return legacy.get();
+            },
+            this::validate,
+            this::transition);
+  }
+
+  Properties load() {
+    backend.usesDatabase();
+    return upgrade(store.load());
+  }
+
+  Properties snapshot() {
+    backend.usesDatabase();
+    return upgrade(store.snapshot());
+  }
+
+  private Properties upgrade(Properties value) {
+    if (!"1".equals(value.getProperty("format.version"))) return value;
+    // Import before any caller can retire a nation, even if the reparations module is disabled.
+    value.setProperty("format.version", "2");
+    value.setProperty(
+        REPARATIONS,
+        ReparationAuthorityState.encode(
+            ReparationAuthorityState.retire(
+                legacyReparations.get(),
+                receipts(value).keySet().stream()
+                    .map(NationId::value)
+                    .collect(java.util.stream.Collectors.toSet()),
+                family(value, ARCHIVE).keySet())));
+    store.save(value);
+    return store.snapshot();
+  }
+
+  void save(Properties value) {
+    backend.usesDatabase();
+    if (!"2".equals(value.getProperty("format.version")))
+      throw new IllegalArgumentException("War authority cannot be downgraded");
+    var previous = snapshot();
+    WarDisbandAdmission.commit(previous, value, this);
+    validatePaymentCommit(previous, value);
+    ReparationAuthorityState.transition(reparations(previous), reparations(value), true);
+    store.save(value);
+  }
+
+  long revision() {
+    return DurablePropertiesStore.revision(snapshot());
+  }
+
+  static Properties empty() {
+    var p = new Properties();
+    p.setProperty("format.version", "2");
+    p.setProperty(REPARATIONS, ReparationAuthorityState.encode(new Properties()));
+    return p;
+  }
+
+  static Properties reparations(Properties value) {
+    return ReparationAuthorityState.decode(value.getProperty(REPARATIONS));
+  }
+
+  War decodeWar(UUID id, String json) {
+    var war = codec.decode(JsonParser.parseString(json).getAsJsonObject());
+    if (war == null || !id.equals(war.id()))
+      throw new IllegalStateException("Invalid war authority record " + id);
+    return war;
+  }
+
+  static Map<UUID, String> family(Properties p, String prefix) {
+    var result = new HashMap<UUID, String>();
+    for (String key : p.stringPropertyNames())
+      if (key.startsWith(prefix)) {
+        UUID id = UUID.fromString(key.substring(prefix.length()));
+        if (!key.equals(prefix + id) || result.putIfAbsent(id, p.getProperty(key)) != null)
+          throw new IllegalArgumentException("Invalid or duplicate war authority key");
+      }
+    return Map.copyOf(result);
+  }
+
+  static Map<String, String> treatyData(String json) {
+    var object = JsonParser.parseString(json).getAsJsonObject();
+    var result = new HashMap<String, String>();
+    for (var entry : object.entrySet()) {
+      if (!entry.getValue().isJsonPrimitive() || !entry.getValue().getAsJsonPrimitive().isString())
+        throw new IllegalArgumentException("Non-text treaty record");
+      result.put(entry.getKey(), entry.getValue().getAsString());
+    }
+    return Map.copyOf(result);
+  }
+
+  static String encodeTreaty(Map<String, String> value) {
+    return GSON.toJson(new TreeMap<>(value));
+  }
+
+  static Map<NationId, WarRetirementReceipt> receipts(Properties p) {
+    var result = new HashMap<NationId, WarRetirementReceipt>();
+    family(p, RETIRED)
+        .forEach(
+            (id, json) -> {
+              var v = JsonParser.parseString(json).getAsJsonObject();
+              var nation = NationId.of(id);
+              var receipt =
+                  new WarRetirementReceipt(
+                      UUID.fromString(v.get("operationId").getAsString()),
+                      nation,
+                      ids(v, "warIds"),
+                      ids(v, "treatyIds"),
+                      ids(v, "battlefieldIds"));
+              if (!v.keySet()
+                  .equals(Set.of("operationId", "warIds", "treatyIds", "battlefieldIds")))
+                throw new IllegalArgumentException("Invalid war retirement receipt fields");
+              result.put(nation, receipt);
+            });
+    return Map.copyOf(result);
+  }
+
+  private static Set<UUID> ids(JsonObject value, String key) {
+    var result = new HashSet<UUID>();
+    for (var element : value.getAsJsonArray(key))
+      if (!result.add(UUID.fromString(element.getAsString())))
+        throw new IllegalArgumentException("Duplicate war retirement ID");
+    return Set.copyOf(result);
+  }
+
+  private static String encodeReceipt(WarRetirementReceipt r) {
+    var v = new JsonObject();
+    v.addProperty("operationId", r.operationId().toString());
+    v.add("warIds", GSON.toJsonTree(r.warIds().stream().map(UUID::toString).sorted().toList()));
+    v.add(
+        "treatyIds", GSON.toJsonTree(r.treatyIds().stream().map(UUID::toString).sorted().toList()));
+    v.add(
+        "battlefieldIds",
+        GSON.toJsonTree(r.battlefieldIds().stream().map(UUID::toString).sorted().toList()));
+    return v.toString();
+  }
+
+  WarRetirementReceipt retire(UUID operation, NationId nation) {
+    Objects.requireNonNull(operation);
+    Objects.requireNonNull(nation);
+    var p = snapshot();
+    var reservation = WarDisbandAdmission.reserved(p).get(nation);
+    var admission = WarDisbandAdmission.receipts(p).get(operation);
+    if (reservation != null && !reservation.equals(operation)
+        || admission != null
+            && (!admission.accepted() || !admission.request().nationIds().contains(nation)))
+      throw new IllegalStateException("Conflicting disband admission retirement");
+    var old = receipts(p).get(nation);
+    if (old != null) {
+      if (!old.operationId().equals(operation))
+        throw new IllegalArgumentException("Conflicting war retirement operation");
+      return old;
+    }
+    var wars = new HashSet<UUID>();
+    var fields = new HashSet<UUID>();
+    var treaties = new HashSet<UUID>();
+    var allAffectedWars = new HashSet<UUID>();
+    family(p, WAR)
+        .forEach(
+            (id, json) -> {
+              var war = decodeWar(id, json);
+              if (war.isParticipant(nation)) {
+                allAffectedWars.add(id);
+                if (war.isActive()) wars.add(id);
+              }
+            });
+    family(p, FIELD)
+        .forEach(
+            (id, json) -> {
+              if (allAffectedWars.contains(id) || battlefieldNations(id, json).contains(nation)) {
+                if (hasPendingScore(json))
+                  throw new IllegalStateException(
+                      "Pending battlefield score must settle before retirement: " + id);
+                fields.add(id);
+                p.setProperty(ARCHIVED_FIELD + id, json);
+                p.remove(FIELD + id);
+              }
+            });
+    family(p, TREATY)
+        .forEach(
+            (id, json) -> {
+              var data = treatyData(json);
+              boolean affectedWar =
+                  data.containsKey("STATE")
+                      && allAffectedWars.contains(
+                          new PeaceTreatyStateCodec().decode(data.get("STATE")).treaty().warId());
+              if (treatyNations(id, data).contains(nation) || affectedWar) {
+                if (data.containsKey("STATE")) {
+                  var state = new PeaceTreatyStateCodec().decode(data.get("STATE"));
+                  if (state.payments().stream().anyMatch(pending -> !pending.completed()))
+                    throw new IllegalStateException(
+                        "Pending treaty payment must settle before retirement: " + id);
+                  var status = state.execution().status();
+                  if (status != PeaceTreatyExecution.Status.NOT_STARTED
+                      && status != PeaceTreatyExecution.Status.COMPLETED)
+                    throw new IllegalStateException(
+                        "Pending treaty execution must settle before retirement: " + id);
+                  if (state.treaty().status() == PeaceTreaty.PeaceTreatyStatus.ACCEPTED
+                      && status != PeaceTreatyExecution.Status.COMPLETED)
+                    throw new IllegalStateException(
+                        "Accepted treaty has no completed execution: " + id);
+                }
+                treaties.add(id);
+                p.setProperty(ARCHIVE + id, json);
+                p.remove(TREATY + id);
+              }
+            });
+    for (UUID id : wars) {
+      p.setProperty(ARCHIVED_WAR + id, p.getProperty(WAR + id));
+      p.remove(WAR + id);
+      p.setProperty(DELETED + id, operation.toString());
+    }
+    var receipt = new WarRetirementReceipt(operation, nation, wars, treaties, fields);
+    p.setProperty(RETIRED + nation, encodeReceipt(receipt));
+    archiveReparations(p);
+    save(p);
+    return receipt;
+  }
+
+  static Set<NationId> battlefieldNations(UUID id, String json) {
+    var value = JsonParser.parseString(json).getAsJsonObject();
+    if (value.has("warId") && !id.toString().equals(value.get("warId").getAsString()))
+      throw new IllegalArgumentException("Battlefield war mismatch");
+    var result = new HashSet<NationId>();
+    for (String group : List.of("battlefields", "strongholds"))
+      if (value.has(group))
+        for (var item : value.getAsJsonArray(group)) {
+          var entry = item.getAsJsonObject();
+          for (String key : List.of("controller", "owner", "pendingScoreRecipient"))
+            if (entry.has(key) && !entry.get(key).isJsonNull())
+              result.add(NationId.of(UUID.fromString(entry.get(key).getAsString())));
+        }
+    return Set.copyOf(result);
+  }
+
+  static boolean hasPendingScore(String json) {
+    var value = JsonParser.parseString(json).getAsJsonObject();
+    for (String group : List.of("battlefields", "strongholds"))
+      if (value.has(group))
+        for (var item : value.getAsJsonArray(group)) {
+          var entry = item.getAsJsonObject();
+          if (entry.has("pendingScoreEventId") && !entry.get("pendingScoreEventId").isJsonNull())
+            return true;
+        }
+    return false;
+  }
+
+  static void archiveDeletedWar(Properties p, UUID warId) {
+    String war = p.getProperty(WAR + warId);
+    String field = p.getProperty(FIELD + warId);
+    if (field != null) {
+      if (hasPendingScore(field))
+        throw new IllegalStateException("Pending battlefield score must settle before deletion");
+      p.setProperty(ARCHIVED_FIELD + warId, field);
+      p.remove(FIELD + warId);
+    }
+    family(p, TREATY)
+        .forEach(
+            (id, json) -> {
+              var data = treatyData(json);
+              if (!data.containsKey("STATE")) return;
+              var state = new PeaceTreatyStateCodec().decode(data.get("STATE"));
+              if (!state.treaty().warId().equals(warId)) return;
+              if (state.payments().stream().anyMatch(payment -> !payment.completed())
+                  || state.execution().status() != PeaceTreatyExecution.Status.NOT_STARTED
+                      && state.execution().status() != PeaceTreatyExecution.Status.COMPLETED
+                  || state.treaty().status() == PeaceTreaty.PeaceTreatyStatus.ACCEPTED
+                      && state.execution().status() != PeaceTreatyExecution.Status.COMPLETED)
+                throw new IllegalStateException(
+                    "Pending treaty operation must settle before war deletion");
+              p.setProperty(ARCHIVE + id, json);
+              p.remove(TREATY + id);
+            });
+    if (war != null) p.setProperty(ARCHIVED_WAR + warId, war);
+    archiveReparations(p);
+  }
+
+  private static void archiveReparations(Properties p) {
+    p.setProperty(
+        REPARATIONS,
+        ReparationAuthorityState.encode(
+            ReparationAuthorityState.retire(
+                reparations(p),
+                receipts(p).keySet().stream()
+                    .map(NationId::value)
+                    .collect(java.util.stream.Collectors.toSet()),
+                family(p, ARCHIVE).keySet())));
+  }
+
+  static Set<NationId> treatyNations(UUID id, Map<String, String> data) {
+    var result = new HashSet<NationId>();
+    if (data.containsKey("STATE")) {
+      var value = new PeaceTreatyStateCodec().decode(data.get("STATE"));
+      if (!value.treaty().id().equals(id))
+        throw new IllegalArgumentException("Treaty key mismatch");
+      result.add(value.treaty().victor());
+      result.add(value.treaty().defeated());
+      value
+          .reparations()
+          .forEach(
+              r -> {
+                result.add(NationId.of(r.payerId()));
+                result.add(NationId.of(r.receiverId()));
+              });
+      value.militaryRestrictions().forEach(r -> result.add(NationId.of(r.nationId())));
+      value
+          .resourceTributes()
+          .forEach(
+              r -> {
+                result.add(NationId.of(r.payerId()));
+                result.add(NationId.of(r.receiverId()));
+              });
+      value.politicalRestrictions().forEach(r -> result.add(NationId.of(r.nationId())));
+      value
+          .payments()
+          .forEach(
+              p -> {
+                result.add(p.payer());
+                result.add(p.receiver());
+              });
+    }
+    for (var entry : data.entrySet()) {
+      String key = entry.getKey();
+      String[] fields = entry.getValue().split(":", -1);
+      int[] indices;
+      if (key.startsWith("REPARATION_")) indices = new int[] {2, 3};
+      else if (key.startsWith("MILITARY_") || key.startsWith("POLITICAL_")) indices = new int[] {2};
+      else if (key.startsWith("TRIBUTE_")) indices = new int[] {2, 3};
+      else continue;
+      for (int index : indices) {
+        if (fields.length <= index)
+          throw new IllegalArgumentException("Invalid legacy treaty record");
+        result.add(NationId.of(UUID.fromString(fields[index])));
+      }
+    }
+    return Set.copyOf(result);
+  }
+
+  private void validate(Properties p) {
+    if (p.isEmpty() || p.size() == 1 && p.containsKey(DurablePropertiesStore.REVISION)) return;
+    boolean oldSchema = "1".equals(p.getProperty("format.version"));
+    if (!oldSchema && !"2".equals(p.getProperty("format.version")))
+      throw new IllegalArgumentException("Invalid war authority schema");
+    if (oldSchema && p.containsKey(REPARATIONS))
+      throw new IllegalArgumentException("Invalid mixed war authority schema");
+    var retired = receipts(p);
+    var deleted = family(p, DELETED);
+    var archived = family(p, ARCHIVE);
+    var archivedWars = family(p, ARCHIVED_WAR);
+    var archivedFields = family(p, ARCHIVED_FIELD);
+    for (String key : p.stringPropertyNames())
+      if (!Set.of(
+                  "format.version",
+                  "state.revision",
+                  "authority.version",
+                  "authority.sha256",
+                  REPARATIONS)
+              .contains(key)
+          && List.of(
+                  WAR,
+                  FIELD,
+                  TREATY,
+                  RETIRED,
+                  DELETED,
+                  ARCHIVE,
+                  ARCHIVED_WAR,
+                  ARCHIVED_FIELD,
+                  WarDisbandAdmission.PREFIX)
+              .stream()
+              .noneMatch(key::startsWith))
+        throw new IllegalArgumentException("Unknown war authority key: " + key);
+    if (oldSchema && !WarDisbandAdmission.receipts(p).isEmpty())
+      throw new IllegalArgumentException("Admission requires reparations authority");
+    if (!oldSchema) WarDisbandAdmission.validate(p, this);
+    if (!oldSchema)
+      ReparationAuthorityState.validateRetirement(
+          reparations(p),
+          retired.keySet().stream()
+              .map(NationId::value)
+              .collect(java.util.stream.Collectors.toSet()),
+          archived.keySet());
+    deleted.values().forEach(UUID::fromString);
+    var wars = family(p, WAR);
+    wars.forEach(
+        (id, json) -> {
+          War war = decodeWar(id, json);
+          if (deleted.containsKey(id)
+              || war.isActive() && war.allParticipants().stream().anyMatch(retired::containsKey))
+            throw new IllegalArgumentException("Retired war cannot be restored");
+        });
+    family(p, FIELD)
+        .forEach(
+            (id, json) -> {
+              if (deleted.containsKey(id)
+                  || archivedFields.containsKey(id)
+                  || wars.containsKey(id)
+                      && decodeWar(id, wars.get(id)).allParticipants().stream()
+                          .anyMatch(retired::containsKey)
+                  || battlefieldNations(id, json).stream().anyMatch(retired::containsKey))
+                throw new IllegalArgumentException("Retired battlefield cannot be restored");
+            });
+    family(p, TREATY)
+        .forEach(
+            (id, json) -> {
+              var data = treatyData(json);
+              if (archived.containsKey(id)
+                  || treatyNations(id, data).stream().anyMatch(retired::containsKey)
+                  || data.containsKey("STATE")
+                      && deleted.containsKey(
+                          new PeaceTreatyStateCodec().decode(data.get("STATE")).treaty().warId()))
+                throw new IllegalArgumentException("Retired treaty cannot be restored");
+              if (data.containsKey("STATE"))
+                validatePayments(new PeaceTreatyStateCodec().decode(data.get("STATE")));
+            });
+    archived.forEach((id, json) -> treatyNations(id, treatyData(json)));
+    archivedWars.forEach(this::decodeWar);
+    archivedFields.forEach(WarAuthority::battlefieldNations);
+    retired.forEach(
+        (nation, receipt) -> {
+          for (UUID id : receipt.warIds())
+            if (!receipt.operationId().toString().equals(deleted.get(id)))
+              throw new IllegalArgumentException("Missing retired war tombstone");
+          if (!archived.keySet().containsAll(receipt.treatyIds())
+              || !archivedWars.keySet().containsAll(receipt.warIds())
+              || !archivedFields.keySet().containsAll(receipt.battlefieldIds()))
+            throw new IllegalArgumentException("Incomplete retirement evidence");
+        });
+  }
+
+  private void transition(Properties previous, Properties next) {
+    WarDisbandAdmission.transition(previous, next, this);
+    if ("2".equals(previous.getProperty("format.version"))) {
+      if (!"2".equals(next.getProperty("format.version")))
+        throw new IllegalArgumentException("War authority cannot be downgraded");
+      ReparationAuthorityState.transition(reparations(previous), reparations(next), false);
+    }
+    for (String prefix : List.of(RETIRED, DELETED, ARCHIVE, ARCHIVED_WAR, ARCHIVED_FIELD))
+      for (var entry : family(previous, prefix).entrySet())
+        if (!entry.getValue().equals(next.getProperty(prefix + entry.getKey())))
+          throw new IllegalArgumentException("War retirement evidence is immutable");
+    var retired = receipts(previous);
+    family(previous, WAR)
+        .forEach(
+            (id, json) -> {
+              if (decodeWar(id, json).allParticipants().stream().anyMatch(retired::containsKey)
+                  && !json.equals(next.getProperty(WAR + id)))
+                throw new IllegalArgumentException("Retired nation history is immutable");
+            });
+    var nextRetired = receipts(next);
+    family(next, WAR)
+        .forEach(
+            (id, json) -> {
+              if (decodeWar(id, json).allParticipants().stream().anyMatch(nextRetired::containsKey)
+                  && !json.equals(previous.getProperty(WAR + id)))
+                throw new IllegalArgumentException(
+                    "Retired nation history cannot be created or changed");
+            });
+    family(previous, TREATY)
+        .forEach(
+            (id, json) -> {
+              var oldData = treatyData(json);
+              if (!oldData.containsKey("STATE")) return;
+              String after = next.getProperty(TREATY + id, next.getProperty(ARCHIVE + id));
+              if (after == null)
+                throw new IllegalArgumentException("Treaty history cannot be removed");
+              var newData = treatyData(after);
+              if (!newData.containsKey("STATE"))
+                throw new IllegalArgumentException("Treaty snapshot cannot be downgraded");
+              var before = new PeaceTreatyStateCodec().decode(oldData.get("STATE"));
+              var updated = new PeaceTreatyStateCodec().decode(newData.get("STATE"));
+              if (!before.treaty().warId().equals(updated.treaty().warId())
+                  || !before.treaty().victor().equals(updated.treaty().victor())
+                  || !before.treaty().defeated().equals(updated.treaty().defeated())
+                  || !before.treaty().terms().equals(updated.treaty().terms()))
+                throw new IllegalArgumentException("Treaty original terms are immutable");
+              for (int i = 0; i < before.execution().steps().size(); i++) {
+                if (before.execution().step(i).status() == PeaceTreatyExecution.StepStatus.APPLIED
+                    && updated.execution().step(i).status()
+                        != PeaceTreatyExecution.StepStatus.APPLIED)
+                  throw new IllegalArgumentException("Applied treaty term cannot be replayed");
+                var step = before.execution().step(i);
+                if ((step.status() == PeaceTreatyExecution.StepStatus.PREPARED
+                        || step.status() == PeaceTreatyExecution.StepStatus.APPLIED)
+                    && !step.compensationData()
+                        .equals(updated.execution().step(i).compensationData()))
+                  throw new IllegalArgumentException("Original treaty effect plan is immutable");
+              }
+              var payments = new HashMap<UUID, PeaceTreatyPayment>();
+              updated.payments().forEach(p -> payments.put(p.id(), p));
+              for (var payment : before.payments()) {
+                var current = payments.get(payment.id());
+                if (!payment.sameRequest(current)
+                    || payment.completed() && !payment.equals(current))
+                  throw new IllegalArgumentException("Treaty payment evidence is immutable");
+                if (!payment.completed() && current.completed())
+                  validateCompletedPayment(updated, current, false);
+              }
+            });
+  }
+
+  dev.starcore.starcore.module.war.WarDisbandAdmissionService.Receipt prepareDisband(
+      dev.starcore.starcore.module.war.WarDisbandAdmissionService.Request request) {
+    Objects.requireNonNull(request);
+    var current = load();
+    var existing = WarDisbandAdmission.receipts(current).get(request.operationId());
+    if (existing != null) {
+      if (!existing.request().equals(request))
+        throw new IllegalArgumentException("Conflicting disband admission request");
+      return existing;
+    }
+    var receipt =
+        new dev.starcore.starcore.module.war.WarDisbandAdmissionService.Receipt(
+            request, WarDisbandAdmission.decide(current, request, this));
+    current.setProperty(
+        WarDisbandAdmission.PREFIX + request.operationId(), WarDisbandAdmission.encode(receipt));
+    save(current);
+    return receipt;
+  }
+
+  // Reloads may skip many valid revisions. Only a local commit must observe the prepared
+  // predecessor and advance a ledger by exactly one original payment.
+  private static void validatePaymentCommit(Properties previous, Properties next) {
+    family(next, TREATY)
+        .forEach(
+            (id, json) -> {
+              var data = treatyData(json);
+              if (!data.containsKey("STATE")) return;
+              var updated = new PeaceTreatyStateCodec().decode(data.get("STATE"));
+              var oldPayments = new HashMap<UUID, PeaceTreatyPayment>();
+              String old = previous.getProperty(TREATY + id);
+              if (old != null) {
+                var before = treatyData(old);
+                if (before.containsKey("STATE"))
+                  new PeaceTreatyStateCodec()
+                      .decode(before.get("STATE"))
+                      .payments()
+                      .forEach(p -> oldPayments.put(p.id(), p));
+              }
+              for (var payment : updated.payments())
+                if (payment.completed()) {
+                  var before = oldPayments.get(payment.id());
+                  if (before == null)
+                    throw new IllegalArgumentException(
+                        "Treaty payment must be prepared before completion");
+                  if (!before.completed()) validateCompletedPayment(updated, payment, true);
+                }
+            });
+  }
+
+  private static void validatePayments(PeaceTreatyStateCodec.Decoded state) {
+    for (var p : state.payments())
+      if (!p.completed()) {
+        if (p.category()
+            == dev.starcore.starcore.module.treasury.NationTransferService.TransferCategory
+                .REPARATION) {
+          var record =
+              state.reparations().stream()
+                  .filter(r -> r.id().equals(p.recordId()))
+                  .findFirst()
+                  .orElseThrow(() -> new IllegalArgumentException("Pending reparation missing"));
+          if (!record.payerId().equals(p.payer().value())
+              || !record.receiverId().equals(p.receiver().value())
+              || record.paidAmount().compareTo(p.paidBefore()) != 0
+              || record.paidInstallments() != p.installmentsBefore()
+              || record.status() != WarReparation.ReparationStatus.ACTIVE
+              || record.remainingAmount().compareTo(p.amount()) < 0)
+            throw new IllegalArgumentException("Pending reparation ledger mismatch");
+        } else {
+          var record =
+              state.resourceTributes().stream()
+                  .filter(r -> r.id().equals(p.recordId()))
+                  .findFirst()
+                  .orElseThrow(() -> new IllegalArgumentException("Pending tribute missing"));
+          if (!record.payerId().equals(p.payer().value())
+              || !record.receiverId().equals(p.receiver().value())
+              || record.completedPayments() != p.installmentsBefore()
+              || record.calculateValue().compareTo(p.amount()) != 0
+              || !record.isActive())
+            throw new IllegalArgumentException("Pending tribute ledger mismatch");
+        }
+      }
+  }
+
+  private static void validateCompletedPayment(
+      PeaceTreatyStateCodec.Decoded state, PeaceTreatyPayment p, boolean exact) {
+    if (p.category()
+        == dev.starcore.starcore.module.treasury.NationTransferService.TransferCategory
+            .REPARATION) {
+      var record =
+          state.reparations().stream()
+              .filter(r -> r.id().equals(p.recordId()))
+              .findFirst()
+              .orElseThrow(() -> new IllegalArgumentException("Completed reparation missing"));
+      int delta = record.paidAmount().compareTo(p.paidBefore().add(p.amount()));
+      if (delta < 0
+          || record.paidInstallments() < p.installmentsBefore() + 1
+          || exact && (delta != 0 || record.paidInstallments() != p.installmentsBefore() + 1))
+        throw new IllegalArgumentException("Completed reparation ledger mismatch");
+    } else {
+      var record =
+          state.resourceTributes().stream().filter(r -> r.id().equals(p.recordId())).findFirst();
+      if (record.isPresent()
+          && (record.get().completedPayments() < p.installmentsBefore() + 1
+              || exact && record.get().completedPayments() != p.installmentsBefore() + 1))
+        throw new IllegalArgumentException("Completed tribute ledger mismatch");
+    }
+  }
+}
