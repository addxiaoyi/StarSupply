+          .when(federation)
+          .federationRetirementReceipt(any());
+      assertThat(module.disbandOperation(id).orElseThrow().state())
+          .isEqualTo(NationDisbandService.RecoveryState.VERIFICATION_UNAVAILABLE);
+      services.unregister(AllianceService.class);
+      assertThat(module.pendingDisbands().getFirst().state())
+          .isEqualTo(NationDisbandService.RecoveryState.VERIFICATION_UNAVAILABLE);
+      services.register(AllianceService.class, f.service());
+      assertThat(module.recoverDisband(id).state())
+          .isEqualTo(NationDisbandService.RecoveryState.COMPLETED);
+      assertThat(store.load()).isEqualTo(before);
+      assertThat(module.pendingDisbands()).isEmpty();
+      assertThat(module.disbandNation(f.b)).isTrue();
