+      f.balances("2000", "0");
+      mode.set(2);
+      assertThat(module.payReparation(debt.id(), new BigDecimal("25"))).isFalse();
+      f.balances("1975", "25");
+      assertThatThrownBy(() -> f.storage().retireNationWars(UUID.randomUUID(), payer))
+          .hasMessageContaining("Pending reparation");
+      mode.set(3);
+      assertThat(module.payReparation(debt.id(), new BigDecimal("90"))).isFalse();
+      assertThat(module.getReparation(debt.id()).orElseThrow().paidAmount())
+          .isEqualByComparingTo("0");
