+          NationStateCodec.toProperties(List.of(f.directory.get(f.a), f.directory.get(f.b))));
+      var services = fixture.services();
+      var module = fixture.module(store, services);
+      assertThat(module.disbandNation(f.a)).isTrue();
+      var before = store.load();
+      var id = NationStateCodec.snapshot(before).disbands().keySet().iterator().next();
+      var federation = spy(f.service());
+      f.create(federation, f.a, "Alpha");
