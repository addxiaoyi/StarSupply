new file mode 100644
--- /dev/null
+++ b/src/test/java/dev/starcore/starcore/war/WarDisbandAdmissionTest.java
@@ -0,0 +1,450 @@
+package dev.starcore.starcore.war;
+
+import static org.assertj.core.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+import dev.starcore.starcore.module.nation.model.NationId;
+import dev.starcore.starcore.module.war.WarDisbandAdmissionService.*;
+import dev.starcore.starcore.module.war.reparations.ReparationsStateCodec;
+import java.math.BigDecimal;
+import java.nio.file.Path;
+import java.sql.*;
+import java.time.Instant;
+import java.util.*;
+import java.util.concurrent.*;
+import java.util.concurrent.atomic.AtomicBoolean;
+import javax.sql.DataSource;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.*;
+
+class WarDisbandAdmissionTest {
+  @TempDir Path root;
+
+  @AfterEach
+  void releaseMocks() {
+    framework().clearInlineMocks();
+  }
+
+  WarRetirementTest fixture() {
+    var f = new WarRetirementTest();
+    f.root = root;
+    return f;
+  }
+
+  Request request(NationId... nations) {
+    return new Request(UUID.randomUUID(), List.of(nations));
+  }
+
+  Properties debt(Properties before, NationId payer, NationId receiver) {
+    var next = new Properties();
+    next.putAll(before);
+    var debt =
+        new WarReparation(
+            UUID.randomUUID(),
+            UUID.randomUUID(),
+            payer.value(),
+            receiver.value(),
+            new BigDecimal("1000"),
+            1,
+            Instant.ofEpochMilli(1000));
+    next.setProperty("reparation.count", "1");
+    next.setProperty("reparation.0.id", debt.id().toString());
+    next.setProperty("reparation.0.data", ReparationsStateCodec.encode(debt));
+    return next;
+  }
+
+  @ParameterizedTest
+  @CsvSource({"false,false", "true,false", "false,true", "true,true"})
+  void concurrentIndependentEffectAndAdmissionHaveOneDurableOutcome(boolean sql, boolean reparation)
+      throws Exception {
+    var f = fixture();
+    var setup = f.fixture(sql);
+    var admission = setup.storage();
+    var writer = setup.storage();
+    var original = request(f.a);
+    var war = War.declare("racing", f.a, f.b, WarGoal.TERRITORIAL);
+    var frozen = writer.freezeWar(war);
+    var before = writer.currentReparations();
+    var after = debt(before, f.a, f.b);
+    var start = new CyclicBarrier(2);
+    try (var pool = Executors.newFixedThreadPool(2)) {
+      var admit =
+          pool.submit(
+              () -> {
+                start.await(10, TimeUnit.SECONDS);
+                try {
+                  admission.prepareDisband(original);
+                  return null;
+                } catch (RuntimeException conflict) {
+                  return conflict;
+                }
+              });
+      var effect =
+          pool.submit(
+              () -> {
+                start.await(10, TimeUnit.SECONDS);
+                try {
+                  if (reparation) writer.saveReparations(before, after);
+                  else writer.writeWarRecord(frozen);
+                  return null;
+                } catch (RuntimeException conflict) {
+                  return conflict;
+                }
+              });
+      var admissionFailure = admit.get(20, TimeUnit.SECONDS);
+      var effectFailure = effect.get(20, TimeUnit.SECONDS);
+      if (admissionFailure != null)
+        assertThat(admissionFailure).isInstanceOf(IllegalStateException.class);
+      if (effectFailure != null)
+        assertThat(effectFailure).isInstanceOf(IllegalStateException.class);
+      var restarted = setup.storage();
+      var receipt = restarted.prepareDisband(original);
+      if (effectFailure == null) {
+        assertThat(receipt.decision())
