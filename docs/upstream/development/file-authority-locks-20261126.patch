+      assertThat(module.pendingDisbands()).hasSize(1);
+      assertThat(federation.getAllianceCount()).isEqualTo(1);
+      verify(federation, never()).retireNationFederation(any(), any());
+      assertThat(store.load()).isEqualTo(before);
+      assertThatThrownBy(() -> module.disbandNation(f.b))
+          .hasMessageContaining("Federation retirement recovery pending");
