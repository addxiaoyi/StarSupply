+  @Test
+  void killedOwnerReleasesTheOsLockAndKeepsTheSidecarIdentity() throws Exception {
+    Path path = FileAuthorityProcessProbe.authorityPath(root, "SNAPSHOT");
+    try (var child = new Child("hold", "SNAPSHOT")) {
+      child.await("ready");
+      assertThatThrownBy(() -> FileAuthorityLock.acquire(path))
+          .isInstanceOf(IOException.class)
+          .hasMessageContaining("busy");
+      child.kill();
+      try (var lock = FileAuthorityLock.acquire(path)) {
+        AtomicFilePersistence.replace(path, temp -> Files.writeString(temp, "after-owner-exit"));
+      }
+      assertThat(path.resolveSibling(path.getFileName() + ".lock")).isRegularFile();
+      assertThat(Files.readString(path)).isEqualTo("after-owner-exit");
+    }
+  }
+
+  @Test
+  void killedReplacementCannotLoseTheLastConfirmedSnapshotOrBlockRecovery() throws Exception {
+    Path path = FileAuthorityProcessProbe.authorityPath(root, "SNAPSHOT");
+    AtomicFilePersistence.replace(path, temp -> Files.writeString(temp, "confirmed"));
+    try (var child = new Child("atomic-interrupt", "SNAPSHOT")) {
+      child.await("ready");
+      assertThat(Files.readString(AtomicFilePersistence.temp(path))).isEqualTo("unconfirmed");
+      assertThatThrownBy(() -> AtomicFilePersistence.recover(path, Files::isRegularFile))
+          .isInstanceOf(IOException.class)
+          .hasMessageContaining("busy");
+      assertThat(AtomicFilePersistence.temp(path)).exists();
+      child.kill();
+      assertThat(AtomicFilePersistence.recover(path, Files::isRegularFile))
+          .isEqualTo(AtomicFilePersistence.RecoverySource.CURRENT);
+      assertThat(Files.readString(path)).isEqualTo("confirmed");
+      assertThat(AtomicFilePersistence.temp(path)).doesNotExist();
+    }
+  }
+
+  @Test
+  void processExitAfterConfirmedCommitKeepsTheDurableSnapshot() throws Exception {
+    try (var child = new Child("snapshot-save", "SNAPSHOT")) {
+      child.await("ready");
+      child.kill();
+      var store =
+          new DurablePropertiesStore(
+              FileAuthorityProcessProbe.authorityPath(root, "SNAPSHOT"),
+              null,
+              "starcore_probe",
+              Properties::new,
+              p -> {},
+              (a, b) -> {});
+      assertThat(store.load()).containsEntry("winner", child.token);
+    }
+  }
+
+  @Test
+  void deleteCannotRemoveAnotherProcessesUnfinishedReplacement() throws Exception {
+    Path path = FileAuthorityProcessProbe.authorityPath(root, "SNAPSHOT");
+    AtomicFilePersistence.replace(path, temp -> Files.writeString(temp, "confirmed"));
+    try (var child = new Child("atomic-interrupt", "SNAPSHOT")) {
+      child.await("ready");
+      assertThatThrownBy(() -> AtomicFilePersistence.delete(path))
+          .isInstanceOf(IOException.class)
+          .hasMessageContaining("busy");
+      assertThat(Files.readString(path)).isEqualTo("confirmed");
+      assertThat(Files.readString(AtomicFilePersistence.temp(path))).isEqualTo("unconfirmed");
+      child.kill();
+      AtomicFilePersistence.delete(path);
+      assertThat(path).doesNotExist();
+      assertThat(AtomicFilePersistence.temp(path)).doesNotExist();
+      assertThat(AtomicFilePersistence.backup(path)).doesNotExist();
+      assertThat(AtomicFilePersistence.deleteMarker(path)).doesNotExist();
+      assertThat(path.resolveSibling(path.getFileName() + ".lock")).isRegularFile();
+      assertThat(AtomicFilePersistence.recoveryTargets(root, ".properties")).isEmpty();
+    }
+  }
+
+  @Test
+  void failedSidecarOpenReleasesTheLocalLock() throws Exception {
+    Path path = root.resolve("state.properties"), sidecar = root.resolve("state.properties.lock");
+    Files.createDirectory(sidecar);
+    assertThatThrownBy(() -> FileAuthorityLock.acquire(path)).isInstanceOf(IOException.class);
+    Files.delete(sidecar);
+    try (var lock = FileAuthorityLock.acquire(path)) {
+      AtomicFilePersistence.replace(path, temp -> Files.writeString(temp, "retry"));
+    }
+    assertThat(Files.readString(path)).isEqualTo("retry");
+  }
+
+  @Test
+  void reentrantAliasesAndInterruptedWaitDoNotLeakLocalOrNativeLocks() throws Exception {
+    Path path = root.resolve("nested/state.properties");
+    try (var outer = FileAuthorityLock.acquire(path);
+        var inner = FileAuthorityLock.acquire(root.resolve("nested/../nested/state.properties"))) {
+      AtomicFilePersistence.replace(path, temp -> Files.writeString(temp, "nested"));
+      var started = new CountDownLatch(1);
+      var failure = new java.util.concurrent.atomic.AtomicReference<Throwable>();
+      var interrupted = new java.util.concurrent.atomic.AtomicBoolean();
+      var waiter =
+          new Thread(
+              () -> {
+                started.countDown();
+                try (var ignored = FileAuthorityLock.acquire(path)) {
+                  failure.set(new AssertionError("unexpected acquisition"));
+                } catch (Throwable error) {
+                  failure.set(error);
+                  interrupted.set(Thread.currentThread().isInterrupted());
+                }
+              });
+      waiter.start();
+      assertThat(started.await(1, TimeUnit.SECONDS)).isTrue();
+      waiter.interrupt();
+      waiter.join(2000);
+      assertThat(waiter.isAlive()).isFalse();
+      assertThat(failure.get()).isInstanceOf(IOException.class);
+      assertThat(interrupted).isTrue();
+    }
+    try (var next = FileAuthorityLock.acquire(path)) {
+      assertThat(Files.readString(path)).isEqualTo("nested");
+    }
+  }
+}
