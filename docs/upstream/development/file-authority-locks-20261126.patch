+    @Override
+    public void close() {
+      reparations.disable(null);
+      wars.disable(null);
+      federation.shutdown();
+      military.shutdown();
+      bilateral.shutdown();
+      cities.shutdown();
+      try {
+        diplomacy.disable(context);
+      } catch (DiplomacyStateConflictException fencedOldWriter) {
+        // The current authority wins over this stale instance's shutdown snapshot.
+      }
+      try {
+        treasury.disable(context);
+      } catch (RuntimeException fencedOldWriter) {
+        // Disposing a simulated crashed instance may reject its stale shutdown snapshot.
+        // Recovery above deliberately constructs fresh authorities before disposing old ones.
+        assertThat(fencedOldWriter.getClass().getName())
+            .isEqualTo("dev.starcore.starcore.module.treasury.TreasuryStateConflictException");
+      }
+      territory.shutdown();
+      persistence.stop();
+      ownedStores.forEach(AbstractModuleStateStorage::shutdown);
+    }
+  }
