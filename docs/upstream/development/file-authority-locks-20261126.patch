+package dev.starcore.starcore.module.nation.command;
+
+import static org.assertj.core.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+import dev.starcore.starcore.module.nation.*;
+import dev.starcore.starcore.module.nation.model.NationId;
+import java.util.*;
+import org.bukkit.command.CommandSender;
+import org.bukkit.plugin.Plugin;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+
+class NationDisbandRecoveryCommandTest {
+  final NationService nations =
+      mock(NationService.class, withSettings().extraInterfaces(NationDisbandService.class));
+  final NationDisbandService service = (NationDisbandService) nations;
+  final Plugin plugin = mock(Plugin.class);
+  final NationLifecycleCommand command = new NationLifecycleCommand(plugin, nations);
+  final CommandSender sender = mock(CommandSender.class);
+  final UUID id = UUID.randomUUID();
+  final NationId nation = NationId.random();
+  final NationDisbandService.Recovery pending =
+      new NationDisbandService.Recovery(
+          id, List.of(nation), NationDisbandService.RecoveryState.CLEANUP_PENDING, "等待清理");
+
+  void run(String... args) {
+    assertThat(command.onCommand(sender, null, "nation", args)).isTrue();
+  }
+
+  @Test
+  void permissionProtectsQueriesRetriesAndTabCompletion() {
+    run("disbandrecovery", "list");
+    run("disbandrecovery", "show", id.toString());
+    run("disbandrecovery", "retry", id.toString());
+    assertThat(command.onTabComplete(sender, null, "nation", new String[] {"disbandrecovery", ""}))
+        .isEmpty();
+    assertThat(command.onTabComplete(sender, null, "nation", new String[] {""}))
+        .doesNotContain("disbandrecovery");
+    verifyNoInteractions(nations, plugin);
+  }
+
+  @Test
+  void consoleQueriesShowOriginalTargetsAndRetryUsesOnlyOriginalOperation() {
+    when(sender.hasPermission("starcore.admin")).thenReturn(true);
+    when(service.pendingDisbands()).thenReturn(List.of(pending));
+    when(service.disbandOperation(id)).thenReturn(Optional.of(pending));
+    when(service.recoverDisband(id)).thenReturn(pending);
+    run("disbandrecovery", "list");
+    verify(service).pendingDisbands();
+    run("disbandrecovery", "show", id.toString());
+    verify(service).disbandOperation(id);
+    verify(sender).sendMessage(nation.toString());
+    run("disbandrecovery", "retry", id.toString());
+    verify(service).recoverDisband(id);
+    verifyNoMoreInteractions(nations);
+    verifyNoInteractions(plugin);
+  }
+
+  @ParameterizedTest
+  @ValueSource(strings = {"1-1-1-1-1", "bad", "", "00000000000000000000000000000000"})
+  void malformedOrAbbreviatedIdNeverTouchesService(String value) {
+    when(sender.hasPermission("starcore.admin")).thenReturn(true);
+    run("disbandrecovery", "retry", value);
+    verifyNoInteractions(nations, plugin);
+  }
+
+  @Test
+  void cancellationAndExtraArgumentsNeverCreateNewWork() {
+    when(sender.hasPermission("starcore.admin")).thenReturn(true);
+    run("disbandrecovery", "cancel", id.toString(), "confirm");
+    run("disbandrecovery", "retry", id.toString(), "confirm");
+    run("disbandrecovery", "retry");
+    run("disbandrecovery", "list", "-1");
+    verifyNoInteractions(nations, plugin);
+    assertThat(command.onTabComplete(sender, null, "nation", new String[] {"disbandrecovery", ""}))
+        .containsExactly("list", "show", "retry");
+    assertThat(command.onTabComplete(sender, null, "nation", new String[] {})).isEmpty();
+  }
+
+  @Test
+  void missingServiceUnknownOperationAndUnavailableAuthorityRemainVisible() {
+    when(sender.hasPermission("starcore.admin")).thenReturn(true);
+    new NationLifecycleCommand(plugin, mock(NationService.class))
+        .onCommand(sender, null, "nation", new String[] {"disbandrecovery"});
+    verify(sender).sendMessage("§c国家解散恢复服务不可用。");
+    when(service.disbandOperation(id)).thenReturn(Optional.empty());
+    run("disbandrecovery", "show", id.toString());
+    verify(sender).sendMessage("§c解散恢复未完成: 未知解散操作");
+    when(service.recoverDisband(id)).thenThrow(new IllegalStateException("cleanup unavailable"));
+    run("disbandrecovery", "retry", id.toString());
+    verify(sender).sendMessage("§c解散恢复未完成: cleanup unavailable");
+  }
+
+  @Test
+  void retiredCommandCannotQueryRetryOrForward() {
+    when(sender.hasPermission("starcore.admin")).thenReturn(true);
+    command.shutdown();
+    run("disbandrecovery", "list");
+    run("disbandrecovery", "retry", id.toString());
+    run("create", "New");
+    assertThat(command.onTabComplete(sender, null, "nation", new String[] {"disbandrecovery", ""}))
+        .isEmpty();
+    verifyNoInteractions(nations, plugin);
+  }
+
+  @ParameterizedTest
+  @org.junit.jupiter.params.provider.EnumSource(
+      value = NationDisbandService.RecoveryState.class,
+      names = {"ADMISSION_PENDING", "REJECTED"})
+  void originalAdmissionStatusIsShownWithoutStartingAnotherDisband(
+      NationDisbandService.RecoveryState state) {
+    when(sender.hasPermission("starcore.admin")).thenReturn(true);
+    var status = new NationDisbandService.Recovery(id, List.of(nation), state, "原准入决定");
+    when(service.disbandOperation(id)).thenReturn(Optional.of(status));
+    run("disbandrecovery", "show", id.toString());
+    verify(sender).sendMessage(contains(id + " " + state));
+    verify(service).disbandOperation(id);
+    verifyNoMoreInteractions(nations);
+    assertThat(state.pending())
+        .isEqualTo(state == NationDisbandService.RecoveryState.ADMISSION_PENDING);
+  }
+
+  @Test
+  void laterPagesRemainAccessibleForOperationsAndOriginalTargets() {
+    when(sender.hasPermission("starcore.admin")).thenReturn(true);
+    var rows = new ArrayList<NationDisbandService.Recovery>();
+    for (int i = 0; i < 21; i++)
+      rows.add(
+          new NationDisbandService.Recovery(
+              UUID.randomUUID(), List.of(nation), pending.state(), "pending"));
+    when(service.pendingDisbands()).thenReturn(rows);
+    run("disbandrecovery", "list", "2");
+    verify(sender).sendMessage(contains(rows.getLast().operationId().toString()));
+    verify(sender, never()).sendMessage(contains(rows.getFirst().operationId().toString()));
+    var ids = new ArrayList<NationId>();
+    for (int i = 0; i < 21; i++) ids.add(NationId.random());
+    when(service.disbandOperation(id))
+        .thenReturn(
+            Optional.of(new NationDisbandService.Recovery(id, ids, pending.state(), "pending")));
+    run("disbandrecovery", "show", id.toString(), "2");
+    verify(sender).sendMessage(ids.getLast().toString());
+    verify(sender, never()).sendMessage(ids.getFirst().toString());
+  }
+}
