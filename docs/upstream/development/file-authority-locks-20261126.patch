+  private AllianceResult setAllianceRelationInternal(
+      NationId actorId, UUID alliance1, UUID alliance2, AllianceRelationType relationType) {
+    // 检查联盟是否存在
+    Alliance sourceAlliance = alliances.get(alliance1);
+    if (sourceAlliance == null) {
+      return new AllianceResult(false, "联盟1不存在");
+    }
+    if (actorId == null || !sourceAlliance.leaderId().equals(actorId)) {
+      return new AllianceResult(false, "只有发起方联盟盟主可以设置外交关系");
+    }
+    if (!alliances.containsKey(alliance2)) {
+      return new AllianceResult(false, "联盟2不存在");
+    }
+
+    if (relationType == null) {
+      return new AllianceResult(false, "联盟关系类型不能为空");
+    }
+
+    if (alliance1.equals(alliance2)) {
+      return new AllianceResult(false, "不能设置与自己的关系");
+    }
+
+    // 创建关系（标准化键）
+    AlliancePairKey key = AlliancePairKey.of(alliance1, alliance2);
+    AllianceRelation relation =
+        new AllianceRelation(alliance1, alliance2, relationType, Instant.now(), null);
+    allianceRelations.put(key, relation);
+
+    // 发布事件
+    publishEvent(new AllianceRelationChangedEvent(alliance1, alliance2, relationType));
+
+    return new AllianceResult(true, "联盟关系已设置");
+  }
