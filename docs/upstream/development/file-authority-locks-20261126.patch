+  private List<NationDisbandService.Recovery> pendingDisbandDescriptions() {
+    var results = new ArrayList<NationDisbandService.Recovery>();
+    boolean federationPending = false;
+    for (var operation : List.copyOf(disbandOperations.values())) {
+      var result = describeDisband(operation);
+      if (result.state().pending()) results.add(result);
+      if (!operation.state().pending() && result.state().pending()) federationPending = true;
+    }
