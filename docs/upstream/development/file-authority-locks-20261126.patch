+
+/** Administrative recovery of original shared disband requests. Callers authorize access. */
+public interface NationDisbandService {
+  enum RecoveryState {
+    ADMISSION_PENDING,
+    CLEANUP_PENDING,
+    FEDERATION_PENDING,
+    VERIFICATION_UNAVAILABLE,
+    CONFLICT,
+    COMPLETED,
+    REJECTED;
+
+    public boolean pending() {
+      return this != COMPLETED && this != REJECTED;
+    }
+  }
+
+  record Recovery(UUID operationId, List<NationId> nationIds, RecoveryState state, String detail) {
+    public Recovery {
+      Objects.requireNonNull(operationId);
+      nationIds = List.copyOf(nationIds);
+      Objects.requireNonNull(state);
+      Objects.requireNonNull(detail);
+      if (nationIds.isEmpty() || new HashSet<>(nationIds).size() != nationIds.size())
+        throw new IllegalArgumentException("Invalid disband recovery targets");
+    }
+  }
+
+  Optional<Recovery> disbandOperation(UUID operationId);
+
+  List<Recovery> pendingDisbands();
+
+  /** Continues the original cleanup; never removes a new nation or reverses prior retirement. */
+  Recovery recoverDisband(UUID operationId);
+}
