+      var s = f.service();
+      var id = f.create(s, f.a, "Alpha");
+      f.join(s, id, f.a, f.b);
+      f.join(s, id, f.a, f.c);
+      f.join(s, id, f.a, f.d);
+      s.setMemberRole(id, f.a, f.c, AllianceMember.Role.OFFICER);
+      s.setMemberRole(id, f.a, f.d, AllianceMember.Role.OFFICER);
+      var store = f.storage();
+      var before = store.loadSnapshot();
+      var group =
+          before.members().get(id).stream()
+              .map(m -> new AllianceMember(m.nationId(), m.role(), Instant.EPOCH))
+              .toList();
+      store.saveAllSync(
+          before.alliances(),
+          Map.of(id, group),
+          before.membership(),
+          before.invites(),
+          before.relations(),
