+import org.junit.jupiter.params.provider.ValueSource;
+
+class FederationLifecycleTest {
+  @TempDir Path root;
+
+  record Setup(
+      AllianceModule module,
+      StarCoreContext context,
+      ServiceRegistry registry,
+      JavaPlugin plugin,
+      PluginManager manager,
+      PluginCommand command) {}
+
+  Setup setup(FederationTestFixture f) {
+    var context = mock(StarCoreContext.class);
+    var registry = new ServiceRegistry();
+    var plugin = mock(JavaPlugin.class);
+    var server = mock(Server.class);
+    var manager = mock(PluginManager.class);
+    var command = mock(PluginCommand.class);
+    when(context.plugin()).thenReturn(plugin);
+    when(context.serviceRegistry()).thenReturn(registry);
+    when(context.persistenceService()).thenReturn(f.persistence);
+    when(context.databaseService()).thenReturn(f.database);
+    when(plugin.getServer()).thenReturn(server);
+    when(server.getPluginManager()).thenReturn(manager);
+    when(plugin.getLogger()).thenReturn(Logger.getAnonymousLogger());
+    when(plugin.getCommand("fed")).thenReturn(command);
+    registry.register(NationService.class, f.nations);
+    registry.register(OnlinePlayerDirectory.class, mock(OnlinePlayerDirectory.class));
+    return new Setup(new AllianceModule(), context, registry, plugin, manager, command);
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void disableCancelsOwnedTaskFencesStaleTimerAndPreservesReplacementsEvenIfCancelFails(
+      boolean cancelFails) {
+    try (var f = new FederationTestFixture(root, false);
+        var scheduler = mockStatic(CompatScheduler.class);
+        var handlers = mockStatic(HandlerList.class)) {
+      var setup = setup(f);
+      var task = mock(BukkitTask.class);
+      var callback = new AtomicReference<Runnable>();
+      scheduler
+          .when(() -> CompatScheduler.asyncTimer(eq(setup.plugin), any(), eq(1200L), eq(1200L)))
+          .thenAnswer(
+              i -> {
+                callback.set(i.getArgument(1));
+                return task;
+              });
+      setup.module.enable(setup.context);
+      var old = setup.registry.require(FederationRetirementService.class);
+      var business = setup.registry.require(AllianceService.class);
+      assertThat(old).isSameAs(business);
+      var op = UUID.randomUUID();
+      old.retireNationFederation(op, f.a);
+      var replacement = mock(FederationRetirementService.class);
+      setup.registry.register(FederationRetirementService.class, replacement);
+      var commandReplacement = mock(CommandExecutor.class);
+      when(setup.command.getExecutor()).thenReturn(commandReplacement);
+      if (cancelFails) doThrow(new IllegalStateException("cancel failed")).when(task).cancel();
+      if (cancelFails)
+        assertThatThrownBy(() -> setup.module.disable(setup.context)).hasMessage("cancel failed");
+      else setup.module.disable(setup.context);
+      verify(task).cancel();
+      callback.get().run();
+      verify(setup.command, never()).setExecutor(null);
+      assertThat(setup.registry.require(FederationRetirementService.class)).isSameAs(replacement);
+      assertThat(setup.registry.find(AllianceService.class)).isEmpty();
+      assertThat(setup.module.getAllianceService()).isNull();
+      assertThatThrownBy(() -> business.createAlliance("Late", f.b))
+          .hasMessageContaining("stopped");
+      assertThat(f.service().federationRetirementReceipt(f.a)).isPresent();
+    }
+  }
+
+  @Test
+  void failedRegistrationLeavesCapturedServiceStoppedAndRegistryEmptyOfFederation() {
+    try (var f = new FederationTestFixture(root, false);
+        var scheduler = mockStatic(CompatScheduler.class);
+        var handlers = mockStatic(HandlerList.class)) {
+      var setup = setup(f);
+      var task = mock(BukkitTask.class);
+      scheduler
+          .when(() -> CompatScheduler.asyncTimer(eq(setup.plugin), any(), eq(1200L), eq(1200L)))
+          .thenReturn(task);
+      var captured = new AtomicReference<AllianceService>();
+      doAnswer(
+              i -> {
+                captured.set(setup.registry.require(AllianceService.class));
+                throw new IllegalStateException("listener failed");
+              })
+          .when(setup.manager)
+          .registerEvents(any(), any());
+      assertThatThrownBy(() -> setup.module.enable(setup.context)).hasMessage("listener failed");
+      verify(task).cancel();
+      assertThat(setup.registry.snapshot())
+          .containsOnlyKeys(NationService.class, OnlinePlayerDirectory.class);
+      assertThatThrownBy(() -> captured.get().createAlliance("Late", f.a))
+          .hasMessageContaining("stopped");
+      assertThat(f.service().getAllianceCount()).isZero();
+    }
+  }
+
+  @Test
+  void callbackShutdownBeforeCommitCancelsWriteAndLeavesAuthorityUntouched() {
+    try (var f = new FederationTestFixture(root, false)) {
+      var s = f.service();
+      when(f.nations.nationById(f.a))
+          .thenAnswer(
+              i -> {
+                s.shutdown();
+                return Optional.of(f.directory.get(f.a));
+              });
+      assertThatThrownBy(() -> s.createAlliance("Alpha", f.a))
+          .hasMessageContaining("stopped during");
+      assertThat(f.storage().loadSnapshot().alliances()).isEmpty();
+    }
+  }
+}
