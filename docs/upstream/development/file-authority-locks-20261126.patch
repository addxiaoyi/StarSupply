+  static Stream<Arguments> directoryBoundaries() {
+    return Stream.of(false, true)
+        .flatMap(
+            sql ->
+                Stream.of(1, 2, 3)
+                    .flatMap(
+                        save ->
+                            Stream.of(false, true)
+                                .flatMap(
+                                    after ->
+                                        Stream.of(false, true)
+                                            .map(
+                                                blockRead ->
+                                                    Arguments.of(sql, save, after, blockRead)))));
+  }
+
+  static final class DirectoryFault implements NationStateStorage {
+    final NationStateStorage delegate;
+    final int failAt;
+    final boolean after, blockRead;
+    int saves;
+    boolean failed;
+    NationDisbandTransaction original;
+
+    DirectoryFault(NationStateStorage delegate, int failAt, boolean after, boolean blockRead) {
+      this.delegate = delegate;
+      this.failAt = failAt;
+      this.after = after;
+      this.blockRead = blockRead;
+    }
+
+    public Properties load() {
+      if (failed && blockRead) throw new IllegalStateException("directory read unavailable");
+      return delegate.load();
+    }
+
+    public void save(Properties state) {
+      original =
+          NationStateCodec.snapshot(state).disbands().values().iterator().next().transaction();
+      boolean fail = ++saves == failAt;
+      if (!fail || after) delegate.save(state);
+      if (fail) {
+        failed = true;
+        throw new IllegalStateException("directory boundary");
+      }
+    }
+  }
+
+  @ParameterizedTest(name = "sql={0}, save={1}, after={2}, unavailable={3}")
+  @MethodSource("directoryBoundaries")
+  void sharedDirectoryCommitAndReadbackFailuresKeepActualCleanupEvidence(
+      boolean sql, int save, boolean after, boolean blockRead) throws Exception {
+    DirectoryFault[] fault = new DirectoryFault[1];
+    try (var first =
+        new Session(
+            sql, true, store -> fault[0] = new DirectoryFault(store, save, after, blockRead))) {
+      if (after && !blockRead) assertThat(first.nations.disbandNation(parent)).isTrue();
+      else
+        assertThatThrownBy(() -> first.nations.disbandNation(parent))
+            .isInstanceOf(IllegalStateException.class);
+      var original = fault[0].original;
+      assertThat(original).isNotNull();
+      var committed = first.receipts();
+      boolean intentSaved = save >= 2 || after;
+      try (var restart = new Session(sql, false)) {
+        if (intentSaved) {
+          assertThat(restart.operation().transaction()).isEqualTo(original);
+          restart.nations.recoverDisband(original.transactionId());
+        } else {
+          assertThat(NationStateCodec.snapshot(restart.directory.load()).disbands()).isEmpty();
+          assertThat(committed).isEmpty();
+          assertThat(restart.nations.nationById(parent)).isPresent();
+          assertThat(restart.nations.disbandNation(parent)).isTrue();
+        }
+        restart.assertComplete(restart.operation().transaction().transactionId());
+        assertThat(restart.receipts()).containsAllEntriesOf(committed);
+      }
+    }
+  }
