+      assertThat(s.getPendingInvites(f.b).getFirst().allianceName()).isEqualTo("Alpha|甲");
+      assertThat(s.getAnnouncement(id).orElseThrow().content()).isEqualTo("hello|world\n甲");
+      var op = UUID.randomUUID();
+      var proof = s.retireNationFederation(op, f.a);
+      for (var name : FAMILIES)
+        assertThat(Files.readAllBytes(folder.resolve(name))).isEqualTo(bytes.get(name));
+      assertThat(f.service().retireNationFederation(op, f.a)).isEqualTo(proof);
