+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void independentRecoveryDuringOriginalCleanupPreservesItsTerminalHistory(boolean sql)
+      throws Exception {
+    try (var first = new Session(sql, true)) {
+      var once = new AtomicBoolean(true);
+      doAnswer(
+              call -> {
+                var result = call.callRealMethod();
+                if (once.getAndSet(false)) {
+                  try (var independent = new Session(sql, false)) {
+                    independent.nations.recoverDisband(call.getArgument(0));
+                    independent.assertComplete(call.getArgument(0));
+                  }
+                }
+                return result;
+              })
+          .when(first.federation)
