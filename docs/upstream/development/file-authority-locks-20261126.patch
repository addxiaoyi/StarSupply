+      assertThatThrownBy(() -> module.disbandNation(f.a)).hasMessage("cleanup offline");
+      var before = store.load();
+      var id = NationStateCodec.snapshot(before).disbands().keySet().iterator().next();
+      clearInvocations(federation);
+      module.recoverPendingDisbandOnStartup();
+      assertThatThrownBy(module::saveState).hasMessageContaining("recovery pending");
+      clearInvocations(federation);
+      assertThat(module.pendingDisbands()).hasSize(1);
+      var recovery = module.disbandOperation(id).orElseThrow();
+      assertThat(recovery.state()).isEqualTo(NationDisbandService.RecoveryState.CLEANUP_PENDING);
+      assertThat(recovery.nationIds()).containsExactly(f.a);
+      assertThat(store.load()).isEqualTo(before);
+      verify(federation, never()).retireNationFederation(any(), any());
+      assertThat(module.disbandOperation(UUID.randomUUID())).isEmpty();
+      assertThatThrownBy(() -> module.recoverDisband(UUID.randomUUID()))
+          .hasMessageContaining("Unknown disband");
+      assertThat(store.load()).isEqualTo(before);
+      verify(federation, never()).retireNationFederation(any(), any());
+      doCallRealMethod().when(federation).retireNationFederation(any(), any());
+      var completed = module.recoverDisband(id);
+      assertThat(completed.state()).isEqualTo(NationDisbandService.RecoveryState.COMPLETED);
+      assertThat(completed.operationId()).isEqualTo(id);
+      assertThat(module.pendingDisbands()).isEmpty();
+      assertThat(f.service().federationRetirementReceipt(f.a).orElseThrow().operationId())
+          .isEqualTo(id);
+      var terminal = store.load();
+      assertThat(module.recoverDisband(id)).isEqualTo(completed);
+      assertThat(store.load()).isEqualTo(terminal);
+      assertThat(module.nationById(f.a)).isEmpty();
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
