diff --git a/src/main/java/dev/starcore/starcore/war/WarDisbandAdmission.java b/src/main/java/dev/starcore/starcore/war/WarDisbandAdmission.java
new file mode 100644
--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/war/WarDisbandAdmission.java
@@ -0,0 +1,194 @@
+package dev.starcore.starcore.war;
+
+import com.google.gson.*;
+import dev.starcore.starcore.module.nation.model.NationId;
+import dev.starcore.starcore.module.war.WarDisbandAdmissionService.*;
+import dev.starcore.starcore.module.war.reparations.ReparationAuthorityState;
+import java.util.*;
+
+/** Immutable decisions and effect fences in the same CAS envelope as wars and payments. */
+final class WarDisbandAdmission {
+  static final String PREFIX = "disbandAdmission.";
+
+  static String encode(Receipt receipt) {
+    var value = new JsonObject();
+    var nations = new JsonArray();
+    receipt.request().nationIds().forEach(id -> nations.add(id.toString()));
+    value.add("nations", nations);
+    value.addProperty("decision", receipt.decision().name());
+    return value.toString();
+  }
+
+  static Map<UUID, Receipt> receipts(Properties state) {
+    var result = new HashMap<UUID, Receipt>();
+    WarAuthority.family(state, PREFIX)
+        .forEach(
+            (id, json) -> {
+              var value = JsonParser.parseString(json).getAsJsonObject();
+              var nations = new ArrayList<NationId>();
+              for (var nation : value.getAsJsonArray("nations"))
+                nations.add(NationId.of(UUID.fromString(nation.getAsString())));
+              var receipt =
+                  new Receipt(
+                      new Request(id, nations),
+                      Decision.valueOf(value.get("decision").getAsString()));
+              if (!encode(receipt).equals(json))
+                throw new IllegalArgumentException("Noncanonical disband admission receipt");
+              result.put(id, receipt);
+            });
+    return Map.copyOf(result);
+  }
+
+  static Map<NationId, UUID> reserved(Properties state) {
+    var result = new HashMap<NationId, UUID>();
+    for (var receipt : receipts(state).values())
+      if (receipt.accepted())
+        for (var nation : receipt.request().nationIds())
+          if (result.putIfAbsent(nation, receipt.request().operationId()) != null)
+            throw new IllegalArgumentException("Conflicting disband admission reservations");
+    return Map.copyOf(result);
+  }
+
+  static Decision decide(Properties state, Request request, WarAuthority authority) {
+    var reserved = reserved(state);
+    var retired = WarAuthority.receipts(state);
+    for (var nation : request.nationIds())
+      if (reserved.containsKey(nation) || retired.containsKey(nation))
+        throw new IllegalStateException("Conflicting prior nation retirement or disband admission");
+    return blocked(state, new HashSet<>(request.nationIds()), authority);
+  }
+
+  private static Decision blocked(Properties state, Set<NationId> nations, WarAuthority authority) {
+    var wars = WarAuthority.family(state, WarAuthority.WAR);
+    for (var entry : wars.entrySet()) {
+      var war = authority.decodeWar(entry.getKey(), entry.getValue());
+      if (war.isActive() && war.allParticipants().stream().anyMatch(nations::contains))
+        return Decision.ACTIVE_WAR;
+    }
+    if (ReparationAuthorityState.blocksDisband(WarAuthority.reparations(state), uuids(nations)))
+      return Decision.ACTIVE_REPARATION;
+    for (var entry : WarAuthority.family(state, WarAuthority.TREATY).entrySet()) {
+      if (!affected(
+          state, WarAuthority.TREATY, entry.getKey(), entry.getValue(), nations, authority))
+        continue;
+      var data = WarAuthority.treatyData(entry.getValue());
+      if (!data.containsKey("STATE")) {
+        // Unknown legacy effects cannot authorize a new disband without independent evidence.
+        return Decision.PENDING_EFFECT;
+      }
+      var treaty = new PeaceTreatyStateCodec().decode(data.get("STATE"));
+      if (treaty.reparations().stream()
+          .anyMatch(r -> r.status() == WarReparation.ReparationStatus.ACTIVE))
+        return Decision.ACTIVE_REPARATION;
+      if (treaty.resourceTributes().stream().anyMatch(r -> r.isActive())
+          || treaty.payments().stream().anyMatch(p -> !p.completed())
+          || treaty.execution().status() != PeaceTreatyExecution.Status.NOT_STARTED
+              && treaty.execution().status() != PeaceTreatyExecution.Status.COMPLETED
+          || treaty.treaty().status() == PeaceTreaty.PeaceTreatyStatus.ACCEPTED
+              && treaty.execution().status() != PeaceTreatyExecution.Status.COMPLETED)
+        return Decision.PENDING_EFFECT;
+    }
+    for (var entry : WarAuthority.family(state, WarAuthority.FIELD).entrySet())
+      if (affected(state, WarAuthority.FIELD, entry.getKey(), entry.getValue(), nations, authority)
+          && WarAuthority.hasPendingScore(entry.getValue())) return Decision.PENDING_EFFECT;
+    return Decision.ACCEPTED;
+  }
+
+  static void validate(Properties state, WarAuthority authority) {
+    var reserved = reserved(state);
+    if (reserved.isEmpty()) return;
+    var retired = WarAuthority.receipts(state);
+    for (var entry : reserved.entrySet())
+      if (retired.containsKey(entry.getKey())
+          && !retired.get(entry.getKey()).operationId().equals(entry.getValue()))
+        throw new IllegalArgumentException("Disband admission and retirement operation differ");
+    if (blocked(state, reserved.keySet(), authority) != Decision.ACCEPTED)
+      throw new IllegalStateException("Disband admission fences new war and payment effects");
+  }
+
+  static void commit(Properties previous, Properties next, WarAuthority authority) {
+    var old = receipts(previous);
+    var added =
+        receipts(next).values().stream()
+            .filter(r -> !old.containsKey(r.request().operationId()))
+            .toList();
+    if (added.isEmpty()) return;
+    if (added.size() != 1) throw new IllegalArgumentException("One admission decision per commit");
+    var receipt = added.getFirst();
+    if (receipt.decision() != decide(previous, receipt.request(), authority))
+      throw new IllegalArgumentException("Admission decision does not match selected authority");
+    var unchanged = new Properties();
+    unchanged.putAll(next);
+    unchanged.remove(PREFIX + receipt.request().operationId());
+    if (!unchanged.equals(previous))
+      throw new IllegalArgumentException("Admission cannot change other authority state");
+  }
+
+  static void transition(Properties previous, Properties next, WarAuthority authority) {
+    for (var entry : WarAuthority.family(previous, PREFIX).entrySet())
+      if (!entry.getValue().equals(next.getProperty(PREFIX + entry.getKey())))
+        throw new IllegalArgumentException("Disband admission decisions are immutable");
+    var reserved = reserved(previous);
+    if (reserved.isEmpty()) return;
+    ReparationAuthorityState.validateDisbandFence(
+        WarAuthority.reparations(previous),
+        WarAuthority.reparations(next),
+        uuids(reserved.keySet()));
+    for (String prefix : List.of(WarAuthority.WAR, WarAuthority.TREATY, WarAuthority.FIELD)) {
+      var old = WarAuthority.family(previous, prefix);
+      var updated = WarAuthority.family(next, prefix);
+      var ids = new HashSet<>(old.keySet());
+      ids.addAll(updated.keySet());
+      for (var id : ids) {
+        String a = old.get(id), b = updated.get(id);
+        if (Objects.equals(a, b)) continue;
+        if (!(a != null && affected(previous, prefix, id, a, reserved.keySet(), authority))
+            && !(b != null && affected(next, prefix, id, b, reserved.keySet(), authority)))
+          continue;
+        String archive =
+            prefix.equals(WarAuthority.TREATY) ? WarAuthority.ARCHIVE : WarAuthority.ARCHIVED_FIELD;
+        boolean retiring =
+            WarAuthority.receipts(next).entrySet().stream()
+                .anyMatch(
+                    e ->
+                        e.getValue().operationId().equals(reserved.get(e.getKey()))
+                            && a != null
+                            && affected(previous, prefix, id, a, Set.of(e.getKey()), authority));
+        if (prefix.equals(WarAuthority.WAR)
+            || a == null
+            || b != null
+            || !a.equals(next.getProperty(archive + id))
+            || !retiring)
+          throw new IllegalStateException("Disband admission freezes original war effect state");
+      }
+    }
+  }
