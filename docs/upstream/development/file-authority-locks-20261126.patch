+package dev.starcore.starcore.module.nation;
+
+import static org.assertj.core.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+import dev.starcore.starcore.foundation.territory.TerritoryService;
+import dev.starcore.starcore.module.city.CityService;
+import dev.starcore.starcore.module.diplomacy.DiplomacyRelationService;
