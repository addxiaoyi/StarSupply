+  private NationDisbandService.Recovery describeDisband(NationDisbandOperation operation) {
+    var transaction = operation.transaction();
+    var status = NationDisbandService.RecoveryState.CLEANUP_PENDING;
+    String detail = "国家目录已删除，等待沿原编号完成外部清理。";
+    if (operation.state() == NationDisbandOperation.State.ADMISSION_PENDING) {
+      status = NationDisbandService.RecoveryState.ADMISSION_PENDING;
+      detail = "国家仍保留，等待按原编号确认战争与赔款准入。";
+    } else if (operation.state() == NationDisbandOperation.State.REJECTED) {
+      status = NationDisbandService.RecoveryState.REJECTED;
+      detail = "本次解散准入已拒绝，国家保留：" + operation.admission().decision();
+    } else if (operation.state() == NationDisbandOperation.State.COMPLETED) {
+      status = NationDisbandService.RecoveryState.COMPLETED;
+      detail = "共享清理已完成，多国联盟原编号回执已核实。";
+      try {
+        var federation = requireFederationRetirementAuthority();
+        for (var nationId : transaction.nationIds()) {
+          var receipt = federation.federationRetirementReceipt(nationId).orElse(null);
+          if (receipt == null) {
+            status = NationDisbandService.RecoveryState.FEDERATION_PENDING;
+            detail = "旧共享完成记录仍需补齐多国联盟退役。";
+          } else if (!transaction.transactionId().equals(receipt.operationId())
+              || !nationId.equals(receipt.nationId())) {
+            status = NationDisbandService.RecoveryState.CONFLICT;
+            detail = "多国联盟回执与原解散编号或国家不匹配，需要核对证据。";
+            break;
+          }
+        }
+      } catch (RuntimeException unavailable) {
+        status = NationDisbandService.RecoveryState.VERIFICATION_UNAVAILABLE;
+        detail = "多国联盟退役回执暂不可核实，恢复服务后重试。";
+      }
+    }
+    return new NationDisbandService.Recovery(
+        transaction.transactionId(), transaction.nationIds(), status, detail);
+  }
