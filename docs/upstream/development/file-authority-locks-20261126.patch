+    write(f, FAMILIES.get(2), properties(n, a));
+    write(
+        f,
+        FAMILIES.get(3),
+        properties(f.b.toString(), a + "|Alpha|甲|1234|" + n + "|9999999999999"));
+    write(f, FAMILIES.get(4), new Properties());
+    write(f, FAMILIES.get(5), properties(a, "hello|world\n甲|" + n + "|1234|" + a));
