+/** Child-JVM entry point. No Bukkit bootstrap or mocked storage participates in these probes. */
+public final class FileAuthorityProcessProbe {
+  static final String PREFIX = "dev.starcore.starcore.";
+  static final NationId NATION =
+      NationId.of(UUID.fromString("10000000-0000-0000-0000-000000000001"));
+
+  static Path authorityPath(Path root, String kind) {
+    return root.resolve(
+        switch (kind) {
+          case "NATION" -> "nation/nations.properties";
+          case "TERRITORY" -> "territory/claims.properties";
+          case "TREASURY" -> "treasury/treasury.properties";
+          case "DIPLOMACY" -> "diplomacy/relations.properties";
+          case "CITY" -> "cities/ledger.json";
+          case "BILATERAL" -> "diplomacy/alliance_state.properties";
+          case "MILITARY" -> "military-alliance/military_alliance_state.properties";
+          case "FEDERATION" -> "alliance/federation-authority.properties";
+          case "WAR" -> "wars/authority.properties";
+          default -> "snapshot.properties";
+        });
+  }
+
+  public static void main(String[] args) throws Exception {
+    String mode = args[0], kind = args[1], token = args[3];
+    Path root = Path.of(args[2]);
+    Path path = authorityPath(root, kind);
+    if (mode.equals("hold")) {
+      try (var lock = FileAuthorityLock.acquire(path)) {
+        signal(root, token, "ready", "held");
+        new BufferedReader(new InputStreamReader(System.in)).readLine();
+      }
+      return;
+    }
+    if (mode.equals("atomic-interrupt")) {
+      AtomicFilePersistence.replace(
+          path,
+          temp -> {
+            Files.writeString(temp, "unconfirmed");
+            signal(root, token, "ready", "temp-written");
+            new BufferedReader(new InputStreamReader(System.in)).readLine();
+          });
+      return;
+    }
+    if (mode.equals("snapshot-save")) {
+      var store =
+          new DurablePropertiesStore(
+              path, null, "starcore_probe", Properties::new, p -> {}, (a, b) -> {});
+      store.load();
+      var value = new Properties();
+      value.setProperty("winner", token);
+      store.save(value);
+      signal(root, token, "ready", "committed");
+      new BufferedReader(new InputStreamReader(System.in)).readLine();
+      return;
+    }
+    if (mode.equals("read")) signal(root, token, "loading", "before-load");
+    var work = prepare(root, kind, UUID.fromString(token), mode.equals("race"));
+    signal(root, token, "ready", "selected");
+    if (mode.equals("read")) return;
+    if (new BufferedReader(new InputStreamReader(System.in)).readLine() == null) return;
+    signal(root, token, "started", "saving");
+    try {
+      work.run();
+      signal(root, token, "result", "OK");
+    } catch (RuntimeException error) {
+      String trace = stack(error);
+      if (!trace.toLowerCase(Locale.ROOT).matches("(?s).*(conflict|changed|stale).*")) {
+        signal(root, token, "result", "ERROR\n" + trace);
+        throw error;
+      }
+      signal(root, token, "result", "CONFLICT\n" + trace);
+    }
+  }
+
+  static Runnable prepare(Path root, String kind, UUID operation) throws Exception {
+    return prepare(root, kind, operation, true);
+  }
+
+  static Runnable prepare(Path root, String kind, UUID operation, boolean write) throws Exception {
+    var persistence =
+        new PersistenceService(null, null) {
+          @Override
+          public Path namespacePath(String namespace) throws IOException {
+            return Files.createDirectories(root.resolve(namespace));
+          }
+        };
+    if (kind.equals("BILATERAL")) {
+      var storage = new AllianceStorage(null, persistence, null);
+      storage.loadStateSnapshot();
+      return () -> storage.retire(operation, NATION);
+    }
+    if (kind.equals("MILITARY")) {
+      var storage = new MilitaryAllianceStorage(null, persistence, null);
+      storage.loadState();
+      return () -> storage.retire(operation, NATION);
+    }
+    if (kind.equals("WAR")) {
+      Object backend = create("war.WarStorageBackend", new DatabaseService(null, null));
+      Object codec = create("war.WarJsonCodec", new Gson(), Logger.getAnonymousLogger());
+      java.util.function.Supplier<Properties> empty =
+          () -> (Properties) call(type("war.WarAuthority"), "empty");
+      Object storage =
+          create(
+              "war.WarAuthority",
+              root.resolve("wars"),
+              backend,
+              codec,
+              empty,
+              (java.util.function.Supplier<Properties>) Properties::new);
+      var selected = (Properties) call(storage, "load");
+      selected.setProperty(
+          "disbandAdmission." + operation,
+          "{\"nations\":[\"" + NATION + "\"],\"decision\":\"ACCEPTED\"}");
+      return () -> call(storage, "save", selected);
+    }
+    if (kind.equals("FEDERATION")) {
+      var storage =
+          new dev.starcore.starcore.module.alliance.AllianceStorage(
+              new DatabaseService(null, null), persistence, null);
+      var selected = call(storage, "loadSnapshot");
+      if (!write) return () -> {};
+      var candidate = call(selected, "retire", operation, NATION);
+      return () -> call(storage, "saveSnapshot", selected, candidate);
+    }
+    if (kind.equals("CITY")) {
+      var storage = create("module.city.FileCityLedgerStorage", root.resolve("cities"));
+      var selected = call(storage, "load");
+      var receipt = new CityRetirementService.CityRetirementReceipt(operation, NATION, List.of());
+      var candidate = call(selected, "next", Map.of(), Set.of(), Map.of(NATION, receipt));
+      return () -> call(storage, "save", candidate);
+    }
+    if (kind.equals("TERRITORY")) {
+      var storage = create("foundation.territory.FileTerritoryLedgerStorage", persistence);
+      call(storage, "load");
+      var receipt =
+          new TerritoryRetirementService.RetirementReceipt(operation, NATION.toString(), 0);
+      var candidate =
+          create(
+              "foundation.territory.TerritoryLedger",
+              Map.of(),
+              Map.of(),
+              Map.of(),
+              Map.of(NATION.toString(), receipt));
+      return () -> call(storage, "save", candidate);
+    }
+    String domain = kind.toLowerCase(Locale.ROOT);
+    String name =
+        "module."
+            + domain
+            + ".Persistence"
+            + switch (kind) {
+              case "NATION" -> "Nation";
+              case "TREASURY" -> "Treasury";
+              case "DIPLOMACY" -> "Diplomacy";
+              default -> throw new IllegalArgumentException(kind);
+            }
+            + "StateStorage";
+    var storage = create(name, domain, persistence);
+    var selected = (Properties) call(storage, "load");
+    if (!write) return () -> {};
+    final Object candidate;
+    if (kind.equals("NATION")) {
+      var nation =
+          new Nation(NATION, "Writer" + operation.toString().substring(0, 8), operation, "Founder");
+      candidate = call(type("module.nation.NationStateCodec"), "toProperties", List.of(nation));
+    } else if (kind.equals("TREASURY")) {
+      var receipt =
+          new TreasuryRetirementService.TreasuryRetirementReceipt(
+              operation, NATION, BigDecimal.ZERO);
+      var state =
+          create(
+              "module.treasury.TreasuryStateCodec$TreasuryState",
+              Map.of(),
+              Map.of(),
+              Map.of(),
+              Map.of(),
+              Map.of(NATION, receipt));
+      candidate = call(type("module.treasury.TreasuryStateCodec"), "toProperties", state);
+    } else
+      candidate =
+          call(type("module.diplomacy.DiplomacyAuthority"), "retire", selected, operation, NATION);
+    return () -> call(storage, "save", candidate);
+  }
+
+  static Class<?> type(String name) {
+    try {
+      return Class.forName(PREFIX + name);
+    } catch (ClassNotFoundException error) {
+      throw new IllegalStateException(error);
+    }
+  }
+
+  static boolean matches(Class<?>[] types, Object[] args) {
+    if (types.length != args.length) return false;
+    for (int i = 0; i < types.length; i++)
+      if (args[i] != null && !types[i].isInstance(args[i])) return false;
+    return true;
+  }
+
+  static Object create(String name, Object... args) {
+    try {
+      for (var c : type(name).getDeclaredConstructors())
+        if (matches(c.getParameterTypes(), args)) {
+          c.setAccessible(true);
+          return c.newInstance(args);
+        }
+      throw new IllegalStateException("No constructor " + name);
+    } catch (ReflectiveOperationException error) {
+      throw unwrap(error);
+    }
+  }
+
+  static Object call(Object target, String name, Object... args) {
+    Class<?> type = target instanceof Class<?> c ? c : target.getClass();
+    try {
+      for (var m : type.getDeclaredMethods())
+        if (m.getName().equals(name) && matches(m.getParameterTypes(), args)) {
+          m.setAccessible(true);
+          return m.invoke(target instanceof Class<?> ? null : target, args);
+        }
+      throw new IllegalStateException("No method " + type.getName() + "." + name);
+    } catch (ReflectiveOperationException error) {
+      throw unwrap(error);
+    }
+  }
+
+  static RuntimeException unwrap(ReflectiveOperationException error) {
+    var cause = error instanceof InvocationTargetException ? error.getCause() : error;
+    return cause instanceof RuntimeException r ? r : new IllegalStateException(cause);
+  }
+
+  static void signal(Path root, String token, String state, String text) throws IOException {
+    Files.writeString(root.resolve(token + "." + state), text);
+  }
+
+  static String stack(Throwable error) {
+    var text = new StringWriter();
+    error.printStackTrace(new PrintWriter(text));
+    return text.toString();
+  }
+}
