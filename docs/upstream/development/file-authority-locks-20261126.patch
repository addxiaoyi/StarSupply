+/** Original retirement result, including identities needed to reject delayed snapshots. */
+public record WarRetirementReceipt(
+    UUID operationId,
+    NationId nationId,
+    Set<UUID> warIds,
+    Set<UUID> treatyIds,
+    Set<UUID> battlefieldIds) {
