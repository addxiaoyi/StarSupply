+import java.util.*;
+import org.junit.jupiter.api.Test;
+
+class NationDisbandWarRetirementTest {
+  @Test
+  void pendingWarRetirementRunsBeforeExternalCleanupAndRetriesOriginalOperation() {
+    var nation = NationId.random();
+    var operation = UUID.randomUUID();
+    var transaction =
+        new NationDisbandTransaction(
+            operation, List.of(nation), Map.of(), List.of(), List.of(), List.of());
+    var land = mock(TerritoryService.class);
+    var city = mock(CityService.class);
+    var diplomacy = mock(DiplomacyRelationService.class);
+    var alliance = mock(AllianceService.class);
+    var military = mock(MilitaryAllianceService.class);
+    var war = mock(WarService.class, withSettings().extraInterfaces(WarRetirementService.class));
+    var retirement = (WarRetirementService) war;
+    var proof =
+        new WarRetirementReceipt(operation, nation, Set.of(UUID.randomUUID()), Set.of(), Set.of());
+    when(retirement.retireNationWars(operation, nation))
+        .thenThrow(new IllegalStateException("Pending treaty payment"))
+        .thenReturn(proof);
+    assertThatThrownBy(
+            () ->
+                NationDisbandRecovery.completeCommitted(
+                    transaction, land, diplomacy, null, alliance, military, war, city))
+        .hasMessageContaining("Pending treaty payment");
+    verifyNoInteractions(land, diplomacy, alliance, military);
+    NationDisbandRecovery.completeCommitted(
+        transaction, land, diplomacy, null, alliance, military, war, city);
+    verify(retirement, times(2)).retireNationWars(operation, nation);
+    verify(war, never()).clearNationWarState(any());
+    verify(diplomacy).clearNationRelations(nation);
+  }
+
+  @Test
+  void mismatchedRetirementReceiptStopsCleanup() {
+    var nation = NationId.random();
+    var operation = UUID.randomUUID();
+    var transaction =
+        new NationDisbandTransaction(
+            operation, List.of(nation), Map.of(), List.of(), List.of(), List.of());
+    var land = mock(TerritoryService.class);
+    var diplomacy = mock(DiplomacyRelationService.class);
+    var war = mock(WarService.class, withSettings().extraInterfaces(WarRetirementService.class));
+    when(((WarRetirementService) war).retireNationWars(operation, nation))
+        .thenReturn(
+            new WarRetirementReceipt(UUID.randomUUID(), nation, Set.of(), Set.of(), Set.of()));
+    assertThatThrownBy(
+            () ->
+                NationDisbandRecovery.completeCommitted(
+                    transaction,
+                    land,
+                    diplomacy,
+                    null,
+                    mock(AllianceService.class),
+                    mock(MilitaryAllianceService.class),
+                    war,
+                    mock(CityService.class)))
+        .hasMessageContaining("Conflicting war retirement");
+    verifyNoInteractions(land, diplomacy);
+  }
+}
