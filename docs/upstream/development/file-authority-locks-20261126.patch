+  }
+
+  private AllianceResult setMemberRoleInternal(
+      UUID allianceId, NationId actorId, NationId nationId, AllianceMember.Role role) {
+    Alliance alliance = alliances.get(allianceId);
+    if (alliance == null) {
+      return new AllianceResult(false, "联盟不存在");
+    }
+    if (actorId == null || !alliance.leaderId().equals(actorId)) {
+      return new AllianceResult(false, "只有盟主可以设置成员角色");
+    }
+    if (nationId == null || role == null) {
+      return new AllianceResult(false, "目标国家和角色不能为空");
+    }
+    if (alliance.leaderId().equals(nationId)) {
+      return new AllianceResult(false, "不能修改盟主角色");
+    }
+    if (role == AllianceMember.Role.LEADER) {
+      return new AllianceResult(false, "请使用领导权转移接口设置新盟主");
+    }
+
+    List<AllianceMember> members = allianceMembers.get(allianceId);
+    if (members == null) {
+      return new AllianceResult(false, "联盟成员列表为空");
+    }
+    for (int i = 0; i < members.size(); i++) {
+      AllianceMember member = members.get(i);
+      if (member.nationId().equals(nationId)) {
+        members.set(i, new AllianceMember(member.nationId(), role, member.joinedAt()));
+
+        return new AllianceResult(
+            true,
+            "已设置 "
+                + nationService.nationById(nationId).map(Nation::name).orElse("未知")
+                + " 的角色为 "
+                + role.name());
+      }
+    }
+    return new AllianceResult(false, "该国家不是联盟成员");
+  }
+
+  private AllianceResult transferLeadershipInternal(
+      UUID allianceId, NationId newLeaderId, NationId currentLeaderId) {
+    Alliance alliance = alliances.get(allianceId);
+    if (alliance == null) {
+      return new AllianceResult(false, "联盟不存在");
+    }
+
+    // 只有现任盟主可以转移领导权
+    if (!alliance.leaderId().equals(currentLeaderId)) {
+      return new AllianceResult(false, "只有现任盟主可以转移领导权");
+    }
+
+    if (newLeaderId == null || currentLeaderId == null) {
+      return new AllianceResult(false, "新旧盟主不能为空");
+    }
+
+    if (newLeaderId.equals(currentLeaderId)) {
+      return new AllianceResult(false, "新盟主不能与现任盟主相同");
+    }
+
+    // 检查新盟主是否是成员
+    List<AllianceMember> members = allianceMembers.get(allianceId);
+    if (members == null || members.stream().noneMatch(m -> m.nationId().equals(newLeaderId))) {
+      return new AllianceResult(false, "新盟主必须是联盟成员");
+    }
+
+    // 更新盟主
+    Alliance newAlliance =
+        new Alliance(
+            alliance.id(), alliance.name(), newLeaderId, alliance.createdAt(), alliance.emblem());
+    alliances.put(allianceId, newAlliance);
+
+    // 更新成员角色
+    if (members != null) {
+      for (int i = 0; i < members.size(); i++) {
+        AllianceMember member = members.get(i);
+        if (member.nationId().equals(newLeaderId)) {
+          members.set(
+              i,
+              new AllianceMember(member.nationId(), AllianceMember.Role.LEADER, member.joinedAt()));
+        } else if (member.nationId().equals(currentLeaderId)) {
+          members.set(
+              i,
+              new AllianceMember(member.nationId(), AllianceMember.Role.MEMBER, member.joinedAt()));
+        }
+      }
+    }
+
+    String newLeaderName = nationService.nationById(newLeaderId).map(Nation::name).orElse("未知");
+
+    // 发布事件
+    publishEvent(
+        new AllianceLeadershipChangedEvent(
+            allianceId, currentLeaderId, newLeaderId, newLeaderName));
+
+    return new AllianceResult(true, "领导权已转移给 " + newLeaderName);
+  }
