+  @Test
+  void codecRejectsUnknownPartialAndNoncanonicalState() {
+    var p = FederationCodec.encode(FederationState.empty());
+    p.setProperty("unexpected", "value");
+    assertThatThrownBy(() -> FederationCodec.decode(p)).hasMessageContaining("unknown");
+    var partial = FederationCodec.encode(FederationState.empty());
+    partial.setProperty(
+        "retired." + UUID.randomUUID() + ".operation", UUID.randomUUID().toString());
+    assertThatThrownBy(() -> FederationCodec.decode(partial)).isInstanceOf(RuntimeException.class);
+    var noncanonical = FederationCodec.encode(FederationState.empty());
+    noncanonical.setProperty(
+        "dissolved." + UUID.randomUUID().toString().toUpperCase(Locale.ROOT), "true");
+    assertThatThrownBy(() -> FederationCodec.decode(noncanonical))
+        .hasMessageContaining("Noncanonical UUID");
+  }
+}
diff --git a/src/test/java/dev/starcore/starcore/module/alliance/FederationSqlCommitTest.java b/src/test/java/dev/starcore/starcore/module/alliance/FederationSqlCommitTest.java
new file mode 100644
--- /dev/null
+++ b/src/test/java/dev/starcore/starcore/module/alliance/FederationSqlCommitTest.java
@@ -0,0 +1,103 @@
+package dev.starcore.starcore.module.alliance;
+
+import static org.assertj.core.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+import java.lang.reflect.*;
+import java.nio.file.Path;
+import java.sql.*;
+import java.util.*;
+import java.util.concurrent.atomic.AtomicBoolean;
+import javax.sql.DataSource;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+class FederationSqlCommitTest {
+  @TempDir Path root;
+
+  @Test
+  void actualCommitResponseLossConfirmsOriginalReceiptOrFreezesUntilReplacement() {
+    try (var f = new FederationTestFixture(root, true)) {
+      var armed = new AtomicBoolean();
+      var failRead = new AtomicBoolean();
+      var loseRead = new AtomicBoolean();
+      DataSource source =
+          (DataSource)
+              Proxy.newProxyInstance(
+                  getClass().getClassLoader(),
+                  new Class<?>[] {DataSource.class},
+                  (proxy, m, args) -> {
+                    if (m.getName().equals("getConnection")) {
+                      if (failRead.get()) throw new SQLException("readback offline");
+                      var actual = (Connection) invoke(f.sql, m, args);
+                      return Proxy.newProxyInstance(
+                          getClass().getClassLoader(),
+                          new Class<?>[] {Connection.class},
+                          (p, method, a) -> {
+                            var value = invoke(actual, method, a);
+                            if (method.getName().equals("commit")
+                                && armed.compareAndSet(true, false)) {
+                              if (loseRead.get()) failRead.set(true);
+                              throw new SQLException("committed but reply lost");
+                            }
+                            return value;
+                          });
+                    }
+                    return invoke(f.sql, m, args);
+                  });
+      when(f.database.dataSource()).thenReturn(Optional.of(source));
+      var s = f.service();
+      f.create(s, f.a, "Alpha");
+      var first = UUID.randomUUID();
+      armed.set(true);
+      var proof = s.retireNationFederation(first, f.a);
+      assertThat(proof.dissolvedAlliance()).isTrue();
+      f.create(s, f.b, "Bravo");
+      var second = UUID.randomUUID();
+      loseRead.set(true);
+      armed.set(true);
+      assertThatThrownBy(() -> s.retireNationFederation(second, f.b))
+          .isInstanceOf(IllegalStateException.class);
+      assertThatThrownBy(() -> s.createAlliance("Charlie", f.c))
+          .hasMessageContaining("unavailable");
+      failRead.set(false);
+      var fresh = f.service();
+      assertThat(fresh.retireNationFederation(second, f.b).dissolvedAlliance()).isTrue();
+      assertThat(fresh.retireNationFederation(first, f.a)).isEqualTo(proof);
+    }
+  }
+
+  @Test
+  void midSnapshotSqlFailureRollsBackAllFamiliesAndHistory() throws Exception {
+    try (var f = new FederationTestFixture(root, true)) {
+      var s = f.service();
+      f.create(s, f.a, "Alpha");
+      var before = f.storage().loadSnapshot();
+      try (var c = f.sql.getConnection();
+          var st = c.createStatement()) {
+        st.execute(
+            "CREATE TRIGGER reject_retirement BEFORE INSERT ON starcore_federation_authority WHEN"
+                + " NEW.property_key LIKE 'retired.%' BEGIN SELECT RAISE(ABORT, 'forced failure');"
+                + " END");
+      }
+      var op = UUID.randomUUID();
+      assertThatThrownBy(() -> s.retireNationFederation(op, f.a))
+          .isInstanceOf(IllegalStateException.class);
+      assertThat(f.storage().loadSnapshot()).isEqualTo(before);
+      assertThat(s.getAllianceCount()).isEqualTo(1);
+      try (var c = f.sql.getConnection();
+          var st = c.createStatement()) {
+        st.execute("DROP TRIGGER reject_retirement");
+      }
+      assertThat(s.retireNationFederation(op, f.a).dissolvedAlliance()).isTrue();
+    }
+  }
+
+  static Object invoke(Object target, Method method, Object[] args) throws Throwable {
+    try {
+      return method.invoke(target, args);
+    } catch (InvocationTargetException e) {
+      throw e.getCause();
+    }
+  }
+}
