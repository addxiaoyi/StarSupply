+
+class FederationMigrationTest {
+  @TempDir Path root;
+
+  @ParameterizedTest
+  @ValueSource(ints = {0, 1, 2, 3, 4, 5})
+  void everyLegacyFamilyMustExistOnceMigrationHasData(int missing) throws Exception {
