+          "alliance_invites.properties",
+          "alliance_relations.properties",
+          "alliance_announcements.properties");
+
+  Properties properties(String... values) {
+    var p = new Properties();
+    for (int i = 0; i < values.length; i += 2) p.setProperty(values[i], values[i + 1]);
+    return p;
+  }
+
+  void write(FederationTestFixture f, String file, Properties p) throws Exception {
