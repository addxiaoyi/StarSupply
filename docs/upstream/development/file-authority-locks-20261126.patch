+class FederationAuthorityTest {
+  @TempDir Path root;
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void twoConcurrentStorageWritersCannotCommitDifferentRetirementOperations(boolean sql)
+      throws Exception {
+    try (var f = new FederationTestFixture(root, sql);
+        var executor = Executors.newFixedThreadPool(2)) {
+      var service = f.service();
+      f.create(service, f.a, "Alpha");
+      var one = f.storage();
+      var two = f.storage();
+      var left = one.loadSnapshot();
+      var right = two.loadSnapshot();
+      var first = UUID.randomUUID();
+      var second = UUID.randomUUID();
+      var barrier = new CyclicBarrier(2);
+      var a =
+          executor.submit(
+              () -> {
+                barrier.await(3, TimeUnit.SECONDS);
+                try {
+                  one.saveSnapshot(left, left.retire(first, f.a));
+                  return true;
+                } catch (IllegalStateException conflict) {
+                  return false;
+                }
+              });
+      var b =
+          executor.submit(
+              () -> {
+                barrier.await(3, TimeUnit.SECONDS);
+                try {
+                  two.saveSnapshot(right, right.retire(second, f.a));
+                  return true;
+                } catch (IllegalStateException conflict) {
+                  return false;
+                }
+              });
+      assertThat(a.get(10, TimeUnit.SECONDS) ^ b.get(10, TimeUnit.SECONDS)).isTrue();
+      var result = f.service().federationRetirementReceipt(f.a).orElseThrow();
+      assertThat(result.operationId()).isIn(first, second);
+      assertThat(f.service().getAllianceCount()).isZero();
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void allFamiliesAreDurableBeforeShutdownAndLastMemberRetirementIsPermanent(boolean sql) {
+    try (var f = new FederationTestFixture(root, sql)) {
+      var s = f.service();
+      var id = f.create(s, f.a, "Alpha|盟");
+      var other = f.create(s, f.b, "Bravo");
+      assertThat(s.inviteNation(f.a, id, f.c).success()).isTrue();
+      assertThat(s.setAllianceRelation(f.a, id, other, AllianceRelationType.FRIENDLY).success())
+          .isTrue();
+      assertThat(s.setAnnouncement(id, "notice|甲\nline two", f.a).success()).isTrue();
+      var before = f.storage().loadSnapshot();
+      assertThat(before.alliances()).hasSize(2);
+      assertThat(before.members()).hasSize(2);
+      assertThat(before.membership()).hasSize(2);
+      assertThat(before.invites()).hasSize(1);
+      assertThat(before.relations()).hasSize(1);
+      assertThat(before.announcements()).hasSize(1);
+      var op = UUID.randomUUID();
+      var receipt = s.retireNationFederation(op, f.a);
+      assertThat(receipt.formerAllianceId()).isEqualTo(id);
+      assertThat(receipt.dissolvedAlliance()).isTrue();
+      assertThat(receipt.clearedInvites()).isEqualTo(1);
+      assertThat(receipt.clearedAnnouncements()).isEqualTo(1);
+      var reloaded = f.service();
+      assertThat(reloaded.retireNationFederation(op, f.a)).isEqualTo(receipt);
+      assertThat(reloaded.getNationAlliance(f.b)).isPresent();
+      assertThat(reloaded.getAlliance(id)).isEmpty();
+      var after = f.storage().loadSnapshot();
+      assertThat(after.relations()).isEmpty();
+      assertThat(after.invites()).isEmpty();
+      assertThat(after.dissolved()).contains(id);
+      assertThat(after.membership()).containsOnlyKeys(f.b);
+      assertThatThrownBy(() -> reloaded.retireNationFederation(UUID.randomUUID(), f.a))
