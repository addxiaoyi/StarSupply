+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void committedAdmissionReplyLossKeepsDirectoryUntilOriginalReceiptRecovers(boolean sql)
+      throws Exception {
+    var f = fixture();
+    try (var first = f.new Session(sql, true)) {
+      var once = new AtomicBoolean(true);
+      doAnswer(
+              call -> {
+                var result = call.callRealMethod();
+                if (once.getAndSet(false)) throw new IllegalStateException("admission reply lost");
+                return result;
+              })
+          .when(first.wars)
+          .prepareDisband(any());
+      assertThatThrownBy(() -> first.nations.disbandNation(f.parent))
+          .hasMessage("admission reply lost");
+      var op = first.operation();
+      assertThat(op.state()).isEqualTo(NationDisbandOperation.State.ADMISSION_PENDING);
+      assertThat(first.nations.nationById(f.parent)).isPresent();
+      assertThat(first.nations.nationById(f.child)).isPresent();
+      assertThat(
+              first
+                  .nations
+                  .disbandOperation(op.transaction().transactionId())
+                  .orElseThrow()
+                  .state())
+          .isEqualTo(NationDisbandService.RecoveryState.ADMISSION_PENDING);
+      assertThat(first.receipts()).isEmpty();
+      var proof =
+          new WarStateStorage(first.plugin, first.database)
+              .disbandAdmission(op.transaction().transactionId())
+              .orElseThrow();
+      assertThat(proof.accepted()).isTrue();
+      try (var fresh = f.new Session(sql, false)) {
+        assertThatThrownBy(() -> fresh.warDelegate.declareWar(f.parent, f.parent, f.unrelated))
+            .hasMessageContaining("reserved");
+        assertThatThrownBy(
+                () ->
+                    fresh.reparations.createReparation(
+                        UUID.randomUUID(), f.child, f.unrelated, new BigDecimal("1000"), 1))
+            .isInstanceOf(IllegalStateException.class);
+        assertThat(fresh.treasury.balance(f.child)).isEqualByComparingTo("2000");
+        fresh.nations.recoverDisband(proof.request().operationId());
+        fresh.assertComplete(proof.request().operationId());
+        assertThat(fresh.wars.disbandAdmission(proof.request().operationId())).contains(proof);
+      }
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void independentWarCommittedBeforeAdmissionRejectsWithoutDeletingAnyNation(boolean sql)
+      throws Exception {
+    var f = fixture();
+    try (var first = f.new Session(sql, true)) {
+      var once = new AtomicBoolean(true);
+      AtomicReference<UUID> warId = new AtomicReference<>();
+      doAnswer(
+              call -> {
+                if (once.getAndSet(false)) {
+                  var selected = new WarStateStorage(first.plugin, first.database);
+                  var war = War.declare("late", f.child, f.unrelated, WarGoal.TERRITORIAL);
+                  selected.saveWar(war);
+                  warId.set(war.id());
+                }
+                return call.callRealMethod();
+              })
+          .when(first.wars)
+          .prepareDisband(any());
+      assertThatThrownBy(() -> first.nations.disbandNation(f.parent))
+          .hasMessageContaining("changed");
+      var original = first.operation().transaction();
+      try (var fresh = f.new Session(sql, false)) {
+        assertThat(fresh.nations.recoverDisband(original.transactionId()).state())
+            .isEqualTo(NationDisbandService.RecoveryState.REJECTED);
+        assertThat(fresh.operation().admission().decision()).isEqualTo(Decision.ACTIVE_WAR);
+        assertThat(fresh.nations.nationById(f.parent)).isPresent();
+        assertThat(fresh.nations.nationById(f.child)).isPresent();
+        assertThat(fresh.receipts()).isEmpty();
+        var selected = new WarStateStorage(first.plugin, first.database);
+        var war = selected.loadWar(warId.get());
+        war.end();
+        selected.saveWar(war);
+      }
+      try (var retry = f.new Session(sql, false)) {
+        var history = retry.operation();
+        assertThat(retry.nations.recoverDisband(original.transactionId()).state())
+            .isEqualTo(NationDisbandService.RecoveryState.REJECTED);
+        assertThat(retry.operation()).isEqualTo(history);
+        assertThat(retry.nations.pendingDisbands()).isEmpty();
+        assertThat(retry.nations.disbandNation(f.parent)).isTrue();
+        var all = NationStateCodec.snapshot(retry.directory.load()).disbands();
+        assertThat(all).hasSize(2);
+        assertThat(all.get(original.transactionId())).isEqualTo(history);
+        assertThat(all.values())
+            .extracting(NationDisbandOperation::state)
+            .containsExactlyInAnyOrder(
+                NationDisbandOperation.State.REJECTED, NationDisbandOperation.State.COMPLETED);
+      }
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void independentReparationCommittedAfterDirectoryIntentRejectsTheOriginalDisband(boolean sql)
+      throws Exception {
+    var f = fixture();
+    try (var first = f.new Session(sql, true)) {
+      var once = new AtomicBoolean(true);
+      AtomicReference<UUID> debt = new AtomicReference<>();
+      doAnswer(
+              call -> {
+                if (once.getAndSet(false)) {
+                  try (var other = f.new Session(sql, false)) {
+                    assertThat(other.operation().state())
+                        .isEqualTo(NationDisbandOperation.State.ADMISSION_PENDING);
+                    debt.set(
+                        other
+                            .reparations
+                            .createReparation(
+                                UUID.randomUUID(), f.child, f.unrelated, new BigDecimal("1000"), 1)
+                            .id());
+                  }
+                }
+                return call.callRealMethod();
+              })
+          .when(first.wars)
+          .prepareDisband(any());
+      assertThat(first.nations.disbandNation(f.parent)).isFalse();
+      var rejected = first.operation();
+      assertThat(rejected.admission().decision()).isEqualTo(Decision.ACTIVE_REPARATION);
+      assertThat(first.receipts()).isEmpty();
+      try (var fresh = f.new Session(sql, false)) {
+        assertThat(fresh.reparations.getReparation(debt.get())).isPresent();
+        assertThat(fresh.nations.nationById(f.child)).isPresent();
+        assertThat(fresh.nations.recoverDisband(rejected.transaction().transactionId()).state())
+            .isEqualTo(NationDisbandService.RecoveryState.REJECTED);
+        assertThat(fresh.treasury.balance(f.child)).isEqualByComparingTo("2000");
+      }
+    }
+  }
