+  @Test
+  void committedAdmissionResponseLossConfirmsOrFreezesUntilDurableReadback() throws Exception {
+    var f = fixture();
+    var setup = f.fixture(true);
+    var source = setup.database().dataSource().orElseThrow();
+    var armed = new AtomicBoolean();
+    var loseRead = new AtomicBoolean();
+    var offline = new AtomicBoolean();
+    DataSource proxy =
+        (DataSource)
+            java.lang.reflect.Proxy.newProxyInstance(
+                getClass().getClassLoader(),
+                new Class<?>[] {DataSource.class},
+                (p, m, args) -> {
+                  if (!m.getName().equals("getConnection")) return invoke(source, m, args);
+                  if (offline.get()) throw new SQLException("admission readback offline");
+                  var actual = (Connection) invoke(source, m, args);
+                  return java.lang.reflect.Proxy.newProxyInstance(
+                      getClass().getClassLoader(),
+                      new Class<?>[] {Connection.class},
+                      (cp, cm, ca) -> {
+                        var value = invoke(actual, cm, ca);
+                        if (cm.getName().equals("commit") && armed.compareAndSet(true, false)) {
+                          if (loseRead.get()) offline.set(true);
+                          throw new SQLException("admission committed but response lost");
+                        }
+                        return value;
+                      });
+                });
+    when(setup.database().dataSource()).thenReturn(Optional.of(proxy));
+    var store = setup.storage();
+    store.loadAllWars();
+    var first = request(f.a);
+    armed.set(true);
+    assertThat(store.prepareDisband(first).accepted()).isTrue();
+    var second = request(f.b);
+    armed.set(true);
+    loseRead.set(true);
+    assertThatThrownBy(() -> store.prepareDisband(second))
+        .isInstanceOf(IllegalStateException.class);
+    assertThatThrownBy(() -> store.saveWar(War.declare("uncertain", f.c, f.d, WarGoal.TERRITORIAL)))
+        .hasMessageContaining("unavailable");
+    offline.set(false);
+    assertThat(store.prepareDisband(second).accepted()).isTrue();
+    assertThat(setup.storage().disbandAdmission(first.operationId()))
+        .contains(new Receipt(first, Decision.ACCEPTED));
+    assertThatThrownBy(() -> store.saveWar(War.declare("late", f.b, f.c, WarGoal.TERRITORIAL)))
+        .hasMessageContaining("admission");
+  }
