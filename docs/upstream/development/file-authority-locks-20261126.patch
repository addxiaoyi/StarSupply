+package dev.starcore.starcore.module.war.reparations;
+
+import static org.assertj.core.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+import dev.starcore.starcore.core.database.DatabaseService;
+import dev.starcore.starcore.core.persistence.PersistenceService;
+import dev.starcore.starcore.core.scheduler.StarCoreScheduler;
+import dev.starcore.starcore.module.nation.model.NationId;
+import dev.starcore.starcore.module.treasury.*;
+import dev.starcore.starcore.war.*;
+import java.math.BigDecimal;
+import java.nio.file.*;
+import java.sql.DriverManager;
+import java.time.Instant;
+import java.util.*;
+import java.util.concurrent.atomic.*;
+import java.util.logging.Logger;
+import javax.sql.DataSource;
+import org.bukkit.plugin.java.JavaPlugin;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+
+class ReparationsAuthorityIntegrationTest {
+  @TempDir Path root;
+  final NationId payer = NationId.random(), receiver = NationId.random();
+
+  final class Fixture implements AutoCloseable {
+    final JavaPlugin plugin = mock(JavaPlugin.class);
+    final DatabaseService database = mock(DatabaseService.class);
+    final PersistenceService persistence;
+    final TreasuryModule treasury;
+
+    Fixture(boolean sql) throws Exception {
+      when(plugin.getDataFolder()).thenReturn(root.toFile());
+      when(plugin.getLogger()).thenReturn(Logger.getAnonymousLogger());
+      var server = mock(org.bukkit.Server.class);
+      var scheduler = mock(org.bukkit.scheduler.BukkitScheduler.class);
+      when(plugin.getServer()).thenReturn(server);
+      when(server.getScheduler()).thenReturn(scheduler);
+      when(scheduler.runTaskTimer(eq(plugin), any(Runnable.class), anyLong(), anyLong()))
+          .thenReturn(mock(org.bukkit.scheduler.BukkitTask.class));
+      when(database.isRunning()).thenReturn(sql);
+      if (sql) {
+        var source = mock(DataSource.class);
+        when(source.getConnection())
+            .thenAnswer(
+                call -> DriverManager.getConnection("jdbc:sqlite:" + root.resolve("war.db")));
+        when(database.dataSource()).thenReturn(Optional.of(source));
+      }
+      persistence = new PersistenceService(plugin, mock(StarCoreScheduler.class));
+      persistence.start();
+      treasury = spy(NavyTreasuryFixture.open(persistence, new AtomicInteger()));
+      treasury.deposit(payer, new BigDecimal("2000"));
+    }
+
+    WarStateStorage storage() {
+      return new WarStateStorage(plugin, database);
+    }
+
+    ReparationsModule module(WarStateStorage storage) throws Exception {
+      var module = new ReparationsModule();
+      set(module, "plugin", plugin);
+      set(module, "storage", storage);
+      set(module, "config", ReparationsModule.ReparationsConfig.defaults());
+      set(module, "treasuryService", treasury);
+      set(module, "transferService", treasury);
+      set(module, "stopped", false);
+      module.recoverSettlements();
+      return module;
+    }
+
+    WarReparation create(ReparationsModule module) {
+      return module.createReparation(UUID.randomUUID(), payer, receiver, new BigDecimal("1000"), 2);
+    }
+
+    void balances(String debit, String credit) {
+      var durable = NavyTreasuryFixture.open(persistence, new AtomicInteger());
+      assertThat(durable.balance(payer)).isEqualByComparingTo(debit);
+      assertThat(durable.balance(receiver)).isEqualByComparingTo(credit);
+    }
+
+    public void close() {
+      persistence.stop();
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void replyLossBlocksRetirementAndRestartFinishesTheOriginalPaymentOnce(boolean sql)
+      throws Exception {
+    try (var f = new Fixture(sql)) {
+      var module = f.module(f.storage());
+      var debt = f.create(module);
+      var lost = new AtomicBoolean(true);
+      var requests = new ArrayList<NationTransferService.TransferRequest>();
+      doAnswer(
+              call -> {
+                requests.add(call.getArgument(0));
+                Object result = call.callRealMethod();
+                if (lost.getAndSet(false)) throw new IllegalStateException("committed reply lost");
+                return result;
+              })
+          .when(f.treasury)
+          .transfer(any());
+      assertThat(module.payReparation(debt.id(), new BigDecimal("25"))).isFalse();
+      f.balances("1975", "25");
+      assertThatThrownBy(() -> f.storage().retireNationWars(UUID.randomUUID(), receiver))
+          .hasMessageContaining("Pending reparation");
+      assertThat(module.settleInsuredReparationRefund("reparation:" + debt.id())).isFalse();
+      assertThat(module.forgiveReparation(debt.id())).isFalse();
+      module.disable(null);
+      var restarted = f.module(f.storage());
+      assertThat(restarted.pendingSettlementRecovery()).isEmpty();
+      assertThat(restarted.getReparation(debt.id()).orElseThrow().paidAmount())
+          .isEqualByComparingTo("25");
+      assertThat(requests).hasSize(2);
+      assertThat(requests.get(0)).isEqualTo(requests.get(1));
+      var op = UUID.randomUUID();
+      f.storage().retireNationWars(op, receiver);
+      assertThat(f.storage().warRetirementReceipt(receiver).orElseThrow().operationId())
+          .isEqualTo(op);
+      assertThat(restarted.payReparation(debt.id(), new BigDecimal("25"))).isFalse();
+      assertThat(restarted.forgiveReparation(debt.id())).isFalse();
+      assertThat(restarted.hasActiveReparation(receiver)).isFalse();
+      assertThat(module.payReparation(debt.id(), BigDecimal.ONE)).isFalse();
+      assertThatThrownBy(
+              () ->
+                  restarted.createTreatyReparation(
+                      debt.id(), debt.treatyId(), payer, receiver, debt.totalAmount(), 2))
+          .hasMessageContaining("RETIRED");
+      assertThatThrownBy(() -> f.create(restarted)).hasMessageContaining("persist");
+      f.balances("1975", "25");
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void eachPersistenceBoundaryKeepsItsPaymentEvidence(boolean sql) throws Exception {
+    try (var f = new Fixture(sql)) {
+      var mode = new AtomicInteger();
+      var storage =
+          new WarStateStorage(f.plugin, f.database) {
+            @Override
+            public synchronized void saveReparations(Properties expected, Properties updated) {
+              var snapshot = ReparationsSnapshotCodec.fromProperties(updated);
+              if (snapshot.settlements().values().stream()
+                  .anyMatch(
+                      s ->
+                          mode.get() == 1 && s.state() == ReparationSettlementState.PREPARED
+                              || mode.get() == 2
+                                  && s.state() == ReparationSettlementState.TRANSFERRED
+                              || mode.get() == 3
+                                  && s.state() == ReparationSettlementState.COMPLETED))
+                throw new IllegalStateException("injected settlement write");
+              super.saveReparations(expected, updated);
+            }
+          };
+      var module = f.module(storage);
+      var debt = f.create(module);
+      mode.set(1);
+      assertThat(module.payReparation(debt.id(), new BigDecimal("25"))).isFalse();
