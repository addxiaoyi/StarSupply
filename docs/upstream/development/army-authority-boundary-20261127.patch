+  void damagedLegacyIsRejectedWithoutPublishingAnAuthority(String corruption) throws Exception {
+    try (var f = new FederationTestFixture(root, false)) {
+      var id = seed(f);
+      var folder = f.persistence.namespacePath("alliance");
+      switch (corruption) {
+        case "missingMembers" -> Files.delete(folder.resolve(FAMILIES.get(1)));
