+          if (!operation.planHash().equals(localPlanHash))
+            throw new IllegalArgumentException("Treaty plan identity mismatch");
+          if (operation.binding() != null) {
+            if (!operation.binding().equals(binding))
+              throw new IllegalArgumentException("Treaty manifest binding is immutable");
+            return operation;
+          }
+          if (operation.request().protocolVersion() != TreatyEffectManifest.VERSION)
+            throw new IllegalArgumentException("Legacy treaty cannot bind a v2 manifest");
+          if (operation.terminal())
+            throw new IllegalArgumentException("Cannot bind a terminal treaty operation");
+          if (binding.protocolVersion() != TreatyEffectManifest.VERSION
+              || binding.manifest() == null)
+            throw new IllegalArgumentException("Treaty binding requires an explicit v2 manifest");
+          TreatyEffectManifest.requireSupported(binding.manifest());
+          var bound =
+              new OperationView(
+                  operation.request(),
+                  operation.plan(),
+                  operation.status(),
+                  operation.terminalAt(),
+                  binding,
+                  null);
+          requireTreatyEffectProofPersistence(activeLifecycle);
+          return storeTreaty(bound, activeLifecycle);
