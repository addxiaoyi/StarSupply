+package dev.starcore.starcore.core.persistence;
+
+import java.io.IOException;
+import java.nio.channels.FileChannel;
+import java.nio.channels.FileLock;
+import java.nio.channels.OverlappingFileLockException;
+import java.nio.file.*;
+import java.util.*;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.locks.ReentrantLock;
+
+/** Stable sidecar locks cover comparison, replacement and readback across cooperating processes. */
+public final class FileAuthorityLock implements AutoCloseable {
+  private static final long TIMEOUT_NANOS = TimeUnit.SECONDS.toNanos(5);
+  private static final ReentrantLock[] LOCAL = new ReentrantLock[64];
+  private static final ThreadLocal<Map<Path, Held>> HELD = ThreadLocal.withInitial(HashMap::new);
+
+  static {
+    Arrays.setAll(LOCAL, ignored -> new ReentrantLock());
+  }
+
+  private static final class Held {
+    final FileChannel channel;
+    final FileLock lock;
+    int users = 1;
+
+    Held(FileChannel channel, FileLock lock) {
+      this.channel = channel;
+      this.lock = lock;
+    }
+  }
+
+  private final Path key;
+  private final ReentrantLock local;
+  private final Held held;
+  private final Thread owner = Thread.currentThread();
+  private boolean closed;
+
+  private FileAuthorityLock(Path key, ReentrantLock local, Held held) {
+    this.key = key;
+    this.local = local;
+    this.held = held;
+  }
+
+  /** Reentrant on the owning thread. Busy, interrupted or unsupported locks fail closed. */
+  public static FileAuthorityLock acquire(Path target) throws IOException {
+    Objects.requireNonNull(target, "target");
+    Path absolute = target.toAbsolutePath().normalize();
+    if (absolute.getParent() == null || Files.isSymbolicLink(absolute))
+      throw new IOException("Authority target must be a regular file path");
+    Files.createDirectories(absolute.getParent());
+    Path key = absolute.getParent().toRealPath().resolve(absolute.getFileName());
+    Path sidecar = key.resolveSibling(key.getFileName() + ".lock");
+    if (Files.isSymbolicLink(sidecar))
+      throw new IOException("Authority lock cannot be a symbolic link");
+    ReentrantLock local = LOCAL[Math.floorMod(key.hashCode(), LOCAL.length)];
+    long deadline = System.nanoTime() + TIMEOUT_NANOS;
+    boolean acquired = false;
+    boolean transferred = false;
+    FileChannel channel = null;
+    try {
+      acquired = local.tryLock(TIMEOUT_NANOS, TimeUnit.NANOSECONDS);
+      if (!acquired) throw new IOException("File authority busy; retry after reload: " + key);
+      Held previous = HELD.get().get(key);
+      if (previous != null) {
+        previous.users++;
+        transferred = true;
+        return new FileAuthorityLock(key, local, previous);
+      }
+      channel = FileChannel.open(sidecar, StandardOpenOption.CREATE, StandardOpenOption.WRITE);
+      while (true) {
+        FileLock lock;
+        try {
+          lock = channel.tryLock();
+        } catch (OverlappingFileLockException overlap) {
+          throw new IOException("Authority lock held by another class loader", overlap);
+        }
+        if (lock != null) {
+          var held = new Held(channel, lock);
+          HELD.get().put(key, held);
+          transferred = true;
+          return new FileAuthorityLock(key, local, held);
+        }
+        long remaining = deadline - System.nanoTime();
+        if (remaining <= 0)
+          throw new IOException("File authority busy; retry after reload: " + key);
+        TimeUnit.NANOSECONDS.sleep(Math.min(remaining, TimeUnit.MILLISECONDS.toNanos(10)));
+      }
+    } catch (InterruptedException interrupted) {
+      Thread.currentThread().interrupt();
+      throw new IOException("Interrupted while locking file authority", interrupted);
+    } catch (UnsupportedOperationException unsupported) {
+      throw new IOException("Filesystem does not support authority locks", unsupported);
+    } finally {
+      if (!transferred) {
+        try {
+          if (channel != null) channel.close();
+        } finally {
+          if (acquired) local.unlock();
+          if (HELD.get().isEmpty()) HELD.remove();
+        }
+      }
+    }
+  }
+
+  /** The sidecar is deliberately retained: deleting it could create two separately locked files. */
+  @Override
+  public void close() throws IOException {
+    if (Thread.currentThread() != owner)
+      throw new IllegalStateException("Authority lock owner mismatch");
+    if (closed) return;
+    closed = true;
+    try {
+      if (--held.users == 0) {
+        HELD.get().remove(key);
+        try {
+          held.lock.release();
+        } finally {
+          held.channel.close();
+        }
+      }
+    } finally {
+      local.unlock();
+      if (HELD.get().isEmpty()) HELD.remove();
+    }
+  }
+}
