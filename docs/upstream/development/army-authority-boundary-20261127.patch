+  private WarSettlementAdmissionService.Request sourceRequest(OperationView operation) {
+    var request = operation.request();
+    return new WarSettlementAdmissionService.Request(
+        request.operationId(),
+        request.treatyId(),
+        request.war(),
+        request.warGeneration(),
