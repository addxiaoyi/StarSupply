+    assertNull(decoded.armies().get(ARMY_ID).position().worldId());
+    assertEquals("missing-world", decoded.armies().get(ARMY_ID).position().worldName());
+    assertEquals(37.5f, decoded.armies().get(ARMY_ID).position().yaw());
+    assertEquals(-16.25f, decoded.armies().get(ARMY_ID).position().pitch());
+    assertEquals(original.generations(), decoded.generations());
+    assertEquals(original.incarnations(), decoded.incarnations());
+    assertEquals(encoded, ArmyAuthorityCodec.encode(decoded));
+  }
+
+  @Test
+  void preservesLegacyCompatibleRemainderAndClockOrderingWithoutInventingConstraints() {
+    ArmySnapshot unit = army(1, 1, 100, 0, 0, 59, Instant.EPOCH);
+    ArmyAuthoritySnapshot original = image(1, Map.of(ARMY_ID, unit), Map.of(), Map.of());
+    assertEquals(original, ArmyAuthorityCodec.decode(ArmyAuthorityCodec.encode(original)));
+    assertTrue(unit.lastUpdated().isBefore(unit.createdAt()));
+    assertEquals(100, unit.health());
+  }
+
+  @Test
+  void rejectsInvalidPercentagesAndSupplyRatherThanClamping() {
+    for (double invalid : new double[] {-1, 100.01, Double.NaN, Double.POSITIVE_INFINITY}) {
+      assertThrows(IllegalArgumentException.class, () -> army(1, 1, invalid, 50, 50, 0, UPDATED));
+      assertThrows(IllegalArgumentException.class, () -> army(1, 1, 50, invalid, 50, 0, UPDATED));
+    }
+    assertThrows(IllegalArgumentException.class, () -> army(1, -1, 50, 50, 50, 0, UPDATED));
+    assertThrows(IllegalArgumentException.class, () -> army(1, 1, 50, 50, 101, 0, UPDATED));
+    assertThrows(IllegalArgumentException.class, () -> army(1, 1, 50, 50, 50, 60, UPDATED));
+    assertThrows(IllegalArgumentException.class, () -> new ArmyToken(ARMY_ID, INCARNATION, 0));
+    assertThrows(
+        IllegalArgumentException.class,
+        () -> new ArmyPosition(null, "world", Double.NaN, 0, 0, 0, 0));
+    assertThrows(
+        IllegalArgumentException.class,
+        () -> new ArmyPosition(null, "world", 0, 0, 0, Float.POSITIVE_INFINITY, 0));
+  }
+
+  @Test
+  void snapshotsAndMigrationEvidenceDefensivelyCopyTheirInputs() {
+    Map<java.util.UUID, ArmySnapshot> units = new HashMap<>();
+    units.put(ARMY_ID, army(1));
+    ArmyAuthoritySnapshot snapshot = image(1, units, Map.of(), Map.of());
+    units.clear();
+    assertEquals(1, snapshot.armies().size());
+    assertThrows(UnsupportedOperationException.class, () -> snapshot.armies().clear());
+    assertThrows(UnsupportedOperationException.class, () -> snapshot.generations().clear());
+    Map<String, String> raw = new HashMap<>();
+    raw.put("original", "line\r\nvalue|quotes\"世界");
+    ArmyMigrationEvidence evidence = new ArmyMigrationEvidence(EMPTY_SHA256, raw, Map.of());
+    raw.clear();
+    assertEquals("line\r\nvalue|quotes\"世界", evidence.rawRecords().get("original"));
+    assertThrows(UnsupportedOperationException.class, () -> evidence.rawRecords().clear());
+  }
+
+  @Test
+  void preservesExactSourceBytesAndRejectsMismatchedEvidenceHash() throws Exception {
+    byte[] source = "# comment\r\nlegacy=value\r\n".getBytes(StandardCharsets.UTF_8);
+    String hash = HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256").digest(source));
+    ArmyMigrationEvidence evidence =
+        new ArmyMigrationEvidence(
+            hash,
+            Map.of("legacy", "value"),
+            Map.of(
+                ArmyMigrationEvidence.SOURCE_PAYLOAD_BASE64,
+                Base64.getEncoder().encodeToString(source),
+                ArmyMigrationEvidence.SOURCE_DESCRIPTOR,
+                "armies.dat"));
+    ArmyAuthoritySnapshot original =
+        new ArmyAuthoritySnapshot(true, 1, Map.of(), Map.of(), Map.of(), evidence);
+    ArmyMigrationEvidence decoded =
+        ArmyAuthorityCodec.decode(ArmyAuthorityCodec.encode(original)).migration();
+    assertArrayEquals(source, decoded.sourceBytes());
+    byte[] detached = decoded.sourceBytes();
+    detached[0] = 0;
+    assertArrayEquals(source, decoded.sourceBytes());
+    assertThrows(
+        IllegalArgumentException.class,
+        () -> new ArmyMigrationEvidence(EMPTY_SHA256, Map.of(), evidence.inferences()));
+  }
+
+  @Test
+  void rejectsUnknownPropertiesWrongKeysAndIncompleteTokenLedgers() {
+    Properties unknown = ArmyAuthorityCodec.encode(live(1, 1));
+    unknown.setProperty("unexpected", "value");
+    assertThrows(IllegalArgumentException.class, () -> ArmyAuthorityCodec.decode(unknown));
+    Properties wrongKey = ArmyAuthorityCodec.encode(live(1, 1));
+    String row = (String) wrongKey.remove("army." + ARMY_ID);
+    wrongKey.setProperty("army." + OTHER_ID, row);
+    assertThrows(IllegalArgumentException.class, () -> ArmyAuthorityCodec.decode(wrongKey));
+    Properties missingLedger = ArmyAuthorityCodec.encode(live(1, 1));
+    missingLedger.remove("armyGeneration." + ARMY_ID);
+    assertThrows(IllegalArgumentException.class, () -> ArmyAuthorityCodec.decode(missingLedger));
+    Properties wrongLedger = ArmyAuthorityCodec.encode(live(1, 1));
+    wrongLedger.setProperty("armyIncarnation." + ARMY_ID, OTHER_ID.toString());
+    assertThrows(IllegalArgumentException.class, () -> ArmyAuthorityCodec.decode(wrongLedger));
+  }
+
+  @Test
+  void rejectsNoncanonicalNumbersAndPartialSharedEnvelope() {
+    for (String invalid : new String[] {"0", "01", "+1", "1.0", "9223372036854775808"}) {
+      Properties properties = ArmyAuthorityCodec.encode(live(1, 1));
+      properties.setProperty(ArmyAuthorityCodec.REVISION, invalid);
+      assertThrows(IllegalArgumentException.class, () -> ArmyAuthorityCodec.decode(properties));
+    }
+    Properties partial = ArmyAuthorityCodec.encode(live(1, 1));
+    partial.setProperty("authority.version", "1");
+    assertThrows(IllegalArgumentException.class, () -> ArmyAuthorityCodec.decode(partial));
+    partial.setProperty("authority.sha256", EMPTY_SHA256);
+    assertThrows(IllegalArgumentException.class, () -> ArmyAuthorityCodec.decode(partial));
+  }
+
+  @Test
+  void rejectsTrailingTruncatedAndWrongKindBinaryRows() {
+    Properties trailing = ArmyAuthorityCodec.encode(live(1, 1));
+    byte[] bytes = Base64.getDecoder().decode(trailing.getProperty("army." + ARMY_ID));
+    trailing.setProperty(
+        "army." + ARMY_ID,
+        Base64.getEncoder().encodeToString(Arrays.copyOf(bytes, bytes.length + 1)));
+    assertThrows(IllegalArgumentException.class, () -> ArmyAuthorityCodec.decode(trailing));
+    Properties truncated = ArmyAuthorityCodec.encode(live(1, 1));
+    truncated.setProperty(
+        "army." + ARMY_ID,
+        Base64.getEncoder().encodeToString(Arrays.copyOf(bytes, bytes.length - 1)));
+    assertThrows(IllegalArgumentException.class, () -> ArmyAuthorityCodec.decode(truncated));
+    Properties wrongKind = ArmyAuthorityCodec.encode(live(1, 1));
+    wrongKind.setProperty(ArmyAuthorityCodec.MIGRATION, wrongKind.getProperty("army." + ARMY_ID));
+    assertThrows(IllegalArgumentException.class, () -> ArmyAuthorityCodec.decode(wrongKind));
+  }
+
+  @Test
+  void rejectsUnknownAndNoncanonicalEnumKeysAndInvalidNanoseconds() {
+    Properties unknownType = ArmyAuthorityCodec.encode(live(1, 1));
+    replaceArmyAscii(unknownType, "infantry", "unknown!");
+    assertThrows(IllegalArgumentException.class, () -> ArmyAuthorityCodec.decode(unknownType));
+    Properties aliasState = ArmyAuthorityCodec.encode(live(1, 1));
+    replaceArmyAscii(aliasState, "marching", "MARCHING");
+    assertThrows(IllegalArgumentException.class, () -> ArmyAuthorityCodec.decode(aliasState));
+    Properties invalidNanos = ArmyAuthorityCodec.encode(live(1, 1));
+    byte[] bytes = Base64.getDecoder().decode(invalidNanos.getProperty("army." + ARMY_ID));
+    ByteBuffer.wrap(bytes).putInt(bytes.length - Integer.BYTES, 1_000_000_000);
+    invalidNanos.setProperty("army." + ARMY_ID, Base64.getEncoder().encodeToString(bytes));
+    assertThrows(IllegalArgumentException.class, () -> ArmyAuthorityCodec.decode(invalidNanos));
+  }
+
+  @Test
+  void twoPassEncoderEnforcesSmallExactRowBudgetsWithoutLargeAllocations() {
+    ArmyAuthoritySnapshot original = live(1, 1);
+    Properties encoded = ArmyAuthorityCodec.encode(original);
+    int armyBytes = Base64.getDecoder().decode(encoded.getProperty("army." + ARMY_ID)).length;
+    int migrationBytes =
+        Base64.getDecoder().decode(encoded.getProperty(ArmyAuthorityCodec.MIGRATION)).length;
+    int exactBudget = Math.max(armyBytes, migrationBytes);
+    assertEquals(encoded, ArmyAuthorityCodec.encodeWithRowBudget(original, exactBudget));
+    assertThrows(
+        IllegalArgumentException.class,
+        () -> ArmyAuthorityCodec.encodeWithRowBudget(original, exactBudget - 1));
+    assertThrows(
+        IllegalArgumentException.class, () -> ArmyAuthorityCodec.encodeWithRowBudget(original, 0));
+    ArmyMigrationEvidence larger =
+        new ArmyMigrationEvidence(EMPTY_SHA256, Map.of("small", "x".repeat(256)), Map.of());
+    ArmyAuthoritySnapshot bounded =
+        new ArmyAuthoritySnapshot(true, 1, Map.of(), Map.of(), Map.of(), larger);
+    assertThrows(
+        IllegalArgumentException.class, () -> ArmyAuthorityCodec.encodeWithRowBudget(bounded, 64));
+  }
+
+  @Test
+  void strictUtf8CounterHandlesSupplementaryCharactersAndRejectsUnpairedSurrogates() {
+    String unicode = "Aé世🚀";
+    assertEquals(10, ArmyAuthorityCodec.utf8Length(unicode, 10));
+    assertThrows(IllegalArgumentException.class, () -> ArmyAuthorityCodec.utf8Length(unicode, 9));
+    assertThrows(IllegalArgumentException.class, () -> ArmyAuthorityCodec.utf8Length("\ud800", 8));
+    assertThrows(IllegalArgumentException.class, () -> ArmyAuthorityCodec.utf8Length("\udc00", 8));
+    ArmyMigrationEvidence evidence =
+        new ArmyMigrationEvidence(EMPTY_SHA256, Map.of(unicode, unicode), Map.of());
+    ArmyAuthoritySnapshot original =
+        new ArmyAuthoritySnapshot(true, 1, Map.of(), Map.of(), Map.of(), evidence);
+    assertEquals(original, ArmyAuthorityCodec.decode(ArmyAuthorityCodec.encode(original)));
+  }
+
+  private static void replaceArmyAscii(Properties properties, String original, String replacement) {
+    byte[] bytes = Base64.getDecoder().decode(properties.getProperty("army." + ARMY_ID));
+    byte[] wanted = original.getBytes(StandardCharsets.UTF_8);
+    byte[] updated = replacement.getBytes(StandardCharsets.UTF_8);
+    assertEquals(wanted.length, updated.length);
+    for (int offset = 0; offset <= bytes.length - wanted.length; offset++) {
+      if (Arrays.equals(bytes, offset, offset + wanted.length, wanted, 0, wanted.length)) {
+        System.arraycopy(updated, 0, bytes, offset, updated.length);
+        properties.setProperty("army." + ARMY_ID, Base64.getEncoder().encodeToString(bytes));
+        return;
+      }
+    }
+    fail("Expected encoded Army field was absent");
+  }
+}
