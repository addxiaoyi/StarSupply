+package dev.starcore.starcore.module.army.model.authority;
+
+import java.util.HashMap;
+import java.util.Map;
+import java.util.Objects;
+import java.util.UUID;
+
+public record ArmyAuthoritySnapshot(
+    boolean initialized,
+    long revision,
+    Map<UUID, ArmySnapshot> armies,
+    Map<UUID, ArmyTombstone> tombstones,
+    Map<UUID, ArmyLogisticsReceipt> receipts,
+    ArmyMigrationEvidence migration) {
+  public ArmyAuthoritySnapshot {
+    if (revision < 0) throw new IllegalArgumentException("Authority revision must not be negative");
+    armies = Map.copyOf(Objects.requireNonNull(armies, "armies"));
+    tombstones = Map.copyOf(Objects.requireNonNull(tombstones, "tombstones"));
+    receipts = Map.copyOf(Objects.requireNonNull(receipts, "receipts"));
+    if (initialized) {
+      Objects.requireNonNull(migration, "migration");
+    } else if (revision != 0
+        || !armies.isEmpty()
+        || !tombstones.isEmpty()
+        || !receipts.isEmpty()
+        || migration != null) {
+      throw new IllegalArgumentException("Uninitialized authority must be the empty sentinel");
+    }
+  }
+
+  public static ArmyAuthoritySnapshot uninitialized() {
+    return new ArmyAuthoritySnapshot(false, 0, Map.of(), Map.of(), Map.of(), null);
+  }
+
+  public ArmyAuthoritySnapshot withRevision(long replacement) {
+    return new ArmyAuthoritySnapshot(
+        initialized, replacement, armies, tombstones, receipts, migration);
+  }
+
+  public Map<UUID, Long> generations() {
+    Map<UUID, Long> result = new HashMap<>();
+    armies.forEach((armyId, army) -> result.put(armyId, army.token().generation()));
+    tombstones.forEach((armyId, tombstone) -> result.put(armyId, tombstone.token().generation()));
+    return Map.copyOf(result);
+  }
+
+  public Map<UUID, UUID> incarnations() {
+    Map<UUID, UUID> result = new HashMap<>();
+    armies.forEach((armyId, army) -> result.put(armyId, army.token().incarnation()));
+    tombstones.forEach((armyId, tombstone) -> result.put(armyId, tombstone.token().incarnation()));
+    return Map.copyOf(result);
+  }
+}
