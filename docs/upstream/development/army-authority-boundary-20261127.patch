+package dev.starcore.starcore.module.war;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+import static org.mockito.Mockito.*;
+
+import dev.starcore.starcore.module.diplomacy.WarDiplomacyMirrorService;
+import dev.starcore.starcore.module.nation.model.NationId;
+import dev.starcore.starcore.war.WarServiceImpl;
+import java.lang.reflect.InvocationTargetException;
+import java.time.Instant;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+import java.util.concurrent.atomic.AtomicLong;
+import org.junit.jupiter.api.Test;
+
+class WarModuleMirrorLifecycleTest {
+  void set(WarModule module, String name, Object value) throws Exception {
+    var field = WarModule.class.getDeclaredField(name);
+    field.setAccessible(true);
+    field.set(module, value);
+  }
+
+  Object get(WarModule module, String name) throws Exception {
+    var field = WarModule.class.getDeclaredField(name);
+    field.setAccessible(true);
+    return field.get(module);
+  }
+
+  @SuppressWarnings("unchecked")
+  Map<WarPairKey, Instant> projection(WarModule module) throws Exception {
+    return (Map<WarPairKey, Instant>) get(module, "activeWars");
+  }
+
+  void reconcile(WarModule module) throws Exception {
+    var method = WarModule.class.getDeclaredMethod("reconcileDiplomacyMirror");
+    method.setAccessible(true);
+    method.invoke(module);
+  }
+
+  WarDiplomacyMirrorService.SourceSnapshot snapshot() {
+    return new WarDiplomacyMirrorService.SourceSnapshot(
+        4,
+        List.of(
+            new WarDiplomacyMirrorService.WarEntry(
+                UUID.randomUUID(),
+                NationId.random(),
+                NationId.random(),
+                Instant.parse("2026-11-27T09:30:00Z"),
+                true)));
+  }
+
+  @Test
+  void stoppedReceiverCallbackCannotOverwriteOrSaveTheReplacementLifecycleProjection()
+      throws Exception {
+    var module = new WarModule();
+    var source = mock(WarServiceImpl.class);
+    var receiver = mock(WarDiplomacyMirrorService.class);
+    var originalStorage = mock(WarStateStorage.class);
+    var replacementStorage = mock(WarStateStorage.class);
+    var replacementSource = mock(WarServiceImpl.class);
+    var snapshot = snapshot();
+    var replacementPair = WarPairKey.of(NationId.random(), NationId.random());
+    var replacementDeclared = Instant.parse("2026-11-27T10:00:00Z");
+    set(module, "enabled", true);
+    set(module, "stateRecovered", true);
+    set(module, "warServiceImpl", source);
+    set(module, "diplomacyMirrorService", receiver);
+    set(module, "moduleStateStorage", originalStorage);
+    when(source.mirrorSnapshot()).thenReturn(snapshot);
+    when(receiver.reconcile(snapshot))
+        .thenAnswer(
+            call -> {
+              assertThat(Thread.holdsLock(module)).isFalse();
+              module.disable(null);
+              ((AtomicLong) get(module, "lifecycle")).incrementAndGet();
+              set(module, "enabled", true);
+              set(module, "stateRecovered", true);
+              set(module, "warServiceImpl", replacementSource);
+              set(module, "moduleStateStorage", replacementStorage);
+              projection(module).clear();
+              projection(module).put(replacementPair, replacementDeclared);
+              clearInvocations(originalStorage);
+              return null;
+            });
+
+    assertThatThrownBy(() -> reconcile(module))
+        .isInstanceOf(InvocationTargetException.class)
+        .cause()
+        .isInstanceOf(IllegalStateException.class)
+        .hasMessageContaining("lifecycle changed");
+    assertThat(projection(module))
+        .containsExactlyEntriesOf(Map.of(replacementPair, replacementDeclared));
+    verify(source).shutdown();
+    verifyNoInteractions(originalStorage, replacementStorage, replacementSource);
+  }
+
+  @Test
+  void initialStartupCanReconcileBeforeTheModuleIsEnabled() throws Exception {
+    var module = new WarModule();
+    var source = mock(WarServiceImpl.class);
+    var receiver = mock(WarDiplomacyMirrorService.class);
+    var storage = mock(WarStateStorage.class);
+    var snapshot = snapshot();
+    set(module, "warServiceImpl", source);
+    set(module, "diplomacyMirrorService", receiver);
+    set(module, "moduleStateStorage", storage);
+    when(source.mirrorSnapshot()).thenReturn(snapshot);
+    reconcile(module);
+    var war = snapshot.wars().getFirst();
+    assertThat(projection(module))
+        .containsExactlyEntriesOf(
+            Map.of(WarPairKey.of(war.aggressor(), war.defender()), war.declaredAt()));
+    verify(receiver).reconcile(snapshot);
+    verifyNoInteractions(storage);
+  }
+}
