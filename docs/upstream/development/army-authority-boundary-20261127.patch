+    var envelopeWire = TreatyEffectManifest.encodeEnvelope(original);
+    var bytes = Base64.getDecoder().decode(envelopeWire);
+    var truncated =
+        Base64.getEncoder().encodeToString(java.util.Arrays.copyOf(bytes, bytes.length - 1));
+    var trailing =
+        Base64.getEncoder().encodeToString(java.util.Arrays.copyOf(bytes, bytes.length + 1));
+
+    assertThatThrownBy(() -> TreatyEffectManifest.decodeEnvelope("%%bad%%"))
+        .isInstanceOf(IllegalArgumentException.class);
+    assertThatThrownBy(() -> TreatyEffectManifest.decodeEnvelope(truncated))
+        .hasMessageContaining("Invalid treaty envelope encoding");
+    assertThatThrownBy(() -> TreatyEffectManifest.decodeEnvelope(trailing))
+        .hasMessageContaining("Noncanonical treaty envelope");
+    var unpaddedOriginal = original;
+    while (!TreatyEffectManifest.encodeEnvelope(unpaddedOriginal).endsWith("=")) {
+      var term = unpaddedOriginal.originalTerms().getFirst();
+      unpaddedOriginal =
+          envelope(
+              List.of(new OriginalTerm(0, term.type(), term.payload(), term.description() + "x")));
