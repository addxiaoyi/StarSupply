+
+class EventAllianceInboxTest {
+  @TempDir Path root;
+  final NationId left = NationId.random();
+  final NationId right = NationId.random();
+  final Instant occurredAt = Instant.parse("2026-11-27T00:00:00Z");
+  final UUID eventId = UUID.randomUUID();
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void repeatedDeliveryAcrossRestartCommitsBothRecipientsOnce(boolean sql) {
+    try (var fixture = new Fixture(root, sql)) {
+      var module = fixture.open();
+      assertThat(module.recordAllianceOnce(eventId, left, right, true, occurredAt)).isTrue();
+      var original = List.copyOf(module.eventsOf(left));
+      assertThat(original).hasSize(1);
+      assertThat(original.getFirst().occurredAt()).isEqualTo(occurredAt);
+      assertThat(original.getFirst().type()).isEqualTo("alliance-formed");
+      var restart = fixture.open();
+      assertThat(restart.recordAllianceOnce(eventId, left, right, true, occurredAt)).isTrue();
+      assertThat(restart.eventsOf(left)).containsExactlyElementsOf(original);
+      assertThat(restart.eventsOf(right)).hasSize(1);
+      assertThat(restart.eventsOf(right).iterator().next().id())
+          .isNotEqualTo(original.getFirst().id());
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void eventIdentityRejectsChangedPayload(boolean sql) {
+    try (var fixture = new Fixture(root, sql)) {
+      var module = fixture.open();
+      module.recordAllianceOnce(eventId, left, right, true, occurredAt);
+      assertThatThrownBy(() -> module.recordAllianceOnce(eventId, left, right, false, occurredAt))
+          .isInstanceOf(IllegalArgumentException.class);
+      assertThatThrownBy(() -> module.recordAllianceOnce(eventId, right, left, true, occurredAt))
+          .isInstanceOf(IllegalArgumentException.class);
+      assertThatThrownBy(
+              () ->
+                  module.recordAllianceOnce(eventId, left, right, true, occurredAt.plusSeconds(1)))
+          .isInstanceOf(IllegalArgumentException.class);
+      assertThat(fixture.open().eventsOf(left)).hasSize(1);
+      assertThat(fixture.open().eventsOf(right)).hasSize(1);
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void clearingLogsRetainsReceiptAndReplayDoesNotRecreateRows(boolean sql) {
+    try (var fixture = new Fixture(root, sql)) {
+      var module = fixture.open();
+      module.recordAllianceOnce(eventId, left, right, false, occurredAt);
+      assertThat(module.clear(left)).isTrue();
+      assertThat(module.clear(right)).isTrue();
+      var ordinary = module.record(left, "other", "later ordinary event");
+      var restart = fixture.open();
+      assertThat(restart.recordAllianceOnce(eventId, left, right, false, occurredAt)).isTrue();
+      assertThat(restart.eventsOf(left)).containsExactly(ordinary);
+      assertThat(restart.eventsOf(right)).isEmpty();
+      assertThatThrownBy(() -> restart.recordAllianceOnce(eventId, left, right, true, occurredAt))
+          .isInstanceOf(IllegalArgumentException.class);
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void failureBeforeCommitLeavesNeitherRecipientAndRetrySucceeds(boolean sql) {
+    try (var fixture = new Fixture(root, sql)) {
+      var storage = new FaultStorage(fixture.storage());
+      var module = new EventModule(storage);
+      storage.mode = "before";
+      assertThatThrownBy(() -> module.recordAllianceOnce(eventId, left, right, true, occurredAt))
+          .isInstanceOf(RuntimeException.class);
+      assertThat(fixture.open().eventsOf(left)).isEmpty();
+      assertThat(fixture.open().eventsOf(right)).isEmpty();
+      storage.mode = "";
+      assertThat(module.recordAllianceOnce(eventId, left, right, true, occurredAt)).isTrue();
+      assertThat(fixture.open().eventsOf(left)).hasSize(1);
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void committedLostResponseUsesDurableReceipt(boolean sql) {
+    try (var fixture = new Fixture(root, sql)) {
+      var storage = new FaultStorage(fixture.storage());
+      var module = new EventModule(storage);
+      storage.mode = "after";
+      assertThat(module.recordAllianceOnce(eventId, left, right, true, occurredAt)).isTrue();
+      assertThat(fixture.open().recordAllianceOnce(eventId, left, right, true, occurredAt))
+          .isTrue();
+      assertThat(fixture.open().eventsOf(left)).hasSize(1);
+      assertThat(fixture.open().eventsOf(right)).hasSize(1);
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void unreadableCommitDoesNotAcknowledgeUntilDurableStateCanBeRead(boolean sql) {
+    try (var fixture = new Fixture(root, sql)) {
+      var storage = new FaultStorage(fixture.storage());
+      var module = new EventModule(storage);
+      storage.mode = "unknown";
+      assertThatThrownBy(() -> module.recordAllianceOnce(eventId, left, right, true, occurredAt))
+          .isInstanceOf(RuntimeException.class);
+      storage.unreadable = false;
+      storage.mode = "";
+      assertThat(module.recordAllianceOnce(eventId, left, right, true, occurredAt)).isTrue();
+      assertThat(fixture.open().eventsOf(left)).hasSize(1);
+      assertThat(fixture.open().eventsOf(right)).hasSize(1);
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void independentStaleWriterCannotEraseAnAcceptedEvent(boolean sql) {
+    try (var fixture = new Fixture(root, sql)) {
+      var winner = fixture.storage();
+      var stale = fixture.storage();
+      winner.load();
+      stale.load();
+      var accepted =
+          EventAuthorityState.empty()
+              .accept(
+                  new EventAuthorityState.AllianceReceipt(eventId, left, right, true, occurredAt));
+      winner.save(accepted.write());
+      assertThatThrownBy(() -> stale.save(EventAuthorityState.empty().write()))
+          .isInstanceOf(RuntimeException.class);
+      assertThat(fixture.open().eventsOf(left)).hasSize(1);
+      assertThat(fixture.open().eventsOf(right)).hasSize(1);
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void receiptCannotBeRemovedOrChangedAfterVisibleLogsAreCleared(boolean sql) {
+    try (var fixture = new Fixture(root, sql)) {
+      var module = fixture.open();
+      module.recordAllianceOnce(eventId, left, right, true, occurredAt);
+      module.clear(left);
+      module.clear(right);
+      var storage = fixture.storage();
+      storage.load();
+      assertThatThrownBy(() -> storage.save(EventAuthorityState.empty().write()))
+          .isInstanceOf(IllegalArgumentException.class);
+      assertThat(fixture.open().recordAllianceOnce(eventId, left, right, true, occurredAt))
+          .isTrue();
+      assertThat(fixture.open().eventsOf(left)).isEmpty();
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void initialLegacyLogMigrationPreservesExistingEvents(boolean sql) throws Exception {
+    try (var fixture = new Fixture(root, sql)) {
+      var legacy =
+          new NationEventRecord(UUID.randomUUID(), left, occurredAt, "legacy", "existing", "");
+      var properties = EventStateCodec.toProperties(Map.of(left, List.of(legacy)));
+      fixture.legacy(properties);
+      var module = fixture.open();
+      assertThat(module.eventsOf(left)).containsExactly(legacy);
+      module.recordAllianceOnce(eventId, left, right, true, occurredAt);
+      assertThat(fixture.open().eventsOf(left)).hasSize(2).contains(legacy);
+      assertThat(fixture.open().eventsOf(right)).hasSize(1);
+    }
+  }
+
+  @Test
+  void unavailableSqlDoesNotFallBackToFileOrAcknowledge() {
+    try (var fixture = new Fixture(root, true)) {
+      var unavailable = new AtomicBoolean();
+      var storage =
+          new SqlEventStateStorage(
+              root,
+              () -> {
+                if (unavailable.get()) throw new IllegalStateException("SQL unavailable");
+                return fixture.database;
+              },
+              new Properties());
+      var module = new EventModule(storage);
+      unavailable.set(true);
+      assertThatThrownBy(() -> module.recordAllianceOnce(eventId, left, right, true, occurredAt))
+          .isInstanceOf(RuntimeException.class);
+      assertThat(root.resolve("events-authority.properties")).doesNotExist();
+      unavailable.set(false);
+      assertThat(new EventModule(storage).eventsOf(left)).isEmpty();
+    }
+  }
+
+  @Test
+  void missingFileAuthorityDoesNotResurrectLegacyHistory() throws Exception {
+    try (var fixture = new Fixture(root, false)) {
+      fixture.open().recordAllianceOnce(eventId, left, right, true, occurredAt);
+      Files.delete(fixture.namespaceRoot.resolve("events-authority.properties"));
+      assertThatThrownBy(fixture::open).isInstanceOf(RuntimeException.class);
+    }
+  }
+
+  @Test
+  void durableReceiptCannotBeAcceptedWithoutBothRecipientRecords() {
+    var accepted =
+        EventAuthorityState.empty()
+            .accept(
+                new EventAuthorityState.AllianceReceipt(eventId, left, right, true, occurredAt));
+    var incomplete = accepted.clear(right);
+    assertThatThrownBy(() -> EventAuthorityState.transition(new Properties(), incomplete.write()))
+        .isInstanceOf(IllegalArgumentException.class);
+  }
+
+  @Test
+  void inMemoryOnlyModuleCannotAcknowledgeDurableDelivery() {
+    var module = new EventModule();
+    assertThat(module.recordAllianceOnce(eventId, left, right, true, occurredAt)).isFalse();
+    assertThat(module.eventsOf(left)).isEmpty();
+    assertThat(module.eventsOf(right)).isEmpty();
+  }
+
+  static final class FaultStorage implements EventStateStorage {
+    final EventStateStorage delegate;
+    String mode = "";
+    boolean unreadable;
+
+    FaultStorage(EventStateStorage delegate) {
+      this.delegate = delegate;
+    }
+
+    @Override
+    public Properties load() {
+      if (unreadable) throw new IllegalStateException("read unavailable");
+      return delegate.load();
+    }
+
+    @Override
+    public void save(Properties value) {
+      if (mode.equals("before")) throw new IllegalStateException("before commit");
+      delegate.save(value);
+      if (mode.equals("unknown")) unreadable = true;
+      if (mode.equals("after") || mode.equals("unknown"))
+        throw new IllegalStateException("lost response");
+    }
+  }
+
+  static final class Fixture implements AutoCloseable {
+    final Path namespaceRoot;
+    final PersistenceService persistence;
+    final HikariDataSource database;
+
+    Fixture(Path root, boolean sql) {
+      var plugin = mock(JavaPlugin.class);
+      when(plugin.getDataFolder()).thenReturn(root.toFile());
+      when(plugin.getLogger()).thenReturn(Logger.getAnonymousLogger());
+      persistence = new PersistenceService(plugin, null);
+      persistence.start();
+      try {
+        namespaceRoot = persistence.namespacePath("event");
+      } catch (Exception failure) {
+        throw new IllegalStateException(failure);
+      }
+      if (sql) {
+        var config = new HikariConfig();
+        config.setJdbcUrl("jdbc:sqlite:" + root.resolve("events.db"));
+        config.setMaximumPoolSize(2);
+        database = new HikariDataSource(config);
+      } else database = null;
+    }
+
+    EventStateStorage storage() {
+      return database == null
+          ? new PersistenceEventStateStorage("event", persistence)
+          : new SqlEventStateStorage(namespaceRoot, () -> database, new Properties());
+    }
+
+    EventModule open() {
+      return new EventModule(storage());
+    }
+
+    void legacy(Properties properties) throws Exception {
+      if (database == null) {
+        persistence.saveProperties("event", "events.properties", properties);
+        return;
+      }
+      try (var connection = database.getConnection();
+          var statement = connection.createStatement()) {
+        statement.execute(
+            "CREATE TABLE starcore_event_state "
+                + "(property_key VARCHAR(191) PRIMARY KEY, property_value TEXT NOT NULL)");
+        try (var insert =
+            connection.prepareStatement(
+                "INSERT INTO starcore_event_state (property_key,property_value) VALUES (?,?)")) {
+          for (String key : properties.stringPropertyNames()) {
+            insert.setString(1, key);
+            insert.setString(2, properties.getProperty(key));
+            insert.addBatch();
+          }
+          insert.executeBatch();
+        }
+      }
+    }
+
+    @Override
+    public void close() {
+      if (database != null) database.close();
+      persistence.stop();
+    }
+  }
+}
