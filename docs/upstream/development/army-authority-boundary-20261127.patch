+  @ParameterizedTest
+  @CsvSource({
+    "false,END_APPLIED",
+    "true,END_APPLIED",
+    "false,END_REJECTED",
+    "true,END_REJECTED",
+    "false,CANCEL_SEAL",
+    "true,CANCEL_SEAL",
+    "false,LOCAL_SUPERSEDED",
+    "true,LOCAL_SUPERSEDED"
+  })
+  void fullReleaseVectorAndExactSourceWinnerSurviveRestart(boolean sql, TerminalBasis basis)
+      throws Exception {
+    var fixture = fixture();
+    var setup = fixture.fixture(sql);
+    var storage = setup.storage();
+    var war = War.declare("terminal", fixture.a, fixture.b, WarGoal.TERRITORIAL);
+    storage.saveWar(war);
+    var request = request(storage, war.id());
+    storage.prepareSettlement(request);
+    EndReceipt end =
+        basis == TerminalBasis.END_APPLIED || basis == TerminalBasis.END_REJECTED
+            ? storage.endSettlement(request.operationId(), request.planHash()).receipt()
+            : null;
+    var seal = basis == TerminalBasis.CANCEL_SEAL ? storage.cancelSettlement(request) : null;
+    Phase phase =
+        switch (basis) {
+          case END_APPLIED -> Phase.APPLIED;
+          case END_REJECTED, CANCEL_SEAL -> Phase.CANCELLED;
+          case LOCAL_SUPERSEDED -> Phase.SUPERSEDED;
+        };
+    var terminal = proof(request, phase, new TerminalEvidence(basis, end, seal));
+    var receiver = mock(DiplomacyTreatyOperationService.class);
+    doThrow(new UnsupportedOperationException("receiver persistence unsupported"))
+        .when(receiver)
+        .requireEffectProofPersistence();
+    when(receiver.settlementEffect("diplomacy", 2, request.operationId()))
+        .thenReturn(Optional.of(terminal));
+    var service = setup.service(storage);
+    service.bindSettlementOperations(receiver);
+    var release = new ReleaseRequest(request.operationId(), request.planHash());
+    ReleaseReceipt receipt;
+    try {
+      receipt = service.releaseSettlement(release);
+      assertThat(receipt.protocolVersion()).isEqualTo(2);
+      assertThat(receipt.effectProofs()).containsExactly(terminal);
+      assertThat(setup.storage().settlementRelease(request.operationId())).contains(receipt);
+      assertThat(storage.settlementReserved(war.id())).isFalse();
+      verify(receiver, never()).requireEffectProofPersistence();
+    } finally {
+      service.shutdown();
+    }
+    var restarted = setup.service(setup.storage());
+    try {
+      assertThat(restarted.releaseSettlement(release)).isEqualTo(receipt);
+      var unsupported = mock(DiplomacyTreatyOperationService.class);
+      doThrow(new UnsupportedOperationException("receiver persistence unsupported"))
+          .when(unsupported)
+          .requireEffectProofPersistence();
+      restarted.bindSettlementOperations(unsupported);
+      assertThat(restarted.releaseSettlement(release)).isEqualTo(receipt);
+      if (end != null)
+        assertThat(restarted.endSettlement(request.operationId(), request.planHash()))
+            .isEqualTo(end);
+      assertThat(setup.storage().loadWar(war.id()).isEnded()).isEqualTo(end != null);
+      if (end == null) {
+        assertThatThrownBy(() -> restarted.endSettlement(request.operationId(), request.planHash()))
+            .hasMessageContaining("not reserved");
+        assertThat(setup.storage().settlementEnd(request.operationId())).isEmpty();
+      }
+      verifyNoInteractions(unsupported);
+    } finally {
+      restarted.shutdown();
+    }
+  }
