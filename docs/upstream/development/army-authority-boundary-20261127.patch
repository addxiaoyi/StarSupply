+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void bindingReservesCapacityAndUnrelatedWritesCannotConsumeItUntilTerminal(boolean sql)
+      throws Exception {
+    try (var fixture = new DiplomacyRetirementTestFixture(root, sql)) {
+      var delegate = fixture.storage();
+      var budget = new AtomicLong(Long.MAX_VALUE);
+      var storage = bounded(delegate, budget);
+      var module = fixture.open(storage);
+      var reserved = reserve(module);
+      var binding = binding(reserved);
+      var before = delegate.load();
+      var bound = bound(reserved, binding);
+      var candidate =
+          DiplomacyAuthority.merge(
+              before,
+              DiplomacyTreatyOperationState.read(before).record(bound).write(new Properties()));
+      long exactBudget = required(candidate);
+      budget.set(exactBudget - 1);
+      assertThatThrownBy(
+              () ->
+                  module.bindManifest(
+                      reserved.request().operationId(), reserved.planHash(), binding))
+          .isInstanceOf(IllegalArgumentException.class)
+          .hasMessageContaining("capacity");
+      assertThat(delegate.load()).isEqualTo(before);
+      budget.set(exactBudget);
+      assertThat(
+              module.bindManifest(reserved.request().operationId(), reserved.planHash(), binding))
+          .isEqualTo(bound);
+      var durableBound = delegate.load();
+      var unrelated = DiplomacyAuthority.copy(durableBound);
+      unrelated.setProperty("unrelated.capacity", "x".repeat(128));
+      var unrelatedCandidate = DiplomacyAuthority.seal(unrelated);
+      assertThatThrownBy(() -> storage.save(unrelatedCandidate))
+          .isInstanceOf(IllegalArgumentException.class)
+          .hasMessageContaining("capacity");
+      assertThat(delegate.load()).isEqualTo(durableBound);
+      source(module, null, new CancellationReceipt(binding));
+      var cancelled = module.cancelTreaty(reserved.request());
+      assertThat(cancelled.status()).isEqualTo(Status.CANCELLED);
+      var terminal = delegate.load();
+      assertThat(required(terminal))
+          .isEqualTo(DiplomacyTreatyCapacity.snapshotBytes(terminal, Long.MAX_VALUE));
+      var afterTerminal = DiplomacyAuthority.copy(terminal);
+      afterTerminal.setProperty("unrelated.capacity", "x".repeat(128));
+      storage.save(DiplomacyAuthority.seal(afterTerminal));
+      assertThat(fixture.open().treatyOperation(reserved.request().operationId()).orElseThrow())
+          .isEqualTo(cancelled);
+    }
+  }
