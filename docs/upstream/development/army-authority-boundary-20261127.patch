+  private OperationView storeTreaty(OperationView operation, long activeLifecycle) {
+    requireOperationLifecycle(activeLifecycle);
+    var candidate =
+        DiplomacyAuthority.merge(
+            authority, treatyOperations.record(operation).write(new Properties()));
+    requireOperationLifecycle(activeLifecycle);
