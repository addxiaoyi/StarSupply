+  @Test
+  void terminalDeclarationMustMatchItsExactTreasuryDecision() {
+    var request = request();
+    var now = Instant.ofEpochMilli(System.currentTimeMillis());
+    for (var status : List.of(Status.DECLARED, Status.REJECTED, Status.CANCELLED)) {
+      var receipt =
+          new dev.starcore.starcore.module.war.WarDeclarationRecoveryService.Receipt(
+              request, BigDecimal.TEN, now, status, status == Status.DECLARED ? now : null);
+      for (var debitStatus : NationDebitService.Status.values()) {
+        boolean matches =
+            switch (status) {
+              case DECLARED -> debitStatus == NationDebitService.Status.APPLIED;
+              case CANCELLED -> debitStatus == NationDebitService.Status.CANCELLED;
+              case REJECTED ->
+                  debitStatus == NationDebitService.Status.INSUFFICIENT_FUNDS
+                      || debitStatus == NationDebitService.Status.RETIRED;
+              case PENDING -> false;
+            };
+        if (!matches) {
+          var debit =
+              new NationDebitService.Receipt(
+                  PaidWarDeclaration.debitRequest(receipt), debitStatus, now);
+          assertThatThrownBy(
+                  () ->
+                      new PaidWarDeclaration(
+                          receipt, debit, status == Status.DECLARED ? "original-war" : null))
+              .isInstanceOf(IllegalArgumentException.class);
+        }
+      }
+      assertThatThrownBy(
+              () ->
+                  new PaidWarDeclaration(
+                      receipt, null, status == Status.DECLARED ? "original-war" : null))
+          .isInstanceOf(IllegalArgumentException.class);
+    }
+  }
