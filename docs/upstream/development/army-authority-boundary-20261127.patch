+  private boolean matchesTreatySourceRequest(
+      OperationView operation,
+      dev.starcore.starcore.module.war.WarSettlementAdmissionService.Request admission) {
+    var request = operation.request();
+    if (request.protocolVersion() == TreatyEffectManifest.VERSION)
+      return operation.binding() != null && operation.binding().equals(admission);
+    return admission.protocolVersion() == 1
+        && admission.operationId().equals(request.operationId())
+        && admission.treatyId().equals(request.treatyId())
+        && admission.war().equals(request.war())
+        && admission.warGeneration() == request.warGeneration()
+        && admission.warFingerprint().equals(request.warFingerprint())
+        && admission.planHash().equals(operation.planHash())
+        && admission.preparedAt().equals(request.preparedAt())
+        && admission
+            .scopes()
+            .equals(operation.plan().pairs().stream().map(PairPlan::pair).toList());
+  }
