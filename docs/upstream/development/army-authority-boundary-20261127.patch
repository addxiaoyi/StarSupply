+class PaperTextDialogTest {
+  @Test
+  void nativeFormBoundsPayloadAndUsesDirectCallbacksRatherThanCommandsOrBooks() {
+    var provider = mock(DialogInstancesProvider.class);
+    var builder = mock(DialogRegistryEntry.Builder.class, RETURNS_SELF);
+    var baseBuilder = mock(DialogBase.Builder.class, RETURNS_SELF);
+    var base = mock(DialogBase.class);
+    when(baseBuilder.build()).thenReturn(base);
+    var inputBuilder = mock(TextDialogInput.Builder.class, RETURNS_SELF);
+    var input = mock(TextDialogInput.class);
+    when(inputBuilder.build()).thenReturn(input);
+    var buttonBuilder = mock(ActionButton.Builder.class, RETURNS_SELF);
+    when(buttonBuilder.build()).thenReturn(mock(ActionButton.class));
+    when(provider.textBuilder(eq("value"), any())).thenReturn(inputBuilder);
+    when(provider.dialogBaseBuilder(any())).thenReturn(baseBuilder);
+    when(provider.actionButtonBuilder(any())).thenReturn(buttonBuilder);
+    when(provider.register(any(), any())).thenReturn(mock(DialogAction.CustomClickAction.class));
+    when(provider.confirmation(any(), any())).thenReturn(mock(ConfirmationType.class));
+    var multiline = mock(TextDialogInput.MultilineOptions.class);
+    when(provider.multilineOptions(5, 100)).thenReturn(multiline);
+    var submitted = new ArrayList<String>();
+    var canceled = new ArrayList<Player>();
+    var player = NativeTextInputTest.player(UUID.randomUUID());
+    try (var statics = mockStatic(DialogInstancesProvider.class)) {
+      statics.when(DialogInstancesProvider::instance).thenReturn(provider);
+      PaperTextDialog.configure(
+          builder,
+          new NativeTextInput.Prompt("原生输入", "initial", 32767),
+          (actor, text) -> submitted.add(text),
+          canceled::add);
+      verify(inputBuilder).initial("initial");
+      verify(inputBuilder).maxLength(32767);
+      verify(inputBuilder).multiline(multiline);
+      verify(baseBuilder).inputs(List.of(input));
+      verify(baseBuilder).canCloseWithEscape(false);
+      verify(baseBuilder).afterAction(DialogBase.DialogAfterAction.CLOSE);
+      verify(builder).base(base);
+      var callbacks = ArgumentCaptor.forClass(DialogActionCallback.class);
+      var options = ArgumentCaptor.forClass(ClickCallback.Options.class);
+      verify(provider, times(2)).register(callbacks.capture(), options.capture());
+      assertThat(options.getAllValues())
+          .allSatisfy(
+              option -> {
+                assertThat(option.lifetime()).isEqualTo(NativeTextInput.LIFETIME);
+                assertThat(option.uses()).isEqualTo(ClickCallback.UNLIMITED_USES);
+              });
+      var response = mock(DialogResponseView.class);
+      when(response.getText("value")).thenReturn("/literal\n文字");
+      callbacks.getAllValues().getFirst().accept(response, mock(Audience.class));
+      assertThat(submitted).isEmpty();
+      callbacks.getAllValues().getFirst().accept(response, player);
+      callbacks.getAllValues().getLast().accept(response, player);
+      assertThat(submitted).containsExactly("/literal\n文字");
+      assertThat(canceled).containsExactly(player);
+      verify(provider, never()).commandTemplate(anyString());
+      verify(player, never()).getInventory();
+    }
+  }
+
+  @Test
+  void productionConstructorRegistersLifecycleAndOwnerSchedulerAndCancelsExpiryTimer() {
+    var plugin = mock(Plugin.class);
+    when(plugin.isEnabled()).thenReturn(true);
+    var server = mock(Server.class);
+    var plugins = mock(PluginManager.class);
+    when(plugin.getServer()).thenReturn(server);
+    when(server.getPluginManager()).thenReturn(plugins);
+    var timer = mock(BukkitTask.class);
+    var player = NativeTextInputTest.player(UUID.randomUUID());
+    try (var views = mockConstruction(PaperTextDialog.class);
+        var scheduler = mockStatic(CompatScheduler.class)) {
+      scheduler
+          .when(() -> CompatScheduler.globalTimer(eq(plugin), any(), eq(1200L), eq(1200L)))
+          .thenReturn(timer);
+      var input = new NativeTextInput(plugin);
+      verify(plugins).registerEvents(input, plugin);
+      input.open(player, new NativeTextInput.Prompt("title", "", 10), text -> {}, () -> {});
+      verifyNoInteractions(views.constructed().getFirst());
+      var action = ArgumentCaptor.forClass(Runnable.class);
+      var retired = ArgumentCaptor.forClass(Runnable.class);
+      scheduler.verify(
+          () ->
+              CompatScheduler.entity(
+                  eq(plugin), same(player), action.capture(), retired.capture()));
+      retired.getValue().run();
+      action.getValue().run();
+      verifyNoInteractions(views.constructed().getFirst());
+      input.close();
+      input.close();
+      verify(timer).cancel();
+      assertThat(input.isStopped()).isTrue();
+      verify(player, never()).getInventory();
+    }
+  }
+
+  @Test
+  void failedExpirySchedulingStopsAndUnregistersPartiallyConstructedInput() {
+    for (Throwable failure :
+        List.of(
+            new IllegalStateException("scheduler stopped"),
+            new LinkageError("scheduler unavailable"))) {
+      var plugin = mock(Plugin.class);
+      when(plugin.isEnabled()).thenReturn(true);
+      var server = mock(Server.class);
+      var plugins = mock(PluginManager.class);
+      when(plugin.getServer()).thenReturn(server);
+      when(server.getPluginManager()).thenReturn(plugins);
+      try (var views = mockConstruction(PaperTextDialog.class);
+          var scheduler = mockStatic(CompatScheduler.class);
+          var handlers = mockStatic(HandlerList.class)) {
+        scheduler
+            .when(() -> CompatScheduler.globalTimer(eq(plugin), any(), eq(1200L), eq(1200L)))
+            .thenThrow(failure);
+        assertThatThrownBy(() -> new NativeTextInput(plugin)).isSameAs(failure);
+        var registered = ArgumentCaptor.forClass(Listener.class);
+        verify(plugins).registerEvents(registered.capture(), same(plugin));
+        var input = (NativeTextInput) registered.getValue();
+        assertThat(input.isStopped()).isTrue();
+        handlers.verify(() -> HandlerList.unregisterAll(input));
+        var player = NativeTextInputTest.player(UUID.randomUUID());
+        assertThatThrownBy(
+                () ->
+                    input.open(
+                        player, new NativeTextInput.Prompt("title", "", 10), text -> {}, () -> {}))
+            .isInstanceOf(IllegalStateException.class);
+        verifyNoInteractions(views.constructed().getFirst());
+      }
+    }
+  }
+
+  @Test
+  void failedExpirySchedulingPreservesOriginalFailureWhenListenerCleanupAlsoFails() {
+    for (boolean sameFailure : List.of(true, false)) {
+      var plugin = mock(Plugin.class);
+      when(plugin.isEnabled()).thenReturn(true);
+      var server = mock(Server.class);
+      var plugins = mock(PluginManager.class);
+      when(plugin.getServer()).thenReturn(server);
+      when(server.getPluginManager()).thenReturn(plugins);
+      var failure = new LinkageError("scheduler unavailable");
+      Throwable cleanupFailure =
+          sameFailure ? failure : new IllegalStateException("cleanup failed");
+      try (var views = mockConstruction(PaperTextDialog.class);
+          var scheduler = mockStatic(CompatScheduler.class);
+          var handlers = mockStatic(HandlerList.class)) {
+        scheduler
+            .when(() -> CompatScheduler.globalTimer(eq(plugin), any(), eq(1200L), eq(1200L)))
+            .thenThrow(failure);
+        handlers
+            .when(() -> HandlerList.unregisterAll(any(Listener.class)))
+            .thenThrow(cleanupFailure);
+        assertThatThrownBy(() -> new NativeTextInput(plugin)).isSameAs(failure);
+        if (sameFailure) assertThat(failure.getSuppressed()).isEmpty();
+        else assertThat(failure.getSuppressed()).containsExactly(cleanupFailure);
+      }
+    }
+  }
+}
