+      assertNull(completed.binding());
+      assertEquals(1, completed.warRequest().protocolVersion());
+      assertNull(completed.warRequest().manifest());
+      assertEquals(completed.plan().planHash(), completed.warRequest().planHash());
+      assertEquals(declaredAt.plusSeconds(1).plusNanos(37), completed.request().preparedAt());
+      assertEquals(PeaceTreatyBatch.Stage.RELEASED, completed.stage());
+      assertEquals(Status.APPLIED, completed.terminalReceipt().status());
+      assertNull(completed.terminalReceipt().binding());
+      assertNull(completed.terminalReceipt().terminalEvidence());
+      var release = restarted.storage.settlementRelease(request.operationId()).orElseThrow();
+      assertEquals(1, release.protocolVersion());
+      assertTrue(release.effectProofs().isEmpty());
+      assertFalse(fixture.storage().loadWar(war.id()).isActive());
+      assertEquals(1, restarted.treaties.getPoliticalRestrictions(defender.value()).size());
+      verify(restarted.receiver, never()).bindManifest(any(), anyString(), any());
