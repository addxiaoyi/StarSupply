+        case "partial" -> write(f, FAMILIES.get(0), properties(id + ".name", "Alpha"));
+        case "duplicate" ->
+            Files.writeString(
+                folder.resolve(FAMILIES.get(0)), id + ".name=Alpha\n", StandardOpenOption.APPEND);
+        case "empty" -> Files.writeString(folder.resolve(FAMILIES.get(3)), "");
+        case "orphan" -> {
+          var p = folder.resolve(FAMILIES.get(3));
+          Files.move(p, AtomicFilePersistence.backup(p));
+        }
+        default -> throw new AssertionError();
+      }
+      assertThatThrownBy(f::service).isInstanceOf(RuntimeException.class);
+      assertThat(folder.resolve("federation-authority.properties")).doesNotExist();
+    }
+  }
+
+  @Test
+  void emptyCommentedLegacySealsAndMissingAuthorityNeverReimports() throws Exception {
+    try (var f = new FederationTestFixture(root, false)) {
+      for (var name : FAMILIES) write(f, name, new Properties());
+      assertThat(f.service().getAllianceCount()).isZero();
+      var authority =
+          f.persistence.namespacePath("alliance").resolve("federation-authority.properties");
+      Files.delete(authority);
+      assertThatThrownBy(f::service).hasMessageContaining("Missing snapshot");
+    }
+  }
+
+  @Test
+  void fileToSqlMigratesSealedHistoryAndIgnoresObsoleteLegacy() throws Exception {
+    try (var f = new FederationTestFixture(root, false)) {
+      var s = f.service();
+      var id = f.create(s, f.a, "Alpha");
+      var op = UUID.randomUUID();
+      var proof = s.retireNationFederation(op, f.a);
+      seed(f);
+      when(f.database.isRunning()).thenReturn(true);
+      var sql = f.service();
+      assertThat(sql.retireNationFederation(op, f.a)).isEqualTo(proof);
+      assertThat(sql.getAlliance(id)).isEmpty();
+      assertThatThrownBy(() -> s.createAlliance("Bravo", f.b)).hasMessageContaining("BACKEND");
+      when(f.database.isRunning()).thenReturn(false);
+      assertThatThrownBy(() -> sql.createAlliance("Bravo", f.b)).hasMessageContaining("BACKEND");
+      when(f.database.isRunning()).thenReturn(true);
+      assertThat(f.service().getAllianceCount()).isZero();
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(strings = {"backup", "temp", "marker", "corrupt"})
+  void sqlMigrationCannotBypassLostOrCorruptSealedFile(String trace) throws Exception {
+    try (var f = new FederationTestFixture(root, false)) {
+      var s = f.service();
+      f.create(s, f.a, "Alpha");
+      var file = f.persistence.namespacePath("alliance").resolve("federation-authority.properties");
+      if (trace.equals("corrupt")) Files.writeString(file, "bad=state\n");
+      else {
+        if (trace.equals("temp"))
+          Files.copy(file, AtomicFilePersistence.temp(file), StandardCopyOption.REPLACE_EXISTING);
+        if (trace.equals("backup"))
+          Files.copy(file, AtomicFilePersistence.backup(file), StandardCopyOption.REPLACE_EXISTING);
+        Files.delete(file);
+        if (!trace.equals("marker"))
+          Files.deleteIfExists(file.resolveSibling(file.getFileName() + ".initialized"));
