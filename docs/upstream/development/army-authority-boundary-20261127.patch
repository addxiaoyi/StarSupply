+import org.junit.jupiter.params.provider.ValueSource;
+import org.slf4j.LoggerFactory;
+
+class AllianceOperationEndToEndTest {
+  @TempDir Path root;
+  private final Instant occurredAt = Instant.parse("2026-11-27T01:02:03.123456789Z");
+
+  private AllianceServiceImpl open(
+      AllianceRetirementFixture local,
+      AllianceStorage storage,
+      DiplomacyModule receiver,
+      DiplomacyAllianceOperationService operations) {
+    var policy =
+        new DiplomacyTimingPolicy(
+            Duration.ZERO, Duration.ofDays(7), Clock.fixed(occurredAt, ZoneOffset.UTC));
+    var service =
+        new AllianceServiceImpl(
+            null, local.nations, receiver, null, null, storage, policy, operations);
+    service.initialize();
+    return service;
+  }
+
+  private static final class FaultStorage extends AllianceStorage {
+    private Action rejectAcknowledgment;
+
+    FaultStorage(AllianceRetirementFixture fixture) {
+      super(fixture.database, fixture.persistence, LoggerFactory.getLogger(FaultStorage.class));
+    }
+
+    @Override
+    public synchronized void saveOperationStateSync(StateSnapshot state) {
+      if (rejectAcknowledgment != null
+          && state.intents().values().stream()
+              .anyMatch(
+                  intent ->
+                      intent.status() == Status.ACKNOWLEDGED
+                          && intent.request().action() == rejectAcknowledgment)) {
+        throw new IllegalStateException("injected producer acknowledgment failure");
+      }
+      super.saveOperationStateSync(state);
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void realAuthoritiesPreserveExactTimeAcrossFormationBreakAndRestart(boolean sql) {
+    try (var local = new AllianceRetirementFixture(root.resolve("local"), sql);
+        var remote = new DiplomacyRetirementTestFixture(root.resolve("remote"), sql)) {
+      var receiver = remote.open();
+      var service = open(local, local.allianceStorage(), receiver, receiver);
+      assertTrue(service.sendInvite(local.a, local.b).success());
+      assertTrue(service.acceptInvite(local.b, local.a.toString()).success());
+      var formed = local.allianceStorage().loadStateSnapshot();
+      var intent = formed.intents().values().iterator().next();
+      assertEquals(Status.ACKNOWLEDGED, intent.status());
+      assertEquals(occurredAt, intent.request().occurredAt());
+      assertEquals(occurredAt, service.getAllianceInfo(local.a, local.b).orElseThrow().formedAt());
+      var receipt = receiver.allianceOperationReceipt(intent.operationId()).orElseThrow();
+      assertTrue(receipt.applied());
+      var pending = DiplomacyDerivedEventState.read(remote.storage().load()).pending();
+      assertEquals(local.a, pending.get(intent.operationId()).left());
+      assertEquals(local.b, pending.get(intent.operationId()).right());
+      assertEquals(occurredAt, pending.get(intent.operationId()).createdAt());
+      var restartedReceiver = remote.open();
+      var restarted = open(local, local.allianceStorage(), restartedReceiver, restartedReceiver);
+      assertTrue(restarted.areAllied(local.a, local.b));
+      assertTrue(restarted.breakAlliance(local.a, local.b, local.a));
+      assertFalse(restarted.areAllied(local.a, local.b));
+      assertEquals(DiplomacyRelation.NEUTRAL, restartedReceiver.relationBetween(local.a, local.b));
+      assertEquals(receipt, restartedReceiver.applyAllianceOperation(intent.request()));
+      assertEquals(DiplomacyRelation.NEUTRAL, restartedReceiver.relationBetween(local.a, local.b));
+      assertEquals(2, DiplomacyDerivedEventState.read(remote.storage().load()).pending().size());
+      var finalReceiver = remote.open();
+      assertTrue(
+          open(local, local.allianceStorage(), finalReceiver, finalReceiver)
+              .pendingAllianceOperations()
+              .isEmpty());
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void appliedFormationCannotOverwriteLaterWarAfterProducerAckFailure(boolean sql) {
+    try (var local = new AllianceRetirementFixture(root.resolve("local"), sql);
+        var remote = new DiplomacyRetirementTestFixture(root.resolve("remote"), sql)) {
+      var receiver = remote.open();
+      var storage = new FaultStorage(local);
+      var service = open(local, storage, receiver, receiver);
+      assertTrue(service.sendInvite(local.a, local.b).success());
+      storage.rejectAcknowledgment = Action.FORM;
+      assertThrows(RuntimeException.class, () -> service.acceptInvite(local.b, local.a.toString()));
+      var original =
+          local.allianceStorage().loadStateSnapshot().intents().values().iterator().next();
+      assertEquals(Status.PREPARED, original.status());
+      var applied = receiver.allianceOperationReceipt(original.operationId()).orElseThrow();
+      assertTrue(applied.applied());
+      receiver.reconcile(
+          new WarDiplomacyMirrorService.SourceSnapshot(
+              1,
+              List.of(
+                  new WarDiplomacyMirrorService.WarEntry(
+                      UUID.randomUUID(), local.a, local.b, occurredAt.plusSeconds(1), true))));
+      var restartedReceiver = remote.open();
+      var restarted = open(local, local.allianceStorage(), restartedReceiver, restartedReceiver);
+      assertTrue(restarted.pendingAllianceOperations().isEmpty());
+      assertFalse(restarted.areAllied(local.a, local.b));
+      assertTrue(local.allianceStorage().loadStateSnapshot().alliances().isEmpty());
+      assertEquals(DiplomacyRelation.WAR, restartedReceiver.relationBetween(local.a, local.b));
+      assertEquals(applied, restartedReceiver.applyAllianceOperation(original.request()));
+      assertEquals(DiplomacyRelation.WAR, restartedReceiver.relationBetween(local.a, local.b));
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void appliedBreakCannotOverwriteLaterHostileStateAfterProducerAckFailure(boolean sql) {
+    try (var local = new AllianceRetirementFixture(root.resolve("local"), sql);
+        var remote = new DiplomacyRetirementTestFixture(root.resolve("remote"), sql)) {
+      var receiver = remote.open();
+      var storage = new FaultStorage(local);
+      var service = open(local, storage, receiver, receiver);
+      assertTrue(service.createAlliance(local.a, local.b).success());
+      storage.rejectAcknowledgment = Action.BREAK;
+      assertThrows(RuntimeException.class, () -> service.breakAlliance(local.a, local.b, local.b));
+      var original =
+          local.allianceStorage().loadStateSnapshot().intents().values().stream()
+              .filter(intent -> intent.request().action() == Action.BREAK)
+              .findFirst()
+              .orElseThrow();
+      assertEquals(Status.PREPARED, original.status());
+      var applied = receiver.allianceOperationReceipt(original.operationId()).orElseThrow();
+      receiver.setRelation(local.a, local.b, DiplomacyRelation.HOSTILE);
+      var restartedReceiver = remote.open();
+      var restarted = open(local, local.allianceStorage(), restartedReceiver, restartedReceiver);
+      assertFalse(restarted.areAllied(local.a, local.b));
+      assertEquals(
+          Status.ACKNOWLEDGED,
+          restarted.allianceOperation(original.operationId()).orElseThrow().status());
+      assertEquals(applied, restartedReceiver.applyAllianceOperation(original.request()));
+      assertEquals(DiplomacyRelation.HOSTILE, restartedReceiver.relationBetween(local.a, local.b));
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void clearingLocalProjectionCannotBeUndoneByLegacyRowSave(boolean sql) {
+    try (var local = new AllianceRetirementFixture(root.resolve("local"), sql);
+        var remote = new DiplomacyRetirementTestFixture(root.resolve("remote"), sql)) {
+      var receiver = remote.open();
+      var service = open(local, local.allianceStorage(), receiver, receiver);
+      assertTrue(service.createAlliance(local.a, local.b).success());
+      var original = local.allianceStorage().loadStateSnapshot();
+      service.clearNationRelations(local.a);
+      assertFalse(service.areAllied(local.a, local.b));
+      var legacyWriter = local.allianceStorage();
+      legacyWriter.saveAlliances(original.alliances());
+      var restartedReceiver = remote.open();
+      var restarted = open(local, local.allianceStorage(), restartedReceiver, restartedReceiver);
+      assertFalse(restarted.areAllied(local.a, local.b));
+      assertTrue(restarted.getAllies(local.a).isEmpty());
+      assertEquals(DiplomacyRelation.ALLIED, restartedReceiver.relationBetween(local.a, local.b));
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void cancellationSealsOriginalRequestBeforeAnyEffectAndSurvivesRestart(boolean sql) {
+    try (var local = new AllianceRetirementFixture(root.resolve("local"), sql);
+        var remote = new DiplomacyRetirementTestFixture(root.resolve("remote"), sql)) {
+      var receiver = remote.open();
+      DiplomacyAllianceOperationService unavailableApply =
+          new DiplomacyAllianceOperationService() {
+            @Override
+            public Receipt applyAllianceOperation(Request request) {
+              throw new IllegalStateException("injected unavailable apply");
+            }
+
+            @Override
+            public Receipt cancelAllianceOperation(Request request) {
+              return receiver.cancelAllianceOperation(request);
+            }
+
+            @Override
+            public PairState alliancePairState(NationId left, NationId right) {
+              return receiver.alliancePairState(left, right);
+            }
+
+            @Override
+            public Optional<Receipt> allianceOperationReceipt(UUID operationId) {
+              return receiver.allianceOperationReceipt(operationId);
+            }
+          };
+      var service = open(local, local.allianceStorage(), receiver, unavailableApply);
+      assertThrows(RuntimeException.class, () -> service.createAlliance(local.a, local.b));
+      var original =
+          local.allianceStorage().loadStateSnapshot().intents().values().iterator().next();
+      assertTrue(receiver.allianceOperationReceipt(original.operationId()).isEmpty());
+      var cancelled = service.cancelAllianceOperation(original.operationId());
+      assertEquals(Status.ACKNOWLEDGED, cancelled.status());
+      var receipt = receiver.allianceOperationReceipt(original.operationId()).orElseThrow();
+      assertEquals(Outcome.CANCELLED, receipt.outcome());
+      var restartedReceiver = remote.open();
+      assertEquals(receipt, restartedReceiver.applyAllianceOperation(original.request()));
+      assertEquals(DiplomacyRelation.NEUTRAL, restartedReceiver.relationBetween(local.a, local.b));
+      assertTrue(DiplomacyDerivedEventState.read(remote.storage().load()).pending().isEmpty());
+      var restarted = open(local, local.allianceStorage(), restartedReceiver, restartedReceiver);
+      assertFalse(restarted.areAllied(local.a, local.b));
+      assertTrue(restarted.pendingAllianceOperations().isEmpty());
+    }
+  }
+}
