diff --git a/src/main/java/dev/starcore/starcore/war/PeaceTreatyProtocolJson.java b/src/main/java/dev/starcore/starcore/war/PeaceTreatyProtocolJson.java
new file mode 100644
index 0000000000000000000000000000000000000000..0be85d402be7f4796338b83ca252cbfe09415a00
--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/war/PeaceTreatyProtocolJson.java
@@ -0,0 +1,100 @@
+package dev.starcore.starcore.war;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+
+final class PeaceTreatyProtocolJson {
+  private PeaceTreatyProtocolJson() {}
+
+  static void prepare(JsonObject snapshot, int schemaVersion) {
+    var execution = object(snapshot, "execution");
+    if (execution == null) return;
+    var batch = object(execution, "batch");
+    if (batch == null) return;
+    boolean legacy = schemaVersion < 4;
+    if (legacy) rejectPresent(batch, "binding");
+    else if (!batch.has("cancelRequested"))
+      throw new IllegalArgumentException("Treaty cancellation intent is missing");
+    reserve(object(batch, "request"), legacy);
+    plan(object(batch, "plan"), legacy);
+    end(object(batch, "endReceipt"), legacy);
+    operation(object(batch, "terminalReceipt"), legacy);
+    nativeRequest(object(batch, "binding"), legacy);
+  }
+
+  private static void operation(JsonObject operation, boolean legacy) {
+    if (operation == null) return;
+    reserve(object(operation, "request"), legacy);
+    plan(object(operation, "plan"), legacy);
+    if (legacy) rejectPresent(operation, "binding", "terminalEvidence");
+    nativeRequest(object(operation, "binding"), legacy);
+    var evidence = object(operation, "terminalEvidence");
+    if (evidence != null) {
+      end(object(evidence, "endReceipt"), legacy);
+      var cancellation = object(evidence, "cancellationReceipt");
+      if (cancellation != null) nativeRequest(object(cancellation, "request"), legacy);
+    }
+  }
+
+  private static void plan(JsonObject plan, boolean legacy) {
+    if (plan != null) reserve(object(plan, "request"), legacy);
+  }
+
+  private static void end(JsonObject end, boolean legacy) {
+    if (end != null) nativeRequest(object(end, "request"), legacy);
+  }
+
+  private static void reserve(JsonObject request, boolean legacy) {
+    if (request == null) return;
+    if (legacy) {
+      rejectPresent(request, "protocolVersion", "envelope", "assignedTermIndexes");
+      request.addProperty("protocolVersion", 1);
+      var indexes = new JsonArray();
+      var terms = request.getAsJsonArray("terms");
+      if (terms == null) throw new IllegalArgumentException("Legacy treaty terms are missing");
+      for (JsonElement term : terms) indexes.add(term.getAsJsonObject().get("termIndex"));
+      request.add("assignedTermIndexes", indexes);
+    } else {
+      int protocol = protocol(request);
+      if (!request.has("assignedTermIndexes") || !request.get("assignedTermIndexes").isJsonArray())
+        throw new IllegalArgumentException("Treaty receiver assignment is missing");
+      if ((protocol == 2) != (object(request, "envelope") != null))
+        throw new IllegalArgumentException("Treaty receiver envelope version mismatch");
+    }
+  }
+
+  private static void nativeRequest(JsonObject request, boolean legacy) {
+    if (request == null) return;
+    if (legacy) {
+      rejectPresent(request, "protocolVersion", "manifest");
+      request.addProperty("protocolVersion", 1);
+    } else if ((protocol(request) == 2) != (object(request, "manifest") != null)) {
+      throw new IllegalArgumentException("Treaty native manifest version mismatch");
+    }
+  }
+
+  private static int protocol(JsonObject request) {
+    var value = request.get("protocolVersion");
+    if (value == null
+        || !value.isJsonPrimitive()
+        || !value.getAsJsonPrimitive().isNumber()
+        || !value.getAsString().equals("1") && !value.getAsString().equals("2"))
+      throw new IllegalArgumentException("Treaty protocol version must be explicit");
+    return value.getAsInt();
+  }
+
+  private static void rejectPresent(JsonObject object, String... fields) {
+    for (var field : fields)
+      if (object.has(field))
+        throw new IllegalArgumentException("Versioned treaty field in legacy schema: " + field);
+  }
+
+  private static JsonObject object(JsonObject parent, String field) {
+    JsonElement value = parent.get(field);
+    if (value == null || value.isJsonNull()) return null;
+    if (!value.isJsonObject())
+      throw new IllegalArgumentException("Invalid treaty object: " + field);
+    return value.getAsJsonObject();
+  }
+}
