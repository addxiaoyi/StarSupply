+  private void cancelInvitationIntent(AllianceInviteKey invite) {
+    var intent = pendingIntent(AlliancePairKey.of(invite.inviter(), invite.invited()));
+    if (intent.isEmpty() || !invite.equals(intent.get().originalInvite())) return;
+    requestCancellation(intent.get().operationId());
+    processIntent(intent.get().operationId());
+  }
+
+  private void requestCancellation(UUID operationId) {
+    requireOperationAuthority();
+    var latest = storage.loadStateSnapshot();
+    var intent = requireIntent(latest, operationId);
+    if (intent.status() == Status.ACKNOWLEDGED || intent.cancellationRequested()) return;
+    var updated = new HashMap<>(latest.intents());
+    updated.put(operationId, intent.requestCancellation());
+    saveOperationState(
+        latest,
+        latest.alliances(),
+        latest.invites(),
+        latest.cooldowns(),
+        updated,
+        latest.projectionOwners());
+  }
