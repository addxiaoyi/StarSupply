+      assertThat(callbackEntered.await(5, TimeUnit.SECONDS)).isTrue();
+      var shutdown =
+          executor.submit(
+              () -> {
+                module.disable(null);
+                completionOrder.add("disable");
+              });
+      loanOperation.get(5, TimeUnit.SECONDS);
+      submission.get(5, TimeUnit.SECONDS);
+      shutdown.get(5, TimeUnit.SECONDS);
