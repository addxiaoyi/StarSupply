+package dev.starcore.starcore.module.event;
+
+import dev.starcore.starcore.core.persistence.AtomicFilePersistence;
+import dev.starcore.starcore.core.persistence.DurablePropertiesStore;
+import dev.starcore.starcore.core.persistence.FileAuthorityLock;
+import java.io.ByteArrayInputStream;
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.Objects;
+import java.util.Properties;
+import java.util.function.Supplier;
+import javax.sql.DataSource;
+
+final class EventAuthorityStorage implements EventStateStorage {
+  private final DurablePropertiesStore store;
+
+  EventAuthorityStorage(Path file, Supplier<DataSource> database, Supplier<Properties> legacy) {
+    store =
+        new DurablePropertiesStore(
+            file,
+            database,
+            "starcore_event_authority",
+            legacy,
+            EventAuthorityState::validate,
+            EventAuthorityState::transition);
+  }
+
+  @Override
+  public Properties load() {
+    return store.load();
+  }
+
+  @Override
+  public void save(Properties value) {
+    store.save(value);
+  }
+
+  static Properties legacyFile(Path path) {
+    Objects.requireNonNull(path);
+    try (var ignored = FileAuthorityLock.acquire(path)) {
+      if (!Files.exists(path)) {
+        if (Files.exists(AtomicFilePersistence.backup(path))
+            || Files.exists(AtomicFilePersistence.temp(path)))
+          throw new IOException("Missing legacy event authority");
+        return new Properties();
+      }
+      if (!Files.isRegularFile(path) || Files.size(path) > 64 * 1024 * 1024)
+        throw new IOException("Invalid legacy event authority");
+      byte[] bytes;
+      try (var input = Files.newInputStream(path)) {
+        bytes = input.readNBytes(64 * 1024 * 1024 + 1);
+      }
+      if (bytes.length == 0 || bytes.length > 64 * 1024 * 1024)
+        throw new IOException("Invalid legacy event authority size");
+      var result =
+          new Properties() {
+            @Override
+            public synchronized Object put(Object key, Object value) {
+              if (containsKey(key)) throw new IllegalArgumentException("Duplicate event property");
+              return super.put(key, value);
+            }
+          };
+      result.load(new ByteArrayInputStream(bytes));
+      EventAuthorityState.validate(result);
+      return result;
+    } catch (IOException failure) {
+      throw new IllegalStateException("Unable to read legacy event authority", failure);
+    }
+  }
+}
