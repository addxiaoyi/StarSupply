+  void receiverChangeOrShutdownDuringCapabilityOrProofCannotCommit(
+      boolean admissionPersisted, boolean capabilityCallback, boolean shutdown) throws Exception {
+    var fixture = fixture();
+    var setup = fixture.fixture(false);
+    var storage = setup.storage();
+    var war = War.declare("receiver callback", fixture.a, fixture.b, WarGoal.TERRITORIAL);
+    storage.saveWar(war);
+    var request = request(storage, war.id());
+    if (admissionPersisted) storage.prepareSettlement(request);
+    var receiver = mock(DiplomacyTreatyOperationService.class);
+    var replacement = mock(DiplomacyTreatyOperationService.class);
+    doThrow(new UnsupportedOperationException("replacement persistence unsupported"))
+        .when(replacement)
+        .requireEffectProofPersistence();
+    var service = setup.service(storage);
+    service.bindSettlementOperations(receiver);
+    Answer<Void> invalidate =
+        call -> {
+          if (shutdown) service.shutdown();
+          else {
+            var field = WarServiceImpl.class.getDeclaredField("settlementOperations");
+            field.setAccessible(true);
+            field.set(service, replacement);
+          }
+          return null;
+        };
+    if (capabilityCallback) {
+      doAnswer(invalidate).when(receiver).requireEffectProofPersistence();
+      when(receiver.settlementEffect("diplomacy", 2, request.operationId()))
+          .thenReturn(Optional.of(proof(request, Phase.BOUND, null)));
+    } else
+      when(receiver.settlementEffect("diplomacy", 2, request.operationId()))
+          .thenAnswer(
+              call -> {
+                invalidate.answer(call);
+                return Optional.of(proof(request, Phase.BOUND, null));
+              });
+    var originalAuthority = storage.currentAuthority();
+    try {
+      assertThatThrownBy(
+              () -> {
+                if (admissionPersisted)
+                  service.endSettlement(request.operationId(), request.planHash());
+                else service.prepareSettlement(request);
+              })
+          .isInstanceOf(IllegalStateException.class)
+          .hasMessageContaining(shutdown ? "stopped" : "identity changed");
+      verify(receiver).requireEffectProofPersistence();
+      verify(receiver, times(capabilityCallback ? 0 : 1))
+          .settlementEffect("diplomacy", 2, request.operationId());
+      verifyNoInteractions(replacement);
+      assertThat(setup.storage().currentAuthority()).isEqualTo(originalAuthority);
+      assertThat(setup.storage().settlementAdmission(request.operationId()).isPresent())
+          .isEqualTo(admissionPersisted);
+      assertThat(setup.storage().settlementEnd(request.operationId())).isEmpty();
+      assertThat(setup.storage().loadWar(war.id()).isActive()).isTrue();
+    } finally {
+      service.shutdown();
+    }
+  }
+
+  @Test
+  void readerCallbacksRunOutsideMutationGateAndShutdownPreventsFreshAdmission() throws Exception {
+    var fixture = fixture();
+    var setup = fixture.fixture(false);
+    var storage = setup.storage();
+    var war = War.declare("callback", fixture.a, fixture.b, WarGoal.TERRITORIAL);
