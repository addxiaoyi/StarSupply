+    void assertComplete(UUID operation) {
+      assertThat(operation().state()).isEqualTo(NationDisbandOperation.State.COMPLETED);
+      assertThat(operation().transaction().transactionId()).isEqualTo(operation);
+      assertThat(operation().transaction().nationIds()).containsExactlyInAnyOrder(parent, child);
+      assertThat(nations.nationById(parent)).isEmpty();
+      assertThat(nations.nationById(child)).isEmpty();
+      assertThat(nations.nationById(survivor)).isPresent();
+      assertThat(nations.nationById(unrelated)).isPresent();
+      for (var id : List.of(parent, child)) {
+        assertThat(wars.retireNationWars(operation, id).operationId()).isEqualTo(operation);
+        assertThat(territory.retireOwner(operation, id.toString()).releasedClaims()).isEqualTo(1);
+        assertThat(cities.retireNationCities(operation, id).operationId()).isEqualTo(operation);
+        assertThat(cities.cityRetirementReceipt(id).orElseThrow().deletedCityIds())
+            .containsExactly(cityIds.get(id));
+        assertThat(diplomacy.retireDiplomacy(operation, id).operationId()).isEqualTo(operation);
+        assertThat(bilateral.retireAlliances(operation, id).operationId()).isEqualTo(operation);
+        assertThat(military.retireMilitaryAlliances(operation, id).operationId())
+            .isEqualTo(operation);
+        assertThat(treasury.retireTreasury(operation, id).retiredBalance())
+            .isEqualByComparingTo(id.equals(parent) ? "1000" : "2000");
+        assertThat(federation.retireNationFederation(operation, id).operationId())
+            .isEqualTo(operation);
+        assertThat(territory.claimsByOwner(id.toString())).isEmpty();
+        assertThat(cities.getNationCities(id)).isEmpty();
+        assertThat(diplomacy.relationsOf(id)).isEmpty();
+        assertThat(bilateral.getAllies(id)).isEmpty();
+        assertThat(military.getMilitaryAllies(id, PactType.OBSERVER)).isEmpty();
+        assertThat(treasury.balance(id)).isEqualByComparingTo("0");
+      }
+      assertThat(territory.claimsByOwner(survivor.toString())).hasSize(1);
+      assertThat(cities.getCity(cityIds.get(survivor))).isPresent();
+      assertThat(diplomacy.relationsOf(survivor)).hasSize(1);
+      assertThat(bilateral.getAllies(survivor)).containsExactly(unrelated);
+      assertThat(military.getMilitaryAllies(survivor, PactType.OBSERVER))
+          .containsExactly(unrelated);
+      assertThat(treasury.balance(survivor)).isEqualByComparingTo("3000");
+      assertThat(treasury.balance(unrelated)).isEqualByComparingTo("2000");
+      assertThat(federation.getAlliance(federationId).orElseThrow().leaderId()).isEqualTo(survivor);
+      assertThat(federation.getAllianceMembers(federationId)).hasSize(1);
+      assertThat(warStore.loadAllWars())
+          .extracting(War::id)
+          .containsExactlyInAnyOrder(historicalWarId, unrelatedWarId);
+      assertThat(reparations.getReparation(paidDebtId).orElseThrow().paidAmount())
+          .isEqualByComparingTo("1000");
+      assertThat(reparations.pendingSettlementRecovery()).isEmpty();
+      assertThat(receipts()).hasSize(16);
+    }
