+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void missingOrConflictingAdmissionReadbackNeverRemovesTheDirectory(boolean sql) throws Exception {
+    var f = fixture();
+    try (var first = f.new Session(sql, true)) {
+      doReturn(Optional.empty()).when(first.wars).disbandAdmission(any());
