+          case "role" ->
+              when(service.getAllianceMembers(allianceId))
+                  .thenReturn(
+                      List.of(
+                          new AllianceMember(nationId, AllianceMember.Role.MEMBER, Instant.EPOCH)));
+          case "demotion" -> nation.setMemberRank(playerId, "member");
+          case "permission" ->
+              when(player.hasPermission(NationPermission.ALLY_ADD.getBukkitNode()))
+                  .thenReturn(false);
+          case "shutdown" -> listener.close();
+        }
+        assertThat(active.getValue().getAsBoolean()).as(reason).isFalse();
+        assertThat(nation.hasPermission(playerId, "alliance.manage")).isTrue();
+        submit.getValue().accept("new announcement");
+        save.invoke(listener, player, confirmation, 13);
+        verify(service, never()).setAnnouncement(any(), any(), any());
+        verify(player, never()).openInventory(any(org.bukkit.inventory.Inventory.class));
+        assertThat(guis.constructed()).hasSize(1);
+      }
+    }
+  }
+}
