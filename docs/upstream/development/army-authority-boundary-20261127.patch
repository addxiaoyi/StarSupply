+  private static void requireTreatyBinding(OperationView operation) {
+    if (operation.request().protocolVersion() == TreatyEffectManifest.VERSION
+        && operation.binding() == null)
+      throw new IllegalStateException("Treaty operation must be bound to its exact manifest");
+  }
