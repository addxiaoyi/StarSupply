+  private void handleTreatyRecovery(CommandSender sender, String[] args) {
+    if (!sender.hasPermission(PERMISSION_ADMIN)) {
+      sender.sendMessage(Component.text("需要 starcore.war.admin 权限。", NamedTextColor.RED));
+      return;
+    }
+    if (args.length < 2) {
+      showTreatyRecoveryHelp(sender);
+      return;
+    }
+    String action = args[1].toLowerCase(Locale.ROOT);
+    if (!(action.equals("list") && (args.length == 2 || args.length == 3))
+        && !(Set.of("show", "retry", "cancel").contains(action) && args.length == 3)) {
+      showTreatyRecoveryHelp(sender);
+      return;
+    }
+    UUID treatyId = action.equals("list") ? null : fullTreatyId(args[2]);
+    int page = 1;
+    if (action.equals("list") && args.length == 3) {
+      try {
+        page = Integer.parseInt(args[2]);
+      } catch (NumberFormatException invalidPage) {
+        throw new IllegalArgumentException("Page must be a positive whole number.");
+      }
+      if (page < 1) throw new IllegalArgumentException("Page must be a positive whole number.");
+    }
+    PeaceTreatyService service =
+        peaceTreatyResolver
+            .get()
+            .orElseThrow(() -> new IllegalStateException("Peace treaty service is unavailable."));
+    if (action.equals("list")) {
+      List<UUID> pending = service.pendingTreatyExecutions().stream().distinct().sorted().toList();
+      int pages = Math.max(1, (pending.size() + 9) / 10);
+      if (page > pages) throw new IllegalArgumentException("Treaty recovery page is out of range.");
+      sender.sendMessage(
+          Component.text(
+              "Pending/review treaties: " + pending.size() + " | Page " + page + "/" + pages,
+              NamedTextColor.YELLOW));
+      int from = (page - 1) * 10;
+      for (UUID id : pending.subList(from, Math.min(from + 10, pending.size()))) {
+        var operation = service.getTreatyOperation(id);
+        if (operation.isPresent()) showTreatyOperation(sender, id, operation.orElseThrow());
+      }
+      return;
+    }
+    PeaceTreatyService.TreatyOperation operation;
+    switch (action) {
+      case "retry" -> operation = service.recoverTreatyExecution(treatyId);
+      case "cancel" -> {
+        service.cancelTreatyExecution(treatyId);
+        operation =
+            service
+                .getTreatyOperation(treatyId)
+                .orElseThrow(() -> new IllegalArgumentException("Treaty execution not found."));
+      }
+      default ->
+          operation =
+              service
+                  .getTreatyOperation(treatyId)
+                  .orElseThrow(() -> new IllegalArgumentException("Treaty execution not found."));
+    }
+    showTreatyOperation(sender, treatyId, operation);
+  }
+
+  private static UUID fullTreatyId(String value) {
+    try {
+      UUID id = UUID.fromString(value);
+      if (!id.toString().equalsIgnoreCase(value)) throw new IllegalArgumentException();
+      return id;
+    } catch (IllegalArgumentException invalid) {
+      throw new IllegalArgumentException("Use the full treaty UUID, not a prefix or operation ID.");
+    }
+  }
+
+  private void showTreatyOperation(
+      CommandSender sender, UUID treatyId, PeaceTreatyService.TreatyOperation operation) {
+    sender.sendMessage(Component.text("Treaty ID: " + treatyId, NamedTextColor.GOLD));
+    sender.sendMessage(
+        Component.text(
+            "Operation ID: "
+                + Objects.toString(operation.operationId(), "unprepared")
+                + " | Phase: "
+                + operation.phase(),
+            NamedTextColor.GRAY));
+    sender.sendMessage(
+        Component.text(
+            "Plan hash: "
+                + (operation.planHash() == null || operation.planHash().isEmpty()
+                    ? "unreserved"
+                    : operation.planHash()),
+            NamedTextColor.GRAY));
+    if (operation.protocolVersion() == 2) {
+      sender.sendMessage(
+          Component.text(
+              "Protocol: 2 | Request hash: " + operation.requestDigest(), NamedTextColor.GRAY));
+      sender.sendMessage(
+          Component.text(
+              "Manifest hash: "
+                  + (operation.manifestHash().isEmpty() ? "unbound" : operation.manifestHash()),
+              NamedTextColor.GRAY));
+    }
+    sender.sendMessage(
+        Component.text(
+            "Review reason: "
+                + Objects.toString(operation.reviewReason(), "none")
+                + " | Recovery pending: "
+                + operation.recoveryPending(),
+            operation.reviewReason() == null ? NamedTextColor.GRAY : NamedTextColor.YELLOW));
+  }
+
+  private void showTreatyRecoveryHelp(CommandSender sender) {
+    sender.sendMessage(
+        Component.text(
+            "/war treatyrecovery list [page] | show <full-treaty-UUID> | retry <full-treaty-UUID> |"
+                + " cancel <full-treaty-UUID>",
+            NamedTextColor.YELLOW));
+  }
