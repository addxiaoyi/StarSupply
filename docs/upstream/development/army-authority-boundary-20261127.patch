--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/module/diplomacy/DiplomacyTreatyOperationService.java
@@ -0,0 +1,363 @@
+package dev.starcore.starcore.module.diplomacy;
+
+import dev.starcore.starcore.module.nation.model.NationId;
+import dev.starcore.starcore.module.war.WarSettlementAdmissionService.Request;
+import dev.starcore.starcore.module.war.WarSettlementEffectProofReader;
+import dev.starcore.starcore.treaty.TreatyEffectManifest;
+import dev.starcore.starcore.treaty.TreatyEffectManifest.Envelope;
+import java.time.Instant;
+import java.util.Comparator;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Objects;
+import java.util.Optional;
+import java.util.Set;
+import java.util.UUID;
+
+public interface DiplomacyTreatyOperationService extends WarSettlementEffectProofReader {
+  int MAX_TERMS = 32;
+  int MAX_PAIRS = 4096;
+  Set<String> POLITICAL_REQUIREMENTS =
+      Set.of("vassal", "regime_change", "neutrality", "no_war", "embargo");
+
+  enum Status {
+    RESERVED,
+    APPLIED,
+    CANCELLED,
+    SUPERSEDED,
+    REJECTED
+  }
+
+  record ExactWar(
+      UUID warId,
+      NationId attacker,
+      NationId defender,
+      Instant declaredAt,
+      List<NationId> attackerAllies,
+      List<NationId> defenderAllies) {
+    public ExactWar {
+      Objects.requireNonNull(warId);
+      Objects.requireNonNull(attacker);
+      Objects.requireNonNull(defender);
+      Objects.requireNonNull(declaredAt);
+      attackerAllies = canonicalNations(attackerAllies);
+      defenderAllies = canonicalNations(defenderAllies);
+      var sides = new HashSet<NationId>();
+      sides.add(attacker);
+      if (attacker.equals(defender)
+          || attackerAllies.contains(attacker)
+          || defenderAllies.contains(defender))
+        throw new IllegalArgumentException("Invalid exact war participants");
+      sides.addAll(attackerAllies);
+      if (!sides.add(defender) || defenderAllies.stream().anyMatch(sides::contains))
+        throw new IllegalArgumentException("Overlapping exact war sides");
+      if (sides.size() + defenderAllies.size() > 90)
+        throw new IllegalArgumentException("Treaty war scope is too large");
+    }
+
+    public List<NationId> participants() {
+      var result = new java.util.ArrayList<NationId>();
+      result.add(attacker);
+      result.add(defender);
+      result.addAll(attackerAllies);
+      result.addAll(defenderAllies);
+      return canonicalNations(result);
+    }
+
+    public boolean opposing(NationId left, NationId right) {
+      boolean leftAttacker = left.equals(attacker) || attackerAllies.contains(left);
+      boolean leftDefender = left.equals(defender) || defenderAllies.contains(left);
+      boolean rightAttacker = right.equals(attacker) || attackerAllies.contains(right);
+      boolean rightDefender = right.equals(defender) || defenderAllies.contains(right);
+      return leftAttacker && rightDefender || leftDefender && rightAttacker;
+    }
+  }
+
+  record PairScope(NationId left, NationId right) {
+    public PairScope {
+      Objects.requireNonNull(left);
+      Objects.requireNonNull(right);
+      if (left.toString().compareTo(right.toString()) >= 0)
+        throw new IllegalArgumentException("Treaty pair must be distinct and ordered");
+    }
+
+    public static PairScope of(NationId left, NationId right) {
+      return left.toString().compareTo(right.toString()) < 0
+          ? new PairScope(left, right)
+          : new PairScope(right, left);
+    }
+  }
+
+  record IndexedTerm(int termIndex, String type, String requirement, String description) {
+    public IndexedTerm {
+      Objects.requireNonNull(type);
+      Objects.requireNonNull(requirement);
+      Objects.requireNonNull(description);
+      if (termIndex < 0
+          || type.length() > 128
+          || requirement.length() > 128
+          || description.length() > 8192)
+        throw new IllegalArgumentException("Invalid indexed treaty term");
+    }
+  }
+
+  record ReserveRequest(
+      UUID operationId,
+      UUID treatyId,
+      ExactWar war,
+      long warGeneration,
+      String warFingerprint,
+      NationId victor,
+      NationId defeated,
+      Instant preparedAt,
+      int originalTermCount,
+      List<IndexedTerm> terms,
+      int protocolVersion,
+      Envelope envelope,
+      List<Integer> assignedTermIndexes) {
+    public ReserveRequest(
+        UUID operationId,
+        UUID treatyId,
+        ExactWar war,
+        long warGeneration,
+        String warFingerprint,
+        NationId victor,
+        NationId defeated,
+        Instant preparedAt,
+        int originalTermCount,
+        List<IndexedTerm> terms) {
+      this(
+          operationId,
+          treatyId,
+          war,
+          warGeneration,
+          warFingerprint,
+          victor,
+          defeated,
+          preparedAt,
+          originalTermCount,
+          terms,
+          1,
+          null,
+          java.util.stream.IntStream.range(0, originalTermCount).boxed().toList());
+    }
+
+    public ReserveRequest {
+      Objects.requireNonNull(operationId);
+      Objects.requireNonNull(treatyId);
+      Objects.requireNonNull(war);
+      Objects.requireNonNull(warFingerprint);
+      Objects.requireNonNull(victor);
+      Objects.requireNonNull(defeated);
+      Objects.requireNonNull(preparedAt);
+      terms = List.copyOf(terms);
+      assignedTermIndexes = List.copyOf(assignedTermIndexes).stream().sorted().toList();
+      if (warGeneration < 0
+          || warFingerprint.isBlank()
+          || warFingerprint.length() > 256
+          || originalTermCount < 0
+          || originalTermCount > MAX_TERMS
+          || !war.opposing(victor, defeated)
+          || assignedTermIndexes.size() != terms.size()
+          || new HashSet<>(assignedTermIndexes).size() != assignedTermIndexes.size()
+          || assignedTermIndexes.stream()
+              .anyMatch(index -> index < 0 || index >= originalTermCount))
+        throw new IllegalArgumentException("Invalid treaty request");
+      var indexes = new HashSet<Integer>();
+      for (var term : terms)
+        if (term.termIndex() >= originalTermCount || !indexes.add(term.termIndex()))
+          throw new IllegalArgumentException("Incomplete original treaty term manifest");
+      terms = terms.stream().sorted(Comparator.comparingInt(IndexedTerm::termIndex)).toList();
+      if (!terms.stream().map(IndexedTerm::termIndex).toList().equals(assignedTermIndexes))
+        throw new IllegalArgumentException("Treaty terms do not match receiver assignment");
+      if (protocolVersion == 1) {
+        if (envelope != null || originalTermCount != terms.size())
+          throw new IllegalArgumentException("Invalid legacy treaty request");
+      } else if (protocolVersion == TreatyEffectManifest.VERSION) {
+        if (envelope == null
+            || !operationId.equals(envelope.operationId())
+            || !treatyId.equals(envelope.treatyId())
+            || !war.equals(envelope.war())
+            || warGeneration != envelope.warGeneration()
+            || !warFingerprint.equals(envelope.warFingerprint())
+            || !victor.equals(envelope.victor())
+            || !defeated.equals(envelope.defeated())
+            || !preparedAt.equals(envelope.preparedAt())
+            || originalTermCount != envelope.originalTerms().size())
+          throw new IllegalArgumentException("Treaty request differs from original envelope");
+        for (var term : terms) {
+          var original = envelope.originalTerms().get(term.termIndex());
+          if (!original.type().equals("PoliticalTerm")
+              || !term.type().equals(original.type())
+              || !List.of(term.requirement()).equals(original.payload())
+              || !term.description().equals(original.description()))
+            throw new IllegalArgumentException("Treaty receiver lost an exact original term");
+        }
+      } else {
+        throw new IllegalArgumentException("Unsupported treaty protocol version");
+      }
+    }
+  }
+
+  record PairPlan(
+      PairScope pair,
+      DiplomacyRelation expectedRelation,
+      long expectedGeneration,
+      DiplomacyRelation targetRelation) {
+    public PairPlan {
+      Objects.requireNonNull(pair);
+      Objects.requireNonNull(expectedRelation);
+      Objects.requireNonNull(targetRelation);
+      if (expectedGeneration < 0 || targetRelation == DiplomacyRelation.WAR)
+        throw new IllegalArgumentException("Invalid treaty pair plan");
+    }
+  }
+
+  record TermPlan(
+      int termIndex,
+      UUID restrictionId,
+      Instant imposedAt,
+      String requirement,
+      String description,
+      NationId nationId) {
+    public TermPlan {
+      Objects.requireNonNull(restrictionId);
+      Objects.requireNonNull(imposedAt);
+      Objects.requireNonNull(requirement);
+      Objects.requireNonNull(description);
+      Objects.requireNonNull(nationId);
+      if (termIndex < 0 || !POLITICAL_REQUIREMENTS.contains(requirement))
+        throw new IllegalArgumentException("Invalid treaty restriction plan");
+    }
+  }
+
+  record Plan(ReserveRequest request, List<PairPlan> pairs, List<TermPlan> terms, String planHash) {
+    public Plan {
+      Objects.requireNonNull(request);
+      pairs = List.copyOf(pairs);
+      terms = List.copyOf(terms);
+      Objects.requireNonNull(planHash);
+      if (pairs.isEmpty()
+          || pairs.size() > MAX_PAIRS
+          || terms.size() != request.terms().size()
+          || pairs.stream().map(PairPlan::pair).distinct().count() != pairs.size()
+          || !planHash.matches("[0-9a-f]{64}"))
+        throw new IllegalArgumentException("Invalid frozen treaty plan");
+    }
+  }
+
+  record OperationView(
+      ReserveRequest request,
+      Plan plan,
+      Status status,
+      Instant terminalAt,
+      Request binding,
+      TerminalEvidence terminalEvidence) {
+    public OperationView(ReserveRequest request, Plan plan, Status status, Instant terminalAt) {
+      this(request, plan, status, terminalAt, null, null);
+    }
+
+    public OperationView {
+      Objects.requireNonNull(request);
+      Objects.requireNonNull(status);
+      if (plan != null && !request.equals(plan.request())
+          || (status == Status.RESERVED || status == Status.APPLIED) && plan == null
+          || (status == Status.RESERVED) != (terminalAt == null))
+        throw new IllegalArgumentException("Invalid treaty operation view");
+      if (request.protocolVersion() == 1) {
+        if (binding != null || terminalEvidence != null)
+          throw new IllegalArgumentException("Legacy treaty cannot carry v2 binding evidence");
+      } else if (binding == null) {
+        if (terminalEvidence != null || status == Status.APPLIED || status == Status.CANCELLED)
+          throw new IllegalArgumentException("Unbound treaty cannot authorize an effect outcome");
+      } else {
+        if (binding.protocolVersion() != TreatyEffectManifest.VERSION || binding.manifest() == null)
+          throw new IllegalArgumentException("Treaty binding requires explicit v2 manifest");
+        TreatyEffectManifest.requireSupported(binding.manifest());
+        var entry = binding.manifest().entries().getFirst();
+        if (plan == null
+            || !binding.manifest().envelope().equals(request.envelope())
+            || !entry.assignedTermIndexes().equals(request.assignedTermIndexes())
+            || !entry.localPlanHash().equals(plan.planHash())
+            || !entry.scopes().equals(plan.pairs().stream().map(PairPlan::pair).toList())
+            || status == Status.REJECTED)
+          throw new IllegalArgumentException("Treaty binding differs from frozen receiver plan");
+        new EffectProof(binding, entry, phase(status), terminalAt, terminalEvidence);
+      }
+    }
+
+    public String planHash() {
+      return plan == null ? "" : plan.planHash();
+    }
+
+    public boolean terminal() {
+      return status != Status.RESERVED;
+    }
+
+    public Optional<EffectProof> effectProof() {
+      return binding == null
+          ? Optional.empty()
+          : Optional.of(
+              new EffectProof(
+                  binding,
+                  binding.manifest().entries().getFirst(),
+                  phase(status),
+                  terminalAt,
+                  terminalEvidence));
+    }
+
+    public OperationView superseded(Instant at) {
+      return new OperationView(
+          request,
+          plan,
+          Status.SUPERSEDED,
+          at,
+          binding,
+          binding == null
+              ? null
+              : new TerminalEvidence(TerminalBasis.LOCAL_SUPERSEDED, null, null));
+    }
+
+    private static Phase phase(Status status) {
+      return switch (status) {
+        case RESERVED -> Phase.BOUND;
+        case APPLIED -> Phase.APPLIED;
+        case CANCELLED -> Phase.CANCELLED;
+        case SUPERSEDED -> Phase.SUPERSEDED;
+        case REJECTED -> throw new IllegalArgumentException("Rejected treaty has no effect proof");
+      };
+    }
+  }
+
+  OperationView reserveTreaty(ReserveRequest request);
+
+  Optional<OperationView> treatyOperation(UUID operationId);
+
+  OperationView applyTreaty(UUID operationId, String planHash);
+
+  OperationView cancelTreaty(ReserveRequest request);
+
+  default OperationView bindManifest(UUID operationId, String localPlanHash, Request binding) {
+    throw new UnsupportedOperationException("Treaty manifest binding is unavailable");
+  }
+
+  default void requireEffectProofPersistence() {
+    throw new UnsupportedOperationException("Treaty effect proof persistence is unavailable");
+  }
+
+  @Override
+  default Optional<EffectProof> settlementEffect(
+      String receiverId, int receiverVersion, UUID operationId) {
+    Objects.requireNonNull(operationId);
+    if (!TreatyEffectManifest.DIPLOMACY.equals(receiverId)
+        || receiverVersion != TreatyEffectManifest.VERSION) return Optional.empty();
+    return treatyOperation(operationId).flatMap(OperationView::effectProof);
+  }
+
+  private static List<NationId> canonicalNations(List<NationId> nations) {
+    return List.copyOf(nations).stream()
+        .distinct()
+        .sorted(Comparator.comparing(NationId::toString))
+        .toList();
+  }
+}
diff --git a/src/main/java/dev/starcore/starcore/module/diplomacy/DiplomacyTreatyOperationState.java b/src/main/java/dev/starcore/starcore/module/diplomacy/DiplomacyTreatyOperationState.java
new file mode 100644
index 0000000000000000000000000000000000000000..1cb142866679d52eeff8834e947ce5cefac37388
--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/module/diplomacy/DiplomacyTreatyOperationState.java
@@ -0,0 +1,473 @@
+package dev.starcore.starcore.module.diplomacy;
+
+import dev.starcore.starcore.module.diplomacy.DiplomacyTreatyOperationService.*;
+import dev.starcore.starcore.module.nation.model.NationId;
+import java.time.Instant;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.Objects;
+import java.util.Properties;
+import java.util.UUID;
+
+record DiplomacyTreatyOperationState(
+    Map<UUID, OperationView> operations,
+    Map<UUID, ReleaseProof> proofs,
+    Map<DiplomacyPairKey, Owner> owners) {
+  static final String PREFIX = "treatyOperation.";
+
+  record ReleaseProof(
+      UUID operationId,
+      String planHash,
+      UUID warId,
+      long fromGeneration,
+      long toGeneration,
+      long sourceRevision,
+      int protocolVersion,
+      String globalManifestHash) {
+    ReleaseProof(
+        UUID operationId,
+        String planHash,
+        UUID warId,
+        long fromGeneration,
+        long toGeneration,
+        long sourceRevision) {
+      this(operationId, planHash, warId, fromGeneration, toGeneration, sourceRevision, 1, null);
+    }
+
+    ReleaseProof {
+      Objects.requireNonNull(operationId);
+      Objects.requireNonNull(planHash);
+      Objects.requireNonNull(warId);
+      if (fromGeneration < 0
+          || toGeneration != Math.addExact(fromGeneration, 1)
+          || sourceRevision < 0)
+        throw new IllegalArgumentException("Invalid local treaty release proof");
+      if (protocolVersion == 1) {
+        if (globalManifestHash != null)
+          throw new IllegalArgumentException("Legacy treaty release cannot carry a manifest hash");
+      } else if (protocolVersion != 2
+          || globalManifestHash == null
+          || !globalManifestHash.matches("[0-9a-f]{64}")) {
+        throw new IllegalArgumentException("Invalid versioned local treaty release proof");
+      }
+    }
+  }
+
+  record Owner(UUID operationId, long generation) {
+    Owner {
+      Objects.requireNonNull(operationId);
+      if (generation < 1) throw new IllegalArgumentException("Invalid treaty owner generation");
+    }
+  }
+
+  DiplomacyTreatyOperationState {
+    operations = Map.copyOf(operations);
+    proofs = Map.copyOf(proofs);
+    owners = Map.copyOf(owners);
+  }
+
+  static DiplomacyTreatyOperationState empty() {
+    return new DiplomacyTreatyOperationState(Map.of(), Map.of(), Map.of());
+  }
+
+  DiplomacyTreatyOperationState record(OperationView view) {
+    var next = new HashMap<>(operations);
+    var old = next.put(view.request().operationId(), view);
+    validateOperationTransition(old, view, true);
+    return new DiplomacyTreatyOperationState(next, proofs, owners);
+  }
+
+  DiplomacyTreatyOperationState releaseProof(ReleaseProof proof) {
+    var operation = operations.get(proof.operationId());
+    if (operation == null
+        || operation.status() != Status.RESERVED
+        || !operation.planHash().equals(proof.planHash())
+        || !operation.request().war().warId().equals(proof.warId())
+        || !matchesProofVersion(operation, proof))
+      throw new IllegalArgumentException("Local release proof does not match a pending treaty");
+    var next = new HashMap<>(proofs);
+    var old = next.putIfAbsent(proof.operationId(), proof);
+    if (old != null && !old.equals(proof))
+      throw new IllegalArgumentException("Local treaty release proof changed");
+    return new DiplomacyTreatyOperationState(operations, next, owners);
+  }
+
+  DiplomacyTreatyOperationState own(DiplomacyPairKey pair, UUID operationId, long generation) {
+    var next = new HashMap<>(owners);
+    next.put(pair, new Owner(operationId, generation));
+    return new DiplomacyTreatyOperationState(operations, proofs, next);
+  }
+
+  DiplomacyTreatyOperationState supersedeNation(NationId nation) {
+    var result = this;
+    for (var operation : operations.values())
+      if (operation.status() == Status.RESERVED
+          && operation.plan().pairs().stream()
+              .anyMatch(
+                  pair -> pair.pair().left().equals(nation) || pair.pair().right().equals(nation)))
+        result = result.record(operation.superseded(Instant.now()));
+    var nextOwners = new HashMap<>(result.owners);
+    nextOwners.keySet().removeIf(pair -> pair.contains(nation));
+    return new DiplomacyTreatyOperationState(result.operations, result.proofs, nextOwners);
+  }
+
+  Properties write(Properties properties) {
+    var result = DiplomacyAuthority.copy(properties);
+    result.keySet().removeIf(key -> key instanceof String text && text.startsWith(PREFIX));
+    result.setProperty(PREFIX + "version", "1");
+    operations.forEach(
+        (id, view) ->
+            result.setProperty(
+                PREFIX + "operation." + id, DiplomacyTreatyOperationCodec.encode(view)));
+    proofs.forEach(
+        (id, proof) ->
+            result.setProperty(
+                PREFIX + "proof." + id,
+                (proof.protocolVersion() == 1 ? "" : "2|" + proof.globalManifestHash() + "|")
+                    + proof.planHash()
+                    + "|"
+                    + proof.warId()
+                    + "|"
+                    + proof.fromGeneration()
+                    + "|"
+                    + proof.toGeneration()
+                    + "|"
+                    + proof.sourceRevision()));
+    owners.forEach(
+        (pair, owner) ->
+            result.setProperty(
+                PREFIX + "owner." + pair.left() + "." + pair.right(),
+                owner.operationId() + "|" + owner.generation()));
+    return result;
+  }
+
+  static DiplomacyTreatyOperationState read(Properties properties) {
+    var keys =
+        properties.stringPropertyNames().stream().filter(key -> key.startsWith(PREFIX)).toList();
+    if (keys.isEmpty()) return empty();
+    if (!"1".equals(properties.getProperty(PREFIX + "version")))
+      throw new IllegalArgumentException("Invalid treaty operation schema");
+    var operations = new HashMap<UUID, OperationView>();
+    var proofs = new HashMap<UUID, ReleaseProof>();
+    var owners = new HashMap<DiplomacyPairKey, Owner>();
+    for (var key : keys) {
+      String suffix = key.substring(PREFIX.length());
+      String value = properties.getProperty(key);
+      if (suffix.startsWith("operation.")) {
+        UUID id = UUID.fromString(suffix.substring("operation.".length()));
+        var view = DiplomacyTreatyOperationCodec.decode(value);
+        if (!id.equals(view.request().operationId()))
+          throw new IllegalArgumentException("Treaty operation id mismatch");
+        operations.put(id, view);
+      } else if (suffix.startsWith("proof.")) {
+        UUID id = UUID.fromString(suffix.substring("proof.".length()));
+        var fields = value.split("\\|", -1);
+        int offset;
+        int protocolVersion;
+        String globalManifestHash;
+        if (fields.length == 5) {
+          offset = 0;
+          protocolVersion = 1;
+          globalManifestHash = null;
+        } else if (fields.length == 7 && fields[0].equals("2")) {
+          offset = 2;
+          protocolVersion = 2;
+          globalManifestHash = fields[1];
+        } else {
+          throw new IllegalArgumentException("Invalid local release proof");
+        }
+        proofs.put(
+            id,
+            new ReleaseProof(
+                id,
+                fields[offset],
+                UUID.fromString(fields[offset + 1]),
+                Long.parseLong(fields[offset + 2]),
+                Long.parseLong(fields[offset + 3]),
+                Long.parseLong(fields[offset + 4]),
+                protocolVersion,
+                globalManifestHash));
+      } else if (suffix.startsWith("owner.")) {
+        var endpoints = suffix.substring("owner.".length()).split("\\.", -1);
+        var fields = value.split("\\|", -1);
+        if (endpoints.length != 2 || fields.length != 2)
+          throw new IllegalArgumentException("Invalid treaty projection owner");
+        var pair =
+            DiplomacyPairKey.of(
+                NationId.of(UUID.fromString(endpoints[0])),
+                NationId.of(UUID.fromString(endpoints[1])));
+        if (!(pair.left() + "." + pair.right()).equals(suffix.substring("owner.".length())))
+          throw new IllegalArgumentException("Noncanonical treaty owner pair");
+        owners.put(pair, new Owner(UUID.fromString(fields[0]), Long.parseLong(fields[1])));
+      } else if (!suffix.equals("version")) {
+        throw new IllegalArgumentException("Unknown treaty operation property");
+      }
+    }
+    var result = new DiplomacyTreatyOperationState(operations, proofs, owners);
+    var canonical = result.write(new Properties());
+    if (canonical.size() != keys.size()
+        || keys.stream()
+            .anyMatch(
+                key -> !Objects.equals(properties.getProperty(key), canonical.getProperty(key))))
+      throw new IllegalArgumentException("Noncanonical treaty operation metadata");
+    return result;
+  }
+
+  static void validate(Properties properties) {
+    var state = read(properties);
+    var generations = DiplomacyAllianceOperationState.read(properties);
+    var retired = DiplomacyAuthority.receipts(properties);
+    var relations = DiplomacyStateCodec.fromProperties(properties);
+    var times = DiplomacyTemporalStateCodec.relationChangesFromProperties(properties);
+    var mirror = WarDiplomacyMirrorState.read(properties);
+    state
+        .operations
+        .values()
+        .forEach(
+            view -> {
+              if (view.plan() == null) return;
+              var request = view.request();
+              var plan = view.plan();
+              if (!DiplomacyTreatyOperationCodec.hash(request, plan.pairs(), plan.terms())
+                  .equals(plan.planHash()))
+                throw new IllegalArgumentException("Treaty plan hash mismatch");
+              String previousPair = "";
+              for (var pair : plan.pairs()) {
+                String pairKey = pair.pair().left() + ":" + pair.pair().right();
+                if (previousPair.compareTo(pairKey) >= 0)
+                  throw new IllegalArgumentException("Noncanonical treaty plan pair order");
+                previousPair = pairKey;
+              }
+              var participants = request.war().participants();
+              var scopes =
+                  plan.pairs().stream()
+                      .map(PairPlan::pair)
+                      .collect(java.util.stream.Collectors.toSet());
+              for (int leftIndex = 0; leftIndex < participants.size(); leftIndex++)
+                for (int rightIndex = leftIndex + 1; rightIndex < participants.size(); rightIndex++)
+                  if (!scopes.contains(
+                      PairScope.of(participants.get(leftIndex), participants.get(rightIndex))))
+                    throw new IllegalArgumentException("Incomplete original war political scope");
+              for (int index = 0; index < plan.terms().size(); index++) {
+                var term = plan.terms().get(index);
+                var original = request.terms().get(index);
+                var fixedId =
+                    UUID.nameUUIDFromBytes(
+                        (request.operationId() + ":restriction:" + original.termIndex())
+                            .getBytes(java.nio.charset.StandardCharsets.UTF_8));
+                if (!original.type().equals("PoliticalTerm")
+                    || term.termIndex() != original.termIndex()
+                    || !term.restrictionId().equals(fixedId)
+                    || !term.imposedAt().equals(request.preparedAt())
+                    || !term.requirement()
+                        .equals(original.requirement().toLowerCase(java.util.Locale.ROOT))
+                    || !term.description().equals(original.description())
+                    || !term.nationId().equals(request.defeated()))
+                  throw new IllegalArgumentException("Treaty plan lost an original term identity");
+              }
+              if (view.status() == Status.APPLIED) {
+                var proof = state.proofs.get(request.operationId());
+                if (proof == null)
+                  throw new IllegalArgumentException("Applied treaty lacks exact release proof");
+                var principal = PairScope.of(request.war().attacker(), request.war().defender());
+                for (var pair : plan.pairs()) {
+                  long appliedGeneration =
+                      Math.addExact(
+                          pair.expectedGeneration(), pair.pair().equals(principal) ? 2 : 1);
+                  if (generations.generation(
+                          DiplomacyPairKey.of(pair.pair().left(), pair.pair().right()))
+                      < appliedGeneration)
+                    throw new IllegalArgumentException("Missing applied treaty generation history");
+                }
+              }
+            });
+    state.proofs.forEach(
+        (id, proof) -> {
+          var view = state.operations.get(id);
+          if (view == null
+              || view.plan() == null
+              || !proof.planHash().equals(view.planHash())
+              || !proof.warId().equals(view.request().war().warId())
+              || !matchesProofVersion(view, proof)
+              || mirror.revision() < proof.sourceRevision()
+              || !exactEntry(view.request().war(), mirror.receipts().get(proof.warId()))
+              || mirror.receipts().get(proof.warId()).active())
+            throw new IllegalArgumentException("Orphan treaty release proof");
+        });
+    state.owners.forEach(
+        (pair, owner) -> {
+          var view = state.operations.get(owner.operationId());
+          var planned =
+              view == null || view.plan() == null
+                  ? null
+                  : view.plan().pairs().stream()
+                      .filter(
+                          item ->
+                              item.pair().left().equals(pair.left())
+                                  && item.pair().right().equals(pair.right()))
+                      .findFirst()
+                      .orElse(null);
+          if (view == null
+              || view.status() != Status.APPLIED
+              || planned == null
+              || retired.containsKey(pair.left())
+              || retired.containsKey(pair.right())
+              || mirror.owners().containsKey(pair)
+              || generations.generation(pair) != owner.generation()
+              || relations.getOrDefault(pair, DiplomacyRelation.NEUTRAL) != planned.targetRelation()
+              || !view.request().preparedAt().equals(times.get(pair)))
+            throw new IllegalArgumentException("Superseded treaty projection owner");
+        });
+    DiplomacyTreatyCapacity.require(properties, state);
+  }
+
+  static Properties fenceChanges(Properties previous, Properties next) {
+    var after = read(next);
+    var generations = DiplomacyAllianceOperationState.read(next);
+    var retired = DiplomacyAuthority.receipts(next);
+    var nextOperations = new HashMap<>(after.operations);
+    for (var operation : after.operations.values()) {
+      if (operation.status() != Status.RESERVED) continue;
+      var principal =
+          PairScope.of(operation.request().war().attacker(), operation.request().war().defender());
+      var proof = after.proofs.get(operation.request().operationId());
+      boolean invalid =
+          operation.plan().pairs().stream()
+              .anyMatch(
+                  item -> {
+                    var pair = DiplomacyPairKey.of(item.pair().left(), item.pair().right());
+                    long expected = item.expectedGeneration();
+                    if (proof != null
+                        && item.pair().equals(principal)
+                        && proof.fromGeneration() == expected) expected = proof.toGeneration();
+                    return generations.generation(pair) != expected
+                        || retired.containsKey(pair.left())
+                        || retired.containsKey(pair.right());
+                  });
+      if (invalid)
+        nextOperations.put(operation.request().operationId(), operation.superseded(Instant.now()));
+    }
+    var nextOwners = new HashMap<>(after.owners);
+    nextOwners
+        .entrySet()
+        .removeIf(
+            entry ->
+                generations.generation(entry.getKey()) != entry.getValue().generation()
+                    || retired.containsKey(entry.getKey().left())
+                    || retired.containsKey(entry.getKey().right()));
+    return new DiplomacyTreatyOperationState(nextOperations, after.proofs, nextOwners).write(next);
+  }
+
+  static void transition(
+      DiplomacyTreatyOperationState before, DiplomacyTreatyOperationState after) {
+    before.operations.forEach(
+        (id, old) -> {
+          var next = after.operations.get(id);
+          if (next == null)
+            throw new IllegalArgumentException("Treaty operation payload or receipt is immutable");
+          validateOperationTransition(old, next, false);
+        });
+    after.operations.forEach(
+        (id, next) -> {
+          if (!before.operations.containsKey(id)) validateOperationTransition(null, next, false);
+        });
+    before.proofs.forEach(
+        (id, proof) -> {
+          if (!proof.equals(after.proofs.get(id)))
+            throw new IllegalArgumentException("Local treaty release proof is immutable");
+        });
+    after.proofs.forEach(
+        (id, proof) -> {
+          if (!before.proofs.containsKey(id)) {
+            var old = before.operations.get(id);
+            if (old != null && old.status() != Status.RESERVED)
+              throw new IllegalArgumentException("Cannot release a superseded treaty");
+          }
+        });
+    after.owners.forEach(
+        (pair, owner) -> {
+          if (!owner.equals(before.owners.get(pair))
+              && before.operations.containsKey(owner.operationId())
+              && before.operations.get(owner.operationId()).terminal())
+            throw new IllegalArgumentException("Treaty projection cannot be reacquired");
+        });
+  }
+
+  static void validateCommitTransitions(Properties previous, Properties next) {
+    var before = read(previous);
+    var after = read(next);
+    after.operations.forEach(
+        (id, operation) -> validateOperationTransition(before.operations.get(id), operation, true));
+    validateProofTransitions(previous, next);
+  }
+
+  static void validateProofTransitions(Properties previous, Properties next) {
+    var before = read(previous);
+    var after = read(next);
+    var oldMirror = WarDiplomacyMirrorState.read(previous);
+    var newMirror = WarDiplomacyMirrorState.read(next);
+    var oldGenerations = DiplomacyAllianceOperationState.read(previous);
+    var newGenerations = DiplomacyAllianceOperationState.read(next);
+    after.proofs.forEach(
+        (id, proof) -> {
+          if (before.proofs.containsKey(id)) return;
+          var operation = before.operations.get(id);
+          if (operation == null || operation.status() != Status.RESERVED)
+            throw new IllegalArgumentException(
+                "Release proof requires an existing reserved treaty");
+          if (!matchesProofVersion(operation, proof))
+            throw new IllegalArgumentException("Release proof requires an existing exact binding");
+          var war = operation.request().war();
+          var pair = DiplomacyPairKey.of(war.attacker(), war.defender());
+          var oldEntry = oldMirror.receipts().get(war.warId());
+          var newEntry = newMirror.receipts().get(war.warId());
+          if (!war.warId().equals(oldMirror.owners().get(pair))
+              || oldEntry == null
+              || !oldEntry.active()
+              || newEntry == null
+              || newEntry.active()
+              || !exactEntry(war, oldEntry)
+              || !exactEntry(war, newEntry)
+              || newMirror.owners().containsKey(pair)
+              || proof.fromGeneration() != oldGenerations.generation(pair)
+              || proof.toGeneration() != newGenerations.generation(pair)
+              || proof.sourceRevision() != newMirror.revision())
+            throw new IllegalArgumentException("Unproven exact original war release");
+        });
+  }
+
+  static boolean exactEntry(ExactWar war, WarDiplomacyMirrorService.WarEntry entry) {
+    return entry != null
+        && war.warId().equals(entry.warId())
+        && war.attacker().equals(entry.aggressor())
+        && war.defender().equals(entry.defender())
+        && war.declaredAt().equals(entry.declaredAt());
+  }
+
+  private static boolean matchesProofVersion(OperationView operation, ReleaseProof proof) {
+    return operation.request().protocolVersion() == proof.protocolVersion()
+        && (proof.protocolVersion() == 1
+            || operation.binding() != null
+                && operation.binding().planHash().equals(proof.globalManifestHash()));
+  }
+
+  private static void validateOperationTransition(
+      OperationView old, OperationView next, boolean commit) {
+    if (old == null) {
+      if (commit && next.binding() != null)
+        throw new IllegalArgumentException(
+            "Treaty binding requires an existing reserved operation");
+      return;
+    }
+    if (!old.request().equals(next.request())
+        || !Objects.equals(old.plan(), next.plan())
+        || old.terminal() && !old.equals(next)
+        || old.binding() != null && !old.binding().equals(next.binding())
+        || commit
+            && old.binding() == null
+            && next.binding() != null
+            && (old.status() != Status.RESERVED || next.status() != Status.RESERVED))
+      throw new IllegalArgumentException(
+          "Treaty operation payload, binding or receipt is immutable");
+  }
+}
