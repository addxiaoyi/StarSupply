+    ArmySnapshot differentIncarnation = before.withToken(new ArmyToken(ARMY_ID, OTHER_ID, 2));
+    ArmySnapshot differentType =
+        new ArmySnapshot(
+            new ArmyToken(ARMY_ID, INCARNATION, 2),
+            before.nationId(),
+            ArmyType.ARCHER,
+            before.soldiers(),
+            before.health(),
+            before.morale(),
+            before.position(),
+            before.state(),
+            before.supply(),
+            before.supplyConsumptionRemainder(),
+            before.createdAt(),
+            before.lastUpdated());
+    for (ArmySnapshot invalid :
+        new ArmySnapshot[] {differentOwner, differentIncarnation, differentType}) {
+      assertThrows(
+          IllegalArgumentException.class,
+          () ->
+              ArmyAuthorityState.validateObservation(
+                  original, image(2, Map.of(ARMY_ID, invalid), Map.of(), Map.of())));
+    }
+  }
+
+  @Test
+  void deletionCreatesOnePermanentTombstoneAndCannotRestoreTheOldUnit() {
+    ArmyAuthoritySnapshot before = live(1, 1);
+    ArmyTombstone tombstone = tombstone(army(1), 2);
+    ArmyAuthoritySnapshot retired = image(2, Map.of(), Map.of(ARMY_ID, tombstone), Map.of());
+    assertDoesNotThrow(() -> ArmyAuthorityState.validateCommit(before, retired));
+    assertThrows(
+        IllegalArgumentException.class,
+        () -> ArmyAuthorityState.validateCommit(retired, live(3, 3)));
+    assertThrows(
+        IllegalArgumentException.class,
+        () ->
