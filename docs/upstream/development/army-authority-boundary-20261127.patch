+  private OperationView existingTreaty(ReserveRequest request) {
+    var existing = treatyOperations.operations().get(request.operationId());
+    if (existing != null && !existing.request().equals(request))
+      throw new IllegalArgumentException("Treaty operation identity has a conflicting request");
+    return existing;
+  }
