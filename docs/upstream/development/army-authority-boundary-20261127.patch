+  private <T> T mutate(java.util.function.Supplier<T> action) {
+    if (stopped || authorityFailed || mutating)
+      throw new IllegalStateException("Battlefield authority unavailable, stopped or busy");
+    mutating = true;
+    try {
+      if (storage != null && !selection(storage.reloadAuthority()).equals(observedAuthority)) {
