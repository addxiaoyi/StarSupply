+  private Object attempt(DiplomacyModule module, Request request) {
+    try {
+      return module.applyAllianceOperation(request);
+    } catch (RuntimeException failure) {
+      return failure;
+    }
+  }
+
+  static final class BarrierStorage implements DiplomacyStateStorage {
+    final DiplomacyStateStorage delegate;
+    final CountDownLatch ready;
+    final CountDownLatch release;
+    final AtomicBoolean firstSave = new AtomicBoolean(true);
+
+    BarrierStorage(DiplomacyStateStorage delegate, CountDownLatch ready, CountDownLatch release) {
+      this.delegate = delegate;
+      this.ready = ready;
+      this.release = release;
+    }
+
+    public Properties load() {
+      return delegate.load();
+    }
+
+    public void save(Properties properties) {
+      if (firstSave.compareAndSet(true, false)) {
+        ready.countDown();
+        try {
+          if (!release.await(5, TimeUnit.SECONDS))
+            throw new IllegalStateException("Timed out waiting for concurrent receiver");
+        } catch (InterruptedException failure) {
+          Thread.currentThread().interrupt();
+          throw new IllegalStateException(failure);
+        }
+      }
+      delegate.save(properties);
+    }
+  }
