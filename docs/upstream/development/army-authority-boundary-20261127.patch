+    var mutations = new AtomicInteger();
+    var executor = newExecutor(3);
+    doAnswer(
+            invocation -> {
+              try {
+                assertThat(Thread.holdsLock(module)).isFalse();
+              } finally {
+                closeEntered.countDown();
+              }
+              return invocation.callRealMethod();
