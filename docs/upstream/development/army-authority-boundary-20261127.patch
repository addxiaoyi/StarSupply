+                                tx, NationDisbandOperation.State.CLEANUP_PENDING)))))
+        .isInstanceOf(IllegalStateException.class);
+    assertThat(store.load()).isEqualTo(before);
+    var intent = new NationDisbandOperation(tx, NationDisbandOperation.State.ADMISSION_PENDING);
+    store.save(
+        NationStateCodec.toProperties(
+            List.of(root, child, kept),
+            Map.of(),
+            Map.of(),
+            Map.of(),
+            Map.of(tx.transactionId(), intent)));
+    var pending = store.load();
+    var proof = admissionStore.prepareDisband(NationDisbandOperation.request(tx));
+    assertThatThrownBy(
+            () ->
+                store.save(
+                    NationStateCodec.toProperties(
+                        List.of(kept),
+                        Map.of(),
+                        Map.of(),
+                        Map.of(),
+                        Map.of(
+                            tx.transactionId(),
+                            new NationDisbandOperation(
