+++ b/src/test/java/dev/starcore/starcore/module/army/authority/ArmyAuthorityOwnerStorageTest.java
@@ -0,0 +1,303 @@
+package dev.starcore.starcore.module.army.authority;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+import dev.starcore.starcore.module.army.model.ArmyState;
+import dev.starcore.starcore.module.army.model.ArmyType;
+import dev.starcore.starcore.module.army.model.authority.ArmyLogisticsReceipt;
+import dev.starcore.starcore.module.army.model.authority.ArmyPosition;
+import dev.starcore.starcore.module.army.model.authority.ArmySnapshot;
+import dev.starcore.starcore.module.army.model.authority.ArmyToken;
+import dev.starcore.starcore.module.army.storage.authority.ArmyAuthorityBootstrap;
+import dev.starcore.starcore.module.army.storage.authority.ArmyAuthorityStorage;
+import dev.starcore.starcore.module.army.storage.authority.ArmyFileAuthorityStorage;
+import dev.starcore.starcore.module.army.storage.authority.ArmySqlAuthorityStorage;
+import java.nio.file.Path;
+import java.sql.DriverManager;
+import java.sql.SQLException;
+import java.time.Instant;
+import java.util.Map;
+import java.util.UUID;
+import javax.sql.DataSource;
+import org.junit.jupiter.api.io.TempDir;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+
+class ArmyAuthorityOwnerStorageTest {
+  private static final UUID ARMY_ID = new UUID(0, 1);
+  private static final UUID OTHER_ID = new UUID(0, 2);
+  private static final UUID NATION_ID = new UUID(0, 3);
+  private static final UUID REQUEST_ID = new UUID(0, 4);
+  private static final UUID OPERATION_ID = new UUID(0, 5);
+  private static final Instant CREATED = Instant.parse("2026-11-27T00:00:00.123456789Z");
+  private static final Instant UPDATED = Instant.parse("2026-11-27T00:01:00.987654321Z");
+
+  @TempDir Path root;
+
+  @ParameterizedTest(name = "sqlite={0}")
+  @ValueSource(booleans = {false, true})
+  void updateAndRetirementBecomeOneDurableAggregateRevision(boolean sqlite) throws Exception {
+    var owner = initialize(sqlite);
+    var first = army(ARMY_ID, 38);
+    var second = army(OTHER_ID, 63);
+    owner.create(first);
+    owner.create(second);
+    var before = owner.snapshot();
+    var retirement =
+        new ArmyAuthorityOwner.Retirement(UPDATED, "integration-retirement", OPERATION_ID);
+
+    var committed =
+        owner.transition(
+            Map.of(first.token(), withSupply(first, 71)), Map.of(second.token(), retirement));
+
+    assertEquals(before.revision() + 1, committed.revision());
+    assertEquals(
+        Map.of(ARMY_ID, withSupply(first, 71).withToken(next(first.token()))), committed.armies());
+    var tombstone = committed.tombstones().get(OTHER_ID);
+    assertNotNull(tombstone);
+    assertEquals(next(second.token()), tombstone.token());
+    assertEquals(second.nationId(), tombstone.nationId());
+    assertEquals(second.type(), tombstone.type());
+    assertEquals(second.createdAt(), tombstone.createdAt());
+    assertEquals(retirement.retiredAt(), tombstone.retiredAt());
+    assertEquals(retirement.reason(), tombstone.reason());
+    assertEquals(OPERATION_ID, tombstone.operationId());
+    assertEquals(2, before.armies().size());
+    assertEquals(38, before.armies().get(ARMY_ID).supply());
+    assertTrue(before.tombstones().isEmpty());
+    assertEquals(committed, owner.snapshot());
+    assertEquals(committed, storage(sqlite).load());
+    assertEquals(committed, reopen(sqlite).snapshot());
+  }
+
+  @ParameterizedTest(name = "sqlite={0}")
+  @ValueSource(booleans = {false, true})
+  void sameValueReplacementPersistsItsSuccessorAcrossOwnerCloseAndRestart(boolean sqlite)
+      throws Exception {
+    var owner = initialize(sqlite);
+    var original = army(ARMY_ID, 38);
+    owner.create(original);
+    var before = owner.snapshot();
+
+    var committed = owner.replace(original.token(), original);
+
+    assertEquals(before.revision() + 1, committed.revision());
+    assertEquals(original.withToken(next(original.token())), committed.armies().get(ARMY_ID));
+    assertEquals(original, before.armies().get(ARMY_ID));
+    owner.close();
+    assertFalse(owner.isReady());
+    assertThrows(IllegalStateException.class, owner::refresh);
+    assertThrows(IllegalStateException.class, owner::snapshot);
+    var restarted = reopen(sqlite);
+    assertTrue(restarted.isReady());
+    assertEquals(committed, restarted.snapshot());
+    assertEquals(committed, storage(sqlite).load());
+  }
+
+  @ParameterizedTest(name = "sqlite={0}")
+  @ValueSource(booleans = {false, true})
+  void receiptReplaysAfterRestartAndRetirementWithoutReusingTheArmyIdentity(boolean sqlite)
+      throws Exception {
+    var owner = initialize(sqlite);
+    var original = army(ARMY_ID, 95);
+    owner.create(original);
+    var before = owner.snapshot();
+
+    var receipt = owner.applyLogisticsSupply(REQUEST_ID, NATION_ID, original.token(), 10, UPDATED);
+
+    assertEquals(
+        new ArmyLogisticsReceipt(
+            REQUEST_ID, ARMY_ID, NATION_ID, 10, 5, original.token().incarnation()),
+        receipt);
+    var supplied = owner.snapshot();
+    assertEquals(before.revision() + 1, supplied.revision());
+    assertEquals(100, supplied.armies().get(ARMY_ID).supply());
+    assertEquals(next(original.token()), supplied.armies().get(ARMY_ID).token());
+    assertEquals(
+        receipt,
+        owner.applyLogisticsSupply(
+            REQUEST_ID, NATION_ID, original.token(), 10, UPDATED.plusSeconds(1)));
+    assertEquals(supplied, owner.snapshot());
+    owner.close();
+
+    var restarted = reopen(sqlite);
+    assertEquals(supplied, restarted.snapshot());
+    assertEquals(receipt, restarted.receipt(REQUEST_ID).orElseThrow());
+    assertEquals(
+        receipt,
+        restarted.applyLogisticsSupply(
+            REQUEST_ID, NATION_ID, original.token(), 10, UPDATED.plusSeconds(2)));
+    assertEquals(supplied, restarted.snapshot());
+    var current = restarted.army(ARMY_ID).orElseThrow();
+    var retired =
+        restarted.retire(
+            current.token(),
+            new ArmyAuthorityOwner.Retirement(
+                UPDATED.plusSeconds(3), "after-supply", OPERATION_ID));
+    assertEquals(next(current.token()), retired.tombstones().get(ARMY_ID).token());
+    restarted.close();
+
+    var afterRetirement = reopen(sqlite);
+    assertEquals(retired, afterRetirement.snapshot());
+    assertTrue(afterRetirement.army(ARMY_ID).isEmpty());
+    assertEquals(
+        receipt,
+        afterRetirement.applyLogisticsSupply(
+            REQUEST_ID, NATION_ID, original.token(), 10, UPDATED.plusSeconds(4)));
+    assertEquals(retired, afterRetirement.snapshot());
+    var reincarnated = original.withToken(new ArmyToken(ARMY_ID, new UUID(3, 1), 1));
+    assertThrows(IllegalArgumentException.class, () -> afterRetirement.create(reincarnated));
+    assertThrows(
+        IllegalStateException.class, () -> afterRetirement.replace(original.token(), original));
+    assertTrue(afterRetirement.isReady());
+    assertEquals(retired, afterRetirement.snapshot());
+    assertEquals(retired, storage(sqlite).load());
+  }
+
+  @ParameterizedTest(name = "sqlite={0}")
+  @ValueSource(booleans = {false, true})
+  void staleFullImageCannotOverwriteAnUnrelatedArmyAndRequiresRefresh(boolean sqlite)
+      throws Exception {
+    var winner = initialize(sqlite);
+    var first = army(ARMY_ID, 38);
+    var second = army(OTHER_ID, 63);
+    winner.create(first);
+    winner.create(second);
+    var stale = reopen(sqlite);
+    var shared = stale.snapshot();
+
+    var winning = winner.replace(first.token(), withSupply(first, 40));
+
+    assertEquals(shared.revision() + 1, winning.revision());
+    assertThrows(
+        RuntimeException.class, () -> stale.replace(second.token(), withSupply(second, 88)));
+    assertFalse(stale.isReady());
+    assertThrows(IllegalStateException.class, stale::snapshot);
+    assertThrows(IllegalStateException.class, () -> stale.army(OTHER_ID));
+    assertEquals(winning, storage(sqlite).load());
+    assertEquals(second, winning.armies().get(OTHER_ID));
+
+    assertEquals(winning, stale.refresh());
+    assertTrue(stale.isReady());
+    var refreshedSecond = stale.army(OTHER_ID).orElseThrow();
+    var retried = stale.replace(refreshedSecond.token(), withSupply(refreshedSecond, 88));
+
+    assertEquals(winning.revision() + 1, retried.revision());
+    assertEquals(winning.armies().get(ARMY_ID), retried.armies().get(ARMY_ID));
+    assertEquals(
+        withSupply(second, 88).withToken(next(second.token())), retried.armies().get(OTHER_ID));
+    assertEquals(retried, storage(sqlite).load());
+    assertEquals(retried, reopen(sqlite).snapshot());
+    assertEquals(first, shared.armies().get(ARMY_ID));
+    assertEquals(second, shared.armies().get(OTHER_ID));
+  }
+
+  @ParameterizedTest(name = "sqlite={0}")
+  @ValueSource(booleans = {false, true})
+  void refreshCanSkipToRetirementAndLaterCommitsKeepTheIdentityPermanentlyRetired(boolean sqlite)
+      throws Exception {
+    var writer = initialize(sqlite);
+    var original = army(ARMY_ID, 38);
+    writer.create(original);
+    var observer = reopen(sqlite);
+    var observed = observer.snapshot();
+    writer.replace(original.token(), withSupply(original, 39));
+    var current = writer.army(ARMY_ID).orElseThrow();
+    writer.replace(current.token(), withSupply(current, 40));
+    current = writer.army(ARMY_ID).orElseThrow();
+    var retired =
+        writer.retire(
+            current.token(),
+            new ArmyAuthorityOwner.Retirement(UPDATED, "skipped-observation", OPERATION_ID));
+
+    assertEquals(observed.revision() + 3, retired.revision());
+    assertEquals(4, retired.tombstones().get(ARMY_ID).token().generation());
+    assertEquals(retired, observer.refresh());
+    assertTrue(observer.army(ARMY_ID).isEmpty());
+    var reincarnated = original.withToken(new ArmyToken(ARMY_ID, new UUID(3, 1), 1));
+    assertThrows(IllegalArgumentException.class, () -> observer.create(reincarnated));
+    assertThrows(IllegalStateException.class, () -> observer.replace(original.token(), original));
+    assertThrows(
+        IllegalStateException.class,
+        () -> observer.applyLogisticsSupply(REQUEST_ID, NATION_ID, original.token(), 10, UPDATED));
+    assertTrue(observer.isReady());
+    assertEquals(retired, observer.snapshot());
+
+    var later = observer.create(army(OTHER_ID, 63));
+
+    assertEquals(retired.revision() + 1, later.revision());
+    assertEquals(retired.tombstones(), later.tombstones());
+    assertFalse(later.armies().containsKey(ARMY_ID));
+    assertEquals(later, storage(sqlite).load());
+    var restarted = reopen(sqlite);
+    assertEquals(later, restarted.snapshot());
+    assertThrows(IllegalArgumentException.class, () -> restarted.create(reincarnated));
+    assertEquals(later, restarted.snapshot());
+  }
+
+  private ArmyAuthorityOwner initialize(boolean sqlite) throws Exception {
+    var storage = storage(sqlite);
+    var initialized = ArmyAuthorityBootstrap.initialize(storage, root.resolve("missing-legacy"));
+    assertTrue(initialized.initialized());
+    assertTrue(initialized.armies().isEmpty());
+    var owner = new ArmyAuthorityOwner(storage);
+    assertEquals(initialized, owner.refresh());
+    return owner;
+  }
+
+  private ArmyAuthorityOwner reopen(boolean sqlite) throws Exception {
+    var owner = new ArmyAuthorityOwner(storage(sqlite));
+    owner.refresh();
+    return owner;
+  }
+
+  private ArmyAuthorityStorage storage(boolean sqlite) throws SQLException {
+    var directory = root.resolve("army");
+    if (!sqlite) {
+      return new ArmyFileAuthorityStorage(directory);
+    }
+    DataSource dataSource = mock(DataSource.class);
+    when(dataSource.getConnection())
+        .thenAnswer(
+            unused -> DriverManager.getConnection("jdbc:sqlite:" + root.resolve("army.db")));
+    return new ArmySqlAuthorityStorage(directory, dataSource);
+  }
+
+  private static ArmySnapshot army(UUID armyId, int supply) {
+    return new ArmySnapshot(
+        new ArmyToken(armyId, new UUID(2, armyId.getLeastSignificantBits()), 1),
+        NATION_ID,
+        ArmyType.INFANTRY,
+        42,
+        73.5,
+        64.25,
+        new ArmyPosition(null, "unresolved-world", 12.5, 68, -9.25, 37.5f, -16.25f),
+        ArmyState.MARCHING,
+        supply,
+        37,
+        CREATED,
+        UPDATED);
+  }
+
+  private static ArmySnapshot withSupply(ArmySnapshot before, int supply) {
+    return new ArmySnapshot(
+        before.token(),
+        before.nationId(),
+        before.type(),
+        before.soldiers(),
+        before.health(),
+        before.morale(),
+        before.position(),
+        before.state(),
+        supply,
+        before.supplyConsumptionRemainder(),
+        before.createdAt(),
+        before.lastUpdated());
+  }
+
+  private static ArmyToken next(ArmyToken token) {
+    return new ArmyToken(token.armyId(), token.incarnation(), token.generation() + 1);
+  }
+}
