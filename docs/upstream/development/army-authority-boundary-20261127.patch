+  private void prepareIntent(AllianceOperationIntent intent) {
+    requireOperationAuthority();
+    var state = storage.loadStateSnapshot();
+    if (state.intents().containsKey(intent.operationId())
+        || state.intents().values().stream()
+            .anyMatch(
+                previous ->
+                    previous.status() == Status.PREPARED && previous.pair().equals(intent.pair())))
+      throw new IllegalStateException("Alliance pair already has a pending operation");
+    if (!matchesOriginalState(state, intent))
+      throw new AllianceStateConflictException(persistedRevision, state.revision());
+    if (state.retirements().containsKey(intent.request().left())
+        || state.retirements().containsKey(intent.request().right()))
+      throw new IllegalStateException("Nation relationships are permanently retired");
+    var updated = new HashMap<>(state.intents());
+    updated.put(intent.operationId(), intent);
+    saveOperationState(
+        state,
+        state.alliances(),
+        state.invites(),
+        state.cooldowns(),
+        updated,
+        state.projectionOwners());
+  }
+
+  private AllianceOperationIntent processIntent(UUID operationId) {
+    requireOperationAuthority();
+    try {
+      var initial = storage.loadStateSnapshot();
+      var intent = requireIntent(initial, operationId);
+      if (intent.status() == Status.ACKNOWLEDGED) {
+        applyState(initial);
+        return intent;
       }
+      boolean retired =
+          initial.retirements().containsKey(intent.request().left())
+              || initial.retirements().containsKey(intent.request().right());
+      if (stopped) throw new IllegalStateException("Relationship service stopped");
+      var receipt =
+          intent.cancellationRequested() || retired
+              ? operationService.cancelAllianceOperation(intent.request())
+              : operationService.applyAllianceOperation(intent.request());
+      if (receipt == null || !intent.request().equals(receipt.request()))
+        throw new IllegalStateException("Alliance receiver receipt payload mismatch");
+      PairState receiver = receipt.applied() ? readPair(intent.pair()) : null;
+      if (stopped) throw new IllegalStateException("Relationship service stopped");
+      var latest = storage.loadStateSnapshot();
+      var current = requireIntent(latest, operationId);
+      if (!current.samePayload(intent))
+        throw new IllegalStateException("Prepared alliance intent changed");
+      if (current.status() == Status.ACKNOWLEDGED) {
+        applyState(latest);
+        return current;
+      }
+      var acknowledged = current.acknowledge(receipt);
+      var updatedIntents = new HashMap<>(latest.intents());
+      updatedIntents.put(operationId, acknowledged);
+      var updatedAlliances = new HashMap<>(latest.alliances());
+      var updatedInvites = new HashMap<>(latest.invites());
+      var updatedCooldowns = new HashMap<>(latest.cooldowns());
+      var updatedOwners = new HashMap<>(latest.projectionOwners());
+      boolean active =
+          !latest.retirements().containsKey(intent.request().left())
+              && !latest.retirements().containsKey(intent.request().right());
+      boolean owned =
+          receipt.applied()
+              && receiver.ownedBy(operationId)
+              && receiver.generation() == receipt.generation()
+              && receiver.relation() == receipt.resultingRelation();
+      if (active && owned && matchesOriginalState(latest, intent)) {
+        if (intent.request().action() == Action.FORM)
+          updatedAlliances.put(intent.pair(), intent.proposedAlliance());
+        else updatedAlliances.remove(intent.pair());
+        if (intent.originalInvite() != null)
+          updatedInvites.remove(intent.originalInvite(), intent.originalInviteAt());
+        if (intent.proposedCooldown() == null) updatedCooldowns.remove(intent.pair());
+        else updatedCooldowns.put(intent.pair(), intent.proposedCooldown());
+        updatedOwners.put(
+            intent.pair(), new AllianceProjectionOwner(operationId, receipt.generation()));
+      }
+      saveOperationState(
+          latest,
+          updatedAlliances,
+          updatedInvites,
+          updatedCooldowns,
+          updatedIntents,
+          updatedOwners);
+      recoveryFailures.remove(operationId);
+      return acknowledged;
+    } catch (RuntimeException failure) {
+      recoveryFailures.put(
+          operationId,
+          failure.getClass().getSimpleName()
+              + ": "
+              + Objects.toString(failure.getMessage(), "receiver or authority unavailable"));
+      throw failure;
     }
+  }
 
