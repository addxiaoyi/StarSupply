+
+  private static java.util.function.Supplier<DataSource> fixedSource(DataSource dataSource) {
+    if (dataSource == null)
+      throw new IllegalStateException("Army authority DataSource is unavailable");
+    var fixed = new SqliteDataSource(dataSource);
+    return () -> fixed;
+  }
+
+  private static final class SqliteDataSource implements DataSource {
+    private final DataSource delegate;
+    private String databaseUrl;
+    private Path databasePath;
+
+    private SqliteDataSource(DataSource delegate) {
+      this.delegate = delegate;
+    }
+
+    private synchronized Connection verify(Connection connection) throws SQLException {
+      if (connection == null) throw new SQLException("Army authority connection is unavailable");
+      try {
+        var metadata = connection.getMetaData();
+        var product = metadata == null ? null : metadata.getDatabaseProductName();
+        var url = metadata == null ? null : metadata.getURL();
+        if (!"SQLite".equalsIgnoreCase(product) || url == null || !url.startsWith("jdbc:sqlite:"))
+          throw new SQLException("Army authority requires an actual SQLite connection");
+        var target = url.substring("jdbc:sqlite:".length());
+        if (target.isBlank() || target.equals(":memory:") || target.startsWith(":resource:"))
+          throw new SQLException("Army authority requires a persistent main database file");
+        if (databaseUrl != null && !databaseUrl.equals(url))
+          throw new SQLException("Army authority DataSource database identity changed");
+        String mainFile = null;
+        try (var statement = connection.createStatement();
+            var databases = statement.executeQuery("PRAGMA database_list")) {
+          while (databases.next()) {
+            if (mainFile != null || !"main".equals(databases.getString("name")))
+              throw new SQLException("Army authority requires exactly one main database schema");
+            mainFile = databases.getString("file");
+            if (mainFile == null || mainFile.isBlank())
+              throw new SQLException("Army authority requires a persistent main database file");
+          }
+        }
+        if (mainFile == null)
+          throw new SQLException("Army authority requires a persistent main database file");
+        Path actualPath;
+        try {
+          actualPath = Path.of(mainFile).toRealPath();
+        } catch (IOException | InvalidPathException error) {
+          throw new SQLException("Army authority main database file is unavailable", error);
+        }
+        if (!Files.isRegularFile(actualPath))
+          throw new SQLException("Army authority requires a persistent main database file");
+        if (databasePath != null && !databasePath.equals(actualPath))
+          throw new SQLException("Army authority DataSource main database identity changed");
+        databaseUrl = url;
+        databasePath = actualPath;
+        return connection;
+      } catch (SQLException | RuntimeException error) {
+        try {
+          connection.close();
+        } catch (SQLException closeFailure) {
+          error.addSuppressed(closeFailure);
+        }
+        throw error;
+      }
+    }
+
+    @Override
+    public Connection getConnection() throws SQLException {
+      return verify(delegate.getConnection());
+    }
+
+    @Override
+    public Connection getConnection(String username, String password) throws SQLException {
+      return verify(delegate.getConnection(username, password));
+    }
+
+    @Override
+    public PrintWriter getLogWriter() throws SQLException {
+      return delegate.getLogWriter();
+    }
+
+    @Override
+    public void setLogWriter(PrintWriter writer) throws SQLException {
+      delegate.setLogWriter(writer);
+    }
+
+    @Override
+    public void setLoginTimeout(int seconds) throws SQLException {
+      delegate.setLoginTimeout(seconds);
+    }
+
+    @Override
+    public int getLoginTimeout() throws SQLException {
+      return delegate.getLoginTimeout();
+    }
+
+    @Override
+    public Logger getParentLogger() throws SQLFeatureNotSupportedException {
+      return delegate.getParentLogger();
+    }
+
+    @Override
+    public <Target> Target unwrap(Class<Target> target) throws SQLException {
+      return delegate.unwrap(target);
+    }
+
+    @Override
+    public boolean isWrapperFor(Class<?> target) throws SQLException {
+      return delegate.isWrapperFor(target);
+    }
+  }
+}
