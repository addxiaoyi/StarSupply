+import org.bukkit.entity.Player;
+import org.junit.jupiter.api.Test;
+import org.mockito.ArgumentCaptor;
+
+class ZoneNativeInputContextTest {
+  @Test
+  void memberInputRechecksNationZoneOwnershipRankAndModuleLifecycle() throws Exception {
+    for (String reason : new String[] {"nation", "owner", "rank", "shutdown"}) {
+      var module = mock(ZoneModule.class);
+      var nations = mock(NationService.class);
+      var nation = mock(Nation.class);
+      var player = mock(Player.class);
+      UUID playerId = UUID.randomUUID();
+      UUID zoneId = UUID.randomUUID();
+      NationId nationId = NationId.random();
+      when(player.getUniqueId()).thenReturn(playerId);
+      when(nation.id()).thenReturn(nationId);
+      when(nations.nationOf(playerId)).thenReturn(Optional.of(nation));
+      when(module.getNationService()).thenReturn(nations);
+      var zone = mock(ZoneSnapshot.class);
+      when(zone.nationId()).thenReturn(nationId);
+      when(module.zoneById(zoneId)).thenReturn(Optional.of(zone));
+      when(module.rankOf(zoneId, playerId)).thenReturn(ZoneRank.ADMIN);
+      var listener = new ZoneGuiListener(module, null);
+      var openZones = ZoneGuiListener.class.getDeclaredField("playerOpenZone");
+      openZones.setAccessible(true);
+      ((Map<UUID, UUID>) openZones.get(listener)).put(playerId, zoneId);
+      var open =
+          ZoneGuiListener.class.getDeclaredMethod(
+              "handleMembersMenuClick", Player.class, int.class, ZoneGui.class);
+      open.setAccessible(true);
+      try (var support = mockStatic(BookInputSupport.class)) {
+        open.invoke(listener, player, 31, mock(ZoneGui.class));
+        var active = ArgumentCaptor.forClass(BooleanSupplier.class);
+        var submit = ArgumentCaptor.forClass(Consumer.class);
+        support.verify(
+            () ->
+                BookInputSupport.prepare(
+                    same(player),
+                    eq("Zone member"),
+                    eq(""),
+                    active.capture(),
+                    submit.capture(),
+                    any(Runnable.class)));
+        assertThat(active.getValue().getAsBoolean()).isTrue();
+        switch (reason) {
+          case "nation" -> when(nations.nationOf(playerId)).thenReturn(Optional.empty());
+          case "owner" -> when(zone.nationId()).thenReturn(NationId.random());
+          case "rank" -> when(module.rankOf(zoneId, playerId)).thenReturn(ZoneRank.MEMBER);
+          case "shutdown" -> listener.close();
+        }
+        assertThat(active.getValue().getAsBoolean()).as(reason).isFalse();
+        submit.getValue().accept("Target");
+        verify(module, never()).addMember(any(), any(), any());
+      }
+    }
+  }
+}
