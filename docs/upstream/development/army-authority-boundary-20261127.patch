index 0000000000000000000000000000000000000000..8e7850eee88468e5c3328fcc558b37bf54152972
--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/war/PaidWarDeclaration.java
@@ -0,0 +1,258 @@
+package dev.starcore.starcore.war;
+
+import com.google.gson.*;
+import dev.starcore.starcore.module.nation.model.NationId;
+import dev.starcore.starcore.module.treasury.NationDebitService;
+import dev.starcore.starcore.module.war.WarDeclarationRecoveryService.*;
+import java.math.BigDecimal;
+import java.time.Instant;
+import java.util.*;
+
+/** Intent and outcome live beside the war, not in a separate overwriteable journal. */
+record PaidWarDeclaration(Receipt receipt, NationDebitService.Receipt debit, String initialWar) {
+  static final String PREFIX = "declaration.";
+  static final String ENFORCED = "paidDeclarations.enforced";
+  private static final Gson GSON = new Gson();
+
+  PaidWarDeclaration {
+    Objects.requireNonNull(receipt);
+    if ((receipt.status() == Status.DECLARED) != (initialWar != null))
+      throw new IllegalArgumentException("Declaration war evidence mismatch");
+    if (receipt.status() == Status.PENDING && debit != null
+        || receipt.cost().signum() == 0 && (debit != null || receipt.status() == Status.REJECTED))
+      throw new IllegalArgumentException("Invalid declaration fee evidence");
+    if (receipt.cost().signum() > 0 && receipt.status() != Status.PENDING) {
+      if (debit == null
+          || !debit.request().equals(debitRequest(receipt))
+          || !switch (receipt.status()) {
+            case DECLARED -> debit.status() == NationDebitService.Status.APPLIED;
+            case CANCELLED -> debit.status() == NationDebitService.Status.CANCELLED;
+            case REJECTED ->
+                debit.status() == NationDebitService.Status.INSUFFICIENT_FUNDS
+                    || debit.status() == NationDebitService.Status.RETIRED;
+            case PENDING -> false;
+          }) throw new IllegalArgumentException("Declaration requires its original debit decision");
+    }
+  }
+
+  static NationDebitService.Request debitRequest(Receipt r) {
+    return new NationDebitService.Request(
+        r.request().operationId(),
+        r.request().aggressor(),
+        r.cost(),
+        "war-declaration:" + r.request().operationId());
+  }
+
+  boolean pending() {
+    return receipt.status() == Status.PENDING;
+  }
+
+  Set<NationId> nations() {
+    return Set.of(receipt.request().aggressor(), receipt.request().defender());
+  }
+
+  static boolean samePair(Request a, Request b) {
+    return Set.of(a.aggressor(), a.defender()).equals(Set.of(b.aggressor(), b.defender()));
+  }
+
+  static boolean pair(Request r, War w) {
+    return Set.of(r.aggressor(), r.defender()).equals(Set.of(w.aggressor(), w.defender()));
+  }
+
+  String encode() {
+    var j = new JsonObject();
+    var r = receipt.request();
+    j.addProperty("actor", r.actorId().toString());
+    j.addProperty("aggressor", r.aggressor().toString());
+    j.addProperty("defender", r.defender().toString());
+    j.addProperty("goal", r.goal().name());
+    j.addProperty("cost", receipt.cost().toPlainString());
+    j.addProperty("requestedAt", receipt.requestedAt().toEpochMilli());
+    j.addProperty("status", receipt.status().name());
+    j.add(
+        "declaredAt",
+        receipt.declaredAt() == null
+            ? JsonNull.INSTANCE
+            : new JsonPrimitive(receipt.declaredAt().toEpochMilli()));
+    if (debit == null) j.add("debit", JsonNull.INSTANCE);
+    else {
+      var d = new JsonObject();
+      d.addProperty("status", debit.status().name());
+      d.addProperty("decidedAt", debit.decidedAt().toEpochMilli());
+      j.add("debit", d);
+    }
+    j.add("initialWar", initialWar == null ? JsonNull.INSTANCE : new JsonPrimitive(initialWar));
+    return j.toString();
+  }
+
+  static Map<UUID, PaidWarDeclaration> operations(Properties p) {
+    var result = new HashMap<UUID, PaidWarDeclaration>();
+    WarAuthority.family(p, PREFIX)
+        .forEach(
+            (id, json) -> {
+              var j = JsonParser.parseString(json).getAsJsonObject();
+              var request =
+                  new Request(
+                      id,
+                      nation(j, "actor"),
+                      nation(j, "aggressor"),
+                      nation(j, "defender"),
+                      WarGoal.valueOf(j.get("goal").getAsString()));
+              var receipt =
+                  new Receipt(
+                      request,
+                      new BigDecimal(j.get("cost").getAsString()),
+                      Instant.ofEpochMilli(j.get("requestedAt").getAsLong()),
+                      Status.valueOf(j.get("status").getAsString()),
+                      j.get("declaredAt").isJsonNull()
+                          ? null
+                          : Instant.ofEpochMilli(j.get("declaredAt").getAsLong()));
+              NationDebitService.Receipt debit = null;
+              if (!j.get("debit").isJsonNull()) {
+                var d = j.getAsJsonObject("debit");
+                debit =
+                    new NationDebitService.Receipt(
+                        debitRequest(receipt),
+                        NationDebitService.Status.valueOf(d.get("status").getAsString()),
+                        Instant.ofEpochMilli(d.get("decidedAt").getAsLong()));
+              }
+              var operation =
+                  new PaidWarDeclaration(
+                      receipt,
+                      debit,
+                      j.get("initialWar").isJsonNull() ? null : j.get("initialWar").getAsString());
+              if (!operation.encode().equals(json))
+                throw new IllegalArgumentException("Noncanonical declaration intent");
+              result.put(id, operation);
+            });
+    return Map.copyOf(result);
+  }
+
+  private static NationId nation(JsonObject j, String key) {
+    return NationId.of(UUID.fromString(j.get(key).getAsString()));
+  }
+
+  static void validate(Properties state, WarAuthority authority) {
+    if (state.containsKey(ENFORCED) && !"1".equals(state.getProperty(ENFORCED)))
+      throw new IllegalArgumentException("Invalid paid declaration protocol marker");
+    var ops = operations(state);
+    var pending = ops.values().stream().filter(PaidWarDeclaration::pending).toList();
+    var fenced = WarDisbandAdmission.reserved(state);
+    var retired = WarAuthority.receipts(state);
+    for (var op : ops.values()) {
+      var r = op.receipt();
+      UUID id = r.warId();
+      if (op.pending()) {
+        if (state.containsKey(WarAuthority.WAR + id)
+            || state.containsKey(WarAuthority.ARCHIVED_WAR + id)
+            || state.containsKey(WarAuthority.DELETED + id))
+          throw new IllegalStateException("Pending declaration war ID already used");
+        if (op.nations().stream().anyMatch(n -> fenced.containsKey(n) || retired.containsKey(n)))
+          throw new IllegalStateException("Pending declaration blocks nation retirement");
+        if (pending.stream()
+            .anyMatch(other -> other != op && samePair(r.request(), other.receipt().request())))
+          throw new IllegalStateException("Conflicting pending declaration pair");
+        for (var e : WarAuthority.family(state, WarAuthority.WAR).entrySet())
+          if (pair(r.request(), authority.decodeWar(e.getKey(), e.getValue()))
+              && authority.decodeWar(e.getKey(), e.getValue()).isActive())
+            throw new IllegalStateException("Pending declaration reserves its pair");
+      } else if (r.status() == Status.REJECTED || r.status() == Status.CANCELLED) {
+        if (state.containsKey(WarAuthority.WAR + id)
+            || state.containsKey(WarAuthority.ARCHIVED_WAR + id)
+            || state.containsKey(WarAuthority.DELETED + id))
+          throw new IllegalStateException("Unpaid declaration cannot create war history");
+      } else if (r.status() == Status.DECLARED) {
+        var initial = authority.decodeWar(id, op.initialWar());
+        String json =
+            state.getProperty(
+                WarAuthority.WAR + id, state.getProperty(WarAuthority.ARCHIVED_WAR + id));
+        if (json == null) throw new IllegalStateException("Declared war history missing");
+        var actual = authority.decodeWar(id, json);
+        if (initial.status() != WarStatus.PREPARATION
+            || !initial.aggressor().equals(r.request().aggressor())
+            || !initial.defender().equals(r.request().defender())
+            || initial.goal() != r.request().goal()
+            || !initial.declaredAt().equals(r.declaredAt())
+            || !actual.aggressor().equals(initial.aggressor())
+            || !actual.defender().equals(initial.defender())
+            || actual.goal() != initial.goal()
+            || !actual.declaredAt().equals(initial.declaredAt()))
+          throw new IllegalArgumentException("Declaration original war changed");
+      }
+    }
+  }
+
+  static void transition(Properties previous, Properties next, WarAuthority authority) {
+    if ("1".equals(previous.getProperty(ENFORCED))) {
+      if (!"1".equals(next.getProperty(ENFORCED)))
+        throw new IllegalArgumentException("Paid declaration protocol cannot be disabled");
+      requirePaidNewWars(previous, next, authority);
+    }
+    var before = operations(previous);
+    var after = operations(next);
+    for (var e : before.entrySet()) {
+      var a = e.getValue();
+      var b = after.get(e.getKey());
+      if (b == null
+          || !a.receipt().request().equals(b.receipt().request())
+          || !a.receipt().cost().equals(b.receipt().cost())
+          || !a.receipt().requestedAt().equals(b.receipt().requestedAt())
+          || !a.pending() && !a.equals(b))
+        throw new IllegalArgumentException("Declaration history is immutable");
+    }
+    validate(next, authority);
+  }
+
+  static void commit(Properties previous, Properties next, WarAuthority authority) {
+    if ("1".equals(next.getProperty(ENFORCED))) requirePaidNewWars(previous, next, authority);
+    var before = operations(previous);
+    var after = operations(next);
+    int changes = 0;
+    var unchanged = new Properties();
+    unchanged.putAll(next);
+    for (var e : after.entrySet())
+      if (!e.getValue().equals(before.get(e.getKey()))) {
+        changes++;
+        var op = e.getValue();
+        var old = before.get(e.getKey());
+        if (old == null) {
+          if (!op.pending())
+            throw new IllegalArgumentException("Declaration must persist its intent first");
+          unchanged.remove(PREFIX + e.getKey());
+        } else {
+          unchanged.setProperty(PREFIX + e.getKey(), old.encode());
+          if (op.receipt().status() == Status.DECLARED) {
+            if (previous.containsKey(WarAuthority.WAR + e.getKey())
+                || previous.containsKey(WarAuthority.DELETED + e.getKey())
+                || !op.initialWar().equals(next.getProperty(WarAuthority.WAR + e.getKey())))
+              throw new IllegalArgumentException(
+                  "Declaration must publish original war with outcome");
+            unchanged.remove(WarAuthority.WAR + e.getKey());
+          }
+        }
+      }
+    if (changes > 1 || changes == 1 && !unchanged.equals(previous))
+      throw new IllegalArgumentException("Declaration commit cannot change unrelated authority");
+  }
+
+  private static void requirePaidNewWars(
+      Properties previous, Properties next, WarAuthority authority) {
+    var declarations = operations(next);
+    for (var id : WarAuthority.family(next, WarAuthority.WAR).keySet())
+      if (!previous.containsKey(WarAuthority.WAR + id)) {
+        var operation = declarations.get(id);
+        if (operation == null || operation.receipt().status() != Status.DECLARED)
+          throw new IllegalStateException("New war requires a paid declaration outcome");
+      } else {
+        var before = authority.decodeWar(id, previous.getProperty(WarAuthority.WAR + id));
+        var after = authority.decodeWar(id, next.getProperty(WarAuthority.WAR + id));
+        if (!before.aggressor().equals(after.aggressor())
+            || !before.defender().equals(after.defender())
+            || before.goal() != after.goal()
+            || !before.declaredAt().equals(after.declaredAt())
+            || before.isEnded() && !after.isEnded())
+          throw new IllegalStateException(
+              "Original war identity and terminal status cannot be changed");
+      }
+  }
+}
diff --git a/src/main/java/dev/starcore/starcore/war/PeaceTreatyBatch.java b/src/main/java/dev/starcore/starcore/war/PeaceTreatyBatch.java
new file mode 100644
index 0000000000000000000000000000000000000000..66ade022e4c616f658ddf601200d423d2956722d
--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/war/PeaceTreatyBatch.java
@@ -0,0 +1,246 @@
+package dev.starcore.starcore.war;
+
+import dev.starcore.starcore.module.diplomacy.DiplomacyTreatyOperationService.OperationView;
+import dev.starcore.starcore.module.diplomacy.DiplomacyTreatyOperationService.Plan;
+import dev.starcore.starcore.module.diplomacy.DiplomacyTreatyOperationService.ReserveRequest;
+import dev.starcore.starcore.module.war.WarSettlementAdmissionService.EndReceipt;
+import dev.starcore.starcore.module.war.WarSettlementAdmissionService.Request;
+import dev.starcore.starcore.treaty.TreatyEffectManifest;
+import dev.starcore.starcore.treaty.TreatyEffectManifest.OriginalTerm;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Locale;
+import java.util.Objects;
+
+record PeaceTreatyBatch(
+    ReserveRequest request,
+    Plan plan,
+    Stage stage,
+    EndReceipt endReceipt,
+    OperationView terminalReceipt,
+    boolean cancelRequested,
+    Request binding) {
+  PeaceTreatyBatch(
+      ReserveRequest request,
+      Plan plan,
+      Stage stage,
+      EndReceipt endReceipt,
+      OperationView terminalReceipt) {
+    this(request, plan, stage, endReceipt, terminalReceipt, false, null);
+  }
+
+  PeaceTreatyBatch(
+      ReserveRequest request,
+      Plan plan,
+      Stage stage,
+      EndReceipt endReceipt,
+      OperationView terminalReceipt,
+      boolean cancelRequested) {
+    this(request, plan, stage, endReceipt, terminalReceipt, cancelRequested, null);
+  }
+
+  PeaceTreatyBatch {
+    Objects.requireNonNull(request, "request");
+    Objects.requireNonNull(stage, "stage");
+    if (plan != null && !plan.request().equals(request))
+      throw new IllegalArgumentException("Treaty batch plan request mismatch");
+    if (plan != null) {
+      var originals =
+          new HashMap<
+              Integer,
+              dev.starcore.starcore.module.diplomacy.DiplomacyTreatyOperationService.IndexedTerm>();
+      for (var term : request.terms()) originals.put(term.termIndex(), term);
+      var indexes = new HashSet<Integer>();
+      var restrictionIds = new HashSet<java.util.UUID>();
+      for (var term : plan.terms()) {
+        var original = originals.get(term.termIndex());
+        if (original == null
+            || !indexes.add(term.termIndex())
+            || !restrictionIds.add(term.restrictionId()))
+          throw new IllegalArgumentException("Treaty batch restriction manifest mismatch");
+        if (!term.requirement().equals(original.requirement().toLowerCase(Locale.ROOT))
+            || !term.description().equals(original.description())
+            || !term.nationId().equals(request.defeated())
+            || !term.imposedAt().equals(request.preparedAt()))
+          throw new IllegalArgumentException("Treaty batch restriction payload mismatch");
+      }
+      if (indexes.size() != request.terms().size())
+        throw new IllegalArgumentException("Treaty batch restriction manifest incomplete");
+    }
+    if (stage.ordinal() >= Stage.RESERVED.ordinal()
+        && stage.ordinal() <= Stage.WAR_ENDED.ordinal()
+        && plan == null) throw new IllegalArgumentException("Treaty batch plan missing");
+    if (binding != null
+        && (request.protocolVersion() != 2
+            || plan == null
+            || !expectedWarRequest(request, plan).equals(binding)))
+      throw new IllegalArgumentException("Treaty batch manifest binding mismatch");
+    if (request.protocolVersion() == 2
+        && binding == null
+        && (stage == Stage.MANIFEST_BOUND
+            || stage == Stage.WAR_PREPARED
+            || stage == Stage.WAR_ENDED))
+      throw new IllegalArgumentException("Treaty batch manifest binding missing");
+    if (request.protocolVersion() == 1 && stage == Stage.MANIFEST_BOUND)
+      throw new IllegalArgumentException("Legacy treaty batch cannot bind a manifest");
+    if (terminalReceipt != null
+        && (!terminalReceipt.request().equals(request)
+            || !terminalReceipt.terminal()
+            || !Objects.equals(terminalReceipt.plan(), plan)
+            || !Objects.equals(terminalReceipt.binding(), binding)))
+      throw new IllegalArgumentException("Treaty batch terminal receipt mismatch");
+    if (stage.ordinal() >= Stage.ACKED.ordinal() && terminalReceipt == null)
+      throw new IllegalArgumentException("Treaty batch terminal evidence missing");
+    if (endReceipt != null
+        && (plan == null
+            || request.protocolVersion() == 2 && binding == null
+            || !expectedWarRequest(request, plan).equals(endReceipt.request())))
+      throw new IllegalArgumentException("Treaty batch war end evidence mismatch");
+  }
+
+  static PeaceTreatyBatch prepare(ReserveRequest request) {
+    return new PeaceTreatyBatch(request, null, Stage.PREPARED, null, null);
+  }
+
+  PeaceTreatyBatch reserved(Plan value) {
+    return new PeaceTreatyBatch(
+        request, value, Stage.RESERVED, endReceipt, terminalReceipt, cancelRequested, binding);
+  }
+
+  PeaceTreatyBatch bound(Request value) {
+    if (binding != null && !binding.equals(value))
+      throw new IllegalArgumentException("Treaty batch manifest binding is immutable");
+    return new PeaceTreatyBatch(
+        request,
+        plan,
+        stage.ordinal() < Stage.MANIFEST_BOUND.ordinal() ? Stage.MANIFEST_BOUND : stage,
+        endReceipt,
+        terminalReceipt,
+        cancelRequested,
+        Objects.requireNonNull(value));
+  }
+
+  Request expectedBinding() {
+    return expectedWarRequest(request, Objects.requireNonNull(plan, "plan"));
+  }
+
+  PeaceTreatyBatch advance(Stage value) {
+    return new PeaceTreatyBatch(
+        request, plan, value, endReceipt, terminalReceipt, cancelRequested, binding);
+  }
+
+  PeaceTreatyBatch ended(EndReceipt receipt) {
+    return new PeaceTreatyBatch(
+        request, plan, Stage.WAR_ENDED, receipt, terminalReceipt, cancelRequested, binding);
+  }
+
+  PeaceTreatyBatch acknowledged(OperationView receipt) {
+    return new PeaceTreatyBatch(
+        request, receipt.plan(), Stage.ACKED, endReceipt, receipt, cancelRequested, binding);
+  }
+
+  PeaceTreatyBatch requestedCancellation() {
+    return new PeaceTreatyBatch(request, plan, stage, endReceipt, terminalReceipt, true, binding);
+  }
+
+  boolean terminal() {
+    return stage == Stage.RELEASED;
+  }
+
+  Request warRequest() {
+    if (request.protocolVersion() == 2) return Objects.requireNonNull(binding, "manifest binding");
+    return expectedBinding();
+  }
+
+  private static Request expectedWarRequest(ReserveRequest request, Plan plan) {
+    var scopes = plan.pairs().stream().map(pair -> pair.pair()).toList();
+    var manifest =
+        request.protocolVersion() == 2
+            ? TreatyEffectManifest.singleDiplomacy(request.envelope(), plan.planHash(), scopes)
+            : null;
+    return new Request(
+        request.operationId(),
+        request.treatyId(),
+        request.war(),
+        request.warGeneration(),
+        request.warFingerprint(),
+        scopes,
+        manifest == null ? plan.planHash() : TreatyEffectManifest.manifestHash(manifest),
+        request.preparedAt(),
+        request.protocolVersion(),
+        manifest);
+  }
+
+  static List<OriginalTerm> originalTerms(List<PeaceTreaty.PeaceTerm> terms) {
+    var result = new ArrayList<OriginalTerm>();
+    for (int index = 0; index < terms.size(); index++) {
+      var term = terms.get(index);
+      List<String> payload =
+          switch (term) {
+            case PeaceTreaty.PoliticalTerm value -> List.of(value.requirement());
+            case PeaceTreaty.ReparationTerm value ->
+                List.of(value.amount().toString(), Integer.toString(value.installments()));
+            case PeaceTreaty.TerritorialCessionTerm value -> List.copyOf(value.territoryIds());
+            case PeaceTreaty.MilitaryRestrictionTerm value ->
+                List.of(
+                    Integer.toString(value.maxArmySize()), Boolean.toString(value.disarmament()));
+            case PeaceTreaty.ResourceTributeTerm value ->
+                List.of(
+                    value.resourceType(),
+                    Integer.toString(value.amount()),
+                    Integer.toString(value.durationMonths()));
+            default -> throw new IllegalArgumentException("Unknown original treaty term type");
+          };
+      result.add(
+          new OriginalTerm(index, term.getClass().getSimpleName(), payload, term.description()));
+    }
+    return List.copyOf(result);
+  }
+
+  void validateTreaty(PeaceTreaty treaty) {
+    if (!request.treatyId().equals(treaty.id())
+        || !request.war().warId().equals(treaty.warId())
+        || !request.victor().equals(treaty.victor())
+        || !request.defeated().equals(treaty.defeated())
+        || request.originalTermCount() != treaty.terms().size()
+        || request.terms().size() != treaty.terms().size())
+      throw new IllegalArgumentException("Treaty batch identity mismatch");
+    if (request.protocolVersion() == 2
+        && !request.envelope().originalTerms().equals(originalTerms(treaty.terms())))
+      throw new IllegalArgumentException("Treaty batch full original payload mismatch");
+    for (int index = 0; index < treaty.terms().size(); index++) {
+      if (!(treaty.terms().get(index) instanceof PeaceTreaty.PoliticalTerm political))
+        throw new IllegalArgumentException("Treaty batch contains unsupported original terms");
+      var term = request.terms().get(index);
+      if (term.termIndex() != index
+          || !term.type().equals("PoliticalTerm")
+          || !term.requirement().equals(political.requirement())
+          || !term.description().equals(political.description()))
+        throw new IllegalArgumentException("Treaty batch original term mismatch");
+    }
+  }
+
+  void validateSuccessor(PeaceTreatyBatch next) {
+    if (!request.equals(next.request)
+        || plan != null && !plan.equals(next.plan)
+        || binding != null && !binding.equals(next.binding)
+        || endReceipt != null && !endReceipt.equals(next.endReceipt)
+        || terminalReceipt != null && !terminalReceipt.equals(next.terminalReceipt)
+        || cancelRequested && !next.cancelRequested
+        || next.stage.ordinal() < stage.ordinal()
+        || terminal() && !equals(next))
+      throw new IllegalArgumentException("Treaty batch evidence is immutable");
+  }
+
+  enum Stage {
+    PREPARED,
+    RESERVED,
+    MANIFEST_BOUND,
+    WAR_PREPARED,
+    WAR_ENDED,
+    ACKED,
+    RELEASED
+  }
+}
