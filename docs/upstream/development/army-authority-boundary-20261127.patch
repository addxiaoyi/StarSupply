+      when(f.database.isRunning()).thenReturn(true);
+      assertThatThrownBy(f::service).isInstanceOf(RuntimeException.class);
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void corruptCanonicalOrMissingAuthorityStopsWrites(boolean sql) throws Exception {
+    try (var f = new FederationTestFixture(root, sql)) {
+      var s = f.service();
+      f.create(s, f.a, "Alpha");
