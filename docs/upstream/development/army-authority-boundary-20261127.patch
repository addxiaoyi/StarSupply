+  private DiplomacyStateStorage bounded(DiplomacyStateStorage delegate, AtomicLong budget) {
+    return new DiplomacyStateStorage() {
+      @Override
+      public Properties load() {
+        return delegate.load();
+      }
+
+      @Override
+      public void save(Properties properties) {
+        DiplomacyTreatyCapacity.require(
+            properties, DiplomacyTreatyOperationState.read(properties), budget.get());
+        delegate.save(properties);
+      }
+
+      @Override
+      public void requireEffectProofPersistence() {
+        delegate.requireEffectProofPersistence();
+      }
+    };
+  }
+
+  private long required(Properties properties) {
+    return DiplomacyTreatyCapacity.requiredBytes(
+        properties, DiplomacyTreatyOperationState.read(properties));
+  }
+
+  private OperationView reserve(DiplomacyModule module) {
+    var original = new OriginalTerm(0, "PoliticalTerm", List.of("no_war"), "original|\n描述");
+    var war =
+        new ExactWar(
+            UUID.randomUUID(),
+            attacker,
+            defender,
+            preparedAt.minusSeconds(1),
+            List.of(attackerAlly),
+            List.of(defenderAlly));
+    var envelope =
+        new Envelope(
+            2,
+            UUID.randomUUID(),
+            UUID.randomUUID(),
+            war,
+            7,
+            "a".repeat(64),
+            attacker,
+            defender,
+            preparedAt,
+            List.of(original));
+    var request =
+        new ReserveRequest(
+            envelope.operationId(),
+            envelope.treatyId(),
+            war,
+            envelope.warGeneration(),
+            envelope.warFingerprint(),
+            attacker,
+            defender,
+            preparedAt,
+            1,
+            List.of(new IndexedTerm(0, original.type(), "no_war", original.description())),
+            2,
+            envelope,
+            List.of(0));
+    module.reconcile(
+        new WarDiplomacyMirrorService.SourceSnapshot(1, List.of(entry(request, true))));
+    return module.reserveTreaty(request);
+  }
+
+  private Request binding(OperationView operation) {
+    var request = operation.request();
+    var manifest =
+        TreatyEffectManifest.singleDiplomacy(
+            request.envelope(),
+            operation.planHash(),
+            operation.plan().pairs().stream().map(PairPlan::pair).toList());
+    return new Request(
+        request.operationId(),
+        request.treatyId(),
+        request.war(),
+        request.warGeneration(),
+        request.warFingerprint(),
+        manifest.scopes(),
+        TreatyEffectManifest.manifestHash(manifest),
+        request.preparedAt(),
+        2,
+        manifest);
+  }
+
+  private OperationView bound(OperationView operation, Request binding) {
+    return new OperationView(
+        operation.request(),
+        operation.plan(),
+        operation.status(),
+        operation.terminalAt(),
+        binding,
+        null);
+  }
+
+  private WarDiplomacyMirrorService.WarEntry entry(ReserveRequest request, boolean active) {
+    var war = request.war();
+    return new WarDiplomacyMirrorService.WarEntry(
+        war.warId(), war.attacker(), war.defender(), war.declaredAt(), active);
+  }
+
+  private EndReceipt end(OperationView operation) {
+    return new EndReceipt(
+        operation.binding(),
+        operation.request().warGeneration(),
+        operation.request().warGeneration() + 1,
+        preparedAt.plusSeconds(1),
+        2,
+        entry(operation.request(), false));
+  }
+
+  private OperationView terminal(
+      OperationView operation,
+      Status status,
+      TerminalBasis basis,
+      EndReceipt end,
+      CancellationReceipt cancellation) {
+    return new OperationView(
+        operation.request(),
+        operation.plan(),
+        status,
+        Instant.MAX,
+        operation.binding(),
+        new TerminalEvidence(basis, end, cancellation));
+  }
+
+  private void source(DiplomacyModule module, EndReceipt end, CancellationReceipt cancellation)
+      throws Exception {
+    var registry = new ServiceRegistry();
+    registry.register(
+        WarSettlementEndReceiptService.class,
+        new WarSettlementEndReceiptService() {
+          @Override
+          public Optional<EndReceipt> settlementEnd(UUID operationId) {
+            return Optional.ofNullable(end);
+          }
+
+          @Override
+          public Optional<CancellationReceipt> settlementCancellation(UUID operationId) {
+            return Optional.ofNullable(cancellation);
+          }
+        });
+    DiplomacyRetirementTestFixture.field(
+        module,
+        "context",
+        new StarCoreContext(null, null, null, null, null, null, null, null, null, null, registry));
+  }
+}
