+final class WarSettlementFileCapacity {
+  static final long MAX_BYTES = 64L * 1024 * 1024;
+  private static final long AUTHORITY_METADATA_MARGIN = 512;
+  private static final long WAR_END_MARGIN = 1024;
+
+  private WarSettlementFileCapacity() {}
+
+  static void validate(Properties state, long maximum) {
+    var operations = operations(state);
+    if (operations.isEmpty()) return;
+    requiredBytes(state, maximum, operations);
+  }
+
+  static long requiredBytes(Properties state, long maximum) {
+    return requiredBytes(state, maximum, operations(state));
+  }
+
+  static void validateRevisionCapacity(Properties state, long maximum) {
+    if (maximum < 0) throw new IllegalArgumentException("Invalid settlement revision capacity");
+    long required = requiredRevisions(state);
+    if (required == 0) return;
+    long revision = DurablePropertiesStore.revision(state);
+    if (revision > maximum || required > maximum - revision)
+      throw new IllegalStateException("Settlement authority revision capacity exhausted");
+  }
+
+  static long requiredRevisions(Properties state) {
+    var sources = new HashMap<UUID, PeaceTreatyBatch>();
+    var codec = new PeaceTreatyStateCodec();
+    long required = 0;
+    for (var json : WarAuthority.family(state, WarAuthority.TREATY).values()) {
+      String sourceJson = WarAuthority.treatyData(json).get("STATE");
+      if (sourceJson == null) continue;
+      var source = codec.decode(sourceJson);
+      var batch = source.execution().batch();
+      if (batch == null || batch.request().protocolVersion() != 2 || batch.terminal()) continue;
+      if (sources.putIfAbsent(batch.request().operationId(), batch) != null)
+        throw new IllegalArgumentException("Duplicate source revision operation");
+      long remaining = PeaceTreatyBatch.Stage.RELEASED.ordinal() - batch.stage().ordinal();
+      if (!batch.cancelRequested()) remaining = Math.addExact(remaining, 1);
+      required = Math.addExact(required, remaining);
+    }
+    var admissions = WarSettlementState.admissions(state);
+    var ends = WarSettlementState.ends(state);
+    var cancellations = WarSettlementState.cancellations(state);
+    var releases = WarSettlementState.releases(state);
+    var operationIds = new java.util.HashSet<>(sources.keySet());
+    for (var admission : admissions.values())
+      if (admission.request().protocolVersion() == 2
+          && admission.accepted()
+          && !releases.containsKey(admission.request().operationId()))
+        operationIds.add(admission.request().operationId());
+    for (var operationId : operationIds) {
+      var source = sources.get(operationId);
+      var admission = admissions.get(operationId);
+      if (source != null
+          && admission != null
+          && (admission.request().protocolVersion() != 2
+              || !source.request().envelope().equals(admission.request().manifest().envelope())
+              || source.binding() != null && !source.binding().equals(admission.request())))
+        throw new IllegalArgumentException("Source revision binding differs from native admission");
+      if (source != null && source.binding() == null) {
+        required = Math.addExact(required, 3);
+        continue;
+      }
+      if (releases.containsKey(operationId)) continue;
+      if (admission == null) {
+        required = Math.addExact(required, 3);
+      } else if (!admission.accepted()) {
+        if (!cancellations.containsKey(operationId)) required = Math.addExact(required, 1);
+      } else {
+        if (!ends.containsKey(operationId) && !cancellations.containsKey(operationId))
+          required = Math.addExact(required, 1);
+        required = Math.addExact(required, 1);
+      }
+    }
+    return required;
+  }
+
+  static void validateSourceProtocol(Properties state) {
+    var codec = new PeaceTreatyStateCodec();
+    for (var json : WarAuthority.family(state, WarAuthority.TREATY).values()) {
+      String source = WarAuthority.treatyData(json).get("STATE");
+      if (source != null) validateSourceProtocol(codec.decode(source));
+    }
+  }
+
+  private static void validateSourceProtocol(PeaceTreatyStateCodec.Decoded source) {
+    var execution = source.execution();
+    var batch = execution.batch();
+    if (batch == null || batch.request().protocolVersion() != 2) return;
+    String review = execution.reviewReason();
+    if (review != null
+        && (review.length() > 8192 || review.getBytes(StandardCharsets.UTF_8).length > 8192))
+      throw new IllegalStateException("Treaty v2 review evidence exceeds its protocol capacity");
+    var terms =
+        new HashMap<
+            Integer,
+            dev.starcore.starcore.module.diplomacy.DiplomacyTreatyOperationService.TermPlan>();
+    var restrictions =
+        new HashMap<
+            UUID,
+            dev.starcore.starcore.module.diplomacy.DiplomacyTreatyOperationService.TermPlan>();
+    if (batch.plan() != null)
+      for (var term : batch.plan().terms()) {
+        terms.put(term.termIndex(), term);
+        restrictions.put(term.restrictionId(), term);
+      }
+    for (var step : execution.steps()) {
+      if (step.compensationData().isEmpty()) continue;
+      var term = terms.get(step.index());
+      if (term == null
+          || !step.compensationData()
+              .equals(
+                  Map.of(
+                      "batchOperationId", batch.request().operationId().toString(),
+                      "restrictionId", term.restrictionId().toString())))
+        throw new IllegalStateException(
+            "Treaty v2 compensation differs from its frozen protocol plan");
+    }
+    if (!source.reparations().isEmpty()
+        || !source.militaryRestrictions().isEmpty()
+        || !source.resourceTributes().isEmpty()
+        || !source.payments().isEmpty())
+      throw new IllegalStateException("Treaty v2 cannot carry unsupported source sidecars");
+    for (var restriction : source.politicalRestrictions()) {
+      var term = restrictions.get(restriction.id());
+      if (term == null
+          || !restriction.treatyId().equals(batch.request().treatyId())
+          || !restriction.nationId().equals(term.nationId().value())
+          || !restriction.requirement().equals(term.requirement())
+          || !restriction.description().equals(term.description())
+          || !restriction.imposedAt().equals(term.imposedAt()))
+        throw new IllegalStateException("Treaty v2 sidecar differs from its frozen political plan");
+    }
+  }
+
+  private static long requiredBytes(
+      Properties state, long maximum, Map<UUID, SourceBudget> operations) {
+    long required = add(count(state, maximum), AUTHORITY_METADATA_MARGIN, maximum);
+    var admissions = WarSettlementState.admissions(state);
+    var ends = WarSettlementState.ends(state);
+    var cancellations = WarSettlementState.cancellations(state);
+    var releases = WarSettlementState.releases(state);
+    for (var entry : operations.entrySet()) {
+      UUID operationId = entry.getKey();
+      var source = entry.getValue();
+      var request = source.binding();
+      var admission = admissions.get(operationId);
+      if (admission != null && !admission.request().equals(request))
+        throw new IllegalArgumentException("Source capacity binding differs from native admission");
+      if (source.futureSourceBytes() != 0)
+        required = add(required, source.futureSourceBytes(), maximum);
+      if (!admissions.containsKey(operationId)) {
+        var futureAdmission = new Admission(request, Decision.CONFLICTING_SCOPE);
+        required =
+            add(
+                required,
+                propertyBytes(
+                    WarSettlementState.ADMISSION + operationId,
+                    WarSettlementState.encode(futureAdmission)),
+                maximum);
+      }
+      if (releases.containsKey(operationId)) continue;
+      if (admission != null && !admission.accepted()) {
+        if (!cancellations.containsKey(operationId))
+          required =
+              add(
+                  required,
+                  propertyBytes(
+                      WarSettlementState.CANCEL + operationId,
+                      WarSettlementState.encode(new CancellationReceipt(request))),
+                  maximum);
+        continue;
+      }
+      var futureEnd = futureEnd(request);
+      if (!ends.containsKey(operationId) && !cancellations.containsKey(operationId)) {
+        required =
+            add(
+                required,
+                propertyBytes(
+                    WarSettlementState.END + operationId, WarSettlementState.encode(futureEnd)),
+                maximum);
+        required = add(required, WAR_END_MARGIN, maximum);
+      }
+      required = add(required, futureReleaseBytes(request, futureEnd), maximum);
+    }
+    return required;
+  }
+
+  private static Map<UUID, SourceBudget> operations(Properties state) {
+    var result = new HashMap<UUID, SourceBudget>();
+    var codec = new PeaceTreatyStateCodec();
+    for (var entry : WarAuthority.family(state, WarAuthority.TREATY).entrySet()) {
+      var data = WarAuthority.treatyData(entry.getValue());
+      String sourceJson = data.get("STATE");
+      if (sourceJson == null) continue;
+      var source = codec.decode(sourceJson);
+      var batch = source.execution().batch();
+      validateSourceProtocol(source);
+      if (batch == null || batch.binding() == null || batch.terminal()) continue;
+      long sourceBudget = codec.futureGrowthBudget(sourceJson);
+      long currentSourceBytes =
+          propertyBytes(
+              WarAuthority.TREATY + entry.getKey(),
+              WarAuthority.encodeTreaty(Map.of("STATE", sourceJson)));
+      if (currentSourceBytes > sourceBudget)
+        throw new IllegalStateException("Treaty source exceeds its frozen file capacity quota");
+      var previous =
+          result.put(
+              batch.binding().operationId(),
+              new SourceBudget(
+                  batch.binding(), Math.subtractExact(sourceBudget, currentSourceBytes)));
+      if (previous != null)
+        throw new IllegalArgumentException("Duplicate source capacity operation");
+    }
+    var releases = WarSettlementState.releases(state);
+    for (var admission : WarSettlementState.admissions(state).values()) {
+      var request = admission.request();
+      if (request.protocolVersion() == 2
+          && admission.accepted()
+          && !releases.containsKey(request.operationId()))
+        result.putIfAbsent(request.operationId(), new SourceBudget(request, 0));
+    }
+    return Map.copyOf(result);
+  }
+
+  private static EndReceipt futureEnd(Request request) {
+    return new EndReceipt(
+        request,
+        request.warGeneration(),
+        Math.addExact(request.warGeneration(), 1),
+        Instant.MAX,
+        Long.MAX_VALUE,
+        new WarEntry(
+            request.war().warId(),
+            request.war().attacker(),
+            request.war().defender(),
+            request.war().declaredAt(),
+            false));
+  }
+
+  private static long futureReleaseBytes(Request request, EndReceipt end) {
+    var json = new com.google.gson.JsonObject();
+    json.addProperty("operationId", request.operationId().toString());
+    json.addProperty("planHash", request.planHash());
+    json.addProperty("status", TerminalStatus.CANCELLED.name());
+    json.addProperty("protocolVersion", 2);
+    var placeholders = new com.google.gson.JsonArray();
+    long proofBytes = 0;
+    for (var entry : request.manifest().entries()) {
+      placeholders.add("");
+      var proof =
+          new EffectProof(
+              request,
+              entry,
+              Phase.CANCELLED,
+              Instant.MAX,
+              new TerminalEvidence(TerminalBasis.END_REJECTED, end, null));
+      proofBytes =
+          Math.addExact(
+              proofBytes, Math.addExact(WarSettlementEffectProofCodec.encodedLength(proof), 2));
+    }
+    json.add("effectProofs", placeholders);
+    return Math.addExact(
+        propertyBytes(WarSettlementState.RELEASE + request.operationId(), json.toString()),
+        proofBytes);
+  }
+
+  static long propertyBytes(String key, String value) {
+    var property = new Properties();
+    property.setProperty(key, value);
+    return count(property, Long.MAX_VALUE);
+  }
+
+  private static long count(Properties state, long maximum) {
+    var output = new Counter(maximum);
+    try {
+      state.store(output, "STARCORE snapshot authority");
+    } catch (IOException failure) {
+      throw new IllegalStateException("Settlement file capacity exhausted", failure);
+    }
+    return output.count;
+  }
+
+  private static long add(long left, long right, long maximum) {
+    long result = Math.addExact(left, right);
+    if (result > maximum) throw new IllegalStateException("Settlement file capacity exhausted");
+    return result;
+  }
+
+  private record SourceBudget(Request binding, long futureSourceBytes) {}
+
+  private static final class Counter extends OutputStream {
+    private final long maximum;
+    private long count;
+
+    private Counter(long maximum) {
+      if (maximum <= 0) throw new IllegalArgumentException("Invalid settlement file capacity");
+      this.maximum = maximum;
+    }
+
+    @Override
+    public void write(int value) throws IOException {
+      advance(1);
+    }
+
+    @Override
+    public void write(byte[] bytes, int offset, int length) throws IOException {
+      Objects.checkFromIndexSize(offset, length, bytes.length);
+      advance(length);
+    }
+
+    private void advance(int length) throws IOException {
+      count = Math.addExact(count, length);
+      if (count > maximum) throw new IOException("Settlement file capacity exhausted");
+    }
+  }
+}
diff --git a/src/main/java/dev/starcore/starcore/war/WarSettlementState.java b/src/main/java/dev/starcore/starcore/war/WarSettlementState.java
