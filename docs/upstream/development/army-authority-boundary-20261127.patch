+    var persistence = mock(dev.starcore.starcore.core.persistence.PersistenceService.class);
+    when(persistence.namespacePath("alliance")).thenReturn(directory);
+    var storage =
+        new AllianceStorage(
+            mock(dev.starcore.starcore.core.database.DatabaseService.class),
+            persistence,
+            org.slf4j.LoggerFactory.getLogger(getClass()));
+    service = new AllianceServiceImpl(null, nationService, null, null, storage);
+    service.initialize();
+    leaderId = addNation("Leader");
+    officerId = addNation("Officer");
+    memberId = addNation("Member");
+    outsiderId = addNation("Outsider");
+    otherLeaderId = addNation("OtherLeader");
+  }
+
+  @Test
+  void legacyMutationEntrypointsFailClosed() {
+    Alliance alliance = createAlliance("Alpha", leaderId);
+
+    assertFalse(service.disbandAlliance(alliance.id()).success());
+    assertFalse(service.inviteNation(alliance.id(), officerId).success());
+    assertFalse(
+        service.setMemberRole(alliance.id(), leaderId, AllianceMember.Role.OFFICER).success());
+    assertFalse(
+        service
+            .setAllianceRelation(alliance.id(), UUID.randomUUID(), AllianceRelationType.FRIENDLY)
+            .success());
+  }
+
+  @Test
+  void leaderAndOfficerPermissionsRespectRoleHierarchy() {
+    Alliance alliance = createAlliance("Alpha", leaderId);
+
+    assertFalse(service.inviteNation(outsiderId, alliance.id(), officerId).success());
+    assertTrue(service.inviteNation(leaderId, alliance.id(), officerId).success());
+    assertTrue(service.acceptInvite(officerId, alliance.id()).success());
+    assertTrue(
+        service
+            .setMemberRole(alliance.id(), leaderId, officerId, AllianceMember.Role.OFFICER)
+            .success());
+
+    assertTrue(service.inviteNation(officerId, alliance.id(), memberId).success());
+    assertTrue(service.acceptInvite(memberId, alliance.id()).success());
+    assertTrue(service.setAnnouncement(alliance.id(), "Operational notice", officerId).success());
+
+    assertFalse(service.removeMember(alliance.id(), leaderId, officerId).success());
+    assertFalse(
+        service
+            .setMemberRole(alliance.id(), leaderId, memberId, AllianceMember.Role.LEADER)
+            .success());
+    assertTrue(service.removeMember(alliance.id(), memberId, officerId).success());
+  }
+
+  @Test
+  void onlySourceLeaderMayChangeRelationsAndLeadership() {
+    Alliance first = createAlliance("Alpha", leaderId);
+    Alliance second = createAlliance("Bravo", otherLeaderId);
+
+    assertFalse(
+        service
+            .setAllianceRelation(outsiderId, first.id(), second.id(), AllianceRelationType.FRIENDLY)
+            .success());
+    assertTrue(
+        service
+            .setAllianceRelation(leaderId, first.id(), second.id(), AllianceRelationType.FRIENDLY)
+            .success());
+
+    assertTrue(service.inviteNation(leaderId, first.id(), officerId).success());
+    assertTrue(service.acceptInvite(officerId, first.id()).success());
+    assertFalse(service.transferLeadership(first.id(), officerId, outsiderId).success());
+    assertTrue(service.transferLeadership(first.id(), officerId, leaderId).success());
+
+    assertFalse(service.disbandAlliance(leaderId, first.id()).success());
+    assertTrue(service.disbandAlliance(officerId, first.id()).success());
+  }
+
+  private Alliance createAlliance(String name, NationId leader) {
+    assertTrue(service.createAlliance(name, leader).success());
+    return service.getNationAlliance(leader).orElseThrow();
+  }
+
+  private NationId addNation(String name) {
+    NationId id = NationId.random();
+    Nation nation = new Nation(id, name, UUID.randomUUID(), name + " Founder");
+    nations.put(id, nation);
+    return id;
+  }
 }
