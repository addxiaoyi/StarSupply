+package dev.starcore.starcore.module.treasury;
+
+import static org.assertj.core.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+import dev.starcore.starcore.core.StarCoreContext;
+import dev.starcore.starcore.core.persistence.PersistenceService;
+import dev.starcore.starcore.core.service.ServiceRegistry;
+import dev.starcore.starcore.module.nation.model.NationId;
+import java.math.BigDecimal;
+import java.nio.file.*;
+import java.time.Instant;
+import java.util.*;
+import java.util.concurrent.*;
+import java.util.function.Supplier;
+import java.util.logging.Logger;
+import org.junit.jupiter.api.*;
+import org.junit.jupiter.api.io.TempDir;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.*;
+import org.sqlite.SQLiteDataSource;
+
+class TreasuryDebitAuthorityTest {
+  @TempDir Path directory;
+  final NationId nation = NationId.random();
+  final List<SqlTreasuryStateStorage> sqlStores = new ArrayList<>();
+
+  SQLiteDataSource source() {
+    var ds = new SQLiteDataSource();
+    ds.setUrl("jdbc:sqlite:" + directory.resolve("treasury.db"));
+    return ds;
+  }
+
+  Supplier<TreasuryStateStorage> stores(boolean sql) throws Exception {
+    var persistence = mock(PersistenceService.class);
+    when(persistence.namespacePath("treasury")).thenReturn(directory);
+    return () -> {
+      if (!sql) return new PersistenceTreasuryStateStorage("treasury", persistence);
+      var store =
+          new SqlTreasuryStateStorage(source(), new Properties(), Logger.getAnonymousLogger());
+      sqlStores.add(store);
+      return store;
+    };
+  }
+
+  TreasuryModule treasury(TreasuryStateStorage store) throws Exception {
+    var module = new TreasuryModule();
+    var field = TreasuryModule.class.getDeclaredField("stateStorage");
+    field.setAccessible(true);
+    field.set(module, store);
+    var load = TreasuryModule.class.getDeclaredMethod("loadState");
+    load.setAccessible(true);
+    load.invoke(module);
+    return module;
+  }
+
+  NationDebitService.Request request() {
+    UUID id = UUID.randomUUID();
+    return new NationDebitService.Request(
+        id, nation, new BigDecimal("10.00"), "war-declaration:" + id);
+  }
+
