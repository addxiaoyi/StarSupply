+  @Test
+  void enableWaitsForDurableReceiptCommitBeforeChangingLifecycle() throws Exception {
+    var fixture = fixture();
+    var stored = new AtomicReference<>(new Properties());
+    var storage = mock(EventStateStorage.class);
+    when(storage.load()).thenAnswer(ignored -> stored.get());
+    var saveEntered = new CountDownLatch(1);
+    var releaseSave = new CountDownLatch(1);
+    doAnswer(
+            invocation -> {
+              saveEntered.countDown();
+              if (!releaseSave.await(5, TimeUnit.SECONDS))
+                throw new IllegalStateException("timed out waiting to finish save");
+              stored.set(invocation.getArgument(0));
+              return null;
+            })
+        .when(storage)
+        .save(any());
+    var module = new EventModule(storage);
+    var executor = Executors.newFixedThreadPool(2);
+    try {
+      var receipt =
+          executor.submit(
+              () ->
+                  module.recordAllianceOnce(
+                      UUID.randomUUID(),
+                      NationId.random(),
+                      NationId.random(),
+                      true,
+                      Instant.parse("2026-11-27T00:00:00Z")));
+      assertThat(saveEntered.await(5, TimeUnit.SECONDS)).isTrue();
+      var enableStarted = new CountDownLatch(1);
+      var enabling =
+          executor.submit(
+              () -> {
+                enableStarted.countDown();
+                module.enable(fixture.context);
+              });
+      assertThat(enableStarted.await(5, TimeUnit.SECONDS)).isTrue();
+      assertThatThrownBy(() -> enabling.get(100, TimeUnit.MILLISECONDS))
+          .isInstanceOf(TimeoutException.class);
+      verify(fixture.context.persistenceService(), never()).ensureNamespace(anyString());
+      releaseSave.countDown();
+      assertThat(receipt.get(5, TimeUnit.SECONDS)).isTrue();
+      assertThatThrownBy(() -> enabling.get(5, TimeUnit.SECONDS))
+          .isInstanceOf(ExecutionException.class)
+          .hasCauseInstanceOf(NullPointerException.class);
+      verify(fixture.context.persistenceService()).ensureNamespace("event");
+    } finally {
+      releaseSave.countDown();
+      executor.shutdownNow();
+      assertThat(executor.awaitTermination(5, TimeUnit.SECONDS)).isTrue();
+    }
+  }
+}
