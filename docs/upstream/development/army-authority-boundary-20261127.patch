+      assertThat(pending.right()).isEqualTo(left);
+      assertThat(pending.createdAt()).isEqualTo(occurredAt);
+      assertThat(DiplomacyTemporalStateCodec.relationChangesFromProperties(persisted))
+          .containsEntry(DiplomacyPairKey.of(left, right), occurredAt);
+      assertThat(module.alliancePairState(right, left).ownedBy(form.operationId())).isTrue();
+      assertThat(fixture.open().applyAllianceOperation(form)).isEqualTo(formed);
+      assertThat(state(fixture)).isEqualTo(persisted);
