+          case SUPERSEDED -> TerminalStatus.SUPERSEDED;
+          case CANCELLED -> TerminalStatus.CANCELLED;
+          default -> throw new IllegalStateException("Treaty terminal cannot release settlement");
+        };
+    return mutate(() -> storage.releaseSettlement(request, status));
+  }
