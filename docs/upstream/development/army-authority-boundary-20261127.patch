+package dev.starcore.starcore.module.war.listener;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.mockito.Mockito.*;
+
+import dev.starcore.starcore.foundation.territory.TerritoryService;
+import dev.starcore.starcore.foundation.territory.model.ChunkCoordinate;
+import dev.starcore.starcore.foundation.territory.model.TerritoryClaim;
+import dev.starcore.starcore.module.nation.NationService;
+import dev.starcore.starcore.module.nation.model.NationId;
+import dev.starcore.starcore.module.war.WarService;
+import dev.starcore.starcore.module.war.event.WarEndedEvent;
+import dev.starcore.starcore.war.War;
+import dev.starcore.starcore.war.WarGoal;
+import java.util.Optional;
+import java.util.UUID;
+import java.util.logging.Logger;
+import org.bukkit.plugin.Plugin;
+import org.junit.jupiter.api.Test;
+
+class WarTerritorySettlementEventTest {
+  private final NationId original = NationId.random();
+  private final NationId conqueror = NationId.random();
+  private final ChunkCoordinate coordinate = new ChunkCoordinate("world", 4, 7);
+  private final TerritoryService territory = mock(TerritoryService.class);
+
+  WarTerritoryIntegrationListener listener() {
+    var plugin = mock(Plugin.class);
+    when(plugin.getLogger()).thenReturn(Logger.getAnonymousLogger());
+    var listener =
+        new WarTerritoryIntegrationListener(
+            plugin, mock(WarService.class), mock(NationService.class), territory, null);
+    listener.recordChunkOccupation(coordinate, original, conqueror, UUID.randomUUID());
+    return listener;
+  }
+
+  void end(WarTerritoryIntegrationListener listener, WarEndedEvent event) throws Exception {
+    var method =
+        WarTerritoryIntegrationListener.class.getDeclaredMethod("onWarEnded", WarEndedEvent.class);
+    method.setAccessible(true);
+    method.invoke(listener, event);
+  }
+
+  @Test
+  void durableSettlementClearsOccupationWithoutInferringTerritorialCession() throws Exception {
+    var listener = listener();
+    var war = War.declare("political settlement", original, conqueror, WarGoal.TERRITORIAL);
+    var operation = UUID.randomUUID();
+    var event = new WarEndedEvent(war, WarEndedEvent.WarEndReason.PEACE_TREATY, operation);
+    end(listener, event);
+    assertThat(event.getTreatyOperationId()).contains(operation);
+    assertThat(listener.isChunkOccupied(coordinate)).isFalse();
+    verifyNoInteractions(territory);
+  }
+
+  @Test
+  void legacyPeaceEventRetainsItsExistingRestorationBehavior() throws Exception {
+    var listener = listener();
+    var war = War.declare("legacy settlement", original, conqueror, WarGoal.TERRITORIAL);
+    when(territory.claimAt(coordinate))
+        .thenReturn(Optional.of(new TerritoryClaim(conqueror.toString(), coordinate)));
+    var event = new WarEndedEvent(war, WarEndedEvent.WarEndReason.PEACE_TREATY);
+    end(listener, event);
+    assertThat(event.getTreatyOperationId()).isEmpty();
+    assertThat(listener.isChunkOccupied(coordinate)).isFalse();
+    verify(territory).unclaim(conqueror.toString(), coordinate);
+    verify(territory).claim(original.toString(), coordinate);
+  }
+}
