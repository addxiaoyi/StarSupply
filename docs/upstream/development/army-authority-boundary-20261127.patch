+  @ParameterizedTest
+  @ValueSource(strings = {"EXACT", "DIFFERENT", "UNREADABLE"})
+  void uncertainSqlCommitOnlySucceedsAfterExactIntendedImageReadback(String outcome)
+      throws Exception {
+    var backend = backend(true);
+    var inject = new AtomicBoolean();
+    var offline = new AtomicBoolean();
+    var afterCommit = new AtomicReference<Runnable>();
+    var faultySource = mock(DataSource.class);
+    when(faultySource.getConnection())
+        .thenAnswer(
+            call -> {
+              if (offline.get()) throw new SQLException("readback unavailable");
+              var delegate = DriverManager.getConnection(backend.url());
+              return Proxy.newProxyInstance(
+                  Connection.class.getClassLoader(),
+                  new Class<?>[] {Connection.class},
+                  (proxy, method, arguments) -> {
+                    try {
+                      Object result = method.invoke(delegate, arguments);
+                      if (method.getName().equals("commit") && inject.compareAndSet(true, false)) {
+                        var callback = afterCommit.get();
+                        if (callback != null) callback.run();
+                        throw new SQLException("lost write acknowledgement");
+                      }
+                      return result;
+                    } catch (InvocationTargetException error) {
+                      throw error.getCause();
+                    }
+                  });
+            });
+    var storage = new ArmySqlAuthorityStorage(backend.directory(), faultySource);
+    var initial = storage.initializeFromLegacy(imported());
+    var intendedDraft = replace(initial, advance(initial.armies().get(firstId)));
+    var competitor = backend.storage();
+    if (outcome.equals("DIFFERENT"))
+      afterCommit.set(
+          () -> {
+            var actual = competitor.load();
+            competitor.commit(actual, replace(actual, advance(actual.armies().get(secondId))));
+          });
+    else if (outcome.equals("UNREADABLE")) afterCommit.set(() -> offline.set(true));
+    inject.set(true);
+    if (outcome.equals("EXACT")) {
+      var confirmed = storage.commit(initial, intendedDraft);
+      assertThat(confirmed).isEqualTo(intendedDraft.withRevision(initial.revision() + 1));
+      assertThat(backend.storage().load()).isEqualTo(confirmed);
+    } else {
+      assertThatThrownBy(() -> storage.commit(initial, intendedDraft))
+          .isInstanceOf(RuntimeException.class);
+      if (outcome.equals("UNREADABLE")) {
+        assertThatThrownBy(storage::snapshot).hasMessageContaining("unavailable");
+        offline.set(false);
+        assertThat(storage.load()).isEqualTo(intendedDraft.withRevision(initial.revision() + 1));
+      } else {
+        assertThat(storage.snapshot()).isEqualTo(competitor.snapshot());
+        assertThat(storage.snapshot().revision()).isEqualTo(initial.revision() + 2);
+      }
+      assertThatThrownBy(() -> storage.commit(initial, intendedDraft))
+          .hasMessageContaining("predecessor conflict");
+    }
+  }
