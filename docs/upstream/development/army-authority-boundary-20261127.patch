+        before.supplyConsumptionRemainder(),
+        before.createdAt(),
+        before.lastUpdated());
+  }
+
+  private static ArmyToken next(ArmyToken before) {
+    return new ArmyToken(
+        before.armyId(), before.incarnation(), Math.addExact(before.generation(), 1));
+  }
+
+  private static ArmyTombstone tombstone(ArmySnapshot before, long generation) {
+    return new ArmyTombstone(
+        new ArmyToken(before.token().armyId(), before.token().incarnation(), generation),
