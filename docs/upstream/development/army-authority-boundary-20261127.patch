+  private WarSettlementAdmissionService.Request changedSourceRequest(
+      WarSettlementAdmissionService.Request original, String changed) {
+    var originalWar = original.war();
+    var changedWar =
+        new ExactWar(
+            changed.equals("warId") ? UUID.randomUUID() : originalWar.warId(),
+            originalWar.attacker(),
+            originalWar.defender(),
+            changed.equals("declaredAt")
+                ? originalWar.declaredAt().plusNanos(1)
+                : originalWar.declaredAt(),
+            changed.equals("allies") ? List.of() : originalWar.attackerAllies(),
+            originalWar.defenderAllies());
+    return new WarSettlementAdmissionService.Request(
+        changed.equals("operationId") ? UUID.randomUUID() : original.operationId(),
+        changed.equals("treatyId") ? UUID.randomUUID() : original.treatyId(),
+        changedWar,
+        original.warGeneration() + (changed.equals("warGeneration") ? 1 : 0),
+        changed.equals("warFingerprint") ? "b".repeat(64) : original.warFingerprint(),
+        changed.equals("scopes")
+            ? original.scopes().subList(0, original.scopes().size() - 1)
+            : original.scopes(),
+        changed.equals("planHash") ? "b".repeat(64) : original.planHash(),
+        changed.equals("preparedAt") ? original.preparedAt().plusNanos(1) : original.preparedAt());
+  }
