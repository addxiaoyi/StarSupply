+        IllegalArgumentException.class,
+        () ->
+            ArmyAuthorityState.validateObservation(
+                retired, image(3, Map.of(), Map.of(ARMY_ID, rewritten), Map.of())));
+    assertThrows(
+        IllegalArgumentException.class,
+        () ->
+            ArmyAuthorityState.validateCommit(
+                before, image(2, Map.of(), Map.of(ARMY_ID, tombstone(army(1), 3)), Map.of())));
+  }
+
+  @Test
+  void deletionCannotDisappearOrInventANewTombstoneAfterInitialization() {
+    assertThrows(
+        IllegalArgumentException.class,
+        () ->
+            ArmyAuthorityState.validateCommit(live(1, 1), image(2, Map.of(), Map.of(), Map.of())));
+    ArmyAuthoritySnapshot empty = image(1, Map.of(), Map.of(), Map.of());
+    ArmyAuthoritySnapshot injected =
+        image(2, Map.of(), Map.of(ARMY_ID, tombstone(army(1), 1)), Map.of());
+    assertThrows(
+        IllegalArgumentException.class, () -> ArmyAuthorityState.validateCommit(empty, injected));
+    assertDoesNotThrow(
+        () -> ArmyAuthorityState.validateObservation(empty, injected.withRevision(3)));
+  }
+
+  @Test
+  void priorReceiptsRemainExactAfterRetirementAndCannotBeDeletedOrRewritten() {
+    ArmyLogisticsReceipt receipt =
+        new ArmyLogisticsReceipt(REQUEST_ID, ARMY_ID, NATION_ID, 25, 0, null);
+    ArmyAuthoritySnapshot before =
