+  private List<EffectProof> settlementEffects(
+      WarSettlementAdmissionService.Request request,
+      DiplomacyTreatyOperationService receiver,
+      boolean boundOnly) {
+    TreatyEffectManifest.requireSupported(request.manifest());
+    if (receiver == null)
+      throw new IllegalStateException("Durable treaty proof reader unavailable");
+    if (boundOnly) {
+      receiver.requireEffectProofPersistence();
+      requireSettlementReceiver(receiver);
+    }
+    var proofs = new ArrayList<EffectProof>();
+    for (var entry : request.manifest().entries()) {
+      var proof =
+          receiver
+              .settlementEffect(entry.receiverId(), entry.receiverVersion(), request.operationId())
+              .orElseThrow(
+                  () -> new IllegalStateException("Durable treaty effect binding missing"));
+      if (!proof.binding().equals(request)
+          || !proof.entry().equals(entry)
+          || boundOnly && proof.phase() != Phase.BOUND)
+        throw new IllegalStateException("Treaty effect does not match exact bound manifest");
+      proofs.add(proof);
+    }
+    requireSettlementReceiver(receiver);
+    return List.copyOf(proofs);
+  }
