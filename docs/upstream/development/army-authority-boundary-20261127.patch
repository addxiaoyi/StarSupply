+  public IncidentBundleResult create(UUID transactionId) {
+    Objects.requireNonNull(transactionId, "transactionId");
+    TransactionRecord transaction =
+        transactions
+            .find(transactionId)
+            .orElseThrow(
+                () -> new IllegalArgumentException("Transaction not found: " + transactionId));
+    EvidenceReplaySnapshot evidence =
+        replay
+            .find(transactionId)
+            .orElseThrow(
+                () -> new IllegalStateException("Replay evidence disappeared: " + transactionId));
+    ModuleHealthSnapshot health = healthCenter.snapshot();
+    List<String> errors = new ArrayList<>();
+    List<IncidentArtifact> artifacts = collectArtifacts(transactionId, transaction, errors);
+    List<EvidenceReplayEvent> providerEvidence = replay.sourceEvidence(transactionId);
+
+    Map<String, byte[]> entries = new LinkedHashMap<>();
+    entries.put("transaction.json", jsonBytes(transactionDocument(transaction)));
+    entries.put("refund.json", jsonBytes(refundDocument(evidence)));
+    entries.put("audit.json", jsonBytes(auditDocument(providerEvidence)));
+    entries.put("domain-evidence.json", jsonBytes(domainDocument(providerEvidence, artifacts)));
+    entries.put("health.json", jsonBytes(healthDocument(health)));
+    entries.put("insurance.json", jsonBytes(insuranceDocument(transactionId)));
+
+    entries.put(MANIFEST, jsonBytes(manifest(transactionId, transaction, entries, errors)));
+    List<String> orderedEntries = entries.keySet().stream().sorted().toList();
+    byte[] archiveBytes = zipBytes(entries, orderedEntries);
+
+    try {
+      Files.createDirectories(outputDirectory);
+      Path normalizedOutput = outputDirectory.toAbsolutePath().normalize();
+      Path archive = normalizedOutput.resolve(transactionId + ".zip").normalize();
+      if (!archive.getParent().equals(normalizedOutput)) {
+        throw new IllegalStateException("Incident bundle path escaped output directory");
+      }
+      Path temporary = archive.resolveSibling(archive.getFileName() + ".tmp");
+      Files.write(
+          temporary,
+          archiveBytes,
+          StandardOpenOption.CREATE,
+          StandardOpenOption.TRUNCATE_EXISTING,
+          StandardOpenOption.WRITE);
+      try {
+        Files.move(
+            temporary,
+            archive,
+            StandardCopyOption.REPLACE_EXISTING,
+            StandardCopyOption.ATOMIC_MOVE);
+      } catch (java.nio.file.AtomicMoveNotSupportedException unsupported) {
+        Files.move(temporary, archive, StandardCopyOption.REPLACE_EXISTING);
+      }
+      return new IncidentBundleResult(
+          transactionId, archive, sha256(archiveBytes), orderedEntries, errors);
+    } catch (IOException exception) {
+      throw new IllegalStateException(
+          "Unable to write incident bundle " + transactionId, exception);
     }
