@@ -0,0 +1,82 @@
+package dev.starcore.starcore.war;
+
+import dev.starcore.starcore.core.persistence.DurablePropertiesStore;
+import java.util.*;
+
+final class WarRowVersion {
+  static final String PREFIX = "warGeneration.";
+
+  static long generation(Properties state, UUID warId) {
+    String value = state.getProperty(PREFIX + warId, "0");
+    long generation = Long.parseLong(value);
+    if (generation < 0 || !Long.toString(generation).equals(value))
+      throw new IllegalArgumentException("Invalid war row generation");
+    return generation;
+  }
+
+  static void validate(Properties state) {
+    for (UUID warId : WarAuthority.family(state, PREFIX).keySet()) {
+      if (generation(state, warId) == 0
+          || !state.containsKey(WarAuthority.WAR + warId)
+              && !state.containsKey(WarAuthority.ARCHIVED_WAR + warId)
+              && !state.containsKey(WarAuthority.DELETED + warId))
+        throw new IllegalArgumentException("Orphan or empty war row generation");
+    }
+  }
+
+  static Properties advance(Properties previous, Properties supplied, WarAuthority authority) {
+    if (!WarAuthority.family(previous, PREFIX).equals(WarAuthority.family(supplied, PREFIX)))
+      throw new IllegalArgumentException("War row generations are authority owned");
+    var next = DurablePropertiesStore.copy(supplied);
+    var ids = new HashSet<>(WarAuthority.family(previous, WarAuthority.WAR).keySet());
+    ids.addAll(WarAuthority.family(next, WarAuthority.WAR).keySet());
+    for (UUID id : ids) {
+      String before = previous.getProperty(WarAuthority.WAR + id);
+      String after = next.getProperty(WarAuthority.WAR + id);
+      if (before == null
+          && after != null
+          && (previous.containsKey(WarAuthority.ARCHIVED_WAR + id)
+              || previous.containsKey(WarAuthority.DELETED + id)))
+        throw new IllegalStateException("Archived war identity cannot be reused");
+      if (before != null && after != null) requireIdentity(authority, id, before, after);
+      if (!sameRow(authority, id, before, after))
+        next.setProperty(PREFIX + id, Long.toString(Math.addExact(generation(previous, id), 1)));
+    }
+    return next;
+  }
+
+  static void transition(Properties previous, Properties next, WarAuthority authority) {
+    if (previous.isEmpty()
+        || previous.size() == 1 && previous.containsKey(DurablePropertiesStore.REVISION)) return;
+    for (UUID id : WarAuthority.family(previous, PREFIX).keySet())
+      if (!next.containsKey(PREFIX + id) || generation(next, id) < generation(previous, id))
+        throw new IllegalArgumentException("War row generation cannot be removed or rewound");
+    var ids = new HashSet<>(WarAuthority.family(previous, WarAuthority.WAR).keySet());
+    ids.addAll(WarAuthority.family(next, WarAuthority.WAR).keySet());
+    for (UUID id : ids) {
+      String before = previous.getProperty(WarAuthority.WAR + id);
+      String after = next.getProperty(WarAuthority.WAR + id);
+      if (before != null && after != null) requireIdentity(authority, id, before, after);
+      if (!sameRow(authority, id, before, after)
+          && generation(next, id) <= generation(previous, id))
+        throw new IllegalArgumentException("Changed war row requires a newer generation");
+    }
+  }
+
+  private static void requireIdentity(
+      WarAuthority authority, UUID id, String before, String after) {
+    var original = authority.decodeWar(id, before);
+    var updated = authority.decodeWar(id, after);
+    if (!original.aggressor().equals(updated.aggressor())
+        || !original.defender().equals(updated.defender())
+        || !original.goal().equals(updated.goal())
+        || !original.declaredAt().equals(updated.declaredAt())
+        || original.isEnded() && !updated.isEnded())
+      throw new IllegalStateException("Original war identity and terminal state are immutable");
+  }
+
+  static boolean sameRow(WarAuthority authority, UUID id, String left, String right) {
+    if (left == null || right == null) return Objects.equals(left, right);
+    return authority.fingerprint(id, left).equals(authority.fingerprint(id, right));
+  }
+}
