+import java.util.*;
+import org.bukkit.command.CommandSender;
+import org.junit.jupiter.api.Test;
+
+class WarDeclarationRecoveryCommandTest {
+  WarService service =
+      mock(WarService.class, withSettings().extraInterfaces(WarDeclarationRecoveryService.class));
+  WarDeclarationRecoveryService recovery = (WarDeclarationRecoveryService) service;
+  CommandSender sender = mock(CommandSender.class);
+  WarCommand command =
+      new WarCommand(
+          service,
+          mock(NationService.class),
+          mock(DiplomacyRelationService.class),
+          mock(MessageService.class));
+
+  WarDeclarationRecoveryService.Receipt receipt() {
+    var a = NationId.random();
+    return new WarDeclarationRecoveryService.Receipt(
+        new WarDeclarationRecoveryService.Request(
+            UUID.randomUUID(), a, a, NationId.random(), WarGoal.TERRITORIAL),
+        BigDecimal.TEN,
+        Instant.ofEpochMilli(1000),
+        WarDeclarationRecoveryService.Status.PENDING,
+        null);
+  }
+
+  @Test
+  void unauthorizedRecoveryCannotReadOrReplayMoneyOperation() {
+    for (var args :
+        List.of(
+            new String[] {"declarationrecovery", "list"},
+            new String[] {"declarationrecovery", "show", UUID.randomUUID().toString()},
+            new String[] {"declarationrecovery", "retry", UUID.randomUUID().toString()},
+            new String[] {"declarationrecovery", "cancel", UUID.randomUUID().toString()}))
+      command.onCommand(sender, null, "war", args);
+    verifyNoInteractions(service);
+  }
+
+  @Test
+  void authorizedListAndShowAreReadOnlyAndRetryUsesExactOriginalId() {
+    when(sender.hasPermission("starcore.war.admin")).thenReturn(true);
+    var r = receipt();
+    var id = r.request().operationId();
+    when(recovery.pendingWarDeclarations()).thenReturn(List.of(r));
+    when(recovery.warDeclaration(id)).thenReturn(Optional.of(r));
+    when(recovery.recoverWarDeclaration(id)).thenReturn(r);
+    command.onCommand(sender, null, "war", new String[] {"declarationrecovery", "list"});
+    command.onCommand(
+        sender, null, "war", new String[] {"declarationrecovery", "show", id.toString()});
+    verify(recovery).pendingWarDeclarations();
+    verify(recovery).warDeclaration(id);
+    verify(recovery, never()).recoverWarDeclaration(any());
+    command.onCommand(
+        sender, null, "war", new String[] {"declarationrecovery", "retry", id.toString()});
+    verify(recovery).recoverWarDeclaration(id);
+    verifyNoMoreInteractions(service);
+  }
+
+  @Test
+  void malformedIdCannotGenerateANewOperation() {
+    when(sender.hasPermission("starcore.war.admin")).thenReturn(true);
+    command.onCommand(
+        sender, null, "war", new String[] {"declarationrecovery", "retry", "wrong-id"});
+    command.onCommand(
+        sender, null, "war", new String[] {"declarationrecovery", "cancel", "wrong-id"});
+    verifyNoInteractions(service);
+  }
+
+  @Test
+  void authorizedCancelUsesExactOriginalId() {
+    when(sender.hasPermission("starcore.war.admin")).thenReturn(true);
+    var r = receipt();
+    var id = r.request().operationId();
+    when(recovery.cancelWarDeclaration(id)).thenReturn(r);
+    command.onCommand(
+        sender, null, "war", new String[] {"declarationrecovery", "cancel", id.toString()});
+    verify(recovery).cancelWarDeclaration(id);
+    verify(recovery, never()).recoverWarDeclaration(any());
+    verify(recovery, never()).declareWarWithReceipt(any());
+  }
+
+  @Test
+  void declarationRecoveryAndCancelAreAdminOnlySuggestions() {
+    when(sender.hasPermission("starcore.war.admin")).thenReturn(false);
+    org.junit.jupiter.api.Assertions.assertFalse(
+        command
+            .onTabComplete(sender, null, "war", new String[] {"declarationrecovery"})
+            .contains("declarationrecovery"));
+    org.junit.jupiter.api.Assertions.assertTrue(
+        command
+            .onTabComplete(sender, null, "war", new String[] {"declarationrecovery", "ca"})
+            .isEmpty());
+    when(sender.hasPermission("starcore.war.admin")).thenReturn(true);
+    org.junit.jupiter.api.Assertions.assertTrue(
+        command
+            .onTabComplete(sender, null, "war", new String[] {"declarationrecovery", "ca"})
+            .contains("cancel"));
+  }
+}
