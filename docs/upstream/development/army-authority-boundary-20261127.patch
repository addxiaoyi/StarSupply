+  private static Manifest rawSingle(Envelope envelope, String localHash) {
+    var scopes = closure(envelope.war());
+    return new Manifest(
+        envelope,
+        List.of(
+            new Entry(
+                "diplomacy",
+                2,
+                envelope.originalTerms().stream().map(OriginalTerm::termIndex).toList(),
+                localHash,
+                scopes)),
+        scopes);
+  }
+
+  private static List<PairScope> closure(ExactWar war) {
+    var result = new ArrayList<PairScope>();
+    var participants = war.participants();
+    for (int leftIndex = 0; leftIndex < participants.size(); leftIndex++)
+      for (int rightIndex = leftIndex + 1; rightIndex < participants.size(); rightIndex++)
+        result.add(PairScope.of(participants.get(leftIndex), participants.get(rightIndex)));
+    return List.copyOf(result);
+  }
+
+  private static List<PairScope> extendedScopes(ExactWar war, int count) {
+    var result = new ArrayList<>(closure(war));
+    for (int index = 100; result.size() < count; index++)
+      result.add(PairScope.of(ATTACKER, nation(index)));
+    return List.copyOf(result);
+  }
