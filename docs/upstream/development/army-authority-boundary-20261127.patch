+  @org.junit.jupiter.api.io.TempDir java.nio.file.Path directory;
+
+  private final Map<NationId, Nation> nations = new HashMap<>();
+  private AllianceServiceImpl service;
+  private NationId leaderId;
+  private NationId officerId;
+  private NationId memberId;
+  private NationId outsiderId;
+  private NationId otherLeaderId;
+
+  @BeforeEach
+  void setUp() throws Exception {
+    NationService nationService = mock(NationService.class);
+    when(nationService.nationById(any(NationId.class)))
