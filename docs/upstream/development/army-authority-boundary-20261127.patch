+  private void requireOperationAuthority() {
+    if (storage == null || operationService == null)
+      throw new IllegalStateException("Durable alliance storage and receiver are required");
+    if (stopped || stateLoadFailed)
+      throw new IllegalStateException("Relationship service unavailable");
