+  @Test
+  void pendingBindingsReserveSqlRevisionsAndRejectUnfinishableFrozenGenerations() {
+    try (var fixture = new DiplomacyRetirementTestFixture(root, false)) {
+      var module = fixture.open();
+      var reserved = reserve(module);
+      var bound = bound(reserved, binding(reserved));
