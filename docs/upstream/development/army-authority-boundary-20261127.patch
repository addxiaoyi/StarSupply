+      if (reserved) original = original.reserved(first.receiver.reserveTreaty(request).plan());
+      var execution = PeaceTreatyExecution.create(terms);
+      treaty.beginExecution();
+      execution.begin();
+      execution.batch(original);
+      var legacy =
+          JsonParser.parseString(
+                  new PeaceTreatyStateCodec()
+                      .encode(treaty, execution, List.of(), List.of(), List.of(), List.of()))
