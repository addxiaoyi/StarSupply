+  private void releaseBatch(PeaceTreaty treaty, PeaceTreatyExecution execution) {
+    PeaceTreatyBatch batch = execution.batch();
+    if (batch.plan() != null
+        && (batch.request().protocolVersion() == 1 || batch.binding() != null)) {
