+  @Test
+  void conversionRequiresAllArguments() {
+    ArmySnapshot snapshot = snapshot(position(WORLD_ID, "world"));
+    TrackingResolver resolver = new TrackingResolver(world(WORLD_ID, "world"), null);
+    ArmyUnit unit = unit(17, 73.25, new Location(world(WORLD_ID, "world"), 0, 64, 0));
+
+    assertThrows(
+        NullPointerException.class,
+        () -> ArmySnapshotViews.toDetachedUnit(null, resolver, LegacyWorldPolicy.REJECT_NAME_ONLY));
+    assertThrows(
+        NullPointerException.class,
+        () -> ArmySnapshotViews.toDetachedUnit(snapshot, null, LegacyWorldPolicy.REJECT_NAME_ONLY));
+    assertThrows(
+        NullPointerException.class,
+        () -> ArmySnapshotViews.toDetachedUnit(snapshot, resolver, null));
+    assertThrows(NullPointerException.class, () -> ArmySnapshotViews.fromDetachedUnit(null, TOKEN));
+    assertThrows(NullPointerException.class, () -> ArmySnapshotViews.fromDetachedUnit(unit, null));
+  }
+
+  private static ArmyPosition position(UUID worldId, String worldName) {
+    return new ArmyPosition(worldId, worldName, -123.25, 64.75, 987.5, 135.5f, -37.25f);
+  }
+
+  private static ArmySnapshot snapshot(ArmyPosition position) {
+    return new ArmySnapshot(
+        TOKEN,
+        NATION_ID,
+        ArmyType.CAVALRY,
+        17,
+        73.25,
+        61.5,
+        position,
+        ArmyState.SIEGING,
+        42,
+        59,
+        CREATED_AT,
+        LAST_UPDATED);
+  }
+
+  private static ArmyUnit unit(int soldiers, double health, Location location) {
+    return new ArmyUnit(
+        ARMY_ID,
+        NATION_ID,
+        ArmyType.CAVALRY,
+        soldiers,
+        health,
+        61.5,
+        location,
+        ArmyState.SIEGING,
+        42,
+        CREATED_AT,
+        LAST_UPDATED,
+        59);
+  }
+
+  private static World world(UUID worldId, String worldName) {
+    return (World)
+        Proxy.newProxyInstance(
+            World.class.getClassLoader(),
+            new Class<?>[] {World.class},
+            (proxy, method, arguments) ->
+                switch (method.getName()) {
+                  case "getUID" -> worldId;
+                  case "getName" -> worldName;
+                  case "equals" -> proxy == arguments[0];
+                  case "hashCode" -> System.identityHashCode(proxy);
+                  case "toString" -> "World[" + worldId + "," + worldName + "]";
+                  default -> throw new UnsupportedOperationException(method.getName());
+                });
+  }
+
+  private static final class TrackingResolver implements ArmySnapshotViews.WorldResolver {
+    private final World byId;
+    private final World byName;
+    private final List<UUID> idLookups = new ArrayList<>();
+    private final List<String> nameLookups = new ArrayList<>();
+
+    private TrackingResolver(World byId, World byName) {
+      this.byId = byId;
+      this.byName = byName;
+    }
+
+    @Override
+    public Optional<World> byId(UUID worldId) {
+      idLookups.add(worldId);
+      return Optional.ofNullable(byId);
+    }
+
+    @Override
+    public Optional<World> byName(String worldName) {
+      nameLookups.add(worldName);
+      return Optional.ofNullable(byName);
+    }
+  }
+}
