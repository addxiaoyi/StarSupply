+package dev.starcore.starcore.module.diplomacy.alliance;
+
+import java.util.Objects;
+import java.util.UUID;
+
+public record AllianceProjectionOwner(UUID operationId, long generation, boolean active) {
+  public AllianceProjectionOwner(UUID operationId, long generation) {
+    this(operationId, generation, true);
+  }
+
+  public AllianceProjectionOwner {
+    Objects.requireNonNull(operationId);
+    if (generation < 1)
+      throw new IllegalArgumentException("Invalid alliance projection generation");
+  }
+
+  public AllianceProjectionOwner invalidate() {
+    return active ? new AllianceProjectionOwner(operationId, generation, false) : this;
+  }
+}
