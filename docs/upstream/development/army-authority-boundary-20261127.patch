+
+  private boolean matchesOriginalState(
+      AllianceStorage.StateSnapshot state, AllianceOperationIntent intent) {
+    return Objects.equals(state.alliances().get(intent.pair()), intent.originalAlliance())
+        && Objects.equals(state.cooldowns().get(intent.pair()), intent.originalCooldown())
+        && (intent.originalInvite() == null
+            || Objects.equals(
+                state.invites().get(intent.originalInvite()), intent.originalInviteAt()));
+  }
+
+  private void saveOperationState(
+      AllianceStorage.StateSnapshot base,
+      Map<AlliancePairKey, AllianceInfoData> nextAlliances,
+      Map<AllianceInviteKey, Instant> nextInvites,
+      Map<AlliancePairKey, Instant> nextCooldowns,
+      Map<UUID, AllianceOperationIntent> nextIntents,
+      Map<AlliancePairKey, AllianceProjectionOwner> nextOwners) {
+    if (stopped) throw new IllegalStateException("Relationship service stopped");
+    storage.saveOperationStateSync(
+        new AllianceStorage.StateSnapshot(
+            nextAlliances,
+            nextInvites,
+            nextCooldowns,
+            base.revision(),
+            base.retirements(),
+            nextIntents,
+            nextOwners));
+    applyState(storage.snapshot());
+  }
