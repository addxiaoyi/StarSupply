+          invoke(() -> settlementAdmission.settlementAdmission(batch.request().operationId()));
+      requireRunning();
+      if (admission.isPresent() && admission.orElseThrow().accepted()) {
+        if (!warRequest(batch).equals(admission.orElseThrow().request()))
+          throw new IllegalStateException("TREATY_WAR_ADMISSION_MISMATCH");
+        var request =
+            new WarSettlementAdmissionService.ReleaseRequest(
+                batch.request().operationId(), warRequest(batch).planHash());
+        var receipt = invoke(() -> settlementAdmission.releaseSettlement(request));
+        requireRunning();
+        if (!request.equals(receipt.request())
+            || !receipt.status().name().equals(batch.terminalReceipt().status().name()))
+          throw new IllegalStateException("TREATY_WAR_RELEASE_MISMATCH");
+        if (batch.request().protocolVersion() == 2) {
+          var proof =
+              new EffectProof(
+                  batch.binding(),
+                  batch.binding().manifest().entries().getFirst(),
+                  Phase.valueOf(batch.terminalReceipt().status().name()),
+                  batch.terminalReceipt().terminalAt(),
+                  batch.terminalReceipt().terminalEvidence());
+          if (receipt.protocolVersion() != 2 || !receipt.effectProofs().equals(List.of(proof)))
+            throw new IllegalStateException("TREATY_WAR_RELEASE_VECTOR_MISMATCH");
+        }
+      }
+    }
+    execution.batch(batch.advance(PeaceTreatyBatch.Stage.RELEASED));
+    saveTreaty(treaty);
+  }
