@@ -0,0 +1,410 @@
+package dev.starcore.starcore.module.diplomacy;
+
+import dev.starcore.starcore.module.diplomacy.DiplomacyTreatyOperationService.*;
+import dev.starcore.starcore.module.nation.model.NationId;
+import dev.starcore.starcore.module.war.WarSettlementEffectProofCodec;
+import dev.starcore.starcore.treaty.TreatyEffectManifest;
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.DataInputStream;
+import java.io.DataOutputStream;
+import java.io.IOException;
+import java.io.OutputStream;
+import java.nio.charset.StandardCharsets;
+import java.time.Instant;
+import java.util.ArrayList;
+import java.util.Base64;
+import java.util.List;
+import java.util.UUID;
+
+final class DiplomacyTreatyOperationCodec {
+  private static final int MAX_BYTES = 16 * 1024 * 1024;
+  private static final int MAX_ENCODED_LENGTH = (MAX_BYTES + 2) / 3 * 4;
+  private static final int MAX_ENVELOPE_TEXT_BYTES = (2 * 1024 * 1024 + 2) / 3 * 4;
+
+  private DiplomacyTreatyOperationCodec() {}
+
+  static String encode(OperationView view) {
+    return Base64.getEncoder().encodeToString(bytes(output -> writeView(output, view)));
+  }
+
+  static long encodedValueBytes(OperationView view) {
+    var bytes = new SizeOutputStream();
+    try (var output = new DataOutputStream(bytes)) {
+      writeView(output, view, bytes);
+    } catch (IOException failure) {
+      throw new IllegalArgumentException("Unable to measure treaty operation", failure);
+    }
+    return Math.addExact((bytes.size + 2) / 3 * 4, (3 - bytes.size % 3) % 3);
+  }
+
+  static OperationView decode(String value) {
+    if (value.length() > MAX_ENCODED_LENGTH)
+      throw new IllegalArgumentException("Treaty operation encoding is too large");
+    byte[] decoded = Base64.getDecoder().decode(value);
+    if (decoded.length > MAX_BYTES)
+      throw new IllegalArgumentException("Treaty operation encoding is too large");
+    try (var input = new DataInputStream(new ByteArrayInputStream(decoded))) {
+      int version = input.readInt();
+      if (version != 1 && version != TreatyEffectManifest.VERSION)
+        throw new IllegalArgumentException("Invalid treaty operation schema");
+      var request = version == 1 ? request(input) : requestV2(input);
+      Plan plan = null;
+      if (input.readBoolean()) {
+        var pairs = pairs(input);
+        var terms = terms(input);
+        plan = new Plan(request, pairs, terms, input.readUTF());
+        if (!hash(request, pairs, terms).equals(plan.planHash()))
+          throw new IllegalArgumentException("Treaty plan hash mismatch");
+      }
+      OperationView result;
+      if (version == TreatyEffectManifest.VERSION && input.readBoolean()) {
+        var proof =
+            WarSettlementEffectProofCodec.decode(
+                text(input, WarSettlementEffectProofCodec.MAX_ENCODED_LENGTH));
+        var status =
+            switch (proof.phase()) {
+              case BOUND -> Status.RESERVED;
+              case APPLIED -> Status.APPLIED;
+              case CANCELLED -> Status.CANCELLED;
+              case SUPERSEDED -> Status.SUPERSEDED;
+            };
+        result =
+            new OperationView(
+                request,
+                plan,
+                status,
+                proof.terminalAt(),
+                proof.binding(),
+                proof.terminalEvidence());
+        if (!result.effectProof().orElseThrow().equals(proof))
+          throw new IllegalArgumentException("Treaty operation proof differs from receiver entry");
+      } else {
+        result = new OperationView(request, plan, Status.valueOf(input.readUTF()), time(input));
+      }
+      if (input.available() != 0 || !encode(result).equals(value))
+        throw new IllegalArgumentException("Noncanonical treaty operation encoding");
+      return result;
+    } catch (IOException failure) {
+      throw new IllegalArgumentException("Invalid treaty operation encoding", failure);
+    }
+  }
+
+  static String hash(ReserveRequest request, List<PairPlan> pairs, List<TermPlan> terms) {
+    try {
+      return java.util.HexFormat.of()
+          .formatHex(
+              java.security.MessageDigest.getInstance("SHA-256")
+                  .digest(
+                      bytes(
+                          output -> {
+                            if (request.protocolVersion() == 1) {
+                              request(output, request);
+                            } else {
+                              output.writeUTF("starcore:diplomacy:treaty-local-plan:v2");
+                              output.writeUTF(
+                                  TreatyEffectManifest.requestDigest(request.envelope()));
+                              output.writeUTF(TreatyEffectManifest.DIPLOMACY);
+                              output.writeInt(TreatyEffectManifest.VERSION);
+                              indexes(output, request.assignedTermIndexes());
+                            }
+                            pairs(output, pairs);
+                            terms(output, terms);
+                          })));
+    } catch (java.security.NoSuchAlgorithmException failure) {
+      throw new IllegalStateException(failure);
+    }
+  }
+
+  private interface Writer {
+    void write(DataOutputStream output) throws IOException;
+  }
+
+  private static byte[] bytes(Writer writer) {
+    try {
+      var bytes = new ByteArrayOutputStream();
+      try (var output = new DataOutputStream(bytes)) {
+        writer.write(output);
+      }
+      if (bytes.size() > MAX_BYTES)
+        throw new IllegalArgumentException("Treaty operation encoding is too large");
+      return bytes.toByteArray();
+    } catch (IOException failure) {
+      throw new IllegalArgumentException("Unable to encode treaty operation", failure);
+    }
+  }
+
+  private static void writeView(DataOutputStream output, OperationView view) throws IOException {
+    writeView(output, view, null);
+  }
+
+  private static void writeView(DataOutputStream output, OperationView view, SizeOutputStream size)
+      throws IOException {
+    if (view.request().protocolVersion() == 1) {
+      output.writeInt(1);
+      request(output, view.request());
+    } else {
+      output.writeInt(TreatyEffectManifest.VERSION);
+      text(
+          output,
+          TreatyEffectManifest.encodeEnvelope(view.request().envelope()),
+          MAX_ENVELOPE_TEXT_BYTES);
+      indexes(output, view.request().assignedTermIndexes());
+    }
+    output.writeBoolean(view.plan() != null);
+    if (view.plan() != null) {
+      pairs(output, view.plan().pairs());
+      terms(output, view.plan().terms());
+      output.writeUTF(view.planHash());
+    }
+    if (view.request().protocolVersion() == TreatyEffectManifest.VERSION) {
+      output.writeBoolean(view.binding() != null);
+      if (view.binding() != null) {
+        if (size != null) {
+          int length =
+              WarSettlementEffectProofCodec.encodedLength(view.effectProof().orElseThrow());
+          output.writeInt(length);
+          size.add(length);
+          return;
+        }
+        text(
+            output,
+            WarSettlementEffectProofCodec.encode(view.effectProof().orElseThrow()),
+            WarSettlementEffectProofCodec.MAX_ENCODED_LENGTH);
+        return;
+      }
+    }
+    output.writeUTF(view.status().name());
+    time(output, view.terminalAt());
+  }
+
+  private static final class SizeOutputStream extends OutputStream {
+    private long size;
+
+    @Override
+    public void write(int value) {
+      add(1);
+    }
+
+    @Override
+    public void write(byte[] bytes, int offset, int length) {
+      java.util.Objects.checkFromIndexSize(offset, length, bytes.length);
+      add(length);
+    }
+
+    void add(long length) {
+      size = Math.addExact(size, length);
+      if (size > MAX_BYTES)
+        throw new IllegalArgumentException("Treaty operation encoding is too large");
+    }
+  }
+
+  private static ReserveRequest requestV2(DataInputStream input) throws IOException {
+    var envelope = TreatyEffectManifest.decodeEnvelope(text(input, MAX_ENVELOPE_TEXT_BYTES));
+    var assigned = indexes(input);
+    var terms = new ArrayList<IndexedTerm>();
+    for (int index : assigned) {
+      if (index < 0 || index >= envelope.originalTerms().size())
+        throw new IllegalArgumentException("Foreign treaty receiver assignment");
+      var original = envelope.originalTerms().get(index);
+      if (!original.type().equals("PoliticalTerm"))
+        throw new IllegalArgumentException("Unsupported treaty receiver term");
+      terms.add(
+          new IndexedTerm(
+              index, original.type(), original.payload().getFirst(), original.description()));
+    }
+    return new ReserveRequest(
+        envelope.operationId(),
+        envelope.treatyId(),
+        envelope.war(),
+        envelope.warGeneration(),
+        envelope.warFingerprint(),
+        envelope.victor(),
+        envelope.defeated(),
+        envelope.preparedAt(),
+        envelope.originalTerms().size(),
+        terms,
+        TreatyEffectManifest.VERSION,
+        envelope,
+        assigned);
+  }
+
+  private static void indexes(DataOutputStream output, List<Integer> indexes) throws IOException {
+    output.writeInt(indexes.size());
+    for (int index : indexes) output.writeInt(index);
+  }
+
+  private static List<Integer> indexes(DataInputStream input) throws IOException {
+    int size = count(input, DiplomacyTreatyOperationService.MAX_TERMS);
+    var indexes = new ArrayList<Integer>();
+    for (int index = 0; index < size; index++) indexes.add(input.readInt());
+    return indexes;
+  }
+
+  private static void request(DataOutputStream output, ReserveRequest request) throws IOException {
+    uuid(output, request.operationId());
+    uuid(output, request.treatyId());
+    var war = request.war();
+    uuid(output, war.warId());
+    nation(output, war.attacker());
+    nation(output, war.defender());
+    time(output, war.declaredAt());
+    nations(output, war.attackerAllies());
+    nations(output, war.defenderAllies());
+    output.writeLong(request.warGeneration());
+    output.writeUTF(request.warFingerprint());
+    nation(output, request.victor());
+    nation(output, request.defeated());
+    time(output, request.preparedAt());
+    output.writeInt(request.originalTermCount());
+    output.writeInt(request.terms().size());
+    for (var term : request.terms()) {
+      output.writeInt(term.termIndex());
+      output.writeUTF(term.type());
+      output.writeUTF(term.requirement());
+      output.writeUTF(term.description());
+    }
+  }
+
+  private static ReserveRequest request(DataInputStream input) throws IOException {
+    UUID operationId = uuid(input);
+    UUID treatyId = uuid(input);
+    var war =
+        new ExactWar(
+            uuid(input), nation(input), nation(input), time(input), nations(input), nations(input));
+    long generation = input.readLong();
+    String fingerprint = input.readUTF();
+    var victor = nation(input);
+    var defeated = nation(input);
+    var preparedAt = time(input);
+    int originalCount = input.readInt();
+    int count = count(input, DiplomacyTreatyOperationService.MAX_TERMS);
+    var terms = new ArrayList<IndexedTerm>();
+    for (int index = 0; index < count; index++)
+      terms.add(
+          new IndexedTerm(input.readInt(), input.readUTF(), input.readUTF(), input.readUTF()));
+    return new ReserveRequest(
+        operationId,
+        treatyId,
+        war,
+        generation,
+        fingerprint,
+        victor,
+        defeated,
+        preparedAt,
+        originalCount,
+        terms);
+  }
+
+  private static void pairs(DataOutputStream output, List<PairPlan> pairs) throws IOException {
+    output.writeInt(pairs.size());
+    for (var pair : pairs) {
+      nation(output, pair.pair().left());
+      nation(output, pair.pair().right());
+      output.writeUTF(pair.expectedRelation().name());
+      output.writeLong(pair.expectedGeneration());
+      output.writeUTF(pair.targetRelation().name());
+    }
+  }
+
+  private static List<PairPlan> pairs(DataInputStream input) throws IOException {
+    int count = count(input, DiplomacyTreatyOperationService.MAX_PAIRS);
+    var result = new ArrayList<PairPlan>();
+    for (int index = 0; index < count; index++)
+      result.add(
+          new PairPlan(
+              new PairScope(nation(input), nation(input)),
+              DiplomacyRelation.valueOf(input.readUTF()),
+              input.readLong(),
+              DiplomacyRelation.valueOf(input.readUTF())));
+    return result;
+  }
+
+  private static void terms(DataOutputStream output, List<TermPlan> terms) throws IOException {
+    output.writeInt(terms.size());
+    for (var term : terms) {
+      output.writeInt(term.termIndex());
+      uuid(output, term.restrictionId());
+      time(output, term.imposedAt());
+      output.writeUTF(term.requirement());
+      output.writeUTF(term.description());
+      nation(output, term.nationId());
+    }
+  }
+
+  private static List<TermPlan> terms(DataInputStream input) throws IOException {
+    int count = count(input, DiplomacyTreatyOperationService.MAX_TERMS);
+    var result = new ArrayList<TermPlan>();
+    for (int index = 0; index < count; index++)
+      result.add(
+          new TermPlan(
+              input.readInt(),
+              uuid(input),
+              time(input),
+              input.readUTF(),
+              input.readUTF(),
+              nation(input)));
+    return result;
+  }
+
+  private static void nations(DataOutputStream output, List<NationId> nations) throws IOException {
+    output.writeInt(nations.size());
+    for (var nation : nations) nation(output, nation);
+  }
+
+  private static List<NationId> nations(DataInputStream input) throws IOException {
+    int count = count(input, 90);
+    var result = new ArrayList<NationId>();
+    for (int index = 0; index < count; index++) result.add(nation(input));
+    return result;
+  }
+
+  private static int count(DataInputStream input, int maximum) throws IOException {
+    int value = input.readInt();
+    if (value < 0 || value > maximum) throw new IllegalArgumentException("Invalid treaty count");
+    return value;
+  }
+
+  private static void text(DataOutputStream output, String value, int maximum) throws IOException {
+    byte[] encoded = value.getBytes(StandardCharsets.UTF_8);
+    if (encoded.length > maximum)
+      throw new IllegalArgumentException("Treaty operation text is too large");
+    output.writeInt(encoded.length);
+    output.write(encoded);
+  }
+
+  private static String text(DataInputStream input, int maximum) throws IOException {
+    int size = count(input, maximum);
+    if (size > input.available()) throw new IllegalArgumentException("Truncated treaty text");
+    return new String(input.readNBytes(size), StandardCharsets.UTF_8);
+  }
+
+  private static void nation(DataOutputStream output, NationId nation) throws IOException {
+    uuid(output, nation.value());
+  }
+
+  private static NationId nation(DataInputStream input) throws IOException {
+    return NationId.of(uuid(input));
+  }
+
+  private static void uuid(DataOutputStream output, UUID id) throws IOException {
+    output.writeLong(id.getMostSignificantBits());
+    output.writeLong(id.getLeastSignificantBits());
+  }
+
+  private static UUID uuid(DataInputStream input) throws IOException {
+    return new UUID(input.readLong(), input.readLong());
+  }
+
+  private static void time(DataOutputStream output, Instant time) throws IOException {
+    output.writeBoolean(time != null);
+    if (time != null) {
+      output.writeLong(time.getEpochSecond());
+      output.writeInt(time.getNano());
+    }
+  }
+
+  private static Instant time(DataInputStream input) throws IOException {
+    return input.readBoolean() ? Instant.ofEpochSecond(input.readLong(), input.readInt()) : null;
+  }
+}
diff --git a/src/main/java/dev/starcore/starcore/module/diplomacy/DiplomacyTreatyOperationService.java b/src/main/java/dev/starcore/starcore/module/diplomacy/DiplomacyTreatyOperationService.java
