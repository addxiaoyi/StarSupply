+  private PairState readPair(AlliancePairKey pair) {
+    var state =
+        Objects.requireNonNull(
+            operationService.alliancePairState(pair.left(), pair.right()),
+            "Alliance receiver state");
+    if (!state.left().equals(pair.left()) || !state.right().equals(pair.right()))
+      throw new IllegalStateException("Alliance receiver pair mismatch");
+    return state;
+  }
