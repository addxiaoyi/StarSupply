+  @Test
+  void retryWaitsForEnableAndUsesOnlyTheNewAuthority() throws Exception {
+    try (var fixture = new DiplomacyRetirementTestFixture(root, false)) {
+      var module = fixture.open();
+      var pair = DiplomacyPairKey.of(left, right);
+      var oldRequest =
+          new DiplomacyAllianceOperationService.Request(
+              UUID.randomUUID(),
+              pair.left(),
+              pair.right(),
+              DiplomacyAllianceOperationService.Action.FORM,
+              right,
+              Instant.EPOCH.plusNanos(123_456_789),
+              DiplomacyRelation.NEUTRAL,
+              0);
+      var oldReceipt = module.applyAllianceOperation(oldRequest);
+      var oldEntry = pending(fixture).pending().values().iterator().next();
+      var oldConsumer = accepting();
+      module.disable(attach(module, oldConsumer));
+      var newEntry =
+          new DiplomacyDerivedEventState.Entry(
+              UUID.randomUUID(),
+              left,
+              right,
+              DiplomacyRelation.ALLIED,
+              DiplomacyRelation.NEUTRAL,
+              AllianceBrokenEvent.AllianceBreakReason.ADMIN_FORCE,
+              Instant.now());
+      var newState =
+          new AtomicReference<>(
+              DiplomacyAuthority.seal(
+                  DiplomacyDerivedEventState.empty().enqueue(newEntry).write(new Properties())));
+      var consumer = accepting();
+      var registry = new ServiceRegistry();
+      registry.register(EventService.class, consumer);
+      registry.register(NationService.class, mock(NationService.class));
+      var plugin = mock(JavaPlugin.class);
+      var server = mock(Server.class);
+      when(plugin.getServer()).thenReturn(server);
+      when(server.getPluginManager()).thenReturn(mock(PluginManager.class));
+      when(plugin.getConfig()).thenReturn(new YamlConfiguration());
+      when(plugin.getLogger()).thenReturn(Logger.getAnonymousLogger());
+      var persistence = mock(PersistenceService.class);
+      var startupEntered = new CountDownLatch(1);
+      var finishStartup = new CountDownLatch(1);
+      when(persistence.ensureNamespace("diplomacy"))
+          .thenAnswer(
+              ignored -> {
+                startupEntered.countDown();
+                if (!finishStartup.await(5, TimeUnit.SECONDS))
+                  throw new IllegalStateException("timed out waiting to finish enable");
+                return CompletableFuture.completedFuture(null);
+              });
+      var context =
+          new StarCoreContext(
+              plugin, null, null, null, null, persistence, null, null, null, null, registry);
+      var executor = Executors.newFixedThreadPool(2);
+      try {
+        var enabling =
+            executor.submit(
+                () -> {
+                  try (var storage =
+                          mockConstruction(
+                              DatabaseAwareDiplomacyStateStorage.class,
+                              (mock, ignored) -> {
+                                when(mock.load()).thenAnswer(invocation -> newState.get());
+                                doAnswer(
+                                        invocation -> {
+                                          newState.set(invocation.getArgument(0));
+                                          return null;
+                                        })
+                                    .when(mock)
+                                    .save(any());
+                              });
+                      var menus = mockConstruction(DiplomacyMenu.class);
+                      var scheduler = mockStatic(CompatScheduler.class)) {
+                    module.enable(context);
+                  }
+                });
+        assertThat(startupEntered.await(5, TimeUnit.SECONDS)).isTrue();
+        var retryStarted = new CountDownLatch(1);
+        var retry =
+            executor.submit(
+                () -> {
+                  retryStarted.countDown();
+                  return module.retryPendingDerivedEvents();
+                });
+        assertThat(retryStarted.await(5, TimeUnit.SECONDS)).isTrue();
+        assertThatThrownBy(() -> retry.get(100, TimeUnit.MILLISECONDS))
+            .isInstanceOf(TimeoutException.class);
+        verifyNoInteractions(oldConsumer, consumer);
+        finishStartup.countDown();
+        enabling.get(5, TimeUnit.SECONDS);
+        assertThat(retry.get(5, TimeUnit.SECONDS)).isOne();
+        verifyNoInteractions(oldConsumer);
+        verify(consumer)
+            .recordAllianceOnce(newEntry.eventId(), left, right, false, newEntry.createdAt());
+        verifyNoMoreInteractions(consumer);
+        assertThat(pending(fixture).pending()).containsOnlyKeys(oldEntry.eventId());
+        assertThat(DiplomacyDerivedEventState.read(newState.get()).pending()).isEmpty();
+        assertThat(module.allianceOperationReceipt(oldRequest.operationId())).isEmpty();
+        var newPair = module.alliancePairState(left, right);
+        assertThat(newPair.generation()).isZero();
+        assertThat(newPair.ownerOperationId()).isNull();
+        assertThat(newPair.relation()).isEqualTo(DiplomacyRelation.NEUTRAL);
+        assertThat(fixture.open().allianceOperationReceipt(oldRequest.operationId()))
+            .contains(oldReceipt);
+        module.disable(context);
+      } finally {
+        finishStartup.countDown();
+        executor.shutdownNow();
+        assertThat(executor.awaitTermination(5, TimeUnit.SECONDS)).isTrue();
+      }
+    }
+  }
