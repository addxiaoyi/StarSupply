+            original, Outcome.APPLIED, 1, DiplomacyRelation.NEUTRAL, DiplomacyRelation.ALLIED);
+    var valid = DiplomacyAllianceOperationState.empty().record(receipt).write(new Properties());
+    var missingHistory = DiplomacyAuthority.copy(valid);
+    missingHistory.remove(DiplomacyAllianceOperationState.PREFIX + "pair." + left + "." + right);
+    var truncatedReceipt = DiplomacyAuthority.copy(valid);
+    truncatedReceipt.setProperty(
+        DiplomacyAllianceOperationState.PREFIX + "receipt." + original.operationId(),
+        left + "|" + right);
+    var unknownSchema = DiplomacyAuthority.copy(valid);
+    unknownSchema.setProperty(DiplomacyAllianceOperationState.PREFIX + "version", "2");
+    var unknownKey = DiplomacyAuthority.copy(valid);
+    unknownKey.setProperty(DiplomacyAllianceOperationState.PREFIX + "future", "value");
+    var changedOwner = DiplomacyAuthority.copy(valid);
+    changedOwner.setProperty(
+        DiplomacyAllianceOperationState.PREFIX + "pair." + left + "." + right,
+        "1|" + UUID.randomUUID());
+    for (var malformed :
+        List.of(missingHistory, truncatedReceipt, unknownSchema, unknownKey, changedOwner))
+      assertThatThrownBy(() -> DiplomacyAllianceOperationState.read(malformed))
+          .isInstanceOf(RuntimeException.class);
