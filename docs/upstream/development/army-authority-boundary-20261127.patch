+      DiplomacyTreatyCapacity.requireRevision(state, Long.MAX_VALUE - 2);
+      assertThatThrownBy(() -> DiplomacyTreatyCapacity.requireRevision(state, Long.MAX_VALUE - 1))
+          .isInstanceOf(ArithmeticException.class);
+      DiplomacyTreatyCapacity.requireRevision(
+          state.record(bound.superseded(Instant.MAX)), Long.MAX_VALUE);
+      var principal =
+          DiplomacyPairKey.of(bound.request().war().attacker(), bound.request().war().defender());
+      var overflowing =
+          new Plan(
