@@ -0,0 +1,118 @@
+package dev.starcore.starcore.module.diplomacy.alliance;
+
+import dev.starcore.starcore.module.diplomacy.DiplomacyAllianceOperationService;
+import dev.starcore.starcore.module.diplomacy.DiplomacyRelation;
+import dev.starcore.starcore.module.nation.model.NationId;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.UUID;
+import java.util.function.Consumer;
+
+public final class AllianceOperationTestReceiver implements DiplomacyAllianceOperationService {
+  public final Map<UUID, Receipt> receipts = new HashMap<>();
+  public final List<Request> attempts = new ArrayList<>();
+  public final Map<AlliancePairKey, PairState> pairs = new HashMap<>();
+  public Consumer<Request> beforeApply = request -> {};
+  public Consumer<Receipt> afterApply = receipt -> {};
+  public Consumer<Receipt> afterCancel = receipt -> {};
+  public boolean unavailable;
+
+  @Override
+  public Receipt applyAllianceOperation(Request request) {
+    attempts.add(request);
+    var previous = existing(request);
+    if (previous != null) return previous;
+    if (unavailable) throw new IllegalStateException("receiver unavailable");
+    beforeApply.accept(request);
+    var state = alliancePairState(request.left(), request.right());
+    Outcome rejected =
+        state.retired()
+            ? Outcome.REJECTED_RETIRED
+            : state.relation() == DiplomacyRelation.WAR
+                ? Outcome.REJECTED_WAR
+                : state.generation() != request.expectedGeneration()
+                        || state.relation() != request.expectedRelation()
+                    ? Outcome.REJECTED_PRECONDITION
+                    : request.action() == Action.FORM
+                                && (state.relation() == DiplomacyRelation.ALLIED
+                                    || state.relation() == DiplomacyRelation.HOSTILE)
+                            || request.action() == Action.BREAK
+                                && state.relation() != DiplomacyRelation.ALLIED
+                        ? Outcome.REJECTED_PRECONDITION
+                        : null;
+    Receipt receipt;
+    if (rejected != null) {
+      receipt =
+          new Receipt(request, rejected, state.generation(), state.relation(), state.relation());
+    } else {
+      var relation =
+          request.action() == Action.FORM ? DiplomacyRelation.ALLIED : DiplomacyRelation.NEUTRAL;
+      var generation = state.generation() + 1;
+      receipt = new Receipt(request, Outcome.APPLIED, generation, state.relation(), relation);
+      pairs.put(
+          AlliancePairKey.of(request.left(), request.right()),
+          new PairState(
+              request.left(), request.right(), generation, relation, request.operationId(), false));
+    }
+    receipts.put(request.operationId(), receipt);
+    afterApply.accept(receipt);
+    return receipt;
+  }
+
+  @Override
+  public Receipt cancelAllianceOperation(Request request) {
+    attempts.add(request);
+    var previous = existing(request);
+    if (previous != null) return previous;
+    if (unavailable) throw new IllegalStateException("receiver unavailable");
+    var state = alliancePairState(request.left(), request.right());
+    var receipt =
+        new Receipt(
+            request, Outcome.CANCELLED, state.generation(), state.relation(), state.relation());
+    receipts.put(request.operationId(), receipt);
+    afterCancel.accept(receipt);
+    return receipt;
+  }
+
+  private Receipt existing(Request request) {
+    var receipt = receipts.get(request.operationId());
+    if (receipt != null && !receipt.request().equals(request))
+      throw new IllegalArgumentException("Changed receiver request payload");
+    return receipt;
+  }
+
+  @Override
+  public PairState alliancePairState(NationId left, NationId right) {
+    var pair = AlliancePairKey.of(left, right);
+    return pairs.getOrDefault(
+        pair, new PairState(pair.left(), pair.right(), 0, DiplomacyRelation.NEUTRAL, null, false));
+  }
+
+  @Override
+  public Optional<Receipt> allianceOperationReceipt(UUID operationId) {
+    return Optional.ofNullable(receipts.get(operationId));
+  }
+
+  public void supersede(NationId left, NationId right, DiplomacyRelation relation) {
+    var state = alliancePairState(left, right);
+    pairs.put(
+        AlliancePairKey.of(left, right),
+        new PairState(state.left(), state.right(), state.generation() + 1, relation, null, false));
+  }
+
+  public void retire(NationId left, NationId right) {
+    var state = alliancePairState(left, right);
+    pairs.put(
+        AlliancePairKey.of(left, right),
+        new PairState(
+            state.left(),
+            state.right(),
+            state.generation() + 1,
+            DiplomacyRelation.NEUTRAL,
+            null,
+            true));
+  }
+}
