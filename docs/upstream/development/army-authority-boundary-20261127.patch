+
+  static JsonObject legacyUnit(UUID armyId, UUID nationId, int soldiers) {
+    var value = new JsonObject();
+    value.addProperty("id", armyId.toString());
+    value.addProperty("nationId", nationId.toString());
+    value.addProperty("type", "infantry");
+    value.addProperty("soldiers", soldiers);
+    value.addProperty("health", 100);
+    value.addProperty("morale", 75);
+    value.addProperty("state", "stationary");
+    value.addProperty("supply", 30);
+    value.addProperty("createdAt", 1700000000123L);
+    var location = new JsonObject();
+    location.addProperty("world", "unresolved-legacy-world");
+    location.addProperty("x", 1.25);
+    location.addProperty("y", 64.5);
+    location.addProperty("z", -9.75);
+    value.add("location", location);
+    return value;
+  }
+
+  static byte[] bytes(Properties properties) throws Exception {
+    var output = new ByteArrayOutputStream();
+    properties.store(output, "exact legacy recovery source");
+    return output.toByteArray();
+  }
+
+  ArmyLegacyImporter.ImportResult imported() throws Exception {
+    var properties = new Properties();
+    properties.setProperty(firstId.toString(), legacyUnit(firstId, nationId, 100).toString());
+    properties.setProperty(secondId.toString(), legacyUnit(secondId, nationId, 150).toString());
+    properties.setProperty(
+        "logistics-supply:" + UUID.randomUUID(), firstId + "|" + nationId + "|20|0");
+    return ArmyLegacyImporter.inspect(bytes(properties), "configured-persistence:army/armies.dat");
+  }
+
+  static ArmySnapshot advance(ArmySnapshot army) {
+    return new ArmySnapshot(
+        new ArmyToken(
+            army.token().armyId(),
+            army.token().incarnation(),
+            Math.addExact(army.token().generation(), 1)),
+        army.nationId(),
+        army.type(),
+        Math.addExact(army.soldiers(), 1),
+        army.health(),
+        army.morale(),
+        army.position(),
+        army.state(),
+        army.supply(),
+        army.supplyConsumptionRemainder(),
+        army.createdAt(),
+        army.lastUpdated().plusMillis(1));
+  }
+
+  static ArmyAuthoritySnapshot replace(ArmyAuthoritySnapshot expected, ArmySnapshot replacement) {
+    var armies = new HashMap<>(expected.armies());
+    armies.put(replacement.token().armyId(), replacement);
+    return new ArmyAuthoritySnapshot(
+        true,
+        expected.revision(),
+        armies,
+        expected.tombstones(),
+        expected.receipts(),
+        expected.migration());
+  }
+
+  static ArmyAuthoritySnapshot retire(ArmyAuthoritySnapshot expected, UUID armyId) {
+    var army = expected.armies().get(armyId);
+    var armies = new HashMap<>(expected.armies());
+    armies.remove(armyId);
+    var tombstones = new HashMap<>(expected.tombstones());
+    tombstones.put(
+        armyId,
+        new ArmyTombstone(
+            new ArmyToken(armyId, army.token().incarnation(), army.token().generation() + 1),
+            army.nationId(),
+            army.type(),
+            army.createdAt(),
+            army.lastUpdated().plusMillis(1),
+            "TEST_RETIREMENT",
+            null));
+    return new ArmyAuthoritySnapshot(
+        true, expected.revision(), armies, tombstones, expected.receipts(), expected.migration());
+  }
