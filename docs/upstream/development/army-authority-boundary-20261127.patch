+      var listener = new ArbitrationGuiListener(service, nations);
+      var open =
+          ArbitrationGuiListener.class.getDeclaredMethod(
+              "handleDetailClick", Player.class, ArbitrationGui.class, int.class, ItemStack.class);
+      open.setAccessible(true);
+      try (var support = mockStatic(BookInputSupport.class)) {
+        open.invoke(listener, player, gui, 20, null);
+        var active = ArgumentCaptor.forClass(BooleanSupplier.class);
+        var submit = ArgumentCaptor.forClass(Consumer.class);
+        support.verify(
+            () ->
+                BookInputSupport.prepare(
+                    same(player),
+                    eq("Arbitration ruling"),
+                    eq(""),
