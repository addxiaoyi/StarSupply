+/** Actual independent treasury modules and file/SQLite authorities for cross-domain recovery. */
+public final class WarDebitTestFixture implements AutoCloseable {
+  private final Path root;
+  private final boolean sql;
+  private final List<SqlTreasuryStateStorage> sqlStores = new ArrayList<>();
+
+  public WarDebitTestFixture(Path root, boolean sql) throws Exception {
+    this.root = Files.createDirectories(root);
+    this.sql = sql;
+  }
+
+  public TreasuryModule open() throws Exception {
+    TreasuryStateStorage storage;
+    if (sql) {
+      var ds = new SQLiteDataSource();
+      ds.setUrl("jdbc:sqlite:" + root.resolve("treasury.db"));
+      var actual = new SqlTreasuryStateStorage(ds, new Properties(), Logger.getAnonymousLogger());
+      sqlStores.add(actual);
+      storage = actual;
+    } else
+      storage =
+          new PersistenceTreasuryStateStorage(
+              "treasury",
+              new PersistenceService(null, null) {
+                @Override
