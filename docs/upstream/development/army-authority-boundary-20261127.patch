+    WarStateStorage storage() {
+      return new WarStateStorage(plugin, database) {
+        @Override
+        public void saveTreatyData(UUID id, String key, String json) {
+          PeaceTreatyBatch batch = null;
+          if (key.equals("STATE")) {
+            batch = new PeaceTreatyStateCodec().decode(json).execution().batch();
+            if (batch != null) {
+              if (batch.cancelRequested()) failOnce(Boundary.CANCELLATION_WRITE);
+              Boundary boundary =
+                  switch (batch.stage()) {
+                    case RESERVED -> Boundary.RESERVED_WRITE;
+                    case MANIFEST_BOUND -> Boundary.BOUND_WRITE;
+                    case WAR_ENDED -> Boundary.WAR_ENDED_WRITE;
+                    case ACKED -> Boundary.ACKED_WRITE;
+                    case RELEASED -> Boundary.RELEASED_WRITE;
+                    default -> null;
+                  };
+              if (boundary != null) failOnce(boundary);
+            }
+          }
+          super.saveTreatyData(id, key, json);
+          if (batch != null) sourceWrites.add(batch);
