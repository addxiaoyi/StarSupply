+  private void sourceEnd(OperationView operation, Map<UUID, EndReceipt> ends) {
+    var request = operation.request();
+    ends.put(
+        request.operationId(),
+        new EndReceipt(
+            sourceRequest(operation),
+            request.warGeneration(),
+            request.warGeneration() + 1,
+            preparedAt.plusSeconds(1),
+            2,
+            entry(request, false)));
+  }
