+  @Override
+  public Optional<PendingView> allianceOperation(UUID operationId) {
+    return mutate(
+        () ->
+            Optional.ofNullable(intents.get(Objects.requireNonNull(operationId))).map(this::view));
+  }
+
+  @Override
+  public PendingView retryAllianceOperation(UUID operationId) {
+    return mutate(() -> view(processIntent(Objects.requireNonNull(operationId))));
+  }
+
+  @Override
+  public PendingView cancelAllianceOperation(UUID operationId) {
+    return mutate(
+        () -> {
+          requestCancellation(Objects.requireNonNull(operationId));
+          return view(processIntent(operationId));
+        });
+  }
+
+  @Override
+  public int recoverPendingAllianceOperations(int limit) {
+    if (limit < 1 || limit > 100)
+      throw new IllegalArgumentException("Recovery limit must be 1..100");
+    return mutate(
+        () -> {
+          int completed = 0;
+          for (var intent : orderedPendingIntents().stream().limit(limit).toList()) {
+            if (stopped) break;
+            try {
+              if (processIntent(intent.operationId()).status() == Status.ACKNOWLEDGED) completed++;
+            } catch (RuntimeException failure) {
+              if (plugin != null)
+                plugin
+                    .getLogger()
+                    .log(
+                        Level.WARNING,
+                        "Alliance operation remains pending: " + intent.operationId(),
+                        failure);
+              if (storage != null) {
+                try {
+                  loadStateOrThrow();
+                } catch (RuntimeException unreadable) {
+                  stateLoadFailed = true;
+                  failure.addSuppressed(unreadable);
+                  break;
+                }
+              }
+            }
+          }
+          return completed;
+        });
+  }
+
+  private List<AllianceOperationIntent> orderedPendingIntents() {
+    return intents.values().stream()
+        .filter(intent -> intent.status() == Status.PREPARED)
+        .sorted(
+            Comparator.comparing((AllianceOperationIntent intent) -> intent.request().occurredAt())
+                .thenComparing(intent -> intent.operationId().toString()))
+        .toList();
+  }
+
+  private PendingView view(AllianceOperationIntent intent) {
+    String reason =
+        intent.status() == Status.ACKNOWLEDGED
+            ? intent.outcome().name()
+            : recoveryFailures.getOrDefault(
+                intent.operationId(),
+                intent.cancellationRequested() ? "CANCELLATION_REQUESTED" : "AWAITING_RECEIVER");
+    return new PendingView(
+        intent.operationId(),
+        intent.request().action().name(),
+        intent.request().left(),
+        intent.request().right(),
+        intent.request().occurredAt(),
+        intent.status(),
+        reason);
   }
 
