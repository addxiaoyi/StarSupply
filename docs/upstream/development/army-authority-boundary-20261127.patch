+    var terminal = new OperationView(request, plan, Status.APPLIED, PREPARED_AT.plusNanos(2));
+    var acknowledged = new PeaceTreatyBatch(request, plan, Stage.ACKED, end, terminal, true);
+    var released = acknowledged.advance(Stage.RELEASED);
+
+    assertEquals(end, released.endReceipt());
+    assertEquals(terminal, released.terminalReceipt());
+    assertEquals(1, released.request().protocolVersion());
+    assertEquals(1, released.warRequest().protocolVersion());
+    assertNull(released.binding());
