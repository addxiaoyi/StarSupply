+    assertThat(money.calls).isZero();
+    assertThat(money.receipts).isEmpty();
+    var persisted = f.storage().paidDeclaration(request.operationId()).orElseThrow();
+    assertThat(persisted.receipt().request()).isEqualTo(request);
