+
+  private static void removeLegacyReserveProtocol(JsonObject request) {
+    request.remove("protocolVersion");
+    request.remove("envelope");
+    request.remove("assignedTermIndexes");
+  }
+
+  private ReleaseReceipt assertV2Release(Session session, PeaceTreatyBatch batch) {
+    var binding = batch.warRequest();
+    var release = session.storage.settlementRelease(binding.operationId()).orElseThrow();
+    var entries = binding.manifest().entries();
+    var expectedPhase = Phase.valueOf(batch.terminalReceipt().status().name());
+    assertEquals(2, batch.request().protocolVersion());
+    assertEquals(2, binding.protocolVersion());
+    assertEquals(2, release.protocolVersion());
+    assertEquals(new ReleaseRequest(binding.operationId(), binding.planHash()), release.request());
+    assertEquals(batch.terminalReceipt().status().name(), release.status().name());
+    assertEquals(entries.size(), release.effectProofs().size());
+    assertEquals(entries, release.effectProofs().stream().map(proof -> proof.entry()).toList());
+    for (var proof : release.effectProofs()) {
+      assertEquals(binding, proof.binding());
+      assertEquals(expectedPhase, proof.phase());
+      assertEquals(batch.terminalReceipt().terminalAt(), proof.terminalAt());
+      assertEquals(batch.terminalReceipt().terminalEvidence(), proof.terminalEvidence());
+      assertEquals(batch.plan().planHash(), proof.entry().localPlanHash());
+      assertEquals(batch.request().assignedTermIndexes(), proof.entry().assignedTermIndexes());
+      assertEquals(binding.scopes(), proof.entry().scopes());
+      if (proof.terminalEvidence().endReceipt() != null)
+        assertEquals(
+            session.wars.settlementEnd(binding.operationId()).orElseThrow(),
+            proof.terminalEvidence().endReceipt());
+      if (proof.terminalEvidence().cancellationReceipt() != null)
+        assertEquals(
+            session.wars.settlementCancellation(binding.operationId()).orElseThrow(),
+            proof.terminalEvidence().cancellationReceipt());
+    }
+    assertEquals(
+        List.of(batch.terminalReceipt().effectProof().orElseThrow()), release.effectProofs());
+    return release;
+  }
+}
