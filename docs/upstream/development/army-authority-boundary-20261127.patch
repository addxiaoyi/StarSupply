+  static final class Money implements NationDebitService {
+    final Map<UUID, Receipt> receipts = new HashMap<>();
+    NationDebitService.Status next = NationDebitService.Status.APPLIED;
+    int calls, cancelCalls;
+    boolean responseLost, unreadable;
+    Runnable afterDecision = () -> {};
+    Runnable afterRead = () -> {};
+
+    @Override
+    public synchronized Receipt applyDebit(NationDebitService.Request request) {
+      var prior = receipts.get(request.operationId());
+      if (prior != null) {
+        if (!prior.request().equals(request))
+          throw new IllegalArgumentException("Conflicting debit");
+        return prior;
+      }
+      calls++;
+      var receipt = new Receipt(request, next, Instant.now());
+      receipts.put(request.operationId(), receipt);
+      afterDecision.run();
+      if (responseLost) throw new IllegalStateException("Debit committed; response lost");
+      return receipt;
+    }
+
+    @Override
+    public synchronized Optional<Receipt> debitReceipt(UUID id) {
+      if (unreadable) throw new IllegalStateException("Debit readback offline");
+      var selected = Optional.ofNullable(receipts.get(id));
+      afterRead.run();
+      return selected;
+    }
+
+    @Override
+    public synchronized Receipt cancelDebit(NationDebitService.Request request) {
+      var prior = receipts.get(request.operationId());
+      if (prior != null) {
+        if (!prior.request().equals(request))
+          throw new IllegalArgumentException("Conflicting debit");
+        return prior;
+      }
+      cancelCalls++;
+      var receipt = new Receipt(request, NationDebitService.Status.CANCELLED, Instant.now());
+      receipts.put(request.operationId(), receipt);
+      afterDecision.run();
+      if (responseLost)
+        throw new IllegalStateException("Debit cancellation committed; response lost");
+      return receipt;
+    }
+  }
+
