+  private static void assertModuleDisableDiscardsInput(boolean stopFails) throws Exception {
+    StorageService storage = mock(StorageService.class);
+    Player player = mock(Player.class);
+    UUID playerId = UUID.randomUUID();
+    Warehouse warehouse = new Warehouse(WarehouseType.PERSONAL, playerId, "native-disable");
+    when(player.getUniqueId()).thenReturn(playerId);
+    when(storage.getPermission(warehouse.getWarehouseId(), playerId))
+        .thenReturn(RemoteAccessPermission.OWNER);
+    WarehouseListener listener = new WarehouseListener(storage);
+    WarehouseGUI gui = new WarehouseGUI(storage, warehouse, player, false);
+    Inventory inventory = mock(Inventory.class);
+    when(inventory.getSize()).thenReturn(54);
+    setField(gui, "inventory", inventory);
+    setField(gui, "mode", WarehouseGUI.GUIMode.PERMISSIONS);
+    listener.registerGUI(gui);
+    doAnswer(
+            invocation -> {
+              close(listener, player, inventory);
+              return null;
+            })
+        .when(player)
+        .closeInventory();
+    AtomicReference<BooleanSupplier> active = new AtomicReference<>();
+    AtomicReference<Consumer<String>> submit = new AtomicReference<>();
+    try (var input =
+        mockStatic(
+            BookInputSupport.class,
+            invocation -> {
+              if (invocation.getMethod().getName().equals("prepare")) {
+                active.set(invocation.getArgument(3));
+                submit.set(invocation.getArgument(4));
+                player.closeInventory();
+              }
+              return null;
+            })) {
+      listener.onInventoryClick(click(player, inventory, 50, Material.LIME_DYE));
+      assertThat(active.get().getAsBoolean()).isTrue();
+      assertThat(listener.getActiveGUICount()).isZero();
+      StorageModule module = new StorageModule();
+      setField(module, "listener", listener);
+      setField(module, "storageService", storage);
+      StarCoreContext context = mock(StarCoreContext.class);
+      JavaPlugin plugin = mock(JavaPlugin.class);
+      when(context.plugin()).thenReturn(plugin);
+      when(plugin.getLogger()).thenReturn(Logger.getLogger("WarehouseNativeInputReopenTest"));
+      when(plugin.isEnabled()).thenReturn(true);
+      if (stopFails) {
+        doThrow(new IllegalStateException("stop failed")).when(storage).stop();
+        assertThatThrownBy(() -> module.disable(context))
+            .isInstanceOf(IllegalStateException.class)
+            .hasMessage("stop failed");
+      } else {
+        module.disable(context);
+      }
+      verify(storage).stop();
+      assertThat(plugin.isEnabled()).isTrue();
+      assertThat(active.get().getAsBoolean()).isFalse();
+      clearInvocations(storage, player);
+
+      submit.get().accept("Target");
+      gui.open();
+      listener.registerGUI(gui);
+
+      verifyNoInteractions(storage);
+      verify(player, never()).openInventory(any(Inventory.class));
+      assertThat(listener.getActiveGUICount()).isZero();
+    }
+  }
