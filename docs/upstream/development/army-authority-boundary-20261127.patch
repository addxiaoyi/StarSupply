+package dev.starcore.starcore.foundation.gui;
+
+import io.papermc.paper.dialog.Dialog;
+import io.papermc.paper.registry.data.dialog.ActionButton;
+import io.papermc.paper.registry.data.dialog.DialogBase;
+import io.papermc.paper.registry.data.dialog.DialogRegistryEntry;
+import io.papermc.paper.registry.data.dialog.action.DialogAction;
+import io.papermc.paper.registry.data.dialog.input.DialogInput;
+import io.papermc.paper.registry.data.dialog.input.TextDialogInput;
+import io.papermc.paper.registry.data.dialog.type.DialogType;
+import java.util.List;
+import java.util.function.BiConsumer;
+import java.util.function.Consumer;
+import net.kyori.adventure.text.Component;
+import net.kyori.adventure.text.event.ClickCallback;
+import org.bukkit.entity.Player;
+
+final class PaperTextDialog implements NativeTextInput.View {
+  public void show(
+      Player player,
+      NativeTextInput.Prompt prompt,
+      BiConsumer<Player, String> submit,
+      Consumer<Player> cancel) {
+    var dialog = Dialog.create(factory -> configure(factory.empty(), prompt, submit, cancel));
+    player.closeInventory();
+    player.showDialog(dialog);
+  }
+
+  static void configure(
+      DialogRegistryEntry.Builder builder,
+      NativeTextInput.Prompt prompt,
+      BiConsumer<Player, String> submit,
+      Consumer<Player> cancel) {
+    var input =
+        DialogInput.text("value", Component.text("内容"))
+            .initial(prompt.initial())
+            .maxLength(prompt.maxLength())
+            .width(300)
+            .multiline(TextDialogInput.MultilineOptions.create(5, 100));
+    var options =
+        ClickCallback.Options.builder()
+            .uses(ClickCallback.UNLIMITED_USES)
+            .lifetime(NativeTextInput.LIFETIME)
+            .build();
+    var confirm =
+        ActionButton.builder(Component.text("确认"))
+            .action(
+                DialogAction.customClick(
+                    (response, audience) -> {
+                      if (audience instanceof Player player) {
+                        submit.accept(player, response.getText("value"));
+                      }
+                    },
+                    options))
+            .build();
+    var back =
+        ActionButton.builder(Component.text("取消"))
+            .action(
+                DialogAction.customClick(
+                    (response, audience) -> {
+                      if (audience instanceof Player player) cancel.accept(player);
+                    },
+                    options))
+            .build();
+    builder
+        .base(
+            DialogBase.builder(Component.text(prompt.title()))
+                .canCloseWithEscape(false)
+                .pause(false)
+                .afterAction(DialogBase.DialogAfterAction.CLOSE)
+                .inputs(List.of(input.build()))
+                .build())
+        .type(DialogType.confirmation(confirm, back));
+  }
+}
