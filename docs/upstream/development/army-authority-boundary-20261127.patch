@@ -0,0 +1,574 @@
+package dev.starcore.starcore.war;
+
+import com.google.gson.*;
+import dev.starcore.starcore.core.persistence.DurablePropertiesStore;
+import dev.starcore.starcore.module.diplomacy.DiplomacyTreatyOperationService.ExactWar;
+import dev.starcore.starcore.module.diplomacy.DiplomacyTreatyOperationService.PairScope;
+import dev.starcore.starcore.module.diplomacy.WarDiplomacyMirrorService.WarEntry;
+import dev.starcore.starcore.module.nation.model.NationId;
+import dev.starcore.starcore.module.war.WarSettlementAdmissionService.*;
+import dev.starcore.starcore.module.war.WarSettlementEffectProofCodec;
+import dev.starcore.starcore.module.war.WarSettlementEffectProofReader.EffectProof;
+import dev.starcore.starcore.treaty.TreatyEffectManifest;
+import java.time.Instant;
+import java.util.*;
+import java.util.function.Function;
+
+final class WarSettlementState {
+  static final String ADMISSION = "settlementAdmission.";
+  static final String END = "settlementEnd.";
+  static final String CANCEL = "settlementCancel.";
+  static final String RELEASE = "settlementRelease.";
+
+  static boolean metadata(String key) {
+    return key.startsWith(ADMISSION)
+        || key.startsWith(END)
+        || key.startsWith(CANCEL)
+        || key.startsWith(RELEASE);
+  }
+
+  static ExactWar identity(War war) {
+    return new ExactWar(
+        war.id(),
+        war.aggressor(),
+        war.defender(),
+        war.declaredAt(),
+        new ArrayList<>(war.aggressorAllies()),
+        new ArrayList<>(war.defenderAllies()));
+  }
+
+  static Set<PairScope> closure(Collection<NationId> nations) {
+    var ordered =
+        nations.stream().distinct().sorted(Comparator.comparing(NationId::toString)).toList();
+    var result = new HashSet<PairScope>();
+    for (int left = 0; left < ordered.size(); left++)
+      for (int right = left + 1; right < ordered.size(); right++)
+        result.add(PairScope.of(ordered.get(left), ordered.get(right)));
+    return Set.copyOf(result);
+  }
+
+  static Map<UUID, Admission> admissions(Properties state) {
+    return read(state, ADMISSION, WarSettlementState::admission, WarSettlementState::encode);
+  }
+
+  static Map<UUID, EndReceipt> ends(Properties state) {
+    return read(state, END, WarSettlementState::end, WarSettlementState::encode);
+  }
+
+  static Map<UUID, CancellationReceipt> cancellations(Properties state) {
+    return read(state, CANCEL, WarSettlementState::cancellation, WarSettlementState::encode);
+  }
+
+  static Map<UUID, ReleaseReceipt> releases(Properties state) {
+    return read(state, RELEASE, WarSettlementState::release, WarSettlementState::encode);
+  }
+
+  private static <T> Map<UUID, T> read(
+      Properties state, String prefix, Function<JsonObject, T> decode, Function<T, String> encode) {
+    var result = new HashMap<UUID, T>();
+    WarAuthority.family(state, prefix)
+        .forEach(
+            (id, json) -> {
+              T value = decode.apply(JsonParser.parseString(json).getAsJsonObject());
+              if (!encode.apply(value).equals(json))
+                throw new IllegalArgumentException("Noncanonical settlement receipt");
+              UUID operation =
+                  value instanceof Admission item
+                      ? item.request().operationId()
+                      : value instanceof EndReceipt item
+                          ? item.request().operationId()
+                          : value instanceof CancellationReceipt item
+                              ? item.request().operationId()
+                              : ((ReleaseReceipt) value).request().operationId();
+              if (!id.equals(operation))
+                throw new IllegalArgumentException("Settlement operation mismatch");
+              result.put(id, value);
+            });
+    return Map.copyOf(result);
+  }
+
+  static Map<UUID, Admission> reserved(Properties state) {
+    var releases = releases(state);
+    var result = new HashMap<UUID, Admission>();
+    admissions(state)
+        .forEach(
+            (id, admission) -> {
+              if (admission.accepted() && !releases.containsKey(id)) result.put(id, admission);
+            });
+    return Map.copyOf(result);
+  }
+
+  static boolean reservedWar(Properties state, UUID warId) {
+    return reserved(state).values().stream().anyMatch(a -> a.request().war().warId().equals(warId));
+  }
+
+  static boolean blocksNations(Properties state, Set<NationId> nations) {
+    return reserved(state).values().stream()
+        .flatMap(a -> a.request().scopes().stream())
+        .anyMatch(pair -> nations.contains(pair.left()) || nations.contains(pair.right()));
+  }
+
+  static Decision decide(Properties state, Request request, WarAuthority authority) {
+    var cancellation = cancellations(state).get(request.operationId());
+    if (cancellation != null) {
+      if (!cancellation.request().equals(request))
+        throw new IllegalArgumentException("Conflicting original settlement cancellation");
+      return Decision.CANCELLED;
+    }
+    String json = state.getProperty(WarAuthority.WAR + request.war().warId());
+    if (json == null) return Decision.WAR_MISMATCH;
+    var war = authority.decodeWar(request.war().warId(), json);
+    if (!identity(war).equals(request.war())
+        || WarRowVersion.generation(state, war.id()) != request.warGeneration()
+        || !authority.fingerprint(war.id(), json).equals(request.warFingerprint())
+        || !new HashSet<>(request.scopes()).containsAll(closure(war.allParticipants())))
+      return Decision.WAR_MISMATCH;
+    if (!war.isActive()) return Decision.INACTIVE_WAR;
+    var nations = endpoints(request.scopes());
+    if (nations.stream().anyMatch(WarAuthority.receipts(state)::containsKey)
+        || nations.stream().anyMatch(WarDisbandAdmission.reserved(state)::containsKey))
+      return Decision.RETIRED;
+    if (reserved(state).values().stream()
+        .anyMatch(a -> intersects(a.request().scopes(), request.scopes())))
+      return Decision.CONFLICTING_SCOPE;
+    for (var entry : WarAuthority.family(state, WarAuthority.WAR).entrySet()) {
+      if (entry.getKey().equals(war.id())) continue;
+      var other = authority.decodeWar(entry.getKey(), entry.getValue());
+      if (other.isActive() && intersects(closure(other.allParticipants()), request.scopes()))
+        return Decision.CONFLICTING_SCOPE;
+    }
+    String field = state.getProperty(WarAuthority.FIELD + war.id());
+    if (field != null && WarAuthority.hasPendingScore(field)) return Decision.PENDING_EFFECT;
+    if (PaidWarDeclaration.operations(state).values().stream()
+        .filter(PaidWarDeclaration::pending)
+        .anyMatch(
+            op ->
+                request
+                    .scopes()
+                    .contains(
+                        PairScope.of(
+                            op.receipt().request().aggressor(),
+                            op.receipt().request().defender())))) return Decision.PENDING_EFFECT;
+    return Decision.ACCEPTED;
+  }
+
+  static void validate(Properties state, WarAuthority authority) {
+    var admissions = admissions(state);
+    var ends = ends(state);
+    var cancellations = cancellations(state);
+    var releases = releases(state);
+    for (var entry : cancellations.entrySet()) {
+      var admission = admissions.get(entry.getKey());
+      if (ends.containsKey(entry.getKey())
+          || admission != null && !admission.request().equals(entry.getValue().request()))
+        throw new IllegalArgumentException("Cancellation conflicts with original settlement");
+    }
+    for (var entry : admissions.entrySet())
+      if (entry.getValue().decision() == Decision.CANCELLED
+          && (!cancellations.containsKey(entry.getKey())
+              || !cancellations.get(entry.getKey()).request().equals(entry.getValue().request())))
+        throw new IllegalArgumentException("Cancelled admission requires its original seal");
+    for (var entry : ends.entrySet()) {
+      var admission = admissions.get(entry.getKey());
+      var receipt = entry.getValue();
+      if (admission == null
+          || !admission.accepted()
+          || !receipt.request().equals(admission.request())
+          || receipt.endedAuthorityRevision() > DurablePropertiesStore.revision(state))
+        throw new IllegalArgumentException("End receipt requires its original admission");
+    }
+    for (var entry : releases.entrySet()) {
+      validateRelease(entry.getValue(), admissions, ends, cancellations);
+    }
+    var scopes = new HashSet<PairScope>();
+    for (var entry : reserved(state).entrySet()) {
+      var request = entry.getValue().request();
+      for (var pair : request.scopes())
+        if (!scopes.add(pair))
+          throw new IllegalStateException("Conflicting settlement pair fences");
+      var nations = endpoints(request.scopes());
+      if (nations.stream().anyMatch(WarAuthority.receipts(state)::containsKey)
+          || nations.stream().anyMatch(WarDisbandAdmission.reserved(state)::containsKey))
+        throw new IllegalStateException("Settlement fences nation retirement");
+      String json = state.getProperty(WarAuthority.WAR + request.war().warId());
+      if (json == null
+          || state.containsKey(WarAuthority.ARCHIVED_WAR + request.war().warId())
+          || state.containsKey(WarAuthority.DELETED + request.war().warId()))
+        throw new IllegalStateException("Settlement freezes its exact war row");
+      var war = authority.decodeWar(request.war().warId(), json);
+      if (!identity(war).equals(request.war()))
+        throw new IllegalStateException("Settlement war identity changed");
+      var end = ends.get(entry.getKey());
+      if (end == null) {
+        if (!war.isActive()
+            || WarRowVersion.generation(state, war.id()) != request.warGeneration()
+            || !authority.fingerprint(war.id(), json).equals(request.warFingerprint()))
+          throw new IllegalStateException("Settlement freezes its original active war");
+      } else if (!war.isEnded()
+          || !end.endedAt().equals(war.endedAt())
+          || WarRowVersion.generation(state, war.id()) != end.afterGeneration())
+        throw new IllegalStateException("Settlement freezes its ended war until acknowledgement");
+      String field = state.getProperty(WarAuthority.FIELD + war.id());
+      if (field != null && WarAuthority.hasPendingScore(field))
+        throw new IllegalStateException("Settlement fences pending battlefield scores");
+      for (var otherEntry : WarAuthority.family(state, WarAuthority.WAR).entrySet()) {
+        if (otherEntry.getKey().equals(war.id())) continue;
+        var other = authority.decodeWar(otherEntry.getKey(), otherEntry.getValue());
+        if (other.isActive() && intersects(closure(other.allParticipants()), request.scopes()))
+          throw new IllegalStateException("Settlement fences overlapping war participants");
+      }
+      if (PaidWarDeclaration.operations(state).values().stream()
+          .filter(PaidWarDeclaration::pending)
+          .anyMatch(
+              op ->
+                  request
+                      .scopes()
+                      .contains(
+                          PairScope.of(
+                              op.receipt().request().aggressor(),
+                              op.receipt().request().defender()))))
+        throw new IllegalStateException("Settlement fences paid declaration intent");
+    }
+  }
+
+  static void commit(Properties previous, Properties next, WarAuthority authority) {
+    var oldAdmissions = admissions(previous);
+    var newAdmissions = admissions(next);
+    var oldEnds = ends(previous);
+    var newEnds = ends(next);
+    var oldCancellations = cancellations(previous);
+    var newCancellations = cancellations(next);
+    var oldReleases = releases(previous);
+    var newReleases = releases(next);
+    var addedAdmissions = added(oldAdmissions, newAdmissions);
+    var addedEnds = added(oldEnds, newEnds);
+    var addedCancellations = added(oldCancellations, newCancellations);
+    var addedReleases = added(oldReleases, newReleases);
+    int count =
+        addedAdmissions.size()
+            + addedEnds.size()
+            + addedCancellations.size()
+            + addedReleases.size();
+    if (count == 0) return;
+    if (count != 1) throw new IllegalArgumentException("One settlement decision per commit");
+    var unchanged = DurablePropertiesStore.copy(next);
+    if (!addedAdmissions.isEmpty()) {
+      var admission = addedAdmissions.getFirst();
+      if (admission.decision() != decide(previous, admission.request(), authority))
+        throw new IllegalArgumentException(
+            "Settlement admission does not match selected authority");
+      unchanged.remove(ADMISSION + admission.request().operationId());
+    } else if (!addedEnds.isEmpty()) {
+      var receipt = addedEnds.getFirst();
+      var request = receipt.request();
+      var admission = oldAdmissions.get(request.operationId());
+      String before = previous.getProperty(WarAuthority.WAR + request.war().warId());
+      String after = next.getProperty(WarAuthority.WAR + request.war().warId());
+      if (admission == null
+          || !admission.accepted()
+          || !request.equals(admission.request())
+          || oldCancellations.containsKey(request.operationId())
+          || oldReleases.containsKey(request.operationId())
+          || before == null
+          || after == null
+          || receipt.beforeGeneration() != WarRowVersion.generation(previous, request.war().warId())
+          || receipt.endedAuthorityRevision()
+              != Math.addExact(DurablePropertiesStore.revision(previous), 1)
+          || !authority.exactSettlementEnd(request.war().warId(), before, after, receipt.endedAt()))
+        throw new IllegalArgumentException("Exact settlement end does not match its original war");
+      unchanged.remove(END + request.operationId());
+      unchanged.setProperty(WarAuthority.WAR + request.war().warId(), before);
+    } else if (!addedCancellations.isEmpty()) {
+      var receipt = addedCancellations.getFirst();
+      var request = receipt.request();
+      var admission = oldAdmissions.get(request.operationId());
+      if (oldEnds.containsKey(request.operationId())
+          || admission != null && !admission.request().equals(request))
+        throw new IllegalArgumentException("Cancellation conflicts with original settlement");
+      unchanged.remove(CANCEL + request.operationId());
+    } else {
+      var receipt = addedReleases.getFirst();
+      validateRelease(receipt, oldAdmissions, oldEnds, oldCancellations);
+      unchanged.remove(RELEASE + receipt.request().operationId());
+    }
+    if (!unchanged.equals(previous))
+      throw new IllegalArgumentException("Settlement decision cannot change unrelated authority");
+  }
+
+  static void transition(Properties previous, Properties next, WarAuthority authority) {
+    for (String prefix : List.of(ADMISSION, END, CANCEL, RELEASE))
+      for (var entry : WarAuthority.family(previous, prefix).entrySet())
+        if (!entry.getValue().equals(next.getProperty(prefix + entry.getKey())))
+          throw new IllegalArgumentException("Settlement receipts are permanent and immutable");
+    var newEnds = ends(next);
+    var releases = releases(next);
+    for (var entry : reserved(previous).entrySet()) {
+      if (releases.containsKey(entry.getKey())) continue;
+      var request = entry.getValue().request();
+      UUID warId = request.war().warId();
+      String before = previous.getProperty(WarAuthority.WAR + warId);
+      String after = next.getProperty(WarAuthority.WAR + warId);
+      var newEnd = newEnds.get(entry.getKey());
+      boolean ending = !ends(previous).containsKey(entry.getKey()) && newEnd != null;
+      if (!WarRowVersion.sameRow(authority, warId, before, after)
+          && !(ending
+              && before != null
+              && after != null
+              && authority.exactSettlementEnd(warId, before, after, newEnd.endedAt())))
+        throw new IllegalStateException("Settlement reservation freezes its exact war");
+      for (String prefix :
+          List.of(
+              WarAuthority.FIELD,
+              WarAuthority.ARCHIVED_FIELD,
+              WarAuthority.ARCHIVED_WAR,
+              WarAuthority.DELETED))
+        if (!Objects.equals(previous.getProperty(prefix + warId), next.getProperty(prefix + warId)))
+          throw new IllegalStateException("Settlement reservation freezes battlefield and history");
+    }
+  }
+
+  private static <T> List<T> added(Map<UUID, T> before, Map<UUID, T> after) {
+    return after.entrySet().stream()
+        .filter(entry -> !before.containsKey(entry.getKey()))
+        .map(Map.Entry::getValue)
+        .toList();
+  }
+
+  private static boolean intersects(Collection<PairScope> left, Collection<PairScope> right) {
+    return left.stream().anyMatch(right::contains);
+  }
+
+  private static Set<NationId> endpoints(List<PairScope> scopes) {
+    var result = new HashSet<NationId>();
+    scopes.forEach(
+        pair -> {
+          result.add(pair.left());
+          result.add(pair.right());
+        });
+    return Set.copyOf(result);
+  }
+
+  static void validateRelease(
+      ReleaseReceipt receipt,
+      Map<UUID, Admission> admissions,
+      Map<UUID, EndReceipt> ends,
+      Map<UUID, CancellationReceipt> cancellations) {
+    UUID operationId = receipt.request().operationId();
+    var admission = admissions.get(operationId);
+    if (admission == null
+        || !admission.accepted()
+        || !admission.request().planHash().equals(receipt.request().planHash())
+        || admission.request().protocolVersion() != receipt.protocolVersion())
+      throw new IllegalArgumentException("Release requires its original settlement outcome");
+    var end = ends.get(operationId);
+    var cancellation = cancellations.get(operationId);
+    if (receipt.protocolVersion() == 1) {
+      if (receipt.status() == TerminalStatus.APPLIED && end == null)
+        throw new IllegalArgumentException("Applied release requires its original exact end");
+      return;
+    }
+    var original = admission.request();
+    for (var proof : receipt.effectProofs()) {
+      if (!proof.binding().equals(original))
+        throw new IllegalArgumentException("Release proof does not match original admission");
+      var evidence = proof.terminalEvidence();
+      switch (evidence.basis()) {
+        case END_APPLIED, END_REJECTED -> {
+          if (end == null || cancellation != null || !end.equals(evidence.endReceipt()))
+            throw new IllegalArgumentException("Release proof does not match permanent exact end");
+        }
+        case CANCEL_SEAL -> {
+          if (cancellation == null
+              || end != null
+              || !cancellation.equals(evidence.cancellationReceipt()))
+            throw new IllegalArgumentException(
+                "Release proof does not match permanent cancellation");
+        }
+        case LOCAL_SUPERSEDED -> {
+          if (end != null && !end.request().equals(original)
+              || cancellation != null && !cancellation.request().equals(original)
+              || end != null && cancellation != null)
+            throw new IllegalArgumentException("Superseded release conflicts with source winner");
+        }
+      }
+    }
+  }
+
+  static String encode(Admission value) {
+    var json = new JsonObject();
+    json.add("request", request(value.request()));
+    json.addProperty("decision", value.decision().name());
+    return json.toString();
+  }
+
+  static String encode(EndReceipt value) {
+    var json = new JsonObject();
+    json.add("request", request(value.request()));
+    json.addProperty("beforeGeneration", value.beforeGeneration());
+    json.addProperty("afterGeneration", value.afterGeneration());
+    json.addProperty("endedAt", value.endedAt().toString());
+    json.addProperty("endedAuthorityRevision", value.endedAuthorityRevision());
+    json.addProperty("endedWarId", value.endedWar().warId().toString());
+    json.addProperty("endedAggressor", value.endedWar().aggressor().toString());
+    json.addProperty("endedDefender", value.endedWar().defender().toString());
+    json.addProperty("endedDeclaredAt", value.endedWar().declaredAt().toString());
+    json.addProperty("active", value.endedWar().active());
+    return json.toString();
+  }
+
+  static String encode(ReleaseReceipt value) {
+    var json = new JsonObject();
+    json.addProperty("operationId", value.request().operationId().toString());
+    json.addProperty("planHash", value.request().planHash());
+    json.addProperty("status", value.status().name());
+    if (value.protocolVersion() == TreatyEffectManifest.VERSION) {
+      json.addProperty("protocolVersion", value.protocolVersion());
+      var proofs = new JsonArray();
+      for (var proof : value.effectProofs())
+        proofs.add(WarSettlementEffectProofCodec.encode(proof));
+      json.add("effectProofs", proofs);
+    }
+    return json.toString();
+  }
+
+  static String encode(CancellationReceipt value) {
+    var json = new JsonObject();
+    json.add("request", request(value.request()));
+    return json.toString();
+  }
+
+  private static Admission admission(JsonObject json) {
+    return new Admission(
+        request(json.getAsJsonObject("request")), Decision.valueOf(text(json, "decision")));
+  }
+
+  private static EndReceipt end(JsonObject json) {
+    return new EndReceipt(
+        request(json.getAsJsonObject("request")),
+        number(json, "beforeGeneration"),
+        number(json, "afterGeneration"),
+        Instant.parse(text(json, "endedAt")),
+        number(json, "endedAuthorityRevision"),
+        new WarEntry(
+            uuid(json, "endedWarId"),
+            nation(json, "endedAggressor"),
+            nation(json, "endedDefender"),
+            Instant.parse(text(json, "endedDeclaredAt")),
+            json.get("active").getAsBoolean()));
+  }
+
+  private static ReleaseReceipt release(JsonObject json) {
+    var request = new ReleaseRequest(uuid(json, "operationId"), text(json, "planHash"));
+    var status = TerminalStatus.valueOf(text(json, "status"));
+    if (!json.has("protocolVersion") && !json.has("effectProofs"))
+      return new ReleaseReceipt(request, status);
+    int version = Math.toIntExact(number(json, "protocolVersion"));
+    if (version != TreatyEffectManifest.VERSION || !json.has("effectProofs"))
+      throw new IllegalArgumentException("Invalid explicit settlement release version");
+    var proofs = new ArrayList<EffectProof>();
+    var values = json.getAsJsonArray("effectProofs");
+    if (values.size() == 0 || values.size() > 8)
+      throw new IllegalArgumentException("Invalid settlement release proof count");
+    for (var proof : values) proofs.add(WarSettlementEffectProofCodec.decode(proof.getAsString()));
+    return new ReleaseReceipt(request, status, version, proofs);
+  }
+
+  private static CancellationReceipt cancellation(JsonObject json) {
+    return new CancellationReceipt(request(json.getAsJsonObject("request")));
+  }
+
+  private static JsonObject request(Request value) {
+    var json = new JsonObject();
+    json.addProperty("operationId", value.operationId().toString());
+    json.addProperty("treatyId", value.treatyId().toString());
+    var war = value.war();
+    json.addProperty("warId", war.warId().toString());
+    json.addProperty("attacker", war.attacker().toString());
+    json.addProperty("defender", war.defender().toString());
+    json.addProperty("declaredAt", war.declaredAt().toString());
+    json.add("attackerAllies", nations(war.attackerAllies()));
+    json.add("defenderAllies", nations(war.defenderAllies()));
+    json.addProperty("warGeneration", value.warGeneration());
+    json.addProperty("warFingerprint", value.warFingerprint());
+    var scopes = new JsonArray();
+    for (var scope : value.scopes()) {
+      var pair = new JsonArray();
+      pair.add(scope.left().toString());
+      pair.add(scope.right().toString());
+      scopes.add(pair);
+    }
+    json.add("scopes", scopes);
+    json.addProperty("planHash", value.planHash());
+    json.addProperty("preparedAt", value.preparedAt().toString());
+    if (value.protocolVersion() == TreatyEffectManifest.VERSION) {
+      json.addProperty("protocolVersion", value.protocolVersion());
+      json.addProperty("manifest", TreatyEffectManifest.encodeManifest(value.manifest()));
+    }
+    return json;
+  }
+
+  private static Request request(JsonObject json) {
+    var scopes = new ArrayList<PairScope>();
+    for (var value : json.getAsJsonArray("scopes")) {
+      var pair = value.getAsJsonArray();
+      if (pair.size() != 2) throw new IllegalArgumentException("Invalid settlement pair");
+      scopes.add(
+          new PairScope(
+              NationId.of(UUID.fromString(pair.get(0).getAsString())),
+              NationId.of(UUID.fromString(pair.get(1).getAsString()))));
+    }
+    int version = 1;
+    TreatyEffectManifest.Manifest manifest = null;
+    if (json.has("protocolVersion") || json.has("manifest")) {
+      version = Math.toIntExact(number(json, "protocolVersion"));
+      if (version != TreatyEffectManifest.VERSION || !json.has("manifest"))
+        throw new IllegalArgumentException("Invalid explicit settlement request version");
+      manifest = TreatyEffectManifest.decodeManifest(text(json, "manifest"));
+    }
+    return new Request(
+        uuid(json, "operationId"),
+        uuid(json, "treatyId"),
+        new ExactWar(
+            uuid(json, "warId"),
+            nation(json, "attacker"),
+            nation(json, "defender"),
+            Instant.parse(text(json, "declaredAt")),
+            nations(json.getAsJsonArray("attackerAllies")),
+            nations(json.getAsJsonArray("defenderAllies"))),
+        number(json, "warGeneration"),
+        text(json, "warFingerprint"),
+        scopes,
+        text(json, "planHash"),
+        Instant.parse(text(json, "preparedAt")),
+        version,
+        manifest);
+  }
+
+  private static JsonArray nations(List<NationId> values) {
+    var json = new JsonArray();
+    values.forEach(value -> json.add(value.toString()));
+    return json;
+  }
+
+  private static List<NationId> nations(JsonArray json) {
+    var result = new ArrayList<NationId>();
+    json.forEach(value -> result.add(NationId.of(UUID.fromString(value.getAsString()))));
+    return result;
+  }
+
+  private static String text(JsonObject json, String key) {
+    return json.get(key).getAsString();
+  }
+
+  private static UUID uuid(JsonObject json, String key) {
+    return UUID.fromString(text(json, key));
+  }
+
+  private static NationId nation(JsonObject json, String key) {
+    return NationId.of(uuid(json, key));
+  }
+
+  private static long number(JsonObject json, String key) {
+    return new java.math.BigDecimal(text(json, key)).longValueExact();
+  }
+}
