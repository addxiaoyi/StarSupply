+    assertThatThrownBy(() -> module.applyDebit(request)).isInstanceOf(IllegalStateException.class);
+    for (var amount : List.of("0", "-1", "0.001", "1000000000000000.01"))
+      assertThatThrownBy(
+              () ->
+                  new NationDebitService.Request(
+                      UUID.randomUUID(), nation, new BigDecimal(amount), "test"))
+          .isInstanceOf(IllegalArgumentException.class);
