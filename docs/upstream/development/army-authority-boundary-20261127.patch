+    assertEquals(snapshot, ArmySnapshotViews.fromDetachedUnit(detached, TOKEN));
+    assertSame(world, detached.location().getWorld());
+    assertEquals(List.of(WORLD_ID), resolver.idLookups);
+    assertEquals(List.of(), resolver.nameLookups);
