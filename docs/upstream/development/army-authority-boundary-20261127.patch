+      EndReceipt endReceipt,
+      CancellationReceipt cancellationReceipt) {
+    return new OperationView(
+        operation.request(),
+        operation.plan(),
+        status,
+        timingPolicy.now(),
+        operation.binding(),
+        operation.request().protocolVersion() == TreatyEffectManifest.VERSION
+            ? new TerminalEvidence(basis, endReceipt, cancellationReceipt)
+            : null);
