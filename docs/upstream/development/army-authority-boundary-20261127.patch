+    var f = fixture(sql);
+    var request = request();
+    f.storage().preparePaidDeclaration(request, BigDecimal.TEN, () -> {});
+    var first = service(f, f.storage());
+    var second = service(f, f.storage());
+    var money = new Money();
+    var secondResult =
+        new java.util.concurrent.atomic.AtomicReference<
+            dev.starcore.starcore.module.war.WarDeclarationRecoveryService.Receipt>();
+    // First reader selects no money receipt, then another independent war authority completes.
+    // Returning the original empty selection forces the first call to send its delayed request.
+    money.afterRead =
+        () -> {
+          money.afterRead = () -> {};
+          secondResult.set(
+              cancellationWins
+                  ? second.cancelWarDeclaration(request.operationId(), money)
+                  : second.recoverWarDeclaration(request.operationId(), money));
+        };
+    dev.starcore.starcore.module.war.WarDeclarationRecoveryService.Receipt firstResult = null;
+    try {
+      firstResult =
+          cancellationWins
+              ? first.recoverWarDeclaration(request.operationId(), money)
+              : first.cancelWarDeclaration(request.operationId(), money);
+    } catch (IllegalStateException conflict) {
+      // Competing final war timestamps may cause a CAS refusal; only its durable winner may win.
+      assertThat(secondResult.get()).isNotNull();
+    }
+    var winner = secondResult.get();
+    assertThat(winner).isNotNull();
+    assertThat(winner.status()).isEqualTo(cancellationWins ? Status.CANCELLED : Status.DECLARED);
+    if (firstResult != null) assertThat(firstResult).isEqualTo(winner);
+    assertThat(first.recoverWarDeclaration(request.operationId(), money)).isEqualTo(winner);
+    assertThat(second.cancelWarDeclaration(request.operationId(), money)).isEqualTo(winner);
+    assertThat(f.storage().paidDeclaration(request.operationId()).orElseThrow().receipt())
+        .isEqualTo(winner);
+    assertThat(money.calls).isEqualTo(cancellationWins ? 0 : 1);
+    assertThat(money.cancelCalls).isEqualTo(cancellationWins ? 1 : 0);
+    if (cancellationWins) assertThat(f.storage().loadAllWars()).isEmpty();
+    else
+      assertThat(f.storage().loadAllWars())
+          .extracting(War::id)
+          .containsExactly(request.operationId());
+  }
