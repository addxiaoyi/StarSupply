+                  new Receipt(
+                      new Request(op.transaction().transactionId(), List.of(f.parent)),
+                      Decision.ACCEPTED)))
+          .when(first.wars)
+          .disbandAdmission(any());
+      assertThatThrownBy(() -> first.nations.recoverDisband(op.transaction().transactionId()))
+          .hasMessageContaining("could not be verified");
+      assertThat(first.nations.nationById(f.parent)).isPresent();
+      assertThat(first.receipts()).isEmpty();
+      try (var fresh = f.new Session(sql, false)) {
