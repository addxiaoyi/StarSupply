+    assertNotSame(first.location(), second.location());
+    first.location().setX(900.0);
+    first.location().setYaw(17.0f);
+    first.setState(ArmyState.ATTACKING);
+
+    assertEquals(-123.25, snapshot.position().x());
+    assertEquals(135.5f, snapshot.position().yaw());
+    assertEquals(ArmyState.SIEGING, snapshot.state());
+    assertEquals(-123.25, second.location().getX());
