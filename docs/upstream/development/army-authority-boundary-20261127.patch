+        before.type(),
+        before.createdAt(),
+        UPDATED,
+        "retired",
+        null);
+  }
+
+  private static ArmyAuthorityOwner.Retirement retirement() {
+    return new ArmyAuthorityOwner.Retirement(UPDATED, "test-retirement", null);
+  }
+
+  private static ArmyMigrationEvidence migration(String descriptor) {
+    return new ArmyMigrationEvidence(
+        "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
+        Map.of(),
+        Map.of(
+            ArmyMigrationEvidence.SOURCE_PAYLOAD_BASE64,
+            "",
+            ArmyMigrationEvidence.SOURCE_DESCRIPTOR,
+            descriptor));
+  }
+
+  private static ArmyAuthoritySnapshot live(ArmySnapshot before) {
+    return image(1, Map.of(before.token().armyId(), before), Map.of(), Map.of());
+  }
+
+  private static ArmyAuthoritySnapshot image(
+      long revision,
+      Map<UUID, ArmySnapshot> armies,
+      Map<UUID, ArmyTombstone> tombstones,
+      Map<UUID, ArmyLogisticsReceipt> receipts) {
+    return new ArmyAuthoritySnapshot(
+        true, revision, armies, tombstones, receipts, migration("test"));
