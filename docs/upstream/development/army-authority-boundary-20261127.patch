+  @Override
+  public Receipt applyAllianceOperation(Request request) {
+    Objects.requireNonNull(request, "request");
+    return withAllianceAuthority(
+        activeLifecycle -> {
+          Receipt existing = existingAllianceReceipt(request);
+          if (existing != null) return existing;
+          var pair = DiplomacyPairKey.of(request.left(), request.right());
+          DiplomacyRelation previous = relations.getOrDefault(pair, DiplomacyRelation.NEUTRAL);
+          WarService activeWarService = authoritativeWarService();
+          Outcome rejection = null;
+          if (retirements.containsKey(request.left()) || retirements.containsKey(request.right())) {
+            rejection = Outcome.REJECTED_RETIRED;
+          } else if (previous == DiplomacyRelation.WAR
+              || warRecords.containsKey(pair)
+              || warMirror.owners().containsKey(pair)
+              || (activeWarService != null
+                  && activeWarService.atWar(request.left(), request.right()))) {
+            rejection = Outcome.REJECTED_WAR;
+          } else if (allianceOperations.generation(pair) != request.expectedGeneration()
+              || previous != request.expectedRelation()
+              || (request.action() == Action.FORM
+                  && (previous == DiplomacyRelation.ALLIED
+                      || previous == DiplomacyRelation.HOSTILE))
+              || (request.action() == Action.BREAK && previous != DiplomacyRelation.ALLIED)) {
+            rejection = Outcome.REJECTED_PRECONDITION;
+          } else if (request.action() == Action.FORM
+              && isInCooldown(request.left(), request.right())) {
+            rejection = Outcome.REJECTED_COOLDOWN;
+          }
+          if (rejection != null) return sealAllianceOutcome(request, rejection, previous);
+          DiplomacyRelation target =
+              request.action() == Action.FORM
+                  ? DiplomacyRelation.ALLIED
+                  : DiplomacyRelation.NEUTRAL;
+          NationId other = pair.other(request.actor());
+          NationId eventLeft = request.action() == Action.FORM ? other : request.actor();
+          NationId eventRight = request.action() == Action.FORM ? request.actor() : other;
+          boolean accepted = publishRelationChangedEvent(eventLeft, eventRight, previous, target);
+          if (stopped || lifecycle.get() != activeLifecycle)
+            throw new IllegalStateException("Diplomacy alliance operation lifecycle changed");
+          if (!accepted) return sealAllianceOutcome(request, Outcome.CANCELLED, previous);
+          var receipt =
+              new Receipt(
+                  request,
+                  Outcome.APPLIED,
+                  Math.addExact(allianceOperations.generation(pair), 1),
+                  previous,
+                  target);
+          var nextRelations = new HashMap<>(relations);
+          nextRelations.put(pair, target);
+          var nextWars = new HashMap<>(warRecords);
+          nextWars.remove(pair);
+          var nextTimes = new HashMap<>(relationChangeTimestamps);
+          nextTimes.put(pair, request.occurredAt());
+          var pending =
+              derivedEvents.enqueue(
+                  new DiplomacyDerivedEventState.Entry(
+                      request.operationId(),
+                      eventLeft,
+                      eventRight,
+                      previous,
+                      target,
