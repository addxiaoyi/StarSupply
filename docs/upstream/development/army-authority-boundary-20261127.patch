@@ -0,0 +1,27 @@
+package dev.starcore.starcore.module.army.storage.authority;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.Objects;
+
+public final class ArmyFileAuthorityStorage extends AbstractArmyAuthorityStorage {
+  public ArmyFileAuthorityStorage(Path armyDirectory) {
+    this(armyDirectory, MAX_AUTHORITY_BYTES);
+  }
+
+  ArmyFileAuthorityStorage(Path armyDirectory, long maximumAuthorityBytes) {
+    super(authorityPath(armyDirectory), null, maximumAuthorityBytes);
+  }
+
+  private static Path authorityPath(Path armyDirectory) {
+    var directory =
+        Objects.requireNonNull(armyDirectory, "armyDirectory").toAbsolutePath().normalize();
+    try {
+      Files.createDirectories(directory);
+    } catch (IOException error) {
+      throw new IllegalStateException("Army authority directory is unavailable", error);
+    }
+    return directory.resolve("authority.properties");
+  }
+}
