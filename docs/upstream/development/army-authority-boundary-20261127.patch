+  private AllianceOperationIntent requireIntent(AllianceStorage.StateSnapshot state, UUID id) {
+    var intent = state.intents().get(Objects.requireNonNull(id));
+    if (intent == null) throw new IllegalArgumentException("Unknown alliance operation: " + id);
+    return intent;
