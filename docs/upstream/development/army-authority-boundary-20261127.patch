+          }
+          for (var pair : plan.pairs())
+            if (retirements.containsKey(pair.pair().left())
+                || retirements.containsKey(pair.pair().right()))
+              return storeTreaty(
+                  new OperationView(request, plan, Status.SUPERSEDED, timingPolicy.now()),
+                  activeLifecycle);
+          var principal = DiplomacyPairKey.of(request.war().attacker(), request.war().defender());
+          var originalEntry = warMirror.receipts().get(request.war().warId());
+          if (!request.war().warId().equals(warMirror.owners().get(principal))
