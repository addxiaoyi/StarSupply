+        IllegalArgumentException.class, () -> ArmySnapshotViews.fromDetachedUnit(unit, TOKEN));
+  }
+
+  @Test
+  void captureRejectsArmyWithNoHealth() {
+    ArmyUnit unit = unit(17, 0, new Location(world(WORLD_ID, "world"), 0, 64, 0));
+
+    assertThrows(
+        IllegalArgumentException.class, () -> ArmySnapshotViews.fromDetachedUnit(unit, TOKEN));
