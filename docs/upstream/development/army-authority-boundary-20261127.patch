+    assertEquals(List.of("ReGiMe_ChAnGe"), originals.get(0).payload());
+    assertEquals(List.of("1E+3", "3"), originals.get(1).payload());
+    assertEquals(amount, new BigDecimal(originals.get(1).payload().getFirst()));
+    assertEquals(-3, new BigDecimal(originals.get(1).payload().getFirst()).scale());
+    assertEquals(List.of("zone-b", "zone-a", "zone-b"), originals.get(2).payload());
+    assertEquals(List.of("0", "true"), originals.get(3).payload());
+    assertEquals(List.of("minecraft:iron_ingot", "7", "12"), originals.get(4).payload());
+    assertEquals(
+        terms.stream().map(PeaceTerm::description).toList(),
+        originals.stream().map(OriginalTerm::description).toList());
+    territories.clear();
+    assertEquals(List.of("zone-b", "zone-a", "zone-b"), originals.get(2).payload());
