+  private static void setField(Object target, String name, Object value) throws Exception {
+    Field field = target.getClass().getDeclaredField(name);
+    field.setAccessible(true);
+    field.set(target, value);
+  }
+
+  private static void close(WarehouseListener listener, Player player, Inventory inventory) {
+    if (inventory == null) return;
+    InventoryCloseEvent event = mock(InventoryCloseEvent.class);
+    when(event.getPlayer()).thenReturn(player);
+    when(event.getInventory()).thenReturn(inventory);
+    listener.onInventoryClose(event);
+  }
+
+  private static InventoryClickEvent click(
+      Player player, Inventory inventory, int slot, Material material) {
+    InventoryClickEvent event = mock(InventoryClickEvent.class);
+    InventoryView view = mock(InventoryView.class);
+    ItemStack item = mock(ItemStack.class);
+    when(item.getType()).thenReturn(material);
+    when(view.getTopInventory()).thenReturn(inventory);
+    when(event.getWhoClicked()).thenReturn(player);
+    when(event.getView()).thenReturn(view);
+    when(event.getInventory()).thenReturn(inventory);
+    when(event.getClickedInventory()).thenReturn(inventory);
+    when(event.getRawSlot()).thenReturn(slot);
+    when(event.getCurrentItem()).thenReturn(item);
+    when(event.getClick()).thenReturn(ClickType.LEFT);
+    when(event.isLeftClick()).thenReturn(true);
+    return event;
+  }
+
+  private static InventoryDragEvent drag(Player player, Inventory inventory) {
+    InventoryDragEvent event = mock(InventoryDragEvent.class);
+    InventoryView view = mock(InventoryView.class);
+    when(view.getTopInventory()).thenReturn(inventory);
+    when(event.getWhoClicked()).thenReturn(player);
+    when(event.getView()).thenReturn(view);
+    return event;
+  }
+}
