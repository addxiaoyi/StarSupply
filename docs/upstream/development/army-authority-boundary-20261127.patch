+  @Test
+  void snapshotCounterBoundsEscapedWriterWithoutAllocatingTheMeasuredSnapshot() throws Exception {
+    var properties = new Properties();
+    properties.setProperty(" spaced:=#!\\key\t", " leading:=#!\\\t\n\r\f\u0000中文😀");
+    properties.setProperty("plain", "a b");
+    var encoded = new ByteArrayOutputStream();
+    properties.store(encoded, "STARCORE diplomacy state");
+    long measured = DiplomacyTreatyCapacity.snapshotBytes(properties, Long.MAX_VALUE);
+    assertThat(measured).isGreaterThanOrEqualTo(encoded.size());
+    assertThatThrownBy(() -> DiplomacyTreatyCapacity.snapshotBytes(properties, measured - 1))
+        .isInstanceOf(IllegalArgumentException.class)
+        .hasMessageContaining("capacity");
+    assertThat(DiplomacyTreatyCapacity.snapshotBytes(properties, measured)).isEqualTo(measured);
+  }
