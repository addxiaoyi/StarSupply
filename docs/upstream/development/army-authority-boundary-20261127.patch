+  private <T> T withAllianceAuthority(java.util.function.LongFunction<T> action) {
+    long activeLifecycle;
+    synchronized (this) {
+      if (stopped || authorityUnavailable || !mutating.compareAndSet(false, true))
+        throw new IllegalStateException("Diplomacy authority unavailable, stopped or busy");
+      activeLifecycle = lifecycle.get();
+    }
+    try {
+      requireOperationLifecycle(activeLifecycle);
+      requireStorage();
+      loadState();
+      requireOperationLifecycle(activeLifecycle);
+      return action.apply(activeLifecycle);
+    } catch (RuntimeException failure) {
+      if (stateStorage != null)
+        try {
+          loadState();
+        } catch (RuntimeException read) {
+          authorityUnavailable = true;
+          failure.addSuppressed(read);
+        }
+      throw failure;
+    } finally {
+      mutating.set(false);
+    }
+  }
+
+  private void requireOperationLifecycle(long activeLifecycle) {
+    if (stopped || lifecycle.get() != activeLifecycle)
+      throw new IllegalStateException("Diplomacy operation lifecycle changed");
+  }
