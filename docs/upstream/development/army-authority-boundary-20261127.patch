+            .orElseThrow(() -> new IllegalStateException("Original settlement admission missing"));
+    if (!admission.request().planHash().equals(request.planHash()))
+      throw new IllegalArgumentException("Conflicting settlement release hash");
+    var receiver = settlementOperations;
+    if (admission.request().protocolVersion() == TreatyEffectManifest.VERSION) {
+      var proofs = settlementEffects(admission.request(), receiver, false);
+      TerminalStatus status =
+          switch (proofs.getFirst().phase()) {
+            case APPLIED -> TerminalStatus.APPLIED;
+            case CANCELLED -> TerminalStatus.CANCELLED;
+            case SUPERSEDED -> TerminalStatus.SUPERSEDED;
+            case BOUND ->
+                throw new IllegalStateException("Bound treaty effect cannot release settlement");
+          };
+      var receipt = new ReleaseReceipt(request, status, TreatyEffectManifest.VERSION, proofs);
+      return mutate(
+          () -> {
+            requireSettlementReceiver(receiver);
+            return storage.releaseSettlement(receipt);
