+      throws Exception {
+    var f = fixture();
+    try (var first = f.new Session(sql, true)) {
+      first.fail(NationDisbandJointTest.Endpoint.WAR, false, f.parent);
+      assertThatThrownBy(() -> first.nations.disbandNation(f.parent));
+      var original = first.operation();
+      var storage = new WarStateStorage(first.plugin, first.database);
+      assertThatThrownBy(
+              () ->
+                  storage.prepareDisband(
+                      new Request(original.transaction().transactionId(), List.of(f.parent))))
+          .hasMessageContaining("Conflicting");
+      assertThatThrownBy(() -> storage.retireNationWars(UUID.randomUUID(), f.parent))
+          .hasMessageContaining("Conflicting");
+      var current = NationStateCodec.snapshot(first.directory.load());
+      var corrupted = new HashMap<>(current.disbands());
+      corrupted.put(
+          original.transaction().transactionId(),
+          new NationDisbandOperation(
+              original.transaction(), NationDisbandOperation.State.COMPLETED));
+      assertThatThrownBy(
+              () ->
+                  first.directory.save(
+                      NationStateCodec.toProperties(
+                          current.nations(),
+                          current.creations(),
+                          current.claims(),
+                          current.splits(),
+                          corrupted)))
+          .isInstanceOf(IllegalStateException.class)
+          .hasStackTraceContaining("Disband request and terminal history are immutable");
+      assertThat(NationStateCodec.snapshot(first.directory.load()).disbands())
+          .isEqualTo(current.disbands());
+    }
+  }
