+  private AllianceResult formationResult(AllianceOperationIntent intent) {
+    boolean applied = intent.status() == Status.ACKNOWLEDGED && intent.outcome() == Outcome.APPLIED;
+    boolean visible = applied && visibleAlliance(intent.pair(), alliances.get(intent.pair()));
+    return new AllianceResult(
+        visible,
+        visible ? "联盟关系已建立" : applied ? "联盟操作已确认，但已被后续关系变更取代" : "联盟操作已终止: " + intent.outcome());
+  }
+
+  private boolean visibleAlliance(AlliancePairKey pair, AllianceInfoData data) {
+    if (stopped || stateLoadFailed || data == null || storage == null || operationService == null)
+      return false;
+    try {
+      var latest = storage.loadStateSnapshot();
+      if (latest.retirements().containsKey(pair.left())
+          || latest.retirements().containsKey(pair.right())
+          || !data.equals(latest.alliances().get(pair))) return false;
+      var owner = latest.projectionOwners().get(pair);
+      if (owner == null || !owner.active()) return false;
+      var intent = latest.intents().get(owner.operationId());
+      if (intent == null
+          || intent.status() != Status.ACKNOWLEDGED
+          || intent.outcome() != Outcome.APPLIED
+          || intent.request().action() != Action.FORM
+          || intent.receiptGeneration() != owner.generation()
+          || !data.equals(intent.proposedAlliance())) return false;
+      var receiver = readPair(pair);
+      return receiver.ownedBy(owner.operationId())
+          && receiver.generation() == owner.generation()
+          && receiver.relation() == DiplomacyRelation.ALLIED;
+    } catch (RuntimeException unavailable) {
+      return false;
+    }
+  }
