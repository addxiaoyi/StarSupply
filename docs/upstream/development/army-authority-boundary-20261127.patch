+  private Plan freezeTreatyPlan(ReserveRequest request) {
+    var targets = new HashMap<PairScope, DiplomacyRelation>();
+    var participants = request.war().participants();
+    for (int leftIndex = 0; leftIndex < participants.size(); leftIndex++)
+      for (int rightIndex = leftIndex + 1; rightIndex < participants.size(); rightIndex++)
+        targets.put(
+            PairScope.of(participants.get(leftIndex), participants.get(rightIndex)),
+            DiplomacyRelation.NEUTRAL);
+    var termTargets = new HashMap<PairScope, DiplomacyRelation>();
+    var termPlans = new ArrayList<TermPlan>();
+    for (var term : request.terms()) {
+      String requirement = term.requirement().toLowerCase(Locale.ROOT);
+      if (!term.type().equals("PoliticalTerm") || !POLITICAL_REQUIREMENTS.contains(requirement))
+        throw new IllegalArgumentException("Unsupported or mixed treaty terms");
+      var politicalTargets = new HashSet<PairScope>();
+      var politicalPair = PairScope.of(request.victor(), request.defeated());
+      politicalTargets.add(politicalPair);
+      DiplomacyRelation target =
+          switch (requirement) {
+            case "vassal" -> DiplomacyRelation.VASSAL;
+            case "regime_change", "embargo" -> DiplomacyRelation.HOSTILE;
+            case "no_war" -> DiplomacyRelation.CEASE_FIRE;
+            case "neutrality" -> DiplomacyRelation.NEUTRAL;
+            default -> throw new IllegalArgumentException("Unknown political requirement");
+          };
+      if (requirement.equals("neutrality")) {
+        for (var pair : targets.keySet())
+          if (pair.left().equals(request.defeated()) || pair.right().equals(request.defeated()))
+            politicalTargets.add(pair);
+        for (var pair : relations.keySet())
+          if (pair.contains(request.defeated()))
+            politicalTargets.add(PairScope.of(pair.left(), pair.right()));
+      }
+      for (var pair : politicalTargets) {
+        var old = termTargets.putIfAbsent(pair, target);
+        if (old != null && old != target)
+          throw new IllegalArgumentException("Conflicting political targets");
+        targets.put(pair, target);
+      }
+      termPlans.add(
+          new TermPlan(
+              term.termIndex(),
+              UUID.nameUUIDFromBytes(
+                  (request.operationId() + ":restriction:" + term.termIndex())
+                      .getBytes(java.nio.charset.StandardCharsets.UTF_8)),
+              request.preparedAt(),
+              requirement,
+              term.description(),
+              request.defeated()));
+    }
+    if (targets.size() > MAX_PAIRS)
+      throw new IllegalArgumentException("Treaty scope exceeds capacity");
+    var pairs =
+        targets.entrySet().stream()
+            .sorted(
+                Comparator.comparing(
+                        (Map.Entry<PairScope, DiplomacyRelation> entry) ->
+                            entry.getKey().left().toString())
+                    .thenComparing(entry -> entry.getKey().right().toString()))
+            .map(
+                entry -> {
+                  var pair = DiplomacyPairKey.of(entry.getKey().left(), entry.getKey().right());
+                  return new PairPlan(
+                      entry.getKey(),
+                      relations.getOrDefault(pair, DiplomacyRelation.NEUTRAL),
+                      allianceOperations.generation(pair),
+                      entry.getValue());
+                })
+            .toList();
+    return new Plan(
+        request, pairs, termPlans, DiplomacyTreatyOperationCodec.hash(request, pairs, termPlans));
+  }
