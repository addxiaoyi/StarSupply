+  record Form(Player player, BiConsumer<Player, String> submit, Consumer<Player> cancel) {}
+
+  record Task(Runnable action, Runnable retired) {}
+
+  static final class Fixture {
+    final Plugin plugin = mock(Plugin.class);
+    final Player player = player(UUID.randomUUID());
+    final List<Form> forms = new ArrayList<>();
+    final Deque<Task> tasks = new ArrayDeque<>();
+    final List<String> results = new ArrayList<>();
+    final AtomicLong clock = new AtomicLong();
+    final NativeTextInput input;
+
+    Fixture() {
+      when(plugin.isEnabled()).thenReturn(true);
+      input =
+          new NativeTextInput(
+              plugin,
+              (owner, prompt, submit, cancel) -> forms.add(new Form(owner, submit, cancel)),
+              (owner, action, retired) -> tasks.add(new Task(action, retired)),
+              clock::get);
+    }
+
+    void queue() {
+      input.open(
+          player,
+          new NativeTextInput.Prompt("title", "initial", 20),
+          results::add,
+          () -> results.add("cancel"));
+    }
+
+    Form open() {
+      queue();
+      tasks.removeLast().action().run();
+      return forms.getLast();
+    }
+
+    void drain() {
+      while (!tasks.isEmpty()) tasks.removeFirst().action().run();
+    }
+  }
+
+  static Player player(UUID id) {
+    var player = mock(Player.class);
+    when(player.getUniqueId()).thenReturn(id);
+    when(player.isOnline()).thenReturn(true);
+    return player;
+  }
+
+  @Test
+  void responseRunsOnOwnerSchedulerOnceAndPreservesLiteralText() {
+    var fixture = new Fixture();
+    var form = fixture.open();
+    form.submit().accept(fixture.player, " /literal\n文字 ");
+    form.submit().accept(fixture.player, "duplicate");
+    form.cancel().accept(fixture.player);
+    assertThat(fixture.results).isEmpty();
+    assertThat(fixture.tasks).hasSize(1);
+    fixture.drain();
+    assertThat(fixture.results).containsExactly(" /literal\n文字 ");
+    verify(fixture.player, never()).getInventory();
+  }
+
+  @Test
+  void foreignConnectionCannotConsumeOriginalForm() {
+    var fixture = new Fixture();
+    var form = fixture.open();
+    form.submit().accept(player(UUID.randomUUID()), "foreign");
+    form.submit().accept(player(fixture.player.getUniqueId()), "reconnected");
+    assertThat(fixture.tasks).isEmpty();
+    form.submit().accept(fixture.player, "owner");
+    fixture.drain();
+    assertThat(fixture.results).containsExactly("owner");
+  }
+
+  @Test
+  void supersessionRejectsBothOldQueuedResponseAndOldDialogButton() {
+    var fixture = new Fixture();
+    var old = fixture.open();
+    old.submit().accept(fixture.player, "old");
+    var current = fixture.open();
+    old.cancel().accept(fixture.player);
+    fixture.drain();
+    assertThat(fixture.results).isEmpty();
+    current.submit().accept(fixture.player, "current");
+    fixture.drain();
+    assertThat(fixture.results).containsExactly("current");
+  }
+
+  @Test
+  void quitStopExpiryAndRetirementInvalidateQueuedPublication() {
+    for (String reason : List.of("quit", "stop", "expiry", "retired", "offline", "disabled")) {
+      var fixture = new Fixture();
+      fixture.queue();
+      switch (reason) {
+        case "quit" -> fixture.input.onQuit(new PlayerQuitEvent(fixture.player, "quit"));
+        case "stop" -> fixture.input.close();
+        case "expiry" -> fixture.clock.set(NativeTextInput.LIFETIME.toNanos());
+        case "retired" -> fixture.tasks.getFirst().retired().run();
+        case "offline" -> when(fixture.player.isOnline()).thenReturn(false);
+        case "disabled" -> when(fixture.plugin.isEnabled()).thenReturn(false);
+      }
+      fixture.drain();
+      assertThat(fixture.forms).as(reason).isEmpty();
+      verify(fixture.player, never()).getInventory();
+    }
+  }
+
+  @Test
+  void lifecycleAndExpiryAreRecheckedAfterResponseScheduling() {
+    for (String reason : List.of("quit", "stop", "expiry", "offline", "disabled", "retired")) {
+      var fixture = new Fixture();
+      fixture.open().submit().accept(fixture.player, "queued");
+      switch (reason) {
+        case "quit" -> fixture.input.cancel(fixture.player);
+        case "stop" -> fixture.input.close();
+        case "expiry" -> fixture.clock.set(NativeTextInput.LIFETIME.toNanos());
+        case "offline" -> when(fixture.player.isOnline()).thenReturn(false);
+        case "disabled" -> when(fixture.plugin.isEnabled()).thenReturn(false);
+        case "retired" -> fixture.tasks.getFirst().retired().run();
+      }
+      fixture.drain();
+      assertThat(fixture.results).as(reason).isEmpty();
+    }
+  }
+
+  @Test
+  void cancelAndInvalidPayloadNeverSubmitContent() {
+    var fixture = new Fixture();
+    fixture.open().cancel().accept(fixture.player);
+    fixture.drain();
+    fixture.open().submit().accept(fixture.player, null);
+    fixture.drain();
+    fixture.open().submit().accept(fixture.player, "x".repeat(21));
+    fixture.drain();
+    assertThat(fixture.results).containsExactly("cancel", "cancel", "cancel");
+  }
+
+  @Test
+  void unrelatedPluginDisableDoesNotCloseButOwnerDisableDoes() {
+    var fixture = new Fixture();
+    var form = fixture.open();
+    try (var bukkit = mockStatic(Bukkit.class)) {
+      bukkit.when(Bukkit::isPrimaryThread).thenReturn(true);
+      fixture.input.onDisable(new PluginDisableEvent(mock(Plugin.class)));
+      assertThat(fixture.input.isStopped()).isFalse();
+      fixture.input.onDisable(new PluginDisableEvent(fixture.plugin));
+    }
+    assertThat(fixture.input.isStopped()).isTrue();
+    form.submit().accept(fixture.player, "late");
+    assertThat(fixture.tasks).isEmpty();
+    assertThatThrownBy(fixture::queue).isInstanceOf(IllegalStateException.class);
+  }
+
+  @Test
+  void failedPublicationDiscardsCapturedCallbackAndAllowsAnotherAttempt() {
+    var fixture = new Fixture();
+    var failure = new AtomicBoolean(true);
+    var input =
+        new NativeTextInput(
+            fixture.plugin,
+            (owner, prompt, submit, cancel) -> {
+              fixture.forms.add(new Form(owner, submit, cancel));
+              if (failure.getAndSet(false)) throw new IllegalStateException("show failed");
+            },
+            (owner, action, retired) -> action.run(),
+            fixture.clock::get);
+    Runnable open =
+        () ->
+            input.open(
+                fixture.player,
+                new NativeTextInput.Prompt("a", "", 10),
+                fixture.results::add,
+                () -> {});
+    assertThatThrownBy(open::run).isInstanceOf(IllegalStateException.class);
+    fixture.forms.getFirst().submit().accept(fixture.player, "stale");
+    assertThat(fixture.results).isEmpty();
+    open.run();
+    fixture.forms.getLast().submit().accept(fixture.player, "next");
+    assertThat(fixture.results).containsExactly("next");
+  }
+
+  @Test
+  void rejectedResponseSchedulingDiscardsSession() {
+    var fixture = new Fixture();
+    var input =
+        new NativeTextInput(
+            fixture.plugin,
+            (owner, prompt, submit, cancel) -> fixture.forms.add(new Form(owner, submit, cancel)),
+            (owner, action, retired) -> {
+              if (!fixture.forms.isEmpty()) throw new IllegalStateException("scheduler stopped");
+              action.run();
+            },
+            fixture.clock::get);
+    input.open(
+        fixture.player, new NativeTextInput.Prompt("a", "", 10), fixture.results::add, () -> {});
+    var form = fixture.forms.getFirst();
+    assertThatThrownBy(() -> form.submit().accept(fixture.player, "value"))
+        .isInstanceOf(IllegalStateException.class);
+    form.submit().accept(fixture.player, "retry");
+    assertThat(fixture.results).isEmpty();
+  }
+
+  @Test
+  void invalidPromptFailsBeforeChangingAnySession() {
+    assertThatThrownBy(() -> new NativeTextInput.Prompt("a", "long", 2))
+        .isInstanceOf(IllegalArgumentException.class);
+    assertThatThrownBy(() -> new NativeTextInput.Prompt("a", "", 0))
+        .isInstanceOf(IllegalArgumentException.class);
+  }
+
+  @Test
+  void contextRevocationPreventsPublicationAndQueuedResponse() {
+    for (boolean beforePublication : List.of(true, false)) {
+      var fixture = new Fixture();
+      var active = new AtomicBoolean(true);
+      fixture.input.open(
+          fixture.player,
+          new NativeTextInput.Prompt("Context", "", 20),
+          active::get,
+          fixture.results::add,
+          () -> fixture.results.add("cancel"));
+      if (beforePublication) active.set(false);
+      fixture.drain();
+      if (beforePublication) {
