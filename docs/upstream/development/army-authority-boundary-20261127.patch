@@ -0,0 +1,124 @@
+package dev.starcore.starcore.module.diplomacy;
+
+import dev.starcore.starcore.module.nation.model.NationId;
+import java.time.Instant;
+import java.util.Objects;
+import java.util.Optional;
+import java.util.UUID;
+
+public interface DiplomacyAllianceOperationService {
+  enum Action {
+    FORM,
+    BREAK
+  }
+
+  enum Outcome {
+    APPLIED,
+    CANCELLED,
+    REJECTED_RETIRED,
+    REJECTED_WAR,
+    REJECTED_PRECONDITION,
+    REJECTED_COOLDOWN
+  }
+
+  record Request(
+      UUID operationId,
+      NationId left,
+      NationId right,
+      Action action,
+      NationId actor,
+      Instant occurredAt,
+      DiplomacyRelation expectedRelation,
+      long expectedGeneration) {
+    public Request {
+      Objects.requireNonNull(operationId, "operationId");
+      Objects.requireNonNull(left, "left");
+      Objects.requireNonNull(right, "right");
+      Objects.requireNonNull(action, "action");
+      Objects.requireNonNull(actor, "actor");
+      Objects.requireNonNull(occurredAt, "occurredAt");
+      Objects.requireNonNull(expectedRelation, "expectedRelation");
+      if (left.toString().compareTo(right.toString()) >= 0)
+        throw new IllegalArgumentException(
+            "Alliance operation endpoints must be distinct and ordered");
+      if (!actor.equals(left) && !actor.equals(right))
+        throw new IllegalArgumentException("Alliance operation actor must be an endpoint");
+      if (expectedGeneration < 0)
+        throw new IllegalArgumentException("Invalid expected alliance generation");
+    }
+  }
+
+  record Receipt(
+      Request request,
+      Outcome outcome,
+      long generation,
+      DiplomacyRelation previousRelation,
+      DiplomacyRelation resultingRelation) {
+    public Receipt {
+      Objects.requireNonNull(request, "request");
+      Objects.requireNonNull(outcome, "outcome");
+      Objects.requireNonNull(previousRelation, "previousRelation");
+      Objects.requireNonNull(resultingRelation, "resultingRelation");
+      if (generation < 0) throw new IllegalArgumentException("Invalid alliance generation");
+      if (outcome == Outcome.APPLIED) {
+        DiplomacyRelation target =
+            request.action() == Action.FORM ? DiplomacyRelation.ALLIED : DiplomacyRelation.NEUTRAL;
+        if (resultingRelation != target
+            || previousRelation != request.expectedRelation()
+            || (request.action() == Action.FORM
+                && (previousRelation == DiplomacyRelation.ALLIED
+                    || previousRelation == DiplomacyRelation.WAR
+                    || previousRelation == DiplomacyRelation.HOSTILE))
+            || (request.action() == Action.BREAK && previousRelation != DiplomacyRelation.ALLIED)
+            || generation != Math.addExact(request.expectedGeneration(), 1))
+          throw new IllegalArgumentException("Invalid applied alliance receipt");
+      } else if (previousRelation != resultingRelation) {
+        throw new IllegalArgumentException("Rejected alliance operation changed its relation");
+      }
+    }
+
+    public boolean applied() {
+      return outcome == Outcome.APPLIED;
+    }
+  }
+
+  record PairState(
+      NationId left,
+      NationId right,
+      long generation,
+      DiplomacyRelation relation,
+      UUID ownerOperationId,
+      boolean retired) {
+    public PairState {
+      Objects.requireNonNull(left, "left");
+      Objects.requireNonNull(right, "right");
+      Objects.requireNonNull(relation, "relation");
+      if (left.toString().compareTo(right.toString()) >= 0 || generation < 0)
+        throw new IllegalArgumentException("Invalid alliance pair state");
+      if (retired && ownerOperationId != null)
+        throw new IllegalArgumentException("Retired alliance pair cannot have an owner");
+    }
+
+    public boolean ownedBy(UUID operationId) {
+      return !retired && operationId != null && operationId.equals(ownerOperationId);
+    }
+  }
+
+  default Receipt applyAllianceOperation(Request request) {
+    throw new UnsupportedOperationException("Durable alliance operations are not supported");
+  }
+
+  default Receipt cancelAllianceOperation(Request request) {
+    throw new UnsupportedOperationException(
+        "Durable alliance operation cancellation is not supported");
+  }
+
+  default PairState alliancePairState(NationId left, NationId right) {
+    throw new UnsupportedOperationException("Durable alliance pair state is not supported");
+  }
+
+  default Optional<Receipt> allianceOperationReceipt(UUID operationId) {
+    throw new UnsupportedOperationException(
+        "Durable alliance operation receipts are not supported");
+  }
+}
