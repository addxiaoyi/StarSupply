+    }
+  }
+
+  private static BigDecimal moneyAmount(BigDecimal amount) {
+    BigDecimal value = Objects.requireNonNull(amount);
+    if (value.signum() <= 0
+        || value.compareTo(PlayerMoneyService.MAX_BALANCE) > 0
+        || value.stripTrailingZeros().scale() > 2)
+      throw new IllegalArgumentException("金额必须为正数，最多两位小数，且不超过余额上限");
+    return value.setScale(2, RoundingMode.UNNECESSARY);
+  }
+
+  private <T> CompletableFuture<T> submit(Callable<T> action) {
+    CompletableFuture<T> result = new CompletableFuture<>();
+    pending.add(result);
+    result.whenComplete((ignored, failure) -> pending.remove(result));
+    if (closed) result.completeExceptionally(new IllegalStateException("Clan bank stopped"));
+    else
+      try {
+        io.execute(
+            () -> {
+              try {
+                result.complete(action.call());
+              } catch (Exception failure) {
+                result.completeExceptionally(failure);
+              }
+            });
+      } catch (RejectedExecutionException busy) {
+        result.completeExceptionally(busy);
+      }
+    return result;
+  }
+
+  @Override
+  public void close() {
+    closed = true;
+    io.shutdown();
