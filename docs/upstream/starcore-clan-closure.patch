diff --git a/src/test/java/dev/starcore/starcore/clan/ClanBankRecoveryTest.java b/src/test/java/dev/starcore/starcore/clan/ClanBankRecoveryTest.java
new file mode 100644
index 0000000..8a52575
--- /dev/null
+++ b/src/test/java/dev/starcore/starcore/clan/ClanBankRecoveryTest.java
@@ -0,0 +1,400 @@
+package dev.starcore.starcore.clan;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.ArgumentMatchers.*;
+import static org.mockito.Mockito.*;
+
+import dev.starcore.starcore.core.extension.ExtensionRegistry;
+import dev.starcore.starcore.core.persistence.AtomicFilePersistence;
+import dev.starcore.starcore.core.persistence.PersistenceService;
+import dev.starcore.starcore.core.scheduler.StarCoreScheduler;
+import dev.starcore.starcore.foundation.economy.InternalEconomyService;
+import dev.starcore.starcore.foundation.economy.PlayerMoneyService;
+import java.io.IOException;
+import java.math.BigDecimal;
+import java.nio.file.*;
+import java.util.*;
+import java.util.concurrent.*;
+import java.util.concurrent.atomic.*;
+import java.util.function.Supplier;
+import java.util.logging.Logger;
+import org.bukkit.plugin.java.JavaPlugin;
+import org.junit.jupiter.api.*;
+import org.junit.jupiter.api.io.TempDir;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+
+class ClanBankRecoveryTest {
+  @TempDir Path directory;
+  private final Logger log = Logger.getAnonymousLogger();
+  private final UUID actor = UUID.randomUUID();
+  private ClanManager manager;
+  private Clan clan;
+  private InternalEconomyService economy;
+
+  @BeforeEach
+  void initialize() {
+    ExtensionRegistry.init(log);
+    ExtensionRegistry.getInstance().clear();
+    manager = new ClanManager();
+    JavaPlugin plugin = mock(JavaPlugin.class);
+    when(plugin.getDataFolder()).thenReturn(directory.toFile());
+    when(plugin.getLogger()).thenReturn(log);
+    manager.setPlugin(plugin);
+    clan = manager.createClan("TAG", "Bank", actor);
+    clan.deposit(100);
+    economy = economy();
+    economy.applyMoney(
+        new PlayerMoneyService.Request(
+            UUID.randomUUID(),
+            actor,
+            PlayerMoneyService.Direction.CREDIT,
+            new BigDecimal("100"),
+            "test:initial"));
+  }
+
+  private InternalEconomyService economy() {
+    JavaPlugin plugin = mock(JavaPlugin.class);
+    when(plugin.getDataFolder()).thenReturn(directory.resolve("economy").toFile());
+    when(plugin.getLogger()).thenReturn(log);
+    StarCoreScheduler scheduler = mock(StarCoreScheduler.class);
+    when(scheduler.supplyAsync(any()))
+        .thenAnswer(
+            call -> CompletableFuture.completedFuture(call.getArgument(0, Supplier.class).get()));
+    PersistenceService persistence = new PersistenceService(plugin, scheduler);
+    persistence.start();
+    InternalEconomyService service = new InternalEconomyService(persistence);
+    service.start();
+    return service;
+  }
+
+  private ClanBankService bank(PlayerMoneyService authority, ClanBankService.Writer writer) {
+    return new ClanBankService(
+        manager, directory, authority, log, writer, Executors.newSingleThreadExecutor());
+  }
+
+  private void write(Path file, String content) throws IOException {
+    AtomicFilePersistence.replace(file, temp -> Files.writeString(temp, content));
+  }
+
+  private static <T> T await(CompletionStage<T> result) throws Exception {
+    return result.toCompletableFuture().get(5, TimeUnit.SECONDS);
+  }
+
+  private void assertMoney(String value) {
+    assertEquals(0, economy.balance(actor).compareTo(new BigDecimal(value)));
+  }
+
+  @Test
+  void realMoneyDepositAndWithdrawalConserveValueAcrossBothRestarts() throws Exception {
+    try (var bank = bank(economy, this::write)) {
+      assertEquals(
+          ClanBankService.State.APPLIED,
+          await(bank.transfer(clan.getId(), actor, new BigDecimal("12.50"), true)).state());
+      assertMoney("87.50");
+      assertEquals(0, bank.balance(clan.getId()).compareTo(new BigDecimal("112.50")));
+      assertEquals(
+          ClanBankService.State.APPLIED,
+          await(bank.transfer(clan.getId(), actor, new BigDecimal("20.25"), false)).state());
+      assertMoney("107.75");
+    }
+    economy = economy();
+    try (var restarted = bank(economy, this::write)) {
+      await(restarted.recover());
+      await(restarted.recover());
+      assertMoney("107.75");
+      assertEquals(0, restarted.balance(clan.getId()).compareTo(new BigDecimal("92.25")));
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {true, false})
+  void lostPlayerReceiptResponseRecoversWithOriginalIdExactlyOnce(boolean deposit)
+      throws Exception {
+    AtomicBoolean lose = new AtomicBoolean(true);
+    PlayerMoneyService authority =
+        new PlayerMoneyService() {
+          public Optional<Receipt> moneyReceipt(UUID id) {
+            return economy.moneyReceipt(id);
+          }
+
+          public Receipt applyMoney(Request request) {
+            Receipt result = economy.applyMoney(request);
+            if (lose.getAndSet(false)) throw new IllegalStateException("lost player result");
+            return result;
+          }
+        };
+    UUID operation;
+    try (var bank = bank(authority, this::write)) {
+      var result = await(bank.transfer(clan.getId(), actor, new BigDecimal("10"), deposit));
+      operation = result.operation();
+      assertEquals(ClanBankService.State.PENDING, result.state());
+      assertTrue(bank.busy(clan.getId()));
+      assertEquals(
+          ClanBankService.State.BUSY,
+          await(bank.transfer(clan.getId(), actor, new BigDecimal("11"), deposit)).state());
+    }
+    economy = economy();
+    try (var restarted = bank(economy, this::write)) {
+      await(restarted.recover());
+      await(restarted.recover());
+      assertMoney(deposit ? "90" : "110");
+      assertEquals(
+          0, restarted.balance(clan.getId()).compareTo(new BigDecimal(deposit ? "110" : "90")));
+      assertTrue(economy.moneyReceipt(operation).isPresent());
+      assertFalse(restarted.busy(clan.getId()));
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {true, false})
+  void failedFinalLedgerWriteUsesReceiptWithoutRepeatingMoney(boolean afterReplace)
+      throws Exception {
+    AtomicInteger writes = new AtomicInteger();
+    try (var bank =
+        bank(
+            economy,
+            (file, content) -> {
+              int step = writes.incrementAndGet();
+              if (step == 3 && !afterReplace) throw new IOException("before final replace");
+              write(file, content);
+              if (step == 3) throw new IOException("after final replace");
+            })) {
+      assertEquals(
+          ClanBankService.State.PENDING,
+          await(bank.transfer(clan.getId(), actor, new BigDecimal("10"), false)).state());
+      assertMoney("110");
+      await(bank.recover());
+      await(bank.recover());
+      assertMoney("110");
+      assertEquals(0, bank.balance(clan.getId()).compareTo(new BigDecimal("90")));
+    }
+  }
+
+  @Test
+  void failedPreparedWriteCannotCallPlayerAuthority() throws Exception {
+    PlayerMoneyService authority = mock(PlayerMoneyService.class);
+    AtomicInteger writes = new AtomicInteger();
+    try (var bank =
+        bank(
+            authority,
+            (file, content) -> {
+              if (writes.incrementAndGet() == 2) throw new IOException("cannot save intent");
+              write(file, content);
+            })) {
+      assertThrows(
+          ExecutionException.class,
+          () -> await(bank.transfer(clan.getId(), actor, new BigDecimal("10"), false)));
+      verifyNoInteractions(authority);
+      assertEquals(0, bank.balance(clan.getId()).compareTo(new BigDecimal("100")));
+    }
+  }
+
+  @Test
+  void authoritativeRejectionReleasesWithdrawalReservation() throws Exception {
+    PlayerMoneyService authority =
+        new PlayerMoneyService() {
+          public Optional<Receipt> moneyReceipt(UUID id) {
+            return Optional.empty();
+          }
+
+          public Receipt applyMoney(Request request) {
+            return new Receipt(
+                request,
+                Status.EXTENSION_REJECTED,
+                new BigDecimal("100"),
+                new BigDecimal("100"),
+                1);
+          }
+        };
+    try (var bank = bank(authority, this::write)) {
+      assertEquals(
+          ClanBankService.State.REJECTED,
+          await(bank.transfer(clan.getId(), actor, new BigDecimal("10"), false)).state());
+      assertEquals(0, bank.balance(clan.getId()).compareTo(new BigDecimal("100")));
+      assertMoney("100");
+    }
+  }
+
+  @Test
+  void insufficientClanBalanceDoesNotInvokeMoneyAndInvalidAmountsAreRejected() throws Exception {
+    PlayerMoneyService authority = mock(PlayerMoneyService.class);
+    try (var bank = bank(authority, this::write)) {
+      assertEquals(
+          ClanBankService.State.REJECTED,
+          await(bank.transfer(clan.getId(), actor, new BigDecimal("101"), false)).state());
+      for (String invalid :
+          List.of("0", "-1", "0.001", "999999999999999999999", "1e100000000", "1e-100000000"))
+        assertThrows(
+            RuntimeException.class,
+            () -> bank.transfer(clan.getId(), actor, new BigDecimal(invalid), true));
+      verifyNoInteractions(authority);
+    }
+  }
+
+  @Test
+  void corruptLedgerStopsRecoveryAndCannotBeReplacedByOldMemory() throws Exception {
+    AtomicInteger writes = new AtomicInteger();
+    try (var bank =
+        bank(
+            economy,
+            (file, content) -> {
+              if (writes.incrementAndGet() == 3) {
+                Files.writeString(file, "{broken");
+                throw new IOException("unreadable authority");
+              }
+              write(file, content);
+            })) {
+      assertEquals(
+          ClanBankService.State.PENDING,
+          await(bank.transfer(clan.getId(), actor, new BigDecimal("10"), true)).state());
+      assertThrows(ExecutionException.class, () -> await(bank.recover()));
+      assertThrows(
+          ExecutionException.class,
+          () -> await(bank.transfer(clan.getId(), actor, new BigDecimal("10"), true)));
+      assertEquals("{broken", Files.readString(directory.resolve("clan-bank.json")));
+      assertMoney("90");
+    }
+  }
+
+  @Test
+  void failedPreparedResponseAfterReplaceIsRecoveredWithOnePlayerOperation() throws Exception {
+    AtomicInteger writes = new AtomicInteger();
+    try (var bank =
+        bank(
+            economy,
+            (file, content) -> {
+              write(file, content);
+              if (writes.incrementAndGet() == 2) throw new IOException("lost prepared response");
+            })) {
+      assertThrows(
+          ExecutionException.class,
+          () -> await(bank.transfer(clan.getId(), actor, new BigDecimal("10"), true)));
+      assertMoney("100");
+      assertTrue(bank.busy(clan.getId()));
+      await(bank.recover());
+      await(bank.recover());
+      assertMoney("90");
+      assertEquals(0, bank.balance(clan.getId()).compareTo(new BigDecimal("110")));
+    }
+  }
+
+  @Test
+  void realPlayerInsufficientFundsCannotMintClanMoney() throws Exception {
+    try (var bank = bank(economy, this::write)) {
+      assertEquals(
+          ClanBankService.State.REJECTED,
+          await(bank.transfer(clan.getId(), actor, new BigDecimal("101"), true)).state());
+      assertMoney("100");
+      assertEquals(0, bank.balance(clan.getId()).compareTo(new BigDecimal("100")));
+    }
+  }
+
+  @Test
+  void conflictingPlayerReceiptStaysPendingWithoutChangingClanBalance() throws Exception {
+    PlayerMoneyService authority = mock(PlayerMoneyService.class);
+    when(authority.moneyReceipt(any()))
+        .thenAnswer(
+            call -> {
+              var wrong =
+                  new PlayerMoneyService.Request(
+                      call.getArgument(0),
+                      UUID.randomUUID(),
+                      PlayerMoneyService.Direction.DEBIT,
+                      BigDecimal.TEN,
+                      "other:source");
+              return Optional.of(
+                  new PlayerMoneyService.Receipt(
+                      wrong,
+                      PlayerMoneyService.Status.APPLIED,
+                      BigDecimal.TEN,
+                      BigDecimal.ZERO,
+                      1));
+            });
+    try (var bank = bank(authority, this::write)) {
+      assertEquals(
+          ClanBankService.State.PENDING,
+          await(bank.transfer(clan.getId(), actor, BigDecimal.TEN, true)).state());
+      await(bank.recover());
+      assertEquals(0, bank.balance(clan.getId()).compareTo(new BigDecimal("100")));
+      verify(authority, never()).applyMoney(any());
+    }
+  }
+
+  @Test
+  void callerCancellationCannotDiscardAnAdmittedTransfer() throws Exception {
+    CountDownLatch entered = new CountDownLatch(1), release = new CountDownLatch(1);
+    PlayerMoneyService authority =
+        new PlayerMoneyService() {
+          public Optional<Receipt> moneyReceipt(UUID id) {
+            return economy.moneyReceipt(id);
+          }
+
+          public Receipt applyMoney(Request request) {
+            entered.countDown();
+            try {
+              if (!release.await(5, TimeUnit.SECONDS)) throw new IllegalStateException("timeout");
+            } catch (InterruptedException interrupted) {
+              Thread.currentThread().interrupt();
+              throw new IllegalStateException(interrupted);
+            }
+            return economy.applyMoney(request);
+          }
+        };
+    try (var bank = bank(authority, this::write)) {
+      var result = bank.transfer(clan.getId(), actor, BigDecimal.TEN, true).toCompletableFuture();
+      try {
+        assertTrue(entered.await(5, TimeUnit.SECONDS));
+        assertTrue(result.cancel(true));
+        assertTrue(bank.busy(clan.getId()));
+      } finally {
+        release.countDown();
+      }
+      await(bank.recover());
+      assertMoney("90");
+      assertEquals(0, bank.balance(clan.getId()).compareTo(new BigDecimal("110")));
+      assertFalse(bank.busy(clan.getId()));
+    }
+  }
+
+  @Test
+  void managerRestartRecoversPendingMoneyAndBlocksDisbandUntilResolved() throws Exception {
+    PlayerMoneyService loseResponse =
+        new PlayerMoneyService() {
+          public Optional<Receipt> moneyReceipt(UUID id) {
+            return economy.moneyReceipt(id);
+          }
+
+          public Receipt applyMoney(Request request) {
+            economy.applyMoney(request);
+            throw new IllegalStateException("lost result");
+          }
+        };
+    manager.initializeBank(loseResponse);
+    manager.persistBankMigration();
+    try {
+      assertEquals(
+          ClanBankService.State.PENDING,
+          await(manager.transferMoney(actor, BigDecimal.TEN, true)).state());
+      assertFalse(manager.disbandClan(actor, clan.getId()));
+    } finally {
+      manager.shutdown();
+    }
+    assertMoney("90");
+    economy = economy();
+    ClanManager restarted = new ClanManager();
+    restarted.setPlugin(manager.plugin());
+    restarted.loadData();
+    restarted.initializeBank(economy);
+    restarted.persistBankMigration();
+    try {
+      await(restarted.recoverBank());
+      await(restarted.recoverBank());
+      assertMoney("90");
+      assertEquals(110, restarted.getClan(clan.getId()).getBalance());
+      assertTrue(restarted.getClan(clan.getId()).isMember(actor));
+    } finally {
+      restarted.shutdown();
+    }
+  }
+}
