@@ -0,0 +1,345 @@
+package dev.starcore.starcore.clan;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+import com.google.gson.JsonParser;
+import dev.starcore.starcore.core.persistence.AtomicFilePersistence;
+import dev.starcore.starcore.foundation.economy.PlayerMoneyService;
+import java.io.IOException;
+import java.math.BigDecimal;
+import java.nio.file.*;
+import java.util.*;
+import java.util.concurrent.*;
+import java.util.concurrent.atomic.*;
+import java.util.logging.Logger;
+import org.bukkit.plugin.Plugin;
+import org.junit.jupiter.api.*;
+import org.junit.jupiter.api.io.TempDir;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+
+class ClanPersistenceConcurrencyTest {
+  @TempDir Path directory;
+  private final UUID leader = UUID.randomUUID();
+
+  private ClanManager manager() {
+    return manager(this::write);
+  }
+
+  private ClanManager manager(ClanManager.StateWriter writer) {
+    Plugin plugin = mock(Plugin.class);
+    when(plugin.getDataFolder()).thenReturn(directory.toFile());
+    when(plugin.getLogger()).thenReturn(Logger.getAnonymousLogger());
+    ClanManager manager = new ClanManager(writer);
+    manager.setPlugin(plugin);
+    return manager;
+  }
+
+  private void write(Path file, String content) throws IOException {
+    AtomicFilePersistence.replace(file, temp -> Files.writeString(temp, content));
+  }
+
+  private Path file() {
+    return directory.resolve("clan_data.json");
+  }
+
+  private static <T> T await(CompletionStage<T> future) throws Exception {
+    return future.toCompletableFuture().get(5, TimeUnit.SECONDS);
+  }
+
+  @Test
+  void mutationsDuringSnapshotWriteRemainDirtyAndSurviveNextRestart() throws Exception {
+    CountDownLatch captured = new CountDownLatch(1), release = new CountDownLatch(1);
+    AtomicBoolean block = new AtomicBoolean(true);
+    ClanManager manager =
+        manager(
+            (file, json) -> {
+              if (block.getAndSet(false)) {
+                captured.countDown();
+                try {
+                  if (!release.await(5, TimeUnit.SECONDS)) throw new IOException("timeout");
+                } catch (InterruptedException interrupted) {
+                  Thread.currentThread().interrupt();
+                  throw new IOException(interrupted);
+                }
+              }
+              write(file, json);
+            });
+    Clan clan = manager.createClan("TAG", "before", leader);
+    try (var worker = Executors.newSingleThreadExecutor()) {
+      Future<?> saving = worker.submit(manager::saveDirtyClans);
+      assertTrue(captured.await(5, TimeUnit.SECONDS));
+      clan.setName("during write");
+      clan.addDeath();
+      release.countDown();
+      saving.get(5, TimeUnit.SECONDS);
+    } finally {
+      release.countDown();
+    }
+    assertTrue(manager.hasDirtyClans());
+    manager.saveDirtyClans();
+    assertFalse(manager.hasDirtyClans());
+    ClanManager restored = manager();
+    restored.loadData();
+    assertEquals("during write", restored.getClan(clan.getId()).getName());
+    assertEquals(1, restored.getClan(clan.getId()).getDeaths());
+  }
+
+  @Test
+  void failedAtomicWriteRetainsPriorSnapshotAndUnsavedChanges() throws Exception {
+    AtomicBoolean fail = new AtomicBoolean();
+    ClanManager manager =
+        manager(
+            (file, json) -> {
+              if (fail.get())
+                AtomicFilePersistence.replace(
+                    file,
+                    temp -> {
+                      Files.writeString(temp, "partial");
+                      throw new IOException("disk fault");
+                    });
+              else write(file, json);
+            });
+    Clan clan = manager.createClan("TAG", "before", leader);
+    manager.saveData();
+    String before = Files.readString(file());
+    fail.set(true);
+    clan.setName("after");
+    manager.saveDirtyClans();
+    assertEquals(before, Files.readString(file()));
+    assertTrue(manager.hasDirtyClans());
+    fail.set(false);
+    manager.saveDirtyClans();
+    ClanManager restored = manager();
+    restored.loadData();
+    assertEquals("after", restored.getClan(clan.getId()).getName());
+  }
+
+  @ParameterizedTest
+  @ValueSource(
+      strings = {
+        "{}",
+        "null",
+        "[]",
+        "{\"clans\":null}",
+        "{\"version\":2,\"clans\":[]}",
+        "{\"version\":1,\"clans\":[]}",
+        "{\"clans\":[{}]}",
+        "{broken"
+      })
+  void corruptSnapshotsFreezeMutationAndCannotBeOverwritten(String corrupt) throws Exception {
+    Files.writeString(file(), corrupt);
+    ClanManager manager = manager();
+    manager.loadData();
+    assertNull(manager.createClan("TAG", "new", leader));
+    manager.saveData();
+    manager.shutdown();
+    assertEquals(corrupt, Files.readString(file()));
+    assertThrows(
+        IllegalStateException.class, () -> manager.initializeBank(mock(PlayerMoneyService.class)));
+  }
+
+  @Test
+  void missingCurrentWithBackupDoesNotBecomeAnEmptyClanDatabase() throws Exception {
+    ClanManager manager = manager();
+    manager.createClan("TAG", "one", leader);
+    manager.saveData();
+    manager.saveData();
+    assertTrue(Files.exists(AtomicFilePersistence.backup(file())));
+    Files.delete(file());
+    ClanManager restored = manager();
+    restored.loadData();
+    assertNull(restored.createClan("NEW", "two", UUID.randomUUID()));
+    restored.saveData();
+    assertFalse(Files.exists(file()));
+  }
+
+  @Test
+  void legacySnapshotRestoresTimesStatsRanksAndUnloadedHomeWithoutBukkitAccess() throws Exception {
+    ClanManager manager = manager();
+    Clan clan = manager.createClan("TAG", "Persisted", leader);
+    UUID member = UUID.randomUUID();
+    manager.joinClan(member, clan.getId());
+    manager.setRank(leader, member, Clan.ClanRank.OFFICER);
+    clan.addKills(7);
+    clan.addDeaths(2);
+    clan.deposit(12.5);
+    clan.restoreHome("unloaded", 1, 65, -2, 90, 15);
+    clan.restoreTimes(1000, 2000);
+    manager.saveData();
+    var legacy = JsonParser.parseString(Files.readString(file())).getAsJsonObject();
+    legacy.remove("version");
+    legacy.remove("bankProtocol");
+    Files.writeString(file(), legacy.toString());
+    ClanManager restored = manager();
+    restored.loadData();
+    Clan loaded = restored.getClan(clan.getId());
+    assertNotNull(loaded);
+    assertEquals(1000, loaded.getCreatedTime());
+    assertEquals(2000, loaded.getLastActiveTime());
+    assertEquals(7, loaded.getKills());
+    assertEquals(2, loaded.getDeaths());
+    assertEquals(12.5, loaded.getBalance());
+    assertEquals(Clan.ClanRank.OFFICER, loaded.getRank(member));
+    assertEquals("unloaded", loaded.getHomeWorld());
+    assertEquals(65, loaded.homeSnapshot().getY());
+    loaded.homeSnapshot().setY(90);
+    assertEquals(65, loaded.homeSnapshot().getY());
+    restored.saveData();
+    assertTrue(Files.readString(file()).contains("unloaded"));
+  }
+
+  @Test
+  void simultaneousCreateAndJoinKeepUniqueTagsMembersAndCapacity() throws Exception {
+    ClanManager manager = manager();
+    try (var workers = Executors.newFixedThreadPool(2)) {
+      var created =
+          workers.invokeAll(
+              List.of(
+                  () -> manager.createClan("TAG", "one", leader),
+                  () -> manager.createClan("tag", "two", leader)));
+      assertEquals(
+          1,
+          created.stream()
+              .filter(
+                  f -> {
+                    try {
+                      return f.get() != null;
+                    } catch (Exception e) {
+                      throw new AssertionError(e);
+                    }
+                  })
+              .count());
+      Clan clan = manager.getPlayerClan(leader);
+      List<Callable<Boolean>> joins = new ArrayList<>();
+      for (int i = 0; i < 50; i++) {
+        UUID id = UUID.randomUUID();
+        joins.add(() -> manager.joinClan(id, clan.getId()));
+      }
+      for (var joined : workers.invokeAll(joins)) joined.get(5, TimeUnit.SECONDS);
+      assertEquals(30, clan.getMemberCount());
+      assertEquals(30, manager.getTotalMembers());
+      UUID extra = UUID.randomUUID();
+      assertTrue(manager.invitePlayer(leader, extra));
+      assertFalse(manager.acceptInvite(extra, clan.getId()));
+      assertNull(manager.getPlayerClan(extra));
+      assertFalse(manager.kickMember(leader, leader));
+      assertSame(clan, manager.getPlayerClan(leader));
+    }
+  }
+
+  @Test
+  void snapshotsAndRanksCannotGrantOutsiderOrDemoteLeader() {
+    ClanManager manager = manager();
+    Clan clan = manager.createClan("TAG", "one", leader);
+    Set<UUID> snapshot = clan.getMembers();
+    UUID member = UUID.randomUUID();
+    assertFalse(clan.hasPermission(member, Clan.ClanPermission.DEPOSIT));
+    assertThrows(
+        UnsupportedOperationException.class,
+        () -> Clan.ClanRank.MEMBER.getPermissions().add(Clan.ClanPermission.ALL));
+    manager.joinClan(member, clan.getId());
+    assertEquals(Set.of(leader), snapshot);
+    assertFalse(manager.setRank(leader, leader, Clan.ClanRank.MEMBER));
+    assertEquals(Clan.ClanRank.LEADER, clan.getRank(leader));
+    Clan other = manager.createClan("TWO", "two", UUID.randomUUID());
+    assertFalse(manager.createAlliance(member, clan.getId(), other.getId()));
+    assertFalse(manager.createAlliance(leader, clan.getId(), clan.getId()));
+  }
+
+  @Test
+  void bankMigrationMarkerAndNewClanIdentityMustBeSavedBeforeAnyMoneyCall() throws Exception {
+    AtomicBoolean fail = new AtomicBoolean();
+    ClanManager manager =
+        manager(
+            (file, json) -> {
+              if (fail.get()) throw new IOException("metadata unavailable");
+              write(file, json);
+            });
+    PlayerMoneyService money = mock(PlayerMoneyService.class);
+    manager.initializeBank(money);
+    try {
+      fail.set(true);
+      assertThrows(IllegalStateException.class, manager::persistBankMigration);
+      Clan clan = manager.createClan("TAG", "new", leader);
+      assertThrows(
+          ExecutionException.class,
+          () -> await(manager.transferMoney(leader, BigDecimal.ONE, true)));
+      fail.set(false);
+      manager.persistBankMigration();
+      UUID fresh = UUID.randomUUID();
+      Clan unsaved = manager.createClan("NEW", "new", fresh);
+      fail.set(true);
+      assertThrows(
+          ExecutionException.class,
+          () -> await(manager.transferMoney(fresh, BigDecimal.ONE, true)));
+      verifyNoInteractions(money);
+      assertFalse(Files.readString(file()).contains(unsaved.getId().toString()));
+      fail.set(false);
+      when(money.moneyReceipt(org.mockito.ArgumentMatchers.any())).thenReturn(Optional.empty());
+      when(money.applyMoney(org.mockito.ArgumentMatchers.any()))
+          .thenAnswer(
+              call -> {
+                assertTrue(Files.readString(file()).contains(unsaved.getId().toString()));
+                var request = call.getArgument(0, PlayerMoneyService.Request.class);
+                return new PlayerMoneyService.Receipt(
+                    request,
+                    PlayerMoneyService.Status.APPLIED,
+                    BigDecimal.TEN,
+                    new BigDecimal("9"),
+                    1);
+              });
+      assertEquals(
+          ClanBankService.State.APPLIED,
+          await(manager.transferMoney(fresh, BigDecimal.ONE, true)).state());
+      assertThrows(IllegalStateException.class, () -> clan.deposit(1));
+      assertEquals(1, unsaved.getBalance());
+    } finally {
+      fail.set(false);
+      manager.shutdown();
+    }
+  }
+
+  @Test
+  void migratedBankCannotBeReimportedWhenAuthorityDisappears() throws Exception {
+    ClanManager manager = manager();
+    manager.createClan("TAG", "bank", leader).deposit(20);
+    manager.initializeBank(mock(PlayerMoneyService.class));
+    manager.persistBankMigration();
+    manager.shutdown();
+    Files.delete(directory.resolve("clan-bank.json"));
+    ClanManager restored = manager();
+    restored.loadData();
+    assertTrue(restored.bankExpected());
+    assertThrows(
+        IllegalStateException.class, () -> restored.initializeBank(mock(PlayerMoneyService.class)));
+    assertFalse(Files.exists(directory.resolve("clan-bank.json")));
+  }
+
+  @Test
+  void acceptingAnExpiredInviteCannotBypassTheThirtyMinuteLimit() throws Exception {
+    ClanManager manager = manager();
+    Clan clan = manager.createClan("TAG", "one", leader);
+    UUID target = UUID.randomUUID();
+    var field = ClanManager.class.getDeclaredField("clanInvites");
+    field.setAccessible(true);
+    @SuppressWarnings("unchecked")
+    Map<UUID, Set<ClanManager.ClanInvite>> invites =
+        (Map<UUID, Set<ClanManager.ClanInvite>>) field.get(manager);
+    invites.put(
+        target,
+        new HashSet<>(
+            Set.of(
+                new ClanManager.ClanInvite(
+                    clan.getId(),
+                    leader,
+                    target,
+                    System.currentTimeMillis() - TimeUnit.MINUTES.toMillis(31)))));
+    assertFalse(manager.acceptInvite(target, clan.getId()));
+    assertNull(manager.getPlayerClan(target));
+    assertTrue(manager.getInvites(target).isEmpty());
+    assertTrue(manager.invitePlayer(leader, target));
+    assertTrue(manager.acceptInvite(target, clan.getId()));
+  }
+}
