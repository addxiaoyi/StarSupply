diff --git a/src/main/java/dev/starcore/starcore/clan/ClanBankService.java b/src/main/java/dev/starcore/starcore/clan/ClanBankService.java
new file mode 100644
index 0000000..2d5d25b
--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/clan/ClanBankService.java
@@ -0,0 +1,334 @@
+package dev.starcore.starcore.clan;
+
+import com.google.gson.Gson;
+import com.google.gson.GsonBuilder;
+import dev.starcore.starcore.core.persistence.AtomicFilePersistence;
+import dev.starcore.starcore.foundation.economy.PlayerMoneyService;
+import java.io.IOException;
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.*;
+import java.util.concurrent.*;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.logging.Logger;
+
+/** Clan bank authority. Balance reservations and requests share one durable ledger. */
+public final class ClanBankService implements AutoCloseable {
+  public enum State {
+    PENDING,
+    APPLIED,
+    REJECTED,
+    BUSY
+  }
+
+  public record Result(UUID operation, State state, BigDecimal balance) {}
+
+  private record Transfer(
+      UUID id, UUID clan, UUID player, BigDecimal amount, boolean deposit, State state) {
+    Transfer {
+      Objects.requireNonNull(id);
+      Objects.requireNonNull(clan);
+      Objects.requireNonNull(player);
+      amount = moneyAmount(amount);
+      if (state == null || state == State.BUSY)
+        throw new IllegalArgumentException("Invalid transfer state");
+    }
+
+    PlayerMoneyService.Request request() {
+      return new PlayerMoneyService.Request(
+          id,
+          player,
+          deposit ? PlayerMoneyService.Direction.DEBIT : PlayerMoneyService.Direction.CREDIT,
+          amount,
+          "starcore:clan-bank:" + clan);
+    }
+
+    Transfer terminal(State state) {
+      return new Transfer(id, clan, player, amount, deposit, state);
+    }
+  }
+
+  private record Ledger(
+      int version, Map<UUID, BigDecimal> balances, Map<UUID, Transfer> transfers) {
+    Ledger {
+      if (version != 1 || balances == null || transfers == null)
+        throw new IllegalArgumentException("Invalid Clan bank ledger");
+      balances.forEach(
+          (id, amount) -> {
+            Objects.requireNonNull(id);
+            if (amount == null
+                || amount.signum() < 0
+                || amount.compareTo(PlayerMoneyService.MAX_BALANCE) > 0
+                || amount.stripTrailingZeros().scale() > 2)
+              throw new IllegalArgumentException("Invalid Clan balance");
+          });
+      Set<UUID> pendingClans = new HashSet<>();
+      Map<UUID, BigDecimal> validatedBalances = balances;
+      transfers.forEach(
+          (id, transfer) -> {
+            if (transfer == null
+                || !id.equals(transfer.id())
+                || !validatedBalances.containsKey(transfer.clan()))
+              throw new IllegalArgumentException("Invalid Clan transfer binding");
+            if (transfer.state() == State.PENDING && !pendingClans.add(transfer.clan()))
+              throw new IllegalArgumentException("Multiple pending Clan transfers");
+            if (transfer.state() == State.PENDING
+                && validatedBalances
+                        .get(transfer.clan())
+                        .add(transfer.amount())
+                        .compareTo(PlayerMoneyService.MAX_BALANCE)
+                    > 0) throw new IllegalArgumentException("Invalid Clan deposit reservation");
+          });
+      balances = Map.copyOf(balances);
+      transfers = Map.copyOf(transfers);
+    }
+  }
+
+  @FunctionalInterface
+  interface Writer {
+    void write(Path path, String json) throws IOException;
+  }
+
+  private final Path file;
+  private final ClanManager manager;
+  private final PlayerMoneyService money;
+  private final Logger logger;
+  private final Writer writer;
+  private final ExecutorService io;
+  private final Gson gson = new GsonBuilder().setPrettyPrinting().create();
+  private final Map<UUID, AtomicInteger> admitted = new ConcurrentHashMap<>();
+  private final Set<CompletableFuture<?>> pending = ConcurrentHashMap.newKeySet();
+  private volatile Ledger ledger;
+  private volatile boolean closed;
+  private volatile boolean uncertain;
+
+  ClanBankService(ClanManager manager, Path directory, PlayerMoneyService money, Logger logger) {
+    this(
+        manager,
+        directory,
+        money,
+        logger,
+        (path, json) -> AtomicFilePersistence.replace(path, temp -> Files.writeString(temp, json)),
+        new ThreadPoolExecutor(
+            1,
+            1,
+            0L,
+            TimeUnit.MILLISECONDS,
+            new ArrayBlockingQueue<>(128),
+            task -> {
+              Thread thread = new Thread(task, "StarCore-Clan-bank");
+              thread.setDaemon(true);
+              return thread;
+            },
+            new ThreadPoolExecutor.AbortPolicy()));
+  }
+
+  ClanBankService(
+      ClanManager manager,
+      Path directory,
+      PlayerMoneyService money,
+      Logger logger,
+      Writer writer,
+      ExecutorService io) {
+    this.file = directory.resolve("clan-bank.json");
+    this.manager = manager;
+    this.money = Objects.requireNonNull(money);
+    this.logger = logger;
+    this.writer = writer;
+    this.io = io;
+    try {
+      if (Files.exists(file)) ledger = read();
+      else {
+        if (manager.bankExpected()
+            || Files.exists(AtomicFilePersistence.backup(file))
+            || Files.exists(AtomicFilePersistence.temp(file)))
+          throw new IOException("Missing Clan bank authority; refusing to import stale balances");
+        Map<UUID, BigDecimal> balances = new HashMap<>();
+        manager
+            .getAllClans()
+            .forEach(clan -> balances.put(clan.getId(), BigDecimal.valueOf(clan.getBalance())));
+        Ledger initial = new Ledger(1, balances, Map.of());
+        writer.write(file, gson.toJson(initial));
+        ledger = initial;
+      }
+    } catch (IOException | RuntimeException failure) {
+      io.shutdownNow();
