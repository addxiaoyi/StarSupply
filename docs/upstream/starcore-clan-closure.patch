+  private boolean transferMoney(Player player, String input, boolean deposit) {
+    Clan clan = clanManager.getPlayerClan(player);
+    if (clan == null) {
+      player.sendMessage(Component.text("你不在任何Clan中", NamedTextColor.RED));
+      return true;
+    }
+    if (!clan.hasPermission(
+        player.getUniqueId(),
+        deposit ? Clan.ClanPermission.DEPOSIT : Clan.ClanPermission.WITHDRAW)) {
+      player.sendMessage(Component.text(deposit ? "你没有存款权限" : "你没有取款权限", NamedTextColor.RED));
+      return true;
+    }
+    BigDecimal amount;
+    try {
+      BigDecimal parsed = new BigDecimal(input);
+      if (parsed.signum() <= 0
+          || parsed.compareTo(
+                  dev.starcore.starcore.foundation.economy.PlayerMoneyService.MAX_BALANCE)
+              > 0
+          || parsed.stripTrailingZeros().scale() > 2) throw new IllegalArgumentException();
+      amount = parsed.setScale(2, java.math.RoundingMode.UNNECESSARY);
+    } catch (IllegalArgumentException | ArithmeticException invalid) {
+      player.sendMessage(Component.text("无效金额：必须大于0，最多两位小数且不超过余额上限", NamedTextColor.RED));
+      return true;
+    }
+    var transfer = clanManager.transferMoney(player.getUniqueId(), amount, deposit);
+    if (transfer == null) { // Unavailable authority never authorizes a free deposit or a one-sided
+      // withdrawal.
+      player.sendMessage(Component.text("Clan 银行暂不可用", NamedTextColor.RED));
+      return true;
+    }
+    transfer.whenComplete(
+        (result, failure) ->
+            onOwner(
+                player,
+                () -> {
+                  if (failure != null) {
+                    player.sendMessage(
+                        Component.text("银行操作未确认，请等待恢复后查询余额；不要重复转账。", NamedTextColor.YELLOW));
+                    return;
+                  }
+                  String text =
+                      switch (result.state()) {
+                        case APPLIED ->
+                            (deposit ? "已存入 " : "已取出 ") + amount.toPlainString() + "，双方余额已保存";
+                        case REJECTED -> "操作被拒绝（余额不足、上限或经济规则），双方资金已核对";
+                        case PENDING -> "银行操作待恢复，编号 " + result.operation();
+                        case BUSY -> "Clan 有未完成的银行操作，编号 " + result.operation();
+                      };
+                  player.sendMessage(
+                      Component.text(
+                          text,
+                          result.state() == dev.starcore.starcore.clan.ClanBankService.State.APPLIED
+                              ? NamedTextColor.GREEN
+                              : NamedTextColor.YELLOW));
+                }));
+    return true;
+  }
