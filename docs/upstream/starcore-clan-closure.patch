+      if (!entry.isJsonObject()) throw new IOException("Invalid Clan entry");
+      var clan = entry.getAsJsonObject();
+      for (String field : List.of("id", "tag", "name", "leader"))
+        if (!clan.has(field)
+            || !clan.get(field).isJsonPrimitive()
+            || !clan.getAsJsonPrimitive(field).isString())
+          throw new IOException("Missing Clan " + field);
+      for (String field : List.of("members", "allies", "rivals"))
+        if (!clan.has(field) || !clan.get(field).isJsonArray())
+          throw new IOException("Missing Clan " + field);
+      if (!clan.has("ranks") || !clan.get("ranks").isJsonObject())
+        throw new IOException("Missing Clan ranks");
+      for (String field : List.of("kills", "deaths", "balance", "createdTime", "lastActiveTime")) {
+        if (!clan.has(field)
+            || !clan.get(field).isJsonPrimitive()
+            || !clan.getAsJsonPrimitive(field).isNumber()
+            || clan.get(field).getAsBigDecimal().signum() < 0)
+          throw new IOException("Invalid Clan " + field);
+        if (field.equals("kills") || field.equals("deaths"))
+          clan.get(field).getAsBigDecimal().intValueExact();
+        else if (!field.equals("balance")) clan.get(field).getAsBigDecimal().longValueExact();
+      }
+      for (String field : List.of("friendlyFire", "pvpEnabled"))
+        if (!clan.has(field)
+            || !clan.get(field).isJsonPrimitive()
+            || !clan.getAsJsonPrimitive(field).isBoolean())
+          throw new IOException("Invalid Clan " + field);
+    }
+  }
