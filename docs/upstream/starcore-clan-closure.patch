+package dev.starcore.starcore.clan;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.ArgumentMatchers.*;
+import static org.mockito.Mockito.*;
+
+import dev.starcore.starcore.clan.chat.ClanChatChannel;
+import dev.starcore.starcore.clan.command.ClanCommand;
+import dev.starcore.starcore.clan.listener.ClanPvPListener;
+import dev.starcore.starcore.core.scheduler.FeedbackSchedulerFixture;
+import dev.starcore.starcore.util.MessageUtil;
+import java.math.BigDecimal;
+import java.nio.file.Path;
+import java.util.*;
+import java.util.concurrent.CompletableFuture;
+import java.util.logging.Logger;
+import net.kyori.adventure.text.Component;
+import net.kyori.adventure.text.serializer.plain.PlainTextComponentSerializer;
+import org.bukkit.Bukkit;
+import org.bukkit.command.Command;
+import org.bukkit.damage.DamageSource;
+import org.bukkit.entity.Player;
+import org.bukkit.entity.Projectile;
+import org.bukkit.event.entity.EntityDamageByEntityEvent;
+import org.bukkit.event.entity.PlayerDeathEvent;
+import org.bukkit.event.player.AsyncPlayerChatEvent;
+import org.bukkit.event.player.PlayerQuitEvent;
+import org.junit.jupiter.api.*;
+import org.junit.jupiter.api.io.TempDir;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.EnumSource;
+
+class ClanOwnershipTest {
+  @TempDir Path directory;
+  private FeedbackSchedulerFixture fixture;
+  private ClanManager manager;
+  private Player leader, member;
+  private UUID leaderId;
+  private Clan clan;
+  private ClanCommand command;
+  private final Map<Player, List<String>> messages = new IdentityHashMap<>();
+
+  @ParameterizedTest
+  @org.junit.jupiter.params.provider.ValueSource(strings = {"1e100000000", "1e-100000000", "0.001"})
+  void invalidMagnitudeOrPrecisionNeverReachesMoneyAuthority(String input) {
+    command(leader, "deposit", input);
+    verify(manager, never()).transferMoney(any(), any(), anyBoolean());
+    assertTrue(messages.get(leader).stream().anyMatch(message -> message.contains("无效金额")));
+  }
+
+  @BeforeEach
+  void setup() {
+    fixture = new FeedbackSchedulerFixture();
+    when(fixture.plugin.getDataFolder()).thenReturn(directory.toFile());
+    when(fixture.plugin.getLogger()).thenReturn(Logger.getAnonymousLogger());
+    manager = spy(new ClanManager());
+    manager.setPlugin(fixture.plugin);
+    leader = player("Leader");
+    member = player("Member");
+    leaderId = leader.getUniqueId();
+    clan = manager.createClan("TAG", "Owners", leaderId);
+    assertTrue(manager.joinClan(member.getUniqueId(), clan.getId()));
+    command = new ClanCommand(manager);
+  }
+
+  @AfterEach
+  void teardown() {
+    try {
+      if (manager != null) manager.shutdown();
+    } finally {
+      MessageUtil.shutdown();
+      if (fixture != null) fixture.close();
+    }
+  }
+
+  private Player player(String name) {
+    Player player = fixture.player(0);
+    when(player.getName()).thenReturn(name);
+    messages.put(player, new ArrayList<>());
+    fixture.bukkit.when(() -> Bukkit.getPlayer(player.getUniqueId())).thenReturn(player);
+    doAnswer(
+            call -> {
+              assertSame(player, fixture.owner);
+              messages.get(player).add(call.getArgument(0));
+              return null;
+            })
+        .when(player)
+        .sendMessage(anyString());
+    doAnswer(
+            call -> {
+              assertSame(player, fixture.owner);
+              messages
+                  .get(player)
+                  .add(PlainTextComponentSerializer.plainText().serialize(call.getArgument(0)));
+              return null;
+            })
+        .when(player)
+        .sendMessage(any(Component.class));
+    return player;
+  }
+
+  private void command(Player actor, String... args) {
+    fixture.owner = actor;
+    try {
+      command.onCommand(actor, mock(Command.class), "clan", args);
+    } finally {
+      fixture.owner = null;
+    }
+  }
+
+  @Test
+  void commandToggleControlsAsyncChatAndEachReceiverOwnsDelivery() {
+    ClanChatChannel channel = new ClanChatChannel(manager);
+    command(leader, "chat");
+    assertTrue(channel.isClanChatMode(leader.getUniqueId()));
+    messages.values().forEach(List::clear);
+    AsyncPlayerChatEvent event =
+        new AsyncPlayerChatEvent(true, leader, "private", Set.of(leader, member));
+    channel.onChat(event);
+    assertTrue(event.isCancelled());
+    assertTrue(messages.get(member).isEmpty());
+    assertTrue(messages.get(leader).isEmpty());
+    fixture.pending.getFirst().tick();
+    assertEquals(1, messages.get(leader).size());
+    assertTrue(messages.get(member).isEmpty());
+    fixture.pending.getLast().tick();
+    assertEquals(1, messages.get(member).size());
+    assertTrue(messages.get(member).getFirst().contains("private"));
+    channel.onQuit(new PlayerQuitEvent(leader, Component.empty()));
+    assertFalse(command.isClanChatEnabled(leader.getUniqueId()));
+    AsyncPlayerChatEvent publicEvent = new AsyncPlayerChatEvent(true, leader, "public", Set.of());
+    channel.onChat(publicEvent);
+    assertFalse(publicEvent.isCancelled());
+  }
+
+  @Test
+  void memberLeavingBeforeDeliveryReceivesNoOldClanChat() {
+    ClanChatChannel channel = new ClanChatChannel(manager);
+    channel.sendClanMessage(leader, "secret");
+    fixture.pending.getFirst().tick();
+    assertTrue(manager.leaveClan(member.getUniqueId()));
