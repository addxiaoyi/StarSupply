+    } catch (InterruptedException interrupted) {
+      io.shutdownNow();
+      Thread.currentThread().interrupt();
+    } finally {
+      pending.forEach(
+          future -> future.completeExceptionally(new IllegalStateException("Clan bank stopped")));
+    }
+  }
