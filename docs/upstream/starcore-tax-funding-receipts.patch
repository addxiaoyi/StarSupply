+  final class Harness implements AutoCloseable {
+    final SQLiteDataSource source = new SQLiteDataSource();
+    final AtomicBoolean loseCommit = new AtomicBoolean(),
+        blockAfterCommit = new AtomicBoolean(),
+        blockConnections = new AtomicBoolean();
+    final JdbcDatabase database;
+    final ServiceRegistry services = new ServiceRegistry();
+    SqlTreasuryStateStorage storage;
+    TreasuryModule treasury;
+    TaxationServiceImpl taxes;
+
+    Harness() throws Exception {
+      source.setUrl("jdbc:sqlite:" + directory.resolve("tax.db"));
+      database = new JdbcDatabase(source);
+      reopen();
+    }
+
+    void reopen() throws Exception {
+      if (storage != null) storage.shutdown();
+      DataSource faultSource =
+          (DataSource)
+              Proxy.newProxyInstance(
+                  getClass().getClassLoader(),
+                  new Class<?>[] {DataSource.class},
+                  (p, m, args) -> {
+                    if (!m.getName().equals("getConnection")) return invoke(m, source, args);
+                    if (blockConnections.get()) throw new SQLException("reload blocked");
+                    Connection connection = source.getConnection();
+                    return Proxy.newProxyInstance(
+                        getClass().getClassLoader(),
+                        new Class<?>[] {Connection.class},
+                        (p2, method, a) -> {
+                          Object result = invoke(method, connection, a);
+                          if (method.getName().equals("commit")
+                              && loseCommit.compareAndSet(true, false)) {
+                            if (blockAfterCommit.get()) blockConnections.set(true);
+                            throw new SQLException("commit response lost");
+                          }
+                          return result;
+                        });
+                  });
+      storage =
+          new SqlTreasuryStateStorage(faultSource, new Properties(), Logger.getAnonymousLogger());
+      treasury = new TreasuryModule();
+      set(treasury, "stateStorage", storage);
+      Method load = TreasuryModule.class.getDeclaredMethod("loadState");
+      load.setAccessible(true);
+      load.invoke(treasury);
+      services.register(NationCreditService.class, treasury);
+      services.register(TreasuryService.class, treasury);
+      taxes = new TaxationServiceImpl();
+      set(
+          taxes,
+          "currentContext",
+          new StarCoreContext(
+              null, null, null, null, null, null, database, null, null, null, services));
+    }
+
+    @Override
+    public void close() {
+      blockConnections.set(false);
+      storage.shutdown();
+    }
+  }
+
+  static void set(Object receiver, String name, Object value) throws Exception {
+    Field f = receiver.getClass().getDeclaredField(name);
+    f.setAccessible(true);
+    f.set(receiver, value);
+  }
+
+  static Object invoke(Method method, Object receiver, Object[] args) throws Throwable {
+    try {
+      return method.invoke(receiver, args);
+    } catch (InvocationTargetException e) {
+      throw e.getCause();
+    }
+  }
+
+  static final class JdbcDatabase extends DatabaseService {
+    private final DataSource source;
+
+    JdbcDatabase(DataSource source) {
+      super(null, null);
+      this.source = source;
+    }
+
+    @Override
+    public boolean execute(String sql) {
+      try (Connection c = source.getConnection();
+          Statement s = c.createStatement()) {
+        return s.execute(sql);
+      } catch (SQLException e) {
+        throw new IllegalStateException(e);
+      }
+    }
+
+    @Override
+    public int update(String sql, Object... args) {
+      try (Connection c = source.getConnection();
+          PreparedStatement s = c.prepareStatement(sql)) {
+        bind(s, args);
+        return s.executeUpdate();
+      } catch (SQLException e) {
+        throw new IllegalStateException(e);
+      }
+    }
+
+    @Override
+    public <T> T query(String sql, Function<ResultSet, T> mapper, Object... args) {
+      try (Connection c = source.getConnection();
+          PreparedStatement s = c.prepareStatement(sql)) {
+        bind(s, args);
+        try (ResultSet rows = s.executeQuery()) {
+          return mapper.apply(rows);
+        }
+      } catch (SQLException e) {
+        throw new IllegalStateException(e);
+      }
+    }
+
+    private void bind(PreparedStatement s, Object[] args) throws SQLException {
+      for (int i = 0; i < args.length; i++) s.setObject(i + 1, args[i]);
+    }
+  }
+}
