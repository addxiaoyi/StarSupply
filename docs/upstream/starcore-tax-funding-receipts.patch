+package dev.starcore.starcore.module.treasury;
+
+import dev.starcore.starcore.module.treasury.TaxationService.TaxQuote;
+import java.time.Instant;
+import java.util.Objects;
+import java.util.Optional;
+import java.util.UUID;
+
+/** Recoverable funding of a positive, previously withheld transaction-tax quote. */
+public interface TaxFundingService {
+  record Receipt(TaxQuote quote, Instant fundedAt) {
+    public Receipt {
+      Objects.requireNonNull(quote, "quote");
+      Objects.requireNonNull(fundedAt, "fundedAt");
+      fundedAt = Instant.ofEpochMilli(fundedAt.toEpochMilli());
+      if (quote.taxAmount().signum() <= 0 || !fundedAt.isAfter(Instant.EPOCH)) {
+        throw new IllegalArgumentException("Invalid funded tax receipt");
+      }
+    }
+  }
+
+  /** Honors the original withheld quote. Exceptions never prove nonpayment. */
+  Receipt fundTaxWithReceipt(TaxQuote quote);
+
+  /** Only a matching treasury credit proves funding; an intent alone never does. */
+  Optional<Receipt> taxFundingReceipt(UUID transactionId);
+}
