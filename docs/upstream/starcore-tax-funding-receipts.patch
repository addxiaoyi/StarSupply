+  @Override
+  public synchronized TaxFundingService.Receipt fundTaxWithReceipt(TaxQuote quote) {
+    Objects.requireNonNull(quote, "quote");
+    if (quote.taxAmount().signum() <= 0
+        || (quote.type() != TaxType.TARIFF && quote.type() != TaxType.BUSINESS_TAX)) {
+      throw new IllegalArgumentException("Receipt funding requires a positive transaction tax");
+    }
+    // This records ownership of the original withheld quote, never proof of treasury payment.
+    var intent = fundedTaxLedger().receiptIntent(quote.transactionId());
+    if (intent.isPresent() && !intent.get().equals(quote)) {
+      throw new IllegalArgumentException("Tax transaction is bound to a different quote");
+    }
+    fundedTaxLedger().claimReceipted(quote);
+    NationCreditService credits = taxCredits();
+    TaxFundingService.Receipt receipt;
+    boolean newlyApplied = false;
+    synchronized (credits) {
+      var request = taxCreditRequest(quote);
+      var stored = credits.creditReceipt(request.transactionId());
+      if (stored.isEmpty()) {
+        var result = credits.credit(request);
+        newlyApplied =
+            result != null && result.status() == NationCreditService.CreditStatus.APPLIED;
+        stored = credits.creditReceipt(request.transactionId());
+      }
+      receipt =
+          validateTaxCredit(
+              quote,
+              stored.orElseThrow(
+                  () ->
+                      new IllegalStateException(
+                          "Tax credit has no durable receipt; retry original quote")));
+    }
+    observeFundedReceipt(receipt);
+    if (newlyApplied) {
+      try {
+        recordTaxEvent(quote.nationId(), quote.type(), quote.taxAmount());
+      } catch (RuntimeException auditFailure) {
+        // Money and its complete audit identity are already durable. Events are best effort.
+        java.util.logging.Logger.getLogger(TaxationServiceImpl.class.getName())
+            .log(Level.WARNING, "Funded tax event failed: " + quote.transactionId(), auditFailure);
+      }
+    }
+    return receipt;
+  }
+
+  @Override
