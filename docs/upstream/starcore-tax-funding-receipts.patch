+    NationCreditService credits = taxCredits();
+    synchronized (credits) {
+      var credit = credits.creditReceipt(taxCreditKey(transactionId));
+      if (credit.isEmpty()) return Optional.empty();
+      var quote =
+          intent.orElseThrow(
+              () -> new IllegalArgumentException("Tax receipt has no original intent"));
+      var receipt = validateTaxCredit(quote, credit.get());
+      observeFundedReceipt(receipt);
+      return Optional.of(receipt);
