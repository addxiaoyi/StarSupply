@@ -0,0 +1,19 @@
+package dev.starcore.starcore.module.faith;
+
+import dev.starcore.starcore.module.nation.NationService;
+import dev.starcore.starcore.module.nation.model.Nation;
+import org.bukkit.entity.Player;
+
+public final class FaithAccess {
+  private FaithAccess() {}
+
+  public static boolean canBless(Player player, Nation nation, NationService nations) {
+    return player.hasPermission("starcore.faith.blessing")
+        && nations
+            .nationOf(player.getUniqueId())
+            .filter(current -> current.id().equals(nation.id()))
+            .isPresent()
+        && (nation.founderId().equals(player.getUniqueId())
+            || player.hasPermission("starcore.faith.admin"));
+  }
+}
