index 0000000..9ee0d69
--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/module/faith/FaithPrayerFeedback.java
@@ -0,0 +1,32 @@
+package dev.starcore.starcore.module.faith;
+
+import dev.starcore.starcore.foundation.message.MessageService;
+import net.kyori.adventure.text.Component;
+import net.kyori.adventure.text.format.NamedTextColor;
+import org.bukkit.entity.Player;
+
+public final class FaithPrayerFeedback {
+  private FaithPrayerFeedback() {}
+
+  public static void send(
+      Player player, FaithService.PrayerResult result, MessageService messages) {
+    String key =
+        switch (result.status()) {
+          case SUCCESS -> "success";
+          case COOLDOWN -> "cooldown";
+          case DAILY_LIMIT -> "daily_limit";
+          case CANCELLED -> "cancelled";
+          case BUSY -> "busy";
+          case NOT_AVAILABLE -> "unavailable";
+          case SAVE_FAILED -> "save_failed";
+        };
+    long value =
+        result.status() == FaithService.PrayerStatus.COOLDOWN
+            ? result.cooldownSeconds()
+            : result.faithGained();
+    player.sendMessage(
+        Component.text(
+            messages.format("faith.prayer." + key, value),
+            result.success() ? NamedTextColor.GREEN : NamedTextColor.RED));
+  }
+}
