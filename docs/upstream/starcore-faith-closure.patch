@@ -0,0 +1,275 @@
+package dev.starcore.starcore.module.faith;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+import dev.starcore.starcore.core.scheduler.FeedbackSchedulerFixture;
+import dev.starcore.starcore.foundation.message.MessageService;
+import dev.starcore.starcore.foundation.territory.TerritoryService;
+import dev.starcore.starcore.foundation.territory.model.*;
+import dev.starcore.starcore.module.faith.event.*;
+import dev.starcore.starcore.module.faith.gui.*;
+import dev.starcore.starcore.module.faith.listener.FaithListener;
+import dev.starcore.starcore.module.faith.model.FaithConfig;
+import dev.starcore.starcore.module.nation.NationService;
+import dev.starcore.starcore.module.nation.model.*;
+import java.nio.file.Path;
+import java.time.Clock;
+import java.util.*;
+import java.util.logging.Logger;
+import net.kyori.adventure.text.Component;
+import org.bukkit.*;
+import org.bukkit.entity.Player;
+import org.bukkit.event.block.Action;
+import org.bukkit.event.entity.EntityDamageEvent;
+import org.bukkit.event.inventory.InventoryClickEvent;
+import org.bukkit.event.player.*;
+import org.bukkit.inventory.*;
+import org.junit.jupiter.api.*;
+import org.junit.jupiter.api.io.TempDir;
+
+class FaithInteractionTest {
+  @TempDir Path directory;
+  FeedbackSchedulerFixture fixture;
+  FaithServiceImpl faith;
+  NationService nations;
+  TerritoryService territories;
+  FaithListener listener;
+  Player player;
+  Nation nation;
+  UUID playerId;
+  final MessageService messages = (key, args) -> key;
+
+  @BeforeEach
+  void setup() {
+    fixture = new FeedbackSchedulerFixture();
+    when(fixture.plugin.getDataFolder()).thenReturn(directory.toFile());
+    when(fixture.plugin.getLogger()).thenReturn(Logger.getLogger("FaithInteraction"));
+    when(fixture.world.getName()).thenReturn("world");
+    player = fixture.player(-17);
+    playerId = player.getUniqueId();
+    fixture.owner = player;
+    when(player.hasPermission(anyString())).thenReturn(true);
+    nation = new Nation(NationId.random(), "Test", playerId, "Founder");
+    nations = mock(NationService.class);
+    territories = mock(TerritoryService.class);
+    when(nations.nationOf(playerId)).thenReturn(Optional.of(nation));
+    when(nations.nationById(nation.id())).thenReturn(Optional.of(nation));
+    var config = FaithConfig.defaultConfig();
+    config =
+        new FaithConfig(
+            config.maxFaith(),
+            config.levelThresholds(),
+            config.levelConfigs(),
+            Map.of("harvest", 10.0),
+            5,
+            2,
+            3,
+            10,
+            60);
+    faith = new FaithServiceImpl(fixture.plugin, config, Clock.systemUTC(), null);
+    faith.initialize();
+    faith.initializeFaith(nation.id(), playerId);
+    listener = new FaithListener(faith, nations, territories, messages);
+  }
+
+  @AfterEach
+  void close() {
+    try {
+      if (faith != null) faith.shutdown();
+    } finally {
+      if (fixture != null) fixture.close();
+    }
+  }
+
+  PlayerInteractEvent interact(EquipmentSlot hand) {
+    var event = mock(PlayerInteractEvent.class);
+    var item = mock(ItemStack.class);
+    when(item.getType()).thenReturn(Material.BLAZE_ROD);
+    when(event.getAction()).thenReturn(Action.RIGHT_CLICK_AIR);
+    when(event.getHand()).thenReturn(hand);
+    when(event.getItem()).thenReturn(item);
+    when(event.getPlayer()).thenReturn(player);
+    when(territories.claimAt(new ChunkCoordinate("world", -2, 0)))
+        .thenReturn(
+            Optional.of(
+                new TerritoryClaim(nation.id().toString(), new ChunkCoordinate("world", -2, 0))));
+    return event;
+  }
+
+  @Test
+  void offhandAndDeniedPermissionCannotPray() {
+    listener.onPlayerInteract(interact(EquipmentSlot.OFF_HAND));
+    when(player.hasPermission("starcore.faith.pray")).thenReturn(false);
+    listener.onPlayerInteract(interact(EquipmentSlot.HAND));
+    assertEquals(0, faith.getStats(nation.id()).totalPrayers());
+  }
+
+  @Test
+  void rightClickUsesChunkCoordinatesAndRejectedPrayerHasNoSuccessFeedback() {
+    listener.onPlayerInteract(interact(EquipmentSlot.HAND));
+    assertEquals(1, faith.getStats(nation.id()).totalPrayers());
+    clearInvocations(player);
+    listener.onPlayerInteract(interact(EquipmentSlot.HAND));
+    var capture = org.mockito.ArgumentCaptor.forClass(Component.class);
+    verify(player).sendMessage(capture.capture());
+    assertEquals(
+        "faith.prayer.cooldown",
+        net.kyori.adventure.text.serializer.plain.PlainTextComponentSerializer.plainText()
+            .serialize(capture.getValue()));
+    assertEquals(1, faith.getStats(nation.id()).totalPrayers());
+  }
+
+  @Test
+  void combatDefenseAndExperienceActuallyApplyBoundedBonuses() {
+    var damage = mock(EntityDamageEvent.class);
+    when(damage.getEntity()).thenReturn(player);
+    when(damage.getCause()).thenReturn(EntityDamageEvent.DamageCause.ENTITY_ATTACK);
+    when(damage.getDamage()).thenReturn(20.0);
+    listener.onDamage(damage);
+    verify(damage).setDamage(19.0);
+    var exp = new PlayerExpChangeEvent(player, 100);
+    listener.onExperience(exp);
+    assertEquals(105, exp.getAmount());
+    var extreme = new PlayerExpChangeEvent(player, Integer.MAX_VALUE);
+    listener.onExperience(extreme);
+    assertEquals(Integer.MAX_VALUE, extreme.getAmount());
+    when(damage.getCause()).thenReturn(EntityDamageEvent.DamageCause.VOID);
+    clearInvocations(damage);
+    listener.onDamage(damage);
+    verify(damage, never()).setDamage(anyDouble());
+  }
+
+  @Test
+  void broadcastsDispatchToOwnerAndRecheckNationMembership() {
+    var member = fixture.player(100);
+    var id = member.getUniqueId();
+    when(nations.nationOf(id)).thenReturn(Optional.of(nation));
+    fixture.owner = null;
+    listener.onFaithBlessing(new FaithBlessingEvent(nation.id(), "harvest", 10, true));
+    verify(member, never()).sendMessage(any(Component.class));
+    when(nations.nationOf(id)).thenReturn(Optional.empty());
+    for (var task : List.copyOf(fixture.pending)) task.tick();
+    verify(member, never()).sendMessage(any(Component.class));
+  }
+
+  @Test
+  void shutdownSuppressesQueuedBroadcastsAndLoginRewards() {
+    fixture.owner = null;
+    listener.onFaithBlessing(new FaithBlessingEvent(nation.id(), "harvest", 10, true));
+    listener.shutdown();
+    for (var task : List.copyOf(fixture.pending)) task.tick();
+    verify(player, never()).sendMessage(any(Component.class));
+    listener.recordLogin(player);
+    assertEquals(50, faith.getFaith(nation.id()));
+  }
+
+  @Test
+  void cancelledAndRetiredOwnerCallbacksDoNothing() {
+    faith.feedback(player, () -> fail("retired callback ran"));
+    fixture.pending.getLast().retire();
+    fixture.pending.getLast().tick();
+  }
+
+  FaithGui gui(Inventory inventory) {
+    fixture
+        .bukkit
+        .when(() -> Bukkit.createInventory(any(InventoryHolder.class), eq(54), anyString()))
+        .thenReturn(inventory);
+    var gui = new FaithGui(player, faith, nations);
+    gui.open();
+    return gui;
+  }
+
+  @Test
+  void guiMemberCannotSpendAndAuthorizedLeaderCanSpendOnlyOnce() {
+    try (var items = mockConstruction(ItemStack.class)) {
+      Inventory inventory = mock(Inventory.class);
+      FaithGui gui = gui(inventory);
+      nation.setFounderId(UUID.randomUUID());
+      when(player.hasPermission("starcore.faith.admin")).thenReturn(false);
+      gui.handleClick(19);
+      assertEquals(50, faith.getFaith(nation.id()));
+      when(player.hasPermission("starcore.faith.admin")).thenReturn(true);
+      gui.handleClick(19);
+      gui.handleClick(19);
+      assertEquals(40, faith.getFaith(nation.id()));
+    }
+  }
+
+  @Test
+  void guiClickDefersInventoryMutationAndRejectsForeignHolderOrChangedNation() {
+    var inventory = mock(Inventory.class);
+    var gui = mock(FaithGui.class);
+    when(inventory.getHolder()).thenReturn(gui);
+    when(gui.belongsTo(player)).thenReturn(true);
+    when(gui.getInventory()).thenReturn(inventory);
+    var event = mock(InventoryClickEvent.class);
+    when(event.getInventory()).thenReturn(inventory);
+    when(event.getClickedInventory()).thenReturn(inventory);
+    when(event.getWhoClicked()).thenReturn(player);
+    when(event.getSlot()).thenReturn(19);
+    var view = mock(InventoryView.class);
+    when(player.getOpenInventory()).thenReturn(view);
+    when(view.getTopInventory()).thenReturn(inventory);
+    var clicks = new FaithGuiListener(fixture.plugin, faith, nations);
+    clicks.onInventoryClick(event);
+    verify(gui, never()).handleClick(anyInt());
+    var pending = fixture.pending.getLast();
+    when(nations.nationOf(playerId)).thenReturn(Optional.empty());
+    pending.tick();
+    verify(gui, never()).handleClick(anyInt());
+    var foreign = new FaithGuiListener(fixture.plugin, faith, nations);
+    when(gui.belongsTo(player)).thenReturn(false);
+    int tasks = fixture.pending.size();
+    foreign.onInventoryClick(event);
+    assertEquals(tasks, fixture.pending.size());
+  }
+
+  @Test
+  void guiDeferredClickRunsOnOwnerAndOldListenerCannotRunAfterShutdown() {
+    var inventory = mock(Inventory.class);
+    var gui = mock(FaithGui.class);
+    when(inventory.getHolder()).thenReturn(gui);
+    when(gui.belongsTo(player)).thenReturn(true);
+    when(gui.getInventory()).thenReturn(inventory);
+    var event = mock(InventoryClickEvent.class);
+    when(event.getInventory()).thenReturn(inventory);
+    when(event.getClickedInventory()).thenReturn(inventory);
+    when(event.getWhoClicked()).thenReturn(player);
+    when(event.getSlot()).thenReturn(19);
+    var view = mock(InventoryView.class);
+    when(player.getOpenInventory()).thenReturn(view);
+    when(view.getTopInventory()).thenReturn(inventory);
+    var clicks = new FaithGuiListener(fixture.plugin, faith, nations);
+    clicks.onInventoryClick(event);
+    fixture.pending.getLast().tick();
+    verify(gui).handleClick(19);
+    var stale = new FaithGuiListener(fixture.plugin, faith, nations);
+    stale.onInventoryClick(event);
+    stale.shutdown();
+    fixture.pending.getLast().tick();
+    verify(gui, times(1)).handleClick(19);
+  }
+
+  @Test
+  void bonusesCannotIntroduceNaNOrNegativeValues() {
+    FaithService foreign = mock(FaithService.class);
+    when(foreign.isAvailable()).thenReturn(true);
+    when(foreign.getFaithBonuses(nation.id()))
+        .thenReturn(
+            Map.of(
+                "resource",
+                Double.NaN,
+                "tax",
+                -4.0,
+                "exp",
+                Double.POSITIVE_INFINITY,
+                "defense",
+                500.0));
+    assertEquals(0, FaithBonus.amount(foreign, nation.id(), "resource"));
+    assertEquals(0, FaithBonus.amount(foreign, nation.id(), "tax"));
+    assertEquals(0, FaithBonus.amount(foreign, nation.id(), "exp"));
+    assertEquals(1.1, FaithBonus.amount(foreign, nation.id(), "defense"));
+  }
+}
