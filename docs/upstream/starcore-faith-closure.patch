+        for (int count = count(input); count > 0; count--) {
+          NationId id = nation(input);
+          if (nations.containsKey(id) || !removed.add(id))
+            throw new IOException("Invalid removed faith nation");
+        }
+        day = positive(input);
+      }
+      if (input.read() != -1) throw new IOException("Trailing faith data");
+      return new Snapshot(nations, cooldowns, loginDays, blessings, removed, day);
+    } catch (IllegalArgumentException failure) {
+      throw new IOException("Invalid faith record", failure);
+    }
+  }
+
+  private byte[] encode(Snapshot state) throws IOException {
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    try (DataOutputStream output = new DataOutputStream(bytes)) {
+      output.writeInt(VERSION);
+      output.writeInt(state.nations().size());
+      for (NationId id : sorted(state.nations().keySet())) {
+        FaithData data = state.nations().get(id);
+        if (!id.equals(data.nationId()) || data.faith() > maximumFaith)
+          throw new IOException("Invalid faith snapshot");
+        output.writeUTF(id.toString());
+        output.writeInt(data.faith());
+        output.writeInt(data.totalPrayers());
+        output.writeInt(data.todayPrayers());
+        output.writeLong(data.lastPrayerTime());
+        output.writeLong(data.lastEventTime());
+        output.writeInt(data.consecutiveDays());
+        output.writeUTF(
+            data.lastPrayingPlayer() == null ? "" : data.lastPrayingPlayer().toString());
+      }
+      writePlayers(output, state.cooldowns());
+      writePlayers(output, state.loginDays());
+      output.writeInt(state.blessings().values().stream().mapToInt(Map::size).sum());
+      for (NationId id : sorted(state.blessings().keySet()))
+        for (String type : sorted(state.blessings().get(id).keySet())) {
+          output.writeUTF(id.toString());
+          output.writeUTF(type);
+          output.writeLong(state.blessings().get(id).get(type));
+        }
+      output.writeInt(state.removed().size());
+      for (NationId id : sorted(state.removed())) output.writeUTF(id.toString());
+      output.writeLong(state.maintenanceDay());
+    }
+    byte[] payload = bytes.toByteArray();
+    bytes.write(digest(payload));
+    byte[] result = bytes.toByteArray();
+    if (result.length > MAX_BYTES) throw new IOException("Faith snapshot exceeds size limit");
+    // Validate before replacing the only current authority, including collection limits.
+    decode(result, state.maintenanceDay());
+    return result;
+  }
+
+  private static <T> List<T> sorted(Collection<T> values) {
+    return values.stream().sorted(Comparator.comparing(Object::toString)).toList();
+  }
+
+  private static void writePlayers(DataOutputStream output, Map<UUID, Long> values)
+      throws IOException {
+    output.writeInt(values.size());
+    for (UUID player : sorted(values.keySet())) {
+      output.writeUTF(player.toString());
+      output.writeLong(values.get(player));
+    }
+  }
+
+  private static void readPlayers(DataInputStream input, Map<UUID, Long> values)
+      throws IOException {
+    for (int count = count(input); count > 0; count--)
+      if (values.put(uuid(input.readUTF()), positive(input)) != null)
+        throw new IOException("Duplicate faith player");
+  }
+
+  private static NationId nation(DataInputStream input) throws IOException {
+    return NationId.of(uuid(input.readUTF()));
+  }
+
+  private static UUID uuid(String value) throws IOException {
+    UUID id = UUID.fromString(value);
+    if (!id.toString().equals(value)) throw new IOException("Non-canonical faith UUID");
+    return id;
+  }
+
+  private static int count(DataInputStream input) throws IOException {
+    int count = input.readInt();
+    if (count < 0 || count > MAX_ENTRIES) throw new IOException("Invalid faith record count");
+    return count;
+  }
+
+  private static long positive(DataInputStream input) throws IOException {
+    long value = input.readLong();
+    if (value < 0) throw new IOException("Negative faith timestamp");
+    return value;
+  }
+
+  private static byte[] digest(byte[] bytes) throws IOException {
+    try {
+      return MessageDigest.getInstance("SHA-256").digest(bytes);
+    } catch (java.security.NoSuchAlgorithmException impossible) {
+      throw new IOException(impossible);
+    }
+  }
+}
