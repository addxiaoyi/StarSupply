@@ -0,0 +1,116 @@
+package dev.starcore.starcore.module.faith;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import dev.starcore.starcore.module.faith.model.*;
+import dev.starcore.starcore.module.nation.model.NationId;
+import java.io.*;
+import java.nio.file.*;
+import java.time.*;
+import java.util.*;
+import org.bukkit.configuration.file.YamlConfiguration;
+import org.junit.jupiter.api.*;
+import org.junit.jupiter.api.io.TempDir;
+
+class FaithModelValidationTest {
+  @TempDir Path directory;
+
+  @Test
+  void thresholdsAreDefensiveAndMalformedConfiguredThresholdsFail() {
+    var config = FaithConfig.defaultConfig();
+    int[] thresholds = config.levelThresholds();
+    thresholds[0] = 500;
+    assertEquals(2, config.calculateLevel(20));
+    var yaml = new YamlConfiguration();
+    yaml.set("level-thresholds", List.of(20, 40));
+    assertThrows(IllegalArgumentException.class, () -> FaithConfig.fromConfig(yaml));
+  }
+
+  @Test
+  void invalidBlessingPricesAndBonusesCannotEnterRuntime() {
+    for (double price : new double[] {-1, 0, 0.5, Double.NaN, Double.POSITIVE_INFINITY}) {
+      var yaml = new YamlConfiguration();
+      yaml.set("blessing-costs.harvest", price);
+      assertThrows(IllegalArgumentException.class, () -> FaithConfig.fromConfig(yaml));
+    }
+    assertThrows(
+        IllegalArgumentException.class,
+        () -> new FaithLevelConfig("bad", "bad", Double.NaN, 0, 0, 0, "BOOK"));
+  }
+
+  @Test
+  void calendarDayAcrossMidnightDoesNotRequireTwentyFourHours() {
+    ZoneId zone = ZoneId.of("Asia/Shanghai");
+    long now = Instant.parse("2026-11-25T15:59:00Z").toEpochMilli();
+    var data =
+        FaithData.create(NationId.random(), UUID.randomUUID())
+            .recordPrayer(UUID.randomUUID(), now, zone);
+    assertEquals(0, data.prayersToday(now + 120_000, zone));
+    assertEquals(2, data.recordPrayer(UUID.randomUUID(), now + 120_000, zone).consecutiveDays());
+  }
+
+  @Test
+  void configurableMaximumAndSaturatedArithmeticArePreserved() {
+    var data = FaithData.create(NationId.random(), 150, UUID.randomUUID());
+    assertEquals(150, data.faith());
+    assertEquals(Integer.MAX_VALUE, data.addFaith(Integer.MAX_VALUE).faith());
+    assertEquals(0, data.addFaith(Integer.MIN_VALUE).faith());
+    assertEquals(0.75, new FaithStats(150, 3, "test", 0, 0, 0, 0, 0, 0, 0).faithPercentage(200));
+  }
+
+  @Test
