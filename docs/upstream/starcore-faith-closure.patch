+import java.io.*;
+import java.nio.file.*;
+import java.security.MessageDigest;
+import java.util.*;
+
+/** Validated, checksummed snapshots. Never replace unreadable authority with partial defaults. */
+final class FaithStore {
+  private static final int VERSION = 2;
+  private static final Object[] GUARDS = new Object[64];
+
+  static {
+    Arrays.setAll(GUARDS, index -> new Object());
+  }
+
+  private Object guard() {
+    return GUARDS[Math.floorMod(path.toAbsolutePath().normalize().hashCode(), GUARDS.length)];
+  }
+
+  private static final int MAX_ENTRIES = 100_000;
+  private static final int MAX_BYTES = 64 * 1024 * 1024;
+  private final Path path;
+  private final int maximumFaith;
+  private final Writer writer;
+  private byte[] expected;
+  private boolean loaded;
+  private volatile boolean failed;
+
+  @FunctionalInterface
+  interface Writer {
+    void write(Path path, byte[] bytes) throws IOException;
+  }
+
+  record Snapshot(
+      Map<NationId, FaithData> nations,
+      Map<UUID, Long> cooldowns,
+      Map<UUID, Long> loginDays,
+      Map<NationId, Map<String, Long>> blessings,
+      Set<NationId> removed,
+      long maintenanceDay) {
+    Snapshot {
+      nations = Map.copyOf(nations);
+      cooldowns = Map.copyOf(cooldowns);
+      loginDays = Map.copyOf(loginDays);
+      Map<NationId, Map<String, Long>> copy = new HashMap<>();
+      blessings.forEach((id, values) -> copy.put(id, Map.copyOf(values)));
+      blessings = Map.copyOf(copy);
+      removed = Set.copyOf(removed);
+    }
+
+    static Snapshot empty(long day) {
+      return new Snapshot(Map.of(), Map.of(), Map.of(), Map.of(), Set.of(), day);
+    }
+  }
+
+  FaithStore(Path path, int maximumFaith) {
+    this(
+        path,
+        maximumFaith,
+        (target, bytes) -> AtomicFilePersistence.replace(target, temp -> Files.write(temp, bytes)));
+  }
+
+  FaithStore(Path path, int maximumFaith, Writer writer) {
+    this.path = path;
+    this.maximumFaith = maximumFaith;
+    this.writer = writer;
+  }
+
+  synchronized Snapshot load(long currentDay) throws IOException {
+    if (loaded) throw new IOException("Faith store already loaded");
+    try {
+      Snapshot result;
+      if (!Files.exists(path)) {
+        if (Files.exists(AtomicFilePersistence.backup(path))
+            || Files.exists(AtomicFilePersistence.temp(path)))
+          throw new IOException(
+              "Missing faith authority with recovery artifacts; restore explicitly");
+        result = Snapshot.empty(currentDay);
+      } else {
+        expected = bytes();
+        result = decode(expected, currentDay);
+      }
+      loaded = true;
+      return result;
+    } catch (IOException | RuntimeException failure) {
+      failed = true;
+      throw new IOException("Cannot load faith authority", failure);
+    }
+  }
+
+  synchronized void save(Snapshot snapshot) throws IOException {
+    synchronized (guard()) {
+      saveGuarded(snapshot);
+    }
+  }
+
+  private void saveGuarded(Snapshot snapshot) throws IOException {
+    if (!loaded || failed) throw new IOException("Faith storage unavailable");
+    byte[] next = encode(snapshot);
+    byte[] current;
+    try {
+      current = Files.exists(path) ? bytes() : null;
+    } catch (IOException failure) {
+      failed = true;
+      throw failure;
+    }
+    if (!Arrays.equals(current, expected)) {
+      failed = true;
+      throw new IOException("Faith authority changed or disappeared outside the service");
+    }
+    if (Arrays.equals(current, next)) return;
+    try {
+      writer.write(path, next);
+      if (!Arrays.equals(bytes(), next))
+        throw new IOException("Faith writer did not publish the complete snapshot");
+    } catch (IOException | RuntimeException failure) {
+      byte[] actual;
+      try {
+        actual = Files.exists(path) ? bytes() : null;
+      } catch (IOException readFailure) {
+        failed = true;
