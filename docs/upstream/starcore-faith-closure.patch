+import dev.starcore.starcore.core.service.ServiceRegistry;
+import dev.starcore.starcore.foundation.economy.EconomyService;
+import dev.starcore.starcore.module.faith.FaithService;
+import dev.starcore.starcore.module.nation.model.NationId;
+import dev.starcore.starcore.module.treasury.TaxationService.*;
+import dev.starcore.starcore.module.treasury.extension.TaxRateExtensionPoint;
+import java.math.BigDecimal;
+import java.util.*;
+import java.util.logging.Logger;
+import org.bukkit.plugin.java.JavaPlugin;
+import org.junit.jupiter.api.*;
+
+class TaxationFaithBonusTest {
+  final ServiceRegistry services = new ServiceRegistry();
+  final EconomyService economy = mock(EconomyService.class);
+  final TreasuryService treasury = mock(TreasuryService.class);
+  final FaithService faith = mock(FaithService.class);
+  final NationId nation = NationId.random();
+  final UUID payer = UUID.randomUUID();
+  final TaxationServiceImpl taxes = new TaxationServiceImpl();
+
+  @BeforeEach
+  void setup() throws Exception {
+    services.register(EconomyService.class, economy);
+    services.register(TreasuryService.class, treasury);
+    services.register(FaithService.class, faith);
+    when(faith.isAvailable()).thenReturn(true);
+    when(faith.getFaithBonuses(nation)).thenReturn(Map.of("tax", 0.1));
+    JavaPlugin plugin = mock(JavaPlugin.class);
+    when(plugin.getLogger()).thenReturn(Logger.getLogger("TaxFaithTest"));
+    var context =
+        new StarCoreContext(plugin, null, null, null, null, null, null, null, null, null, services);
+    var field = TaxationServiceImpl.class.getDeclaredField("currentContext");
+    field.setAccessible(true);
+    field.set(taxes, context);
+    taxes
+        .getTaxConfigs(nation)
+        .put(
+            TaxType.BUSINESS_TAX,
+            new TaxConfig(
+                TaxType.BUSINESS_TAX,
+                true,
+                BigDecimal.ZERO,
+                new BigDecimal("5"),
+                BigDecimal.ZERO,
+                1440,
+                false));
+  }
+
+  TaxContext context(UUID... payers) {
+    return new TaxContext(
+        0,
+        0,
+        payers.length,
+        new BigDecimal("100"),
+        List.of(),
+        Arrays.stream(payers).map(id -> new TaxPayer(id, new BigDecimal("100"))).toList(),
+        List.of());
+  }
+
+  @Test
+  void faithBonusIsAssessedBeforeDebitAndAuditMatchesActualTreasuryMoney() {
+    when(economy.withdraw(payer, new BigDecimal("5.50"))).thenReturn(true);
+    when(treasury.tryDeposit(nation, new BigDecimal("5.50"))).thenReturn(true);
+    assertThat(taxes.collectTax(nation, TaxType.BUSINESS_TAX, context(payer)))
+        .isEqualByComparingTo("5.50");
+    verify(economy).withdraw(payer, new BigDecimal("5.50"));
+    verify(treasury).tryDeposit(nation, new BigDecimal("5.50"));
+    assertThat(taxes.getTaxHistory(nation, TaxType.BUSINESS_TAX, 10).getFirst().amount())
+        .isEqualByComparingTo("5.50");
+  }
+
+  @Test
+  void failedPayerCannotCreateBonusRevenue() {
+    UUID failed = UUID.randomUUID();
+    when(economy.withdraw(payer, new BigDecimal("5.50"))).thenReturn(true);
+    when(treasury.tryDeposit(nation, new BigDecimal("5.50"))).thenReturn(true);
+    assertThat(taxes.collectTax(nation, TaxType.BUSINESS_TAX, context(payer, failed)))
+        .isEqualByComparingTo("5.50");
+    verify(treasury).tryDeposit(nation, new BigDecimal("5.50"));
+  }
+
+  @Test
+  void rejectedTreasuryRefundsTheExactBonusInclusiveDebit() {
+    when(economy.withdraw(payer, new BigDecimal("5.50"))).thenReturn(true);
+    when(economy.deposit(payer, new BigDecimal("5.50"))).thenReturn(true);
+    assertThat(taxes.collectTax(nation, TaxType.BUSINESS_TAX, context(payer)))
+        .isEqualByComparingTo("0");
+    verify(economy).deposit(payer, new BigDecimal("5.50"));
+    assertThat(taxes.getTaxHistory(nation, TaxType.BUSINESS_TAX, 10)).isEmpty();
+  }
+
+  @Test
+  void quotesContainBonusAndCannotExceedGrossProceeds() {
+    var quote =
+        taxes.quoteTax(
+            UUID.randomUUID(), nation, TaxType.BUSINESS_TAX, payer, new BigDecimal("100"));
+    assertThat(quote.taxAmount()).isEqualByComparingTo("5.50");
+    taxes
+        .getTaxConfigs(nation)
+        .put(
+            TaxType.BUSINESS_TAX,
+            new TaxConfig(
+                TaxType.BUSINESS_TAX,
+                true,
+                BigDecimal.ZERO,
+                new BigDecimal("100"),
+                BigDecimal.ZERO,
+                1440,
+                false));
+    assertThat(
+            taxes
+                .quoteTax(
+                    UUID.randomUUID(), nation, TaxType.BUSINESS_TAX, payer, new BigDecimal("100"))
+                .taxAmount())
+        .isEqualByComparingTo("100");
+  }
+
+  @Test
+  void extensionAdjustsActualChargesBeforeCollectionInsteadOfOnlyReturnValue() {
+    ExtensionRegistry registry = mock(ExtensionRegistry.class);
+    try (var extension = mockStatic(ExtensionRegistry.class)) {
+      extension.when(ExtensionRegistry::getInstance).thenReturn(registry);
+      when(registry.execute(eq("tax_rate_modifier"), any(TaxRateExtensionPoint.TaxRequest.class)))
+          .thenReturn(
+              new TaxRateExtensionPoint.TaxResult(
+                  new BigDecimal("2.75"), "test", List.of(), new BigDecimal("5.50")));
+      when(economy.withdraw(payer, new BigDecimal("2.75"))).thenReturn(true);
+      when(treasury.tryDeposit(nation, new BigDecimal("2.75"))).thenReturn(true);
+      assertThat(taxes.collectTax(nation, TaxType.BUSINESS_TAX, context(payer)))
+          .isEqualByComparingTo("2.75");
+      verify(economy).withdraw(payer, new BigDecimal("2.75"));
+      assertThat(
+              taxes
+                  .quoteTax(
+                      UUID.randomUUID(), nation, TaxType.BUSINESS_TAX, payer, new BigDecimal("100"))
+                  .taxAmount())
+          .isEqualByComparingTo("2.75");
+    }
+  }
+
+  @Test
+  void zeroExtensionExemptsCollectionAndUnavailableFaithHasNoBonus() {
+    when(faith.isAvailable()).thenReturn(false);
+    assertThat(
+            taxes
+                .quoteTax(
+                    UUID.randomUUID(), nation, TaxType.BUSINESS_TAX, payer, new BigDecimal("100"))
+                .taxAmount())
+        .isEqualByComparingTo("5");
+    ExtensionRegistry registry = mock(ExtensionRegistry.class);
+    try (var extension = mockStatic(ExtensionRegistry.class)) {
+      extension.when(ExtensionRegistry::getInstance).thenReturn(registry);
+      when(registry.execute(eq("tax_rate_modifier"), any(TaxRateExtensionPoint.TaxRequest.class)))
+          .thenReturn(
+              new TaxRateExtensionPoint.TaxResult(
+                  BigDecimal.ZERO, "exempt", List.of(), new BigDecimal("5")));
+      assertThat(taxes.collectTax(nation, TaxType.BUSINESS_TAX, context(payer)))
+          .isEqualByComparingTo("0");
+      verifyNoInteractions(economy, treasury);
+    }
+  }
+
+  @Test
+  void actualExtensionAggregationPreservesZeroExemption() {
+    ExtensionRegistry registry = mock(ExtensionRegistry.class);
+    try (var extension = mockStatic(ExtensionRegistry.class)) {
+      extension.when(ExtensionRegistry::getInstance).thenReturn(registry);
+      var point = new TaxRateExtensionPoint();
+      @SuppressWarnings("unchecked")
+      dev.starcore.starcore.core.extension.ExtensionContributor<
+              TaxRateExtensionPoint.TaxResult, TaxRateExtensionPoint.TaxRequest>
+          contributor = mock(dev.starcore.starcore.core.extension.ExtensionContributor.class);
+      when(contributor.isApplicable(any())).thenReturn(true);
+      when(contributor.contribute(any()))
+          .thenReturn(
+              new TaxRateExtensionPoint.TaxResult(
+                  BigDecimal.ZERO, "exempt", List.of(), new BigDecimal("5")));
+      doReturn(List.of(contributor)).when(registry).getContributors("tax_rate_modifier");
+      assertThat(
+              point
+                  .execute(
+                      new TaxRateExtensionPoint.TaxRequest(
+                          nation, "BUSINESS_TAX", "", "", new BigDecimal("5")))
+                  .modifiedAmount())
+          .isEqualByComparingTo("0");
+    }
+  }
+}
