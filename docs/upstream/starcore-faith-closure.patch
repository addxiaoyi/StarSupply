+    when(nations.nations()).thenReturn(List.of(nation));
+    when(nations.nationById(nation.id())).thenReturn(Optional.of(nation));
+    services.register(NationService.class, nations);
+    services.register(MessageService.class, (key, args) -> key);
+    var persistence = mock(PersistenceService.class);
+    context =
+        new StarCoreContext(
+            fixture.plugin, null, null, null, null, persistence, null, null, null, null, services);
+  }
+
+  @AfterEach
+  void close() {
+    try {
+      if (module.isAvailable()) module.disable(context);
+    } finally {
+      if (navigation != null) navigation.close();
+      if (handlers != null) handlers.close();
+      if (fixture != null) fixture.close();
+    }
+  }
+
+  @Test
+  void disableUnregistersEveryListenerAndServiceAndFreezesOldCommand() {
+    var listeners = org.mockito.ArgumentCaptor.forClass(Listener.class);
+    var executor = org.mockito.ArgumentCaptor.forClass(CommandExecutor.class);
+    module.enable(context);
+    verify(manager, times(2)).registerEvents(listeners.capture(), eq(fixture.plugin));
+    verify(command).setExecutor(executor.capture());
+    var oldCommand = executor.getValue();
+    when(command.getExecutor()).thenReturn(oldCommand);
+    when(command.getTabCompleter()).thenReturn((TabCompleter) oldCommand);
+    assertSame(module, services.require(FaithService.class));
+    assertEquals(50, module.getFaith(nation.id()));
+    module.disable(context);
+    assertTrue(services.find(FaithService.class).isEmpty());
+    assertFalse(module.isAvailable());
+    for (var listener : listeners.getAllValues())
+      handlers.verify(() -> HandlerList.unregisterAll(listener));
+    verify(command).setExecutor(null);
+    verify(command).setTabCompleter(null);
+    module.enable(context);
+    var player = fixture.player(1);
+    fixture.owner = player;
+    when(player.hasPermission(anyString())).thenReturn(true);
+    oldCommand.onCommand(player, command, "faith", new String[] {"set", nation.name(), "75"});
+    assertEquals(50, module.getFaith(nation.id()));
+  }
+
+  @Test
+  void removalDoesNotResurrectOnModuleReloadAndUnknownNationCannotBeCreated() {
+    module.enable(context);
+    module.removeFaith(nation.id());
+    module.disable(context);
+    module.enable(context);
+    assertTrue(module.getFaithData(nation.id()).isEmpty());
+    NationId unknown = NationId.random();
+    module.getFaith(unknown);
+    assertTrue(module.getFaithData(unknown).isEmpty());
+  }
+
+  @Test
+  void failedRegistrationClosesServiceAndRemovesRegistryEntry() {
+    doThrow(new IllegalStateException("registration failed"))
+        .when(manager)
+        .registerEvents(any(), eq(fixture.plugin));
+    assertThrows(IllegalStateException.class, () -> module.enable(context));
+    assertFalse(module.isAvailable());
+    assertTrue(services.find(FaithService.class).isEmpty());
+  }
+
+  @Test
+  void corruptedFileFailsEnableWithoutRegisteringAnyListener() throws Exception {
+    Files.writeString(directory.resolve("faith.dat"), "corrupt");
+    assertThrows(IllegalStateException.class, () -> module.enable(context));
+    assertTrue(services.find(FaithService.class).isEmpty());
+    verify(manager, never()).registerEvents(any(), any());
+  }
+
+  @Test
+  void alreadyOnlinePlayerLoginUsesOwnerCallbackAndDeduplicatesReload() {
+    var player = fixture.player(0);
+    var id = player.getUniqueId();
+    when(nations.nationOf(id)).thenReturn(Optional.of(nation));
+    module.enable(context);
+    assertEquals(50, module.getFaith(nation.id()));
+    fixture.pending.getLast().tick();
+    assertEquals(53, module.getFaith(nation.id()));
+    module.disable(context);
+    module.enable(context);
+    fixture.pending.getLast().tick();
+    assertEquals(53, module.getFaith(nation.id()));
+  }
+}
