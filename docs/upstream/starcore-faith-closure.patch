@@ -0,0 +1,20 @@
+package dev.starcore.starcore.module.faith;
+
+import dev.starcore.starcore.module.nation.model.NationId;
+
+/** Bounded integration boundary, including optional third-party FaithService implementations. */
+public final class FaithBonus {
+  private FaithBonus() {}
+
+  public static double amount(FaithService faith, NationId nation, String type) {
+    if (faith == null || !faith.isAvailable()) return 0;
+    Double value = faith.getFaithBonuses(nation).get(type);
+    return value == null || !Double.isFinite(value) ? 0 : Math.clamp(value, 0, 1.1);
+  }
+
+  public static int increase(int base, double bonus) {
+    if (base <= 0) return base;
+    double safe = Double.isFinite(bonus) ? Math.clamp(bonus, 0, 1.1) : 0;
+    return (int) Math.min(Integer.MAX_VALUE, Math.floor(base * (1.0 + safe)));
+  }
+}
