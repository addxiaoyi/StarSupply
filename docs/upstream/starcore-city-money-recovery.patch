+    if (operation == null) throw new IllegalArgumentException("Unknown city transfer");
+    if (!operation.request().playerRequest().equals(receipt.request()))
+      throw new IllegalArgumentException("Player receipt conflicts with city intent");
+    if (operation.state() != CityMoneyService.State.PENDING) {
+      if (!operation.playerReceipt().equals(receipt))
+        throw new IllegalArgumentException("Player terminal receipt changed");
+      return operation;
+    }
+    var terminal = operation.finish(receipt);
+    var values = new HashMap<>(ledger.cities());
+    var cityId = operation.request().cityId();
+    values.put(
+        cityId,
+        CityLedger.balanceSnapshot(
+            values.get(cityId), terminal.finalBalance(), terminal.preparedAt()));
+    var operations = new HashMap<>(ledger.moneyOperations());
+    operations.put(id, terminal);
+    commit(ledger.withMoney(values, operations));
+    return terminal;
+  }
+
+  public synchronized Optional<CityMoneyService.Operation> moneyOperation(UUID id) {
+    return Optional.ofNullable(storage.load().moneyOperations().get(Objects.requireNonNull(id)));
+  }
+
+  public synchronized List<CityMoneyService.Operation> pendingMoney() {
+    return storage.load().moneyOperations().values().stream()
+        .filter(op -> op.state() == CityMoneyService.State.PENDING)
+        .sorted(
+            Comparator.comparingLong(CityMoneyService.Operation::preparedAt)
+                .thenComparing(op -> op.request().operationId()))
+        .toList();
+  }
 }
