+
+class CityMoneyAuthorityTest {
+  @TempDir Path directory;
+
+  @BeforeEach
+  void extensions() {
+    ExtensionRegistry.init(Logger.getAnonymousLogger());
+    ExtensionRegistry.getInstance().clear();
+  }
+
+  @AfterEach
+  void clearExtensions() {
+    ExtensionRegistry.getInstance().clear();
+  }
+
+  private static void await(CyclicBarrier barrier) {
+    try {
+      barrier.await(5, TimeUnit.SECONDS);
+    } catch (Exception failure) {
+      throw new IllegalStateException(failure);
+    }
+  }
+
+  private CityLedgerStorage competingLoad(CityLedgerStorage delegate, CyclicBarrier barrier) {
+    return new CityLedgerStorage() {
+      boolean first = true;
+
+      public CityLedger load() {
+        var ledger = delegate.load();
+        if (first) {
+          first = false;
+          await(barrier);
+        }
+        return ledger;
+      }
+
+      public void save(CityLedger ledger) {
+        delegate.save(ledger);
+      }
+    };
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void independentCityWritersCannotReserveSameFunds(boolean sql) throws Exception {
+    try (var f = new CityMoneyTestFixture(directory, sql);
+        var executor = Executors.newFixedThreadPool(2)) {
+      var barrier = new CyclicBarrier(2);
+      var left =
+          f.coordinator(new DurableCityStorage(competingLoad(f.ledger(), barrier)), f.economy);
+      var right =
+          f.coordinator(new DurableCityStorage(competingLoad(f.ledger(), barrier)), f.economy);
+      var one = f.request(CityMoneyService.Direction.WITHDRAW, "80");
+      var two = f.request(CityMoneyService.Direction.WITHDRAW, "80");
+      var a = executor.submit(() -> catchThrowable(() -> left.transfer(one)));
+      var b = executor.submit(() -> catchThrowable(() -> right.transfer(two)));
+      var failures = Arrays.asList(a.get(10, TimeUnit.SECONDS), b.get(10, TimeUnit.SECONDS));
+      assertThat(failures.stream().filter(Objects::nonNull)).hasSize(1);
+      var history = f.ledger().load().moneyOperations();
+      assertThat(history).hasSize(1);
+      var accepted = history.values().iterator().next();
+      assertThat(accepted.state()).isEqualTo(CityMoneyService.State.APPLIED);
+      assertThat(f.economy.moneyReceipt(accepted.request().operationId()))
+          .contains(accepted.playerReceipt());
+      var refused = accepted.request().equals(one) ? two : one;
+      assertThat(f.economy.moneyReceipt(refused.operationId())).isEmpty();
+      assertThat(f.cityBalance()).isEqualByComparingTo("20");
+      assertThat(f.economy.balance(f.mayor)).isEqualByComparingTo("180");
+    }
+  }
+
+  @Test
+  void twoSqlPlayerAndCityInstancesRecoverOneIdentityWithoutDuplicateCredit() throws Exception {
+    try (var f = new CityMoneyTestFixture(directory, true);
+        var executor = Executors.newFixedThreadPool(2)) {
+      var request = f.request(CityMoneyService.Direction.WITHDRAW, "10.01");
+      f.store().prepareMoney(request);
+      var other = f.openEconomy();
+      var barrier = new CyclicBarrier(2);
+      java.util.function.Function<PlayerMoneyService, PlayerMoneyService> gated =
+          delegate ->
+              new PlayerMoneyService() {
+                public Optional<Receipt> moneyReceipt(UUID id) {
+                  var receipt = delegate.moneyReceipt(id);
+                  await(barrier);
+                  return receipt;
+                }
+
+                public Receipt applyMoney(Request input) {
+                  return delegate.applyMoney(input);
+                }
+              };
+      var left = f.coordinator(f.store(), gated.apply(f.economy));
+      var right = f.coordinator(f.store(), gated.apply(other));
+      var a = executor.submit(() -> left.retry(request.operationId()));
+      var b = executor.submit(() -> right.retry(request.operationId()));
+      assertThat(a.get(10, TimeUnit.SECONDS).request()).isEqualTo(request);
+      assertThat(b.get(10, TimeUnit.SECONDS).request()).isEqualTo(request);
+      var terminal = f.money().retry(request.operationId());
+      assertThat(terminal.state()).isEqualTo(CityMoneyService.State.APPLIED);
+      assertThat(f.ledger().load().moneyOperations()).hasSize(1);
+      other.start();
+      assertThat(other.moneyReceipt(request.operationId())).contains(terminal.playerReceipt());
+      assertThat(other.balance(f.mayor)).isEqualByComparingTo("110.01");
+      other.stop();
+      f.economies.remove(other);
+      f.economy.start();
+      assertThat(f.cityBalance()).isEqualByComparingTo("89.99");
+    }
+  }
+
+  @ParameterizedTest
+  @CsvSource({"false,DEPOSIT", "false,WITHDRAW", "true,DEPOSIT", "true,WITHDRAW"})
+  void actualExtensionRejectionRestoresReservationAndRemainsTerminal(
+      boolean sql, CityMoneyService.Direction direction) {
+    try (var f = new CityMoneyTestFixture(directory, sql)) {
+      var registry = ExtensionRegistry.getInstance();
+      var extension = new EconomyTransactionExtensionPoint();
+      var calls = new AtomicInteger();
+      registry.registerExtensionPoint(extension);
+      registry.registerContributor(
+          extension,
+          new ExtensionContributor<
+              EconomyTransactionExtensionPoint.TransactionResult,
+              EconomyTransactionExtensionPoint.TransactionContext>() {
+            public String getId() {
+              return "city-test-denial";
+            }
+
+            public String getName() {
+              return getId();
+            }
+
+            public EconomyTransactionExtensionPoint.TransactionResult contribute(
+                EconomyTransactionExtensionPoint.TransactionContext context) {
+              calls.incrementAndGet();
+              return new EconomyTransactionExtensionPoint.TransactionResult(
+                  false, null, "test denial", Map.of());
+            }
+          });
+      var request = f.request(direction, "10.25");
+      var result = f.money().transfer(request);
+      assertThat(result.state()).isEqualTo(CityMoneyService.State.REJECTED);
+      assertThat(result.playerReceipt().status())
+          .isEqualTo(PlayerMoneyService.Status.EXTENSION_REJECTED);
+      registry.clear();
+      f.restartEconomy();
+      assertThat(f.money().retry(request.operationId())).isEqualTo(result);
+      assertThat(calls).hasValue(1);
+      assertThat(f.cityBalance()).isEqualByComparingTo("100");
+      assertThat(f.economy.balance(f.mayor)).isEqualByComparingTo("100");
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void fileToSqlMigrationKeepsPendingAndTerminalMoneyHistory(boolean applied) {
+    try (var f = new CityMoneyTestFixture(directory, false)) {
+      var request = f.request(CityMoneyService.Direction.WITHDRAW, "11.11");
+      if (applied) f.money().transfer(request);
+      else {
+        f.store().prepareMoney(request);
+        f.economy.applyMoney(request.playerRequest());
+      }
+      var original = f.ledger().load();
+      var source = f.source("migrated");
+      var ledger = new SqlCityLedgerStorage(() -> Optional.of(source), f.ledger()::load);
+      assertThat(ledger.load()).isEqualTo(original);
+      var money = f.coordinator(new DurableCityStorage(ledger), f.economy);
+      var result = money.retry(request.operationId());
+      assertThat(result.state()).isEqualTo(CityMoneyService.State.APPLIED);
+      var restarted =
+          new DurableCityStorage(
+              new SqlCityLedgerStorage(
+                  () -> Optional.of(source),
+                  () -> {
+                    throw new AssertionError("must not reimport old file");
+                  }));
+      assertThat(restarted.moneyOperation(request.operationId())).contains(result);
+      assertThat(restarted.find(f.city.id()).orElseThrow().treasuryBalance())
+          .isEqualByComparingTo("88.89");
+      assertThat(f.economy.balance(f.mayor)).isEqualByComparingTo("111.11");
+    }
+  }
