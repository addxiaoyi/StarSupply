+      var store = f.store();
+      store.prepareMoney(request);
+      f.economy.applyMoney(request.playerRequest());
+      try (var c = f.source("city").getConnection();
+          var s = c.createStatement()) {
+        s.execute(
+            "CREATE TRIGGER reject_final BEFORE UPDATE ON starcore_city_state BEGIN SELECT"
+                + " RAISE(ABORT,'injected'); END");
+      }
+      assertThat(f.money().retry(request.operationId()).state())
+          .isEqualTo(CityMoneyService.State.PENDING);
+      assertThat(f.cityBalance()).isEqualByComparingTo("90");
+      try (var c = f.source("city").getConnection();
+          var s = c.createStatement()) {
+        s.execute("DROP TRIGGER reject_final");
+      }
+      assertThat(f.money().retry(request.operationId()).state())
+          .isEqualTo(CityMoneyService.State.APPLIED);
+      assertThat(f.economy.balance(f.mayor)).isEqualByComparingTo("110");
