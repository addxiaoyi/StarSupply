--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/module/city/CityMoneyService.java
@@ -0,0 +1,116 @@
+package dev.starcore.starcore.module.city;
+
+import dev.starcore.starcore.foundation.economy.PlayerMoneyService;
+import java.math.*;
+import java.util.*;
+
+/** Durable transfers between one player's account and a city. Keep the request ID on retry. */
+public interface CityMoneyService {
+  enum Direction {
+    DEPOSIT,
+    WITHDRAW
+  }
+
+  enum State {
+    PENDING,
+    APPLIED,
+    REJECTED
+  }
+
+  record Request(
+      UUID operationId, UUID cityId, UUID accountId, Direction direction, BigDecimal amount) {
+    public Request {
+      Objects.requireNonNull(operationId);
+      Objects.requireNonNull(cityId);
+      Objects.requireNonNull(accountId);
+      Objects.requireNonNull(direction);
+      amount = Objects.requireNonNull(amount).setScale(2, RoundingMode.UNNECESSARY);
+      if (amount.signum() <= 0 || amount.compareTo(PlayerMoneyService.MAX_BALANCE) > 0)
+        throw new IllegalArgumentException("Invalid city transfer amount");
+    }
+
+    public PlayerMoneyService.Request playerRequest() {
+      return new PlayerMoneyService.Request(
+          operationId,
+          accountId,
+          direction == Direction.DEPOSIT
+              ? PlayerMoneyService.Direction.DEBIT
+              : PlayerMoneyService.Direction.CREDIT,
+          amount,
+          "starcore:city-money:" + cityId);
+    }
+  }
+
+  record Operation(
+      Request request,
+      State state,
+      BigDecimal balanceBefore,
+      long preparedAt,
+      PlayerMoneyService.Receipt playerReceipt) {
+    public Operation {
+      Objects.requireNonNull(request);
+      Objects.requireNonNull(state);
+      Objects.requireNonNull(balanceBefore);
+      if (balanceBefore.signum() < 0
+          || balanceBefore.compareTo(PlayerMoneyService.MAX_BALANCE) > 0
+          || preparedAt <= 0) throw new IllegalArgumentException("Invalid city money intent");
+      if (request.direction() == Direction.WITHDRAW && balanceBefore.compareTo(request.amount()) < 0
+          || request.direction() == Direction.DEPOSIT
+              && balanceBefore.add(request.amount()).compareTo(PlayerMoneyService.MAX_BALANCE) > 0)
+        throw new IllegalArgumentException("City funds or capacity unavailable");
+      if (state == State.PENDING
+          ? playerReceipt != null
+          : playerReceipt == null
+              || !request.playerRequest().equals(playerReceipt.request())
+              || (state == State.APPLIED)
+                  != (playerReceipt.status() == PlayerMoneyService.Status.APPLIED))
+        throw new IllegalArgumentException("City transfer receipt does not match intent");
+    }
+
+    public BigDecimal reservedBalance() {
+      return request.direction() == Direction.WITHDRAW
+          ? balanceBefore.subtract(request.amount())
+          : balanceBefore;
+    }
+
+    public BigDecimal finalBalance() {
+      if (state == State.PENDING) return reservedBalance();
+      if (state == State.REJECTED) return balanceBefore;
+      return request.direction() == Direction.DEPOSIT
+          ? balanceBefore.add(request.amount())
+          : reservedBalance();
+    }
+
+    public Operation finish(PlayerMoneyService.Receipt receipt) {
+      return new Operation(
+          request,
+          receipt.status() == PlayerMoneyService.Status.APPLIED ? State.APPLIED : State.REJECTED,
+          balanceBefore,
+          preparedAt,
+          receipt);
+    }
+  }
+
+  Operation transfer(Request request);
+
+  Operation retry(UUID operationId);
+
+  Optional<Operation> operation(UUID operationId);
+
+  List<Operation> pending();
+
+  /** Shared command/book validation. Display inputs deliberately cap a transfer at one billion. */
+  static Optional<BigDecimal> parseUserAmount(String input) {
+    if (input == null || input.isBlank() || input.length() > 64) return Optional.empty();
+    try {
+      var amount = new BigDecimal(input.trim());
+      if (amount.signum() <= 0
+          || amount.scale() > 2
+          || amount.precision() > 12
+          || amount.compareTo(new BigDecimal("1000000000.00")) > 0) return Optional.empty();
+      return Optional.of(amount.setScale(2, RoundingMode.UNNECESSARY));
+    } catch (IllegalArgumentException | ArithmeticException invalid) {
+      return Optional.empty();
+    }
+  }
+}
