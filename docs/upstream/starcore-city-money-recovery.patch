+  public synchronized CityMoneyService.Operation prepareMoney(CityMoneyService.Request request) {
+    Objects.requireNonNull(request);
+    var ledger = storage.load();
+    var existing = ledger.moneyOperations().get(request.operationId());
+    if (existing != null) {
+      if (!existing.request().equals(request))
+        throw new IllegalArgumentException("City transfer ID reused for a different request");
+      return existing;
+    }
+    for (var op : ledger.moneyOperations().values())
+      if (op.state() == CityMoneyService.State.PENDING
+          && op.request().cityId().equals(request.cityId()))
+        throw new IllegalStateException(
+            "City has a pending transfer: " + op.request().operationId());
+    var value = ledger.cities().get(request.cityId());
+    if (value == null) throw new IllegalArgumentException("City no longer exists");
+    var operation =
+        new CityMoneyService.Operation(
+            request,
+            CityMoneyService.State.PENDING,
+            CitySnapshotCodec.number(CitySnapshotCodec.parse(value), "treasury"),
+            System.currentTimeMillis(),
+            null);
+    var values = new HashMap<>(ledger.cities());
+    values.put(
+        request.cityId(),
+        CityLedger.balanceSnapshot(value, operation.reservedBalance(), operation.preparedAt()));
+    var operations = new HashMap<>(ledger.moneyOperations());
+    operations.put(request.operationId(), operation);
+    commit(ledger.withMoney(values, operations));
