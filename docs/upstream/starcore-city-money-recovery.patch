+      var city =
+          cityService
+              .getPlayerCity(player.getUniqueId())
+              .orElseThrow(() -> new IllegalArgumentException("你不在任何城市中"));
+      var request =
+          CityMoneyInteraction.request(money, city.id(), player.getUniqueId(), direction, amount);
+      player.sendMessage(
+          Component.text(CityMoneyInteraction.submit(money, request), NamedTextColor.YELLOW));
+    } catch (RuntimeException failure) {
+      player.sendMessage(Component.text("无法开始转账，请检查城市归属、待恢复交易或联系管理员", NamedTextColor.RED));
+    }
