+public final class CityMoneyTestFixture implements AutoCloseable {
+  final Path directory;
+  final boolean sql;
+  public final UUID mayor = UUID.randomUUID();
+  public final City city;
+  final List<InternalEconomyService> economies = new ArrayList<>();
+  public InternalEconomyService economy;
+  public CityService service;
+  final Logger logger = Logger.getAnonymousLogger();
+
+  public CityMoneyTestFixture(Path directory, boolean sql) {
+    this.directory = directory;
+    this.sql = sql;
+    logger.setLevel(Level.OFF);
+    city = City.create(NationId.random(), "bank", mayor, null);
+    city.setTreasury(100);
+    store().save(city);
+    economy = openEconomy();
+    economy.applyMoney(
+        new PlayerMoneyService.Request(
+            UUID.randomUUID(),
+            mayor,
+            PlayerMoneyService.Direction.CREDIT,
+            new BigDecimal("100.00"),
+            "test:seed"));
+    service = new CityService(store(), mock(NationService.class));
+  }
+
+  public SQLiteDataSource source(String name) {
+    var source = new SQLiteDataSource();
+    source.setUrl("jdbc:sqlite:" + directory.resolve(name + ".db"));
+    return source;
+  }
+
+  CityLedgerStorage ledger() {
+    return sql
+        ? new SqlCityLedgerStorage(() -> Optional.of(source("city")), CityLedger::empty)
+        : new FileCityLedgerStorage(directory.resolve("cities"));
+  }
+
+  DurableCityStorage store() {
+    return new DurableCityStorage(ledger());
+  }
+
+  InternalEconomyService openEconomy() {
+    var plugin = mock(JavaPlugin.class);
+    when(plugin.getDataFolder()).thenReturn(directory.resolve("player").toFile());
+    when(plugin.getLogger()).thenReturn(logger);
+    var scheduler = mock(StarCoreScheduler.class);
+    when(scheduler.supplyAsync(any()))
+        .thenAnswer(
+            call -> CompletableFuture.completedFuture(call.getArgument(0, Supplier.class).get()));
+    var persistence = new PersistenceService(plugin, scheduler);
+    persistence.start();
+    var database = mock(DatabaseService.class);
+    when(database.isRunning()).thenReturn(sql);
+    if (sql) when(database.dataSource()).thenAnswer(call -> Optional.of(source("player")));
+    var economy = new InternalEconomyService(database, persistence, logger, Runnable::run);
+    economy.start();
+    economies.add(economy);
+    return economy;
+  }
+
+  void restartEconomy() {
+    economy.stop();
+    economies.remove(economy);
+    economy = openEconomy();
+  }
+
+  CityMoneyCoordinator coordinator(CityMoneyStorage storage, PlayerMoneyService players) {
+    return new CityMoneyCoordinator(storage, players, logger);
+  }
+
+  public CityMoneyService money() {
+    return coordinator(store(), economy);
+  }
+
+  public CityMoneyService.Operation prepare(CityMoneyService.Request request) {
+    return store().prepareMoney(request);
+  }
+
+  public CityMoneyService.Request request(CityMoneyService.Direction direction, String amount) {
+    return new CityMoneyService.Request(
+        UUID.randomUUID(), city.id(), mayor, direction, new BigDecimal(amount));
+  }
+
+  public BigDecimal cityBalance() {
+    return store().find(city.id()).orElseThrow().treasuryBalance();
+  }
+
+  public void close() {
+    for (var economy : economies) economy.stop();
+  }
+}
