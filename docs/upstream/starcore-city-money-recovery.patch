+
+  private StarCoreContext context(CityMoneyTestFixture f, PlayerMoneyService players) {
+    var context = mock(StarCoreContext.class);
+    var plugin = mock(JavaPlugin.class);
+    var database = mock(DatabaseService.class);
+    var registry = new ServiceRegistry();
+    when(context.plugin()).thenReturn(plugin);
+    when(context.serviceRegistry()).thenReturn(registry);
+    when(context.databaseService()).thenReturn(database);
+    when(plugin.getDataFolder()).thenReturn(directory.toFile());
+    when(plugin.getLogger()).thenReturn(f.logger);
+    when(database.isRunning()).thenReturn(f.sql);
+    if (f.sql) when(database.dataSource()).thenAnswer(call -> Optional.of(f.source("city")));
+    registry.register(NationService.class, mock(NationService.class));
+    registry.register(MessageService.class, mock(MessageService.class));
+    registry.register(PlayerMoneyService.class, players);
+    return context;
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void enableRecoversPlayerReceiptAndDisableRetiresOldReferencesAfterNewTransfer(boolean sql) {
+    try (var f = new CityMoneyTestFixture(directory, sql);
+        var bukkit = mockStatic(Bukkit.class);
+        var placeholders = mockConstruction(CityPlaceholderExpansion.class)) {
+      var pending = f.request(CityMoneyService.Direction.WITHDRAW, "8.88");
+      f.prepare(pending);
+      f.economy.applyMoney(pending.playerRequest());
+      var module = new CityModule();
+      var context = context(f, f.economy);
+      module.enable(context);
+      var money = context.serviceRegistry().require(CityMoneyService.class);
+      var city = context.serviceRegistry().require(CityService.class);
+      assertThat(money.operation(pending.operationId()).orElseThrow().state())
+          .isEqualTo(CityMoneyService.State.APPLIED);
+      assertThat(city.getCity(f.city.id()).orElseThrow().treasuryBalance())
+          .isEqualByComparingTo("91.12");
+      money.transfer(f.request(CityMoneyService.Direction.DEPOSIT, "2.22"));
+      // No city read between money settlement and disable: cache is deliberately one revision old.
+      assertThatCode(() -> module.disable(context)).doesNotThrowAnyException();
+      assertThat(context.serviceRegistry().find(CityMoneyService.class)).isEmpty();
+      assertThat(context.serviceRegistry().find(CityService.class)).isEmpty();
+      assertThatThrownBy(() -> money.retry(pending.operationId()))
+          .isInstanceOf(IllegalStateException.class);
+      assertThatThrownBy(() -> money.transfer(f.request(CityMoneyService.Direction.WITHDRAW, "1")))
+          .isInstanceOf(IllegalStateException.class);
+      assertThat(f.cityBalance()).isEqualByComparingTo("93.34");
+      assertThat(f.economy.balance(f.mayor)).isEqualByComparingTo("106.66");
