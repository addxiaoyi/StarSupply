+        var bukkit = mockStatic(Bukkit.class)) {
+      var context = context(f, f.economy);
+      var captured = new AtomicReference<CityMoneyService>();
+      when(context.plugin().getCommand("city"))
+          .thenAnswer(
+              call -> {
+                captured.set(context.serviceRegistry().require(CityMoneyService.class));
+                throw new IllegalStateException("binding failure");
+              });
+      assertThatThrownBy(() -> new CityModule().enable(context))
+          .isInstanceOf(IllegalStateException.class)
+          .hasMessage("binding failure");
+      assertThat(context.serviceRegistry().find(CityMoneyService.class)).isEmpty();
+      assertThat(context.serviceRegistry().find(CityRetirementService.class)).isEmpty();
+      assertThatThrownBy(captured.get()::pending).isInstanceOf(IllegalStateException.class);
+      assertThat(f.economy.balance(f.mayor)).isEqualByComparingTo("100");
+    }
+  }
+
+  @Test
+  void blockedPlayerRecoveryLeavesOriginalIntentAndOtherCitiesStillRecover() {
+    try (var f = new CityMoneyTestFixture(directory, false);
+        var bukkit = mockStatic(Bukkit.class);
+        var placeholders = mockConstruction(CityPlaceholderExpansion.class)) {
+      var blocked = f.request(CityMoneyService.Direction.WITHDRAW, "10");
+      f.prepare(blocked);
+      var otherMayor = UUID.randomUUID();
+      var other = City.create(NationId.random(), "other", otherMayor, null);
+      other.setTreasury(20);
+      f.store().save(other);
+      var recoverable =
+          new CityMoneyService.Request(
+              UUID.randomUUID(),
+              other.id(),
+              otherMayor,
+              CityMoneyService.Direction.WITHDRAW,
+              new BigDecimal("3.33"));
+      f.prepare(recoverable);
+      var players =
+          new PlayerMoneyService() {
+            public Optional<Receipt> moneyReceipt(UUID id) {
+              if (id.equals(blocked.operationId()))
+                throw new IllegalStateException("player authority unavailable");
+              return f.economy.moneyReceipt(id);
+            }
+
+            public Receipt applyMoney(Request request) {
+              return f.economy.applyMoney(request);
+            }
+          };
+      var context = context(f, players);
+      var module = new CityModule();
+      module.enable(context);
+      var money = context.serviceRegistry().require(CityMoneyService.class);
+      assertThat(money.pending())
+          .extracting(op -> op.request().operationId())
+          .containsExactly(blocked.operationId());
+      assertThat(money.operation(recoverable.operationId()).orElseThrow().state())
+          .isEqualTo(CityMoneyService.State.APPLIED);
+      assertThat(f.economy.balance(otherMayor)).isEqualByComparingTo("3.33");
+      module.disable(context);
+      assertThat(f.money().retry(blocked.operationId()).state())
+          .isEqualTo(CityMoneyService.State.APPLIED);
+      assertThat(f.cityBalance()).isEqualByComparingTo("90");
+      assertThat(f.economy.balance(f.mayor)).isEqualByComparingTo("110");
+    }
+  }
+}
