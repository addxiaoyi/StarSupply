diff --git a/src/main/java/dev/starcore/starcore/module/city/CityMoneyCodec.java b/src/main/java/dev/starcore/starcore/module/city/CityMoneyCodec.java
new file mode 100644
index 0000000..7098ffe
--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/module/city/CityMoneyCodec.java
@@ -0,0 +1,66 @@
+package dev.starcore.starcore.module.city;
+
+import static dev.starcore.starcore.module.city.CitySnapshotCodec.*;
+
+import com.google.gson.JsonObject;
+import dev.starcore.starcore.foundation.economy.PlayerMoneyService;
+import java.util.Set;
+
+final class CityMoneyCodec {
+  private CityMoneyCodec() {}
+
+  static JsonObject encode(CityMoneyService.Operation operation) {
+    var p = new JsonObject();
+    var request = operation.request();
+    p.addProperty("id", request.operationId().toString());
+    p.addProperty("city", request.cityId().toString());
+    p.addProperty("account", request.accountId().toString());
+    p.addProperty("direction", request.direction().name());
+    p.addProperty("amount", request.amount());
+    p.addProperty("state", operation.state().name());
+    p.addProperty("before", operation.balanceBefore());
+    p.addProperty("preparedAt", operation.preparedAt());
+    var receipt = operation.playerReceipt();
+    if (receipt != null) {
+      var r = new JsonObject();
+      r.addProperty("status", receipt.status().name());
+      r.addProperty("before", receipt.balanceBefore());
+      r.addProperty("after", receipt.balanceAfter());
+      r.addProperty("recordedAt", receipt.recordedAt());
+      p.add("receipt", r);
+    }
+    return p;
+  }
+
+  static CityMoneyService.Operation decode(JsonObject p) {
+    fields(
+        p,
+        Set.of("id", "city", "account", "direction", "amount", "state", "before", "preparedAt"),
+        Set.of("receipt"));
+    var request =
+        new CityMoneyService.Request(
+            uuid(string(p, "id", 36)),
+            uuid(string(p, "city", 36)),
+            uuid(string(p, "account", 36)),
+            CityMoneyService.Direction.valueOf(string(p, "direction", 32)),
+            number(p, "amount"));
+    PlayerMoneyService.Receipt receipt = null;
+    if (p.has("receipt")) {
+      var r = p.getAsJsonObject("receipt");
+      fields(r, Set.of("status", "before", "after", "recordedAt"), Set.of());
+      receipt =
+          new PlayerMoneyService.Receipt(
+              request.playerRequest(),
+              PlayerMoneyService.Status.valueOf(string(r, "status", 32)),
+              number(r, "before"),
+              number(r, "after"),
+              number(r, "recordedAt").longValueExact());
+    }
+    return new CityMoneyService.Operation(
+        request,
+        CityMoneyService.State.valueOf(string(p, "state", 32)),
+        number(p, "before"),
+        number(p, "preparedAt").longValueExact(),
+        receipt);
+  }
+}
diff --git a/src/main/java/dev/starcore/starcore/module/city/CityMoneyCoordinator.java b/src/main/java/dev/starcore/starcore/module/city/CityMoneyCoordinator.java
new file mode 100644
index 0000000..7d9e091
--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/module/city/CityMoneyCoordinator.java
@@ -0,0 +1,122 @@
+package dev.starcore.starcore.module.city;
+
+import dev.starcore.starcore.foundation.economy.PlayerMoneyService;
+import java.util.*;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.logging.*;
+
+/** No city or coordinator monitor is held while invoking the external player authority. */
+final class CityMoneyCoordinator implements CityMoneyService, AutoCloseable {
+  private final CityMoneyStorage storage;
+  private final PlayerMoneyService players;
+  private final Logger logger;
+  private final Set<UUID> inFlight = ConcurrentHashMap.newKeySet();
+  private final ThreadLocal<Boolean> callback = new ThreadLocal<>();
+  private volatile boolean stopped;
+  private final Object lifecycle = new Object();
+
+  CityMoneyCoordinator(CityMoneyStorage storage, PlayerMoneyService players, Logger logger) {
+    this.storage = Objects.requireNonNull(storage);
+    this.players = Objects.requireNonNull(players);
+    this.logger = Objects.requireNonNull(logger);
+  }
+
+  private void ready() {
+    if (stopped || Boolean.TRUE.equals(callback.get()))
+      throw new IllegalStateException("City money service stopped or reentrant");
+  }
+
+  public Operation transfer(Request request) {
+    Operation prepared;
+    synchronized (lifecycle) {
+      ready();
+      prepared = storage.prepareMoney(request);
+    }
+    return settle(prepared);
+  }
+
+  public Operation retry(UUID id) {
+    Operation prepared;
+    synchronized (lifecycle) {
+      ready();
+      prepared =
+          storage
+              .moneyOperation(id)
+              .orElseThrow(() -> new IllegalArgumentException("Unknown city transfer"));
+    }
+    return settle(prepared);
+  }
+
+  public Optional<Operation> operation(UUID id) {
+    synchronized (lifecycle) {
+      ready();
+      return storage.moneyOperation(id);
+    }
+  }
+
+  public List<Operation> pending() {
+    synchronized (lifecycle) {
+      ready();
+      return storage.pendingMoney();
+    }
+  }
+
+  private Operation settle(Operation operation) {
+    ready();
+    if (operation.state() != State.PENDING) return operation;
+    UUID id = operation.request().operationId();
+    if (!inFlight.add(id)) return storage.moneyOperation(id).orElseThrow();
+    try {
+      PlayerMoneyService.Receipt receipt;
+      callback.set(true);
+      try {
+        receipt =
+            players
+                .moneyReceipt(id)
+                .orElseGet(() -> players.applyMoney(operation.request().playerRequest()));
+      } finally {
+        callback.remove();
+      }
+      ready();
+      if (!operation.request().playerRequest().equals(receipt.request()))
+        throw new IllegalStateException("Player receipt conflicts with city transfer");
+      synchronized (lifecycle) {
+        ready();
+        return storage.finishMoney(id, receipt);
+      }
+    } catch (RuntimeException failure) {
+      logger.log(Level.WARNING, "City transfer remains recoverable: " + id, failure);
+      // Absence or unreadability is never a reason to refund or repeat under a new identity.
+      var actual =
+          storage
+              .moneyOperation(id)
+              .orElseThrow(() -> new IllegalStateException("Missing city money intent", failure));
+      if (!actual.request().equals(operation.request()))
+        throw new IllegalStateException("City money intent changed", failure);
+      return actual;
+    } finally {
+      inFlight.remove(id);
+    }
+  }
+
+  void recover() {
+    for (var operation : pending()) {
+      try {
+        retry(operation.request().operationId());
+      } catch (RuntimeException failure) {
+        logger.log(
+            Level.WARNING,
+            "City money recovery unavailable: " + operation.request().operationId(),
+            failure);
+      }
+    }
+  }
+
+  public void close() {
+    synchronized (lifecycle) {
+      if (Boolean.TRUE.equals(callback.get()))
+        throw new IllegalStateException("City money callback cannot stop service");
+      stopped = true;
+    }
+  }
+}
diff --git a/src/main/java/dev/starcore/starcore/module/city/CityMoneyInteraction.java b/src/main/java/dev/starcore/starcore/module/city/CityMoneyInteraction.java
new file mode 100644
index 0000000..bcdc7c6
--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/module/city/CityMoneyInteraction.java
@@ -0,0 +1,58 @@
+package dev.starcore.starcore.module.city;
+
+import java.math.BigDecimal;
+import java.util.UUID;
+
+/** Shared presentation for command and inventory transfers. No boolean money compensation. */
+public final class CityMoneyInteraction {
+  private CityMoneyInteraction() {}
+
+  public static CityMoneyService.Request request(
+      CityMoneyService money,
+      UUID city,
+      UUID account,
+      CityMoneyService.Direction direction,
+      BigDecimal amount) {
+    if (money == null) throw new IllegalStateException("城市资金服务不可用");
+    for (var op : money.pending()) {
+      var r = op.request();
+      if (r.cityId().equals(city)
+          && r.accountId().equals(account)
+          && r.direction() == direction
+          && r.amount().compareTo(amount) == 0) return r;
+    }
+    return new CityMoneyService.Request(UUID.randomUUID(), city, account, direction, amount);
+  }
+
+  public static String describe(CityMoneyService.Operation operation) {
+    var r = operation.request();
+    String action = r.direction() == CityMoneyService.Direction.DEPOSIT ? "存入城市" : "取出到玩家";
+    return switch (operation.state()) {
+      case APPLIED -> action + " " + r.amount().toPlainString() + " 金币已完成；编号 " + r.operationId();
+      case REJECTED ->
+          "转账被拒绝，城市资金已恢复（" + operation.playerReceipt().status() + "）；编号 " + r.operationId();
+      case PENDING -> "转账待恢复，请使用 /city money retry " + r.operationId();
+    };
+  }
+
+  public static String submit(CityMoneyService money, CityMoneyService.Request request) {
+    if (money == null) return "城市资金服务不可用，请联系管理员";
+    try {
+      return describe(money.transfer(request));
+    } catch (RuntimeException failure) {
+      try {
+        var recorded = money.operation(request.operationId());
+        if (recorded.isPresent()) return describe(recorded.get());
+        for (var pending : money.pending()) {
+          if (!pending.request().cityId().equals(request.cityId())) continue;
+          if (pending.request().accountId().equals(request.accountId())) return describe(pending);
+          return "城市有其他待恢复转账，请联系市长或管理员";
+        }
+        return "转账未受理，请检查城市余额、归属和权限后重试；编号 " + request.operationId();
+      } catch (RuntimeException unreadable) {
+        // A failed authority read cannot establish that preparation did not commit.
+      }
+      return "转账未确认，请使用 /city money show " + request.operationId() + " 查询；不要重复创建新交易";
+    }
+  }
+}
diff --git a/src/main/java/dev/starcore/starcore/module/city/CityMoneyService.java b/src/main/java/dev/starcore/starcore/module/city/CityMoneyService.java
new file mode 100644
