+  private boolean handleMoneyRecovery(CommandSender sender, String[] args) {
+    boolean admin = sender.hasPermission("starcore.city.money.admin");
+    if (!admin && !(sender instanceof Player)) {
+      sender.sendMessage(Component.text("没有城市资金管理权限", NamedTextColor.RED));
+      return true;
+    }
+    if (money == null) {
+      sender.sendMessage(Component.text("城市资金服务不可用", NamedTextColor.RED));
+      return true;
+    }
+    try {
+      if (args.length == 1 || (args.length == 2 && args[1].equalsIgnoreCase("list"))) {
+        var pending =
+            money.pending().stream()
+                .filter(
+                    op -> admin || op.request().accountId().equals(((Player) sender).getUniqueId()))
+                .toList();
+        if (pending.isEmpty()) sender.sendMessage(Component.text("没有待恢复城市转账", NamedTextColor.GRAY));
+        pending.stream()
+            .limit(50)
+            .forEach(
+                op ->
+                    sender.sendMessage(
+                        Component.text(CityMoneyInteraction.describe(op), NamedTextColor.YELLOW)));
+        return true;
+      }
+      if (args.length != 3
+          || !(args[1].equalsIgnoreCase("show") || args[1].equalsIgnoreCase("retry"))) {
+        sender.sendMessage(
+            Component.text("用法: /city money list|show <编号>|retry <编号>", NamedTextColor.YELLOW));
+        return true;
+      }
+      var id = UUID.fromString(args[2]);
+      var operation = money.operation(id).orElseThrow(() -> new IllegalArgumentException("未找到该转账"));
+      if (!admin && !operation.request().accountId().equals(((Player) sender).getUniqueId())) {
+        sender.sendMessage(Component.text("只能查询或恢复自己的转账", NamedTextColor.RED));
         return true;
+      }
+      if (args[1].equalsIgnoreCase("retry")) operation = money.retry(id);
+      sender.sendMessage(
+          Component.text(CityMoneyInteraction.describe(operation), NamedTextColor.YELLOW));
+    } catch (RuntimeException failure) {
+      sender.sendMessage(Component.text("无法读取或恢复该转账，请检查编号或联系管理员", NamedTextColor.RED));
+    }
+    return true;
+  }
