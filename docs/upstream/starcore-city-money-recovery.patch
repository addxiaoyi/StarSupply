+  private boolean handleMoneyTransfer(
+      Player player, java.math.BigDecimal amount, CityMoneyService.Direction direction) {
+    if (!player.hasPermission("starcore.city.money")) {
+      player.sendMessage(Component.text("你没有城市转账权限", NamedTextColor.RED));
