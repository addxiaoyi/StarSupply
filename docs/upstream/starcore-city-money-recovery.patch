+
+class CityMoneyRecoveryTest {
+  @TempDir Path directory;
+
+  @BeforeEach
+  void extensions() {
+    ExtensionRegistry.init(Logger.getAnonymousLogger());
+    ExtensionRegistry.getInstance().clear();
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void realPlayerAndCityFundsConserveValueAcrossRestartAndReplay(boolean sql) {
+    try (var f = new CityMoneyTestFixture(directory, sql)) {
+      var money = f.money();
+      var deposit = f.request(CityMoneyService.Direction.DEPOSIT, "12.34");
+      var withdraw = f.request(CityMoneyService.Direction.WITHDRAW, "20.01");
+      assertThat(money.transfer(deposit).state()).isEqualTo(CityMoneyService.State.APPLIED);
+      var result = money.transfer(withdraw);
+      assertThat(result.state()).isEqualTo(CityMoneyService.State.APPLIED);
+      assertThat(f.economy.balance(f.mayor)).isEqualByComparingTo("107.67");
+      assertThat(f.cityBalance()).isEqualByComparingTo("92.33");
+      f.restartEconomy();
+      var restarted = f.money();
+      assertThat(restarted.transfer(withdraw)).isEqualTo(result);
+      restarted.retry(deposit.operationId());
+      assertThat(f.cityBalance().add(f.economy.balance(f.mayor))).isEqualByComparingTo("200.00");
+      assertThat(restarted.pending()).isEmpty();
+      f.store().delete(f.city.id());
+      assertThat(restarted.transfer(withdraw)).isEqualTo(result);
+      assertThat(f.economy.balance(f.mayor)).isEqualByComparingTo("107.67");
+    }
+  }
+
+  @ParameterizedTest
+  @CsvSource({"false,DEPOSIT", "false,WITHDRAW", "true,DEPOSIT", "true,WITHDRAW"})
+  void lostPlayerResponseRetainsReservationAndOriginalIdentity(
+      boolean sql, CityMoneyService.Direction direction) {
+    try (var f = new CityMoneyTestFixture(directory, sql)) {
+      AtomicBoolean fail = new AtomicBoolean(true);
+      var players =
+          new PlayerMoneyService() {
+            public Optional<Receipt> moneyReceipt(UUID id) {
+              return f.economy.moneyReceipt(id);
+            }
+
+            public Receipt applyMoney(Request request) {
+              var receipt = f.economy.applyMoney(request);
+              if (fail.getAndSet(false)) throw new IllegalStateException("lost response");
+              return receipt;
+            }
+          };
+      var storage = f.store();
+      var money = f.coordinator(storage, players);
+      var request = f.request(direction, "10.25");
+      assertThat(money.transfer(request).state()).isEqualTo(CityMoneyService.State.PENDING);
+      assertThat(f.cityBalance())
+          .isEqualByComparingTo(direction == CityMoneyService.Direction.DEPOSIT ? "100" : "89.75");
+      assertThatThrownBy(() -> f.store().delete(f.city.id())).isInstanceOf(RuntimeException.class);
+      assertThatThrownBy(() -> f.store().retireNationCities(UUID.randomUUID(), f.city.nationId()))
+          .isInstanceOf(RuntimeException.class);
+      var changed = storage.find(f.city.id()).orElseThrow();
+      changed.setName("late");
+      assertThatThrownBy(() -> storage.save(changed)).isInstanceOf(IllegalStateException.class);
+      assertThatThrownBy(() -> money.transfer(f.request(direction, "1.00")))
+          .isInstanceOf(IllegalStateException.class);
+      f.restartEconomy();
+      var restarted = f.money();
+      assertThat(restarted.retry(request.operationId()).state())
+          .isEqualTo(CityMoneyService.State.APPLIED);
+      assertThat(f.cityBalance().add(f.economy.balance(f.mayor))).isEqualByComparingTo("200.00");
+      f.store().retireNationCities(UUID.randomUUID(), f.city.nationId());
+      assertThat(restarted.retry(request.operationId()).state())
+          .isEqualTo(CityMoneyService.State.APPLIED);
+    }
+  }
+
+  static final class FaultStore implements CityLedgerStorage {
+    final CityLedgerStorage delegate;
+    int writes, failAt;
+    boolean after, blockRead, blocked;
+
+    FaultStore(CityLedgerStorage delegate) {
+      this.delegate = delegate;
+    }
+
+    public CityLedger load() {
+      if (blocked) throw new IllegalStateException("read unavailable");
+      return delegate.load();
+    }
+
+    public void save(CityLedger ledger) {
+      writes++;
+      if (writes != failAt) {
+        delegate.save(ledger);
+        return;
+      }
+      if (after) delegate.save(ledger);
+      blocked = blockRead;
+      throw new IllegalStateException("city write response lost");
+    }
+  }
+
+  @ParameterizedTest
+  @CsvSource({
+    "false,false,1",
+    "false,true,1",
+    "false,false,2",
+    "false,true,2",
+    "true,false,1",
+    "true,true,1",
+    "true,false,2",
+    "true,true,2"
+  })
+  void failureBeforeOrAfterEachCityCommitRecoversWithoutDuplicateMoney(
+      boolean sql, boolean after, int stage) {
+    try (var f = new CityMoneyTestFixture(directory, sql)) {
+      var fault = new FaultStore(f.ledger());
+      fault.failAt = stage;
+      fault.after = after;
+      fault.blockRead = true;
+      var money = f.coordinator(new DurableCityStorage(fault), f.economy);
+      var request = f.request(CityMoneyService.Direction.WITHDRAW, "9.25");
+      assertThatThrownBy(() -> money.transfer(request)).isInstanceOf(RuntimeException.class);
+      var actual = f.money();
+      var intent = actual.operation(request.operationId());
+      assertThat(intent.isPresent()).isEqualTo(stage == 2 || after);
+      assertThat(f.economy.moneyReceipt(request.operationId()).isPresent()).isEqualTo(stage == 2);
+      if (intent.isPresent()) actual.retry(request.operationId());
+      else actual.transfer(request);
+      actual.transfer(request);
+      assertThat(f.cityBalance()).isEqualByComparingTo("90.75");
+      assertThat(f.economy.balance(f.mayor)).isEqualByComparingTo("109.25");
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void rejectedExternalCreditReleasesCityReservationExactlyOnce(boolean sql) {
+    try (var f = new CityMoneyTestFixture(directory, sql)) {
+      f.economy.applyMoney(
+          new PlayerMoneyService.Request(
+              UUID.randomUUID(),
+              f.mayor,
+              PlayerMoneyService.Direction.CREDIT,
+              PlayerMoneyService.MAX_BALANCE.subtract(new BigDecimal("100")),
+              "test:fill"));
+      var request = f.request(CityMoneyService.Direction.WITHDRAW, "10");
+      var money = f.money();
+      var rejected = money.transfer(request);
+      assertThat(rejected.state()).isEqualTo(CityMoneyService.State.REJECTED);
+      assertThat(rejected.playerReceipt().status())
+          .isEqualTo(PlayerMoneyService.Status.BALANCE_LIMIT);
+      assertThat(f.cityBalance()).isEqualByComparingTo("100");
+      f.economy.applyMoney(
+          new PlayerMoneyService.Request(
+              UUID.randomUUID(),
+              f.mayor,
+              PlayerMoneyService.Direction.DEBIT,
+              new BigDecimal("20"),
+              "test:spend"));
+      assertThat(money.transfer(request)).isEqualTo(rejected);
+      assertThat(f.cityBalance()).isEqualByComparingTo("100");
+    }
+  }
