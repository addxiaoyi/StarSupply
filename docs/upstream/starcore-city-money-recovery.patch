+  @Test
+  void callbacksCannotCreateNestedTransfersAndStopDoesNotWaitOnPlayer() throws Exception {
+    try (var f = new CityMoneyTestFixture(directory, false)) {
+      var entered = new CountDownLatch(1);
+      var release = new CountDownLatch(1);
+      CityMoneyCoordinator[] holder = new CityMoneyCoordinator[1];
+      var players =
+          new PlayerMoneyService() {
+            public Optional<Receipt> moneyReceipt(UUID id) {
+              return Optional.empty();
+            }
+
+            public Receipt applyMoney(Request request) {
+              assertThatThrownBy(
+                      () -> holder[0].transfer(f.request(CityMoneyService.Direction.DEPOSIT, "1")))
+                  .isInstanceOf(IllegalStateException.class);
+              assertThatThrownBy(holder[0]::close).isInstanceOf(IllegalStateException.class);
+              entered.countDown();
+              try {
+                if (!release.await(5, TimeUnit.SECONDS)) throw new IllegalStateException("timeout");
+              } catch (InterruptedException e) {
+                throw new IllegalStateException(e);
+              }
+              return f.economy.applyMoney(request);
+            }
+          };
+      holder[0] = f.coordinator(f.store(), players);
+      var request = f.request(CityMoneyService.Direction.WITHDRAW, "10");
+      try (var executor = Executors.newFixedThreadPool(2)) {
+        var result = executor.submit(() -> holder[0].transfer(request));
+        assertThat(entered.await(5, TimeUnit.SECONDS)).isTrue();
+        try {
+          executor.submit(holder[0]::close).get(2, TimeUnit.SECONDS);
+        } finally {
+          release.countDown();
+        }
+        assertThat(result.get(5, TimeUnit.SECONDS).state())
+            .isEqualTo(CityMoneyService.State.PENDING);
+      }
+      assertThatThrownBy(() -> holder[0].retry(request.operationId()))
+          .isInstanceOf(IllegalStateException.class);
+      assertThat(f.money().retry(request.operationId()).state())
+          .isEqualTo(CityMoneyService.State.APPLIED);
+      assertThat(f.economy.balance(f.mayor)).isEqualByComparingTo("110");
+    }
+  }
+}
