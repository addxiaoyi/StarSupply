index 0000000..a43b51b
--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/module/diplomacy/RelationshipAuthorityStore.java
@@ -0,0 +1,481 @@
+package dev.starcore.starcore.module.diplomacy;
+
+import dev.starcore.starcore.core.database.DatabaseService;
+import dev.starcore.starcore.core.persistence.AtomicFilePersistence;
+import dev.starcore.starcore.core.persistence.PersistenceService;
+import dev.starcore.starcore.module.nation.model.NationId;
+import java.io.*;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.*;
+import java.security.MessageDigest;
+import java.sql.*;
+import java.util.*;
+import java.util.function.*;
+
+/**
+ * Shared durability mechanism for the separate bilateral alliance and military pact authorities.
+ */
+public final class RelationshipAuthorityStore {
+  public static final String REVISION = "state.revision";
+  private static final String HASH = "authority.sha256",
+      VERSION = "authority.version",
+      RETIRED = "retired.";
+  private static final int MAX_BYTES = 64 * 1024 * 1024;
+  private static final Object[] GUARDS = new Object[64];
+
+  static {
+    Arrays.setAll(GUARDS, ignored -> new Object());
+  }
+
+  private final DatabaseService database;
+  private final PersistenceService persistence;
+  private final String namespace, filename, table, schemaKey;
+  private final boolean sql;
+  private final List<String> families;
+  private final Supplier<Properties> legacy;
+  private final Consumer<Properties> validator;
+  private final BiFunction<Long, Long, RuntimeException> conflict;
+  private Properties observed;
+  private byte[] expectedFile;
+  private boolean failed, fileSeen;
+
+  public RelationshipAuthorityStore(
+      DatabaseService database,
+      PersistenceService persistence,
+      String namespace,
+      String filename,
+      String table,
+      String schemaKey,
+      List<String> families,
+      Supplier<Properties> legacy,
+      Consumer<Properties> validator,
+      BiFunction<Long, Long, RuntimeException> conflict) {
+    this.database = database;
+    this.persistence = persistence;
+    this.namespace = namespace;
+    this.filename = filename;
+    if (!table.matches("starcore_[a-z_]+"))
+      throw new IllegalArgumentException("Invalid state table");
+    this.table = table;
+    this.schemaKey = Objects.requireNonNull(schemaKey);
+    this.families = List.copyOf(families);
+    this.legacy = Objects.requireNonNull(legacy);
+    this.validator = Objects.requireNonNull(validator);
+    this.conflict = Objects.requireNonNull(conflict);
+    this.sql = database != null && database.isRunning();
+  }
+
+  public synchronized Properties load() {
+    try {
+      Properties value;
+      if (sql) {
+        try (Connection connection = connection()) {
+          initializeTable(connection);
+          value = readSql(connection);
+        }
+        if (isEmptySql(value)) {
+          if (revision(value) != 0 || observed != null && !isEmptySql(observed))
+            throw new IllegalStateException("Missing relationship SQL authority");
+          Properties migrated = legacy.get();
+          validate(migrated);
+          if (!migrated.isEmpty()) {
+            Properties candidate = copy(migrated);
+            candidate.setProperty(REVISION, "1");
+            candidate = seal(candidate);
+            writeSql(candidate, value);
+            value = candidate;
+          }
+        }
+      } else {
+        Path path = path();
+        byte[] bytes = readFile(path);
+        if (bytes == null
+            && (fileSeen
+                || Files.exists(AtomicFilePersistence.backup(path))
+                || Files.exists(AtomicFilePersistence.temp(path))))
+          throw new IllegalStateException("Missing relationship file authority");
+        value = bytes == null ? legacy.get() : decode(bytes);
+        validate(value);
+        expectedFile = bytes;
+        fileSeen |= bytes != null;
+      }
+      validate(value);
+      if (observed != null) transition(observed, value);
+      observed = copy(value);
+      failed = false;
+      return copy(value);
+    } catch (IOException | SQLException | RuntimeException error) {
+      failed = true;
+      if (error instanceof RuntimeException runtime) throw runtime;
+      throw new IllegalStateException("Unable to load relationship authority", error);
+    }
+  }
+
+  public synchronized Properties snapshot() {
+    if (observed == null) return load();
+    if (failed) throw new IllegalStateException("Relationship authority unavailable");
+    return copy(observed);
+  }
+
+  private static boolean isEmptySql(Properties value) {
+    return value.isEmpty() || value.size() == 1 && value.containsKey(REVISION);
+  }
+
+  /** Full family and receipt replacement. Unrelated metadata is retained. */
+  public synchronized void save(Properties update) {
+    if (observed == null) load();
+    if (failed)
+      throw new IllegalStateException("Relationship authority unavailable; reload required");
+    Properties candidate = copy(observed);
+    candidate
+        .keySet()
+        .removeIf(
+            k ->
+                k instanceof String s
+                    && (families.stream().anyMatch(s::startsWith) || s.startsWith(RETIRED)));
+    candidate.putAll(update);
+    candidate.setProperty(REVISION, Long.toString(Math.addExact(revision(observed), 1)));
+    candidate = seal(candidate);
+    transition(observed, candidate);
+    try {
+      if (sql) writeSql(candidate, observed);
+      else writeFile(candidate);
+      observed = copy(candidate);
+    } catch (RuntimeException error) {
+      try {
+        Properties actual = load();
+        if (actual.equals(candidate)) return;
+      } catch (RuntimeException unreadable) {
+        failed = true;
+        error.addSuppressed(unreadable);
+      }
+      throw error;
+    }
+  }
+
+  public synchronized RelationshipRetirementReceipt retire(UUID operation, NationId nation) {
+    Objects.requireNonNull(operation);
+    Objects.requireNonNull(nation);
+    if (observed == null) load();
+    if (failed) throw new IllegalStateException("Relationship authority unavailable");
+    var existing = receipts(observed).get(nation);
+    if (existing != null) {
+      if (!existing.operationId().equals(operation))
+        throw new IllegalArgumentException("Conflicting relationship retirement operation");
+      return existing;
+    }
+    var candidate = copy(observed);
+    candidate.putIfAbsent(schemaKey, "2");
+    int count = 0;
+    for (String key : observed.stringPropertyNames()) {
+      for (String prefix : families) {
+        if (key.startsWith(prefix) && endpoints(key.substring(prefix.length())).contains(nation)) {
+          candidate.remove(key);
+          count++;
+        }
+      }
+    }
+    var receipt = new RelationshipRetirementReceipt(operation, nation, count);
+    candidate.setProperty(RETIRED + nation, operation + ":" + count);
+    save(candidate);
+    return receipt;
+  }
+
+  private void writeFile(Properties candidate) {
+    try {
+      Path path = path();
+      synchronized (GUARDS[Math.floorMod(path.hashCode(), GUARDS.length)]) {
+        byte[] current = readFile(path);
+        if (!Arrays.equals(expectedFile, current))
+          throw conflict.apply(
+              revision(observed), revision(current == null ? new Properties() : decode(current)));
+        var output = new ByteArrayOutputStream();
+        candidate.store(output, "STARCORE relationship authority");
+        byte[] bytes = output.toByteArray();
+        if (bytes.length > MAX_BYTES) throw new IOException("Relationship snapshot too large");
+        AtomicFilePersistence.replace(path, temp -> Files.write(temp, bytes));
+        if (!Arrays.equals(readFile(path), bytes))
+          throw new IOException("Relationship snapshot not published");
+        expectedFile = bytes;
+        fileSeen = true;
+      }
+    } catch (IOException error) {
+      throw new IllegalStateException("Unable to save relationship authority", error);
+    }
+  }
+
+  private void writeSql(Properties candidate, Properties expected) {
+    for (int attempt = 0; ; attempt++) {
+      try (Connection connection = connection()) {
+        initializeTable(connection);
+        connection.setAutoCommit(false);
+        try {
+          Properties current = readSql(connection);
+          if (revision(current) != revision(expected))
+            throw conflict.apply(revision(expected), revision(current));
+          validate(current);
+          transition(current, candidate);
+          try (var update =
+              connection.prepareStatement(
+                  "UPDATE "
+                      + table
+                      + " SET property_value=? WHERE property_key=? AND property_value=?")) {
+            update.setString(1, candidate.getProperty(REVISION));
+            update.setString(2, REVISION);
+            update.setString(3, Long.toString(revision(expected)));
+            if (update.executeUpdate() != 1)
+              throw conflict.apply(revision(expected), revision(readSql(connection)));
+          }
+          try (var delete =
+              connection.prepareStatement("DELETE FROM " + table + " WHERE property_key<>?")) {
+            delete.setString(1, REVISION);
+            delete.executeUpdate();
+          }
+          try (var insert =
+              connection.prepareStatement(
+                  "INSERT INTO " + table + " (property_key, property_value) VALUES (?,?)")) {
+            for (String key : candidate.stringPropertyNames()) {
+              if (REVISION.equals(key)) continue;
+              insert.setString(1, key);
+              insert.setString(2, candidate.getProperty(key));
+              insert.addBatch();
+            }
+            insert.executeBatch();
+          }
+          connection.commit();
+          return;
+        } catch (SQLException | RuntimeException error) {
+          try {
+            connection.rollback();
+          } catch (SQLException rollback) {
+            error.addSuppressed(rollback);
+          }
+          throw error;
+        }
+      } catch (SQLException error) {
+        if (attempt >= 3 || !sqliteBusy(error))
+          throw new IllegalStateException("Unable to save relationship SQL authority", error);
+        try {
+          Thread.sleep(25L * (attempt + 1));
+        } catch (InterruptedException interrupted) {
+          Thread.currentThread().interrupt();
+          throw new IllegalStateException(interrupted);
+        }
+      }
+    }
+  }
+
+  private static boolean sqliteBusy(SQLException error) {
+    String message = Objects.toString(error.getMessage(), "").toLowerCase(Locale.ROOT);
+    return message.contains("sqlite_busy")
+        || message.contains("sqlite_locked")
+        || message.contains("database is locked");
+  }
+
+  private Connection connection() throws SQLException {
+    return database
+        .dataSource()
+        .orElseThrow(() -> new IllegalStateException("Relationship database unavailable"))
+        .getConnection();
+  }
+
+  private void initializeTable(Connection connection) throws SQLException {
+    try (var statement = connection.createStatement()) {
+      statement.execute(
+          "CREATE TABLE IF NOT EXISTS "
+              + table
+              + " (property_key VARCHAR(191) PRIMARY KEY, property_value TEXT NOT NULL)");
+    }
+    if (!revisionExists(connection)) {
+      try (var insert =
+          connection.prepareStatement(
+              "INSERT INTO " + table + " (property_key, property_value) VALUES (?,?)")) {
+        insert.setString(1, REVISION);
+        insert.setString(2, "0");
+        try {
+          insert.executeUpdate();
+        } catch (SQLException race) {
+          if (!revisionExists(connection)) throw race;
+        }
+      }
+    }
+  }
+
+  private boolean revisionExists(Connection connection) throws SQLException {
+    try (var statement =
+        connection.prepareStatement("SELECT 1 FROM " + table + " WHERE property_key=?")) {
+      statement.setString(1, REVISION);
+      try (var rows = statement.executeQuery()) {
+        return rows.next();
+      }
+    }
+  }
+
+  private Properties readSql(Connection connection) throws SQLException {
+    var value = new Properties();
+    try (var statement = connection.createStatement();
+        var rows = statement.executeQuery("SELECT property_key, property_value FROM " + table)) {
+      while (rows.next()) value.setProperty(rows.getString(1), rows.getString(2));
+    }
+    return value;
+  }
+
+  private Path path() throws IOException {
+    return Objects.requireNonNull(persistence.namespacePath(namespace))
+        .resolve(filename)
+        .toAbsolutePath()
+        .normalize();
+  }
+
+  /** No implicit backup recovery or damaged-row omission during migration. */
+  public static Properties readLegacy(
+      PersistenceService persistence, String namespace, String filename) {
+    try {
+      Path path = Objects.requireNonNull(persistence.namespacePath(namespace)).resolve(filename);
+      byte[] bytes = readFile(path);
+      if (bytes == null
+          && (Files.exists(AtomicFilePersistence.backup(path))
+              || Files.exists(AtomicFilePersistence.temp(path))))
+        throw new IOException("Missing legacy relationship authority");
+      return bytes == null ? new Properties() : decode(bytes);
+    } catch (IOException error) {
+      throw new IllegalStateException("Unable to read legacy relationships", error);
+    }
+  }
+
+  private static byte[] readFile(Path path) throws IOException {
+    if (!Files.exists(path)) return null;
+    if (!Files.isRegularFile(path) || Files.size(path) > MAX_BYTES)
+      throw new IOException("Invalid relationship file");
+    try (var input = Files.newInputStream(path)) {
+      byte[] bytes = input.readNBytes(MAX_BYTES + 1);
+      if (bytes.length > MAX_BYTES) throw new IOException("Relationship file too large");
+      return bytes;
+    }
+  }
+
+  private static Properties decode(byte[] bytes) throws IOException {
+    var value =
+        new Properties() {
+          @Override
+          public synchronized Object put(Object key, Object value) {
+            if (containsKey(key))
+              throw new IllegalArgumentException("Duplicate relationship property");
+            return super.put(key, value);
+          }
+        };
+    value.load(new ByteArrayInputStream(bytes));
+    if (value.isEmpty()) throw new IOException("Empty relationship authority");
+    return value;
+  }
+
+  public static Properties copy(Properties value) {
+    var result = new Properties();
+    result.putAll(value);
+    return result;
+  }
+
+  public static long revision(Properties value) {
+    long revision = Long.parseLong(value.getProperty(REVISION, "0"));
+    if (revision < 0) throw new IllegalArgumentException("Negative relationship revision");
+    return revision;
+  }
+
+  public static List<NationId> endpoints(String pair) {
+    String[] values = pair.split(":", -1);
+    if (values.length != 2) throw new IllegalArgumentException("Invalid relationship key");
+    var ids = Arrays.stream(values).map(v -> NationId.of(UUID.fromString(v))).toList();
+    if (ids.get(0).equals(ids.get(1)) || !pair.equals(ids.get(0) + ":" + ids.get(1)))
+      throw new IllegalArgumentException("Invalid relationship endpoints");
+    return ids;
+  }
+
+  public static Map<NationId, RelationshipRetirementReceipt> receipts(Properties value) {
+    var result = new HashMap<NationId, RelationshipRetirementReceipt>();
+    for (String key : value.stringPropertyNames())
+      if (key.startsWith(RETIRED)) {
+        var nation = NationId.of(UUID.fromString(key.substring(RETIRED.length())));
+        String[] fields = value.getProperty(key).split(":", -1);
+        if (fields.length != 2) throw new IllegalArgumentException("Invalid relationship receipt");
+        var receipt =
+            new RelationshipRetirementReceipt(
+                UUID.fromString(fields[0]), nation, Integer.parseInt(fields[1]));
+        if (!key.equals(RETIRED + nation)
+            || !value
+                .getProperty(key)
+                .equals(receipt.operationId() + ":" + receipt.clearedEntries()))
+          throw new IllegalArgumentException("Invalid relationship receipt encoding");
+        result.put(nation, receipt);
+      }
+    return Map.copyOf(result);
+  }
+
+  public static void putReceipts(
+      Properties value, Map<NationId, RelationshipRetirementReceipt> receipts) {
+    receipts.forEach(
+        (nation, receipt) -> {
+          if (!nation.equals(receipt.nationId()))
+            throw new IllegalArgumentException("Receipt nation mismatch");
+          value.setProperty(
+              RETIRED + nation, receipt.operationId() + ":" + receipt.clearedEntries());
+        });
+  }
+
+  private static String checksum(Properties value) {
+    try {
+      var hash = MessageDigest.getInstance("SHA-256");
+      for (String key : new TreeSet<>(value.stringPropertyNames()))
+        if (!key.equals(HASH))
+          for (String part : List.of(key, value.getProperty(key))) {
+            byte[] bytes = part.getBytes(StandardCharsets.UTF_8);
+            hash.update(java.nio.ByteBuffer.allocate(4).putInt(bytes.length).array());
+            hash.update(bytes);
+          }
+      return HexFormat.of().formatHex(hash.digest());
+    } catch (java.security.NoSuchAlgorithmException error) {
+      throw new IllegalStateException(error);
+    }
+  }
+
+  private Properties seal(Properties value) {
+    var result = copy(value);
+    result.setProperty(VERSION, "1");
+    result.setProperty(HASH, checksum(result));
+    validate(result);
+    return result;
+  }
+
+  private void validate(Properties value) {
+    if (value.size() != value.stringPropertyNames().size())
+      throw new IllegalArgumentException("Non-text relationship property");
+    if (value.containsKey(VERSION)
+        || value.containsKey(HASH)
+        || value.stringPropertyNames().stream().anyMatch(k -> k.startsWith(RETIRED)))
+      if (!"1".equals(value.getProperty(VERSION))
+          || !checksum(value).equals(value.getProperty(HASH)))
+        throw new IllegalArgumentException("Relationship authority checksum/version mismatch");
+    revision(value);
+    var retired = receipts(value);
+    for (String key : value.stringPropertyNames())
+      for (String prefix : families)
+        if (key.startsWith(prefix)
+            && endpoints(key.substring(prefix.length())).stream().anyMatch(retired::containsKey))
+          throw new IllegalArgumentException("Relationship references a retired nation");
+    validator.accept(value);
+  }
+
+  private void transition(Properties previous, Properties next) {
+    validate(previous);
+    validate(next);
+    var after = receipts(next);
+    receipts(previous)
+        .forEach(
+            (nation, receipt) -> {
+              if (!receipt.equals(after.get(nation)))
+                throw new IllegalArgumentException(
+                    "Relationship retirement receipts are immutable");
+            });
+    if (previous.containsKey(VERSION) && !next.containsKey(VERSION))
+      throw new IllegalArgumentException("Relationship authority downgrade");
+  }
+}
