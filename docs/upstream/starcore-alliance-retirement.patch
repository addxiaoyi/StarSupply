+package dev.starcore.starcore.module.diplomacy;
+
+import java.nio.ByteBuffer;
+import java.nio.charset.*;
+import java.util.Base64;
+import java.util.Map;
+import java.util.Objects;
+
+/** Lossless names and strict legacy field validation for both relationship snapshots. */
+public final class RelationshipValues {
+  private RelationshipValues() {}
+
+  public static String encode(String value) {
+    return Base64.getEncoder()
+        .encodeToString(Objects.requireNonNull(value).getBytes(StandardCharsets.UTF_8));
+  }
+
+  public static String name(String value, boolean encoded) {
+    if (!encoded) return value;
+    try {
+      byte[] bytes = Base64.getDecoder().decode(value);
+      String decoded =
+          StandardCharsets.UTF_8
+              .newDecoder()
+              .onMalformedInput(CodingErrorAction.REPORT)
+              .decode(ByteBuffer.wrap(bytes))
+              .toString();
+      if (!encode(decoded).equals(value))
+        throw new IllegalArgumentException("Invalid relationship name encoding");
+      return decoded;
+    } catch (CharacterCodingException error) {
+      throw new IllegalArgumentException("Invalid relationship UTF-8", error);
+    }
+  }
+
+  public static String[] fields(String value, int count) {
+    String[] fields = Objects.requireNonNull(value).split("\\|", -1);
+    if (fields.length != count)
+      throw new IllegalArgumentException("Invalid relationship field count");
+    return fields;
+  }
+
+  public static <K, V> void put(Map<K, V> map, K key, V value) {
+    if (map.putIfAbsent(key, value) != null)
+      throw new IllegalArgumentException("Duplicate relationship entry");
+  }
+}
