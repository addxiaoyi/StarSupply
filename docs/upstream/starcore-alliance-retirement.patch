@@ -0,0 +1,96 @@
+package dev.starcore.starcore.module.diplomacy;
+
+import static org.assertj.core.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+import java.lang.reflect.*;
+import java.nio.file.Path;
+import java.sql.*;
+import java.util.*;
+import java.util.concurrent.atomic.AtomicBoolean;
+import javax.sql.DataSource;
+import org.junit.jupiter.api.io.TempDir;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+
+class AllianceRetirementSqlCommitTest {
+  @TempDir Path root;
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void actualJdbcCommitResponseLossReturnsProofOrFreezesUntilExplicitReload(boolean military) {
+    try (var f = new AllianceRetirementFixture(root, true)) {
+      var armed = new AtomicBoolean();
+      var failRead = new AtomicBoolean();
+      var loseRead = new AtomicBoolean();
+      DataSource source =
+          (DataSource)
+              Proxy.newProxyInstance(
+                  getClass().getClassLoader(),
+                  new Class<?>[] {DataSource.class},
+                  (proxy, method, args) -> {
+                    if (method.getName().equals("getConnection")) {
+                      if (failRead.get()) throw new SQLException("readback offline");
+                      Connection actual = (Connection) invoke(f.sql, method, args);
+                      return Proxy.newProxyInstance(
+                          getClass().getClassLoader(),
+                          new Class<?>[] {Connection.class},
+                          (p, m, a) -> {
+                            Object value = invoke(actual, m, a);
+                            if (m.getName().equals("commit") && armed.compareAndSet(true, false)) {
+                              if (loseRead.get()) failRead.set(true);
+                              throw new SQLException("committed but response lost");
+                            }
+                            return value;
+                          });
+                    }
+                    return invoke(f.sql, method, args);
+                  });
+      when(f.database.dataSource()).thenReturn(Optional.of(source));
+      var op = UUID.randomUUID();
+      if (military) {
+        var store = f.militaryStorage();
+        f.seedMilitary(store);
+        var service = f.military(store, null);
+        armed.set(true);
+        assertThat(service.retireMilitaryAlliances(op, f.a).clearedEntries()).isEqualTo(3);
+        loseRead.set(true);
+        armed.set(true);
+        var next = UUID.randomUUID();
+        assertThatThrownBy(() -> service.retireMilitaryAlliances(next, f.b))
+            .isInstanceOf(IllegalStateException.class);
+        assertThatThrownBy(() -> service.clearNationRelations(f.c))
+            .hasMessageContaining("unavailable");
+        failRead.set(false);
+        service.initialize();
+        assertThat(service.retireMilitaryAlliances(next, f.b).operationId()).isEqualTo(next);
+        assertThat(f.military().retireMilitaryAlliances(op, f.a).clearedEntries()).isEqualTo(3);
+      } else {
+        var store = f.allianceStorage();
+        f.seedAlliance(store);
+        var service = f.alliance(store, null);
+        armed.set(true);
+        assertThat(service.retireAlliances(op, f.a).clearedEntries()).isEqualTo(3);
+        loseRead.set(true);
+        armed.set(true);
+        var next = UUID.randomUUID();
+        assertThatThrownBy(() -> service.retireAlliances(next, f.b))
+            .isInstanceOf(IllegalStateException.class);
+        assertThatThrownBy(() -> service.clearNationRelations(f.c))
+            .hasMessageContaining("unavailable");
+        failRead.set(false);
+        service.initialize();
+        assertThat(service.retireAlliances(next, f.b).operationId()).isEqualTo(next);
+        assertThat(f.alliance().retireAlliances(op, f.a).clearedEntries()).isEqualTo(3);
+      }
+    }
+  }
+
+  private static Object invoke(Object target, Method method, Object[] args) throws Throwable {
+    try {
+      return method.invoke(target, args);
+    } catch (InvocationTargetException error) {
+      throw error.getCause();
+    }
+  }
+}
