+import java.nio.file.Path;
+import java.util.*;
+import java.util.concurrent.*;
+import java.util.concurrent.atomic.AtomicReference;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+
+class AllianceRetirementTest {
+  @TempDir Path root;
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void bothAuthoritiesRetainOriginalResultAndRejectLateServiceAndRawWrites(boolean sql) {
+    try (var f = new AllianceRetirementFixture(root, sql)) {
+      var as = f.allianceStorage();
+      f.seedAlliance(as);
+      var ms = f.militaryStorage();
+      f.seedMilitary(ms);
+      var alliance = f.alliance();
+      var military = f.military();
+      var staleAlliance = f.alliance();
+      var staleMilitary = f.military();
+      UUID operation = UUID.randomUUID();
+      var a = alliance.retireAlliances(operation, f.a);
+      var m = military.retireMilitaryAlliances(operation, f.a);
+      assertThat(a.clearedEntries()).isEqualTo(3);
+      assertThat(m.clearedEntries()).isEqualTo(3);
+      assertThat(f.alliance().retireAlliances(operation, f.a)).isEqualTo(a);
+      assertThat(f.military().retireMilitaryAlliances(operation, f.a)).isEqualTo(m);
+      assertThat(f.alliance().areAllied(f.b, f.c)).isTrue();
+      assertThat(f.military().hasMilitaryAlliance(f.b, f.c, PactType.INTEGRATED)).isTrue();
+      assertThatThrownBy(() -> alliance.retireAlliances(UUID.randomUUID(), f.a))
+          .isInstanceOf(IllegalArgumentException.class);
+      assertThatThrownBy(() -> military.retireMilitaryAlliances(UUID.randomUUID(), f.a))
+          .isInstanceOf(IllegalArgumentException.class);
+      assertThatThrownBy(() -> staleAlliance.sendInvite(f.a, f.c))
+          .isInstanceOf(AllianceStateConflictException.class);
+      assertThatThrownBy(() -> staleMilitary.sendPactInvite(f.a, f.c, PactType.OBSERVER))
+          .isInstanceOf(MilitaryAllianceStateConflictException.class);
+      assertThatThrownBy(() -> staleAlliance.sendInvite(f.a, f.c)).hasMessageContaining("retired");
+      assertThatThrownBy(() -> staleMilitary.sendPactInvite(f.a, f.c, PactType.OBSERVER))
+          .hasMessageContaining("retired");
+      var currentA = as.loadStateSnapshot();
+      var currentM = ms.loadState();
+      assertThatThrownBy(
+              () ->
+                  as.saveStateSync(
+                      new AllianceStorage.StateSnapshot(
+                          currentA.alliances(),
+                          currentA.invites(),
+                          currentA.cooldowns(),
+                          currentA.revision())))
+          .hasMessageContaining("immutable");
+      assertThatThrownBy(
+              () ->
+                  ms.saveStateSync(
+                      new MilitaryAllianceStorage.StateSnapshot(
+                          currentM.pacts(), currentM.invites(), currentM.cooldowns())))
+          .hasMessageContaining("immutable");
+      assertThatThrownBy(() -> as.saveInvitesSync(Map.of(new AllianceInviteKey(f.a, f.c), f.time)))
+          .hasMessageContaining("retired");
+      assertThatThrownBy(
+              () ->
+                  ms.saveInvitesDirectional(
+                      Map.of(
+                          new MilitaryPactInviteKey(f.a, f.c),
+                          new MilitaryAllianceStorage.PactInviteRecord(PactType.OBSERVER, f.time))))
+          .hasMessageContaining("retired");
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void emptyRetirementAndOrdinaryChangesPreserveReceipts(boolean sql) {
+    try (var f = new AllianceRetirementFixture(root, sql)) {
+      var a = f.alliance();
+      var m = f.military();
+      var operation = UUID.randomUUID();
+      assertThat(a.retireAlliances(operation, f.a).clearedEntries()).isZero();
+      assertThat(m.retireMilitaryAlliances(operation, f.a).clearedEntries()).isZero();
+      assertThat(a.sendInvite(f.b, f.c).success()).isTrue();
+      assertThat(m.sendPactInvite(f.b, f.c, PactType.DEFENSIVE).success()).isTrue();
+      assertThat(a.acceptInvite(f.c, f.b.toString()).success()).isTrue();
+      assertThat(m.acceptPactInvite(f.c, f.b.toString()).success()).isTrue();
+      assertThat(f.alliance().allianceRetirementReceipt(f.a)).isPresent();
+      assertThat(f.military().militaryAllianceRetirementReceipt(f.a)).isPresent();
+      a.shutdown();
+      m.shutdown();
+      assertThatThrownBy(() -> a.sendInvite(f.a, f.b)).hasMessageContaining("stopped");
+      assertThatThrownBy(() -> m.upgradePact(f.b, f.c, PactType.INTEGRATED))
+          .hasMessageContaining("stopped");
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void independentWritersCompeteWithoutOverwritingWinner(boolean sql) throws Exception {
+    try (var f = new AllianceRetirementFixture(root, sql)) {
+      var first = f.alliance();
+      var second = f.alliance();
+      UUID one = UUID.randomUUID(), two = UUID.randomUUID();
+      var gate = new CountDownLatch(1);
+      var pool = Executors.newFixedThreadPool(2);
+      try {
+        var r1 =
+            pool.submit(
+                () ->
+                    attempt(
+                        () -> {
+                          gate.await();
+                          return first.retireAlliances(one, f.a);
+                        }));
+        var r2 =
+            pool.submit(
+                () ->
+                    attempt(
+                        () -> {
+                          gate.await();
+                          return second.retireAlliances(two, f.a);
+                        }));
+        gate.countDown();
+        var results = List.of(r1.get(10, TimeUnit.SECONDS), r2.get(10, TimeUnit.SECONDS));
+        assertThat(results.stream().filter(RelationshipRetirementReceipt.class::isInstance))
+            .hasSize(1);
+        var stored = f.alliance().allianceRetirementReceipt(f.a).orElseThrow();
+        assertThat(stored.operationId()).isIn(one, two);
+        assertThat(results).contains(stored);
+      } finally {
+        pool.shutdownNow();
+      }
+    }
+  }
+
+  private static Object attempt(Callable<Object> work) throws Exception {
+    try {
+      return work.call();
+    } catch (RuntimeException error) {
+      return error;
+    }
+  }
+
+  @Test
+  void callbackReentryRejectedAndStopCannotFlushUncommittedAlliance() {
+    try (var f = new AllianceRetirementFixture(root, false)) {
+      var diplomacy = mock(DiplomacyRelationService.class);
+      var holder = new AtomicReference<AllianceServiceImpl>();
+      when(diplomacy.setRelation(f.b, f.c, DiplomacyRelation.ALLIED))
+          .thenAnswer(
+              call -> {
+                assertThatThrownBy(() -> holder.get().retireAlliances(UUID.randomUUID(), f.b))
+                    .hasMessageContaining("busy");
+                holder.get().shutdown();
+                return DiplomacyRelation.ALLIED;
+              });
+      var a = f.alliance(f.allianceStorage(), diplomacy);
+      holder.set(a);
+      assertThat(a.sendInvite(f.b, f.c).success()).isTrue();
+      assertThatThrownBy(() -> a.acceptInvite(f.c, f.b.toString()))
+          .hasMessageContaining("unavailable");
+      var restart = f.alliance();
+      assertThat(restart.areAllied(f.b, f.c)).isFalse();
+      assertThat(restart.hasPendingInvite(f.c)).isTrue();
+    }
+  }
+}
