+      assertThatThrownBy(() -> old.get().run()).hasMessageContaining("stopped");
+      assertThat(f.alliance().allianceRetirementReceipt(f.a)).isEmpty();
+      assertThat(f.military().militaryAllianceRetirementReceipt(f.a)).isEmpty();
+    }
+  }
