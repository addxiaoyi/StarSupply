+
+class AllianceRetirementLifecycleTest {
+  @TempDir Path root;
+
+  record ModuleFixture(
+      StarCoreModule module,
+      StarCoreContext context,
+      ServiceRegistry registry,
+      PluginManager manager) {}
+
+  ModuleFixture module(AllianceRetirementFixture f, boolean military) {
+    StarCoreModule module = military ? new MilitaryAllianceModule() : new AllianceModule();
+    var context = mock(StarCoreContext.class);
+    var registry = new ServiceRegistry();
+    var plugin = mock(JavaPlugin.class);
+    var server = mock(Server.class);
+    var manager = mock(PluginManager.class);
+    registry.register(NationService.class, f.nations);
+    registry.register(OnlinePlayerDirectory.class, mock(OnlinePlayerDirectory.class));
+    when(context.plugin()).thenReturn(plugin);
+    when(context.serviceRegistry()).thenReturn(registry);
+    when(context.persistenceService()).thenReturn(f.persistence);
+    when(context.databaseService()).thenReturn(f.database);
+    when(plugin.getServer()).thenReturn(server);
+    when(server.getPluginManager()).thenReturn(manager);
+    when(plugin.getLogger()).thenReturn(Logger.getAnonymousLogger());
+    return new ModuleFixture(module, context, registry, manager);
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void moduleRegistersRetirementStopsOldReferencesAndKeepsReplacement(boolean military) {
+    try (var f = new AllianceRetirementFixture(root, false);
+        var handlers = mockStatic(HandlerList.class)) {
+      var m = module(f, military);
+      m.module.enable(m.context);
+      var op = UUID.randomUUID();
+      if (military) {
+        var old = m.registry.require(MilitaryAllianceRetirementService.class);
+        old.retireMilitaryAlliances(op, f.a);
+        var replacement = mock(MilitaryAllianceRetirementService.class);
+        m.registry.register(MilitaryAllianceRetirementService.class, replacement);
+        m.module.disable(m.context);
+        assertThat(m.registry.require(MilitaryAllianceRetirementService.class))
+            .isSameAs(replacement);
+        assertThatThrownBy(() -> old.retireMilitaryAlliances(op, f.a))
+            .hasMessageContaining("stopped");
+        assertThat(m.registry.find(MilitaryAllianceService.class)).isEmpty();
+      } else {
+        var old = m.registry.require(AllianceRetirementService.class);
+        old.retireAlliances(op, f.a);
+        var replacement = mock(AllianceRetirementService.class);
+        m.registry.register(AllianceRetirementService.class, replacement);
+        m.module.disable(m.context);
+        assertThat(m.registry.require(AllianceRetirementService.class)).isSameAs(replacement);
+        assertThatThrownBy(() -> old.retireAlliances(op, f.a)).hasMessageContaining("stopped");
+        assertThat(m.registry.find(AllianceService.class)).isEmpty();
+      }
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void failedEnableRemovesRegistrationsAndOldServiceCannotWrite(boolean military) {
+    try (var f = new AllianceRetirementFixture(root, false);
+        var handlers = mockStatic(HandlerList.class)) {
+      var m = module(f, military);
+      var old = new AtomicReference<Runnable>();
+      doAnswer(
+              call -> {
+                if (military) {
+                  var service = m.registry.require(MilitaryAllianceRetirementService.class);
+                  old.set(() -> service.retireMilitaryAlliances(UUID.randomUUID(), f.a));
+                } else {
+                  var service = m.registry.require(AllianceRetirementService.class);
+                  old.set(() -> service.retireAlliances(UUID.randomUUID(), f.a));
+                }
+                throw new IllegalStateException("listener registration failed");
+              })
+          .when(m.manager)
+          .registerEvents(any(), any());
