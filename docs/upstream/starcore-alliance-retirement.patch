+package dev.starcore.starcore.module.nation;
+
+import static org.assertj.core.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+import dev.starcore.starcore.foundation.territory.TerritoryService;
+import dev.starcore.starcore.module.city.CityService;
+import dev.starcore.starcore.module.diplomacy.*;
+import dev.starcore.starcore.module.war.WarService;
+import java.nio.file.Path;
+import java.util.*;
+import org.junit.jupiter.api.io.TempDir;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+
+class NationDisbandAllianceRetirementTest {
+  @TempDir Path root;
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void laterWarFailureReplaysOriginalAllianceAndMilitaryReceipts(boolean sql) {
+    try (var f = new AllianceRetirementFixture(root, sql)) {
+      f.seedAlliance(f.allianceStorage());
+      f.seedMilitary(f.militaryStorage());
+      var alliance = f.alliance();
+      var military = f.military();
+      var war = mock(WarService.class);
+      doThrow(new IllegalStateException("war authority unavailable"))
+          .doNothing()
+          .when(war)
+          .clearNationWarState(f.a);
+      var operation = UUID.randomUUID();
+      var transaction =
+          new NationDisbandTransaction(
+              operation, List.of(f.a), Map.of(), List.of(), List.of(), List.of());
+      var land = mock(TerritoryService.class);
+      var diplomacy = mock(DiplomacyRelationService.class);
+      var city = mock(CityService.class);
+      assertThatThrownBy(
+              () ->
+                  NationDisbandRecovery.completeCommitted(
+                      transaction, land, diplomacy, null, alliance, military, war, city))
+          .hasMessage("war authority unavailable");
+      var a = alliance.allianceRetirementReceipt(f.a).orElseThrow();
+      var m = military.militaryAllianceRetirementReceipt(f.a).orElseThrow();
+      assertThat(a.operationId()).isEqualTo(operation);
+      assertThat(m.operationId()).isEqualTo(operation);
+      var restartedA = f.alliance();
+      var restartedM = f.military();
+      NationDisbandRecovery.completeCommitted(
+          transaction, land, diplomacy, null, restartedA, restartedM, war, city);
+      assertThat(restartedA.allianceRetirementReceipt(f.a)).contains(a);
+      assertThat(restartedM.militaryAllianceRetirementReceipt(f.a)).contains(m);
+      assertThatThrownBy(() -> restartedA.sendInvite(f.a, f.b)).hasMessageContaining("retired");
+      assertThatThrownBy(
+              () ->
+                  restartedM.sendPactInvite(
+                      f.a,
+                      f.b,
+                      dev.starcore.starcore.module.diplomacy.military.MilitaryAllianceService
+                          .PactType.OBSERVER))
+          .hasMessageContaining("retired");
+      verify(war, times(2)).clearNationWarState(f.a);
+    }
+  }
+}
