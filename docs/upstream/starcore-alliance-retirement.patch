+      var armed = new AtomicBoolean();
+      var store =
+          new AllianceStorage(f.database, f.persistence, LoggerFactory.getLogger(getClass())) {
+            @Override
+            public synchronized RelationshipRetirementReceipt retire(UUID op, NationId n) {
+              var result = super.retire(op, n);
+              if (armed.get()) {
+                failRead.set(true);
+                throw new IllegalStateException("response lost");
+              }
+              throw new IllegalStateException("response lost but readable");
+            }
+
+            @Override
+            public synchronized StateSnapshot loadStateSnapshot() {
+              if (failRead.get()) throw new IllegalStateException("readback unavailable");
+              return super.loadStateSnapshot();
+            }
+          };
+      f.seedAlliance(store);
+      var service = f.alliance(store, null);
+      var operation = UUID.randomUUID();
