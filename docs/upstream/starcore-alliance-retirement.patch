+package dev.starcore.starcore.module.diplomacy;
+
+import static org.assertj.core.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+import dev.starcore.starcore.module.diplomacy.alliance.*;
+import dev.starcore.starcore.module.diplomacy.alliance.AllianceInviteKey;
