+import org.bukkit.plugin.PluginManager;
+import org.bukkit.plugin.java.JavaPlugin;
+import org.bukkit.scheduler.BukkitScheduler;
+import org.bukkit.scheduler.BukkitTask;
+import org.junit.jupiter.api.Test;
+
+class SiegeModuleTreasuryLifecycleTest {
+  @Test
+  void managerStartsTreasuryBeforeConstructingSiegeAndCreationUsesItsAuthority() {
+    Fixture fixture = fixture();
+    ServiceRegistry registry = fixture.registry();
+    TreasuryService treasury = mock(TreasuryService.class);
+    List<String> enabled = new ArrayList<>();
+    when(fixture.scheduler().runTaskTimer(any(), any(Runnable.class), anyLong(), anyLong()))
+        .thenAnswer(
+            ignored -> {
+              enabled.add("siege");
+              assertThat(registry.require(TreasuryService.class)).isSameAs(treasury);
+              return fixture.updateTask();
+            });
+    when(fixture.scheduler().runTaskTimerAsynchronously(any(), any(Runnable.class), anyLong(), anyLong()))
+        .thenReturn(fixture.saveTask());
+    SiegeModule siege = new SiegeModule();
+    ModuleManager manager = new ModuleManager(Logger.getAnonymousLogger(), registry);
+    // Register the consumer first: only declared dependencies may determine startup ordering.
+    manager.register(siege);
+    manager.register(module("treasury", List.of("nation", "economy"), List.of(TreasuryService.class),
+        () -> { enabled.add("treasury"); registry.register(TreasuryService.class, treasury); }));
+    manager.register(module("nation", List.of(), List.of(), () -> {}));
+    manager.register(module("economy", List.of(), List.of(), () -> {}));
+
+    try (var ignored = mockStatic(HandlerList.class)) {
+      manager.enableAll(fixture.context());
+
+      assertThat(enabled).containsExactly("treasury", "siege");
+      assertThat(registry.require(SiegeService.class)).isSameAs(siege);
+      UUID nation = UUID.randomUUID();
+      BigDecimal cost = BigDecimal.valueOf(SiegeType.BATTERING_RAM.constructionCost() + 5 * 50);
+      when(treasury.balance(NationId.of(nation))).thenReturn(cost);
+      when(treasury.withdraw(NationId.of(nation), cost)).thenReturn(true);
+      assertThat(siege.createSiege(nation, SiegeType.BATTERING_RAM, 5, new Location(null, 0, 64, 0)))
+          .isNotNull();
+      verify(treasury).withdraw(NationId.of(nation), cost);
+
+      manager.disableAll(fixture.context());
+      verify(fixture.updateTask()).cancel();
+      verify(fixture.saveTask()).cancel();
+      assertThat(registry.find(SiegeService.class)).isEmpty();
+    }
+  }
+
+  @Test
+  void managerDoesNotConstructSiegeWhenTreasuryModuleIsMissing() {
+    Fixture fixture = fixture();
+    ModuleManager manager = new ModuleManager(Logger.getAnonymousLogger(), fixture.registry());
+    manager.register(new SiegeModule());
+    manager.register(module("nation", List.of(), List.of(), () -> {}));
+    manager.register(module("economy", List.of(), List.of(), () -> {}));
+
+    manager.enableAll(fixture.context());
+
+    assertThat(manager.descriptors()).filteredOn(descriptor -> descriptor.metadata().id().equals("siege"))
+        .singleElement().extracting(descriptor -> descriptor.status()).isEqualTo(ModuleStatus.FAILED);
+    assertThat(fixture.registry().find(SiegeService.class)).isEmpty();
+    verify(fixture.scheduler(), never()).runTaskTimer(any(), any(Runnable.class), anyLong(), anyLong());
+  }
+
+  @Test
+  void directEnableRequiresTreasuryBeforeCreatingPeriodicService() {
+    Fixture fixture = fixture();
+    assertThrows(IllegalStateException.class, () -> new SiegeModule().enable(fixture.context()));
+    verify(fixture.scheduler(), never()).runTaskTimer(any(), any(Runnable.class), anyLong(), anyLong());
+    verify(fixture.scheduler(), never()).runTaskTimerAsynchronously(any(), any(Runnable.class), anyLong(), anyLong());
+  }
+
+  private static StarCoreModule module(String id, List<String> dependencies, List<Class<?>> services,
+                                       Runnable enable) {
+    return new StarCoreModule() {
+      @Override public ModuleMetadata metadata() {
+        return new ModuleMetadata(id, id, ModuleLayer.MODULE, dependencies, services, "test prerequisite");
+      }
+      @Override public void enable(StarCoreContext context) { enable.run(); }
+    };
+  }
+
+  private static Fixture fixture() {
+    JavaPlugin plugin = mock(JavaPlugin.class);
+    Server server = mock(Server.class);
+    BukkitScheduler scheduler = mock(BukkitScheduler.class);
+    when(plugin.getServer()).thenReturn(server);
+    when(plugin.getConfig()).thenReturn(new YamlConfiguration());
+    when(plugin.getLogger()).thenReturn(Logger.getAnonymousLogger());
+    when(server.getScheduler()).thenReturn(scheduler);
+    when(server.getPluginManager()).thenReturn(mock(PluginManager.class));
+    ServiceRegistry registry = new ServiceRegistry();
+    registry.register(NationService.class, mock(NationService.class));
+    registry.register(MessageService.class, mock(MessageService.class));
+    StarCoreContext context = mock(StarCoreContext.class);
+    when(context.plugin()).thenReturn(plugin);
+    when(context.serviceRegistry()).thenReturn(registry);
+    return new Fixture(context, registry, scheduler, mock(BukkitTask.class), mock(BukkitTask.class));
+  }
+
+  private record Fixture(StarCoreContext context, ServiceRegistry registry, BukkitScheduler scheduler,
+                         BukkitTask updateTask, BukkitTask saveTask) {}
+}
