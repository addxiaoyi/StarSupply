+    persistence.start();
+    if (sql) {
+      var config = new HikariConfig();
+      config.setJdbcUrl("jdbc:sqlite:" + root.resolve("diplomacy.db"));
+      config.setMaximumPoolSize(4);
+      database = new HikariDataSource(config);
+    } else database = null;
+  }
+
+  DiplomacyStateStorage storage() {
+    return database == null
+        ? new PersistenceDiplomacyStateStorage("diplomacy", persistence)
+        : new SqlDiplomacyStateStorage(database, new Properties(), Logger.getAnonymousLogger());
+  }
+
+  public DiplomacyModule open() {
+    return open(new MergingDiplomacyStateStorage(storage()));
+  }
+
+  DiplomacyModule open(DiplomacyStateStorage storage) {
+    try {
+      var result = new DiplomacyModule();
+      field(result, "stateStorage", storage);
+      var load = DiplomacyModule.class.getDeclaredMethod("loadState");
+      load.setAccessible(true);
+      load.invoke(result);
+      result.setAllianceCooldown(java.time.Duration.ZERO);
+      return result;
+    } catch (Exception e) {
+      throw new IllegalStateException(e);
+    }
+  }
+
+  static void field(Object object, String name, Object value) throws Exception {
+    var f = object.getClass().getDeclaredField(name);
+    f.setAccessible(true);
+    f.set(object, value);
+  }
+
+  public void close() {
+    if (database != null) database.close();
+    persistence.stop();
+  }
+}
