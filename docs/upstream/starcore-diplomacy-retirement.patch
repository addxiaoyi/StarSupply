@@ -0,0 +1,175 @@
+package dev.starcore.starcore.module.diplomacy;
+
+import static org.assertj.core.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+import dev.starcore.starcore.core.database.DatabaseService;
+import dev.starcore.starcore.module.nation.model.NationId;
+import java.nio.file.*;
+import java.util.*;
+import java.util.concurrent.atomic.AtomicBoolean;
+import java.util.logging.Logger;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+
+class DiplomacyAuthorityStorageTest {
+  @TempDir Path root;
+
+  @Test
+  void fileMissingCorruptOrDuplicateAuthorityNeverUsesBackup() throws Exception {
+    try (var f = new DiplomacyRetirementTestFixture(root, false)) {
+      var nation = NationId.random();
+      f.open().retireDiplomacy(UUID.randomUUID(), nation);
+      var path = root.resolve("diplomacy/relations.properties");
+      var valid = Files.readAllBytes(path);
+      Files.write(path, new byte[0]);
+      assertThatThrownBy(() -> f.storage().load()).isInstanceOf(IllegalStateException.class);
+      Files.write(path, valid);
+      var established = f.storage();
+      established.load();
+      var missing = root.resolve("diplomacy/moved.properties");
+      Files.move(path, missing);
+      assertThatThrownBy(established::load).isInstanceOf(IllegalStateException.class);
+      Files.copy(missing, path.resolveSibling("relations.properties.bak"));
+      assertThatThrownBy(() -> f.storage().load()).isInstanceOf(IllegalStateException.class);
+      Files.write(path, valid);
+      Files.writeString(
+          path,
+          "\n" + DiplomacyAuthority.RETIRED + nation + "=" + UUID.randomUUID() + ":0\n",
+          StandardOpenOption.APPEND);
+      assertThatThrownBy(() -> f.storage().load()).isInstanceOf(IllegalStateException.class);
+      Files.write(path, valid);
+      assertThat(f.open().diplomacyRetirementReceipt(nation)).isPresent();
+    }
+  }
+
+  @Test
+  void sqliteMigrationPreservesReceiptAndPreventsFallback() throws Exception {
+    try (var f = new DiplomacyRetirementTestFixture(root, true)) {
+      var nation = NationId.random();
+      var file = new PersistenceDiplomacyStateStorage("diplomacy", f.persistence);
+      var module = f.open(new MergingDiplomacyStateStorage(file));
+      var receipt = module.retireDiplomacy(UUID.randomUUID(), nation);
+      var online = new AtomicBoolean(true);
+      var store =
+          new SqlDiplomacyStateStorage(
+              () -> online.get() ? Optional.of(f.database) : Optional.empty(),
+              () -> new PersistenceDiplomacyStateStorage("diplomacy", f.persistence).load(),
+              Logger.getAnonymousLogger());
+      assertThat(DiplomacyAuthority.receipts(store.load())).containsEntry(nation, receipt);
+      online.set(false);
+      assertThatThrownBy(store::load).isInstanceOf(IllegalStateException.class);
+      online.set(true);
+      assertThat(DiplomacyAuthority.receipts(store.load())).containsEntry(nation, receipt);
+      try (var c = f.database.getConnection();
+          var s = c.createStatement()) {
+        s.executeUpdate(
+            "DELETE FROM starcore_diplomacy_state WHERE property_key <> '__starcore_revision__'");
+      }
+      assertThatThrownBy(store::load).isInstanceOf(IllegalStateException.class);
+      assertThatThrownBy(() -> f.storage().load()).isInstanceOf(IllegalStateException.class);
+    }
+  }
+
+  @Test
+  void sqliteFailureRollsBackRetirementAndRetryUsesOriginalNumber() throws Exception {
+    try (var f = new DiplomacyRetirementTestFixture(root, true)) {
+      var module = f.open();
+      var nation = NationId.random();
+      var other = NationId.random();
+      module.setRelation(nation, other, DiplomacyRelation.ALLIED);
+      var operation = UUID.randomUUID();
+      try (var c = f.database.getConnection();
+          var s = c.createStatement()) {
+        s.execute(
+            "CREATE TRIGGER reject_retirement BEFORE INSERT ON starcore_diplomacy_state WHEN"
+                + " NEW.property_key LIKE 'diplomacyRetired.%' BEGIN SELECT RAISE(ABORT, 'injected"
+                + " retirement write failure'); END");
+      }
+      assertThatThrownBy(() -> module.retireDiplomacy(operation, nation))
+          .isInstanceOf(IllegalStateException.class);
+      assertThat(f.open().relationsOf(nation)).hasSize(1);
+      assertThat(f.open().diplomacyRetirementReceipt(nation)).isEmpty();
+      try (var c = f.database.getConnection();
+          var s = c.createStatement()) {
+        s.execute("DROP TRIGGER reject_retirement");
+      }
+      var receipt = module.retireDiplomacy(operation, nation);
+      assertThat(receipt.clearedEntries()).isEqualTo(2);
+      assertThat(f.open().retireDiplomacy(operation, nation)).isEqualTo(receipt);
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void damagedChecksumAndTruncatedRowsRejectLoading(boolean sql) throws Exception {
+    try (var f = new DiplomacyRetirementTestFixture(root, sql)) {
+      var nation = NationId.random();
+      f.open().retireDiplomacy(UUID.randomUUID(), nation);
+      if (sql) {
+        try (var c = f.database.getConnection();
+            var s = c.createStatement()) {
+          s.executeUpdate(
+              "UPDATE starcore_diplomacy_state SET property_value='bad' WHERE"
+                  + " property_key='diplomacyAuthority.sha256'");
+        }
+      } else {
+        var p = root.resolve("diplomacy/relations.properties");
+        String text = Files.readString(p, java.nio.charset.StandardCharsets.ISO_8859_1);
+        Files.writeString(
+            p,
+            text.replaceFirst(
+                "diplomacyAuthority.sha256=[^\\r\\n]*", "diplomacyAuthority.sha256=bad"),
+            java.nio.charset.StandardCharsets.ISO_8859_1);
+      }
+      assertThatThrownBy(() -> f.storage().load()).isInstanceOf(IllegalStateException.class);
+    }
+  }
+
+  @Test
+  void truncatedUnknownAndInvalidEndpointFamiliesAreRejected() {
+    var a = NationId.random();
+    var b = NationId.random();
+    var valid =
+        DiplomacyStateCodec.toProperties(
+            Map.of(DiplomacyPairKey.of(a, b), DiplomacyRelation.ALLIED));
+    for (String key : List.of("relation.0.left", "relation.0.right", "relation.0.relation")) {
+      var bad = DiplomacyAuthority.copy(valid);
+      bad.remove(key);
+      assertThatThrownBy(() -> DiplomacyAuthority.seal(bad)).isInstanceOf(RuntimeException.class);
+    }
+    var bad = DiplomacyAuthority.copy(valid);
+    bad.setProperty("relation.1.left", a.toString());
+    assertThatThrownBy(() -> DiplomacyAuthority.seal(bad))
+        .isInstanceOf(IllegalArgumentException.class);
+    var receipt = new DiplomacyRetirementService.RetirementReceipt(UUID.randomUUID(), a, 0);
+    assertThatThrownBy(
+            () -> new DiplomacyRetirementService.RetirementReceipt(receipt.operationId(), a, -1))
+        .isInstanceOf(IllegalArgumentException.class);
+  }
+
+  @Test
+  void backendDoesNotSwitchAfterFileAuthorityWasChosen() {
+    try (var f = new DiplomacyRetirementTestFixture(root, true)) {
+      var database = mock(DatabaseService.class);
+      when(database.isRunning()).thenReturn(false);
+      when(database.dataSource()).thenReturn(Optional.of(f.database));
+      var store =
+          new DatabaseAwareDiplomacyStateStorage(
+              "diplomacy", database, f.persistence, Logger.getAnonymousLogger());
+      var module = f.open(store);
+      var nation = NationId.random();
+      var operation = UUID.randomUUID();
+      var receipt = module.retireDiplomacy(operation, nation);
+      when(database.isRunning()).thenReturn(true);
+      assertThat(module.retireDiplomacy(operation, nation)).isEqualTo(receipt);
+      assertThat(
+              DiplomacyAuthority.receipts(
+                  new PersistenceDiplomacyStateStorage("diplomacy", f.persistence).load()))
+          .containsEntry(nation, receipt);
+      assertThat(f.storage().load()).isEmpty();
+    }
+  }
+}
