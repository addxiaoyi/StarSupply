+class DiplomacyRetirementTest {
+  @TempDir Path root;
+  final NationId retired = NationId.random(), other = NationId.random(), kept = NationId.random();
+  final UUID operation = UUID.randomUUID();
+
+  Properties seed() {
+    var now = Instant.now();
+    var value =
+        DiplomacyCombinedStateCodec.toProperties(
+            Map.of(
+                DiplomacyPairKey.of(retired, other),
+                DiplomacyRelation.ALLIED,
+                DiplomacyPairKey.of(other, kept),
+                DiplomacyRelation.FRIENDLY),
+            Map.of(
+                DiplomacyPairKey.of(retired, other),
+                new WarRecord(retired, other, now),
+                DiplomacyPairKey.of(other, kept),
+                new WarRecord(other, kept, now)),
+            Map.of(DiplomacyPairKey.of(retired, other), now, DiplomacyPairKey.of(other, kept), now),
+            Map.of(
+                new AllianceInvitationKey(retired, other),
+                now,
+                new AllianceInvitationKey(other, kept),
+                now));
+    value.putAll(
+        DiplomacyInteractionCodec.toProperties(
+            Map.of(DiplomacyPairKey.of(retired, other), now, DiplomacyPairKey.of(other, kept), now),
+            Map.of(
+                new AllianceInviteKey(other, retired),
+                now,
+                new AllianceInviteKey(other, kept),
+                now),
+            Map.of(
+                DiplomacyPairKey.of(retired, other),
+                retired,
+                DiplomacyPairKey.of(other, kept),
+                other)));
+    value.setProperty("unrelated.metadata", "keep me");
+    return value;
+  }
+
+  void seed(DiplomacyRetirementTestFixture f) {
+    var s = f.storage();
+    s.load();
+    s.save(seed());
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void retirementSurvivesRestartPreservesOtherStateAndReturnsOriginalResult(boolean sql) {
+    try (var f = new DiplomacyRetirementTestFixture(root, sql)) {
+      seed(f);
+      var module = f.open();
+      var receipt = module.retireDiplomacy(operation, retired);
+      assertThat(receipt.clearedEntries()).isEqualTo(7);
+      assertThat(module.relationsOf(retired)).isEmpty();
+      assertThat(module.activeWarsOf(retired)).isEmpty();
+      var restart = f.open();
+      assertThat(restart.retireDiplomacy(operation, retired)).isEqualTo(receipt);
+      assertThat(restart.diplomacyRetirementReceipt(retired)).contains(receipt);
+      assertThatThrownBy(() -> restart.retireDiplomacy(UUID.randomUUID(), retired))
+          .isInstanceOf(IllegalArgumentException.class);
+      restart.setRelation(other, kept, DiplomacyRelation.FRIENDLY);
+      var persisted = f.storage().load();
+      assertThat(persisted).containsEntry("unrelated.metadata", "keep me");
+      assertThat(DiplomacyInteractionCodec.fromProperties(persisted).invitations())
+          .containsOnlyKeys(new AllianceInviteKey(other, kept));
+      assertThat(DiplomacyInteractionCodec.fromProperties(persisted).warEndRequests())
+          .containsOnlyKeys(DiplomacyPairKey.of(other, kept));
+      assertThat(f.open().retireDiplomacy(operation, retired)).isEqualTo(receipt);
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void staleWriterCannotResurrectAfterRefreshOrOrdinarySave(boolean sql) {
+    try (var f = new DiplomacyRetirementTestFixture(root, sql)) {
+      seed(f);
+      var winner = f.open();
+      var stale = f.open();
+      winner.retireDiplomacy(operation, retired);
+      assertThatThrownBy(() -> stale.setRelation(retired, other, DiplomacyRelation.FRIENDLY))
+          .isInstanceOf(DiplomacyStateConflictException.class);
+      assertThat(stale.relationsOf(retired)).isEmpty();
+      for (Runnable action :
+          List.<Runnable>of(
+              () -> stale.setRelation(retired, other, DiplomacyRelation.FRIENDLY),
+              () -> stale.sendInvite(retired, other),
+              () -> stale.acceptInvite(retired, other),
+              () -> stale.recordWarDeclaration(other, retired, Instant.now()),
+              () -> stale.declareWar(retired, other)))
+        assertThatThrownBy(action::run)
+            .isInstanceOf(IllegalStateException.class)
+            .hasMessageContaining("retired");
+      stale.setRelation(other, kept, DiplomacyRelation.FRIENDLY);
+      assertThat(f.open().diplomacyRetirementReceipt(retired)).isPresent();
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void storageRejectsReceiptDeletionChangeAndResurrectionEvenAfterFreshLoad(boolean sql) {
+    try (var f = new DiplomacyRetirementTestFixture(root, sql)) {
+      seed(f);
+      f.open().retireDiplomacy(operation, retired);
+      var store = f.storage();
+      var saved = store.load();
+      var removed = DiplomacyAuthority.copy(saved);
+      removed.remove(DiplomacyAuthority.RETIRED + retired);
+      assertThatThrownBy(() -> store.save(DiplomacyAuthority.seal(removed)))
+          .isInstanceOf(RuntimeException.class);
+      store.load();
+      var changed = DiplomacyAuthority.copy(saved);
+      changed.setProperty(DiplomacyAuthority.RETIRED + retired, UUID.randomUUID() + ":7");
+      assertThatThrownBy(() -> store.save(DiplomacyAuthority.seal(changed)))
+          .isInstanceOf(RuntimeException.class);
+      store.load();
+      var resurrected = seed();
+      saved.stringPropertyNames().stream()
+          .filter(k -> k.startsWith(DiplomacyAuthority.RETIRED))
+          .forEach(k -> resurrected.setProperty(k, saved.getProperty(k)));
+      assertThatThrownBy(() -> store.save(resurrected)).isInstanceOf(RuntimeException.class);
+      assertThat(f.open().diplomacyRetirementReceipt(retired).orElseThrow().operationId())
+          .isEqualTo(operation);
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void shrinkingTemporalFamiliesDoesNotLeaveOldEntriesAndLegacyClearDoesNotRetire(boolean sql) {
+    try (var f = new DiplomacyRetirementTestFixture(root, sql)) {
+      var module = f.open();
+      module.sendInvite(retired, other);
+      module.sendInvite(retired, kept);
+      module.cancelInvite(retired, other);
+      assertThat(f.storage().load())
+          .containsEntry("alliance-invite.count", "1")
+          .doesNotContainKey("alliance-invite.1.inviter");
+      module.clearNationRelations(retired);
+      assertThat(f.open().getPendingInvites(kept)).isEmpty();
+      assertThat(module.diplomacyRetirementReceipt(retired)).isEmpty();
+      assertThat(module.sendInvite(retired, other).success()).isTrue();
+    }
+  }
+
+  static final class FaultStorage implements DiplomacyStateStorage {
+    final DiplomacyStateStorage delegate;
+    String mode = "";
+    boolean unreadable;
+    Runnable during = () -> {};
+
+    FaultStorage(DiplomacyStateStorage delegate) {
+      this.delegate = delegate;
+    }
+
+    public Properties load() {
+      if (unreadable) throw new IllegalStateException("read unavailable");
+      return delegate.load();
+    }
+
+    public void save(Properties value) {
+      during.run();
+      if (mode.equals("before")) throw new IllegalStateException("before commit");
+      delegate.save(value);
+      if (mode.equals("unknown")) unreadable = true;
+      if (mode.equals("after") || mode.equals("unknown"))
+        throw new IllegalStateException("lost response");
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void interruptedRetirementRetainsOriginalNumberAndNeverRepeatsCleanup(boolean sql) {
+    try (var f = new DiplomacyRetirementTestFixture(root, sql)) {
+      seed(f);
+      var faults = new FaultStorage(new MergingDiplomacyStateStorage(f.storage()));
+      var module = f.open(faults);
+      faults.mode = "before";
+      assertThatThrownBy(() -> module.retireDiplomacy(operation, retired))
+          .hasMessage("before commit");
+      assertThat(module.relationsOf(retired)).hasSize(1);
+      faults.mode = "after";
+      var receipt = module.retireDiplomacy(operation, retired);
+      assertThat(receipt.clearedEntries()).isEqualTo(7);
+      faults.mode = "";
+      assertThat(module.retireDiplomacy(operation, retired)).isEqualTo(receipt);
+      assertThat(f.open().retireDiplomacy(operation, retired)).isEqualTo(receipt);
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void unknownCommitAndReadbackFailureRequireReloadWithOriginalRequest(boolean sql) {
+    try (var f = new DiplomacyRetirementTestFixture(root, sql)) {
+      seed(f);
+      var faults = new FaultStorage(new MergingDiplomacyStateStorage(f.storage()));
+      var module = f.open(faults);
+      faults.mode = "unknown";
+      assertThatThrownBy(() -> module.retireDiplomacy(operation, retired))
+          .hasMessage("lost response");
+      faults.mode = "";
+      faults.unreadable = false;
+      assertThatThrownBy(() -> module.setRelation(other, kept, DiplomacyRelation.FRIENDLY))
+          .hasMessageContaining("unavailable");
+      assertThat(f.open().retireDiplomacy(operation, retired).clearedEntries()).isEqualTo(7);
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void independentInstancesCompetingForSameRetirementPreserveSingleReceipt(boolean sql)
+      throws Exception {
+    try (var f = new DiplomacyRetirementTestFixture(root, sql);
+        var pool = Executors.newFixedThreadPool(2)) {
+      seed(f);
+      var barrier = new CyclicBarrier(2);
+      var a = new FaultStorage(new MergingDiplomacyStateStorage(f.storage()));
+      var b = new FaultStorage(new MergingDiplomacyStateStorage(f.storage()));
+      Runnable wait =
+          () -> {
+            try {
+              barrier.await(5, TimeUnit.SECONDS);
+            } catch (Exception e) {
+              throw new IllegalStateException(e);
+            }
+          };
+      var first = f.open(a);
+      var second = f.open(b);
+      a.during = wait;
+      b.during = wait;
+      var one = pool.submit(() -> attempt(first));
+      var two = pool.submit(() -> attempt(second));
+      assertThat(List.of(one.get(10, TimeUnit.SECONDS), two.get(10, TimeUnit.SECONDS)))
+          .contains(true);
+      a.during = () -> {};
+      b.during = () -> {};
+      assertThat(first.retireDiplomacy(operation, retired))
+          .isEqualTo(second.retireDiplomacy(operation, retired));
+      assertThat(f.open().retireDiplomacy(operation, retired).clearedEntries()).isEqualTo(7);
+    }
+  }
+
+  boolean attempt(DiplomacyModule module) {
+    try {
+      module.retireDiplomacy(operation, retired);
+      return true;
+    } catch (RuntimeException conflict) {
+      return false;
+    }
+  }
+
+  @Test
+  void callbackCannotReenterRetirementAndStoppedReferencesCannotMutate() throws Exception {
