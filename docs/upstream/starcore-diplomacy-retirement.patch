+import org.bukkit.plugin.PluginManager;
+import org.bukkit.plugin.java.JavaPlugin;
+import org.junit.jupiter.api.Test;
+
+class DiplomacyRetirementLifecycleTest {
+  record Fixture(
+      DiplomacyModule module,
+      StarCoreContext context,
+      ServiceRegistry registry,
+      PluginManager manager) {}
+
+  Fixture fixture() {
+    var module = new DiplomacyModule();
+    var context = mock(StarCoreContext.class);
+    var registry = new ServiceRegistry();
+    registry.register(NationService.class, mock(NationService.class));
+    var plugin = mock(JavaPlugin.class);
+    var server = mock(Server.class);
+    var manager = mock(PluginManager.class);
+    var persistence = mock(PersistenceService.class);
+    when(context.plugin()).thenReturn(plugin);
+    when(context.serviceRegistry()).thenReturn(registry);
+    when(context.persistenceService()).thenReturn(persistence);
+    when(plugin.getServer()).thenReturn(server);
+    when(server.getPluginManager()).thenReturn(manager);
+    when(plugin.getConfig()).thenReturn(new YamlConfiguration());
+    when(plugin.getLogger()).thenReturn(Logger.getAnonymousLogger());
+    when(persistence.ensureNamespace(anyString()))
+        .thenReturn(CompletableFuture.completedFuture(null));
+    return new Fixture(module, context, registry, manager);
+  }
+
+  @Test
+  void startupLoadsRetirementAndRegistersServiceThenStopsOldReferences() {
+    var f = fixture();
+    var nation = NationId.random();
+    var op = UUID.randomUUID();
+    var state = DiplomacyAuthority.retire(new Properties(), op, nation);
+    try (var storage =
+            mockConstruction(
+                DatabaseAwareDiplomacyStateStorage.class,
+                (mock, c) -> when(mock.load()).thenReturn(state));
+        var menus = mockConstruction(DiplomacyMenu.class);
+        var handlers = mockStatic(HandlerList.class)) {
+      f.module.enable(f.context);
+      assertThat(f.registry.require(DiplomacyRetirementService.class)).isSameAs(f.module);
+      assertThat(f.module.diplomacyRetirementReceipt(nation).orElseThrow().operationId())
+          .isEqualTo(op);
+      assertThatThrownBy(() -> f.module.sendInvite(nation, NationId.random()))
+          .hasMessageContaining("retired");
+      f.module.disable(f.context);
+      assertThat(f.registry.snapshot()).containsOnlyKeys(NationService.class);
+      verify(menus.constructed().getFirst()).shutdown();
+      assertThatThrownBy(() -> f.module.retireDiplomacy(op, nation))
+          .hasMessageContaining("stopped");
+    }
+  }
+
+  @Test
+  void partialEnableFailureUnregistersAndDoesNotFlushUncommittedState() {
+    var f = fixture();
+    doThrow(new IllegalStateException("listener registration failed"))
+        .when(f.manager)
+        .registerEvents(any(), any());
+    try (var storage =
+            mockConstruction(
+                DatabaseAwareDiplomacyStateStorage.class,
+                (mock, c) -> when(mock.load()).thenReturn(new Properties()));
+        var menus = mockConstruction(DiplomacyMenu.class);
+        var handlers = mockStatic(HandlerList.class)) {
+      assertThatThrownBy(() -> f.module.enable(f.context))
+          .hasMessage("listener registration failed");
+      assertThat(f.registry.snapshot()).containsOnlyKeys(NationService.class);
+      verify(storage.constructed().getFirst(), never()).save(any());
+      verify(menus.constructed().getFirst()).shutdown();
+      assertThatThrownBy(() -> f.module.sendInvite(NationId.random(), NationId.random()))
+          .hasMessageContaining("stopped");
+    }
+  }
+
+  @Test
+  void menuShutdownFailureStillUnregistersModuleAndPreservesReplacementService() {
+    var f = fixture();
+    try (var storage =
+            mockConstruction(
+                DatabaseAwareDiplomacyStateStorage.class,
+                (mock, c) -> when(mock.load()).thenReturn(new Properties()));
+        var menus = mockConstruction(DiplomacyMenu.class);
+        var handlers = mockStatic(HandlerList.class)) {
+      f.module.enable(f.context);
+      var replacement = mock(DiplomacyRetirementService.class);
+      f.registry.register(DiplomacyRetirementService.class, replacement);
+      doThrow(new IllegalStateException("menu cleanup failed"))
+          .when(menus.constructed().getFirst())
+          .shutdown();
+      assertThatThrownBy(() -> f.module.disable(f.context)).hasMessage("menu cleanup failed");
+      assertThat(f.registry.snapshot())
+          .containsOnlyKeys(NationService.class, DiplomacyRetirementService.class);
+      assertThat(f.registry.require(DiplomacyRetirementService.class)).isSameAs(replacement);
+    }
+  }
+}
