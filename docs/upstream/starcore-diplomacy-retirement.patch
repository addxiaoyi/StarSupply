index 0000000..5eb61b3
--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/module/diplomacy/DiplomacyAuthority.java
@@ -0,0 +1,246 @@
+package dev.starcore.starcore.module.diplomacy;
+
+import dev.starcore.starcore.module.nation.model.NationId;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.util.*;
+
+/** Complete persisted state, including legacy interaction families and permanent receipts. */
+final class DiplomacyAuthority {
+  static final String VERSION = "diplomacyAuthority.version";
+  static final String HASH = "diplomacyAuthority.sha256";
+  static final String RETIRED = "diplomacyRetired.";
+
+  record Family(String count, String prefix, List<String> endpoints, List<String> fields) {}
+
+  static final List<Family> FAMILIES =
+      List.of(
+          new Family(
+              "count", "relation.", List.of("left", "right"), List.of("left", "right", "relation")),
+          new Family(
+              "warCount",
+              "war.",
+              List.of("declarer", "target"),
+              List.of("declarer", "target", "declaredAt")),
+          new Family(
+              "relation-time.count",
+              "relation-time.",
+              List.of("left", "right"),
+              List.of("left", "right", "at")),
+          new Family(
+              "alliance-invite.count",
+              "alliance-invite.",
+              List.of("inviter", "invited"),
+              List.of("inviter", "invited", "at")),
+          new Family(
+              "timestampCount",
+              "timestamp.",
+              List.of("left", "right"),
+              List.of("left", "right", "changedAt")),
+          new Family(
+              "inviteCount",
+              "invite.",
+              List.of("inviter", "invited"),
+              List.of("inviter", "invited", "createdAt")),
+          new Family(
+              "warEndRequestCount",
+              "warEndRequest.",
+              List.of("left", "right"),
+              List.of("left", "right", "requester")));
+
+  private DiplomacyAuthority() {}
+
+  static Properties copy(Properties value) {
+    var result = new Properties();
+    result.putAll(Objects.requireNonNull(value));
+    return result;
+  }
+
+  static String checksum(Properties value) {
+    try {
+      var digest = MessageDigest.getInstance("SHA-256");
+      for (String key : new TreeSet<>(value.stringPropertyNames())) {
+        if (key.equals(HASH)) continue;
+        for (String part : List.of(key, value.getProperty(key))) {
+          byte[] bytes = part.getBytes(StandardCharsets.UTF_8);
+          digest.update(java.nio.ByteBuffer.allocate(4).putInt(bytes.length).array());
+          digest.update(bytes);
+        }
+      }
+      return HexFormat.of().formatHex(digest.digest());
+    } catch (java.security.NoSuchAlgorithmException failure) {
+      throw new IllegalStateException(failure);
+    }
+  }
+
+  static Properties seal(Properties value) {
+    var result = copy(value);
+    result.setProperty(VERSION, "1");
+    result.setProperty(HASH, checksum(result));
+    validate(result);
+    return result;
+  }
+
+  static void validate(Properties value) {
+    if (value.size() != value.stringPropertyNames().size())
+      throw new IllegalArgumentException("Non-text diplomacy property");
+    boolean envelope =
+        value.containsKey(VERSION)
+            || value.containsKey(HASH)
+            || value.stringPropertyNames().stream().anyMatch(k -> k.startsWith(RETIRED));
+    if (envelope
+        && (!"1".equals(value.getProperty(VERSION))
+            || !checksum(value).equals(value.getProperty(HASH))))
+      throw new IllegalArgumentException("Diplomacy authority checksum/version mismatch");
+    var retired = receipts(value);
+    for (var family : FAMILIES) {
+      var entries = entries(value, family);
+      var pairs = new HashSet<List<String>>();
+      for (var entry : entries) {
+        var ids =
+            family.endpoints().stream()
+                .map(f -> NationId.of(UUID.fromString(required(entry, f))))
+                .toList();
+        if (ids.get(0).equals(ids.get(1)) || ids.stream().anyMatch(retired::containsKey))
+          throw new IllegalArgumentException("Retired or invalid diplomacy endpoint");
+        List<String> pair = ids.stream().map(NationId::toString).toList();
+        if (!family.prefix().contains("invite")) pair = pair.stream().sorted().toList();
+        if (!pairs.add(pair)) throw new IllegalArgumentException("Duplicate diplomacy entry");
+        for (String field : family.fields()) required(entry, field);
+        if (family.prefix().equals("relation."))
+          DiplomacyRelation.valueOf(entry.getProperty("relation"));
+        if (entry.containsKey("declaredAt"))
+          java.time.Instant.ofEpochMilli(Long.parseLong(entry.getProperty("declaredAt")));
+        for (String field : List.of("at", "changedAt", "createdAt"))
+          if (entry.containsKey(field)) java.time.Instant.parse(entry.getProperty(field));
+        for (String field : List.of("attacker", "requester"))
+          if (entry.containsKey(field)
+              && !ids.contains(NationId.of(UUID.fromString(entry.getProperty(field)))))
+            throw new IllegalArgumentException("Diplomacy participant is not an endpoint");
+      }
+    }
+  }
+
+  private static String required(Properties entry, String field) {
+    return Objects.requireNonNull(entry.getProperty(field), "Missing diplomacy field " + field);
+  }
+
+  private static List<Properties> entries(Properties value, Family family) {
+    int count = Integer.parseInt(value.getProperty(family.count(), "0"));
+    if (count < 0 || count > 1_000_000)
+      throw new IllegalArgumentException("Invalid diplomacy count");
+    var entries = new ArrayList<Properties>(count);
+    for (int i = 0; i < count; i++) entries.add(new Properties());
+    for (String key : value.stringPropertyNames())
+      if (key.startsWith(family.prefix()) && !key.equals(family.count())) {
+        String suffix = key.substring(family.prefix().length());
+        int dot = suffix.indexOf('.');
+        if (dot < 1) throw new IllegalArgumentException("Invalid diplomacy entry key");
+        int index = Integer.parseInt(suffix.substring(0, dot));
+        if (index < 0
+            || index >= count
+            || !Integer.toString(index).equals(suffix.substring(0, dot)))
+          throw new IllegalArgumentException("Diplomacy entry outside declared count");
+        entries.get(index).setProperty(suffix.substring(dot + 1), value.getProperty(key));
+      }
+    return entries;
+  }
+
+  static Map<NationId, DiplomacyRetirementService.RetirementReceipt> receipts(Properties value) {
+    var result = new HashMap<NationId, DiplomacyRetirementService.RetirementReceipt>();
+    for (String key : value.stringPropertyNames())
+      if (key.startsWith(RETIRED)) {
+        String suffix = key.substring(RETIRED.length());
+        var nation = NationId.of(UUID.fromString(suffix));
+        if (!nation.toString().equals(suffix))
+          throw new IllegalArgumentException("Invalid retirement nation");
+        String[] fields = value.getProperty(key).split(":", -1);
+        if (fields.length != 2) throw new IllegalArgumentException("Invalid retirement receipt");
+        var receipt =
+            new DiplomacyRetirementService.RetirementReceipt(
+                UUID.fromString(fields[0]), nation, Integer.parseInt(fields[1]));
+        if (!encode(receipt).equals(value.getProperty(key)))
+          throw new IllegalArgumentException("Invalid retirement receipt encoding");
+        result.put(nation, receipt);
+      }
+    return Map.copyOf(result);
+  }
+
+  private static String encode(DiplomacyRetirementService.RetirementReceipt r) {
+    return r.operationId() + ":" + r.clearedEntries();
+  }
+
+  static Properties merge(Properties previous, Properties update) {
+    validate(previous);
+    var result = copy(previous);
+    for (var family : FAMILIES)
+      if (update.containsKey(family.count())) removeFamily(result, family);
+    result.putAll(update);
+    result = seal(result);
+    transition(previous, result);
+    return result;
+  }
+
+  private static void removeFamily(Properties value, Family family) {
+    value.remove(family.count());
+    value.keySet().removeIf(k -> k instanceof String s && s.startsWith(family.prefix()));
+  }
+
+  static void transition(Properties previous, Properties next) {
+    validate(previous);
+    validate(next);
+    var after = receipts(next);
+    receipts(previous)
+        .forEach(
+            (nation, receipt) -> {
+              if (!receipt.equals(after.get(nation)))
+                throw new IllegalArgumentException("Diplomacy retirement receipts are immutable");
+            });
+    if (previous.containsKey(VERSION) && !next.containsKey(VERSION))
+      throw new IllegalArgumentException("Diplomacy authority downgrade");
+  }
+
+  static Properties clear(Properties previous, NationId nation) {
+    validate(previous);
+    var result = copy(previous);
+    for (var family : FAMILIES) {
+      var entries = entries(previous, family);
+      if (!previous.containsKey(family.count())) continue;
+      var keep =
+          entries.stream()
+              .filter(
+                  e ->
+                      family.endpoints().stream()
+                          .noneMatch(
+                              f -> nation.equals(NationId.of(UUID.fromString(e.getProperty(f))))))
+              .toList();
+      removeFamily(result, family);
+      result.setProperty(family.count(), Integer.toString(keep.size()));
+      for (int i = 0; i < keep.size(); i++)
+        for (String field : keep.get(i).stringPropertyNames())
+          result.setProperty(family.prefix() + i + "." + field, keep.get(i).getProperty(field));
+    }
+    return seal(result);
+  }
+
+  static Properties retire(Properties previous, UUID operation, NationId nation) {
+    Objects.requireNonNull(operation);
+    Objects.requireNonNull(nation);
+    validate(previous);
+    var existing = receipts(previous).get(nation);
+    if (existing != null) {
+      if (!existing.operationId().equals(operation))
+        throw new IllegalArgumentException("Conflicting diplomacy retirement operation");
+      return copy(previous);
+    }
+    var result = clear(previous, nation);
+    int removed = 0;
+    for (var family : FAMILIES)
+      removed +=
+          Integer.parseInt(previous.getProperty(family.count(), "0"))
+              - Integer.parseInt(result.getProperty(family.count(), "0"));
+    var receipt = new DiplomacyRetirementService.RetirementReceipt(operation, nation, removed);
+    result.setProperty(RETIRED + nation, encode(receipt));
+    return seal(result);
+  }
+}
