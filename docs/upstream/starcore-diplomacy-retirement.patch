+package dev.starcore.starcore.module.nation;
+
+import static org.assertj.core.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+import dev.starcore.starcore.foundation.territory.TerritoryService;
+import dev.starcore.starcore.module.city.CityService;
+import dev.starcore.starcore.module.diplomacy.*;
+import dev.starcore.starcore.module.diplomacy.alliance.AllianceService;
+import dev.starcore.starcore.module.diplomacy.military.MilitaryAllianceService;
+import dev.starcore.starcore.module.nation.model.NationId;
+import dev.starcore.starcore.module.war.WarService;
+import java.nio.file.Path;
+import java.util.*;
+import org.junit.jupiter.api.io.TempDir;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+
+class NationDisbandDiplomacyTest {
+  @TempDir Path root;
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void failureAfterDiplomacyRetirementResumesOriginalReceiptAndRejectsLateWrites(boolean sql) {
+    try (var f = new DiplomacyRetirementTestFixture(root, sql)) {
+      var nation = NationId.random();
+      var other = NationId.random();
+      var operation = UUID.randomUUID();
+      var diplomacy = f.open();
+      diplomacy.setRelation(nation, other, DiplomacyRelation.ALLIED);
+      var alliance = mock(AllianceService.class);
+      doThrow(new IllegalStateException("alliance unavailable"))
+          .doNothing()
+          .when(alliance)
+          .clearNationRelations(nation);
+      var land = mock(TerritoryService.class);
+      var military = mock(MilitaryAllianceService.class);
+      var war = mock(WarService.class);
+      var cities = mock(CityService.class);
+      var transaction =
+          new NationDisbandTransaction(
+              operation, List.of(nation), Map.of(), List.of(), List.of(), List.of());
+      assertThatThrownBy(
+              () ->
+                  NationDisbandRecovery.completeCommitted(
+                      transaction, land, diplomacy, null, alliance, military, war, cities))
+          .hasMessage("alliance unavailable");
+      var receipt = diplomacy.diplomacyRetirementReceipt(nation).orElseThrow();
+      assertThat(receipt.operationId()).isEqualTo(operation);
+      assertThat(receipt.clearedEntries()).isEqualTo(2);
+      assertThatThrownBy(() -> diplomacy.sendInvite(nation, other)).hasMessageContaining("retired");
+      var restart = f.open();
+      NationDisbandRecovery.completeCommitted(
+          transaction, land, restart, null, alliance, military, war, cities);
+      assertThat(restart.diplomacyRetirementReceipt(nation)).contains(receipt);
+      verify(war).clearNationWarState(nation);
+    }
+  }
+}
