+  private static Map<NationId, TreasuryRetirementService.TreasuryRetirementReceipt> readRetirements(
+      Properties p) {
+    if (!"2".equals(p.getProperty("receiptFormatVersion"))) return Map.of();
+    if (!checksum(p).equals(p.getProperty("retirement.sha256")))
+      throw new IllegalArgumentException("Treasury retirement checksum mismatch");
