+  static class BarrierStore implements TreasuryStateStorage {
+    final TreasuryStateStorage delegate;
+    final java.util.concurrent.CyclicBarrier barrier;
+
+    BarrierStore(TreasuryStateStorage delegate, java.util.concurrent.CyclicBarrier barrier) {
+      this.delegate = delegate;
+      this.barrier = barrier;
+    }
+
+    public Properties load() {
+      return delegate.load();
+    }
+
+    public void save(Properties properties) {
+      try {
+        barrier.await(10, java.util.concurrent.TimeUnit.SECONDS);
+      } catch (Exception e) {
+        throw new IllegalStateException(e);
+      }
+      delegate.save(properties);
+    }
+  }
+
+  static class FaultStore implements TreasuryStateStorage {
+    final TreasuryStateStorage delegate;
+    boolean fail, after, failed, blockRead = true;
+
+    FaultStore(TreasuryStateStorage delegate) {
+      this.delegate = delegate;
+    }
+
+    public Properties load() {
+      if (failed && blockRead) throw new IllegalStateException("read unavailable");
+      return delegate.load();
+    }
+
+    public void save(Properties properties) {
+      if (!fail) {
+        delegate.save(properties);
+        return;
+      }
+      fail = false;
+      if (after) delegate.save(properties);
+      failed = true;
+      throw new IllegalStateException("lost treasury write");
+    }
+  }
+}
