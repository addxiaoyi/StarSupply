+    var stores = stores(sql);
+    var service = land(stores.get());
+    var batch = new TerritoryBatchService.Request(UUID.randomUUID(), "old", List.of(first), 5);
+    service.claimBatch(batch);
+    service.claim("old", second);
+    var transfer =
+        new TerritoryTransferService.TransferRequest(
+            UUID.randomUUID(), "old", "other", List.of(second), 0);
+    service.transferBatch(transfer);
+    UUID id = UUID.randomUUID();
+    var receipt = service.retireOwner(id, "old");
+    assertThat(receipt.releasedClaims()).isEqualTo(1);
+    assertThat(service.claimsByOwner("old")).isEmpty();
+    assertThat(service.claim("other", first)).isTrue();
+    var restarted = land(stores.get());
+    assertThat(restarted.retireOwner(id, "old")).isEqualTo(receipt);
+    assertThat(restarted.claimBatch(batch).status())
+        .isEqualTo(TerritoryBatchService.Status.APPLIED);
+    assertThat(restarted.transferBatch(transfer).status())
+        .isEqualTo(TerritoryTransferService.TransferStatus.APPLIED);
+    assertThat(restarted.claimsByOwner("other")).hasSize(2);
+    assertThat(restarted.claim("old", new ChunkCoordinate("world", 3, 0))).isFalse();
+    assertThat(restarted.transferClaims("other", "old", List.of(first))).isFalse();
+    assertThat(
