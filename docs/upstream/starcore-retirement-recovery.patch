+        new LinkedHashMap<>();
+    for (int i = 0; i < count; i++) {
+      String key = "retirement." + i + ".";
+      var nation = new NationId(UUID.fromString(p.getProperty(key + "nation")));
+      var receipt =
+          new TreasuryRetirementService.TreasuryRetirementReceipt(
+              UUID.fromString(p.getProperty(key + "operation")),
+              nation,
+              new BigDecimal(p.getProperty(key + "balance")));
+      if (receipts.putIfAbsent(nation, receipt) != null)
+        throw new IllegalArgumentException("Duplicate retired treasury");
+    }
+    return receipts;
+  }
