+package dev.starcore.starcore.module.nation;
+
+import static org.assertj.core.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+import dev.starcore.starcore.core.persistence.PersistenceService;
+import dev.starcore.starcore.foundation.territory.InMemoryTerritoryService;
+import dev.starcore.starcore.foundation.territory.model.ChunkCoordinate;
+import dev.starcore.starcore.module.city.CityService;
+import dev.starcore.starcore.module.diplomacy.DiplomacyRelationService;
+import dev.starcore.starcore.module.diplomacy.alliance.AllianceService;
+import dev.starcore.starcore.module.diplomacy.military.MilitaryAllianceService;
+import dev.starcore.starcore.module.nation.model.NationId;
+import dev.starcore.starcore.module.treasury.NavyTreasuryFixture;
+import dev.starcore.starcore.module.war.WarService;
+import java.math.BigDecimal;
+import java.nio.file.Path;
+import java.util.*;
+import java.util.concurrent.atomic.AtomicInteger;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+class NationDisbandRetirementTest {
+  @TempDir Path directory;
+
+  @Test
+  void interruptedCleanupClosesCurrentLandAndTreasuryExactlyOnce() throws Exception {
+    var persistence = mock(PersistenceService.class);
+    when(persistence.namespacePath("territory")).thenReturn(directory.resolve("land"));
+    when(persistence.namespacePath("navy-test-treasury")).thenReturn(directory.resolve("money"));
+    var land = new InMemoryTerritoryService(persistence);
+    var treasury = NavyTreasuryFixture.open(persistence, new AtomicInteger());
+    var nation = NationId.random();
+    var other = NationId.random();
+    var first = new ChunkCoordinate("world", 1, 1);
+    var later = new ChunkCoordinate("world", 2, 1);
+    var kept = new ChunkCoordinate("world", 3, 1);
+    land.claim(nation.toString(), first);
+    treasury.deposit(nation, new BigDecimal("100.00"));
+    var transaction =
+        new NationDisbandTransaction(
+            UUID.randomUUID(),
+            List.of(nation),
+            Map.of(nation, List.of(first)),
+            List.of(),
+            List.of(nation),
+            List.of());
+    // These writes predate external retirement but postdate the old independent journal snapshot.
+    land.claim(nation.toString(), later);
+    land.claim(other.toString(), kept);
+    treasury.deposit(nation, new BigDecimal("25.00"));
+    var diplomacy = mock(DiplomacyRelationService.class);
+    doThrow(new IllegalStateException("cleanup interrupted"))
+        .doNothing()
+        .when(diplomacy)
+        .clearNationRelations(nation);
+    var alliance = mock(AllianceService.class);
+    var military = mock(MilitaryAllianceService.class);
+    var war = mock(WarService.class);
+    var cities = mock(CityService.class);
+    assertThatThrownBy(
+            () ->
+                NationDisbandRecovery.completeCommitted(
+                    transaction, land, diplomacy, treasury, alliance, military, war, cities))
+        .isInstanceOf(IllegalStateException.class);
+    assertThat(land.retirementReceipt(nation.toString())).isPresent();
+    assertThat(land.claimsByOwner(nation.toString())).isEmpty();
+    assertThat(treasury.balance(nation)).isEqualByComparingTo("125.00");
+    land.claim(other.toString(), first);
+    var restartedLand = new InMemoryTerritoryService(persistence);
+    var restartedMoney = NavyTreasuryFixture.open(persistence, new AtomicInteger());
+    NationDisbandRecovery.completeCommitted(
+        transaction, restartedLand, diplomacy, restartedMoney, alliance, military, war, cities);
+    assertThat(restartedLand.isOwnerOf(other.toString(), first)).isTrue();
+    assertThat(restartedLand.isOwnerOf(other.toString(), kept)).isTrue();
+    assertThat(restartedMoney.treasuryRetirementReceipt(nation).orElseThrow().retiredBalance())
+        .isEqualByComparingTo("125.00");
+    assertThat(restartedMoney.tryDeposit(nation, BigDecimal.ONE)).isFalse();
+    NationDisbandRecovery.completeCommitted(
+        transaction, restartedLand, diplomacy, restartedMoney, alliance, military, war, cities);
+    assertThat(restartedMoney.balance(nation)).isEqualByComparingTo("0.00");
+    assertThat(restartedLand.retirementReceipt(nation.toString()).orElseThrow().releasedClaims())
+        .isEqualTo(2);
+  }
+}
