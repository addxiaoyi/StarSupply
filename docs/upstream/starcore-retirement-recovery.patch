+/** Permanently closes a disbanded nation's treasury while retaining every money receipt. */
+public interface TreasuryRetirementService {
+  record TreasuryRetirementReceipt(UUID operationId, NationId nationId, BigDecimal retiredBalance) {
+    public TreasuryRetirementReceipt {
+      Objects.requireNonNull(operationId);
+      Objects.requireNonNull(nationId);
+      Objects.requireNonNull(retiredBalance);
+      retiredBalance = retiredBalance.setScale(2, RoundingMode.UNNECESSARY);
+      if (retiredBalance.signum() < 0
+          || retiredBalance.compareTo(new BigDecimal("1000000000000000.00")) > 0)
+        throw new IllegalArgumentException("Invalid retired treasury balance");
+    }
+  }
+
+  /** Captures and removes the current balance atomically. Replays return that original amount. */
+  TreasuryRetirementReceipt retireTreasury(UUID operationId, NationId nationId);
+
+  Optional<TreasuryRetirementReceipt> treasuryRetirementReceipt(NationId nationId);
+}
