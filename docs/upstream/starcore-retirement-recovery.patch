+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void competingIncomeAndClosureCannotReopenAccount(boolean sql) throws Exception {
+    var stores = stores(sql);
+    treasury(stores.get()).deposit(nation, new BigDecimal("100.00"));
+    var barrier = new java.util.concurrent.CyclicBarrier(2);
+    var writer = treasury(new BarrierStore(stores.get(), barrier));
+    var closer = treasury(new BarrierStore(stores.get(), barrier));
+    UUID id = UUID.randomUUID();
+    boolean deposited;
+    try (var executor = java.util.concurrent.Executors.newFixedThreadPool(2)) {
+      var one = executor.submit(() -> writer.tryDeposit(nation, new BigDecimal("25.00")));
+      var two =
+          executor.submit(
+              () -> {
+                try {
+                  closer.retireTreasury(id, nation);
+                } catch (IllegalStateException conflict) {
+                }
+              });
+      deposited = one.get(15, java.util.concurrent.TimeUnit.SECONDS);
+      two.get(15, java.util.concurrent.TimeUnit.SECONDS);
+    }
+    var restarted = treasury(stores.get());
+    var receipt = restarted.retireTreasury(id, nation);
+    assertThat(receipt.retiredBalance()).isEqualByComparingTo(deposited ? "125.00" : "100.00");
+    assertThat(restarted.balance(nation)).isEqualByComparingTo("0.00");
+    assertThat(restarted.tryDeposit(nation, BigDecimal.ONE)).isFalse();
+  }
