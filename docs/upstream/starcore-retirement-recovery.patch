+    assertThat(restarted.refund("spent")).isFalse();
+    assertThat(restarted.spend(spending("new-spend")).applied()).isFalse();
+    assertThat(restarted.credit(credit("new-credit")).applied()).isFalse();
+    assertThat(restarted.transfer(transfer("new-in", true)).applied()).isFalse();
