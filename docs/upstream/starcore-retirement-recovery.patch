+package dev.starcore.starcore.foundation.territory;
+
+import java.util.Objects;
+import java.util.Optional;
+import java.util.UUID;
+
+/** Permanently closes an owner and releases its current claims in the same durable commit. */
+public interface TerritoryRetirementService {
+  record RetirementReceipt(UUID operationId, String ownerId, int releasedClaims) {
+    public RetirementReceipt {
+      Objects.requireNonNull(operationId);
+      if (ownerId == null
+          || ownerId.isBlank()
+          || ownerId.length() > 64
+          || releasedClaims < 0
+          || releasedClaims > 1_000_000)
+        throw new IllegalArgumentException("Invalid territory retirement");
+    }
+  }
+
+  /** Caller must durably authorize disband first. There is no reopen or cancellation operation. */
+  RetirementReceipt retireOwner(UUID operationId, String ownerId);
+
+  Optional<RetirementReceipt> retirementReceipt(String ownerId);
+}
