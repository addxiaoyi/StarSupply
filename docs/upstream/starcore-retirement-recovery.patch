+    var receipt = new RetirementReceipt(operationId, ownerId, state.claims().size() - next.size());
+    var retired = new HashMap<>(state.retirements());
+    retired.put(ownerId, receipt);
+    commit(new TerritoryLedger(next, state.receipts(), state.transfers(), retired));
+    return receipt;
+  }
