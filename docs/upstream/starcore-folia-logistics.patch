+import java.util.concurrent.atomic.AtomicReference;
+import org.bukkit.Bukkit;
+import org.bukkit.Location;
+import org.bukkit.World;
+import org.bukkit.entity.Player;
+import org.bukkit.plugin.Plugin;
+import org.bukkit.scheduler.BukkitTask;
+import org.junit.jupiter.api.Test;
+import org.mockito.MockedStatic;
+
+class TechnologyNearbyOwnershipTest {
+  @Test
+  void adjacentAllyInAnotherRegionUsesOwnerSnapshotAndLiveNationAuthority() throws Exception {
+    Plugin plugin = mock(Plugin.class);
+    NationService nations = mock(NationService.class);
+    Nation nation = mock(Nation.class);
+    NationId nationId = NationId.random();
+    when(nation.id()).thenReturn(nationId);
+    World world = mock(World.class);
+    when(world.getUID()).thenReturn(UUID.randomUUID());
+    Player self = mock(Player.class), ally = mock(Player.class);
+    UUID selfId = UUID.randomUUID(), allyId = UUID.randomUUID();
+    when(self.getUniqueId()).thenReturn(selfId);
+    when(ally.getUniqueId()).thenReturn(allyId);
+    when(ally.isOnline()).thenReturn(true);
+    when(nations.nationOf(selfId)).thenReturn(Optional.of(nation));
+    when(nations.nationOf(allyId)).thenReturn(Optional.of(nation));
+    AtomicBoolean ownsAlly = new AtomicBoolean();
+    when(ally.getLocation())
+        .thenAnswer(
+            call -> {
+              assertTrue(ownsAlly.get(), "remote entity position read");
+              return new Location(world, 256, 64, 0);
+            });
+    AtomicReference<Runnable> global = new AtomicReference<>();
+    Map<Player, Runnable> entity = new java.util.HashMap<>();
+    BukkitTask timer = mock(BukkitTask.class);
+    try (MockedStatic<CompatScheduler> scheduler = mockStatic(CompatScheduler.class);
+        MockedStatic<Bukkit> bukkit = mockStatic(Bukkit.class)) {
+      scheduler.when(CompatScheduler::isFolia).thenReturn(true);
+      scheduler
+          .when(() -> CompatScheduler.globalTimer(eq(plugin), any(Runnable.class), eq(1L), eq(10L)))
+          .thenAnswer(
+              call -> {
+                global.set(call.getArgument(1));
+                return timer;
+              });
+      scheduler
+          .when(
+              () ->
+                  CompatScheduler.entity(
+                      eq(plugin), any(Player.class), any(Runnable.class), any(Runnable.class)))
+          .thenAnswer(
+              call -> {
+                entity.put(call.getArgument(1), call.getArgument(2));
+                return mock(BukkitTask.class);
+              });
+      bukkit.when(Bukkit::getOnlinePlayers).thenReturn(List.of(self, ally));
+      TechnologyEventListener listener =
+          new TechnologyEventListener(mock(TechnologyModule.class), nations, plugin);
+      global.get().run();
+      verify(ally, never()).getLocation();
+      ownsAlly.set(true);
+      entity.get(ally).run();
+      ownsAlly.set(false);
+      Method near =
+          TechnologyEventListener.class.getDeclaredMethod(
+              "isFightingWithAllies", Player.class, Location.class);
+      near.setAccessible(true);
+      assertEquals(true, near.invoke(listener, self, new Location(world, 255, 64, 0)));
+      verify(ally, times(1)).getLocation();
+      when(nations.nationOf(allyId)).thenReturn(Optional.empty());
+      assertEquals(false, near.invoke(listener, self, new Location(world, 255, 64, 0)));
+      when(nations.nationOf(allyId)).thenReturn(Optional.of(nation));
+      listener.close();
+      entity.get(ally).run();
+      assertEquals(false, near.invoke(listener, self, new Location(world, 255, 64, 0)));
+      verify(timer).cancel();
+      verify(ally, times(1)).getLocation();
+    }
+  }
+}
