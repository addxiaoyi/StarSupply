+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.Mockito.*;
+
+import com.google.gson.Gson;
+import dev.starcore.starcore.module.nation.model.NationId;
+import java.lang.management.ManagementFactory;
+import java.util.UUID;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.Future;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicReference;
+import java.util.concurrent.locks.LockSupport;
+import java.util.logging.Logger;
+import org.junit.jupiter.api.Test;
+
+class WarPersistenceLockOrderTest {
+  @Test
+  void periodicSnapshotDoesNotDeadlockConfirmedScoreGrantHoldingWar() throws Exception {
+    NationId attacker = NationId.random();
+    War war = War.declare("lock-order", attacker, NationId.random(), WarGoal.TERRITORIAL);
+    WarJsonCodec codec = new WarJsonCodec(new Gson(), Logger.getAnonymousLogger());
+    WarStateStorage storage = mock(WarStateStorage.class);
+    when(storage.usesDatabase()).thenReturn(true);
+    when(storage.freezeWar(war))
+        .thenAnswer(
+            call -> new WarStateStorage.WarRecord(war.id(), codec.encode(war).toString(), 1L));
+    WarPersistenceCoordinator coordinator =
+        new WarPersistenceCoordinator(storage, Logger.getAnonymousLogger());
+    ExecutorService callers =
+        Executors.newFixedThreadPool(
+            2,
+            work -> {
+              Thread thread = new Thread(work, "war-lock-order-test");
+              thread.setDaemon(true);
+              return thread;
+            });
+    CountDownLatch warHeld = new CountDownLatch(1);
+    CountDownLatch allowGrant = new CountDownLatch(1);
+    AtomicReference<Thread> snapshotCaller = new AtomicReference<>();
+    Future<?> grant = null;
+    Future<?> snapshot = null;
+    try {
+      grant =
+          callers.submit(
+              () -> {
+                synchronized (war) {
+                  warHeld.countDown();
+                  await(allowGrant);
+                  assertTrue(war.addWarScoreOnce(UUID.randomUUID(), attacker, 1));
+                  coordinator.persistConfirmed(war);
+                }
+              });
+      assertTrue(warHeld.await(5, TimeUnit.SECONDS));
+      snapshot =
+          callers.submit(
+              () -> {
+                snapshotCaller.set(Thread.currentThread());
+                coordinator.persist(war);
+              });
+      // The periodic caller has reached the monitor held by the grant caller. It must not
+      // reserve the coordinator first, or the grant cannot submit its confirmed write.
+      long deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(5);
+      while (System.nanoTime() < deadline) {
+        Thread thread = snapshotCaller.get();
+        if (thread != null && blockedOnWar(thread, war)) break;
+        LockSupport.parkNanos(TimeUnit.MILLISECONDS.toNanos(1));
+      }
+      assertNotNull(snapshotCaller.get());
+      assertTrue(blockedOnWar(snapshotCaller.get(), war));
+      allowGrant.countDown();
+      grant.get(5, TimeUnit.SECONDS);
+      snapshot.get(5, TimeUnit.SECONDS);
+      coordinator.flush();
+      verify(storage, times(2)).writeWarRecord(any());
+      assertEquals(1, war.aggressorWarScore());
+    } finally {
+      allowGrant.countDown();
+      callers.shutdownNow();
+      // A regression must fail within the future bounds, rather than hanging JUnit cleanup.
+      if (grant != null && snapshot != null && grant.isDone() && snapshot.isDone())
+        coordinator.flush();
+      assertTrue(callers.awaitTermination(5, TimeUnit.SECONDS));
+    }
+  }
+
+  private static void await(CountDownLatch gate) {
+    try {
+      if (!gate.await(5, TimeUnit.SECONDS)) throw new AssertionError("grant was not released");
+    } catch (InterruptedException interrupted) {
+      Thread.currentThread().interrupt();
+      throw new AssertionError(interrupted);
+    }
+  }
+
+  private static boolean blockedOnWar(Thread thread, War war) {
+    var info = ManagementFactory.getThreadMXBean().getThreadInfo(thread.threadId());
+    return info != null
+        && info.getThreadState() == Thread.State.BLOCKED
+        && info.getLockInfo() != null
+        && info.getLockInfo().getIdentityHashCode() == System.identityHashCode(war);
+  }
+}
