+              assertThat(registry.require(TreasuryService.class)).isSameAs(treasury);
+              return fixture.updateTask();
+            });
+    when(fixture
+            .scheduler()
+            .runTaskTimerAsynchronously(any(), any(Runnable.class), anyLong(), anyLong()))
+        .thenReturn(fixture.saveTask());
+    SiegeModule siege = new SiegeModule();
+    ModuleManager manager = new ModuleManager(Logger.getAnonymousLogger(), registry);
+    // Register the consumer first: only declared dependencies may determine startup ordering.
+    manager.register(siege);
+    manager.register(
+        module(
+            "treasury",
+            List.of("nation", "economy"),
+            List.of(TreasuryService.class),
+            () -> {
+              enabled.add("treasury");
+              registry.register(TreasuryService.class, treasury);
+            }));
+    manager.register(module("nation", List.of(), List.of(), () -> {}));
+    manager.register(module("economy", List.of(), List.of(), () -> {}));
+
+    try (var ignored = mockStatic(HandlerList.class)) {
+      manager.enableAll(fixture.context());
+
+      assertThat(enabled).containsExactly("treasury", "siege");
+      assertThat(registry.require(SiegeService.class)).isSameAs(siege);
+      UUID nation = UUID.randomUUID();
+      BigDecimal cost = BigDecimal.valueOf(SiegeType.BATTERING_RAM.constructionCost() + 5 * 50);
+      when(treasury.balance(NationId.of(nation))).thenReturn(cost);
+      when(treasury.withdraw(NationId.of(nation), cost)).thenReturn(true);
+      assertThat(
+              siege.createSiege(nation, SiegeType.BATTERING_RAM, 5, new Location(null, 0, 64, 0)))
+          .isNotNull();
+      verify(treasury).withdraw(NationId.of(nation), cost);
+
+      manager.disableAll(fixture.context());
+      verify(fixture.updateTask()).cancel();
+      verify(fixture.saveTask()).cancel();
+      assertThat(registry.find(SiegeService.class)).isEmpty();
+    }
+  }
