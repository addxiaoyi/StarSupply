+import org.bukkit.plugin.java.JavaPlugin;
+import org.bukkit.scheduler.BukkitTask;
+import org.junit.jupiter.api.Test;
+import org.mockito.MockedStatic;
+
+class SeasonServiceFoliaTest {
+  @Test
+  void startupWaitsForGlobalTickAndShutdownDiscardsPendingInitialization() {
+    JavaPlugin plugin = plugin();
+    World world = world("world", 21L);
+    List<Runnable> firstTicks = new ArrayList<>();
+    try (MockedStatic<CompatScheduler> schedulers = folia(firstTicks);
+        MockedStatic<Bukkit> bukkit = mockStatic(Bukkit.class)) {
+      bukkit.when(Bukkit::getWorlds).thenReturn(List.of(world));
+      bukkit.when(Bukkit::getOnlinePlayers).thenReturn(List.of());
+      SeasonService service = new SeasonService(plugin, null, null);
+      service.initialize();
+      verify(world, never()).getFullTime();
+      assertEquals(Season.SPRING, service.getSeason(world));
+      service.shutdown();
+      firstTicks.getFirst().run();
+      verify(world, never()).getFullTime();
+      assertEquals(Season.SPRING, service.getSeason(world));
+    }
+  }
+
+  @Test
+  void regionReadersUseOwnerCapturedWorldTime() {
+    JavaPlugin plugin = plugin();
+    World world = world("world", 21L);
+    List<Runnable> firstTicks = new ArrayList<>();
+    try (MockedStatic<CompatScheduler> schedulers = folia(firstTicks);
+        MockedStatic<Bukkit> bukkit = mockStatic(Bukkit.class)) {
+      bukkit.when(Bukkit::getWorlds).thenReturn(List.of(world));
+      SeasonService service = new SeasonService(plugin, null, null);
+      service.initialize();
+      firstTicks.getFirst().run();
+      assertEquals(Season.WINTER, service.getSeason(world));
+      assertEquals(3L, service.getSeasonCycle(world));
+      when(world.getFullTime()).thenThrow(new AssertionError("off-owner world time read"));
+      assertEquals(3L, service.getSeasonCycle(world));
+      assertEquals(7, service.getDaysUntilNextSeason(world));
+    }
+  }
+
+  @Test
+  void globalEffectTimerOnlyQueuesPlayerOwnedWork() {
+    JavaPlugin plugin = plugin();
+    Player player = mock(Player.class);
+    World world = world("other-world", 0);
+    when(player.isOnline()).thenReturn(true);
+    when(player.getWorld()).thenReturn(world);
+    List<Runnable> firstTicks = new ArrayList<>();
+    List<Runnable> entityTasks = new ArrayList<>();
+    Map<Long, Runnable> timers = new java.util.HashMap<>();
+    try (MockedStatic<CompatScheduler> schedulers = folia(firstTicks);
+        MockedStatic<Bukkit> bukkit = mockStatic(Bukkit.class)) {
+      bukkit.when(Bukkit::getWorlds).thenReturn(List.of());
+      bukkit.when(Bukkit::getOnlinePlayers).thenReturn(List.of(player));
+      schedulers
+          .when(
+              () ->
+                  CompatScheduler.globalTimer(
+                      eq(plugin), any(Runnable.class), anyLong(), anyLong()))
+          .thenAnswer(
+              call -> {
+                timers.put(call.getArgument(3), call.getArgument(1));
+                return mock(BukkitTask.class);
+              });
+      schedulers
+          .when(() -> CompatScheduler.entity(eq(plugin), eq(player), any(Runnable.class)))
+          .thenAnswer(
+              call -> {
+                entityTasks.add(call.getArgument(2));
+                return mock(BukkitTask.class);
+              });
+      SeasonService service = new SeasonService(plugin, null, null);
+      service.initialize();
+      firstTicks.getFirst().run();
+      timers.get(200L).run();
+      verify(player, never()).getWorld();
+      assertEquals(1, entityTasks.size());
+      entityTasks.getFirst().run();
+      verify(player).getWorld();
+    }
+  }
+
+  private MockedStatic<CompatScheduler> folia(List<Runnable> firstTicks) {
+    MockedStatic<CompatScheduler> schedulers = mockStatic(CompatScheduler.class);
+    schedulers.when(CompatScheduler::isFolia).thenReturn(true);
+    schedulers
+        .when(() -> CompatScheduler.global(any(), any(Runnable.class)))
+        .thenAnswer(
+            call -> {
+              firstTicks.add(call.getArgument(1));
+              return mock(BukkitTask.class);
+            });
+    schedulers
+        .when(() -> CompatScheduler.globalTimer(any(), any(Runnable.class), anyLong(), anyLong()))
+        .thenReturn(mock(BukkitTask.class));
+    return schedulers;
+  }
+
+  private JavaPlugin plugin() {
+    JavaPlugin plugin = mock(JavaPlugin.class);
+    Server server = mock(Server.class);
+    when(plugin.getServer()).thenReturn(server);
+    when(server.getPluginManager()).thenReturn(mock(PluginManager.class));
+    when(plugin.getLogger()).thenReturn(java.util.logging.Logger.getAnonymousLogger());
+    when(plugin.isEnabled()).thenReturn(true);
+    return plugin;
+  }
+
+  private World world(String name, long days) {
+    World world = mock(World.class);
+    when(world.getName()).thenReturn(name);
+    when(world.getFullTime()).thenReturn(days * 24_000L);
+    return world;
+  }
+}
