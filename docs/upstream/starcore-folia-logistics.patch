+    Nation nation = new Nation(NationId.random(), "Atlas", founderId, "Founder");
+    NationService nations = mock(NationService.class);
+    when(nations.nationById(nation.id())).thenReturn(Optional.of(nation));
+    when(nations.levelOf(nation.id())).thenReturn(1);
+    when(nations.addMember(nation.id(), applicantId, "Applicant")).thenReturn(true);
+    Player founder = mock(Player.class);
+    Player applicant = mock(Player.class);
+    when(founder.isOnline()).thenReturn(true);
+    when(applicant.isOnline()).thenReturn(true);
+    JavaPlugin plugin = mock(JavaPlugin.class);
+    when(plugin.isEnabled()).thenReturn(true);
+    List<Runnable> callbacks = new ArrayList<>();
+    try (MockedStatic<Bukkit> bukkit = mockStatic(Bukkit.class);
+        MockedStatic<JavaPlugin> plugins = mockStatic(JavaPlugin.class);
+        MockedStatic<CompatScheduler> scheduler = mockStatic(CompatScheduler.class)) {
