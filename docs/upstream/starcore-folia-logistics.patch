+      scheduler.when(CompatScheduler::isGlobalThread).thenAnswer(ignored -> global);
+      scheduler.when(() -> CompatScheduler.isEntityThread(player)).thenAnswer(ignored -> !global);
+      scheduler
+          .when(() -> CompatScheduler.global(eq(plugin), any(Runnable.class)))
+          .thenAnswer(
+              invocation -> {
+                globalTasks.add(invocation.getArgument(1));
+                return mock(BukkitTask.class);
+              });
+      scheduler
+          .when(
+              () ->
+                  CompatScheduler.entityTimer(
+                      eq(plugin),
+                      eq(player),
+                      any(Runnable.class),
+                      any(Runnable.class),
+                      eq(0L),
+                      eq(20L)))
+          .thenAnswer(
+              invocation -> {
+                warmups.add(invocation.getArgument(2));
+                warmupRetired.add(invocation.getArgument(3));
+                return mock(BukkitTask.class);
+              });
+      scheduler
+          .when(
+              () ->
+                  CompatScheduler.entity(
+                      eq(plugin), eq(player), any(Runnable.class), any(Runnable.class)))
+          .thenAnswer(
+              invocation -> {
+                teleports.add(invocation.getArgument(2));
+                teleportRetired.add(invocation.getArgument(3));
+                return mock(BukkitTask.class);
+              });
+      scheduler
+          .when(() -> CompatScheduler.entity(eq(plugin), eq(player), any(Runnable.class)))
+          .thenReturn(mock(BukkitTask.class));
+      when(economy.withdraw(playerId, cost))
+          .thenAnswer(
+              ignored -> {
+                assertTrue(global);
+                return true;
+              });
+      when(economy.deposit(playerId, cost))
+          .thenAnswer(
+              ignored -> {
+                assertTrue(global);
+                return true;
+              });
+      when(player.teleportAsync(any(Location.class)))
+          .thenAnswer(
+              ignored -> {
+                assertFalse(global);
+                return result;
+              });
+      service =
+          new NationTeleportService(
+              plugin,
+              nations,
+              economy,
+              messages,
+              new NationTeleportConfig(
+                  true, Duration.ofMinutes(5), 1, cost, cost, true, true, true),
+              ledger);
+    }
+
+    void startAndDebit() {
+      service.teleportToCapital(player);
+      warmups.getFirst().run();
+      verify(economy, never()).withdraw(any(), any());
+      drainGlobal();
+    }
+
+    void startTeleport() {
+      teleports.getFirst().run();
+    }
+
+    void drainGlobal() {
+      global = true;
+      try {
+        while (!globalTasks.isEmpty()) globalTasks.removeFirst().run();
+      } finally {
+        global = false;
+      }
+    }
+
+    public void close() {
+      service.shutdown();
+      drainGlobal();
+      scheduler.close();
+    }
+  }
+}
