+import org.bukkit.scheduler.BukkitTask;
+import org.junit.jupiter.api.Test;
+
+class ParticleEffectManagerFoliaOwnershipTest {
+  @Test
+  void fixedWarAnimationUsesItsRegionAndCancelsWithoutLegacyScheduler() {
+    Plugin plugin = mock(Plugin.class);
+    Player player = mock(Player.class);
+    World world = mock(World.class);
+    when(player.getUniqueId()).thenReturn(UUID.randomUUID());
+    when(player.getLocation()).thenReturn(new Location(world, 10, 80, 10));
+    BukkitTask nativeTask = mock(BukkitTask.class);
+    AtomicReference<Runnable> animation = new AtomicReference<>();
+    try (var scheduler = mockStatic(CompatScheduler.class)) {
+      scheduler.when(CompatScheduler::isFolia).thenReturn(true);
+      scheduler
+          .when(
+              () ->
+                  CompatScheduler.regionTimer(
+                      eq(plugin), any(Location.class), any(Runnable.class), eq(0L), eq(3L)))
+          .thenAnswer(
+              invocation -> {
+                animation.set(invocation.getArgument(2));
+                return nativeTask;
+              });
+      ParticleEffectManager manager = new ParticleEffectManager(plugin);
+      manager.playBattleCloud(player);
+      assertEquals(0, particleCalls(world));
+      animation.get().run();
+      animation.get().run();
+      assertEquals(10, particleCalls(world));
+      verify(player, times(1)).getLocation();
+      manager.cancelPlayerEffects(player);
+      verify(nativeTask, times(1)).cancel();
+      animation.get().run();
+      assertEquals(10, particleCalls(world));
+      manager.cancelAllEffects();
+      verify(nativeTask, times(1)).cancel();
+    }
+  }
+
+  private static long particleCalls(World world) {
+    return mockingDetails(world).getInvocations().stream()
+        .filter(invocation -> invocation.getMethod().getName().equals("spawnParticle"))
+        .count();
+  }
+}
