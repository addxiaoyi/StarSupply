+      var wars =
+          new WarServiceImpl(
+              plugin,
+              mock(DiplomacyWarService.class),
+              storage,
+              WarServiceImpl.WarConfig.defaults());
+      var treasury =
+          mock(TreasuryService.class, withSettings().extraInterfaces(NationTransferService.class));
+      var treaties =
+          new PeaceTreatyService(
+              plugin,
+              wars,
+              storage,
+              treasury,
