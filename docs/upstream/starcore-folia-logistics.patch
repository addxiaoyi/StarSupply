+    verify(global).runAtFixedRate(eq(plugin), callback.capture(), eq(1L), eq(2L));
+
+    callback.getValue().accept(nativeTask);
+    callback.getValue().accept(nativeTask);
+    assertEquals(1, CompatScheduler.pendingTaskCount());
+    CompatScheduler.cancelTask(handle.getTaskId());
+    callback.getValue().accept(nativeTask);
+
+    assertTrue(handle.isCancelled());
+    assertEquals(0, CompatScheduler.pendingTaskCount());
+    verify(action, times(2)).run();
+    verify(nativeTask).cancel();
+  }
+
+  @Test
+  void failingCallbacksCancelAndRemoveTheirTask() {
+    IllegalStateException failure = new IllegalStateException("callback failed");
+    BukkitTask handle =
+        track(
+            CompatScheduler.global(
+                plugin,
+                () -> {
+                  throw failure;
+                }));
+
+    assertSame(
+        failure,
+        assertThrows(
+            IllegalStateException.class, () -> captureGlobalCallback().accept(nativeTask)));
+
+    assertTrue(handle.isCancelled());
+    assertEquals(0, CompatScheduler.pendingTaskCount());
+    verify(nativeTask).cancel();
+  }
+
+  @Test
+  void schedulerRegistrationFailureDoesNotLeakItsPendingHandle() {
+    IllegalStateException failure = new IllegalStateException("scheduler disabled");
+    when(global.run(eq(plugin), any())).thenThrow(failure);
+
+    assertSame(
+        failure,
+        assertThrows(IllegalStateException.class, () -> CompatScheduler.global(plugin, () -> {})));
+
+    assertEquals(0, CompatScheduler.pendingTaskCount());
+  }
+
+  @Test
+  void entityRetirementRunsItsFallbackOnceAndReleasesThePendingHandle() {
+    Runnable action = mock(Runnable.class);
+    Runnable retired = mock(Runnable.class);
+    BukkitTask handle = track(CompatScheduler.entity(plugin, entity, action, retired));
+    ArgumentCaptor<Consumer<ScheduledTask>> callback = callbackCaptor();
+    ArgumentCaptor<Runnable> retirement = ArgumentCaptor.forClass(Runnable.class);
+    verify(entityScheduler).run(eq(plugin), callback.capture(), retirement.capture());
+
+    retirement.getValue().run();
+    retirement.getValue().run();
+    callback.getValue().accept(nativeTask);
+
+    assertTrue(handle.isCancelled());
+    assertEquals(0, CompatScheduler.pendingTaskCount());
+    verify(retired).run();
+    verifyNoInteractions(action);
+  }
+
+  @Test
+  void alreadyRetiredEntityReturnsACancelledHandleWithoutLeaking() {
+    Runnable action = mock(Runnable.class);
+    Runnable retired = mock(Runnable.class);
+    when(entityScheduler.run(eq(plugin), any(), any())).thenReturn(null);
+
+    BukkitTask handle = track(CompatScheduler.entity(plugin, entity, action, retired));
+
+    assertTrue(handle.isCancelled());
+    assertEquals(0, CompatScheduler.pendingTaskCount());
+    verify(retired).run();
+    verifyNoInteractions(action);
+  }
+
+  @Test
+  void retirementBeforeNativeHandleBindingCancelsTheLateHandle() {
+    Runnable retired = mock(Runnable.class);
+    Runnable action = mock(Runnable.class);
+    when(entityScheduler.run(eq(plugin), any(), any()))
+        .thenAnswer(
+            invocation -> {
+              Runnable retirement = invocation.getArgument(2);
+              retirement.run();
+              return nativeTask;
+            });
+
+    BukkitTask handle = track(CompatScheduler.entity(plugin, entity, action, retired));
+
+    assertTrue(handle.isCancelled());
+    assertEquals(0, CompatScheduler.pendingTaskCount());
+    verify(nativeTask).cancel();
+    verify(retired).run();
+    verifyNoInteractions(action);
+  }
+
+  @Test
+  void cancelTasksOnlyRemovesHandlesOwnedByTheRequestedPlugin() {
+    Plugin otherPlugin = mock(Plugin.class);
+    ScheduledTask otherNativeTask = mock(ScheduledTask.class);
+    when(global.run(eq(otherPlugin), any())).thenReturn(otherNativeTask);
+    BukkitTask own = track(CompatScheduler.global(plugin, () -> {}));
+    BukkitTask other = track(CompatScheduler.global(otherPlugin, () -> {}));
+
+    CompatScheduler.cancelTasks(plugin);
+
+    assertTrue(own.isCancelled());
+    assertFalse(other.isCancelled());
+    assertEquals(1, CompatScheduler.pendingTaskCount());
+    verify(nativeTask).cancel();
+    verify(otherNativeTask, never()).cancel();
+    verify(global).cancelTasks(plugin);
+    verify(async).cancelTasks(plugin);
+    verifyNoInteractions(legacy);
+  }
+
+  @Test
+  void entityTimerCallbackCanCancelBeforeNativeHandleBinding() {
+    when(entityScheduler.runAtFixedRate(eq(plugin), any(), any(), anyLong(), anyLong()))
+        .thenAnswer(
+            invocation -> {
+              Consumer<ScheduledTask> callback = invocation.getArgument(1);
+              callback.accept(nativeTask);
+              return nativeTask;
+            });
+
+    BukkitTask handle =
+        track(
+            CompatScheduler.entityTimer(
+                plugin, entity, (BukkitTask task) -> task.cancel(), 0L, 1L));
+
+    assertTrue(handle.isCancelled());
+    assertEquals(0, CompatScheduler.pendingTaskCount());
+    verify(nativeTask).cancel();
+  }
+
+  @Test
+  void paperCancellationRetainsLegacyTaskIdAndPluginSemantics() {
+    CompatScheduler.setFoliaForTests(false);
+
+    CompatScheduler.cancelTask(25);
+    CompatScheduler.cancelTasks(plugin);
+
+    verify(legacy).cancelTask(25);
+    verify(legacy).cancelTasks(plugin);
+    verifyNoInteractions(global, async, region, entityScheduler);
+  }
+
+  private BukkitTask track(BukkitTask handle) {
+    handles.add(handle);
+    return handle;
+  }
+
+  private Consumer<ScheduledTask> captureGlobalCallback() {
+    ArgumentCaptor<Consumer<ScheduledTask>> callback = callbackCaptor();
+    verify(global).run(eq(plugin), callback.capture());
+    return callback.getValue();
+  }
+
+  @SuppressWarnings({"unchecked", "rawtypes"})
+  private static ArgumentCaptor<Consumer<ScheduledTask>> callbackCaptor() {
+    return (ArgumentCaptor) ArgumentCaptor.forClass(Consumer.class);
+  }
+}
