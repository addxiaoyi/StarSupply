+  private boolean scheduleDistrictOperation(NationResourceDistrict district, Runnable operation) {
+    if (!CompatScheduler.isFolia()) {
+      operation.run();
+      return true;
+    }
+    Location location;
+    synchronized (this) {
+      location = regionLocation(district.coordinate()).orElse(null);
