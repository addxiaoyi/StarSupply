+
+import dev.starcore.starcore.core.scheduler.CompatScheduler;
+import java.util.UUID;
+import java.util.concurrent.atomic.AtomicBoolean;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.concurrent.atomic.AtomicReference;
+import org.bukkit.Server;
+import org.bukkit.entity.Player;
+import org.bukkit.plugin.Plugin;
+import org.bukkit.scheduler.BukkitScheduler;
+import org.bukkit.scheduler.BukkitTask;
+import org.junit.jupiter.api.Test;
+import org.mockito.MockedStatic;
+
+class AnimationOwnershipTest {
+  @Test
+  void foreignPlayerDispatchUsesEntitySchedulerAndShutdownSuppressesQueuedEffects() {
+    Plugin plugin = mock(Plugin.class);
+    Player player = mock(Player.class);
+    BukkitTask handle = mock(BukkitTask.class);
+    AtomicReference<Runnable> callback = new AtomicReference<>();
+    AtomicInteger effects = new AtomicInteger();
+    try (MockedStatic<CompatScheduler> scheduler = mockStatic(CompatScheduler.class)) {
+      scheduler.when(CompatScheduler::isFolia).thenReturn(true);
+      scheduler.when(() -> CompatScheduler.isEntityThread(player)).thenReturn(false);
+      scheduler
+          .when(
+              () ->
+                  CompatScheduler.entityLater(
+                      eq(plugin), eq(player), any(Runnable.class), any(Runnable.class), eq(1L)))
+          .thenAnswer(
+              invocation -> {
+                callback.set(invocation.getArgument(2));
+                return handle;
+              });
+      AnimationTaskTracker tracker = new AnimationTaskTracker(plugin);
+
+      assertTrue(tracker.dispatchPlayer(player, effects::incrementAndGet));
+      assertEquals(0, effects.get());
+      tracker.shutdown();
+      callback.get().run();
+
+      assertEquals(0, effects.get());
+      verify(handle).cancel();
+    }
+  }
+
+  @Test
+  void completedLoadingCallbackSettlesOnceAndCancelsItsTimer() {
+    Plugin plugin = mock(Plugin.class);
+    Server server = mock(Server.class);
+    BukkitScheduler scheduler = mock(BukkitScheduler.class);
+    BukkitTask handle = mock(BukkitTask.class);
+    Player player = mock(Player.class);
+    AtomicReference<Runnable> tick = new AtomicReference<>();
+    AtomicBoolean cancelled = new AtomicBoolean();
+    AtomicInteger completions = new AtomicInteger();
+    when(plugin.getServer()).thenReturn(server);
+    when(server.getScheduler()).thenReturn(scheduler);
+    when(player.getUniqueId()).thenReturn(UUID.randomUUID());
+    when(player.isOnline()).thenReturn(true);
+    when(handle.isCancelled()).thenAnswer(ignored -> cancelled.get());
+    doAnswer(
+            ignored -> {
+              cancelled.set(true);
+              return null;
+            })
+        .when(handle)
+        .cancel();
+    when(scheduler.runTaskTimer(eq(plugin), any(Runnable.class), anyLong(), anyLong()))
+        .thenAnswer(
+            invocation -> {
+              tick.set(invocation.getArgument(1));
+              return handle;
+            });
+    LoadingAnimationManager manager =
+        new LoadingAnimationManager(
+            plugin, mock(GuiAnimationManager.class), mock(SoundFeedbackManager.class));
+
+    manager.startSpinner(player, "Loading", 1, null, ignored -> completions.incrementAndGet());
+    tick.get().run();
+    tick.get().run();
+    tick.get().run();
+
+    assertEquals(1, completions.get());
+    assertTrue(cancelled.get());
+    manager.shutdown();
+  }
+}
