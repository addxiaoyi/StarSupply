+import org.junit.jupiter.api.Test;
+import org.mockito.MockedStatic;
+
+class RegionDetectionFoliaTest {
+  @Test
+  void globalQueueRoutesLocationInspectionToPlayerAndStopInvalidatesQueuedChecks() {
+    Plugin plugin = mock(Plugin.class);
+    Server server = mock(Server.class);
+    Player player = mock(Player.class);
+    UUID id = UUID.randomUUID();
+    when(plugin.getServer()).thenReturn(server);
+    when(server.getPlayer(id)).thenReturn(player);
+    when(player.getUniqueId()).thenReturn(id);
+    when(player.isOnline()).thenReturn(true);
+    Location location = mock(Location.class);
+    when(player.getLocation()).thenReturn(location);
+    RegionTitleService titles = mock(RegionTitleService.class);
+    AtomicReference<Runnable> timer = new AtomicReference<>();
+    AtomicReference<Runnable> entity = new AtomicReference<>();
+    BukkitTask handle = mock(BukkitTask.class);
+    try (MockedStatic<CompatScheduler> scheduler = mockStatic(CompatScheduler.class)) {
+      scheduler.when(CompatScheduler::isFolia).thenReturn(true);
+      scheduler
+          .when(() -> CompatScheduler.globalTimer(eq(plugin), any(Runnable.class), eq(0L), eq(5L)))
+          .thenAnswer(
+              call -> {
+                timer.set(call.getArgument(1));
+                return handle;
+              });
+      scheduler
+          .when(() -> CompatScheduler.entity(eq(plugin), eq(player), any(Runnable.class)))
+          .thenAnswer(
+              call -> {
+                entity.set(call.getArgument(2));
+                return mock(BukkitTask.class);
+              });
+      RegionDetectionListener listener = new RegionDetectionListener(plugin, titles);
+      listener.forceCheckPlayer(player);
+      timer.get().run();
+      verify(player, never()).getLocation();
+      verifyNoInteractions(titles);
+      entity.get().run();
+      verify(titles).checkPlayerRegion(player, location);
+      listener.forceCheckPlayer(player);
+      timer.get().run();
+      listener.stopCheckTask();
+      entity.get().run();
+      verify(titles, times(1)).checkPlayerRegion(player, location);
+      verify(handle).cancel();
+    }
+  }
+}
