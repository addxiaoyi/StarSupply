+  private void refund(Attempt attempt) {
+    RefundLedger ledger = attempt.ledger;
+    try {
+      // Only a definitive false/retired-before-start outcome authorizes this single refund.
+      if (!ledger.authorizeRetry(
+              attempt.id,
