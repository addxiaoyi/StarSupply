diff --git a/src/main/java/dev/starcore/starcore/core/scheduler/CompatScheduler.java b/src/main/java/dev/starcore/starcore/core/scheduler/CompatScheduler.java
new file mode 100644
index 0000000..4317d29
--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/core/scheduler/CompatScheduler.java
@@ -0,0 +1,471 @@
+package dev.starcore.starcore.core.scheduler;
+
+import io.papermc.paper.threadedregions.scheduler.ScheduledTask;
+import java.util.Objects;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.ConcurrentMap;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicBoolean;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.function.Consumer;
+import java.util.function.Function;
+import org.bukkit.Bukkit;
+import org.bukkit.Location;
+import org.bukkit.entity.Entity;
+import org.bukkit.plugin.Plugin;
+import org.bukkit.scheduler.BukkitTask;
+
+/**
+ * Schedules work with explicit ownership while retaining cancellable BukkitTask handles. Global
+ * work must contain only plugin-owned authority state or globally owned world operations; player
+ * and block work must use the entity and region methods respectively.
+ */
+public final class CompatScheduler {
+  private static final boolean FOLIA = detectFolia();
+  private static final AtomicInteger NEXT_ID = new AtomicInteger(-2);
+  private static final ConcurrentMap<Integer, NativeTask> TASKS = new ConcurrentHashMap<>();
+  private static volatile Boolean foliaForTests;
+
+  private CompatScheduler() {}
+
+  public static boolean isFolia() {
+    Boolean override = foliaForTests;
+    return override != null ? override : FOLIA;
+  }
+
+  private static boolean detectFolia() {
+    try {
+      Class.forName(
+          "io.papermc.paper.threadedregions.RegionizedServer",
+          false,
+          CompatScheduler.class.getClassLoader());
+      return true;
+    } catch (ClassNotFoundException ignored) {
+      return false;
+    }
+  }
+
+  public static BukkitTask global(Plugin plugin, Runnable task) {
+    if (!isFolia()) return legacy(plugin).runTask(plugin, task);
+    return schedule(
+        plugin,
+        task,
+        true,
+        false,
+        null,
+        callback -> Bukkit.getGlobalRegionScheduler().run(plugin, callback));
+  }
+
+  public static BukkitTask globalLater(Plugin plugin, Runnable task, long delayTicks) {
+    if (!isFolia()) return legacy(plugin).runTaskLater(plugin, task, delayTicks);
+    return schedule(
+        plugin,
+        task,
+        true,
+        false,
+        null,
+        callback ->
+            Bukkit.getGlobalRegionScheduler().runDelayed(plugin, callback, delay(delayTicks)));
+  }
+
+  public static BukkitTask globalTimer(
+      Plugin plugin, Runnable task, long delayTicks, long periodTicks) {
+    if (!isFolia()) {
+      return legacy(plugin).runTaskTimer(plugin, task, delayTicks, periodTicks);
+    }
+    return schedule(
+        plugin,
+        task,
+        true,
+        true,
+        null,
+        callback ->
+            Bukkit.getGlobalRegionScheduler()
+                .runAtFixedRate(plugin, callback, delay(delayTicks), period(periodTicks)));
+  }
+
+  public static BukkitTask async(Plugin plugin, Runnable task) {
+    if (!isFolia()) return legacy(plugin).runTaskAsynchronously(plugin, task);
+    return schedule(
+        plugin,
+        task,
+        false,
+        false,
+        null,
+        callback -> Bukkit.getAsyncScheduler().runNow(plugin, callback));
+  }
+
+  public static BukkitTask asyncLater(Plugin plugin, Runnable task, long delayTicks) {
+    if (!isFolia()) {
+      return legacy(plugin).runTaskLaterAsynchronously(plugin, task, delayTicks);
+    }
+    return schedule(
+        plugin,
+        task,
+        false,
+        false,
+        null,
+        callback ->
+            Bukkit.getAsyncScheduler()
+                .runDelayed(
+                    plugin, callback, millis(Math.max(0L, delayTicks)), TimeUnit.MILLISECONDS));
+  }
+
+  public static BukkitTask asyncTimer(
+      Plugin plugin, Runnable task, long delayTicks, long periodTicks) {
+    if (!isFolia()) {
+      return legacy(plugin).runTaskTimerAsynchronously(plugin, task, delayTicks, periodTicks);
+    }
+    return schedule(
+        plugin,
+        task,
+        false,
+        true,
+        null,
+        callback ->
+            Bukkit.getAsyncScheduler()
+                .runAtFixedRate(
+                    plugin,
+                    callback,
+                    millis(Math.max(0L, delayTicks)),
+                    millis(period(periodTicks)),
+                    TimeUnit.MILLISECONDS));
+  }
+
+  public static BukkitTask entity(Plugin plugin, Entity entity, Runnable task) {
+    return entity(plugin, entity, task, null);
+  }
+
+  public static BukkitTask entity(Plugin plugin, Entity entity, Runnable task, Runnable retired) {
+    Objects.requireNonNull(entity, "entity");
+    if (!isFolia()) return legacy(plugin).runTask(plugin, task);
+    return scheduleEntity(
+        plugin,
+        task,
+        false,
+        retired,
+        handle -> entity.getScheduler().run(plugin, handle::execute, handle::retire));
+  }
+
+  public static BukkitTask entityLater(
+      Plugin plugin, Entity entity, Runnable task, long delayTicks) {
+    return entityLater(plugin, entity, task, null, delayTicks);
+  }
+
+  public static BukkitTask entityLater(
+      Plugin plugin, Entity entity, Runnable task, Runnable retired, long delayTicks) {
+    Objects.requireNonNull(entity, "entity");
+    if (!isFolia()) return legacy(plugin).runTaskLater(plugin, task, delayTicks);
+    return scheduleEntity(
+        plugin,
+        task,
+        false,
+        retired,
+        handle ->
+            entity
+                .getScheduler()
+                .runDelayed(plugin, handle::execute, handle::retire, delay(delayTicks)));
+  }
+
+  public static BukkitTask entityTimer(
+      Plugin plugin, Entity entity, Runnable task, long delayTicks, long periodTicks) {
+    return entityTimer(plugin, entity, task, null, delayTicks, periodTicks);
+  }
+
+  /** Repeating owner callback with its cancellable handle available on the first native tick. */
+  public static BukkitTask entityTimer(
+      Plugin plugin, Entity entity, Consumer<BukkitTask> task, long delayTicks, long periodTicks) {
+    return entityTimer(plugin, entity, task, null, delayTicks, periodTicks);
+  }
+
+  public static BukkitTask entityTimer(
+      Plugin plugin,
+      Entity entity,
+      Consumer<BukkitTask> task,
+      Runnable retired,
+      long delayTicks,
+      long periodTicks) {
+    Objects.requireNonNull(entity, "entity");
+    Objects.requireNonNull(task, "task");
+    if (!isFolia()) {
+      java.util.concurrent.atomic.AtomicReference<BukkitTask> reference =
+          new java.util.concurrent.atomic.AtomicReference<>();
+      BukkitTask scheduled =
+          legacy(plugin)
+              .runTaskTimer(
+                  plugin,
+                  () -> {
+                    BukkitTask current = reference.get();
+                    if (current != null) task.accept(current);
+                  },
+                  delayTicks,
+                  periodTicks);
+      reference.set(scheduled);
+      return scheduled;
+    }
+    NativeTask handle = new NativeTask(plugin, task, true, true, retired);
+    return bind(
+        handle,
+        () ->
+            entity
+                .getScheduler()
+                .runAtFixedRate(
+                    plugin,
+                    handle::execute,
+                    handle::retire,
+                    delay(delayTicks),
+                    period(periodTicks)));
+  }
+
+  public static BukkitTask entityTimer(
+      Plugin plugin,
+      Entity entity,
+      Runnable task,
+      Runnable retired,
+      long delayTicks,
+      long periodTicks) {
+    Objects.requireNonNull(entity, "entity");
+    if (!isFolia()) {
+      return legacy(plugin).runTaskTimer(plugin, task, delayTicks, periodTicks);
+    }
+    return scheduleEntity(
+        plugin,
+        task,
+        true,
+        retired,
+        handle ->
+            entity
+                .getScheduler()
+                .runAtFixedRate(
+                    plugin,
+                    handle::execute,
+                    handle::retire,
+                    delay(delayTicks),
+                    period(periodTicks)));
+  }
+
+  public static BukkitTask region(Plugin plugin, Location location, Runnable task) {
+    Objects.requireNonNull(location, "location");
+    if (!isFolia()) return legacy(plugin).runTask(plugin, task);
+    Location target = location.clone();
+    return schedule(
+        plugin,
+        task,
+        true,
+        false,
+        null,
+        callback -> Bukkit.getRegionScheduler().run(plugin, target, callback));
+  }
+
+  public static BukkitTask regionLater(
+      Plugin plugin, Location location, Runnable task, long delayTicks) {
+    Objects.requireNonNull(location, "location");
+    if (!isFolia()) return legacy(plugin).runTaskLater(plugin, task, delayTicks);
+    Location target = location.clone();
+    return schedule(
+        plugin,
+        task,
+        true,
+        false,
+        null,
+        callback ->
+            Bukkit.getRegionScheduler().runDelayed(plugin, target, callback, delay(delayTicks)));
+  }
+
+  public static BukkitTask regionTimer(
+      Plugin plugin, Location location, Runnable task, long delayTicks, long periodTicks) {
+    Objects.requireNonNull(location, "location");
+    if (!isFolia()) {
+      return legacy(plugin).runTaskTimer(plugin, task, delayTicks, periodTicks);
+    }
+    Location target = location.clone();
+    return schedule(
+        plugin,
+        task,
+        true,
+        true,
+        null,
+        callback ->
+            Bukkit.getRegionScheduler()
+                .runAtFixedRate(plugin, target, callback, delay(delayTicks), period(periodTicks)));
+  }
+
+  /** Cancels a handle ID returned by this bridge, or a legacy Paper task ID. */
+  public static void cancelTask(int taskId) {
+    NativeTask task = TASKS.get(taskId);
+    if (task != null) task.cancel();
+    else if (!isFolia()) Bukkit.getScheduler().cancelTask(taskId);
+  }
+
+  public static void cancelTasks(Plugin plugin) {
+    TASKS.values().stream().filter(task -> task.getOwner() == plugin).forEach(NativeTask::cancel);
+    if (!isFolia()) legacy(plugin).cancelTasks(plugin);
+    else {
+      Bukkit.getGlobalRegionScheduler().cancelTasks(plugin);
+      Bukkit.getAsyncScheduler().cancelTasks(plugin);
+    }
+  }
+
+  /** A global authority thread is not an entity or location ownership check. */
+  public static boolean isGlobalThread() {
+    return isFolia() ? Bukkit.isGlobalTickThread() : Bukkit.isPrimaryThread();
+  }
+
+  public static boolean isEntityThread(Entity entity) {
+    return isFolia() ? Bukkit.isOwnedByCurrentRegion(entity) : Bukkit.isPrimaryThread();
+  }
+
+  public static boolean isRegionThread(Location location) {
+    return isFolia() ? Bukkit.isOwnedByCurrentRegion(location) : Bukkit.isPrimaryThread();
+  }
+
+  private static BukkitTask schedule(
+      Plugin plugin,
+      Runnable task,
+      boolean sync,
+      boolean repeating,
+      Runnable retired,
+      Function<Consumer<ScheduledTask>, ScheduledTask> scheduler) {
+    NativeTask handle = new NativeTask(plugin, task, sync, repeating, retired);
+    return bind(handle, () -> scheduler.apply(handle::execute));
+  }
+
+  private static BukkitTask scheduleEntity(
+      Plugin plugin,
+      Runnable task,
+      boolean repeating,
+      Runnable retired,
+      Function<NativeTask, ScheduledTask> scheduler) {
+    NativeTask handle = new NativeTask(plugin, task, true, repeating, retired);
+    return bind(handle, () -> scheduler.apply(handle));
+  }
+
+  private static BukkitTask bind(
+      NativeTask handle, java.util.function.Supplier<ScheduledTask> scheduler) {
+    TASKS.put(handle.id, handle);
+    try {
+      ScheduledTask scheduled = scheduler.get();
+      if (scheduled == null) handle.retire();
+      else handle.bind(scheduled);
+      return handle;
+    } catch (RuntimeException | Error failure) {
+      handle.cancel();
+      throw failure;
+    }
+  }
+
+  private static org.bukkit.scheduler.BukkitScheduler legacy(Plugin plugin) {
+    org.bukkit.Server server = plugin.getServer();
+    return server != null ? server.getScheduler() : Bukkit.getScheduler();
+  }
+
+  private static long delay(long ticks) {
+    return Math.max(1L, ticks);
+  }
+
+  private static long period(long ticks) {
+    if (ticks <= 0L) throw new IllegalArgumentException("periodTicks must be positive");
+    return ticks;
+  }
+
+  private static long millis(long ticks) {
+    return ticks > Long.MAX_VALUE / 50L ? Long.MAX_VALUE : ticks * 50L;
+  }
+
+  static void setFoliaForTests(Boolean value) {
+    foliaForTests = value;
+  }
+
+  static int pendingTaskCount() {
+    return TASKS.size();
+  }
+
+  private static final class NativeTask implements BukkitTask {
+    private final int id = NEXT_ID.getAndDecrement();
+    private final Plugin plugin;
+    private final Consumer<BukkitTask> task;
+    private final boolean sync;
+    private final boolean repeating;
+    private final Runnable retired;
+    private final AtomicBoolean cancelled = new AtomicBoolean();
+    private final AtomicBoolean completed = new AtomicBoolean();
+    private final AtomicBoolean retiredCalled = new AtomicBoolean();
+    private volatile ScheduledTask delegate;
+
+    private NativeTask(
+        Plugin plugin, Runnable task, boolean sync, boolean repeating, Runnable retired) {
+      this(plugin, ignored -> task.run(), sync, repeating, retired);
+      Objects.requireNonNull(task, "task");
+    }
+
+    private NativeTask(
+        Plugin plugin,
+        Consumer<BukkitTask> task,
+        boolean sync,
+        boolean repeating,
+        Runnable retired) {
+      this.plugin = Objects.requireNonNull(plugin, "plugin");
+      this.task = Objects.requireNonNull(task, "task");
+      this.sync = sync;
+      this.repeating = repeating;
+      this.retired = retired;
+    }
+
+    private void bind(ScheduledTask task) {
+      delegate = task;
+      if (cancelled.get()) task.cancel();
+    }
+
+    private void execute(ScheduledTask ignored) {
+      if (cancelled.get() || completed.get()) return;
+      try {
+        task.accept(this);
+      } catch (RuntimeException | Error failure) {
+        cancel();
+        throw failure;
+      } finally {
+        if (!repeating) finish();
+      }
+    }
+
+    private void retire() {
+      cancelled.set(true);
+      finish();
+      if (retired != null && retiredCalled.compareAndSet(false, true)) retired.run();
+    }
+
+    private void finish() {
+      completed.set(true);
+      TASKS.remove(id, this);
+    }
+
+    @Override
+    public int getTaskId() {
+      return id;
+    }
+
+    @Override
+    public Plugin getOwner() {
+      return plugin;
+    }
+
+    @Override
+    public boolean isSync() {
+      return sync;
+    }
+
+    @Override
+    public boolean isCancelled() {
+      ScheduledTask current = delegate;
+      return cancelled.get() || current != null && current.isCancelled();
+    }
+
+    @Override
+    public void cancel() {
+      cancelled.set(true);
+      finish();
+      ScheduledTask current = delegate;
+      if (current != null) current.cancel();
+    }
+  }
+}
