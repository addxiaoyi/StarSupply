+package dev.starcore.starcore.war;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+import java.time.Instant;
+import java.util.Optional;
+import java.util.UUID;
+import java.util.concurrent.Executors;
+import java.util.concurrent.TimeUnit;
+import java.util.logging.Logger;
+import org.bukkit.Location;
+import org.bukkit.plugin.Plugin;
+import org.junit.jupiter.api.Test;
+
+class SupplyLineSnapshotConcurrencyTest {
+  @Test
+  void locationsAndSnapshotsDoNotExposeMutableAuthority() {
+    Location origin = new Location(null, 1, 64, 2);
+    SupplyLine line = line(origin);
+    origin.setX(999);
+    line.start().setX(888);
+    assertEquals(1, line.start().getX());
+    line.addSupply(20);
+    SupplyLine copy = line.copy();
+    line.destroy();
+    assertEquals(20, copy.currentSupply());
+    assertEquals(SupplyLine.SupplyLineStatus.ACTIVE, copy.status());
+    assertEquals(0, line.currentSupply());
+  }
+
+  @Test
+  void readerNeverObservesATornMultiFieldTransition() throws Exception {
+    SupplyLine line = line(new Location(null, 0, 64, 0));
+    line.restoreState(100, 10, 1, false, Instant.EPOCH, SupplyLine.SupplyLineStatus.ACTIVE);
+    try (var pool = Executors.newFixedThreadPool(2)) {
+      var writer =
+          pool.submit(
+              () -> {
+                for (int i = 0; i < 10000; i++) {
+                  line.restoreState(
+                      200, 0, 0, true, Instant.EPOCH, SupplyLine.SupplyLineStatus.DESTROYED);
+                  line.restoreState(
+                      100, 10, 1, false, Instant.EPOCH, SupplyLine.SupplyLineStatus.ACTIVE);
+                }
+              });
+      var reader =
+          pool.submit(
+              () -> {
+                for (int i = 0; i < 10000; i++) {
+                  SupplyLine view = line.copy();
+                  if (view.status() == SupplyLine.SupplyLineStatus.ACTIVE) {
+                    assertEquals(100, view.capacity());
+                    assertEquals(10, view.currentSupply());
+                    assertFalse(view.isDisrupted());
+                    assertEquals(1, view.efficiency());
+                  } else {
+                    assertEquals(200, view.capacity());
+                    assertEquals(0, view.currentSupply());
+                    assertTrue(view.isDisrupted());
+                    assertEquals(0, view.efficiency());
+                  }
+                }
+              });
+      writer.get(10, TimeUnit.SECONDS);
+      reader.get(10, TimeUnit.SECONDS);
+    }
+  }
+
+  @Test
+  void serviceReadersAreDetachedWhileAuthorizedMutationsStillReachTheLiveLine() {
+    Plugin plugin = mock(Plugin.class);
+    when(plugin.getLogger()).thenReturn(Logger.getAnonymousLogger());
+    WarServiceImpl wars = mock(WarServiceImpl.class);
+    War war =
+        War.declare(
+            "supply",
+            dev.starcore.starcore.module.nation.model.NationId.random(),
+            dev.starcore.starcore.module.nation.model.NationId.random(),
+            WarGoal.TERRITORIAL);
+    war.start();
+    when(wars.getWar(war.id())).thenReturn(Optional.of(war));
+    BattlefieldService service = new BattlefieldService(plugin, wars);
+    var field =
+        service.createBattlefield(
+            war.id(), "field", new Location(null, 0, 64, 0), 32, war.defender());
+    SupplyLine owned =
+        service.createSupplyLine(
+            war.id(),
+            field.id(),
+            "route",
+            new Location(null, 0, 64, 0),
+            new Location(null, 20, 64, 0),
+            100);
+    service.getSupplyLine(owned.id()).orElseThrow().destroy();
+    assertEquals(
+        SupplyLine.SupplyLineStatus.ACTIVE,
+        service.getSupplyLine(owned.id()).orElseThrow().status());
+    service.disruptSupplyLine(owned.id(), war.aggressor());
+    assertTrue(owned.isDisrupted());
+    service.repairSupplyLine(owned.id(), war.defender());
+    assertFalse(service.getSupplyLine(owned.id()).orElseThrow().isDisrupted());
+    assertThrows(
+        UnsupportedOperationException.class,
+        () -> service.getSupplyLinesInBattlefield(field.id()).clear());
+  }
+
+  private static SupplyLine line(Location origin) {
+    return new SupplyLine(
+        UUID.randomUUID(),
+        UUID.randomUUID(),
+        UUID.randomUUID(),
+        "line",
+        origin,
+        new Location(null, 20, 64, 0),
+        100,
+        Instant.EPOCH);
+  }
+}
diff --git a/src/test/java/dev/starcore/starcore/war/WarConcurrentSnapshotTest.java b/src/test/java/dev/starcore/starcore/war/WarConcurrentSnapshotTest.java
new file mode 100644
index 0000000..0a08312
--- /dev/null
+++ b/src/test/java/dev/starcore/starcore/war/WarConcurrentSnapshotTest.java
@@ -0,0 +1,156 @@
+package dev.starcore.starcore.war;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import com.google.gson.Gson;
+import com.google.gson.JsonObject;
+import dev.starcore.starcore.module.nation.model.NationId;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Set;
+import java.util.UUID;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.Future;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.logging.Logger;
+import org.junit.jupiter.api.Test;
+
+class WarConcurrentSnapshotTest {
+  @Test
+  void publishedSetsAreDetachedFromLaterWarMutations() {
+    NationId attacker = NationId.random();
+    NationId defender = NationId.random();
+    NationId ally = NationId.random();
+    War war = War.declare("snapshot", attacker, defender, WarGoal.TERRITORIAL);
+    Set<NationId> allies = war.aggressorAllies();
+    Set<NationId> participants = war.allParticipants();
+    Set<NationId> peace = war.peaceRequests();
+    Set<UUID> receipts = war.appliedScoreEvents();
+    war.addAlly(ally, true);
+    war.requestPeace(attacker);
+    UUID scoreEvent = UUID.randomUUID();
+    assertTrue(war.addWarScoreOnce(scoreEvent, attacker, 1));
+    assertTrue(allies.isEmpty());
+    assertEquals(Set.of(attacker, defender), participants);
+    assertTrue(peace.isEmpty());
+    assertTrue(receipts.isEmpty());
+    assertEquals(Set.of(ally), war.aggressorAllies());
+    assertEquals(Set.of(attacker), war.peaceRequests());
+    assertEquals(Set.of(scoreEvent), war.appliedScoreEvents());
+    assertThrows(UnsupportedOperationException.class, () -> allies.add(ally));
+  }
+
+  @Test
+  void concurrentDuplicateScoreEventsAndPersistenceKeepScoreAndReceiptsTogether() throws Exception {
+    NationId attacker = NationId.random();
+    War war = War.declare("concurrent", attacker, NationId.random(), WarGoal.TERRITORIAL);
+    List<UUID> ids = new ArrayList<>();
+    for (int i = 0; i < 512; i++) ids.add(UUID.randomUUID());
+    WarJsonCodec codec = new WarJsonCodec(new Gson(), Logger.getAnonymousLogger());
+    CountDownLatch start = new CountDownLatch(1);
+    AtomicInteger finishedWriters = new AtomicInteger();
+    ExecutorService workers = Executors.newFixedThreadPool(3);
+    try {
+      Future<?> forward =
+          workers.submit(() -> applyEvents(start, finishedWriters, war, attacker, ids, false));
+      Future<?> reverse =
+          workers.submit(() -> applyEvents(start, finishedWriters, war, attacker, ids, true));
+      Future<?> snapshots =
+          workers.submit(
+              () -> {
+                await(start);
+                int observed = 0;
+                do {
+                  JsonObject encoded = codec.encode(war);
+                  assertEquals(
+                      encoded.getAsJsonArray("appliedScoreEvents").size(),
+                      encoded.get("aggressorWarScore").getAsInt(),
+                      "one receipt per credited point");
+                  War restored = codec.decode(encoded);
+                  assertNotNull(restored);
+                  assertEquals(restored.appliedScoreEvents().size(), restored.aggressorWarScore());
+                  observed++;
+                } while (finishedWriters.get() < 2 || observed < 100);
+              });
+      start.countDown();
+      forward.get(10, TimeUnit.SECONDS);
+      reverse.get(10, TimeUnit.SECONDS);
+      snapshots.get(10, TimeUnit.SECONDS);
+      assertEquals(ids.size(), war.aggressorWarScore());
+      assertEquals(ids.size(), war.appliedScoreEvents().size());
+    } finally {
+      start.countDown();
+      workers.shutdownNow();
+      assertTrue(workers.awaitTermination(5, TimeUnit.SECONDS));
+    }
+  }
+
+  @Test
+  void encodedLifecycleNeverPublishesNewStatusWithoutItsTransitionTimestamp() throws Exception {
+    War war = War.declare("lifecycle", NationId.random(), NationId.random(), WarGoal.TERRITORIAL);
+    WarJsonCodec codec = new WarJsonCodec(new Gson(), Logger.getAnonymousLogger());
+    CountDownLatch start = new CountDownLatch(1);
+    ExecutorService workers = Executors.newFixedThreadPool(2);
+    try {
+      Future<?> transitions =
+          workers.submit(
+              () -> {
+                await(start);
+                war.start();
+                for (int i = 0; i < 512; i++) {
+                  war.ceasefire();
+                  war.resume();
+                }
+                war.end();
+              });
+      Future<?> snapshots =
+          workers.submit(
+              () -> {
+                await(start);
+                for (int i = 0; i < 256; i++) {
+                  JsonObject encoded = codec.encode(war);
+                  String status = encoded.get("status").getAsString();
+                  if (!status.equals("PREPARATION")) assertTrue(encoded.has("startedAt"));
+                  assertEquals(status.equals("ENDED"), encoded.has("endedAt"));
+                }
+              });
+      start.countDown();
+      transitions.get(10, TimeUnit.SECONDS);
+      snapshots.get(10, TimeUnit.SECONDS);
+      assertTrue(war.isEnded());
+    } finally {
+      start.countDown();
+      workers.shutdownNow();
+      assertTrue(workers.awaitTermination(5, TimeUnit.SECONDS));
+    }
+  }
+
+  private static void applyEvents(
+      CountDownLatch start,
+      AtomicInteger finished,
+      War war,
+      NationId attacker,
+      List<UUID> ids,
+      boolean reverse) {
+    await(start);
+    try {
+      for (int i = 0; i < ids.size(); i++) {
+        war.addWarScoreOnce(ids.get(reverse ? ids.size() - i - 1 : i), attacker, 1);
+      }
+    } finally {
+      finished.incrementAndGet();
+    }
+  }
+
+  private static void await(CountDownLatch gate) {
+    try {
+      if (!gate.await(5, TimeUnit.SECONDS)) throw new AssertionError("workers did not start");
+    } catch (InterruptedException interrupted) {
+      Thread.currentThread().interrupt();
+      throw new AssertionError(interrupted);
+    }
+  }
+}
