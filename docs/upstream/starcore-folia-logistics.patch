+  /** Queues only ownership-safe work; no chunk is loaded while choosing its scheduler. */
+  private boolean dispatchRegion(ChunkCoordinate coordinate, Runnable operation) {
+    Location location = regionLocation(coordinate).orElse(null);
+    if (location == null || stopped) return false;
+    if (!CompatScheduler.isFolia()) {
+      operation.run();
+      return true;
+    }
+    return scheduleOwned(operation, callback -> CompatScheduler.region(plugin, location, callback));
+  }
+
+  private boolean scheduleOwned(Runnable operation, Function<Runnable, BukkitTask> scheduler) {
+    if (stopped) return false;
+    long expectedGeneration = generation.get();
+    AtomicReference<BukkitTask> reference = new AtomicReference<>();
+    AtomicBoolean completed = new AtomicBoolean();
+    BukkitTask task =
+        scheduler.apply(
+            () -> {
+              try {
+                if (!stopped && generation.get() == expectedGeneration) operation.run();
+              } finally {
+                completed.set(true);
+                BukkitTask current = reference.get();
+                if (current != null) regionTasks.remove(current);
+              }
+            });
+    reference.set(task);
+    if (task == null) return false;
+    if (!completed.get()) regionTasks.add(task);
+    if (completed.get()) regionTasks.remove(task);
+    if (stopped || generation.get() != expectedGeneration) {
+      task.cancel();
+      regionTasks.remove(task);
+    }
+    return true;
+  }
+
