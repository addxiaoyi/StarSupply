+package dev.starcore.starcore.core.config;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.util.List;
+import org.bukkit.configuration.file.YamlConfiguration;
+import org.junit.jupiter.api.Test;
+
+class ConfigurationServiceFoliaProfileTest {
+  private static final List<String> REQUIRED =
+      List.of(
+          "nation",
+          "economy",
+          "government",
+          "resolution",
+          "treasury",
+          "diplomacy",
+          "resource",
+          "technology",
+          "policy",
+          "officer",
+          "army",
+          "war",
+          "siege",
+          "taxation",
+          "event");
+
+  @Test
+  void profileIsExplicitAndPreservesNormalModuleDefaults() {
+    ConfigurationService service = new ConfigurationService(new YamlConfiguration());
+    assertThat(service.foliaLogisticsProfile()).isFalse();
+    assertThat(service.moduleEnabled("clan", true)).isTrue();
+    assertThat(service.moduleEnabled("resource")).isFalse();
+  }
+
+  @Test
+  void enabledProfileKeepsWholeSupplyClosureAndExcludesUnauditedModules() {
+    YamlConfiguration yaml = new YamlConfiguration();
+    yaml.set("platform.folia-logistics-profile", true);
+    for (String module : REQUIRED) yaml.set("modules." + module, true);
+    yaml.set("modules.religion", true);
+    ConfigurationService service = new ConfigurationService(yaml);
+    for (String module : REQUIRED) assertThat(service.moduleEnabled(module)).as(module).isTrue();
+    assertThat(service.moduleEnabled("religion", true)).isFalse();
+    assertThat(service.moduleEnabled("satellite", true)).isFalse();
+    yaml.set("modules.siege", false);
+    assertThat(service.moduleEnabled("siege", true)).isFalse();
+  }
+}
