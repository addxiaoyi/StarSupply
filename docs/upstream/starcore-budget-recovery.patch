+package dev.starcore.starcore.module.treasury;
+
+import static org.mockito.Mockito.*;
+
+import dev.starcore.starcore.core.persistence.PersistenceService;
+import dev.starcore.starcore.core.scheduler.StarCoreScheduler;
+import dev.starcore.starcore.module.nation.model.NationId;
+import java.math.BigDecimal;
+import java.nio.file.Path;
+import java.time.Clock;
+import java.time.Instant;
+import java.time.ZoneOffset;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.logging.Logger;
+import org.bukkit.plugin.java.JavaPlugin;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.io.TempDir;
+
+/** Real durable treasury authority shared by budget file and SQL failure tests. */
+abstract class BudgetTestSupport {
+  static final Clock CLOCK =
+      Clock.fixed(Instant.parse("2026-11-18T12:00:00.123456789Z"), ZoneOffset.UTC);
+  @TempDir Path temporary;
+  final NationId nation = NationId.random();
+  PersistenceService persistence;
+  TreasuryModule treasury;
+
+  @BeforeEach
+  void openTreasury() {
+    var plugin = mock(JavaPlugin.class);
+    when(plugin.getDataFolder()).thenReturn(temporary.toFile());
+    when(plugin.getLogger()).thenReturn(Logger.getAnonymousLogger());
+    persistence = new PersistenceService(plugin, mock(StarCoreScheduler.class));
+    persistence.start();
+    treasury = spy(NavyTreasuryFixture.open(persistence, new AtomicInteger()));
+    treasury.deposit(nation, new BigDecimal("100.00"));
+    clearInvocations(treasury);
+  }
+
+  @AfterEach
+  void closeTreasury() {
+    if (persistence != null) persistence.stop();
+  }
+
+  NationSpendingService.SpendRequest request() {
+    return new NationSpendingService.SpendRequest(
+        "budget-shared-test",
+        nation,
+        new BigDecimal("25.00"),
+        NationSpendingService.SpendingCategory.NATIONAL_EVENT,
+        "policy");
+  }
+
+  BudgetStateStorage fileStorage() {
+    return new PersistenceBudgetStateStorage("budget-test", persistence);
+  }
+}
