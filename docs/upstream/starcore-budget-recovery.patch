+    assertThrows(IllegalStateException.class, service::recoverPayments);
+    balance("1000");
+  }
+
+  static final class InterruptedProcess extends Error {}
+
+  static final class FaultStorage implements BudgetStateStorage {
+    final BudgetStateStorage delegate;
+    int saves, failAt = -1;
+    boolean after, failBeforeNext, failAfterNext;
+
+    FaultStorage(BudgetStateStorage delegate) {
+      this.delegate = delegate;
+    }
+
+    void interruptAfter(int offset, boolean after) {
+      failAt = saves + offset;
+      this.after = after;
+    }
+
+    public Properties load() {
+      return delegate.load();
+    }
+
+    public Optional<BudgetStateRefresh> refreshIfChanged() {
+      return delegate.refreshIfChanged();
+    }
+
+    public void acceptRefresh(BudgetStateRefresh refresh) {
+      delegate.acceptRefresh(refresh);
+    }
+
+    public void save(Properties next) {
+      saves++;
+      if (failBeforeNext) {
+        failBeforeNext = false;
+        throw new IllegalStateException("before save");
+      }
+      if (saves == failAt && !after) throw new InterruptedProcess();
+      delegate.save(next);
+      if (saves == failAt && after) throw new InterruptedProcess();
+      if (failAfterNext) {
+        failAfterNext = false;
+        throw new IllegalStateException("lost save reply");
+      }
+    }
+  }
