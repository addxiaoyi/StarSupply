+    assertEquals(money("160"), service.getBudgetExecutionReport(bill).totalSpent());
+    service.refund("pool");
+    balance("500");
+    assertEquals(money("0"), service.getBudgetExecutionReport(bill).totalSpent());
+  }
+
+  @Test
+  void rejectedPreflightHasNoIntentAndCanRetryAfterFunding() {
