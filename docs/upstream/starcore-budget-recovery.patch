+  @Test
+  void lostTreasuryWriteReplyIsConfirmedWithoutAnotherDebit() {
+    treasuryFailure.set(2);
+    assertTrue(service.spend(request("lost-reply", "160")).applied());
+    balance("840");
+    reopen();
+    service.spend(request("lost-reply", "160"));
+    balance("840");
+  }
+
+  @Test
+  void corruptedOrMissingAuthorityCannotLoadOldBackup() throws Exception {
+    service.spend(request("saved", "160"));
+    service.disable(null);
+    Path file = persistence.namespacePath("budget-recovery-test").resolve("budgets.properties");
+    Files.writeString(file, "schema.version=3\n");
+    assertThrows(IllegalStateException.class, this::reopen);
+    Files.delete(file);
+    assertThrows(IllegalStateException.class, this::reopen);
+    balance("840");
+  }
