+
+  void reopen() {
+    if (service != null) service.disable(null);
+    treasury = NavyTreasuryFixture.open(persistence, treasuryFailure);
+    storage =
+        new FaultStorage(new PersistenceBudgetStateStorage("budget-recovery-test", persistence));
+    service = new BudgetServiceImpl(storage, treasury, treasury, clock);
+  }
+
+  static BigDecimal money(String value) {
+    return new BigDecimal(value).setScale(2);
+  }
+
+  NationSpendingService.SpendRequest request(String id, String amount) {
+    return new NationSpendingService.SpendRequest(
+        id,
+        nation,
+        money(amount),
+        NationSpendingService.SpendingCategory.MILITARY,
+        "Fleet purchase");
+  }
+
+  void balance(String expected) {
+    assertEquals(0, money(expected).compareTo(treasury.balance(nation)));
+  }
+
+  UUID funded(String amount) {
+    var id = approved(amount);
+    assertTrue(service.executeBudget(id));
+    return id;
+  }
+
+  UUID approved(String amount) {
+    var bill = service.createBudgetDraft(nation, 2026, 11);
+    service.addBudgetEntry(
+        bill.billId(), BudgetService.BudgetCategory.MILITARY, "Military pool", money(amount));
+    service.submitBudget(bill.billId());
+    assertTrue(service.approveBudget(bill.billId(), "Founder"));
+    return bill.billId();
+  }
+
+  @ParameterizedTest
+  @CsvSource({"1,false", "1,true", "2,false", "2,true"})
+  void spendingInterruptionAtEachSnapshotBoundaryRecoversSingleDebit(int offset, boolean after) {
+    var request = request("crash-spend", "160");
+    storage.interruptAfter(offset, after);
+    assertThrows(InterruptedProcess.class, () -> service.spend(request));
+    reopen();
+    service.spend(request);
+    balance("840");
+    reopen();
+    assertEquals(
+        NationSpendingService.SpendingStatus.ALREADY_APPLIED, service.spend(request).status());
+    balance("840");
+    assertTrue(service.pendingPayments().isEmpty());
+  }
+
+  @ParameterizedTest
+  @CsvSource({"1,false", "1,true", "2,false", "2,true"})
+  void fundingInterruptionAtEachSnapshotBoundaryCannotFundTwice(int offset, boolean after) {
+    UUID id = approved("500");
+    storage.interruptAfter(offset, after);
+    assertThrows(InterruptedProcess.class, () -> service.executeBudget(id));
+    reopen();
+    assertTrue(service.executeBudget(id));
+    balance("500");
+    reopen();
+    assertTrue(service.executeBudget(id));
+    balance("500");
+    assertEquals(
+        BudgetService.BudgetBill.BudgetStatus.EXECUTED,
+        service.getBudget(id).orElseThrow().status());
+  }
+
+  @ParameterizedTest
+  @CsvSource({"1,false", "1,true", "2,false", "2,true"})
+  void refundInterruptionCannotCreditTwice(int offset, boolean after) {
+    var request = request("crash-refund", "160");
+    service.spend(request);
+    storage.interruptAfter(offset, after);
+    assertThrows(InterruptedProcess.class, () -> service.refund(request.transactionId()));
+    reopen();
+    assertTrue(service.refund(request.transactionId()));
+    balance("1000");
+    reopen();
+    assertTrue(service.refund(request.transactionId()));
+    balance("1000");
+    assertTrue(service.spendingReceipt(request.transactionId()).orElseThrow().refunded());
+  }
+
+  @Test
+  void originalCrashReproductionNowRestores840AndNever680() {
