@@ -0,0 +1,98 @@
+package dev.starcore.starcore.module.treasury;
+
+import java.nio.charset.StandardCharsets;
+import java.util.Objects;
+import java.util.UUID;
+
+/** Durable original quote; a prepared operation reserves admission until it is settled. */
+record BudgetMoneyOperation(
+    Kind kind,
+    Status status,
+    UUID subjectId,
+    String requestId,
+    NationSpendingService.SpendingCategory category,
+    String description,
+    NationSpendingReceipt quote) {
+  enum Kind {
+    FUND,
+    SPEND,
+    REFUND
+  }
+
+  enum Status {
+    PREPARED,
+    APPLIED
+  }
+
+  BudgetMoneyOperation {
+    Objects.requireNonNull(kind);
+    Objects.requireNonNull(status);
+    Objects.requireNonNull(subjectId);
+    Objects.requireNonNull(requestId);
+    Objects.requireNonNull(category);
+    Objects.requireNonNull(description);
+    Objects.requireNonNull(quote);
+    if (requestId.isBlank()
+        || requestId.length() > 4096
+        || description.length() > 16384
+        || !subjectId.equals(quote.transactionId())
+        || quote.refunded()) throw new IllegalArgumentException("Invalid budget money operation");
+    if (kind != Kind.FUND && !subjectId.equals(requestUuid(requestId)))
+      throw new IllegalArgumentException("Budget original request identity mismatch");
+    if (kind == Kind.FUND
+        && (!requestId.equals("budget-funding:" + subjectId)
+            || quote.budgetAmount().signum() != 0
+            || category != NationSpendingService.SpendingCategory.OTHER
+            || quote.category() != BudgetService.BudgetCategory.OTHER
+            || !description.equals("Budget funding: " + subjectId)))
+      throw new IllegalArgumentException("Invalid budget funding quote");
+    if (!quote.description().equals(description.trim()))
+      throw new IllegalArgumentException("Budget original description mismatch");
+    if (kind == Kind.SPEND && quote.category() != budgetCategory(category))
+      throw new IllegalArgumentException("Budget original category mismatch");
+  }
+
+  static BudgetService.BudgetCategory budgetCategory(
+      NationSpendingService.SpendingCategory category) {
+    return switch (category) {
+      case TERRITORY_RENT, TERRITORY_LEASE_FEE -> BudgetService.BudgetCategory.INFRASTRUCTURE;
+      case RESEARCH -> BudgetService.BudgetCategory.RESEARCH;
+      case MILITARY -> BudgetService.BudgetCategory.MILITARY;
+      case TREATY -> BudgetService.BudgetCategory.DIPLOMACY;
+      case NATIONAL_EVENT -> BudgetService.BudgetCategory.ADMINISTRATION;
+      case OTHER -> BudgetService.BudgetCategory.OTHER;
+    };
+  }
+
+  String key() {
+    return kind.name() + ":" + subjectId;
+  }
+
+  BudgetMoneyOperation applied() {
+    return new BudgetMoneyOperation(
+        kind, Status.APPLIED, subjectId, requestId, category, description, quote);
+  }
+
+  static UUID requestUuid(String request) {
+    return UUID.nameUUIDFromBytes(request.getBytes(StandardCharsets.UTF_8));
+  }
+
+  NationSpendingService.SpendRequest debitRequest() {
+    return new NationSpendingService.SpendRequest(
+        "budget:v3:" + kind.name() + ":" + subjectId,
+        quote.nationId(),
+        quote.treasuryAmount(),
+        category,
+        "Budget " + kind.name() + ":" + requestId);
+  }
+
+  NationCreditService.CreditRequest refundRequest() {
+    // Keep the historical key so retries of pre-v3 refunds cannot credit again.
+    return new NationCreditService.CreditRequest(
+        "budget-spending-refund:" + subjectId,
+        quote.nationId(),
+        quote.treasuryAmount(),
+        NationCreditService.CreditCategory.BUDGET_SPENDING_REFUND,
+        "Budget spending refund: " + quote.description());
+  }
+}
