+    assertTrue(service.refund(request.transactionId()));
+    balance("900");
+    assertEquals(money("0"), service.getBudgetExecutionReport(bill).totalSpent());
+  }
+
+  @Test
+  void fullyFundedPoolDoesNotDebitTreasuryAgain() {
+    UUID bill = funded("500");
+    service.spend(request("pool", "160"));
