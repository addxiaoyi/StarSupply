+    var request =
+        new NationSpendingService.SpendRequest(
+            "exact-id", nation, money("25"), category, "  exact description  ");
+    service.spend(request);
+    reopen();
+    var receipt = service.spendingReceipt(request.transactionId()).orElseThrow();
+    assertEquals(category, receipt.category());
+    assertEquals(request.description(), receipt.description());
+    assertThrows(
+        IllegalArgumentException.class,
+        () ->
+            service.spend(
+                new NationSpendingService.SpendRequest(
+                    "exact-id", nation, money("25"), category, "exact description")));
+    balance("975");
+  }
+
+  @Test
+  void categoryAliasCannotReplayAnotherOriginalQuote() {
+    service.spend(
+        new NationSpendingService.SpendRequest(
+            "rent",
+            nation,
+            money("25"),
+            NationSpendingService.SpendingCategory.TERRITORY_RENT,
+            "rent"));
+    assertThrows(
+        IllegalArgumentException.class,
+        () ->
+            service.spend(
+                new NationSpendingService.SpendRequest(
+                    "rent",
+                    nation,
+                    money("25"),
+                    NationSpendingService.SpendingCategory.TERRITORY_LEASE_FEE,
+                    "rent")));
+    balance("975");
+  }
+
+  @Test
+  void failedPreparationDoesNotSpendAndLostBudgetWriteReplyIsReadBack() {
+    var request = request("no-prepare", "160");
+    storage.failBeforeNext = true;
+    assertThrows(IllegalStateException.class, () -> service.spend(request));
+    balance("1000");
+    storage.failAfterNext = true;
+    assertTrue(service.spend(request).applied());
+    balance("840");
+    reopen();
+    service.spend(request);
+    balance("840");
+  }
+
+  @Test
+  void treasuryFailureKeepsQuoteUntilRecoveredRatherThanCompensating() {
+    treasuryFailure.set(1);
+    var request = request("treasury-failure", "160");
+    assertThrows(IllegalStateException.class, () -> service.spend(request));
+    balance("1000");
+    assertEquals(1, service.pendingPayments().size());
+    reopen();
+    service.recoverPayments();
+    balance("840");
+  }
