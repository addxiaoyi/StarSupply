@@ -0,0 +1,90 @@
+package dev.starcore.starcore.module.nation;
+
+import static org.mockito.ArgumentMatchers.anyLong;
+import static org.mockito.Mockito.*;
+
+import dev.starcore.starcore.core.config.ConfigurationService;
+import dev.starcore.starcore.core.persistence.PersistenceService;
+import dev.starcore.starcore.foundation.territory.TerritoryService;
+import dev.starcore.starcore.module.nation.model.Nation;
+import java.nio.file.Path;
+import java.util.List;
+import java.util.Properties;
+import java.util.logging.Logger;
+import org.bukkit.plugin.java.JavaPlugin;
+
+/** Real nation authority and atomic files, with faults only at the storage acknowledgement seam. */
+public final class ExerciseNationFixture {
+  public enum Fault {
+    NONE,
+    BEFORE_SAVE,
+    LOST_REPLY,
+    AFTER_COMMIT_ERROR,
+    UNREADABLE_AFTER_COMMIT
+  }
+
+  private final PersistenceService persistence;
+  private Fault fault = Fault.NONE;
+  private boolean unreadable;
+  private NationModule module;
+
+  public ExerciseNationFixture(Path root, List<Nation> seed) {
+    var plugin = mock(JavaPlugin.class);
+    when(plugin.getDataFolder()).thenReturn(root.toFile());
+    when(plugin.getLogger()).thenReturn(Logger.getAnonymousLogger());
+    persistence = new PersistenceService(plugin, null);
+    persistence.start();
+    if (seed != null)
+      new PersistenceNationStateStorage("nation", persistence)
+          .save(NationStateCodec.toProperties(seed));
+    reload();
+  }
+
+  public NationModule module() {
+    return module;
+  }
+
+  public void fault(Fault next) {
+    fault = next;
+  }
+
+  public void reload() {
+    unreadable = false;
+    var files = new PersistenceNationStateStorage("nation", persistence);
+    module =
+        configured(
+            new NationStateStorage() {
+              public Properties load() {
+                if (unreadable) throw new IllegalStateException("injected unreadable authority");
+                return files.load();
+              }
+
+              public void save(Properties value) {
+                Fault current = fault;
+                fault = Fault.NONE;
+                if (current == Fault.BEFORE_SAVE)
+                  throw new IllegalStateException("injected before save");
+                files.save(value);
+                if (current == Fault.AFTER_COMMIT_ERROR)
+                  throw new AssertionError("injected interruption");
+                if (current == Fault.UNREADABLE_AFTER_COMMIT) unreadable = true;
+                if (current == Fault.LOST_REPLY || current == Fault.UNREADABLE_AFTER_COMMIT)
+                  throw new IllegalStateException("injected lost reply");
+              }
+            });
+  }
+
+  static NationModule configured(NationStateStorage storage) {
+    var module = new NationModule(mock(TerritoryService.class), storage);
+    var config = mock(ConfigurationService.class);
+    when(config.nationLevelForExperience(anyLong())).thenReturn(1);
+    try {
+      var field = NationModule.class.getDeclaredField("configuration");
+      field.setAccessible(true);
+      field.set(module, config);
+    } catch (ReflectiveOperationException failure) {
+      throw new AssertionError(failure);
+    }
+    return module;
+  }
+}
