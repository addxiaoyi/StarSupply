@@ -0,0 +1,25 @@
+package dev.starcore.starcore.module.army.exercise;
+
+import java.time.Instant;
+import java.util.*;
+
+record ExerciseSnapshot(
+    Map<UUID, Exercise> exercises,
+    Map<UUID, ExerciseResult> results,
+    Set<String> rewarded,
+    Map<String, Instant> cooldowns) {
+  ExerciseSnapshot {
+    exercises = Map.copyOf(exercises);
+    results = Map.copyOf(results);
+    rewarded = Set.copyOf(rewarded);
+    cooldowns = Map.copyOf(cooldowns);
+  }
+
+  static ExerciseSnapshot empty() {
+    return new ExerciseSnapshot(Map.of(), Map.of(), Set.of(), Map.of());
+  }
+
+  static String rewardId(UUID exercise, UUID nation) {
+    return "exercise-reward:" + exercise + ":" + nation;
+  }
+}
diff --git a/src/main/java/dev/starcore/starcore/module/army/exercise/ExerciseStateCodec.java b/src/main/java/dev/starcore/starcore/module/army/exercise/ExerciseStateCodec.java
new file mode 100644
index 0000000..6b5d027
--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/module/army/exercise/ExerciseStateCodec.java
@@ -0,0 +1,324 @@
+package dev.starcore.starcore.module.army.exercise;
+
+import java.nio.charset.StandardCharsets;
+import java.time.Instant;
+import java.util.*;
+
+final class ExerciseStateCodec {
+  Properties encode(ExerciseSnapshot state) {
+    Properties out = new Properties();
+    put(out, "version", 1);
+    var exercises =
+        state.exercises().values().stream()
+            .sorted(Comparator.comparing(e -> e.id().toString()))
+            .toList();
+    put(out, "count", exercises.size());
+    for (int i = 0; i < exercises.size(); i++) {
+      var e = exercises.get(i);
+      validate(e);
+      String p = "exercise." + i + ".";
+      put(out, p + "id", e.id());
+      put(out, p + "name", e.name());
+      put(out, p + "organizer", e.organizerId());
+      put(out, p + "type", e.type());
+      put(out, p + "state", e.state());
+      put(out, p + "created", e.createdAt());
+      put(out, p + "started", e.startedAt());
+      put(out, p + "ended", e.endedAt());
+      put(out, p + "red", e.redSideId().orElse(null));
+      put(out, p + "blue", e.blueSideId().orElse(null));
+      put(out, p + "battles", e.totalBattles());
+      put(out, p + "redWins", e.redSideWins());
+      put(out, p + "blueWins", e.blueSideWins());
+      put(out, p + "world", e.world().orElse(null));
+      put(out, p + "x", e.centerX().orElse(0));
+      put(out, p + "z", e.centerZ().orElse(0));
+      put(out, p + "radius", e.radius());
+      var c = e.config();
+      put(out, p + "config.min", c.minParticipants());
+      put(out, p + "config.max", c.maxParticipants());
+      put(out, p + "config.duration", c.maxDurationMinutes());
+      put(out, p + "config.level", c.minLevel());
+      put(out, p + "config.minSoldiers", c.minSoldiersPerParticipant());
+      put(out, p + "config.maxSoldiers", c.maxSoldiersPerParticipant());
+      put(out, p + "config.gain", c.moraleGainPerVictory());
+      put(out, p + "config.penalty", c.moralePenaltyForDefeat());
+      put(out, p + "config.xp", c.experienceGainPerParticipant());
+      put(out, p + "config.auto", c.autoStart());
+      put(out, p + "config.rewards", c.rewardsEnabled());
+      put(out, p + "participants", e.participantCount());
+      for (int j = 0; j < e.participantCount(); j++) {
+        var v = e.participants().get(j);
+        String k = p + "participant." + j + ".";
+        put(out, k + "nation", v.nationId());
+        put(out, k + "name", v.nationName());
+        put(out, k + "soldiers", v.soldierCount());
+        put(out, k + "role", v.role());
+        put(out, k + "casualties", v.casualties());
+        put(out, k + "kills", v.kills());
+        put(out, k + "morale", v.morale());
+        put(out, k + "joined", v.joinedAt());
+        put(out, k + "active", v.isActive());
+        put(out, k + "battles", v.battles());
+        put(out, k + "wins", v.wins());
+        put(out, k + "losses", v.losses());
+      }
+      var result = state.results().get(e.id());
+      put(out, p + "result", result != null);
+      if (result != null) {
+        // Version 1 fixes the deterministic ranking/award algorithm; all inputs are durable above.
+        if (!ExerciseSettlement.build(e, result.endReason()).equals(result))
+          throw new IllegalArgumentException("Exercise result mismatch");
+        put(out, p + "reason", result.endReason());
+      }
+    }
+    if (!state.exercises().keySet().containsAll(state.results().keySet()))
+      throw new IllegalArgumentException("Orphan exercise result");
+    var rewarded = state.rewarded().stream().sorted().toList();
+    put(out, "rewarded.count", rewarded.size());
+    Set<String> valid = new HashSet<>();
+    for (var result : state.results().values())
+      for (var pr : result.participantResults())
+        if (pr.experienceGained() > 0)
+          valid.add(ExerciseSnapshot.rewardId(result.exerciseId(), pr.nationId()));
+    if (!valid.containsAll(rewarded))
+      throw new IllegalArgumentException("Unknown exercise reward receipt");
+    for (int i = 0; i < rewarded.size(); i++) put(out, "rewarded." + i, rewarded.get(i));
+    var keys = state.cooldowns().keySet().stream().sorted().toList();
+    put(out, "cooldown.count", keys.size());
+    for (int i = 0; i < keys.size(); i++) {
+      put(out, "cooldown." + i + ".key", keys.get(i));
+      put(out, "cooldown." + i + ".time", state.cooldowns().get(keys.get(i)));
+    }
+    put(out, "sha256", checksum(out));
+    return out;
+  }
+
+  ExerciseSnapshot decode(Properties in) {
+    if (in.isEmpty()) return ExerciseSnapshot.empty();
+    if (!"1".equals(text(in, "version")) || !checksum(in).equals(text(in, "sha256")))
+      throw new IllegalArgumentException("Invalid exercise snapshot checksum/version");
+    var exercises = new LinkedHashMap<UUID, Exercise>();
+    var results = new LinkedHashMap<UUID, ExerciseResult>();
+    for (int i = 0; i < count(in, "count"); i++) {
+      String p = "exercise." + i + ".";
+      var c =
+          new ExerciseConfig(
+              number(in, p + "config.min"),
+              number(in, p + "config.max"),
+              number(in, p + "config.duration"),
+              number(in, p + "config.level"),
+              number(in, p + "config.minSoldiers"),
+              number(in, p + "config.maxSoldiers"),
+              decimal(in, p + "config.gain"),
+              decimal(in, p + "config.penalty"),
+              decimal(in, p + "config.xp"),
+              flag(in, p + "config.auto"),
+              flag(in, p + "config.rewards"));
+      var e =
+          new Exercise(
+              uuid(in, p + "id"),
+              text(in, p + "name"),
+              uuid(in, p + "organizer"),
+              ExerciseType.valueOf(text(in, p + "type")),
+              ExerciseState.valueOf(text(in, p + "state")),
+              Instant.parse(text(in, p + "created")),
+              c);
+      e.restoreProgress(
+          time(in, p + "started"),
+          time(in, p + "ended"),
+          number(in, p + "battles"),
+          number(in, p + "redWins"),
+          number(in, p + "blueWins"));
+      String red = text(in, p + "red"), blue = text(in, p + "blue");
+      e.setRedSideId(red.isEmpty() ? null : UUID.fromString(red));
+      e.setBlueSideId(blue.isEmpty() ? null : UUID.fromString(blue));
+      String world = text(in, p + "world");
+      e.setLocation(
+          world.isEmpty() ? null : world,
+          number(in, p + "x"),
+          number(in, p + "z"),
+          number(in, p + "radius"));
+      int size = count(in, p + "participants");
+      if (size > c.maxParticipants())
+        throw new IllegalArgumentException("Exercise participant overflow");
+      for (int j = 0; j < size; j++) {
+        String k = p + "participant." + j + ".";
+        var v =
+            new ExerciseParticipant(
+                uuid(in, k + "nation"),
+                text(in, k + "name"),
+                number(in, k + "soldiers"),
+                ExerciseRole.valueOf(text(in, k + "role")));
+        v.restoreProgress(
+            number(in, k + "casualties"),
+            number(in, k + "kills"),
+            decimal(in, k + "morale"),
+            Instant.parse(text(in, k + "joined")),
+            flag(in, k + "active"),
+            number(in, k + "battles"),
+            number(in, k + "wins"),
+            number(in, k + "losses"));
+        if (!e.addParticipant(v))
+          throw new IllegalArgumentException("Duplicate exercise participant");
+      }
+      validate(e);
+      if (exercises.put(e.id(), e) != null)
+        throw new IllegalArgumentException("Duplicate exercise");
+      boolean terminal = flag(in, p + "result");
+      if (terminal != e.state().isTerminal())
+        throw new IllegalArgumentException("Missing exercise settlement");
+      if (terminal) results.put(e.id(), ExerciseSettlement.build(e, text(in, p + "reason")));
+    }
+    Set<String> rewarded = new HashSet<>();
+    for (int i = 0; i < count(in, "rewarded.count"); i++)
+      if (!rewarded.add(text(in, "rewarded." + i)))
+        throw new IllegalArgumentException("Duplicate reward");
+    Map<String, Instant> cooldowns = new HashMap<>();
+    for (int i = 0; i < count(in, "cooldown.count"); i++) {
+      String key = text(in, "cooldown." + i + ".key");
+      String[] ids = key.split(":");
+      if (ids.length != 3) throw new IllegalArgumentException("Invalid cooldown");
+      var e = exercises.get(UUID.fromString(ids[0]));
+      if (e == null
+          || e.state().isTerminal()
+          || e.startedAt() == null
+          || e.getParticipant(UUID.fromString(ids[1])).isEmpty()
+          || e.getParticipant(UUID.fromString(ids[2])).isEmpty()
+          || ids[1].compareTo(ids[2]) >= 0)
+        throw new IllegalArgumentException("Invalid cooldown participants");
+      Instant lastBattle = Instant.parse(text(in, "cooldown." + i + ".time"));
+      if (lastBattle.isBefore(e.startedAt()))
+        throw new IllegalArgumentException("Invalid cooldown timestamp");
+      if (cooldowns.put(key, lastBattle) != null)
+        throw new IllegalArgumentException("Duplicate cooldown");
+    }
+    var state = new ExerciseSnapshot(exercises, results, rewarded, cooldowns);
+    if (!encode(state).equals(in))
+      throw new IllegalArgumentException("Exercise snapshot fields incomplete or inconsistent");
+    return state;
+  }
+
+  private void validate(Exercise e) {
+    if (e.state().isTerminal() != (e.endedAt() != null)
+        || (e.startedAt() != null && e.startedAt().isBefore(e.createdAt()))
+        || (e.endedAt() != null
+            && e.endedAt().isBefore(e.startedAt() == null ? e.createdAt() : e.startedAt()))
+        || ((e.state() == ExerciseState.IN_PROGRESS
+                || e.state() == ExerciseState.PAUSED
+                || e.state() == ExerciseState.COMPLETED
+                || e.state() == ExerciseState.TIMEOUT)
+            && e.startedAt() == null)
+        || (e.state().canJoin() && e.startedAt() != null))
+      throw new IllegalArgumentException("Invalid exercise lifecycle");
+    if (e.startedAt() != null
+        && e.type().requiresTwoSides()
+        && (e.redSideId().isEmpty()
+            || e.blueSideId().isEmpty()
+            || e.redSideId().equals(e.blueSideId())
+            || e.getParticipant(e.redSideId().orElseThrow()).isEmpty()
+            || e.getParticipant(e.blueSideId().orElseThrow()).isEmpty()))
+      throw new IllegalArgumentException("Invalid exercise sides");
+    if (e.radius() < 0
+        || e.radius() > 1_000_000
+        || (e.world().isEmpty() && e.radius() != 0)
+        || (e.world().isPresent()
+            && (e.world().orElseThrow().isBlank()
+                || e.world().orElseThrow().length() > 128
+                || e.radius() == 0))) throw new IllegalArgumentException("Invalid exercise zone");
+    long battles = 0, wins = 0, losses = 0, kills = 0, casualties = 0, redWins = 0, blueWins = 0;
+    for (var p : e.participants()) {
+      if (p.soldierCount() < e.config().minSoldiersPerParticipant()
+          || p.soldierCount() > e.config().maxSoldiersPerParticipant()
+          || p.joinedAt().isBefore(e.createdAt())
+          || (e.startedAt() != null && p.joinedAt().isAfter(e.startedAt()))
+          || p.isActive() != (p.effectiveSoldiers() > 0)
+          || (e.type().requiresTwoSides()
+              ? p.role() != ExerciseRole.ATTACKER && p.role() != ExerciseRole.DEFENDER
+              : p.role() != ExerciseRole.FREE))
+        throw new IllegalArgumentException("Invalid exercise participant");
+      battles += p.battles();
+      wins += p.wins();
+      losses += p.losses();
+      kills += p.kills();
+      casualties += p.casualties();
+      if (p.role() == ExerciseRole.ATTACKER) redWins += p.wins();
+      if (p.role() == ExerciseRole.DEFENDER) blueWins += p.wins();
+    }
+    if (battles != 2L * e.totalBattles()
+        || wins != losses
+        || kills > casualties
+        || redWins != e.redSideWins()
+        || blueWins != e.blueSideWins()
+        || (e.startedAt() == null && (battles != 0 || casualties != 0 || kills != 0))
+        || (e.startedAt() != null && e.participantCount() < e.config().minParticipants()))
+      throw new IllegalArgumentException("Inconsistent exercise statistics");
+    if (e.type().requiresTwoSides()
+        && e.startedAt() != null
+        && (e.getParticipant(e.redSideId().orElseThrow()).orElseThrow().role()
+                != ExerciseRole.ATTACKER
+            || e.getParticipant(e.blueSideId().orElseThrow()).orElseThrow().role()
+                != ExerciseRole.DEFENDER))
+      throw new IllegalArgumentException("Invalid side captain");
+    if ((!e.type().requiresTwoSides() || e.startedAt() == null)
+        && (e.redSideId().isPresent() || e.blueSideId().isPresent()))
+      throw new IllegalArgumentException("Unexpected exercise sides");
+  }
+
+  static String checksum(Properties p) {
+    try {
+      var digest = java.security.MessageDigest.getInstance("SHA-256");
+      for (String k :
+          p.stringPropertyNames().stream().filter(k -> !k.equals("sha256")).sorted().toList())
+        for (String v : List.of(k, p.getProperty(k))) {
+          byte[] b = v.getBytes(StandardCharsets.UTF_8);
+          digest.update(java.nio.ByteBuffer.allocate(4).putInt(b.length).array());
+          digest.update(b);
+        }
+      return java.util.HexFormat.of().formatHex(digest.digest());
+    } catch (java.security.NoSuchAlgorithmException impossible) {
+      throw new IllegalStateException(impossible);
+    }
+  }
+
+  private static void put(Properties p, String k, Object v) {
+    p.setProperty(k, v == null ? "" : v.toString());
+  }
+
+  private static String text(Properties p, String k) {
+    String v = p.getProperty(k);
+    if (v == null || v.length() > 2048)
+      throw new IllegalArgumentException("Invalid exercise field: " + k);
+    return v;
+  }
+
+  private static int number(Properties p, String k) {
+    return Integer.parseInt(text(p, k));
+  }
+
+  private static int count(Properties p, String k) {
+    int n = number(p, k);
+    if (n < 0 || n > 100_000) throw new IllegalArgumentException("Exercise count out of range");
+    return n;
+  }
+
+  private static double decimal(Properties p, String k) {
+    return Double.parseDouble(text(p, k));
+  }
+
+  private static boolean flag(Properties p, String k) {
+    String v = text(p, k);
+    if (!v.equals("true") && !v.equals("false"))
+      throw new IllegalArgumentException("Invalid boolean");
+    return Boolean.parseBoolean(v);
+  }
+
+  private static UUID uuid(Properties p, String k) {
+    return UUID.fromString(text(p, k));
+  }
+
+  private static Instant time(Properties p, String k) {
+    String v = text(p, k);
+    return v.isEmpty() ? null : Instant.parse(v);
+  }
+}
