+package dev.starcore.starcore.module.army.exercise;
+
+import static org.assertj.core.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+import dev.starcore.starcore.core.StarCoreContext;
+import dev.starcore.starcore.core.scheduler.FeedbackSchedulerFixture;
+import dev.starcore.starcore.core.service.ServiceRegistry;
+import dev.starcore.starcore.foundation.message.MessageService;
+import dev.starcore.starcore.module.nation.*;
+import dev.starcore.starcore.performance.OptimizedMoveListener;
+import io.papermc.paper.threadedregions.scheduler.ScheduledTask;
+import java.nio.file.*;
+import java.util.List;
+import java.util.concurrent.TimeUnit;
+import java.util.logging.Logger;
+import org.bukkit.Bukkit;
+import org.bukkit.command.PluginCommand;
+import org.bukkit.configuration.file.YamlConfiguration;
+import org.bukkit.event.HandlerList;
+import org.junit.jupiter.api.*;
+import org.junit.jupiter.api.io.TempDir;
+import org.mockito.MockedStatic;
+
+class ExerciseModuleLifecycleTest {
+  @TempDir Path root;
+  FeedbackSchedulerFixture fixture;
+  MockedStatic<HandlerList> handlers;
+  final ServiceRegistry registry = new ServiceRegistry();
+  final ExerciseModule module = new ExerciseModule();
+  final OptimizedMoveListener dispatcher = mock(OptimizedMoveListener.class);
+  final ScheduledTask task = mock(ScheduledTask.class);
+  final PluginCommand command = mock(PluginCommand.class);
+  StarCoreContext context;
+
+  @BeforeEach
+  void setup() {
+    fixture = new FeedbackSchedulerFixture();
+    handlers = mockStatic(HandlerList.class);
+    when(fixture.plugin.getLogger()).thenReturn(Logger.getAnonymousLogger());
+    when(fixture.plugin.getDataFolder()).thenReturn(root.toFile());
+    when(fixture.plugin.getConfig()).thenReturn(new YamlConfiguration());
+    when(Bukkit.getAsyncScheduler()
+            .runAtFixedRate(
+                eq(fixture.plugin), any(), anyLong(), anyLong(), eq(TimeUnit.MILLISECONDS)))
+        .thenReturn(task);
+    registry.register(
+        NationService.class,
+        new ExerciseNationFixture(root.resolve("nation-test"), List.of()).module());
+    registry.register(MessageService.class, (key, args) -> key);
+    registry.register(OptimizedMoveListener.class, dispatcher);
+    when(dispatcher.registerBlock(any())).thenAnswer(call -> call.getArgument(0));
+    when(fixture.plugin.getServer().getPluginCommand("exercise")).thenReturn(command);
+    context =
+        new StarCoreContext(
+            fixture.plugin, null, null, null, null, null, null, null, null, null, registry);
+  }
+
+  @AfterEach
+  void close() {
+    try {
+      module.disable(context);
+    } finally {
+      handlers.close();
+      fixture.close();
+    }
+  }
+
+  @Test
+  void reloadUnregistersCommandsMovementAndOldService() {
+    module.enable(context);
+    var old = module.getExerciseService();
+    var executor = module.getCommand();
+    when(command.getExecutor()).thenReturn(executor);
+    when(command.getTabCompleter()).thenReturn(executor);
+    module.disable(context);
+    assertThat(registry.find(ExerciseService.class)).isEmpty();
+    verify(command).setExecutor(null);
+    verify(command).setTabCompleter(null);
+    verify(task).cancel();
+    verify(dispatcher).unregister(any());
+    assertThatThrownBy(old::getPendingExercises).isInstanceOf(IllegalStateException.class);
+    module.enable(context);
+    assertThat(module.getExerciseService()).isNotSameAs(old);
+    verify(fixture.plugin.getServer(), never()).getScheduler();
+  }
+
+  @Test
+  void registrationFailureCleansPublishedServiceAndTask() {
+    var manager = fixture.plugin.getServer().getPluginManager();
+    doThrow(new IllegalStateException("register failed"))
+        .when(manager)
+        .registerEvents(any(), any());
+    assertThatThrownBy(() -> module.enable(context)).isInstanceOf(IllegalStateException.class);
+    assertThat(registry.find(ExerciseService.class)).isEmpty();
+    verify(task).cancel();
+  }
+
+  @Test
+  void stoppingOldModulePreservesAReplacementService() {
+    module.enable(context);
+    var replacement = mock(ExerciseService.class);
+    registry.register(ExerciseService.class, replacement);
+    module.disable(context);
+    assertThat(registry.find(ExerciseService.class)).contains(replacement);
+  }
+
+  @Test
+  void corruptAuthorityPreventsSchedulingAndRegistration() throws Exception {
+    Files.createDirectories(root.resolve("exercise"));
+    Files.writeString(root.resolve("exercise/exercises.dat"), "broken");
+    assertThatThrownBy(() -> module.enable(context)).isInstanceOf(IllegalStateException.class);
+    assertThat(registry.find(ExerciseService.class)).isEmpty();
+    verify(Bukkit.getAsyncScheduler(), never())
+        .runAtFixedRate(any(), any(), anyLong(), anyLong(), any());
+  }
+
+  @Test
+  void missingExperienceReceiptAuthorityPreventsEnable() {
+    registry.unregister(NationService.class);
+    registry.register(NationService.class, mock(NationService.class));
+    assertThatThrownBy(() -> module.enable(context)).isInstanceOf(IllegalStateException.class);
+    assertThat(registry.find(ExerciseService.class)).isEmpty();
+    verify(Bukkit.getAsyncScheduler(), never())
+        .runAtFixedRate(any(), any(), anyLong(), anyLong(), any());
+  }
+}
