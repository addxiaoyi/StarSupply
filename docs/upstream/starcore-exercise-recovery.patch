+    assertThat(names.get("new nation")).isEqualTo(created.id());
+    assertThat(territories.isOwnerOf(created.id().toString(), first)).isTrue();
+    assertThat(territories.isOwnerOf(created.id().toString(), second)).isTrue();
+    assertThat(territories.isOwnerOf(source.id().toString(), retained)).isTrue();
+    assertThat(NationStateCodec.fromProperties(storage.saved)).hasSize(2);
+  }
