diff --git a/src/main/java/dev/starcore/starcore/module/army/exercise/FileExerciseStateStorage.java b/src/main/java/dev/starcore/starcore/module/army/exercise/FileExerciseStateStorage.java
new file mode 100644
index 0000000..3693a34
--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/module/army/exercise/FileExerciseStateStorage.java
@@ -0,0 +1,127 @@
+package dev.starcore.starcore.module.army.exercise;
+
+import dev.starcore.starcore.core.persistence.AtomicFilePersistence;
+import java.io.*;
+import java.nio.file.*;
+import java.util.*;
+import java.util.Properties;
+
+final class FileExerciseStateStorage implements ExerciseStateStorage {
+  private static final String FILE_NAME = "exercises.dat";
+
+  private static final Object[] GUARDS = new Object[64];
+
+  static {
+    Arrays.setAll(GUARDS, ignored -> new Object());
+  }
+
+  private final Path path;
+
+  private byte[] expected;
+  private boolean loaded, failed;
+
+  FileExerciseStateStorage(Path directory) {
+    path = Objects.requireNonNull(directory).resolve(FILE_NAME).toAbsolutePath().normalize();
+    try {
+      Files.createDirectories(path.getParent());
+    } catch (IOException failure) {
+      throw new IllegalStateException("Exercise directory unavailable", failure);
+    }
+  }
+
+  @Override
+  public synchronized Properties load() {
+    try {
+      byte[] data = read();
+      if (data == null
+          && (expected != null
+              || Files.exists(AtomicFilePersistence.backup(path))
+              || Files.exists(AtomicFilePersistence.temp(path))))
+        throw new IOException("Missing exercise authority; explicit recovery required");
+      Properties value = decode(data);
+      expected = data;
+      loaded = true;
+      failed = false;
+      return value;
+    } catch (IOException | RuntimeException failure) {
+      failed = true;
+      throw new IllegalStateException("Exercise authority requires reconciliation", failure);
+    }
+  }
+
+  @Override
+  public synchronized void save(Properties properties) {
+    synchronized (GUARDS[Math.floorMod(path.hashCode(), GUARDS.length)]) {
+      if (!loaded) load();
+      requireLoaded();
+      var canonical = new ExerciseStateCodec().encode(new ExerciseStateCodec().decode(properties));
+      try {
+        byte[] current = read();
+        if (!Arrays.equals(expected, current))
+          throw new IllegalStateException(new IOException("Exercise file changed"));
+        var buffer = new ByteArrayOutputStream();
+        canonical.store(buffer, "STARCORE exercise state");
+        byte[] candidate = buffer.toByteArray();
+        if (candidate.length > 64 * 1024 * 1024)
+          throw new IOException("Exercise snapshot too large");
+        try {
+          AtomicFilePersistence.replace(path, temp -> Files.write(temp, candidate));
+          if (!Arrays.equals(read(), candidate))
+            throw new IOException("Exercise snapshot not published");
+        } catch (IOException | RuntimeException failure) {
+          byte[] actual;
+          try {
+            actual = read();
+          } catch (IOException unreadable) {
+            failed = true;
+            failure.addSuppressed(unreadable);
+            throw new IllegalStateException("Exercise authority requires reconciliation", failure);
+          }
+          if (Arrays.equals(actual, candidate)) {
+            expected = candidate;
+            return;
+          }
+          if (!Arrays.equals(actual, expected)) {
+            failed = true;
+            throw new IllegalStateException("Exercise authority requires reconciliation", failure);
+          }
+          throw failure;
+        }
+        expected = candidate;
+      } catch (IOException failure) {
+        throw new IllegalStateException("Exercise file save failed", failure);
+      }
+    }
+  }
+
+  private void requireLoaded() {
+    if (!loaded || failed) throw new IllegalStateException("Exercise storage unavailable");
+  }
+
+  private byte[] read() throws IOException {
+    if (!Files.exists(path)) return null;
+    if (!Files.isRegularFile(path) || Files.size(path) > 64 * 1024 * 1024)
+      throw new IOException("Invalid exercise authority file");
+    try (var input = Files.newInputStream(path)) {
+      byte[] bytes = input.readNBytes(64 * 1024 * 1024 + 1);
+      if (bytes.length > 64 * 1024 * 1024) throw new IOException("Exercise file too large");
+      return bytes;
+    }
+  }
+
+  private Properties decode(byte[] bytes) throws IOException {
+    Properties value =
+        new Properties() {
+          @Override
+          public synchronized Object put(Object key, Object text) {
+            if (containsKey(key)) throw new IllegalArgumentException("Duplicate exercise property");
+            return super.put(key, text);
+          }
+        };
+    if (bytes == null) return value;
+    value.load(new ByteArrayInputStream(bytes));
+    if (value.isEmpty()) throw new IOException("Empty exercise authority");
+    new ExerciseStateCodec().decode(value);
+    return value;
+  }
+}
