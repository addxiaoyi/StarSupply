+  public synchronized List<Exercise> getExercisesByOrganizer(UUID id) {
+    return matching(e -> e.organizerId().equals(id));
+  }
+
+  @Override
+  public synchronized Optional<ExerciseResult> getResult(UUID id) {
+    readable();
+    return Optional.ofNullable(results.get(id));
+  }
+
+  @Override
+  public synchronized List<ExerciseResult> getRecentResults(int limit) {
+    readable();
+    if (limit <= 0) return List.of();
+    return results.values().stream()
+        .sorted(
+            Comparator.comparing(ExerciseResult::endedAt)
+                .reversed()
+                .thenComparing(r -> r.exerciseId().toString()))
+        .limit(limit)
+        .toList();
+  }
+
+  @Override
+  public ExerciseConfig getConfig() {
+    return config;
+  }
+
+  @Override
+  public synchronized String checkJoinEligibility(UUID id, UUID nation) {
+    ready();
+    var e = exercises.get(id);
+    if (e == null) return "exercise.error.not-found";
+    if (!e.state().canJoin()) return "exercise.error.cannot-join";
+    if (e.isFull()) return "exercise.error.full";
+    if (e.getParticipant(nation).isPresent()) return "exercise.error.already-joined";
+    if (nations.nationById(new NationId(nation)).isEmpty())
+      return "exercise.error.nation-not-found";
+    if (nations.levelOf(new NationId(nation)) < e.config().minLevel())
+      return "exercise.error.requirements";
+    return "exercise.success.can-join";
+  }
 }
diff --git a/src/main/java/dev/starcore/starcore/module/army/exercise/ExerciseSettlement.java b/src/main/java/dev/starcore/starcore/module/army/exercise/ExerciseSettlement.java
