+/** Experience and its original receipt commit in the same nation snapshot. */
+public interface NationExperienceService {
+  record Grant(String transactionId, NationId nationId, long amount) {
+    public Grant {
+      Objects.requireNonNull(transactionId);
+      Objects.requireNonNull(nationId);
+      if (transactionId.isBlank() || transactionId.length() > 512 || amount < 1 || amount > 10_000)
