+    public Receipt {
+      Objects.requireNonNull(grant);
+      Objects.requireNonNull(appliedAt);
+    }
+  }
+
+  Receipt grantExperience(Grant grant);
+
+  Optional<Receipt> experienceReceipt(NationId nationId, String transactionId);
+}
