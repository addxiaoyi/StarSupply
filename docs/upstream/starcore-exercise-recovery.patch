diff --git a/src/test/java/dev/starcore/starcore/module/army/exercise/ExerciseCommandTest.java b/src/test/java/dev/starcore/starcore/module/army/exercise/ExerciseCommandTest.java
new file mode 100644
index 0000000..ac5f9c7
--- /dev/null
+++ b/src/test/java/dev/starcore/starcore/module/army/exercise/ExerciseCommandTest.java
@@ -0,0 +1,125 @@
+package dev.starcore.starcore.module.army.exercise;
+
+import static org.assertj.core.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+import dev.starcore.starcore.module.army.exercise.command.ExerciseCommand;
+import dev.starcore.starcore.module.nation.NationService;
+import dev.starcore.starcore.module.nation.model.*;
+import java.util.*;
+import org.bukkit.command.*;
+import org.bukkit.entity.Player;
+import org.junit.jupiter.api.*;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+
+class ExerciseCommandTest {
+  final ExerciseService service = mock(ExerciseService.class);
+  final NationService nations = mock(NationService.class);
+  final Player player = mock(Player.class);
+  final Nation own = new Nation(NationId.random(), "Own", UUID.randomUUID(), "Founder");
+  final ExerciseCommand command = new ExerciseCommand(service, nations, (key, args) -> key);
+  Exercise exercise;
+
+  @BeforeEach
+  void setup() {
+    when(player.hasPermission(anyString())).thenReturn(true);
+    when(player.hasPermission("starcore.exercise.admin")).thenReturn(false);
+    when(player.getUniqueId()).thenReturn(own.founderId());
+    when(nations.nationOf(own.founderId())).thenReturn(Optional.of(own));
+    exercise =
+        Exercise.create(
+            "Other", UUID.randomUUID(), ExerciseType.FREE_FOR_ALL, ExerciseConfig.defaults());
+    when(service.getExercise(exercise.id())).thenReturn(Optional.of(exercise));
+    when(service.getPendingExercises()).thenReturn(List.of(exercise));
+  }
+
+  void run(String... args) {
+    command.onCommand(player, mock(Command.class), "exercise", args);
+  }
+
+  @ParameterizedTest
+  @ValueSource(strings = {"start", "end", "cancel", "pause", "resume", "zone"})
+  void fullAndShortIdsCannotBypassOrganizerOwnership(String sub) {
+    run(sub, exercise.id().toString(), "20");
+    run(sub, exercise.id().toString().substring(0, 8), "20");
+    verify(service, never()).startExercise(any());
+    verify(service, never()).endExercise(any(), any());
+    verify(service, never()).cancelExercise(any(), any());
+    verify(service, never()).updateExerciseState(any(), any());
+    verify(service, never()).setLocation(any(), any(), anyInt(), anyInt(), anyInt());
+  }
+
+  @ParameterizedTest
+  @ValueSource(strings = {"create", "join", "leave", "battle"})
+  void ordinaryNationMemberCannotMutateExercise(String sub) {
+    var member = UUID.randomUUID();
+    when(player.getUniqueId()).thenReturn(member);
+    when(nations.nationOf(member)).thenReturn(Optional.of(own));
+    run(
+        sub,
+        sub.equals("create") ? "Name" : exercise.id().toString(),
+        sub.equals("create") ? "ffa" : "100");
+    verify(service, never()).createExercise(any(), any(), any());
+    verify(service, never()).joinExercise(any(), any(), anyInt());
+    verify(service, never()).leaveExercise(any(), any());
+    verify(service, never()).processBattle(any(), any(), any());
+  }
+
+  @Test
+  void permissionIsCheckedBeforeLookupOrMutation() {
+    when(player.hasPermission("starcore.exercise.start")).thenReturn(false);
+    run("start", exercise.id().toString());
+    verifyNoInteractions(service);
+  }
+
+  @Test
+  void cancellationUsesCancellationEndpoint() {
+    when(player.hasPermission("starcore.exercise.admin")).thenReturn(true);
+    run("cancel", exercise.id().toString());
+    verify(service).cancelExercise(eq(exercise.id()), any());
+    verify(service, never()).endExercise(any(), any());
+  }
+
+  @Test
+  void requestedResultDoesNotReturnUnrelatedRecentResults() {
+    run("result", exercise.id().toString());
+    verify(service).getResult(exercise.id());
+    verify(service, never()).getRecentResults(anyInt());
+  }
+
+  @Test
+  void ambiguousPrefixCannotSelectAnArbitraryExercise() {
+    var first =
+        Exercise.create(
+            "First", own.id().value(), ExerciseType.FREE_FOR_ALL, ExerciseConfig.defaults());
+    var id =
+        UUID.fromString(first.id().toString().substring(0, 8) + "-0000-4000-8000-000000000001");
+    var other =
+        new Exercise(
+            id,
+            "Second",
+            own.id().value(),
+            ExerciseType.FREE_FOR_ALL,
+            ExerciseState.PREPARING,
+            java.time.Instant.now(),
+            ExerciseConfig.defaults());
+    when(service.getPendingExercises()).thenReturn(List.of(first, other));
+    run("start", id.toString().substring(0, 8));
+    verify(service, never()).startExercise(any());
+  }
+
+  @Test
+  void consoleRecoveryRequiresAdminAndOldCommandStops() {
+    var console = mock(ConsoleCommandSender.class);
+    when(console.hasPermission("starcore.exercise.admin")).thenReturn(true);
+    command.onCommand(console, mock(Command.class), "exercise", new String[] {"recover"});
+    verify(service).recoverRewards();
+    clearInvocations(service);
+    command.shutdown();
+    run("start", exercise.id().toString());
+    verifyNoInteractions(service);
+    assertThat(command.onTabComplete(player, mock(Command.class), "exercise", new String[] {""}))
+        .isEmpty();
+  }
+}
diff --git a/src/test/java/dev/starcore/starcore/module/army/exercise/ExerciseListenerTest.java b/src/test/java/dev/starcore/starcore/module/army/exercise/ExerciseListenerTest.java
new file mode 100644
index 0000000..b2bd43a
--- /dev/null
+++ b/src/test/java/dev/starcore/starcore/module/army/exercise/ExerciseListenerTest.java
@@ -0,0 +1,177 @@
+package dev.starcore.starcore.module.army.exercise;
+
+import static org.assertj.core.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+import dev.starcore.starcore.core.scheduler.FeedbackSchedulerFixture;
+import dev.starcore.starcore.module.army.exercise.event.ExerciseStartedEvent;
+import dev.starcore.starcore.module.army.exercise.listener.ExerciseListener;
+import dev.starcore.starcore.module.nation.NationService;
+import dev.starcore.starcore.module.nation.model.*;
+import dev.starcore.starcore.performance.OptimizedMoveListener;
+import io.papermc.paper.threadedregions.scheduler.ScheduledTask;
+import java.util.*;
+import java.util.function.Consumer;
+import org.bukkit.*;
+import org.bukkit.entity.Player;
+import org.bukkit.event.entity.PlayerDeathEvent;
+import org.junit.jupiter.api.*;
+
+class ExerciseListenerTest {
+  FeedbackSchedulerFixture fixture;
+  final ExerciseService service = mock(ExerciseService.class);
+  final NationService nations = mock(NationService.class);
+  final OptimizedMoveListener dispatcher = mock(OptimizedMoveListener.class);
+  final Deque<Runnable> callbacks = new ArrayDeque<>();
+  Player actor, target;
+  Nation own, other;
+  Exercise exercise;
+  ExerciseListener listener;
+  OptimizedMoveListener.BlockMoveSubscriber callback;
+
+  @BeforeEach
+  void setup() {
+    fixture = new FeedbackSchedulerFixture();
+    when(fixture.world.getName()).thenReturn("world");
+    when(fixture.world.getUID()).thenReturn(UUID.randomUUID());
+    actor = player(0);
+    target = player(5);
+    own = new Nation(NationId.random(), "Own", actor.getUniqueId(), "Founder");
+    other = new Nation(NationId.random(), "Other", target.getUniqueId(), "Founder");
+    when(nations.nationOf(actor.getUniqueId())).thenReturn(Optional.of(own));
+    when(nations.nationOf(target.getUniqueId())).thenReturn(Optional.of(other));
+    when(nations.nationById(own.id())).thenReturn(Optional.of(own));
+    when(nations.nationById(other.id())).thenReturn(Optional.of(other));
+    exercise =
+        Exercise.create(
+            "Training", own.id().value(), ExerciseType.FREE_FOR_ALL, ExerciseConfig.defaults());
+    exercise.setLocation("world", 0, 0, 50);
+    exercise.addParticipant(
+        new ExerciseParticipant(own.id().value(), "Own", 100, ExerciseRole.FREE));
+    exercise.addParticipant(
+        new ExerciseParticipant(other.id().value(), "Other", 100, ExerciseRole.FREE));
+    exercise.setState(ExerciseState.IN_PROGRESS);
+    when(service.getExercisesByNation(own.id().value()))
+        .thenAnswer(ignored -> List.of(exercise.copy()));
+    listener = new ExerciseListener(fixture.plugin, service, nations, (key, args) -> key);
+    when(dispatcher.registerBlock(any()))
+        .thenAnswer(
+            call -> {
+              callback = call.getArgument(0);
+              return callback;
+            });
+    listener.subscribe(dispatcher);
+  }
+
+  private Player player(double x) {
+    var p = fixture.player(x);
+    fixture.bukkit.when(() -> Bukkit.getPlayer(p.getUniqueId())).thenReturn(p);
+    when(p.getScheduler().run(eq(fixture.plugin), any(), any()))
+        .thenAnswer(
+            call -> {
+              Consumer<ScheduledTask> action = call.getArgument(1);
+              var task = mock(ScheduledTask.class);
+              callbacks.add(
+                  () -> {
+                    var previous = fixture.owner;
+                    fixture.owner = p;
+                    try {
+                      action.accept(task);
+                    } finally {
+                      fixture.owner = previous;
+                    }
+                  });
+              return task;
+            });
+    doAnswer(
+            call -> {
+              assertThat(fixture.owner).isSameAs(p);
+              return null;
+            })
+        .when(p)
+        .sendMessage(any(net.kyori.adventure.text.Component.class));
+    return p;
+  }
+
+  @AfterEach
+  void close() {
+    listener.unsubscribe(dispatcher);
+    fixture.close();
+  }
+
+  private void move() {
+    fixture.owner = actor;
+    var at = new Location(fixture.world, 0, 64, 0);
+    callback.onBlockMove(actor, at, at);
+    fixture.owner = null;
+  }
+
+  private void drain() {
+    while (!callbacks.isEmpty()) callbacks.remove().run();
+  }
+
+  @Test
+  void nearbyCombatUsesRealMembershipAndBothEntityOwners() {
+    move();
+    verify(service, never()).processBattle(any(), any(), any());
+    drain();
+    verify(service).processBattle(exercise.id(), own.id().value(), other.id().value());
+  }
+
+  @Test
+  void membershipChangeBetweenOwnerCallbacksSuppressesCombat() {
+    move();
+    callbacks.remove().run();
+    when(nations.nationOf(target.getUniqueId())).thenReturn(Optional.empty());
+    drain();
+    verify(service, never()).processBattle(any(), any(), any());
+  }
+
+  @Test
+  void retiredSubscriptionCannotRunQueuedOrOldMovementWork() {
+    move();
+    var old = callback;
+    listener.unsubscribe(dispatcher);
+    listener.subscribe(dispatcher);
+    drain();
+    var at = new Location(fixture.world, 0, 64, 0);
+    old.onBlockMove(actor, at, at);
+    verify(service, never()).processBattle(any(), any(), any());
+  }
+
+  @Test
+  void noZoneAndOtherWorldDoNotSimulateGlobalCombat() {
+    exercise.setLocation(null, 0, 0, 0);
+    move();
+    drain();
+    exercise.setLocation("other-world", 0, 0, 50);
+    move();
+    drain();
+    verify(service, never()).processBattle(any(), any(), any());
+  }
+
+  @Test
+  void broadcastsUseMemberPlayersAndTheirOwners() {
+    listener.onExerciseStarted(new ExerciseStartedEvent(exercise));
+    verify(actor, never()).sendMessage(any(net.kyori.adventure.text.Component.class));
+    drain();
+    verify(actor).sendMessage(any(net.kyori.adventure.text.Component.class));
+    verify(target).sendMessage(any(net.kyori.adventure.text.Component.class));
+  }
+
+  @Test
+  void deathUsesDurableCasualtyEndpointOnlyInZone() {
+    var event = mock(PlayerDeathEvent.class);
+    when(event.getEntity()).thenReturn(actor);
+    fixture.owner = actor;
+    listener.onPlayerDeath(event);
+    fixture.owner = null;
+    verify(service).recordPlayerDeath(exercise.id(), own.id().value());
+    clearInvocations(service);
+    exercise.setLocation("other-world", 0, 0, 50);
+    fixture.owner = actor;
+    listener.onPlayerDeath(event);
+    fixture.owner = null;
+    verify(service, never()).recordPlayerDeath(any(), any());
+  }
+}
