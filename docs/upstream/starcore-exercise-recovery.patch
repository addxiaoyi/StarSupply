+  private <T> T mutate(Supplier<T> work) {
+    ready();
+    Properties before = codec.encode(snapshot());
+    try {
+      T result = work.get();
+      Properties candidate = codec.encode(snapshot());
+      try {
+        storage.save(candidate);
+      } catch (RuntimeException uncertain) {
+        try {
+          Properties actual = codec.encode(codec.decode(storage.load()));
+          if (candidate.equals(actual)) return result;
+          if (!before.equals(actual)) failed = true;
+        } catch (RuntimeException unreadable) {
+          failed = true;
+          uncertain.addSuppressed(unreadable);
+        }
+        throw uncertain;
+      }
+      return result;
+    } catch (RuntimeException failure) {
+      restore(codec.decode(before));
+      throw failure;
+    } catch (Error interrupted) {
+      restore(codec.decode(before));
+      failed = true;
+      throw interrupted;
