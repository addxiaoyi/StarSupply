+package dev.starcore.starcore.module.nation;
+
+import static org.assertj.core.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+import dev.starcore.starcore.core.persistence.AtomicFilePersistence;
+import dev.starcore.starcore.module.nation.model.Nation;
+import dev.starcore.starcore.module.nation.model.NationId;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.time.Instant;
+import java.util.*;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+
+class NationExperienceReceiptTest {
+  @TempDir Path root;
+  private final Nation nation =
+      new Nation(NationId.random(), "Alpha", UUID.randomUUID(), "Founder");
+  private final NationExperienceService.Grant grant =
+      new NationExperienceService.Grant("exercise-one", nation.id(), 100);
+
+  private ExerciseNationFixture fixture() {
+    return new ExerciseNationFixture(root, List.of(nation));
+  }
+
+  private long xp(ExerciseNationFixture f) {
+    return f.module().nationById(nation.id()).orElseThrow().experience();
+  }
+
+  @Test
+  void originalIdIsOnceAcrossRestartAndLaterOrdinarySave() {
+    var f = fixture();
+    var receipt = f.module().grantExperience(grant);
+    assertThat(f.module().grantExperience(grant)).isEqualTo(receipt);
+    f.module().renameNation(nation.id(), "Renamed");
+    f.module().saveState();
+    f.reload();
+    assertThat(f.module().grantExperience(grant)).isEqualTo(receipt);
+    assertThat(xp(f)).isEqualTo(100);
+    assertThat(f.module().nationById(nation.id()).orElseThrow().name()).isEqualTo("Renamed");
+  }
+
+  @Test
+  void conflictingAmountDoesNotChangeAuthority() {
+    var f = fixture();
+    f.module().grantExperience(grant);
+    assertThatThrownBy(
+            () ->
+                f.module()
+                    .grantExperience(
+                        new NationExperienceService.Grant("exercise-one", nation.id(), 200)))
+        .isInstanceOf(IllegalArgumentException.class);
+    f.reload();
+    assertThat(xp(f)).isEqualTo(100);
+  }
+
+  @Test
+  void beforeSaveFailureLeavesNoExperienceOrReceiptAndCanRetry() {
+    var f = fixture();
+    f.fault(ExerciseNationFixture.Fault.BEFORE_SAVE);
+    assertThatThrownBy(() -> f.module().grantExperience(grant))
+        .isInstanceOf(IllegalStateException.class);
+    assertThat(xp(f)).isZero();
+    assertThat(f.module().experienceReceipt(nation.id(), grant.transactionId())).isEmpty();
+    f.module().grantExperience(grant);
+    f.reload();
+    assertThat(xp(f)).isEqualTo(100);
+  }
+
+  @Test
+  void committedLostReplyIsConfirmedFromExactFile() {
+    var f = fixture();
+    f.fault(ExerciseNationFixture.Fault.LOST_REPLY);
+    var receipt = f.module().grantExperience(grant);
+    f.reload();
+    assertThat(f.module().grantExperience(grant)).isEqualTo(receipt);
+    assertThat(xp(f)).isEqualTo(100);
+  }
+
+  @Test
+  void interruptedCommitFreezesOldReferenceAndRestartRecovers() {
+    uncertain(ExerciseNationFixture.Fault.AFTER_COMMIT_ERROR);
+  }
+
+  @Test
+  void unreadableCommitFreezesOldReferenceAndRestartRecovers() {
+    uncertain(ExerciseNationFixture.Fault.UNREADABLE_AFTER_COMMIT);
+  }
+
+  private void uncertain(ExerciseNationFixture.Fault fault) {
+    var f = fixture();
+    var old = f.module();
+    f.fault(fault);
+    assertThatThrownBy(() -> old.grantExperience(grant))
+        .isInstanceOf(
+            fault == ExerciseNationFixture.Fault.AFTER_COMMIT_ERROR
+                ? AssertionError.class
+                : IllegalStateException.class);
+    assertThatThrownBy(old::saveState).isInstanceOf(IllegalStateException.class);
+    assertThatThrownBy(() -> old.grantExperience(grant)).isInstanceOf(IllegalStateException.class);
+    f.reload();
+    f.module().grantExperience(grant);
+    assertThat(xp(f)).isEqualTo(100);
+  }
+
+  @Test
+  void staleFileWriterReloadsReceiptBeforeRetry() {
+    var f = fixture();
+    var other = new ExerciseNationFixture(root, null);
+    f.module().grantExperience(grant);
+    assertThatThrownBy(() -> other.module().grantExperience(grant))
+        .isInstanceOf(NationStateConflictException.class);
+    other.module().grantExperience(grant);
+    other.reload();
+    assertThat(xp(other)).isEqualTo(100);
+  }
+
+  @Test
+  void absentRecipientNeverCreatesAnotherNation() {
+    var f = fixture();
+    assertThatThrownBy(
+            () ->
+                f.module()
+                    .grantExperience(
+                        new NationExperienceService.Grant("absent", NationId.random(), 100)))
+        .isInstanceOf(IllegalStateException.class);
+    assertThat(xp(f)).isZero();
+    assertThat(f.module().nations()).hasSize(1);
+  }
+
+  @ParameterizedTest
+  @ValueSource(strings = {"splitJournal", "disbandJournal", "creationJournal"})
+  void pendingLifecycleSnapshotCannotBeOvertakenByNewExperience(String fieldName) throws Exception {
+    var f = fixture();
+    Object journal;
+    if (fieldName.equals("splitJournal")) {
+      var j = mock(NationSplitJournal.class);
+      var pending = mock(NationSplitTransaction.class);
+      when(j.load()).thenReturn(Optional.of(pending));
+      journal = j;
+    } else if (fieldName.equals("disbandJournal")) {
+      var j = mock(NationDisbandJournal.class);
+      var pending = mock(NationDisbandTransaction.class);
+      when(j.load()).thenReturn(Optional.of(pending));
+      journal = j;
+    } else {
+      var j = mock(NationCreationJournal.class);
+      var pending = mock(NationCreationTransaction.class);
+      when(j.load()).thenReturn(Optional.of(pending));
+      journal = j;
+    }
+    var field = NationModule.class.getDeclaredField(fieldName);
+    field.setAccessible(true);
+    field.set(f.module(), journal);
+    assertThatThrownBy(() -> f.module().grantExperience(grant))
+        .isInstanceOf(IllegalStateException.class)
+        .hasMessageContaining("lifecycle recovery");
+    assertThat(xp(f)).isZero();
+    assertThat(f.module().experienceReceipt(nation.id(), grant.transactionId())).isEmpty();
+    f.reload();
+    f.module().grantExperience(grant);
+    assertThat(xp(f)).isEqualTo(100);
+  }
+
+  @ParameterizedTest
+  @ValueSource(strings = {"checksum", "header", "amount", "missing", "duplicate-nation"})
+  void damagedReceiptSnapshotsFailClosed(String damage) {
+    nation.setExperience(100);
+    nation.retainExperienceReceipt(new NationExperienceService.Receipt(grant, Instant.EPOCH));
+    var state = NationStateCodec.toProperties(List.of(nation));
+    switch (damage) {
+      case "checksum" -> state.setProperty("nation.0.experience", "200");
+      case "header" -> state.remove("experienceReceipts.version");
+      case "amount" -> {
+        state.setProperty("nation.0.experienceReceipt.0.amount", "-1");
+        resign(state);
+      }
+      case "missing" -> {
+        state.remove("nation.0.experienceReceipt.0.id");
+        resign(state);
+      }
+      case "duplicate-nation" -> {
+        state = NationStateCodec.toProperties(List.of(nation, nation));
+      }
+    }
+    var broken = state;
+    assertThatThrownBy(() -> NationStateCodec.fromProperties(broken))
+        .isInstanceOf(IllegalArgumentException.class);
+  }
+
+  private void resign(Properties p) {
+    p.setProperty("experienceReceipts.sha256", NationStateCodec.checksum(p));
+  }
+
+  @Test
+  void missingLiveFileDoesNotFallBackToOlderBackup() throws Exception {
+    var f = fixture();
+    f.module().grantExperience(grant);
+    var file = root.resolve("nation/nations.properties");
+    assertThat(Files.exists(AtomicFilePersistence.backup(file))).isTrue();
+    Files.delete(file);
+    assertThatThrownBy(f::reload).isInstanceOf(IllegalStateException.class);
+    assertThat(Files.exists(file)).isFalse();
+  }
+
+  @Test
+  void duplicatePropertiesAreRejected() throws Exception {
+    var f = fixture();
+    f.module().grantExperience(grant);
+    Files.writeString(
+        root.resolve("nation/nations.properties"),
+        "count=1\n",
+        java.nio.file.StandardOpenOption.APPEND);
+    assertThatThrownBy(f::reload).isInstanceOf(IllegalStateException.class);
+  }
+}
