+package dev.starcore.starcore.module.army.exercise;
+
+import static org.assertj.core.api.Assertions.*;
+
+import dev.starcore.starcore.core.persistence.AtomicFilePersistence;
+import java.nio.file.*;
+import java.time.Instant;
+import java.util.*;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+
+class ExerciseStateCodecTest {
+  @TempDir Path root;
+  private final ExerciseStateCodec codec = new ExerciseStateCodec();
+
+  private Exercise preparing() {
+    return new Exercise(
+        UUID.randomUUID(),
+        "Training",
+        UUID.randomUUID(),
+        ExerciseType.FREE_FOR_ALL,
+        ExerciseState.PREPARING,
+        Instant.EPOCH,
+        ExerciseConfig.defaults());
+  }
+
+  private Properties state() {
+    var e = preparing();
+    return codec.encode(new ExerciseSnapshot(Map.of(e.id(), e), Map.of(), Set.of(), Map.of()));
+  }
+
+  private void resign(Properties p) {
+    p.setProperty("sha256", ExerciseStateCodec.checksum(p));
+  }
+
+  @ParameterizedTest
+  @ValueSource(
+      strings = {
+        "checksum",
+        "unknown",
+        "time",
+        "state",
+        "config",
+        "role",
+        "count",
+        "zone",
+        "reward",
+        "cooldown"
+      })
+  void inconsistentStateIsRejectedEvenWithRecomputedChecksum(String damage) {
+    var p = state();
+    switch (damage) {
+      case "checksum" -> {
+        p.setProperty("exercise.0.name", "changed");
+        assertThatThrownBy(() -> codec.decode(p)).isInstanceOf(IllegalArgumentException.class);
+        return;
+      }
+      case "unknown" -> p.setProperty("unrecognized", "value");
+      case "time" -> p.setProperty("exercise.0.started", "2025-01-01T00:00:00Z");
+      case "state" -> p.setProperty("exercise.0.state", "COMPLETED");
+      case "config" -> p.setProperty("exercise.0.config.xp", "NaN");
+      case "role" -> p.setProperty("exercise.0.red", UUID.randomUUID().toString());
+      case "count" -> p.setProperty("count", "-1");
+      case "zone" -> {
+        p.setProperty("exercise.0.world", "world");
+        p.setProperty("exercise.0.radius", "0");
+      }
+      case "reward" -> {
+        p.setProperty("rewarded.count", "1");
+        p.setProperty("rewarded.0", "invented");
+      }
+      case "cooldown" -> {
+        p.setProperty("cooldown.count", "1");
+        p.setProperty("cooldown.0.key", "invalid");
+        p.setProperty("cooldown.0.time", Instant.EPOCH.toString());
+      }
+    }
+    resign(p);
+    assertThatThrownBy(() -> codec.decode(p)).isInstanceOf(IllegalArgumentException.class);
+  }
+
+  @Test
+  void teamScoreIncludesEveryParticipantInsteadOfOnlyCaptains() {
+    var e =
+        new Exercise(
+            UUID.randomUUID(),
+            "Teams",
+            UUID.randomUUID(),
+            ExerciseType.SIMULATION,
+            ExerciseState.COMPLETED,
+            Instant.EPOCH,
+            ExerciseConfig.defaults());
+    UUID red = UUID.randomUUID(), blue = UUID.randomUUID(), support = UUID.randomUUID();
+    e.restoreProgress(Instant.EPOCH, Instant.EPOCH.plusSeconds(60), 0, 0, 0);
+    e.setRedSideId(red);
+    e.setBlueSideId(blue);
+    var r = participant(red, ExerciseRole.ATTACKER, 50);
+    var b = participant(blue, ExerciseRole.DEFENDER, 100);
+    var s = participant(support, ExerciseRole.ATTACKER, 100);
+    e.addParticipant(r);
+    e.addParticipant(b);
+    e.addParticipant(s);
+    assertThat(ExerciseSettlement.build(e, "ended").winnerId()).isEqualTo(red);
+  }
+
+  private ExerciseParticipant participant(UUID id, ExerciseRole role, int soldiers) {
+    var p = new ExerciseParticipant(id, "Nation", soldiers, role);
+    p.restoreProgress(0, 0, 100, Instant.EPOCH, true, 0, 0, 0);
+    return p;
+  }
+
+  @Test
+  void lossPenaltyAcceptsHistoricalNegativeValueButAlwaysSubtracts() {
+    assertThat(ExerciseConfig.defaults().moralePenaltyForDefeat()).isEqualTo(5);
+    var p = participant(UUID.randomUUID(), ExerciseRole.FREE, 100);
+    p.changeMorale(-ExerciseConfig.defaults().moralePenaltyForDefeat());
+    assertThat(p.morale()).isEqualTo(95);
+  }
+
+  @Test
+  void terminalResultCollectionsCannotBeChanged() {
+    var e = preparing();
+    e.transition(ExerciseState.CANCELLED, Instant.EPOCH);
+    var r = ExerciseSettlement.build(e, "cancelled");
+    assertThatThrownBy(() -> r.statistics().put("fake", 1))
+        .isInstanceOf(UnsupportedOperationException.class);
+    assertThatThrownBy(() -> r.participantResults().clear())
+        .isInstanceOf(UnsupportedOperationException.class);
+  }
+
+  @Test
+  void missingPrimaryNeverResurrectsOldExerciseBackup() throws Exception {
+    var files = new FileExerciseStateStorage(root);
+    files.load();
+    files.save(state());
+    files.save(state());
+    var file = root.resolve("exercises.dat");
+    assertThat(Files.exists(AtomicFilePersistence.backup(file))).isTrue();
+    Files.delete(file);
+    assertThatThrownBy(() -> new FileExerciseStateStorage(root).load())
+        .isInstanceOf(IllegalStateException.class);
+    assertThat(Files.exists(file)).isFalse();
+  }
+
+  @Test
+  void duplicateAndEmptyFileAreNotAcceptedAsNoExercises() throws Exception {
+    var file = root.resolve("exercises.dat");
+    Files.writeString(file, "");
+    assertThatThrownBy(() -> new FileExerciseStateStorage(root).load())
+        .isInstanceOf(IllegalStateException.class);
+    Files.writeString(file, "count=0\ncount=1\n");
+    assertThatThrownBy(() -> new FileExerciseStateStorage(root).load())
+        .isInstanceOf(IllegalStateException.class);
+  }
+}
