+  @Test
+  void splitPreservesPriorExperienceReceiptOnOriginalNation() {
+    var grant = new NationExperienceService.Grant("exercise-prior", source.id(), 100);
+    source.setExperience(100);
+    var receipt = new NationExperienceService.Receipt(grant, Instant.EPOCH);
+    source.retainExperienceReceipt(receipt);
+    var outcome =
+        coordinator.split(source.id(), newFounderId, "New Nation", List.of(first, second), 1);
+    assertThat(outcome.status()).isEqualTo(NationSplitOutcome.Status.SUCCESS);
+    var restored = NationStateCodec.fromProperties(storage.saved);
+    var original =
+        restored.stream().filter(n -> n.id().equals(source.id())).findFirst().orElseThrow();
+    assertThat(original.experience()).isEqualTo(100);
+    assertThat(original.experienceReceipts()).containsEntry(grant.transactionId(), receipt);
+    assertThat(
+            restored.stream()
+                .filter(n -> !n.id().equals(source.id()))
+                .findFirst()
+                .orElseThrow()
+                .experienceReceipts())
+        .isEmpty();
+  }
