+import org.junit.jupiter.params.provider.EnumSource;
+
+class ExerciseRecoveryTest {
+  @TempDir Path root;
+  private final Nation a = new Nation(NationId.random(), "Alpha", UUID.randomUUID(), "A");
+  private final Nation b = new Nation(NationId.random(), "Beta", UUID.randomUUID(), "B");
+  private final Nation c = new Nation(NationId.random(), "Gamma", UUID.randomUUID(), "C");
+  private final Nation d = new Nation(NationId.random(), "Delta", UUID.randomUUID(), "D");
+  private ExerciseNationFixture nations;
+  private ExerciseServiceImpl service;
+  private FaultStorage store;
+  private Plugin plugin;
+  private MutableClock clock = new MutableClock();
+  private ExerciseConfig config = ExerciseConfig.defaults();
+
+  @BeforeEach
+  void setup() {
+    nations = new ExerciseNationFixture(root.resolve("authority"), List.of(a, b, c, d));
+    plugin = mock(Plugin.class);
+    var server = mock(Server.class);
+    var manager = mock(PluginManager.class);
+    when(plugin.getServer()).thenReturn(server);
+    when(server.getPluginManager()).thenReturn(manager);
+    when(plugin.getLogger()).thenReturn(Logger.getAnonymousLogger());
+    restart();
+  }
+
+  @AfterEach
+  void stop() {
+    service.shutdown();
+  }
+
+  private void restart() {
+    if (service != null) service.shutdown();
+    store = new FaultStorage(new FileExerciseStateStorage(root.resolve("exercise")));
+    service = new ExerciseServiceImpl(plugin, nations.module(), config, store, clock, false);
+  }
+
+  private UUID started(ExerciseType type, int count) {
+    UUID id = service.createExercise(a.id().value(), "Training", type).id();
+    for (var n : List.of(a, b, c, d).subList(0, count))
+      assertThat(service.joinExercise(id, n.id().value(), 100)).isTrue();
+    assertThat(service.startExercise(id)).isTrue();
+    return id;
+  }
+
+  private ExerciseBattleResult fight(UUID id) {
+    return service.processBattle(id, a.id().value(), b.id().value());
+  }
+
+  private long xp(Nation n) {
+    return nations.module().nationById(n.id()).orElseThrow().experience();
+  }
+
+  private Exercise current(UUID id) {
+    return service.getExercise(id).orElseThrow();
+  }
+
+  @ParameterizedTest
+  @EnumSource(ExerciseType.class)
+  void everyTypeStartsWithMultipleParticipantsAndSurvivesRestart(ExerciseType type) {
+    UUID id = started(type, 4);
+    var before = current(id);
+    assertThat(before.participants()).hasSize(4);
+    if (type.requiresTwoSides()) {
+      assertThat(before.participants().stream().filter(p -> p.role() == ExerciseRole.ATTACKER))
+          .hasSize(2);
+      assertThat(before.participants().stream().filter(p -> p.role() == ExerciseRole.DEFENDER))
+          .hasSize(2);
+    }
+    restart();
+    assertThat(current(id).state()).isEqualTo(ExerciseState.IN_PROGRESS);
+    assertThat(current(id).redSideId()).isEqualTo(before.redSideId());
+    assertThat(service.startExercise(id)).isTrue();
+    assertThat(current(id).redSideId()).isEqualTo(before.redSideId());
+  }
+
+  @Test
+  void resultsRewardsStatisticsAndSymmetricCooldownPersist() {
+    UUID id = started(ExerciseType.FREE_FOR_ALL, 2);
+    var battle = fight(id);
+    assertThat(battle).isNotNull();
+    assertThat(service.processBattle(id, b.id().value(), a.id().value())).isNull();
+    restart();
+    assertThat(fight(id)).isNull();
+    var participant = current(id).getParticipant(a.id().value()).orElseThrow();
+    assertThat(participant.casualties()).isEqualTo(battle.attackerLosses());
+    assertThat(participant.kills()).isEqualTo(battle.defenderLosses());
+    assertThat(participant.battles()).isEqualTo(1);
+    clock.advance(60);
+    assertThat(fight(id)).isNotNull();
+    var result = service.endExercise(id, "finished");
+    assertThat(result.totalBattles()).isEqualTo(2);
+    assertThat(xp(a)).isEqualTo(100);
+    assertThat(xp(b)).isEqualTo(100);
+    assertThat(service.pendingRewards()).isEmpty();
+    assertThat(service.endExercise(id, "again")).isEqualTo(result);
+    nations.reload();
+    restart();
+    assertThat(service.endExercise(id, "after restart")).isEqualTo(result);
+    assertThat(xp(a)).isEqualTo(100);
+    assertThat(service.getRecentResults(10)).containsExactly(result);
+  }
+
+  @Test
+  void cancellingAfterBattleNeverGrantsRewardsOrChangesTerminalResult() {
+    var id = started(ExerciseType.FREE_FOR_ALL, 2);
+    fight(id);
+    var cancelled = service.cancelExercise(id, "cancelled");
+    assertThat(cancelled.isCancelled()).isTrue();
+    assertThat(xp(a)).isZero();
+    assertThat(service.endExercise(id, "finish")).isEqualTo(cancelled);
+    restart();
+    assertThat(service.getResult(id)).contains(cancelled);
+    assertThat(xp(b)).isZero();
+  }
+
+  @Test
+  void startingAndEndingWithoutBattleDoesNotFarmExperience() {
+    var id = started(ExerciseType.FREE_FOR_ALL, 2);
+    var result = service.endExercise(id, "empty");
+    assertThat(result.participantResults())
+        .allSatisfy(p -> assertThat(p.experienceGained()).isZero());
+    assertThat(xp(a)).isZero();
+    assertThat(service.pendingRewards()).isEmpty();
+  }
+
+  @Test
+  void pauseBlocksCombatAndTimeoutStillSettlesOnce() {
+    var id = started(ExerciseType.FREE_FOR_ALL, 2);
+    fight(id);
+    service.updateExerciseState(id, ExerciseState.PAUSED);
+    assertThat(fight(id)).isNull();
+    clock.advance(3600);
+    service.tick();
+    assertThat(current(id).state()).isEqualTo(ExerciseState.TIMEOUT);
+    assertThat(service.getResult(id).orElseThrow().isCancelled()).isFalse();
+    assertThat(xp(a)).isEqualTo(100);
+    service.tick();
+    assertThat(xp(a)).isEqualTo(100);
+  }
+
+  @Test
+  void casualtiesAutomaticallySettleAndDoNotCountAsSimulatedBattle() {
+    config = new ExerciseConfig(2, 4, 60, 0, 1, 100, 5, -5, 100, false, true);
+    restart();
+    var id = service.createExercise(a.id().value(), "One soldier", ExerciseType.FREE_FOR_ALL).id();
+    service.joinExercise(id, a.id().value(), 1);
+    service.joinExercise(id, b.id().value(), 1);
+    service.startExercise(id);
+    assertThat(service.recordPlayerDeath(id, a.id().value())).isTrue();
+    assertThat(current(id).state()).isEqualTo(ExerciseState.COMPLETED);
+    assertThat(service.recordPlayerDeath(id, a.id().value())).isFalse();
+    assertThat(xp(a)).isZero();
+    restart();
+    assertThat(current(id).getParticipant(a.id().value()).orElseThrow().casualties()).isEqualTo(1);
+  }
+
+  @Test
+  void beforeFirstSaveCanRetryWithoutFreezingOrPublishing() {
+    store.before = true;
+    assertThatThrownBy(
+            () -> service.createExercise(a.id().value(), "Fail", ExerciseType.FREE_FOR_ALL))
+        .isInstanceOf(IllegalStateException.class);
+    assertThat(service.getPendingExercises()).isEmpty();
+    assertThat(service.createExercise(a.id().value(), "Retry", ExerciseType.FREE_FOR_ALL))
+        .isNotNull();
+  }
+
+  @Test
+  void failedEndLeavesActiveStateAndNoExperience() {
+    var id = started(ExerciseType.FREE_FOR_ALL, 2);
+    fight(id);
+    store.before = true;
+    assertThatThrownBy(() -> service.endExercise(id, "fail"))
+        .isInstanceOf(IllegalStateException.class);
+    assertThat(current(id).state()).isEqualTo(ExerciseState.IN_PROGRESS);
+    assertThat(xp(a)).isZero();
+    restart();
+    service.endExercise(id, "retry");
+    assertThat(xp(a)).isEqualTo(100);
+  }
+
+  @Test
+  void lostSettlementReplyIsConfirmedThenAwardsOnlyOnce() {
+    var id = started(ExerciseType.FREE_FOR_ALL, 2);
+    fight(id);
+    store.lostReply = true;
+    assertThat(service.endExercise(id, "end")).isNotNull();
+    restart();
+    service.endExercise(id, "retry");
+    assertThat(xp(a)).isEqualTo(100);
+    assertThat(service.pendingRewards()).isEmpty();
+  }
+
+  @Test
+  void interruptedRewardAcknowledgementReplaysExistingNationReceipt() {
+    var id = started(ExerciseType.FREE_FOR_ALL, 2);
+    fight(id);
+    store.crashOnAcknowledgement = true;
+    assertThatThrownBy(() -> service.endExercise(id, "end")).isInstanceOf(AssertionError.class);
+    assertThatThrownBy(service::recoverRewards).isInstanceOf(IllegalStateException.class);
+    nations.reload();
+    restart();
+    assertThat(service.pendingRewards()).isEmpty();
+    assertThat(xp(a)).isEqualTo(100);
+    assertThat(xp(b)).isEqualTo(100);
+    restart();
+    assertThat(xp(a)).isEqualTo(100);
+  }
+
+  @Test
+  void rewardAuthorityLostReplyDoesNotRepeatExperience() {
+    var id = started(ExerciseType.FREE_FOR_ALL, 2);
+    fight(id);
+    nations.fault(ExerciseNationFixture.Fault.LOST_REPLY);
+    service.endExercise(id, "end");
+    nations.reload();
+    restart();
+    assertThat(xp(a)).isEqualTo(100);
+    assertThat(xp(b)).isEqualTo(100);
+    assertThat(service.pendingRewards()).isEmpty();
+  }
+
+  @Test
+  void rewardFailureRetainsOriginalIntentAndOtherRecipientsCanFinish() {
+    var id = started(ExerciseType.FREE_FOR_ALL, 2);
+    fight(id);
+    nations.fault(ExerciseNationFixture.Fault.BEFORE_SAVE);
+    var result = service.endExercise(id, "end");
+    assertThat(service.pendingRewards()).hasSize(1);
+    assertThat(xp(a) + xp(b)).isEqualTo(100);
+    service.recoverRewards();
+    assertThat(xp(a)).isEqualTo(100);
+    assertThat(xp(b)).isEqualTo(100);
+    assertThat(service.getResult(id)).contains(result);
+  }
+
+  @Test
+  void differentWriterCannotOverwriteCommittedParticipants() {
+    var id = service.createExercise(a.id().value(), "Concurrent", ExerciseType.FREE_FOR_ALL).id();
+    var stale =
+        new ExerciseServiceImpl(
+            plugin,
+            nations.module(),
+            config,
+            new FileExerciseStateStorage(root.resolve("exercise")),
+            clock,
+            false);
+    service.joinExercise(id, a.id().value(), 100);
+    assertThatThrownBy(() -> stale.joinExercise(id, b.id().value(), 100))
+        .isInstanceOf(IllegalStateException.class);
+    assertThatThrownBy(stale::getPendingExercises).isInstanceOf(IllegalStateException.class);
+    stale.shutdown();
+    restart();
+    assertThat(current(id).getNationIds()).containsExactly(a.id().value());
+  }
+
+  @Test
+  void callersCannotMutateStoredParticipantsAndOldServiceStops() {
+    var id = started(ExerciseType.FREE_FOR_ALL, 2);
+    var detached = current(id);
+    detached.getParticipant(a.id().value()).orElseThrow().addCasualties(50);
+    detached.setState(ExerciseState.CANCELLED);
+    assertThat(current(id).getParticipant(a.id().value()).orElseThrow().casualties()).isZero();
+    service.shutdown();
+    assertThatThrownBy(() -> fight(id)).isInstanceOf(IllegalStateException.class);
+  }
+
+  @Test
+  void alliedSideAndSelfCombatDoNotProduceStats() {
+    var id = started(ExerciseType.ATTACK_DEFENSE, 4);
+    var members = current(id).participants();
+    var first = members.getFirst();
+    var ally =
+        members.stream()
+            .filter(p -> !p.nationId().equals(first.nationId()) && p.role() == first.role())
+            .findFirst()
+            .orElseThrow();
+    assertThat(service.processBattle(id, first.nationId(), ally.nationId())).isNull();
+    assertThat(service.processBattle(id, first.nationId(), first.nationId())).isNull();
+    assertThat(current(id).totalBattles()).isZero();
+  }
+
+  @Test
+  void originZoneAndJoinLeaveAreSaved() {
+    var id = service.createExercise(a.id().value(), "Origin", ExerciseType.FREE_FOR_ALL).id();
+    assertThat(service.setLocation(id, "world", 0, 0, 25)).isTrue();
+    service.joinExercise(id, a.id().value(), 100);
+    assertThat(service.leaveExercise(id, a.id().value())).isTrue();
+    restart();
+    assertThat(current(id).centerX()).hasValue(0);
+    assertThat(current(id).centerZ()).hasValue(0);
+    assertThat(current(id).participantCount()).isZero();
+  }
+
+  @Test
+  void losingCaptainDoesNotEliminateRemainingTeam() {
+    var id = started(ExerciseType.ATTACK_DEFENSE, 4);
+    var red = current(id).redSideId().orElseThrow();
+    var remaining =
+        current(id).participants().stream()
+            .filter(p -> p.role() == ExerciseRole.ATTACKER && !p.nationId().equals(red))
+            .findFirst()
+            .orElseThrow()
+            .nationId();
+    for (int i = 0; i < 20; i++) service.recordPlayerDeath(id, red);
+    assertThat(current(id).state()).isEqualTo(ExerciseState.IN_PROGRESS);
+    for (int i = 0; i < 20; i++) service.recordPlayerDeath(id, remaining);
+    assertThat(current(id).state()).isEqualTo(ExerciseState.COMPLETED);
+    assertThat(service.getResult(id).orElseThrow().winnerId())
+        .isEqualTo(current(id).blueSideId().orElseThrow());
+  }
+
+  @Test
+  void eventOnlySeesCommittedStateAndCannotReenterMutation() {
+    try (var bukkit = mockStatic(org.bukkit.Bukkit.class)) {
+      var id = service.createExercise(a.id().value(), "Events", ExerciseType.FREE_FOR_ALL).id();
+      var manager = plugin.getServer().getPluginManager();
+      doAnswer(
+              call -> {
+                if (call.getArgument(0)
+                    instanceof
+                    dev.starcore.starcore.module.army.exercise.event.ExerciseJoinedEvent event) {
+                  assertThat(
+                          new ExerciseStateCodec()
+                              .decode(store.load())
+                              .exercises()
+                              .get(id)
+                              .participantCount())
+                      .isEqualTo(1);
+                  assertThat(service.pendingRewards()).isEmpty();
+                  assertThatThrownBy(() -> service.cancelExercise(id, "reentry"))
+                      .isInstanceOf(IllegalStateException.class);
+                  event.getExercise().setState(ExerciseState.CANCELLED);
+                }
+                return null;
+              })
+          .when(manager)
+          .callEvent(any());
+      assertThat(service.joinExercise(id, a.id().value(), 100)).isTrue();
+      assertThat(current(id).state()).isEqualTo(ExerciseState.WAITING);
+    }
+  }
+
+  static final class MutableClock extends Clock {
+    private Instant now = Instant.parse("2026-11-26T00:00:00Z");
+
+    public ZoneId getZone() {
+      return ZoneOffset.UTC;
+    }
+
+    public Clock withZone(ZoneId zone) {
+      return this;
+    }
+
+    public Instant instant() {
+      return now;
+    }
+
+    void advance(long seconds) {
+      now = now.plusSeconds(seconds);
+    }
+  }
+
+  static final class FaultStorage implements ExerciseStateStorage {
+    private final ExerciseStateStorage actual;
+    boolean before, lostReply, crashOnAcknowledgement;
+
+    FaultStorage(ExerciseStateStorage actual) {
+      this.actual = actual;
+    }
+
+    public Properties load() {
+      return actual.load();
+    }
+
+    public void save(Properties p) {
+      if (before) {
+        before = false;
+        throw new IllegalStateException("before save");
+      }
+      if (crashOnAcknowledgement && Integer.parseInt(p.getProperty("rewarded.count")) > 0) {
+        crashOnAcknowledgement = false;
+        throw new AssertionError("acknowledgement interrupted");
+      }
+      actual.save(p);
+      if (lostReply) {
+        lostReply = false;
+        throw new IllegalStateException("lost reply");
+      }
+    }
+  }
+}
