index 0000000..db2438e
--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/module/army/exercise/ExerciseSettlement.java
@@ -0,0 +1,73 @@
+package dev.starcore.starcore.module.army.exercise;
+
+import java.util.*;
+
+/** Version-1 settlement algorithm; results are derived solely from persisted terminal inputs. */
+final class ExerciseSettlement {
+  static ExerciseResult build(Exercise e, String reason) {
+    var sorted =
+        e.participants().stream()
+            .sorted(
+                Comparator.comparingInt(ExerciseParticipant::kills)
+                    .reversed()
+                    .thenComparing(
+                        Comparator.comparingDouble(ExerciseParticipant::combatPower).reversed())
+                    .thenComparing(p -> p.nationId().toString()))
+            .toList();
+    UUID winner = null;
+    String winnerName = null;
+    if (e.state() != ExerciseState.CANCELLED && !sorted.isEmpty()) {
+      if (e.type().requiresTwoSides()) {
+        double red = score(e, ExerciseRole.ATTACKER), blue = score(e, ExerciseRole.DEFENDER);
+        if (red != blue) winner = (red > blue ? e.redSideId() : e.blueSideId()).orElse(null);
+      } else if (sorted.size() == 1
+          || sorted.get(0).kills() != sorted.get(1).kills()
+          || sorted.get(0).combatPower() != sorted.get(1).combatPower())
+        winner = sorted.get(0).nationId();
+      if (winner != null) winnerName = e.getParticipant(winner).orElseThrow().nationName();
+    }
+    List<ExerciseResult.ParticipantResult> results = new ArrayList<>();
+    for (int i = 0; i < sorted.size(); i++) {
+      var p = sorted.get(i);
+      double xp =
+          e.config().rewardsEnabled()
+                  && e.state() != ExerciseState.CANCELLED
+                  && e.totalBattles() > 0
+              ? e.config().experienceGainPerParticipant()
+              : 0;
+      results.add(
+          new ExerciseResult.ParticipantResult(
+              p.nationId(),
+              p.nationName(),
+              p.role(),
+              p.soldierCount(),
+              p.casualties(),
+              p.kills(),
+              p.battles(),
+              p.wins(),
+              p.losses(),
+              p.morale(),
+              xp,
+              i + 1));
+    }
+    return ExerciseResult.builder()
+        .exerciseId(e.id())
+        .exerciseName(e.name())
+        .type(e.type())
+        .endState(e.state())
+        .endReason(reason)
+        .startedAt(e.startedAt() == null ? e.createdAt() : e.startedAt())
+        .endedAt(e.endedAt())
+        .totalBattles(e.totalBattles())
+        .addParticipantResults(results)
+        .winner(winner, winnerName)
+        .build();
+  }
+
+  private static double score(Exercise e, ExerciseRole side) {
+    return e.participants().stream()
+        .filter(p -> p.role() == side)
+        .mapToDouble(p -> p.combatPower() + 10.0 * p.kills())
+        .sum();
+  }
+}
diff --git a/src/main/java/dev/starcore/starcore/module/army/exercise/ExerciseSnapshot.java b/src/main/java/dev/starcore/starcore/module/army/exercise/ExerciseSnapshot.java
