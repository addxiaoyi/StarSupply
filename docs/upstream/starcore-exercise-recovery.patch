+package dev.starcore.starcore.module.nation;
+
+import static org.assertj.core.api.Assertions.*;
+
+import com.zaxxer.hikari.HikariConfig;
+import com.zaxxer.hikari.HikariDataSource;
+import dev.starcore.starcore.module.nation.model.*;
+import java.nio.file.Path;
+import java.util.*;
+import java.util.logging.Logger;
+import org.junit.jupiter.api.*;
+import org.junit.jupiter.api.io.TempDir;
+
+class NationExperienceSqlTest {
+  @TempDir Path root;
+  HikariDataSource pool;
+  final Nation nation = new Nation(NationId.random(), "Nation", UUID.randomUUID(), "Founder");
+  final NationExperienceService.Grant grant =
+      new NationExperienceService.Grant("exercise-sql", nation.id(), 100);
+  final List<SqlNationStateStorage> storages = new ArrayList<>();
+
+  @BeforeEach
+  void setup() {
+    var c = new HikariConfig();
+    c.setJdbcUrl("jdbc:sqlite:" + root.resolve("nation.db"));
+    c.setMaximumPoolSize(3);
+    pool = new HikariDataSource(c);
+  }
+
+  @AfterEach
+  void close() {
+    storages.forEach(SqlNationStateStorage::shutdown);
+    pool.close();
+  }
+
+  SqlNationStateStorage storage(Properties legacy) {
+    var s = new SqlNationStateStorage(pool, legacy, Logger.getAnonymousLogger());
+    storages.add(s);
+    return s;
+  }
+
+  @Test
+  void sqliteStaleWriterCannotApplyExperienceTwice() {
+    storage(new Properties()).save(NationStateCodec.toProperties(List.of(nation)));
+    var first = ExerciseNationFixture.configured(storage(new Properties()));
+    var second = ExerciseNationFixture.configured(storage(new Properties()));
+    var receipt = first.grantExperience(grant);
+    assertThatThrownBy(() -> second.grantExperience(grant))
+        .isInstanceOf(NationStateConflictException.class);
+    assertThat(second.grantExperience(grant)).isEqualTo(receipt);
+    var restarted = ExerciseNationFixture.configured(storage(new Properties()));
+    assertThat(restarted.grantExperience(grant)).isEqualTo(receipt);
+    assertThat(restarted.nationById(nation.id()).orElseThrow().experience()).isEqualTo(100);
+  }
+
+  @Test
+  void migrationPreservesExistingReceiptAndOrdinaryRename() {
+    nation.setExperience(100);
+    nation.retainExperienceReceipt(
+        new NationExperienceService.Receipt(grant, java.time.Instant.EPOCH));
+    var module =
+        ExerciseNationFixture.configured(storage(NationStateCodec.toProperties(List.of(nation))));
+    module.grantExperience(grant);
+    module.renameNation(nation.id(), "Renamed");
+    var restarted = ExerciseNationFixture.configured(storage(new Properties()));
+    restarted.grantExperience(grant);
+    assertThat(restarted.nationById(nation.id()).orElseThrow().experience()).isEqualTo(100);
+    assertThat(restarted.nationById(nation.id()).orElseThrow().name()).isEqualTo("Renamed");
+  }
+
+  @Test
+  void damagedReceiptIsRejectedBeforeMigrationWritesAnything() throws Exception {
+    nation.setExperience(100);
+    nation.retainExperienceReceipt(
+        new NationExperienceService.Receipt(grant, java.time.Instant.EPOCH));
+    var p = NationStateCodec.toProperties(List.of(nation));
+    p.remove("nation.0.experienceReceipt.0.id");
+    assertThatThrownBy(() -> storage(p).load()).isInstanceOf(IllegalStateException.class);
+    try (var c = pool.getConnection();
+        var s = c.createStatement();
+        var r = s.executeQuery("SELECT COUNT(*) FROM starcore_nation_state")) {
+      assertThat(r.next()).isTrue();
+      assertThat(r.getInt(1)).isZero();
+    }
+  }
+
+  @Test
+  void emptyPreviouslyPublishedTableDoesNotReimportStaleFile() throws Exception {
+    var legacy = NationStateCodec.toProperties(List.of(nation));
+    var original = storage(legacy);
+    var module = ExerciseNationFixture.configured(original);
+    module.grantExperience(grant);
+    try (var c = pool.getConnection();
+        var s = c.createStatement()) {
+      s.executeUpdate(
+          "DELETE FROM starcore_nation_state WHERE property_key <> '__starcore_revision__'");
+    }
+    assertThatThrownBy(original::load).isInstanceOf(IllegalStateException.class);
+    assertThatThrownBy(() -> storage(legacy).load()).isInstanceOf(IllegalStateException.class);
+  }
+}
