+  public synchronized TransferReceipt transferBatch(TransferRequest request) {
+    return transfer(request, false);
+  }
+
+  public synchronized TransferReceipt cancelTransfer(TransferRequest request) {
+    return transfer(request, true);
+  }
+
+  public synchronized Optional<TransferReceipt> transferReceipt(UUID id) {
+    return Optional.ofNullable(load().transfers().get(Objects.requireNonNull(id)));
+  }
+
+  private TransferReceipt transfer(TransferRequest request, boolean cancel) {
+    Objects.requireNonNull(request);
+    var state = load();
+    var previous = state.transfers().get(request.operationId());
+    if (previous != null) {
+      if (!previous.request().equals(request))
+        throw new IllegalArgumentException("Conflicting territory transfer");
+      return previous;
+    }
+    TransferStatus status = cancel ? TransferStatus.CANCELLED : TransferStatus.APPLIED;
+    if (!cancel) {
+      if (request.coordinates().stream()
+          .anyMatch(
+              c -> !new TerritoryClaim(request.sourceOwner(), c).equals(state.claims().get(c))))
+        status = TransferStatus.OWNER_CHANGED;
+      else if (state.claims().values().stream()
+                  .filter(c -> c.ownerId().equals(request.sourceOwner()))
+                  .count()
+              - request.coordinates().size()
+          < request.minimumRemainingClaims()) status = TransferStatus.REMAINING_LIMIT;
+    }
+    var next = new HashMap<>(state.claims());
+    var transfers = new HashMap<>(state.transfers());
+    var result = new TransferReceipt(request, status);
+    transfers.put(request.operationId(), result);
+    if (status == TransferStatus.APPLIED)
+      for (var c : request.coordinates()) next.put(c, new TerritoryClaim(request.targetOwner(), c));
+    commit(new TerritoryLedger(next, state.receipts(), transfers));
     return result;
   }
 
