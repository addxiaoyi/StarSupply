@@ -0,0 +1,87 @@
+package dev.starcore.starcore.module.nation;
+
+import dev.starcore.starcore.foundation.territory.model.ChunkCoordinate;
+import dev.starcore.starcore.module.nation.model.NationId;
+import java.time.Instant;
+import java.util.*;
+
+final class NationSplitOperationCodec {
+  static final String PREFIX = "splitOperations.";
+
+  private NationSplitOperationCodec() {}
+
+  static void write(Properties p, Map<UUID, NationSplitOperation> operations) {
+    p.setProperty(PREFIX + "version", "1");
+    p.setProperty(PREFIX + "count", Integer.toString(operations.size()));
+    int i = 0;
+    for (var e : operations.entrySet().stream().sorted(Map.Entry.comparingByKey()).toList()) {
+      var op = e.getValue();
+      var r = op.request();
+      if (!e.getKey().equals(r.operationId()))
+        throw new IllegalArgumentException("Split key mismatch");
+      String k = PREFIX + i++ + ".";
+      p.setProperty(k + "id", r.operationId().toString());
+      p.setProperty(k + "source", r.sourceNationId().toString());
+      p.setProperty(k + "founder", r.founderId().toString());
+      p.setProperty(k + "name", r.name());
+      p.setProperty(k + "minimum", "" + r.minimumRemainingClaims());
+      p.setProperty(k + "target", op.targetNationId().toString());
+      p.setProperty(k + "founderName", op.founderName());
+      p.setProperty(k + "foundedAt", op.foundedAt().toString());
+      p.setProperty(k + "state", op.state().name());
+      p.setProperty(k + "outcome", op.outcome().name());
+      p.setProperty(k + "detail", op.detail());
+      p.setProperty(k + "count", "" + r.coordinates().size());
+      for (int j = 0; j < r.coordinates().size(); j++) {
+        var c = r.coordinates().get(j);
+        String t = k + "chunk." + j + ".";
+        p.setProperty(t + "world", c.world());
+        p.setProperty(t + "x", "" + c.x());
+        p.setProperty(t + "z", "" + c.z());
+      }
+    }
+  }
+
+  static Map<UUID, NationSplitOperation> read(Properties p) {
+    if (!"1".equals(p.getProperty(PREFIX + "version")))
+      throw new IllegalArgumentException("Invalid split version");
+    int count = Integer.parseInt(p.getProperty(PREFIX + "count"));
+    if (count < 1 || count > 100_000) throw new IllegalArgumentException("Invalid split count");
+    Map<UUID, NationSplitOperation> result = new LinkedHashMap<>();
+    for (int i = 0; i < count; i++) {
+      String k = PREFIX + i + ".";
+      int size = Integer.parseInt(p.getProperty(k + "count"));
+      if (size < 1 || size > 100_000)
+        throw new IllegalArgumentException("Invalid split coordinates");
+      List<ChunkCoordinate> coordinates = new ArrayList<>();
+      for (int j = 0; j < size; j++) {
+        String t = k + "chunk." + j + ".";
+        coordinates.add(
+            new ChunkCoordinate(
+                p.getProperty(t + "world"),
+                Integer.parseInt(p.getProperty(t + "x")),
+                Integer.parseInt(p.getProperty(t + "z"))));
+      }
+      var request =
+          new NationSplitService.Request(
+              UUID.fromString(p.getProperty(k + "id")),
+              new NationId(UUID.fromString(p.getProperty(k + "source"))),
+              UUID.fromString(p.getProperty(k + "founder")),
+              p.getProperty(k + "name"),
+              coordinates,
+              Integer.parseInt(p.getProperty(k + "minimum")));
+      var op =
+          new NationSplitOperation(
+              request,
+              new NationId(UUID.fromString(p.getProperty(k + "target"))),
+              p.getProperty(k + "founderName"),
+              Instant.parse(p.getProperty(k + "foundedAt")),
+              NationSplitService.State.valueOf(p.getProperty(k + "state")),
+              NationSplitOutcome.Status.valueOf(p.getProperty(k + "outcome")),
+              p.getProperty(k + "detail"));
+      if (result.putIfAbsent(request.operationId(), op) != null)
+        throw new IllegalArgumentException("Duplicate split operation");
+    }
+    return Map.copyOf(result);
+  }
+}
