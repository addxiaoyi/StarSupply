+package dev.starcore.starcore.module.nation.command;
+
+import static org.mockito.Mockito.*;
+
+import dev.starcore.starcore.module.nation.NationService;
+import dev.starcore.starcore.module.nation.NationSplitService;
+import java.util.List;
+import java.util.UUID;
+import org.bukkit.command.CommandSender;
+import org.bukkit.plugin.Plugin;
+import org.junit.jupiter.api.Test;
+
+class NationSplitRecoveryCommandTest {
+  @Test
+  void permissionsProtectConsoleQueriesAndCancellation() {
+    var nations =
+        mock(NationService.class, withSettings().extraInterfaces(NationSplitService.class));
+    var service = (NationSplitService) nations;
+    var sender = mock(CommandSender.class);
+    var command = new NationLifecycleCommand(mock(Plugin.class), nations);
+    var id = UUID.randomUUID().toString();
+    command.onCommand(
+        sender, null, "nation", new String[] {"splitrecovery", "cancel", id, "confirm"});
+    verifyNoInteractions(nations);
+    when(sender.hasPermission("starcore.admin")).thenReturn(true);
+    command.onCommand(sender, null, "nation", new String[] {"splitrecovery", "cancel", id});
+    verifyNoInteractions(nations);
+    when(service.pendingSplits()).thenReturn(List.of());
+    command.onCommand(sender, null, "nation", new String[] {"splitrecovery", "list"});
+    verify(service).pendingSplits();
+    command.onCommand(sender, null, "nation", new String[] {"splitrecovery", "retry", id});
+    verify(service).recoverSplit(UUID.fromString(id));
+    command.onCommand(
+        sender, null, "nation", new String[] {"splitrecovery", "cancel", id, "confirm"});
+    verify(service).cancelSplit(UUID.fromString(id));
+  }
+
+  @Test
+  void retiredCommandCannotRecoverOrForward() {
+    var nations =
+        mock(NationService.class, withSettings().extraInterfaces(NationSplitService.class));
+    var plugin = mock(Plugin.class);
+    var command = new NationLifecycleCommand(plugin, nations);
+    var sender = mock(CommandSender.class);
+    when(sender.hasPermission("starcore.admin")).thenReturn(true);
+    command.shutdown();
+    command.onCommand(sender, null, "nation", new String[] {"splitrecovery", "list"});
+    command.onCommand(sender, null, "nation", new String[] {"create", "New"});
+    verifyNoInteractions(nations, plugin);
+  }
+}
