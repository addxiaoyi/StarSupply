+package dev.starcore.starcore.module.nation;
+
+import dev.starcore.starcore.foundation.territory.TerritoryTransferService;
+import dev.starcore.starcore.module.nation.model.*;
+import java.nio.charset.StandardCharsets;
+import java.time.Instant;
+import java.util.*;
+
+record NationSplitOperation(
+    NationSplitService.Request request,
+    NationId targetNationId,
+    String founderName,
+    Instant foundedAt,
+    NationSplitService.State state,
+    NationSplitOutcome.Status outcome,
+    String detail) {
+  NationSplitOperation {
+    Objects.requireNonNull(request);
+    Objects.requireNonNull(targetNationId);
+    Objects.requireNonNull(foundedAt);
+    Objects.requireNonNull(state);
+    Objects.requireNonNull(outcome);
+    if (founderName == null
+        || founderName.isBlank()
+        || founderName.length() > 128
+        || detail == null
+        || detail.length() > 512
+        || targetNationId.equals(request.sourceNationId())
+        || (state == NationSplitService.State.COMPLETED)
+            != (outcome == NationSplitOutcome.Status.SUCCESS))
+      throw new IllegalArgumentException("Invalid nation split operation");
+  }
+
+  Nation candidate() {
+    Nation nation =
+        new Nation(
+            targetNationId,
+            request.name(),
+            request.founderId(),
+            founderName,
+            NationKind.NATION,
+            null,
+            foundedAt);
+    nation.addMember(
+        new NationMember(request.founderId(), founderName, "Member", foundedAt, foundedAt));
+    return nation;
+  }
+
+  NationSplitOperation state(
+      NationSplitService.State next, NationSplitOutcome.Status result, String reason) {
+    return new NationSplitOperation(
+        request, targetNationId, founderName, foundedAt, next, result, reason);
+  }
+
+  NationSplitService.Receipt receipt() {
+    return new NationSplitService.Receipt(request, targetNationId, state, outcome, detail);
+  }
+
+  TerritoryTransferService.TransferRequest transfer() {
+    UUID id =
+        UUID.nameUUIDFromBytes(
+            ("nation-split/" + request.operationId() + "/land").getBytes(StandardCharsets.UTF_8));
+    return new TerritoryTransferService.TransferRequest(
+        id,
+        request.sourceNationId().toString(),
+        targetNationId.toString(),
+        request.coordinates(),
+        request.minimumRemainingClaims());
+  }
+}
