+package dev.starcore.starcore.foundation.territory;
+
+import dev.starcore.starcore.foundation.territory.model.ChunkCoordinate;
+import java.util.*;
+
+/** Transfer and immutable receipt share one authority commit. Retain the original request ID. */
+public interface TerritoryTransferService {
+  enum TransferStatus {
+    APPLIED,
+    OWNER_CHANGED,
+    REMAINING_LIMIT,
+    CANCELLED
+  }
+
+  record TransferRequest(
+      UUID operationId,
+      String sourceOwner,
+      String targetOwner,
+      List<ChunkCoordinate> coordinates,
+      int minimumRemainingClaims) {
+    public TransferRequest {
+      var validated = new TerritoryBatchService.Request(operationId, sourceOwner, coordinates, -1);
+      coordinates = validated.coordinates();
+      if (targetOwner == null
+          || targetOwner.isBlank()
+          || targetOwner.length() > 64
+          || sourceOwner.equals(targetOwner)
+          || minimumRemainingClaims < 0)
+        throw new IllegalArgumentException("Invalid territory transfer");
+    }
+  }
+
+  record TransferReceipt(TransferRequest request, TransferStatus status) {
+    public TransferReceipt {
+      Objects.requireNonNull(request);
+      Objects.requireNonNull(status);
+    }
+  }
+
+  TransferReceipt transferBatch(TransferRequest request);
+
+  /** Seals an unpublished transfer. A previously committed transfer wins. */
+  TransferReceipt cancelTransfer(TransferRequest request);
+
+  Optional<TransferReceipt> transferReceipt(UUID operationId);
+}
