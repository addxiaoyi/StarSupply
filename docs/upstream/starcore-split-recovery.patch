+package dev.starcore.starcore.module.nation;
+
+import dev.starcore.starcore.foundation.territory.TerritoryBatchService;
+import dev.starcore.starcore.foundation.territory.model.ChunkCoordinate;
+import dev.starcore.starcore.module.nation.model.NationId;
+import java.util.*;
+
+/** Durable splits. Callers authorize the action and retain the original operation ID. */
+public interface NationSplitService {
+  enum State {
+    PREPARED,
+    CANCEL_PENDING,
+    COMPLETED,
+    REJECTED,
+    CANCELLED;
+
+    public boolean pending() {
+      return this == PREPARED || this == CANCEL_PENDING;
+    }
+  }
+
+  record Request(
+      UUID operationId,
+      NationId sourceNationId,
+      UUID founderId,
+      String name,
+      List<ChunkCoordinate> coordinates,
+      int minimumRemainingClaims) {
+    public Request {
+      Objects.requireNonNull(sourceNationId);
+      Objects.requireNonNull(founderId);
+      name = Objects.requireNonNull(name).trim();
+      if (name.isEmpty() || name.length() > 128 || minimumRemainingClaims < 0)
+        throw new IllegalArgumentException("Invalid nation split request");
+      coordinates =
+          new TerritoryBatchService.Request(operationId, sourceNationId.toString(), coordinates, -1)
+              .coordinates();
+    }
+  }
+
+  record Receipt(
+      Request request,
+      NationId targetNationId,
+      State state,
+      NationSplitOutcome.Status outcome,
+      String detail) {}
+
+  Receipt split(Request request);
+
+  Optional<Receipt> splitOperation(UUID operationId);
+
+  List<Receipt> pendingSplits();
+
+  Receipt recoverSplit(UUID operationId);
+
+  /** Already committed land completes the split; unpublished land is sealed against late calls. */
+  Receipt cancelSplit(UUID operationId);
+}
