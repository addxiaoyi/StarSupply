+package dev.starcore.starcore.foundation.territory;
+
+import static dev.starcore.starcore.foundation.territory.TerritoryTransferService.TransferStatus.*;
+import static org.assertj.core.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+import dev.starcore.starcore.core.persistence.PersistenceService;
+import dev.starcore.starcore.foundation.territory.model.*;
+import java.nio.file.Path;
+import java.util.*;
+import java.util.concurrent.*;
+import java.util.function.Supplier;
+import org.junit.jupiter.api.*;
+import org.junit.jupiter.api.io.TempDir;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.*;
+import org.sqlite.SQLiteDataSource;
+
+class TerritoryTransferRecoveryTest {
+  @TempDir Path directory;
+  final ChunkCoordinate first = new ChunkCoordinate("world", 1, 0),
+      second = new ChunkCoordinate("world", 2, 0),
+      retained = new ChunkCoordinate("world", 3, 0);
+
+  SQLiteDataSource source() {
+    var ds = new SQLiteDataSource();
+    ds.setUrl("jdbc:sqlite:" + directory.resolve("land.db"));
+    return ds;
+  }
+
+  Supplier<TerritoryLedgerStorage> stores(boolean sql) throws Exception {
+    var p = mock(PersistenceService.class);
+    when(p.namespacePath("territory")).thenReturn(directory);
+    var ds = source();
+    return sql
+        ? () ->
+            new SqlTerritoryLedgerStorage(
+                () -> Optional.of(ds), () -> new TerritoryLedger(Map.of(), Map.of()))
+        : () -> new FileTerritoryLedgerStorage(p);
+  }
+
+  DurableTerritoryService land(TerritoryLedgerStorage store) {
+    return new InMemoryTerritoryService(store);
+  }
+
+  TerritoryTransferService.TransferRequest request(ChunkCoordinate... coordinates) {
+    return new TerritoryTransferService.TransferRequest(
+        UUID.randomUUID(), "source", "target", List.of(coordinates), 1);
+  }
+
+  void seed(DurableTerritoryService land) {
+    land.claim("source", first);
+    land.claim("source", second);
+    land.claim("source", retained);
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void transferPreservesBatchReceiptsAndNeverReplaysLaterOwnership(boolean sql) throws Exception {
+    var stores = stores(sql);
+    var land = land(stores.get());
+    var batch =
+        new TerritoryBatchService.Request(
+            UUID.randomUUID(), "source", List.of(first, second, retained), 3);
+    land.claimBatch(batch);
+    var request = request(first, second);
+    var result = land.transferBatch(request);
+    assertThat(result.status()).isEqualTo(APPLIED);
+    assertThat(land.claimsByOwner("source"))
+        .extracting(TerritoryClaim::coordinate)
+        .containsExactly(retained);
+    assertThat(land.unclaim("target", first)).isTrue();
+    land.claim("other", first);
+    land.transferClaims("target", "other", List.of(second));
+    var restarted = land(stores.get());
+    assertThat(restarted.transferBatch(request)).isEqualTo(result);
+    assertThat(restarted.cancelTransfer(request)).isEqualTo(result);
+    assertThat(restarted.claimBatch(batch).status())
+        .isEqualTo(TerritoryBatchService.Status.APPLIED);
+    assertThat(restarted.claimsByOwner("other")).hasSize(2);
+    assertThat(restarted.claimsByOwner("target")).isEmpty();
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void cancellationAndRejectionAreTerminalAcrossRestart(boolean sql) throws Exception {
+    var stores = stores(sql);
+    var land = land(stores.get());
+    seed(land);
+    var cancel = request(first);
+    assertThat(land.cancelTransfer(cancel).status()).isEqualTo(CANCELLED);
+    assertThat(land(stores.get()).transferBatch(cancel).status()).isEqualTo(CANCELLED);
+    var limit = request(first, second, retained);
+    assertThat(land.transferBatch(limit).status()).isEqualTo(REMAINING_LIMIT);
+    land.claim("source", new ChunkCoordinate("world", 4, 0));
+    assertThat(land(stores.get()).transferBatch(limit).status()).isEqualTo(REMAINING_LIMIT);
+    var mismatch = request(first, second);
+    land.transferClaims("source", "other", List.of(second));
+    assertThat(land.transferBatch(mismatch).status()).isEqualTo(OWNER_CHANGED);
+    assertThat(land.isOwnerOf("source", first)).isTrue();
+    land.transferClaims("other", "source", List.of(second));
+    assertThat(land(stores.get()).transferBatch(mismatch).status()).isEqualTo(OWNER_CHANGED);
+    assertThatThrownBy(
+            () ->
+                land.transferBatch(
+                    new TerritoryTransferService.TransferRequest(
+                        cancel.operationId(), "source", "different", cancel.coordinates(), 1)))
+        .isInstanceOf(IllegalArgumentException.class);
+  }
+
+  @ParameterizedTest
+  @CsvSource({"false,false", "false,true", "true,false", "true,true"})
+  void interruptedCommitRecoversOriginalTransfer(boolean sql, boolean after) throws Exception {
+    var stores = stores(sql);
+    seed(land(stores.get()));
+    var fault = new TerritoryBatchRecoveryTest.FaultStore(stores.get());
+    var land = land(fault);
+    fault.fail = true;
+    fault.after = after;
+    fault.blockRead = true;
+    var request = request(first, second);
+    assertThatThrownBy(() -> land.transferBatch(request)).isInstanceOf(IllegalStateException.class);
+    var restarted = land(stores.get());
+    assertThat(restarted.transferReceipt(request.operationId()).isPresent()).isEqualTo(after);
+    assertThat(restarted.claimsByOwner(after ? "target" : "source")).hasSize(after ? 2 : 3);
+    assertThat(restarted.transferBatch(request).status()).isEqualTo(APPLIED);
+    assertThat(land(stores.get()).claimsByOwner("target")).hasSize(2);
+  }
+
+  @ParameterizedTest
+  @ValueSource(strings = {"starcore_territory_claims", "starcore_territory_transfer_receipts"})
+  void sqlFailureRollsBackLandAndReceipt(String table) throws Exception {
+    var stores = stores(true);
+    var land = land(stores.get());
+    seed(land);
+    var request = request(first, second);
+    try (var c = source().getConnection();
+        var s = c.createStatement()) {
+      s.execute(
+          "CREATE TRIGGER fail_transfer BEFORE INSERT ON "
+              + table
+              + " BEGIN SELECT RAISE(ABORT,'injected'); END");
+    }
+    assertThatThrownBy(() -> land.transferBatch(request)).isInstanceOf(IllegalStateException.class);
+    assertThat(land(stores.get()).claimsByOwner("source")).hasSize(3);
+    assertThat(land(stores.get()).transferReceipt(request.operationId())).isEmpty();
+    try (var c = source().getConnection();
+        var s = c.createStatement()) {
+      s.execute("DROP TRIGGER fail_transfer");
+    }
+    assertThat(land(stores.get()).transferBatch(request).status()).isEqualTo(APPLIED);
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void concurrentTransfersCheckRemainingLimitAtCommit(boolean sql) throws Exception {
+    var stores = stores(sql);
+    var initial = land(stores.get());
+    initial.claim("source", first);
+    initial.claim("source", second);
+    var barrier = new CyclicBarrier(2);
+    var a = land(new TerritoryBatchRecoveryTest.BarrierStore(stores.get(), barrier));
+    var b = land(new TerritoryBatchRecoveryTest.BarrierStore(stores.get(), barrier));
+    var x = request(first);
+    var y = request(second);
+    try (var executor = Executors.newFixedThreadPool(2)) {
+      var one = executor.submit(() -> attempt(a, x));
+      var two = executor.submit(() -> attempt(b, y));
+      one.get(15, TimeUnit.SECONDS);
+      two.get(15, TimeUnit.SECONDS);
+    }
+    var restarted = land(stores.get());
+    assertThat(List.of(restarted.transferBatch(x).status(), restarted.transferBatch(y).status()))
+        .containsExactlyInAnyOrder(APPLIED, REMAINING_LIMIT);
+    assertThat(restarted.claimsByOwner("source")).hasSize(1);
+  }
+
+  static void attempt(DurableTerritoryService land, TerritoryTransferService.TransferRequest r) {
+    try {
+      land.transferBatch(r);
+    } catch (IllegalStateException expected) {
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void storesRefuseReceiptRemovalOrMutation(boolean sql) throws Exception {
+    var stores = stores(sql);
+    var land = land(stores.get());
+    seed(land);
+    var request = request(first);
+    land.transferBatch(request);
+    var store = stores.get();
+    var state = store.load();
+    assertThatThrownBy(() -> store.save(new TerritoryLedger(state.claims(), state.receipts())))
+        .isInstanceOf(IllegalStateException.class);
+    assertThat(land(stores.get()).transferReceipt(request.operationId())).isPresent();
+  }
+
+  @Test
+  void deletedSqlTransferAuthorityFailsAfterRestart() throws Exception {
+    var stores = stores(true);
+    var land = land(stores.get());
+    seed(land);
+    land.transferBatch(request(first));
+    try (var c = source().getConnection();
+        var s = c.createStatement()) {
+      s.execute("DROP TABLE starcore_territory_transfer_receipts");
+    }
+    assertThatThrownBy(() -> land(stores.get())).isInstanceOf(IllegalStateException.class);
+  }
+
+  @Test
+  void codecRejectsIncompleteTransferEnvelopeAndInvalidRequests() {
+    var request = request(first);
+    var ledger =
+        new TerritoryLedger(
+            Map.of(),
+            Map.of(),
+            Map.of(
+                request.operationId(),
+                new TerritoryTransferService.TransferReceipt(request, CANCELLED)));
+    var p = ledger.properties();
+    assertThat(TerritoryLedger.decode(p)).isEqualTo(ledger);
+    p.remove("transfers.0.source");
+    p.setProperty("batches.sha256", TerritoryLedger.checksum(p));
+    assertThatThrownBy(() -> TerritoryLedger.decode(p)).isInstanceOf(RuntimeException.class);
+    assertThatThrownBy(() -> request(first, first)).isInstanceOf(IllegalArgumentException.class);
+    assertThatThrownBy(
+            () ->
+                new TerritoryTransferService.TransferRequest(
+                    UUID.randomUUID(), "same", "same", List.of(first), 1))
+        .isInstanceOf(IllegalArgumentException.class);
+  }
+}
