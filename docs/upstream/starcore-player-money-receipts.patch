@@ -0,0 +1,61 @@
+package dev.starcore.starcore.foundation.economy;
+
+import java.math.BigDecimal;
+import java.nio.charset.StandardCharsets;
+import java.util.Base64;
+import java.util.UUID;
+
+/** Same versioned payload in the atomic file snapshot and SQL receipt table. */
+final class PlayerMoneyReceiptCodec {
+  static final String PREFIX = "money-receipt:";
+
+  private PlayerMoneyReceiptCodec() {}
+
+  static String key(PlayerMoneyService.Receipt receipt) {
+    return PREFIX + receipt.request().operationId();
+  }
+
+  static String encode(PlayerMoneyService.Receipt receipt) {
+    var request = receipt.request();
+    return String.join(
+        ";",
+        "1",
+        request.accountId().toString(),
+        request.direction().name(),
+        request.amount().toPlainString(),
+        receipt.status().name(),
+        receipt.balanceBefore().toPlainString(),
+        receipt.balanceAfter().toPlainString(),
+        Long.toString(receipt.recordedAt()),
+        Base64.getUrlEncoder()
+            .withoutPadding()
+            .encodeToString(request.source().getBytes(StandardCharsets.UTF_8)));
+  }
+
+  static PlayerMoneyService.Receipt decode(String key, String payload) {
+    if (!key.startsWith(PREFIX)) throw new IllegalArgumentException("Invalid player receipt key");
+    UUID operationId = UUID.fromString(key.substring(PREFIX.length()));
+    if (!key.equals(PREFIX + operationId))
+      throw new IllegalArgumentException("Noncanonical player receipt key");
+    String[] parts = payload.split(";", -1);
+    if (parts.length != 9 || !parts[0].equals("1"))
+      throw new IllegalArgumentException("Invalid player receipt format");
+    var request =
+        new PlayerMoneyService.Request(
+            operationId,
+            UUID.fromString(parts[1]),
+            PlayerMoneyService.Direction.valueOf(parts[2]),
+            new BigDecimal(parts[3]),
+            new String(Base64.getUrlDecoder().decode(parts[8]), StandardCharsets.UTF_8));
+    var receipt =
+        new PlayerMoneyService.Receipt(
+            request,
+            PlayerMoneyService.Status.valueOf(parts[4]),
+            new BigDecimal(parts[5]),
+            new BigDecimal(parts[6]),
+            Long.parseLong(parts[7]));
+    if (!encode(receipt).equals(payload))
+      throw new IllegalArgumentException("Noncanonical player receipt payload");
+    return receipt;
+  }
+}
