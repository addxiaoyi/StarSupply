+  @Test
+  void providerCannotSilentlyChangeAmountAndDeniedReceiptDoesNotReinvokeIt() {
+    var source = source();
+    var service = economy(source);
+    var credit = request(PlayerMoneyService.Direction.CREDIT, "8");
+    var registry = mock(ExtensionRegistry.class);
+    when(registry.execute(eq("economy_transaction"), any()))
+        .thenReturn(
+            new EconomyTransactionExtensionPoint.TransactionResult(
+                true, new BigDecimal("7"), "changed", Map.of()));
+    try (var mocked = mockStatic(ExtensionRegistry.class)) {
+      mocked.when(ExtensionRegistry::getInstance).thenReturn(registry);
+      var receipt = service.applyMoney(credit);
+      assertThat(receipt.status()).isEqualTo(PlayerMoneyService.Status.EXTENSION_REJECTED);
+      assertThat(service.applyMoney(credit)).isEqualTo(receipt);
+      verify(registry, times(1)).execute(eq("economy_transaction"), any());
+    }
+    assertThat(economy(source).balance(player)).isEqualByComparingTo("0");
