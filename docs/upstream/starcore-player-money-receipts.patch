--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/foundation/economy/PlayerMoneyService.java
@@ -0,0 +1,88 @@
+package dev.starcore.starcore.foundation.economy;
+
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.util.Objects;
+import java.util.Optional;
+import java.util.UUID;
+
+/**
+ * Durable, business-keyed player money operations. Reuse the complete original request on retry.
+ */
+public interface PlayerMoneyService {
+  BigDecimal MAX_BALANCE = new BigDecimal("99999999999999999.99");
+
+  enum Direction {
+    CREDIT,
+    DEBIT
+  }
+
+  enum Status {
+    APPLIED,
+    INSUFFICIENT_FUNDS,
+    EXTENSION_REJECTED,
+    BALANCE_LIMIT
+  }
+
+  record Request(
+      UUID operationId, UUID accountId, Direction direction, BigDecimal amount, String source) {
+    public Request {
+      Objects.requireNonNull(operationId, "operationId");
+      Objects.requireNonNull(accountId, "accountId");
+      Objects.requireNonNull(direction, "direction");
+      amount = Objects.requireNonNull(amount, "amount").setScale(2, RoundingMode.UNNECESSARY);
+      if (amount.signum() <= 0 || amount.compareTo(MAX_BALANCE) > 0) {
+        throw new IllegalArgumentException("Unsupported money amount");
+      }
+      if (source == null || source.isBlank() || source.length() > 512) {
+        throw new IllegalArgumentException("Money source must contain 1-512 characters");
+      }
+    }
+  }
+
+  /**
+   * Terminal result persisted together with the balance; rejected requests also consume their ID.
+   */
+  record Receipt(
+      Request request,
+      Status status,
+      BigDecimal balanceBefore,
+      BigDecimal balanceAfter,
+      long recordedAt) {
+    public Receipt {
+      Objects.requireNonNull(request, "request");
+      Objects.requireNonNull(status, "status");
+      balanceBefore =
+          Objects.requireNonNull(balanceBefore, "balanceBefore")
+              .setScale(2, RoundingMode.UNNECESSARY);
+      balanceAfter =
+          Objects.requireNonNull(balanceAfter, "balanceAfter")
+              .setScale(2, RoundingMode.UNNECESSARY);
+      if (balanceBefore.signum() < 0 || balanceAfter.signum() < 0 || recordedAt <= 0) {
+        throw new IllegalArgumentException("Invalid money receipt");
+      }
+      BigDecimal expected =
+          status != Status.APPLIED
+              ? balanceBefore
+              : request.direction() == Direction.CREDIT
+                  ? balanceBefore.add(request.amount())
+                  : balanceBefore.subtract(request.amount());
+      if (expected.compareTo(balanceAfter) != 0
+          || (status == Status.APPLIED && balanceAfter.compareTo(MAX_BALANCE) > 0)) {
+        throw new IllegalArgumentException("Money receipt does not match its balance change");
+      }
+    }
+  }
+
+  /**
+   * Returns only a durable terminal receipt; storage uncertainty throws and must not authorize
+   * compensation.
+   */
+  Receipt applyMoney(Request request);
+
+  /**
+   * Absence is authoritative only when this method returns normally. Never infer absence from an
+   * exception.
+   */
+  Optional<Receipt> moneyReceipt(UUID operationId);
+}
