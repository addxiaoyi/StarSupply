+
+  private FaultSource faultSource() {
+    FaultSource source = new FaultSource();
+    source.setUrl("jdbc:sqlite:" + directory.resolve("balances.db"));
+    return source;
+  }
+
+  private static class FaultSource extends SQLiteDataSource {
+    final AtomicInteger failCommitNumber = new AtomicInteger();
+    final AtomicBoolean unavailable = new AtomicBoolean();
+    boolean blockReadsAfterCommit;
+
+    @Override
+    public Connection getConnection() throws SQLException {
+      if (unavailable.get()) throw new SQLException("connection unavailable");
+      Connection delegate = super.getConnection();
+      return (Connection)
+          Proxy.newProxyInstance(
+              Connection.class.getClassLoader(),
+              new Class<?>[] {Connection.class},
+              (proxy, method, args) -> {
+                try {
+                  Object result = method.invoke(delegate, args);
+                  if (method.getName().equals("commit")
+                      && failCommitNumber.get() > 0
+                      && failCommitNumber.decrementAndGet() == 0) {
+                    unavailable.set(blockReadsAfterCommit);
+                    throw new SQLException("response lost after actual commit");
+                  }
+                  return result;
+                } catch (InvocationTargetException failure) {
+                  throw failure.getCause();
+                }
+              });
+    }
+  }
+
+  private static void sql(SQLiteDataSource source, String query) throws SQLException {
+    try (var connection = source.getConnection();
+        var statement = connection.createStatement()) {
+      statement.execute(query);
+    }
+  }
+}
