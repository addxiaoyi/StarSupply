+        verify(player).getLocation();
+        fixture.owner = player;
+        Inventory previous = visible.get();
+        menu.refresh();
+        assertNotSame(previous, visible.get());
+        assertTrue(menu.isOpen());
+        assertEquals(0, closes.get());
+        listener.onInventoryClose(closeEvent(player, previous));
+        assertSame(menu, ModernHudListener.getMenu(player));
+        menu.close();
+        menu.close();
+        assertEquals(1, closes.get());
+        assertFalse(menu.isOpen());
+        assertNull(ModernHudListener.getMenu(player));
+        assertTrue(fixture.pending.get(1).cancelled.get());
