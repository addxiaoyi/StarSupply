+  /** 播放场景化音效到指定位置 */
+  public void playSoundAt(
+      SoundScene scene, org.bukkit.Location location, float volume, float pitch) {
+    if (location == null || location.getWorld() == null) return;
+
+    Location target = location.clone();
+    tasks.executeRegion(
+        target,
+        () -> {
+          SceneSoundConfig.Snapshot settings = configuration;
+          SceneSoundConfig.SoundConfig configured =
+              settings == null ? null : settings.sounds().get(scene);
+          if (settings != null && (!settings.enabled() || !configured.enabled())) return;
+          float actualVolume = volume * (settings == null ? 1f : settings.volume());
+          float actualPitch = pitch * (settings == null ? 1f : settings.pitch());
+          if (settings != null) {
+            for (SoundSceneGroup group : SoundSceneGroup.values()) {
+              if (!Arrays.asList(group.getScenes()).contains(scene)) continue;
+              SceneSoundConfig.GroupSoundConfig value = settings.groups().get(group);
+              if (!value.enabled()) return;
+              actualVolume *= value.volume();
+            }
+          }
+          if (!Float.isFinite(actualVolume) || actualVolume <= 0 || !Float.isFinite(actualPitch))
+            return;
+          Sound sound =
+              parseSound(configured == null ? scene.getDefaultSound() : configured.sound());
+          if (sound != null)
+            target
+                .getWorld()
+                .playSound(
+                    target,
+                    sound,
+                    Math.min(4f, actualVolume),
+                    Math.max(.5f, Math.min(2f, actualPitch)));
+        });
+  }
