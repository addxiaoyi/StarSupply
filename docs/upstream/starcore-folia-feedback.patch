+  @Test
+  void menuOpenAndRefreshUseOwnerAndCloseCallbackRunsExactlyOnce() {
+    try (var fixture = new FeedbackSchedulerFixture();
+        var items = mockConstruction(ItemStack.class)) {
+      Player player = fixture.player(0);
+      ModernHudListener listener = ModernHudListener.initialize(fixture.plugin);
+      AtomicReference<Inventory> visible = new AtomicReference<>(mock(Inventory.class));
+      InventoryView view = mock(InventoryView.class);
+      when(view.getTopInventory()).thenAnswer(ignored -> visible.get());
+      when(player.getOpenInventory()).thenReturn(view);
+      fixture
+          .bukkit
+          .when(() -> Bukkit.createInventory(any(InventoryHolder.class), anyInt(), anyString()))
+          .thenAnswer(
+              ignored -> {
+                assertSame(player, fixture.owner);
+                return mock(Inventory.class);
+              });
+      when(player.openInventory(any(Inventory.class)))
+          .thenAnswer(
+              call -> {
+                listener.onInventoryClose(closeEvent(player, visible.get()));
+                visible.set(call.getArgument(0));
+                return view;
+              });
+      doAnswer(
+              ignored -> {
+                listener.onInventoryClose(closeEvent(player, visible.get()));
+                return null;
