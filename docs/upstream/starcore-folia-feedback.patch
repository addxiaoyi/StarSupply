+      verify(menu).handleClick(player, 1, item);
+      listener.onInventoryClick(click);
+      registered(player, fixture);
+      fixture.pending.getLast().tick();
+      verify(menu, times(1)).handleClick(player, 1, item);
+      listener.shutdown();
+    }
+  }
+
+  @Test
+  void immediateRetirementAndDisableLeaveNoMenuOrLiveTimer() {
+    try (var fixture = new FeedbackSchedulerFixture()) {
+      Player player = fixture.player(0);
+      fixture.owner = player;
+      var listener = ModernHudListener.initialize(fixture.plugin);
+      var menu = registered(player, fixture);
