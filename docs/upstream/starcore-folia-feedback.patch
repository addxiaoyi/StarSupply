+import java.util.Optional;
+import org.bukkit.Location;
+import org.bukkit.entity.Player;
+import org.junit.jupiter.api.Test;
+
+class SceneSoundFoliaTest {
+  @Test
+  void ownerDispatchRespectsLatestMuteAndShutdownStopsDelayedReward() {
+    try (var fixture = new FeedbackSchedulerFixture();
+        var resolver = mockStatic(BukkitSoundResolver.class)) {
+      Player player = fixture.player(0);
+      resolver.when(() -> BukkitSoundResolver.resolve(anyString())).thenReturn(Optional.empty());
+      var service = new SceneSoundService(fixture.plugin);
+      service.playReward(player);
+      verify(player, never()).isOnline();
+      service.setMuted(player, true);
+      fixture.pending.getFirst().tick();
+      resolver.verifyNoInteractions();
+      service.setMuted(player, false);
+      service.shutdown();
+      fixture.pending.getLast().tick();
+      resolver.verifyNoInteractions();
+      assertTrue(fixture.pending.getLast().cancelled.get());
+    }
+  }
+
+  @Test
+  void eachPlayersDelayedSequenceRemainsOnItsEntityAndRetirementSuppressesIt() {
+    try (var fixture = new FeedbackSchedulerFixture();
+        var resolver = mockStatic(BukkitSoundResolver.class)) {
+      Player first = fixture.player(0);
+      Player second = fixture.player(5000);
+      resolver.when(() -> BukkitSoundResolver.resolve(anyString())).thenReturn(Optional.empty());
+      var service = new SceneSoundService(fixture.plugin);
+      service.playWarVictory(first);
+      service.playLevelUp(second);
+      assertSame(first, fixture.pending.get(0).player);
+      assertSame(second, fixture.pending.get(2).player);
+      fixture.pending.get(0).tick();
+      fixture.pending.get(2).tick();
+      fixture.pending.get(1).retire();
+      fixture.pending.get(1).tick();
+      fixture.pending.get(3).tick();
+      resolver.verify(() -> BukkitSoundResolver.resolve(anyString()), times(3));
+      service.shutdown();
+    }
+  }
+
+  @Test
+  void fixedPositionIsClonedAndUsesRegionCallback() {
+    try (var fixture = new FeedbackSchedulerFixture();
+        var resolver = mockStatic(BukkitSoundResolver.class)) {
+      resolver
+          .when(() -> BukkitSoundResolver.resolve(anyString()))
+          .thenAnswer(
+              call -> {
+                assertTrue(fixture.regionOwned);
+                return Optional.empty();
+              });
+      var service = new SceneSoundService(fixture.plugin);
+      Location position = new Location(fixture.world, 48, 70, 32);
+      service.playSoundAt(SceneSoundService.SoundScene.WAR_START, position, 1, 1);
+      position.setX(9999);
+      assertEquals(48, fixture.pending.getFirst().location.getX());
+      resolver.verifyNoInteractions();
+      fixture.pending.getFirst().tick();
+      resolver.verify(() -> BukkitSoundResolver.resolve(anyString()));
+      service.shutdown();
+    }
+  }
+
+  @Test
+  void concurrentPreferenceCollectionsCanBeReadWithoutCopyingMutableHashSets() {
+    var prefs = new SceneSoundService.SoundPreferences();
+    java.util.stream.IntStream.range(0, 1000)
+        .parallel()
+        .forEach(
+            i -> {
+              prefs.muteGroup(SceneSoundService.SoundSceneGroup.UI);
+              prefs.getMutedGroups().forEach(group -> assertNotNull(group));
+              prefs.unmuteGroup(SceneSoundService.SoundSceneGroup.UI);
+            });
+    prefs.setUiVolume(.25f);
+    assertEquals(.25f, prefs.getUiVolume());
+  }
+}
