+package dev.starcore.starcore.foundation.sound;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.ArgumentMatchers.*;
+import static org.mockito.Mockito.*;
+
+import dev.starcore.starcore.core.scheduler.FeedbackSchedulerFixture;
+import java.nio.file.*;
+import java.util.*;
+import org.bukkit.entity.Player;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+class SceneSoundConfigTest {
+  @TempDir Path directory;
+
+  @Test
+  void configurationPersistsSeparatelyAndReloadedSnapshotControlsPlayerSound() throws Exception {
+    try (var fixture = new FeedbackSchedulerFixture();
+        var resolver = mockStatic(BukkitSoundResolver.class)) {
+      when(fixture.plugin.getDataFolder()).thenReturn(directory.toFile());
+      Path main = directory.resolve("config.yml");
+      Files.writeString(main, "platform:\n  folia-logistics-profile: true\n");
+      String before = Files.readString(main);
+      var config = new SceneSoundConfig(fixture.plugin);
+      config.load();
+      assertTrue(Files.exists(directory.resolve("scene-sounds.yml")));
+      assertTrue(config.getPlayerPreferences(UUID.randomUUID()).isEmpty());
+      var ui = SceneSoundService.SoundScene.UI_CLICK;
+      config.setSoundConfig(
+          ui, new SceneSoundConfig.SoundConfig(true, "minecraft:test.sound", .5f, 1));
+      var reload = new SceneSoundConfig(fixture.plugin);
+      reload.load();
+      assertEquals("minecraft:test.sound", reload.getSoundConfig(ui).sound());
+      assertEquals(before, Files.readString(main));
+      verify(fixture.plugin, never()).reloadConfig();
+      verify(fixture.plugin, never()).saveConfig();
+
+      resolver.when(() -> BukkitSoundResolver.resolve(anyString())).thenReturn(Optional.empty());
+      Player player = fixture.player(0);
+      fixture.owner = player;
+      var service = new SceneSoundService(fixture.plugin);
+      service.reloadConfiguration(reload);
+      service.playClick(player);
+      resolver.verify(() -> BukkitSoundResolver.resolve("minecraft:test.sound"));
+      reload.setEnabled(false);
+      service.playClick(player); // A file/config edit is not a partially published live snapshot.
+      resolver.verify(() -> BukkitSoundResolver.resolve(anyString()), times(2));
+      service.reloadConfiguration(reload);
+      service.playClick(player);
+      resolver.verify(() -> BukkitSoundResolver.resolve(anyString()), times(2));
+      service.shutdown();
+    }
+  }
+
+  @Test
+  void invalidReloadPreservesPreviousStateAndDefaultYamlUsesNestedScenePaths() throws Exception {
+    try (var fixture = new FeedbackSchedulerFixture()) {
+      when(fixture.plugin.getDataFolder()).thenReturn(directory.toFile());
+      var config = new SceneSoundConfig(fixture.plugin);
+      config.load();
+      config.setEnabled(false);
+      Files.writeString(directory.resolve("scene-sounds.yml"), "invalid: [unterminated");
+      assertThrows(IllegalStateException.class, config::load);
+      assertFalse(config.isEnabled());
+      var yaml = new org.bukkit.configuration.file.YamlConfiguration();
+      yaml.loadFromString(config.generateDefaultConfig());
+      assertEquals("UI_BUTTON_CLICK", yaml.getString("sounds.menu.click.sound"));
+    }
+  }
+}
