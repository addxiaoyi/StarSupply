+  }
+
+  @Test
+  void queuedOpenFromDisabledListenerCannotEnterReplacementInstance() {
+    try (var fixture = new FeedbackSchedulerFixture()) {
+      Player player = fixture.player(0);
+      var first = ModernHudListener.initialize(fixture.plugin);
+      var menu = ModernHudMenu.create(player, fixture.plugin, "queued", Component.text("Queued"));
+      menu.open();
+      first.shutdown();
+      var next = ModernHudListener.initialize(fixture.plugin);
+      try {
+        fixture.pending.getFirst().tick();
+        assertFalse(menu.isOpen());
+        verify(player, never()).openInventory(any(Inventory.class));
+        assertNull(ModernHudListener.getMenu(player));
+      } finally {
+        next.shutdown();
+      }
