+package dev.starcore.starcore.foundation.animation;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.ArgumentMatchers.*;
+import static org.mockito.Mockito.*;
+
+import dev.starcore.starcore.core.scheduler.FeedbackSchedulerFixture;
+import java.util.concurrent.atomic.AtomicLong;
+import org.bukkit.Location;
+import org.bukkit.entity.Player;
+import org.junit.jupiter.api.Test;
+
+class ScreenShakeFoliaTest {
+  @Test
+  void stopIsOrderedAfterQueuedStartOnSameEntity() {
+    try (var fixture = new FeedbackSchedulerFixture()) {
+      Player player = fixture.player(0);
+      var manager = new ScreenShakeManager(fixture.plugin, () -> 0L);
+      manager.shake(player, ScreenShakeManager.ShakeType.LIGHT, config(.3f));
+      manager.stopShake(player);
+      fixture.pending.get(0).tick();
+      fixture.pending.get(1).tick();
+      fixture.pending.get(2).tick();
+      assertFalse(manager.isShaking(player));
+      verify(player, never()).sendHurtAnimation(anyFloat());
+      manager.shutdown();
+    }
+  }
+
+  private static ScreenShakeManager.ShakeConfig config(float intensity) {
+    return new ScreenShakeManager.ShakeConfig(intensity, 500, 0.2f, 5, true, false, false);
+  }
+
+  @Test
+  void foreignDispatchUsesOwnerAndNeverTeleportsOrDamages() {
+    try (var fixture = new FeedbackSchedulerFixture()) {
+      Player player = fixture.player(0);
+      var clock = new AtomicLong();
+      var manager = new ScreenShakeManager(fixture.plugin, clock::get);
+      try {
+        manager.shake(player, ScreenShakeManager.ShakeType.LIGHT, config(0.3f));
+        verify(player, never()).isOnline();
+        assertEquals(0, manager.getActiveShakeCount());
+        fixture.pending.getFirst().tick();
+        assertEquals(1, manager.getActiveShakeCount());
+        fixture.pending.get(1).tick();
+        verify(player).sendHurtAnimation(anyFloat());
+        clock.set(500_000_000L);
+        fixture.pending.get(1).tick();
+        assertEquals(0, manager.getActiveShakeCount());
+        assertTrue(fixture.pending.get(1).cancelled.get());
+        verify(player, never()).teleport(any(Location.class));
+        verify(player, never()).teleportAsync(any(Location.class));
+        verify(player, never()).damage(anyDouble());
+      } finally {
+        manager.shutdown();
+      }
+    }
+  }
+
+  @Test
+  void staleTickAndRetirementCannotRemoveReplacement() {
+    try (var fixture = new FeedbackSchedulerFixture()) {
+      Player player = fixture.player(0);
+      fixture.owner = player;
+      var manager = new ScreenShakeManager(fixture.plugin, () -> 0L);
+      try {
+        manager.shake(player, ScreenShakeManager.ShakeType.LIGHT, config(0.3f));
+        var old = fixture.pending.getFirst();
+        manager.shake(player, ScreenShakeManager.ShakeType.HEAVY, config(0.8f));
+        old.tick();
+        old.retire();
+        assertTrue(manager.isShaking(player));
+        fixture.pending.getLast().tick();
+        verify(player, times(1)).sendHurtAnimation(anyFloat());
+        fixture.pending.getLast().retire();
+        assertFalse(manager.isShaking(player));
+      } finally {
+        manager.shutdown();
+      }
+    }
+  }
+
+  @Test
+  void retirementDuringSubmissionAndSchedulingFailureReleaseState() {
+    try (var fixture = new FeedbackSchedulerFixture()) {
+      Player player = fixture.player(0);
+      fixture.owner = player;
+      var manager = new ScreenShakeManager(fixture.plugin, () -> 0L);
+      fixture.retireImmediately = true;
+      manager.shake(player, ScreenShakeManager.ShakeType.LIGHT, config(0.3f));
+      assertEquals(0, manager.getActiveShakeCount());
+      fixture.retireImmediately = false;
+      when(player
+              .getScheduler()
+              .runAtFixedRate(eq(fixture.plugin), any(), any(), anyLong(), anyLong()))
+          .thenThrow(new IllegalStateException("disabled"));
+      assertThrows(
+          IllegalStateException.class,
+          () -> manager.shake(player, ScreenShakeManager.ShakeType.LIGHT, config(0.3f)));
+      assertEquals(0, manager.getActiveShakeCount());
+      manager.shutdown();
+    }
+  }
+
+  @Test
+  void shutdownSuppressesQueuedAndActiveCallbacksAndAllowsSeparateManager() {
+    try (var fixture = new FeedbackSchedulerFixture()) {
+      Player player = fixture.player(0);
+      var first = new ScreenShakeManager(fixture.plugin);
+      first.shake(player, ScreenShakeManager.ShakeType.LIGHT, config(0.3f));
+      first.shutdown();
+      fixture.pending.getFirst().tick();
+      verify(player, never()).isOnline();
+      fixture.owner = player;
+      var next = new ScreenShakeManager(fixture.plugin, () -> 0L);
+      next.shake(player, ScreenShakeManager.ShakeType.LIGHT, config(0.3f));
+      next.shutdown();
+      fixture.pending.getLast().tick();
+      verify(player, never()).sendHurtAnimation(anyFloat());
+      assertEquals(0, next.getActiveShakeCount());
+    }
+  }
+
+  @Test
+  void areaSamplesEachPlayerOnOwnerAndClonesCallerLocation() {
+    try (var fixture = new FeedbackSchedulerFixture()) {
+      Player near = fixture.player(0);
+      Player far = fixture.player(2000);
+      var manager = new ScreenShakeManager(fixture.plugin);
+      // Disable actual feedback; location eligibility still has to be evaluated on each owner.
+      manager.setEnabled(near, false);
+      manager.setEnabled(far, false);
+      Location center = new Location(fixture.world, 0, 64, 0);
+      manager.shakeAt(ScreenShakeManager.ShakeType.LIGHT, center, 10);
+      center.setX(9000);
+      fixture.pending.getFirst().tick();
