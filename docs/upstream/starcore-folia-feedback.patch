+        // 导航类
+      case NAV_NEXT, NAV_PREVIOUS -> 0.8f;
+        // 通知类
+      case NOTIFY_INFO, NOTIFY_WARNING, NOTIFY_ERROR, NOTIFY_SUCCESS, NOTIFY_URGENT -> 1.0f;
+        // 社交类
