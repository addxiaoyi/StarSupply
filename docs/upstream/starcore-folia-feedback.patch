@@ -0,0 +1,138 @@
+package dev.starcore.starcore.core.scheduler;
+
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.mockito.ArgumentMatchers.*;
+import static org.mockito.Mockito.*;
+
+import io.papermc.paper.threadedregions.scheduler.*;
+import java.util.*;
+import java.util.concurrent.atomic.AtomicBoolean;
+import java.util.function.Consumer;
+import org.bukkit.*;
+import org.bukkit.entity.Entity;
+import org.bukkit.entity.Player;
+import org.bukkit.plugin.PluginManager;
+import org.bukkit.plugin.java.JavaPlugin;
+import org.mockito.MockedStatic;
+
+/** Uses the real CompatScheduler adapter with controllable native entity/region callbacks. */
+public final class FeedbackSchedulerFixture implements AutoCloseable {
+  public final JavaPlugin plugin = mock(JavaPlugin.class);
+  public final World world = mock(World.class);
+  public final List<Player> players = new ArrayList<>();
+  public final List<Pending> pending = new ArrayList<>();
+  public final MockedStatic<Bukkit> bukkit = mockStatic(Bukkit.class);
+  public Player owner;
+  public boolean regionOwned;
+  public boolean retireImmediately;
+
+  public FeedbackSchedulerFixture() {
+    CompatScheduler.setFoliaForTests(true);
+    Server server = mock(Server.class);
+    when(plugin.getServer()).thenReturn(server);
+    when(server.getPluginManager()).thenReturn(mock(PluginManager.class));
+    when(plugin.isEnabled()).thenReturn(true);
+    bukkit
+        .when(() -> Bukkit.isOwnedByCurrentRegion(any(Entity.class)))
+        .thenAnswer(call -> owner == call.getArgument(0));
+    bukkit
+        .when(() -> Bukkit.isOwnedByCurrentRegion(any(Location.class)))
+        .thenAnswer(call -> regionOwned);
+    bukkit.when(Bukkit::getOnlinePlayers).thenReturn(players);
+    bukkit.when(Bukkit::getGlobalRegionScheduler).thenReturn(mock(GlobalRegionScheduler.class));
+    bukkit.when(Bukkit::getAsyncScheduler).thenReturn(mock(AsyncScheduler.class));
+    RegionScheduler regions = mock(RegionScheduler.class);
+    bukkit.when(Bukkit::getRegionScheduler).thenReturn(regions);
+    when(regions.runDelayed(eq(plugin), any(Location.class), any(), anyLong()))
+        .thenAnswer(call -> add(null, call.getArgument(2), null, call.getArgument(1)));
+  }
+
+  public Player player(double x) {
+    Player player = mock(Player.class);
+    when(player.getUniqueId()).thenReturn(UUID.randomUUID());
+    when(player.getLocation())
+        .thenAnswer(
+            ignored -> {
+              assertSame(player, owner, "player location read outside entity owner");
+              return new Location(world, x, 64, 0);
+            });
+    when(player.isOnline())
+        .thenAnswer(
+            ignored -> {
+              assertSame(player, owner, "online read outside entity owner");
+              return true;
+            });
+    EntityScheduler scheduler = mock(EntityScheduler.class);
+    when(player.getScheduler()).thenReturn(scheduler);
+    when(scheduler.runDelayed(eq(plugin), any(), any(), anyLong()))
+        .thenAnswer(call -> add(player, call.getArgument(1), call.getArgument(2), null));
+    when(scheduler.runAtFixedRate(eq(plugin), any(), any(), anyLong(), anyLong()))
+        .thenAnswer(call -> add(player, call.getArgument(1), call.getArgument(2), null));
+    players.add(player);
+    return player;
+  }
+
+  private ScheduledTask add(
+      Player player, Consumer<ScheduledTask> action, Runnable retired, Location location) {
+    Pending work = new Pending(player, action, retired, location);
+    pending.add(work);
+    if (retireImmediately && retired != null) {
+      retired.run();
+      return null;
+    }
+    return work.nativeTask;
+  }
+
+  public final class Pending {
+    public final Player player;
+    public final Location location;
+    public final ScheduledTask nativeTask = mock(ScheduledTask.class);
+    public final AtomicBoolean cancelled = new AtomicBoolean();
+    private final Consumer<ScheduledTask> action;
+    private final Runnable retired;
+
+    Pending(Player player, Consumer<ScheduledTask> action, Runnable retired, Location location) {
+      this.player = player;
+      this.action = action;
+      this.retired = retired;
+      this.location = location;
+      when(nativeTask.isCancelled()).thenAnswer(ignored -> cancelled.get());
+      when(nativeTask.cancel())
+          .thenAnswer(
+              ignored -> {
+                cancelled.set(true);
+                return null;
+              });
+    }
+
+    public void tick() {
+      Player before = owner;
+      boolean beforeRegion = regionOwned;
+      owner = player;
+      regionOwned = location != null;
+      try {
+        action.accept(nativeTask);
+      } finally {
+        owner = before;
+        regionOwned = beforeRegion;
+      }
+    }
+
+    public void retire() {
+      Player before = owner;
+      owner = null;
+      try {
+        retired.run();
+      } finally {
+        owner = before;
+      }
+    }
+  }
+
+  @Override
+  public void close() {
+    CompatScheduler.cancelTasks(plugin);
+    CompatScheduler.setFoliaForTests(null);
+    bukkit.close();
+  }
+}
