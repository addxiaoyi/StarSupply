+package dev.starcore.starcore.foundation.sound;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import java.util.Map;
+import java.util.stream.Stream;
+import org.bukkit.NamespacedKey;
+import org.junit.jupiter.api.Test;
+
+class BukkitSoundResolverTest {
+  @Test
+  void everyDefaultSceneSoundIsDeclaredByPinnedPaperApi() {
+    var names =
+        java.util.Arrays.stream(org.bukkit.Sound.class.getDeclaredFields())
+            .filter(field -> field.getType() == org.bukkit.Sound.class)
+            .map(java.lang.reflect.Field::getName)
+            .collect(java.util.stream.Collectors.toSet());
+    for (var scene : SceneSoundService.SoundScene.values()) {
+      assertTrue(
+          names.contains(scene.getDefaultSound()), scene.name() + ": " + scene.getDefaultSound());
+    }
+  }
+
+  @Test
+  void legacyNamesPreserveUnderscoresInsideMinecraftKeySegments() {
+    NamespacedKey note = NamespacedKey.minecraft("block.note_block.bell");
+    NamespacedKey pickup = NamespacedKey.minecraft("entity.experience_orb.pickup");
+    Map<String, NamespacedKey> aliases = BukkitSoundResolver.legacyNames(Stream.of(note, pickup));
+    assertEquals(note, BukkitSoundResolver.toKey("BLOCK_NOTE_BLOCK_BELL", aliases));
+    assertEquals(pickup, BukkitSoundResolver.toKey("entity_experience_orb_pickup", aliases));
+    assertEquals(note, BukkitSoundResolver.toKey("minecraft:block.note_block.bell", aliases));
+    assertEquals(note, BukkitSoundResolver.toKey("block.note_block.bell", aliases));
+    assertNull(BukkitSoundResolver.toKey("MISSING_SOUND", aliases));
+    assertNull(BukkitSoundResolver.toKey("", aliases));
+  }
+
+  @Test
+  void customNamespacesRemainExplicitAndCannotOverrideMinecraftAliases() {
+    NamespacedKey custom = new NamespacedKey("custom", "block.note_block.bell");
+    Map<String, NamespacedKey> aliases = BukkitSoundResolver.legacyNames(Stream.of(custom));
+    assertTrue(aliases.isEmpty());
+    assertEquals(custom, BukkitSoundResolver.toKey(custom.toString(), aliases));
+    assertNull(BukkitSoundResolver.toKey("BLOCK_NOTE_BLOCK_BELL", aliases));
+  }
+}
