+package dev.starcore.starcore.foundation.animation;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.ArgumentMatchers.*;
+import static org.mockito.Mockito.*;
+
+import java.util.concurrent.*;
+import java.util.concurrent.atomic.*;
+import org.bukkit.Bukkit;
+import org.bukkit.Server;
+import org.bukkit.entity.Player;
+import org.bukkit.plugin.Plugin;
+import org.bukkit.scheduler.*;
+import org.junit.jupiter.api.Test;
+
+class AnimationTaskTrackerLifecycleTest {
+  @Test
+  void shutdownWaitsForActiveFeedbackAndPreventsFurtherWork() throws Exception {
+    var tracker = new AnimationTaskTracker(mock(Plugin.class));
+    CountDownLatch entered = new CountDownLatch(1);
+    CountDownLatch release = new CountDownLatch(1);
+    AtomicBoolean stopped = new AtomicBoolean();
+    AtomicInteger ran = new AtomicInteger();
+    try (ExecutorService workers = Executors.newFixedThreadPool(2)) {
+      Future<?> action =
+          workers.submit(
+              () ->
+                  tracker.runIfOpen(
+                      () -> {
+                        entered.countDown();
+                        try {
+                          assertTrue(release.await(5, TimeUnit.SECONDS));
+                        } catch (InterruptedException ex) {
+                          throw new RuntimeException(ex);
+                        }
+                        ran.incrementAndGet();
+                      }));
+      assertTrue(entered.await(5, TimeUnit.SECONDS));
+      Future<?> stop =
+          workers.submit(
+              () -> {
+                tracker.shutdown();
+                stopped.set(true);
+              });
+      assertThrows(TimeoutException.class, () -> stop.get(50, TimeUnit.MILLISECONDS));
+      assertFalse(stopped.get());
+      release.countDown();
+      action.get(5, TimeUnit.SECONDS);
+      stop.get(5, TimeUnit.SECONDS);
+      tracker.runIfOpen(ran::incrementAndGet);
+      assertEquals(1, ran.get());
+    } finally {
+      release.countDown();
+      tracker.shutdown();
+    }
+  }
+
+  @Test
+  void paperBackgroundWorkDispatchesToMainThreadAndShutdownSuppressesIt() {
+    Plugin plugin = mock(Plugin.class);
+    Server server = mock(Server.class);
+    BukkitScheduler scheduler = mock(BukkitScheduler.class);
+    BukkitTask handle = mock(BukkitTask.class);
+    when(plugin.getServer()).thenReturn(server);
+    when(server.getScheduler()).thenReturn(scheduler);
+    AtomicReference<Runnable> queued = new AtomicReference<>();
+    when(scheduler.runTaskLater(eq(plugin), any(Runnable.class), eq(1L)))
+        .thenAnswer(
+            call -> {
+              queued.set(call.getArgument(1));
+              return handle;
+            });
+    AtomicInteger ran = new AtomicInteger();
+    try (var bukkit = mockStatic(Bukkit.class)) {
+      bukkit.when(Bukkit::isPrimaryThread).thenReturn(false);
+      var tracker = new AnimationTaskTracker(plugin);
+      tracker.executePlayer(mock(Player.class), ran::incrementAndGet);
+      assertEquals(0, ran.get());
+      tracker.shutdown();
+      queued.get().run();
+      assertEquals(0, ran.get());
+      verify(handle).cancel();
+    }
+  }
+}
diff --git a/src/test/java/dev/starcore/starcore/foundation/animation/ScreenShakeFoliaTest.java b/src/test/java/dev/starcore/starcore/foundation/animation/ScreenShakeFoliaTest.java
