+    assertEquals(1, service.leaderboard(1).size());
+    assertThrows(UnsupportedOperationException.class, () -> service.leaderboard(10).clear());
+    assertThrows(IllegalArgumentException.class, () -> service.leaderboard(101));
+  }
+
+  @Test
+  void shrineIndexCoversRadiusBoundaryBeyondAdjacentChunksAndUnsubscribes() {
+    var player = fixture.player(0);
+    UUID id = player.getUniqueId();
+    service.setReligion(id, ReligionType.NATURE);
+    shrine();
+    OptimizedMoveListener dispatcher = new OptimizedMoveListener();
+    service.subscribe(dispatcher);
+    service.subscribe(dispatcher);
+    assertEquals(1, dispatcher.blockSubscribers());
+    fixture.owner = player;
+    service.onBlockMove(
+        player, new Location(fixture.world, 101, 64, 0), new Location(fixture.world, 100, 64, 0));
+    assertEquals(1, service.getReligion(id).getFaith());
+    verify(player).sendMessage(contains("你进入了圣地"));
+    service.onBlockMove(
+        player, new Location(fixture.world, -101, 64, 0), new Location(fixture.world, -100, 64, 0));
+    assertEquals(2, service.getReligion(id).getFaith());
+    service.shutdown();
+    assertEquals(0, dispatcher.blockSubscribers());
+  }
+
+  @Test
+  void movementHandlesNullAndForeignWorldAndDeletedIndex() {
+    var player = fixture.player(0);
+    UUID id = player.getUniqueId();
+    service.setReligion(id, ReligionType.NATURE);
+    HolyPlace place = shrine();
