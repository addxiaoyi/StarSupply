+package dev.starcore.starcore.mechanics;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+import java.util.UUID;
+import java.util.concurrent.*;
+import org.bukkit.Location;
+import org.bukkit.World;
+import org.bukkit.potion.PotionEffect;
+import org.junit.jupiter.api.Test;
+
+class ReligionModelSafetyTest {
+  @Test
+  void negativeAmountsCannotMintFaithContributionsOrPower() {
+    Religion religion = new Religion(UUID.randomUUID(), ReligionType.NATURE);
+    assertThrows(IllegalArgumentException.class, () -> religion.addFaith(-1));
+    assertThrows(IllegalArgumentException.class, () -> religion.reduceFaith(-1));
+    assertThrows(IllegalArgumentException.class, () -> religion.addContribution(-1));
+    HolyPlace place =
+        new HolyPlace(UUID.randomUUID(), ReligionType.NATURE, "world", 0, 64, 0, "Shrine", 50);
+    assertThrows(IllegalArgumentException.class, () -> place.consumeHolyPower(-1));
+    assertThrows(IllegalArgumentException.class, () -> place.addHolyPower(-1));
+    assertEquals(0, religion.getFaith());
+    assertEquals(100, place.getHolyPower());
+  }
+
+  @Test
+  void additionsSaturateWithoutIntegerOverflow() {
+    Religion religion = new Religion(UUID.randomUUID(), ReligionType.NATURE);
+    religion.addContribution(Integer.MAX_VALUE);
+    religion.addContribution(Integer.MAX_VALUE);
+    assertEquals(Integer.MAX_VALUE, religion.getContributions());
+    assertEquals(1000, religion.getFaith());
+    religion.addFaith(Integer.MAX_VALUE);
+    assertEquals(1000, religion.getFaith());
+    HolyPlace place =
+        new HolyPlace(UUID.randomUUID(), ReligionType.NATURE, "world", 0, 64, 0, "Shrine", 50);
+    place.addHolyPower(Integer.MAX_VALUE);
+    assertEquals(1000, place.getHolyPower());
+  }
+
+  @Test
+  void callerLocationMutationDoesNotMoveShrine() {
+    World world = mock(World.class);
+    when(world.getName()).thenReturn("world");
+    Location origin = new Location(world, 0, 64, 0);
+    HolyPlace place = new HolyPlace(UUID.randomUUID(), ReligionType.NATURE, origin, "Shrine", 50);
+    origin.setX(1000);
+    assertTrue(place.isInRange(new Location(world, 0, 64, 0)));
+    assertFalse(place.isInRange(origin));
+    assertFalse(place.isInRange(null));
+    assertFalse(place.isInRange(new Location(null, 0, 64, 0)));
+  }
+
+  @Test
+  void concurrentContributionsDoNotLoseUpdates() throws Exception {
+    Religion religion = new Religion(UUID.randomUUID(), ReligionType.NATURE);
+    try (ExecutorService executor = Executors.newFixedThreadPool(4)) {
+      var first =
+          executor.submit(
+              () -> {
+                for (int i = 0; i < 1000; i++) religion.addContribution(1);
+              });
+      var second =
+          executor.submit(
+              () -> {
+                for (int i = 0; i < 1000; i++) religion.addContribution(1);
+              });
+      first.get(5, TimeUnit.SECONDS);
+      second.get(5, TimeUnit.SECONDS);
+    }
+    assertEquals(2000, religion.getContributions());
+  }
+
+  @Test
+  void failedPowerConsumptionDoesNotAdvanceBlessingTime() {
+    HolyPlace place =
+        new HolyPlace(UUID.randomUUID(), ReligionType.NATURE, "world", 0, 64, 0, "Shrine", 50);
+    place.setHolyPower(5);
+    place.setLastBlessing(10);
+    place.performBlessing();
+    assertEquals(5, place.getHolyPower());
+    assertEquals(10, place.getLastBlessing());
+  }
+
+  @Test
+  void strongerAndInfiniteEffectsArePreserved() {
+    PotionEffect existing = mock(PotionEffect.class);
+    when(existing.getAmplifier()).thenReturn(2);
+    when(existing.getDuration()).thenReturn(1);
+    assertFalse(ReligionService.shouldRefresh(existing, 600, 0));
+    when(existing.getAmplifier()).thenReturn(0);
+    when(existing.isInfinite()).thenReturn(true);
+    assertFalse(ReligionService.shouldRefresh(existing, 600, 0));
+  }
+
+  @Test
+  void absentWeakerAndExpiringEffectsAreRefreshed() {
+    assertTrue(ReligionService.shouldRefresh(null, 600, 0));
+    PotionEffect existing = mock(PotionEffect.class);
+    when(existing.getAmplifier()).thenReturn(0);
+    when(existing.getDuration()).thenReturn(1000);
+    assertTrue(ReligionService.shouldRefresh(existing, 600, 1));
+    assertFalse(ReligionService.shouldRefresh(existing, 600, 0));
+    when(existing.getDuration()).thenReturn(300);
+    assertTrue(ReligionService.shouldRefresh(existing, 600, 0));
+  }
+}
diff --git a/src/test/java/dev/starcore/starcore/mechanics/ReligionPersistenceTest.java b/src/test/java/dev/starcore/starcore/mechanics/ReligionPersistenceTest.java
