+  private final UUID id;
+  private final ReligionType religion;
+  private final String worldName;
+  private final double x, y, z;
+  private final String name;
+  private final int radius;
+  private int holyPower = 100;
+  private long lastBlessing = System.currentTimeMillis();
+  private long revision;
+  private long savedRevision;
+  private boolean frozen;
+  private Runnable onChange = () -> {};
+
+  public HolyPlace(UUID id, ReligionType religion, Location location, String name, int radius) {
+    this(
+        id,
+        religion,
+        Objects.requireNonNull(location.getWorld(), "world").getName(),
+        location.getX(),
+        location.getY(),
+        location.getZ(),
+        name,
+        radius);
+  }
+
+  HolyPlace(
+      UUID id,
+      ReligionType religion,
+      String worldName,
+      double x,
+      double y,
+      double z,
+      String name,
+      int radius) {
+    this.id = Objects.requireNonNull(id);
+    this.religion = Objects.requireNonNull(religion);
+    if (worldName == null || worldName.isBlank() || worldName.length() > 256)
+      throw new IllegalArgumentException("world");
+    if (name == null
+        || name.isBlank()
+        || name.length() > 64
+        || name.chars().anyMatch(Character::isISOControl))
+      throw new IllegalArgumentException("name");
+    if (radius < 1 || radius > 100) throw new IllegalArgumentException("radius must be 1..100");
+    if (!Double.isFinite(x)
+        || !Double.isFinite(y)
+        || !Double.isFinite(z)
+        || Math.abs(x) > 30_000_000
+        || Math.abs(z) > 30_000_000) throw new IllegalArgumentException("coordinates");
+    this.worldName = worldName;
+    this.x = x;
+    this.y = y;
+    this.z = z;
+    this.name = name;
+    this.radius = radius;
+  }
+
+  public boolean isInRange(Location location) {
+    if (location == null
+        || location.getWorld() == null
+        || !worldName.equals(location.getWorld().getName())) return false;
+    double dx = location.getX() - x, dy = location.getY() - y, dz = location.getZ() - z;
+    return dx * dx + dy * dy + dz * dz <= (double) radius * radius;
+  }
+
+  public synchronized void addHolyPower(int amount) {
+    requireMutable();
+    if (amount < 0) throw new IllegalArgumentException("amount");
+    holyPower = (int) Math.min(1000L, (long) holyPower + amount);
+    changed();
+  }
+
+  public synchronized boolean consumeHolyPower(int amount) {
+    requireMutable();
+    if (amount < 0) throw new IllegalArgumentException("amount");
+    if (holyPower < amount) return false;
+    holyPower -= amount;
+    changed();
+    return true;
+  }
+
+  /** Low-level power consumption; callers can check canBless for the cooldown. */
+  public synchronized void performBlessing() {
+    requireMutable();
+    if (holyPower < 10) return;
+    holyPower -= 10;
+    lastBlessing = System.currentTimeMillis();
+    changed();
+  }
+
+  public synchronized boolean canBless() {
+    return System.currentTimeMillis() - lastBlessing >= 60_000 && holyPower >= 10;
+  }
+
+  public synchronized String getDescription() {
+    return String.format(
+        "%s%s\n§7类型: %s\n§7圣力: §f%d/1000\n§7范围: §f%d格",
+        religion.getColorCode(), name, religion.getColoredName(), holyPower, radius);
+  }
+
+  public UUID getId() {
+    return id;
+  }
+
+  public ReligionType getReligion() {
+    return religion;
+  }
+
+  /** Resolve the world only on the caller's server thread; persistence uses snapshot(). */
+  public Location getLocation() {
+    return new Location(Bukkit.getWorld(worldName), x, y, z);
