+  }
+
+  @Test
+  void feedbackRunsOnlyOnOwnerAndRetirementOrShutdownSuppressesIt() {
+    var player = fixture.player(0);
+    AtomicInteger delivered = new AtomicInteger();
+    service.feedback(
+        player,
+        () -> {
+          assertSame(player, fixture.owner);
+          delivered.incrementAndGet();
+        });
+    assertEquals(0, delivered.get());
+    fixture.pending.getLast().tick();
+    assertEquals(1, delivered.get());
+    service.feedback(player, delivered::incrementAndGet);
+    fixture.pending.getLast().retire();
+    fixture.pending.getLast().tick();
+    assertEquals(1, delivered.get());
+    service.feedback(player, delivered::incrementAndGet);
