+
+  @Test
+  void blessingTimerReadsPlayerStateOnlyAfterOwnerDispatchAndRechecksCurrentFaith() {
+    var player = fixture.player(0);
+    UUID id = player.getUniqueId();
+    service.setReligion(id, ReligionType.NATURE);
+    service.getReligion(id).setFaith(100);
+    service.blessAsync(id).join();
+    service.applyBlessings();
+    assertEquals(1, fixture.pending.size());
+    verify(player, never()).getPotionEffect(any());
+    service.setReligion(id, ReligionType.MOON);
+    fixture.pending.getLast().tick();
+    verify(player, never()).getPotionEffect(any());
+  }
