+  @Test
+  void schedulingFailureClosesStorageAndStillAllowsShutdown() throws Exception {
+    service.shutdown();
+    var scheduler = org.bukkit.Bukkit.getGlobalRegionScheduler();
+    fixture
+        .bukkit
+        .when(org.bukkit.Bukkit::getGlobalRegionScheduler)
+        .thenThrow(new IllegalStateException("scheduler unavailable"));
+    try {
+      assertThrows(IllegalStateException.class, this::start);
+      assertFalse(service.isEnabled());
+      assertTrue(raw.isClosed());
+      assertDoesNotThrow(service::shutdown);
+    } finally {
+      fixture.bukkit.when(org.bukkit.Bukkit::getGlobalRegionScheduler).thenReturn(scheduler);
