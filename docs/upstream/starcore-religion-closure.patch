+
+  public String getName() {
+    return name;
+  }
+
+  public int getRadius() {
+    return radius;
+  }
+
+  public synchronized int getHolyPower() {
+    return holyPower;
+  }
+
+  public synchronized void setHolyPower(int power) {
+    requireMutable();
+    holyPower = Math.max(0, Math.min(1000, power));
+    changed();
+  }
+
+  public synchronized long getLastBlessing() {
+    return lastBlessing;
+  }
+
+  public synchronized void setLastBlessing(long time) {
+    requireMutable();
+    if (time < 0) throw new IllegalArgumentException("lastBlessing");
+    lastBlessing = time;
+    changed();
+  }
+
+  record Snapshot(
+      UUID id,
+      ReligionType religion,
+      String name,
+      String world,
+      double x,
+      double y,
+      double z,
+      int radius,
+      int holyPower,
+      long lastBlessing,
+      long revision) {}
+
+  synchronized Snapshot snapshot() {
+    return new Snapshot(
+        id, religion, name, worldName, x, y, z, radius, holyPower, lastBlessing, revision);
+  }
+
+  synchronized void onChange(Runnable callback) {
+    onChange = callback;
+  }
+
+  synchronized boolean isDirty() {
+    return revision != savedRevision;
+  }
+
+  synchronized void markSaved(long writtenRevision) {
+    savedRevision = writtenRevision;
+  }
+
+  synchronized void freeze() {
+    frozen = true;
+    onChange = () -> {};
+  }
+
+  private void requireMutable() {
+    if (frozen) throw new IllegalStateException("Shrine is no longer active");
+  }
+
+  private void changed() {
+    revision++;
+    onChange.run();
+  }
