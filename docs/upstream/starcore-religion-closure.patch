+package dev.starcore.starcore.mechanics;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+import dev.starcore.starcore.core.scheduler.FeedbackSchedulerFixture;
+import dev.starcore.starcore.performance.OptimizedMoveListener;
+import java.lang.reflect.*;
+import java.nio.file.Path;
+import java.sql.*;
+import java.util.*;
+import java.util.concurrent.*;
+import java.util.concurrent.atomic.*;
+import java.util.logging.Logger;
+import org.bukkit.Location;
+import org.junit.jupiter.api.*;
+import org.junit.jupiter.api.io.TempDir;
+
+@Timeout(30)
+class ReligionPersistenceTest {
+  @TempDir Path directory;
+  FeedbackSchedulerFixture fixture;
+  ReligionService service;
+  Connection raw;
+  final AtomicBoolean failWrites = new AtomicBoolean();
+  final AtomicBoolean loseCommitReply = new AtomicBoolean();
+  final AtomicInteger failWriteNumber = new AtomicInteger();
+  final AtomicReference<Gate> nextWrite = new AtomicReference<>();
+  final AtomicReference<Runnable> afterCommit = new AtomicReference<>();
+  final UUID playerId = UUID.fromString("00000000-0000-0000-0000-000000000001");
+
+  @BeforeEach
+  void setup() throws Exception {
+    fixture = new FeedbackSchedulerFixture();
+    when(fixture.plugin.getDataFolder()).thenReturn(directory.toFile());
+    when(fixture.plugin.getLogger()).thenReturn(Logger.getAnonymousLogger());
+    when(fixture.world.getName()).thenReturn("overworld");
+    start();
+  }
+
+  void start() {
+    service =
+        new ReligionService(fixture.plugin) {
+          @Override
+          protected Connection openConnection() throws SQLException {
+            raw = super.openConnection();
+            return (Connection)
+                Proxy.newProxyInstance(
+                    Connection.class.getClassLoader(),
+                    new Class<?>[] {Connection.class},
+                    (proxy, method, args) -> {
+                      Object result = invoke(raw, method, args);
+                      if (method.getName().equals("prepareStatement"))
+                        return statement((PreparedStatement) result);
+                      if (method.getName().equals("commit")) {
+                        Runnable action = afterCommit.getAndSet(null);
+                        if (action != null) action.run();
+                        if (loseCommitReply.getAndSet(false))
+                          throw new SQLException("commit response lost");
+                      }
+                      return result;
+                    });
+          }
+        };
+    service.initialize();
+  }
+
+  Object statement(PreparedStatement statement) {
+    return Proxy.newProxyInstance(
+        PreparedStatement.class.getClassLoader(),
+        new Class<?>[] {PreparedStatement.class},
+        (proxy, method, args) -> {
+          if (method.getName().equals("executeUpdate")) {
+            Gate gate = nextWrite.getAndSet(null);
+            if (gate != null) gate.block();
+            if (failWrites.get()
+                || (failWriteNumber.get() > 0 && failWriteNumber.decrementAndGet() == 0))
+              throw new SQLException("injected write failure");
+          }
+          return invoke(statement, method, args);
+        });
+  }
+
+  static Object invoke(Object target, Method method, Object[] args) throws Throwable {
+    try {
+      return method.invoke(target, args);
+    } catch (InvocationTargetException failure) {
+      throw failure.getCause();
+    }
+  }
+
+  @AfterEach
+  void close() {
+    failWrites.set(false);
+    if (service != null) service.shutdown();
+    fixture.close();
+  }
+
+  long number(String query) throws Exception {
+    try (Connection read =
+            DriverManager.getConnection("jdbc:sqlite:" + directory.resolve("religion.db"));
+        Statement sql = read.createStatement();
+        ResultSet rows = sql.executeQuery(query)) {
+      assertTrue(rows.next());
+      return rows.getLong(1);
+    }
+  }
+
+  HolyPlace shrine() {
+    return service.createHolyPlace(
+        ReligionType.NATURE, new Location(fixture.world, 0, 64, 0), "Forest", 100);
+  }
+
+  Religion religion() {
+    service.setReligion(playerId, ReligionType.NATURE);
+    return service.getReligion(playerId);
+  }
+
+  void restart() {
+    service.shutdown();
+    start();
+  }
+
+  @Test
+  void acknowledgedChoiceAndBlessingSurviveOfflineRestart() {
+    Religion religion = religion();
+    religion.addContribution(1000);
+    assertTrue(service.blessAsync(playerId).join());
+    long joined = religion.getJoinTime();
+    restart();
+    assertEquals(100, service.getReligion(playerId).getFaith());
+    assertEquals(1000, service.getReligion(playerId).getContributions());
+    assertEquals(joined, service.getReligion(playerId).getJoinTime());
+    assertTrue(service.getReligion(playerId).isBlessed());
+    assertFalse(service.blessAsync(playerId).join());
+  }
+
+  @Test
+  void failedChoiceDoesNotPublishOrResetExistingReligion() {
+    Religion religion = religion();
+    religion.setFaith(150);
+    service.flush().join();
+    failWrites.set(true);
+    assertThrows(
+        CompletionException.class,
+        () -> service.setReligionAsync(playerId, ReligionType.WAR).join());
+    assertEquals(ReligionType.NATURE, religion.getType());
+    assertEquals(150, religion.getFaith());
+    UUID absent = UUID.randomUUID();
+    assertThrows(
+        CompletionException.class, () -> service.setReligionAsync(absent, ReligionType.WAR).join());
+    assertNull(service.getReligion(absent));
+  }
+
+  @Test
+  void failedBlessingRemainsUnclaimedAndCanRetry() {
+    Religion religion = religion();
+    religion.setFaith(100);
+    service.flush().join();
+    failWrites.set(true);
+    assertThrows(CompletionException.class, () -> service.blessAsync(playerId).join());
+    assertFalse(religion.isBlessed());
+    failWrites.set(false);
+    assertTrue(service.blessAsync(playerId).join());
+  }
+
+  @Test
+  void competingBlessingRequestsOnlyGrantOnce() {
+    Religion religion = religion();
+    religion.setFaith(100);
+    var first = service.blessAsync(playerId);
+    var second = service.blessAsync(playerId);
+    assertTrue(first.join());
+    assertFalse(second.join());
+  }
+
+  @Test
+  void changingFaithKeepsContributionsAndResetsBlessingDurably() {
+    Religion religion = religion();
+    religion.addContribution(1000);
+    service.blessAsync(playerId).join();
+    service.setReligion(playerId, ReligionType.SUN);
+    assertSame(religion, service.getReligion(playerId));
+    restart();
+    Religion stored = service.getReligion(playerId);
+    assertEquals(ReligionType.SUN, stored.getType());
+    assertEquals(1000, stored.getContributions());
+    assertEquals(0, stored.getFaith());
+    assertFalse(stored.isBlessed());
+  }
+
+  @Test
+  void failedCreateIsInvisibleAndDeleteFailureKeepsShrine() {
+    failWrites.set(true);
+    assertThrows(CompletionException.class, this::shrine);
+    assertTrue(service.getHolyPlaces().isEmpty());
+    failWrites.set(false);
+    HolyPlace place = shrine();
+    failWrites.set(true);
+    assertThrows(
+        CompletionException.class, () -> service.removeHolyPlaceAsync(place.getId()).join());
+    assertTrue(service.getHolyPlaces().contains(place));
+    place.addHolyPower(5);
+  }
+
+  @Test
+  void deletedDirtyShrineCannotReappearAfterSaveOrRestart() {
+    HolyPlace place = shrine();
+    place.addHolyPower(5);
+    assertTrue(service.removeHolyPlaceAsync(place.getId()).join());
+    assertFalse(service.removeHolyPlaceAsync(place.getId()).join());
+    assertThrows(IllegalStateException.class, () -> place.addHolyPower(10));
+    service.flush().join();
+    restart();
+    assertTrue(service.getHolyPlaces().isEmpty());
+  }
+
+  @Test
+  void unloadedWorldNameCoordinatesAndPowerSurviveSave() {
+    HolyPlace place = shrine();
+    place.setHolyPower(211);
+    place.setLastBlessing(12345);
+    service.flush().join();
+    restart();
+    HolyPlace loaded = service.getHolyPlaces().iterator().next();
+    assertEquals("overworld", loaded.getWorldName());
+    assertEquals(64, loaded.getY());
+    assertEquals(211, loaded.getHolyPower());
+    assertEquals(12345, loaded.getLastBlessing());
+    assertNull(loaded.getLocation().getWorld());
+    loaded.addHolyPower(5);
+    service.flush().join();
+    restart();
+    assertEquals(216, service.getHolyPlaces().iterator().next().getHolyPower());
+  }
+
+  @Test
+  void flushRollsBackAllRowsAndRetainsDirtyStateOnFailure() throws Exception {
+    Religion religion = religion();
+    HolyPlace place = shrine();
+    religion.onChange(() -> {});
+    place.onChange(() -> {});
+    religion.addFaith(77);
+    place.addHolyPower(8);
+    failWriteNumber.set(2);
+    assertThrows(CompletionException.class, () -> service.flush().join());
+    assertEquals(0, number("SELECT faith FROM player_religion"));
+    assertEquals(100, number("SELECT holy_power FROM holy_places"));
+    assertTrue(religion.isDirty());
+    assertTrue(place.isDirty());
+    service.flush().join();
+    assertEquals(77, number("SELECT faith FROM player_religion"));
+    assertEquals(108, number("SELECT holy_power FROM holy_places"));
+  }
+
+  @Test
+  void mutationDuringCommitIsNotMarkedSavedByOlderSnapshot() throws Exception {
+    Religion religion = religion();
+    religion.onChange(() -> {});
+    religion.setFaith(50);
+    afterCommit.set(() -> religion.addFaith(1));
+    service.flush().join();
+    assertTrue(religion.isDirty());
+    assertEquals(50, number("SELECT faith FROM player_religion"));
+    service.flush().join();
+    assertEquals(51, number("SELECT faith FROM player_religion"));
+  }
+
+  @Test
+  void uncertainCommitFreezesWritesUntilReloadOfAuthority() {
+    loseCommitReply.set(true);
+    assertThrows(
+        CompletionException.class,
+        () -> service.setReligionAsync(playerId, ReligionType.WAR).join());
+    assertFalse(service.isEnabled());
+    assertNull(service.getReligion(playerId));
+    assertThrows(
+        CompletionException.class,
+        () -> service.setReligionAsync(playerId, ReligionType.NATURE).join());
+    restart();
+    assertEquals(ReligionType.WAR, service.getReligion(playerId).getType());
+  }
+
+  @Test
+  void callerCancellationDoesNotCancelAdmittedWrite() throws Exception {
+    Gate gate = new Gate();
+    nextWrite.set(gate);
+    var result = service.setReligionAsync(playerId, ReligionType.SUN);
+    try {
+      gate.awaitEntered();
+      assertTrue(result.cancel(true));
+    } finally {
+      gate.release.countDown();
+    }
+    service.flush().join();
+    restart();
+    assertEquals(ReligionType.SUN, service.getReligion(playerId).getType());
+  }
+
+  @Test
+  void shutdownDrainsAdmittedWorkRejectsNewWorkAndClosesConnection() throws Exception {
+    Religion old = religion();
+    Gate gate = new Gate();
+    nextWrite.set(gate);
+    UUID other = UUID.randomUUID();
+    var operation = service.setReligionAsync(other, ReligionType.MOON);
+    gate.awaitEntered();
+    var shutdown = CompletableFuture.runAsync(service::shutdown);
+    try {
+      long until = System.nanoTime() + TimeUnit.SECONDS.toNanos(5);
+      while (service.isEnabled() && System.nanoTime() < until) Thread.sleep(1);
+      assertFalse(service.isEnabled());
+      assertFalse(shutdown.isDone());
+      assertThrows(
+          CompletionException.class,
+          () -> service.setReligionAsync(UUID.randomUUID(), ReligionType.WAR).join());
+    } finally {
+      gate.release.countDown();
+    }
+    shutdown.get(5, TimeUnit.SECONDS);
+    assertNotNull(operation.join());
+    assertTrue(raw.isClosed());
+    assertThrows(IllegalStateException.class, () -> old.addFaith(1));
+    service.setEnabled(true);
+    assertFalse(service.isEnabled());
+    start();
+    assertEquals(ReligionType.MOON, service.getReligion(other).getType());
+  }
+
+  @Test
+  void corruptedRowPreventsPartialStartupAndWrites() throws Exception {
+    religion();
+    service.shutdown();
+    try (Connection edit =
+            DriverManager.getConnection("jdbc:sqlite:" + directory.resolve("religion.db"));
+        Statement sql = edit.createStatement()) {
+      sql.executeUpdate("UPDATE player_religion SET faith=-1");
+    }
+    assertThrows(IllegalStateException.class, this::start);
+    assertFalse(service.isEnabled());
+    assertNull(service.getReligion(playerId));
+    assertTrue(raw.isClosed());
+    assertEquals(-1, number("SELECT faith FROM player_religion"));
+  }
+
+  @Test
+  void leaderboardLoadsOfflineRowsAndSortsTiesDeterministically() {
+    UUID second = UUID.fromString("00000000-0000-0000-0000-000000000002");
+    UUID third = UUID.fromString("00000000-0000-0000-0000-000000000003");
+    religion().setFaith(200);
+    service.setReligion(second, ReligionType.SUN);
+    service.getReligion(second).setFaith(200);
+    service.setReligion(third, ReligionType.MOON);
+    service.getReligion(third).setFaith(200);
